{
  "Logging": {
    "FileLogDirectory": "/app/logs"
  },
  "Elasticsearch": {
    "Nodes": [
      ""
    ]
  },
  "Redis": {
    "Mode": "StandAlone",
    "SentinelHosts": [
      "<UAT_REDIS_HOST>"
    ],
    "MasterName": "mymaster",
    "Password": "",
    "ConnectTimeout": 5500,
    "SyncTimeout": 5500,
    "DefaultDatabase": 2,
    "KeepAlive": 180,
    "ConnectRetry": 2
  },
  "RabbitMQ": {
    "Host": "<UAT_RABBIT_HOST>",
    "Port": 5672,
    "Username": "appvcm",
    "Password": "<UAT_RABBIT_PASSWORD>",
    "VirtualHost": "/"
  },
  "FileImport": {
    "Enabled": true,
    "InboxFolder": "/app/ftpbluepos/SyncDataPos/Sale/Kafka",
    "ErrorFolder": "/app/ftpbluepos/SyncDataPos/Sale/error",
    "WorkFolder": "/app/ftpbluepos/SyncDataPos/Sale/_work",
    "FileFilter": "*.zip",
    "PollIntervalSeconds": 30,
    "StableSeconds": 10,
    "MaxFilesPerCycle": 20,
    "Source": "FILE"
  },
  "ConnectionStrings": {
    "CentralMD": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSMasterData;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Loyalty": "Data Source=<UAT_SQL_HOST>;Initial Catalog=Loyalty;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "StagingDB": "Data Source=<UAT_SQL_HOST>;Initial Catalog=StagingDB;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Partner": "Data Source=<UAT_SQL_HOST>;Initial Catalog=Partner_QAS;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "EInvoice": "Data Source=<UAT_SQL_HOST>;Initial Catalog=EInvoice;User ID=<UAT_EINVOICE_USER>;Password=<UAT_EINVOICE_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "IFSAP": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSMasterData;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralGeneral": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSCentralGeneral;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSale": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSCentralSales;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSaleTemplate": "Data Source={server};Initial Catalog=RPOSCentralSales;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "BootstrapServers": "<UAT_KAFKA_HOST>"
  },
  "SetDb": {
    "DB1": "<UAT_SQL_HOST>"
  }
}
