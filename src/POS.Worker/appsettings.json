{
  "Logging": {
    "FileLogDirectory": "D:\\ROOT\\Logs",
    "LogLevel": { "Default": "Information" }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "Elasticsearch": {
    "Nodes": [ "http://10.235.52.189:9200" ],
    "IndexFormat": "pos-worker-logs-{0:yyyy.MM.dd}",
    "Username": "",
    "Password": ""
  },

  "Redis": {
    "Mode": "StandAlone",
    "SentinelHosts": [ "10.235.52.189:6379" ],
    "MasterName": "mymaster",
    "Password": "",
    "ConnectTimeout": 5500,
    "SyncTimeout": 5500,
    "DefaultDatabase": 2,
    "KeepAlive": 180,
    "ConnectRetry": 2
  },

  "RabbitMQ": {
    "Host": "10.235.52.189",
    "Port": 5672,
    "Username": "appvcm",
    "Password": "Msn@2024",
    "VirtualHost": "/",
    "RequestedHeartbeat": 60
  },

  "WorkerRoles": {
    "EnableFileProcessing": true,
    "EnableRabbitMQConsumer": true,
    "EnableSqlReportWorker": true,
    "EnableHeartbeat": true,
    "EnableMasterDataZipGenerator": false
  },

  "AppSettings": {
    "FtpRootPath": "D:\\ROOT\\FTPBLUEPOS"
  },

  "MasterDataSync": {
    "SqlCommandTimeoutSeconds": 600,
    "KeepZipDays": 2,
    "DateInZipName": true,
    "ZipCompressionLevel": "Fastest",
    "BatchSizePerFile": 10000,
    "MaxParallelTables": 4,
    "MaxConcurrentGeneration": 3,
    "ThrottleStaleAfterSeconds": 600
  },

  "MasterDataZipGenerator": {
    "IntervalSeconds": 300,
    "LockTtlMinutes": 30,
    "MaxParallelTerminals": 4,
    "QuarantineThreshold": 3
  },

  "WorkerHeartbeat": {
    "WorkerName": "PosSalesConsumer",
    "QueueName": "pos_sales",
    "IntervalSeconds": 15,
    "NormalTtlSeconds": 60,
    "StoppedTtlSeconds": 300
  },

  "FileImport": {
    "Enabled": true,
    "InboxFolder": "D:\\ROOT\\FILEIMPORT\\inbox",
    "ErrorFolder": "D:\\ROOT\\FILEIMPORT\\error",
    "WorkFolder": "D:\\ROOT\\FILEIMPORT\\_work",
    "FileFilter": "*.zip",
    "PollIntervalSeconds": 30,
    "StableSeconds": 10,
    "MaxFilesPerCycle": 20,
    "Source": "FILE"
  },

  "ConnectionStrings": {
    "CentralMD": "Data Source=10.235.55.122\\DRW;Initial Catalog=RPOSMasterData;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Loyalty": "Data Source=10.235.55.122\\DRW;Initial Catalog=Loyalty;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "StagingDB": "Data Source=10.235.55.122\\DRW;Initial Catalog=StagingDB;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralGeneral": "Data Source=10.235.55.122\\DRW;Initial Catalog=RPOSCentralGeneral;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSale": "Data Source=10.235.55.122\\DRW;Initial Catalog=RPOSCentralSales;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSaleTemplate": "Data Source={server};Initial Catalog=RPOSCentralSales;User ID=IFSAP;Password=IF@1234;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "BootstrapServers": "10.235.52.189:9092,10.235.52.108:9092"
  },

  "LogRetention": {
    "SerilogRetainedFileCountLimit": 7,
    "SerilogFileSizeLimitBytes": null,
    "RawLogRetentionDays": 7
  }
}
