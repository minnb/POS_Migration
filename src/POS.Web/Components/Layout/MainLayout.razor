@inherits LayoutComponentBase
@implements IAsyncDisposable

@inject NavigationManager Nav
@inject IBrowserViewportService ViewportService

@using Microsoft.AspNetCore.Components.Routing

<MudThemeProvider Theme="@PosTheme.Default"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudText Typo="Typo.h6" Class="ml-3 d-none d-sm-flex">POS Dashboard – POSMaster</MudText>
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-2" Typo="Typo.body2">
                    @context.User.Identity?.Name
                </MudText>
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="mr-3">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" Href="/logout" title="Đăng xuất"/>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle2" Class="mt-1">
                POSMaster POS System
            </MudText>
        </MudDrawerHeader>
        <MudNavMenu Margin="Margin.Dense">

            <AuthorizeView Policy="@WebPolicies.StoreAndAbove">
                <MudNavGroup Title="Cửa hàng" Icon="@Icons.Material.Filled.Store" @bind-Expanded="_expandStore">

                    <MudNavGroup Title="Vận hành" Icon="@Icons.Material.Filled.WorkHistory" @bind-Expanded="_expandStoreOps">
                        <MudNavLink Href="/store/business-day" Icon="@Icons.Material.Filled.ChevronRight">Ngày kinh doanh</MudNavLink>
                        <MudNavLink Href="/store/eos-shifts" Icon="@Icons.Material.Filled.ChevronRight">Kết thúc ca</MudNavLink>
                        <MudNavLink Href="/store/shift-summary" Icon="@Icons.Material.Filled.ChevronRight">Tổng kết ca</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Giao dịch" Icon="@Icons.Material.Filled.PointOfSale" @bind-Expanded="_expandStoreTx">
                        <MudNavLink Href="/store/transactions" Icon="@Icons.Material.Filled.ChevronRight">Danh sách giao dịch</MudNavLink>
                        <MudNavLink Href="/store/refunds" Icon="@Icons.Material.Filled.ChevronRight">Hoàn trả</MudNavLink>
                        <MudNavLink Href="/store/voids" Icon="@Icons.Material.Filled.ChevronRight">Lịch sử hủy giao dịch</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Báo cáo" Icon="@Icons.Material.Filled.Assessment" @bind-Expanded="_expandStoreReport">
                        <MudNavLink Href="/store/revenue" Icon="@Icons.Material.Filled.ChevronRight">Tổng hợp doanh thu</MudNavLink>
                        <MudNavLink Href="/store/revenue-by-staff" Icon="@Icons.Material.Filled.ChevronRight">Theo nhân viên</MudNavLink>
                        <MudNavLink Href="/store/revenue-by-store" Icon="@Icons.Material.Filled.ChevronRight">Theo cửa hàng</MudNavLink>
                        <MudNavLink Href="/store/revenue-detail" Icon="@Icons.Material.Filled.ChevronRight">Chi tiết doanh thu</MudNavLink>
                        <MudNavLink Href="/store/revenue-category" Icon="@Icons.Material.Filled.ChevronRight">Theo ngành hàng</MudNavLink>
                        <MudNavLink Href="/store/revenue-hourly" Icon="@Icons.Material.Filled.ChevronRight">Theo khung giờ</MudNavLink>
                        <MudNavLink Href="/store/payment-breakdown" Icon="@Icons.Material.Filled.ChevronRight">Theo hình thức thanh toán</MudNavLink>
                        <MudNavLink Href="/store/top-product" Icon="@Icons.Material.Filled.ChevronRight">Sản phẩm bán chạy</MudNavLink>
                        <MudNavLink Href="/store/loyalty" Icon="@Icons.Material.Filled.ChevronRight">Khách hàng thân thiết</MudNavLink>
                    </MudNavGroup>

                </MudNavGroup>
            </AuthorizeView>

            <AuthorizeView Policy="@WebPolicies.OpsAndAbove">
                <MudNavGroup Title="Danh mục" Icon="@Icons.Material.Filled.Inventory2" @bind-Expanded="_expandCatalog">

                    <MudNavGroup Title="Tổ chức" Icon="@Icons.Material.Filled.Business" @bind-Expanded="_expandCatOrg">
                        <MudNavLink Href="/catalog/employees" Icon="@Icons.Material.Filled.ChevronRight">Nhân viên</MudNavLink>
                        <MudNavLink Href="/catalog/stores" Icon="@Icons.Material.Filled.ChevronRight">Cửa hàng</MudNavLink>
                        <MudNavLink Href="/catalog/provinces" Icon="@Icons.Material.Filled.ChevronRight">Tỉnh / Thành</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Thiết bị POS" Icon="@Icons.Material.Filled.PointOfSale" @bind-Expanded="_expandCatPos">
                        <MudNavLink Href="/catalog/pos-setup" Icon="@Icons.Material.Filled.ChevronRight">Khai báo máy POS</MudNavLink>
                        <MudNavLink Href="/catalog/bank-pos" Icon="@Icons.Material.Filled.ChevronRight">Máy POS ngân hàng</MudNavLink>
                        <!--
                        <MudNavLink Href="/catalog/pos-versions" Icon="@Icons.Material.Filled.ChevronRight">Phiên bản POS</MudNavLink>
                        <MudNavLink Href="/catalog/print-setup" Icon="@Icons.Material.Filled.ChevronRight">Cấu hình in (POSWeb)</MudNavLink>
                        <MudNavLink Href="/catalog/posweb-users" Icon="@Icons.Material.Filled.ChevronRight">User đăng nhập POSWeb</MudNavLink>
                        -->
                    </MudNavGroup>
                    <!--
                    <MudNavGroup Title="Thanh toán" Icon="@Icons.Material.Filled.Payments" @bind-Expanded="_expandCatPay">
                        <MudNavLink Href="/catalog/banks" Icon="@Icons.Material.Filled.ChevronRight">Ngân hàng</MudNavLink>
                        <MudNavLink Href="/catalog/bank-card-types" Icon="@Icons.Material.Filled.ChevronRight">Loại thẻ ngân hàng</MudNavLink>
                        <MudNavLink Href="/catalog/ewallets" Icon="@Icons.Material.Filled.ChevronRight">Ví điện tử</MudNavLink>
                        <MudNavLink Href="/catalog/currency-rates" Icon="@Icons.Material.Filled.ChevronRight">Tỷ giá</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Cấu hình khác" Icon="@Icons.Material.Filled.Tune" @bind-Expanded="_expandCatMisc">
                        <MudNavLink Href="/catalog/sales-order-types" Icon="@Icons.Material.Filled.ChevronRight">Loại đơn bán</MudNavLink>
                        <MudNavLink Href="/catalog/qr-info" Icon="@Icons.Material.Filled.ChevronRight">QR Information</MudNavLink>
                        <MudNavLink Href="/catalog/image-sliders" Icon="@Icons.Material.Filled.ChevronRight">Ảnh slider</MudNavLink>
                    </MudNavGroup>
                        -->
                    <MudNavGroup Title="Sản phẩm" Icon="@Icons.Material.Filled.Inventory" @bind-Expanded="_expandCatProduct">
                        <MudNavLink Href="/catalog/products" Icon="@Icons.Material.Filled.ChevronRight">Danh sách SP / Barcode</MudNavLink>
                        <MudNavLink Href="/catalog/product-lock" Icon="@Icons.Material.Filled.ChevronRight">Khóa sản phẩm</MudNavLink>
                        <!--
                        <MudNavLink Href="/catalog/product-lock-grabfood" Icon="@Icons.Material.Filled.ChevronRight">Khóa SP GrabFood</MudNavLink>
                        <MudNavLink Href="/catalog/setup-item" Icon="@Icons.Material.Filled.ChevronRight">Setup Item</MudNavLink>
                        <MudNavLink Href="/catalog/setup-item-partner" Icon="@Icons.Material.Filled.ChevronRight">Setup Item đối tác</MudNavLink>
                        <MudNavLink Href="/catalog/pos-groups" Icon="@Icons.Material.Filled.ChevronRight">POS Group</MudNavLink>
                        -->
                    </MudNavGroup>

                    <MudNavGroup Title="Giá" Icon="@Icons.Material.Filled.PriceChange" @bind-Expanded="_expandCatPrice">
                        <MudNavLink Href="/catalog/prices" Icon="@Icons.Material.Filled.ChevronRight">Bảng giá</MudNavLink>
                        <MudNavLink Href="/catalog/price-setup" Icon="@Icons.Material.Filled.ChevronRight">Setup giá (Bulk Import)</MudNavLink>
                    </MudNavGroup>

                </MudNavGroup>
            </AuthorizeView>

            <AuthorizeView Policy="@WebPolicies.OpsAndAbove">
                <MudNavGroup Title="Khuyến mãi" Icon="@Icons.Material.Filled.LocalOffer" @bind-Expanded="_expandPromotion">

                    <MudNavGroup Title="Chương trình KM" Icon="@Icons.Material.Filled.Campaign" @bind-Expanded="_expandPromoOffer">
                        <MudNavLink Href="/promotion/offers" Icon="@Icons.Material.Filled.ChevronRight">Danh mục khuyến mãi</MudNavLink>
                        <MudNavLink Href="/promotion/setup" Icon="@Icons.Material.Filled.ChevronRight">Cài đặt CTKM</MudNavLink>
                        <MudNavLink Href="/promotion/special-combo" Icon="@Icons.Material.Filled.ChevronRight">Special Combo</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Campaign" Icon="@Icons.Material.Filled.Loyalty" @bind-Expanded="_expandPromoCampaign">
                        <MudNavLink Href="/promotion/campaigns" Icon="@Icons.Material.Filled.ChevronRight">Danh sách Campaign</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Coupon & Voucher" Icon="@Icons.Material.Filled.ConfirmationNumber" @bind-Expanded="_expandPromoCoupon">
                        <MudNavLink Href="/promotion/coupons" Icon="@Icons.Material.Filled.ChevronRight">Cài đặt Coupon</MudNavLink>
                        <MudNavLink Href="/promotion/coupons/issue" Icon="@Icons.Material.Filled.ChevronRight">Phát hành Coupon</MudNavLink>
                        <MudNavLink Href="/promotion/vouchers" Icon="@Icons.Material.Filled.ChevronRight">Danh mục Voucher</MudNavLink>
                        <MudNavLink Href="/promotion/vouchers-published" Icon="@Icons.Material.Filled.ChevronRight">Voucher phát hành</MudNavLink>
                    </MudNavGroup>

                </MudNavGroup>
            </AuthorizeView>

            <AuthorizeView Policy="@WebPolicies.OpsAndAbove">
                <MudNavGroup Title="Vận hành" Icon="@Icons.Material.Filled.MonitorHeart" @bind-Expanded="_expandOps">

                    <MudNavGroup Title="Giám sát" Icon="@Icons.Material.Filled.Monitor" @bind-Expanded="_expandOpsMonitor">
                        <MudNavLink Href="/ops/health" Icon="@Icons.Material.Filled.ChevronRight">System health</MudNavLink>
                        <MudNavLink Href="/ops/alerts" Icon="@Icons.Material.Filled.ChevronRight">Alerts</MudNavLink>
                        <MudNavLink Href="/ops/queues" Icon="@Icons.Material.Filled.ChevronRight">Queue monitor</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Nhật ký" Icon="@Icons.Material.Filled.Article" @bind-Expanded="_expandOpsLog">
                        <MudNavLink Href="/ops/logs" Icon="@Icons.Material.Filled.ChevronRight">Interface Error</MudNavLink>
                        <MudNavLink Href="/ops/data-raw-log" Icon="@Icons.Material.Filled.ChevronRight">DataRawJson Log</MudNavLink>
                        <MudNavLink Href="/ops/activity-log" Icon="@Icons.Material.Filled.ChevronRight">Nhật ký thao tác</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Cấu hình" Icon="@Icons.Material.Filled.Tune" @bind-Expanded="_expandOpsConfig">
                        <MudNavLink Href="/ops/pos-data-setup" Icon="@Icons.Material.Filled.ChevronRight">POS Data Setup</MudNavLink>
                    </MudNavGroup>

                </MudNavGroup>
            </AuthorizeView>
            
            <AuthorizeView Policy="@WebPolicies.AdminOnly">
                <MudNavGroup Title="Quản trị" Icon="@Icons.Material.Filled.AdminPanelSettings" @bind-Expanded="_expandAdmin">
                    <MudNavLink Href="/admin/users"
                                Icon="@Icons.Material.Filled.People">Users</MudNavLink>
                    <MudNavLink Href="/admin/roles"
                                Icon="@Icons.Material.Filled.Security">Roles</MudNavLink>
                    <MudNavLink Href="/admin/config"
                                Icon="@Icons.Material.Filled.Settings">Configs</MudNavLink>
                    <MudNavLink Href="/admin/audit"
                                Icon="@Icons.Material.Filled.History">Audit log</MudNavLink>
                    <MudNavLink Href="/admin/sql-console"
                                Icon="@Icons.Material.Filled.Storage">SQL Console</MudNavLink>
                    <MudNavLink Href="/admin/encrypt-secret"
                                Icon="@Icons.Material.Filled.Lock">Mã hóa Secret</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4 mt-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;          // init = false; OnAfterRenderAsync set theo viewport
    private bool _expandStore;
    private bool _expandStoreOps;
    private bool _expandStoreTx;
    private bool _expandStoreReport;
    private bool _expandOps;
    private bool _expandOpsMonitor;
    private bool _expandOpsLog;
    private bool _expandOpsConfig;
    private bool _expandCatalog;
    private bool _expandCatOrg;
    private bool _expandCatPos;
    private bool _expandCatPay;
    private bool _expandCatMisc;
    private bool _expandCatProduct;
    private bool _expandCatPrice;
    private bool _expandPromotion;
    private bool _expandPromoOffer;
    private bool _expandPromoCampaign;
    private bool _expandPromoCoupon;
    private bool _expandAdmin;

    protected override void OnInitialized()
    {
        UpdateExpanded(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    // Mở drawer sẵn trên desktop (≥ md = 960px), đóng trên mobile/tablet
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var bp = await ViewportService.GetCurrentBreakpointAsync();
        _drawerOpen = bp is Breakpoint.Md or Breakpoint.Lg or Breakpoint.Xl or Breakpoint.Xxl;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateExpanded(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateExpanded(string uri)
    {
        var u = uri.ToLowerInvariant();
        _expandStoreOps    = u.Contains("/store/business-day") || u.Contains("/store/eos-shifts") || u.Contains("/store/shift-summary");
        _expandStoreTx     = u.Contains("/store/transactions") || u.Contains("/store/refunds") || u.Contains("/store/voids");
        _expandStoreReport = u.Contains("/store/revenue") || u.Contains("/store/loyalty") || u.Contains("/store/payment-breakdown") || u.Contains("/store/revenue-detail") || u.Contains("/store/revenue-category") || u.Contains("/store/top-product");
        _expandStore       = _expandStoreOps || _expandStoreTx || _expandStoreReport;
        _expandOpsMonitor  = u.Contains("/ops/health") || u.Contains("/ops/alerts") || u.Contains("/ops/queues");
        _expandOpsLog      = u.Contains("/ops/logs") || u.Contains("/ops/data-raw-log") || u.Contains("/ops/activity-log");
        _expandOpsConfig   = u.Contains("/ops/pos-map") || u.Contains("/ops/stores") || u.Contains("/ops/pos-data-setup");
        _expandOps         = _expandOpsMonitor || _expandOpsLog || _expandOpsConfig;
        _expandCatOrg      = u.Contains("/catalog/employees") || u.Contains("/catalog/provinces");
        _expandCatPos      = u.Contains("/catalog/bank-pos") || u.Contains("/catalog/pos-versions") || u.Contains("/catalog/print-setup") || u.Contains("/catalog/posweb-users");
        _expandCatPay      = u.Contains("/catalog/banks") || u.Contains("/catalog/bank-card-types") || u.Contains("/catalog/ewallets") || u.Contains("/catalog/currency-rates");
        _expandCatMisc     = u.Contains("/catalog/sales-order-types") || u.Contains("/catalog/qr-info") || u.Contains("/catalog/image-sliders");
        _expandCatProduct  = u.Contains("/catalog/products") || u.Contains("/catalog/product-lock") || u.Contains("/catalog/setup-item") || u.Contains("/catalog/pos-groups");
        _expandCatPrice    = u.Contains("/catalog/prices") || u.Contains("/catalog/price-setup");
        _expandCatalog     = _expandCatOrg || _expandCatPos || _expandCatPay || _expandCatMisc || _expandCatProduct || _expandCatPrice;
        _expandPromoOffer  = u.Contains("/promotion/offers") || u.Contains("/promotion/setup") || u.Contains("/promotion/special-combo");
        _expandPromoCampaign = u.Contains("/promotion/campaigns");
        _expandPromoCoupon = u.Contains("/promotion/coupons") || u.Contains("/promotion/vouchers");
        _expandPromotion   = _expandPromoOffer || _expandPromoCampaign || _expandPromoCoupon;
        _expandAdmin       = u.Contains("/admin/");
    }

    public async ValueTask DisposeAsync() => Nav.LocationChanged -= OnLocationChanged;
}
