@inherits LayoutComponentBase
@implements IAsyncDisposable

@inject NavigationManager Nav
@inject IBrowserViewportService ViewportService

@using Microsoft.AspNetCore.Components.Routing

<MudThemeProvider Theme="@PosTheme.Default"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudText Typo="Typo.h6" Class="ml-3 d-none d-sm-flex">POS Dashboard – WinMart</MudText>
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-2" Typo="Typo.body2">
                    @context.User.Identity?.Name
                </MudText>
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="mr-3">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" Href="/logout" title="Đăng xuất"/>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle2" Class="mt-1">
                WinMart POS System
            </MudText>
        </MudDrawerHeader>
        <MudNavMenu>

            <AuthorizeView Policy="@WebPolicies.StoreAndAbove">
                <MudNavGroup Title="Cửa hàng" Icon="@Icons.Material.Filled.Store" @bind-Expanded="_expandStore">

                    <MudNavGroup Title="Vận hành" Icon="@Icons.Material.Filled.WorkHistory" @bind-Expanded="_expandStoreOps">
                        <MudNavLink Href="/store/business-day"
                                    Icon="@Icons.Material.Filled.CalendarToday">Ngày kinh doanh</MudNavLink>
                        <MudNavLink Href="/store/eos-shifts"
                                    Icon="@Icons.Material.Filled.LockClock">Kết thúc ca</MudNavLink>
                        <MudNavLink Href="/store/shift-summary"
                                    Icon="@Icons.Material.Filled.Summarize">Tổng kết ca</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Giao dịch" Icon="@Icons.Material.Filled.PointOfSale" @bind-Expanded="_expandStoreTx">
                        <MudNavLink Href="/store/transactions"
                                    Icon="@Icons.Material.Filled.Receipt">Danh sách GD</MudNavLink>
                        <MudNavLink Href="/store/refunds"
                                    Icon="@Icons.Material.Filled.AssignmentReturn">Hoàn trả</MudNavLink>
                        <MudNavLink Href="/store/voids"
                                    Icon="@Icons.Material.Filled.Cancel">Hủy GD</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Báo cáo" Icon="@Icons.Material.Filled.Assessment" @bind-Expanded="_expandStoreReport">
                        <MudNavLink Href="/store/revenue"
                                    Icon="@Icons.Material.Filled.BarChart">Doanh thu</MudNavLink>
                        <MudNavLink Href="/store/revenue-detail"
                                    Icon="@Icons.Material.Filled.TableChart">Doanh thu chi tiết</MudNavLink>
                        <MudNavLink Href="/store/revenue-hourly"
                                    Icon="@Icons.Material.Filled.AccessTime">Theo giờ</MudNavLink>
                        <MudNavLink Href="/store/payment-breakdown"
                                    Icon="@Icons.Material.Filled.Payments">Thanh toán</MudNavLink>
                        <MudNavLink Href="/store/loyalty"
                                    Icon="@Icons.Material.Filled.CardGiftcard">Loyalty &amp; Voucher</MudNavLink>
                    </MudNavGroup>

                </MudNavGroup>
            </AuthorizeView>

            <AuthorizeView Policy="@WebPolicies.OpsAndAbove">
                <MudNavGroup Title="Vận hành" Icon="@Icons.Material.Filled.MonitorHeart" @bind-Expanded="_expandOps">
                    <MudNavLink Href="/ops/health"
                                Icon="@Icons.Material.Filled.Speed">System health</MudNavLink>
                    <MudNavLink Href="/ops/pos-map"
                                Icon="@Icons.Material.Filled.Map">POS map</MudNavLink>
                    <MudNavLink Href="/ops/logs"
                                Icon="@Icons.Material.Filled.Article">Log viewer</MudNavLink>
                    <MudNavLink Href="/ops/data-raw-log"
                                Icon="@Icons.Material.Filled.DataObject">DataRaw Log</MudNavLink>
                    <MudNavLink Href="/ops/alerts"
                                Icon="@Icons.Material.Filled.NotificationsActive">Alerts</MudNavLink>
                    <MudNavLink Href="/ops/queues"
                                Icon="@Icons.Material.Filled.Timeline">Queue monitor</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <AuthorizeView Policy="@WebPolicies.AdminOnly">
                <MudNavGroup Title="Quản trị" Icon="@Icons.Material.Filled.AdminPanelSettings" @bind-Expanded="_expandAdmin">
                    <MudNavLink Href="/admin/users"
                                Icon="@Icons.Material.Filled.People">Người dùng</MudNavLink>
                    <MudNavLink Href="/admin/roles"
                                Icon="@Icons.Material.Filled.Security">Phân quyền</MudNavLink>
                    <MudNavLink Href="/admin/config"
                                Icon="@Icons.Material.Filled.Settings">Cấu hình</MudNavLink>
                    <MudNavLink Href="/admin/audit"
                                Icon="@Icons.Material.Filled.History">Audit log</MudNavLink>
                    <MudNavLink Href="/admin/sql-console"
                                Icon="@Icons.Material.Filled.Storage">SQL Console</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4 mt-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;          // init = false; OnAfterRenderAsync set theo viewport
    private bool _expandStore;
    private bool _expandStoreOps;
    private bool _expandStoreTx;
    private bool _expandStoreReport;
    private bool _expandOps;
    private bool _expandAdmin;

    protected override void OnInitialized()
    {
        UpdateExpanded(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    // Mở drawer sẵn trên desktop (≥ md = 960px), đóng trên mobile/tablet
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var bp = await ViewportService.GetCurrentBreakpointAsync();
        _drawerOpen = bp is Breakpoint.Md or Breakpoint.Lg or Breakpoint.Xl or Breakpoint.Xxl;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateExpanded(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateExpanded(string uri)
    {
        var u = uri.ToLowerInvariant();
        _expandStoreOps    = u.Contains("/store/business-day") || u.Contains("/store/eos-shifts") || u.Contains("/store/shift-summary");
        _expandStoreTx     = u.Contains("/store/transactions") || u.Contains("/store/refunds") || u.Contains("/store/voids");
        _expandStoreReport = u.Contains("/store/revenue") || u.Contains("/store/loyalty") || u.Contains("/store/payment-breakdown") || u.Contains("/store/revenue-detail");
        _expandStore       = _expandStoreOps || _expandStoreTx || _expandStoreReport;
        _expandOps         = u.Contains("/ops/");
        _expandAdmin       = u.Contains("/admin/");
    }

    public async ValueTask DisposeAsync() => Nav.LocationChanged -= OnLocationChanged;
}
