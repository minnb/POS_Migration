@page "/catalog/pos-setup"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.Ops
@using POS.Infrastructure.Logging
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using Newtonsoft.Json

@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuditLogger AuditLogger

<PageTitle>POS Map – POS Dashboard</PageTitle>

@* ── Header ──────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-1">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-2" Style="vertical-align:middle"/>
        POS Map
    </MudText>
    <div class="d-flex align-center gap-2">
        <MudSelect T="int" Value="_autoRefreshSec" ValueChanged="OnAutoRefreshChanged"
                   Label="Tự động" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:140px">
            <MudSelectItem Value="0">Tắt</MudSelectItem>
            <MudSelectItem Value="60">60 giây</MudSelectItem>
            <MudSelectItem Value="120">120 giây</MudSelectItem>
            <MudSelectItem Value="300">5 phút</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadDataAsync" Disabled="_loading"
                   Style="align-self:center; white-space:nowrap">
            @if (_loading)
            { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-1"/> }
            Làm mới
        </MudButton>
    </div>
</div>

@* ── Timestamp ───────────────────────────────────────────────────────── *@
@if (_lastLoaded.HasValue)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
        Lần cuối: @_lastLoaded.Value.ToString("HH:mm:ss")
    </MudText>
}

@* ── Loading bar ─────────────────────────────────────────────────────── *@
@if (_loading && !_allItems.Any())
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"
                       Style="border-radius:4px"/>
}

@* ── KPI summary cards ───────────────────────────────────────────────── *@
@if (_allItems.Any())
{
    var total       = _allItems.Count;
    var online      = _allItems.Count(x => x.IsOnline);
    var offline     = total - online;
    var needsUpdate = _allItems.Count(x => x.NeedsUpdate);
    var disabled    = _allItems.Count(x => !x.IsEnabled);

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" md="3">
            <MudPaper Elevation="2" Class="pa-3 text-center">
                <MudText Typo="Typo.h5" Style="font-weight:700">@total</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng máy POS</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="2" Class="pa-3 text-center"
                      Style="border-left:3px solid var(--pos-success)">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--pos-success)">@online</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">● Online</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="2" Class="pa-3 text-center"
                      Style="border-left:3px solid var(--pos-danger)">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--pos-danger)">@offline</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">● Offline</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="2" Class="pa-3 text-center"
                      Style="border-left:3px solid var(--pos-warning)">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--pos-warning)">@needsUpdate</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">⚠ Cần cập nhật</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@* ── Filter bar ──────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="5">
            <MudTextField Value="_search" Immediate="true"
                          ValueChanged="@((string v) => { _search = v; ApplyFilter(); })"
                          Label="Tìm kiếm" Placeholder="PosNo, Store, IP, Chuỗi, Tên máy, Mã CQT..."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          OnClearButtonClick="@(() => { _search = string.Empty; ApplyFilter(); })"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" Value="_statusFilter" Label="Trạng thái"
                       ValueChanged="@((string v) => { _statusFilter = v; ApplyFilter(); })"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("online")">Chỉ Online</MudSelectItem>
                <MudSelectItem Value="@("offline")">Chỉ Offline</MudSelectItem>
                <MudSelectItem Value="@("update")">Cần cập nhật phần mềm</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Value="_enabledFilter" Label="Sử dụng"
                       ValueChanged="@((string v) => { _enabledFilter = v; ApplyFilter(); })"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("enabled")">Đang bật</MudSelectItem>
                <MudSelectItem Value="@("disabled")">Đang tắt</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Error ───────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── POS list ────────────────────────────────────────────────────────── *@
<MudTable Items="@_filtered" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" Loading="@(_loading && !_allItems.Any())"
          HorizontalScrollbar="true" OnRowClick="@OnRowClick" T="PosTerminalListDto"
          RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.IsOnline ? 0 : 1)">IsOnline</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.No)">PosNo</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.StoreNo)">StoreNo</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.IPAddress ?? string.Empty)">IPAddress</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.StyleProfile ?? string.Empty)">StyleProfile</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.NeedsUpdate ? 1 : 0)">BluePosVersion</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.IsEnabled ? 0 : 1)">Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<PosTerminalListDto, object>(x => x.DateTimePos ?? DateTime.MinValue)">DateTimePos</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="IsOnline">
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.IsOnline ? Color.Success : Color.Error)"
                     Variant="Variant.Filled">
                @(context.IsOnline ? "● Online" : "● Offline")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="PosNo">@context.No</MudTd>
        <MudTd DataLabel="StoreNo">@context.StoreNo</MudTd>
        <MudTd DataLabel="IPAddress">@context.IPAddress</MudTd>
        <MudTd DataLabel="StyleProfile">@context.StyleProfile</MudTd>
        <MudTd DataLabel="BluePosVersion">
            @if (context.NeedsUpdate)
            {
                <MudTooltip Text="@($"Bản mới: {context.BluePosVersionUpdate}")">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                        ⚠ @context.BluePosVersion
                    </MudChip>
                </MudTooltip>
            }
            else
            {
                <MudText Typo="Typo.body2">@context.BluePosVersion</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.IsEnabled ? Color.Success : Color.Default)"
                     Variant="Variant.Outlined">
                @(context.IsEnabled ? "Bật" : "Tắt")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="DateTimePos">
            <MudText Typo="Typo.caption"
                     Color="@(context.IsOnline ? Color.Default : Color.Error)">
                @(context.DateTimePos?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Chưa có")
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary" Class="pa-4" Align="Align.Center">
            @(_allItems.Any() ? "Không có kết quả khớp bộ lọc." : "Không có dữ liệu POSTerminal.")
        </MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private string _currentActor = "unknown";
    private List<PosTerminalListDto> _allItems = [];
    private List<PosTerminalListDto> _filtered = [];
    private bool    _loading        = false;
    private string? _errorMsg;
    private string  _search         = string.Empty;
    private string  _statusFilter   = "all";
    private string  _enabledFilter  = "enabled";
    private int     _autoRefreshSec = 120;
    private DateTime? _lastLoaded;
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        await LoadDataAsync();
        StartAutoRefresh();
    }

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            _allItems   = await MdRepo.GetPosTerminalListAsync();
            _lastLoaded = DateTime.Now;
            FileLogger.WriteLogs($"[PosMapPage.Load] ops: POSTerminal: {_allItems.Count} terminals, {_allItems.Count(x => x.IsOnline)} online");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách POS.";
            FileLogger.WriteExpLogs("PosMapPage.Load", ex);
        }
        finally
        {
            _loading = false;
            ApplyFilter();
        }
    }

    private void ApplyFilter()
    {
        var filtered = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            filtered = filtered.Where(x =>
                x.No.Contains(q, StringComparison.OrdinalIgnoreCase)                          ||
                x.StoreNo.Contains(q, StringComparison.OrdinalIgnoreCase)                     ||
                (x.IPAddress?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)       ||
                (x.StyleProfile?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)    ||
                (x.ComputerName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)    ||
                (x.BillNoseri?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        filtered = _statusFilter switch
        {
            "online"  => filtered.Where(x => x.IsOnline),
            "offline" => filtered.Where(x => !x.IsOnline),
            "update"  => filtered.Where(x => x.NeedsUpdate),
            _         => filtered
        };

        filtered = _enabledFilter switch
        {
            "enabled"  => filtered.Where(x => x.IsEnabled),
            "disabled" => filtered.Where(x => !x.IsEnabled),
            _          => filtered
        };

        _filtered = filtered.ToList();
        StateHasChanged();
    }

    private async Task OnRowClick(TableRowClickEventArgs<PosTerminalListDto> args)
    {
        if (args.Item is null) return;
        var oldJson = JsonConvert.SerializeObject(new { args.Item.No, args.Item.StoreNo, args.Item.IPAddress, args.Item.IsEnabled, args.Item.BillNoseri });
        var dialog = await DialogService.ShowAsync<PosTerminalDetailDialog>(
            $"Chi tiết POS: {args.Item.No} – {args.Item.StoreNo}",
            new DialogParameters<PosTerminalDetailDialog> { { x => x.Item, args.Item } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true,
                                CloseButton = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is PosTerminalSavePayload saved)
        {
            var newJson = JsonConvert.SerializeObject(new { args.Item.No, args.Item.StoreNo, IpAddress = saved.IpAddress, IsEnabled = saved.IsEnabled, BillNoseri = saved.BillNoseri });
            await AuditLogger.LogAsync(_currentActor, "UPDATE", "PosTerminal", args.Item.No, oldJson, newJson);
            Snackbar.Add($"POS {args.Item.No} đã được cập nhật.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private void OnAutoRefreshChanged(int value)
    {
        _autoRefreshSec = value;
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _timer?.Dispose();
        _timer = null;
        if (_autoRefreshSec <= 0) return;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_autoRefreshSec));
        _ = Task.Run(async () =>
        {
            while (await _timer.WaitForNextTickAsync())
                await InvokeAsync(LoadDataAsync);
        });
    }

    public void Dispose() => _timer?.Dispose();
}
