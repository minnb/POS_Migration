@page "/ops/data-raw-log"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject IKibanaService KibanaService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>DataRaw Log – POS Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.DataObject" Class="mr-2" Style="vertical-align:middle"/>
    DataRaw Log — Kafka Message Audit
</MudText>

@* ── Filter ────────────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="Từ ngày" @bind-Date="_fromDate" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="Đến ngày" @bind-Date="_toDate" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_dataTypeFilter" Label="Loại DataType"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList"
                          Clearable="true"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_flagFilter" Label="Trạng thái"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@((bool?)null)">Tất cả</MudSelectItem>
                <MudSelectItem Value="@((bool?)true)">Thành công</MudSelectItem>
                <MudSelectItem Value="@((bool?)false)">Lỗi</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_maxRows" Label="Số dòng"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="100">100</MudSelectItem>
                <MudSelectItem Value="200">200</MudSelectItem>
                <MudSelectItem Value="500">500</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadDataAsync" FullWidth="true"
                           Disabled="_loading">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ResetFilter" FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"/>
}
else if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMsg</MudAlert>
}
else if (_isEmpty)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">Không có dữ liệu trong khoảng thời gian đã chọn.</MudAlert>
}
else
{
    @* ── KPI Row ──────────────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="border-left: 4px solid var(--pos-info)">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">Hôm nay</MudText>
                <MudText Typo="Typo.h4" Style="color:var(--pos-info); font-weight:700">
                    @_summary.TotalToday.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="border-left: 4px solid #9E9E9E">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">Trong kỳ</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:700">
                    @_summary.TotalInPeriod.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="border-left: 4px solid var(--pos-success)">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">Thành công</MudText>
                <MudText Typo="Typo.h4" Style="color:var(--pos-success); font-weight:700">
                    @_summary.TotalSuccess.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="border-left: 4px solid var(--pos-danger)">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">Lỗi</MudText>
                <MudText Typo="Typo.h4" Style="color:var(--pos-danger); font-weight:700">
                    @_summary.TotalFailed.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── DataTable ────────────────────────────────────────────────────────────── *@
    <MudTable Items="@_records"
              Hover="true" Striped="true" Dense="true"
              Breakpoint="Breakpoint.Sm" Elevation="2"
              HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh Style="min-width:140px"><MudTableSortLabel SortBy="new Func<DataRawJsonLogDto, object>(x => x.CrtDate)" InitialDirection="SortDirection.Descending">Thời gian</MudTableSortLabel></MudTh>
            <MudTh Style="min-width:160px">TransactionId</MudTh>
            <MudTh Style="min-width:100px"><MudTableSortLabel SortBy="new Func<DataRawJsonLogDto, object>(x => x.DataType ?? string.Empty)">Loại</MudTableSortLabel></MudTh>
            <MudTh Style="min-width:190px; text-align:center"><MudTableSortLabel SortBy="new Func<DataRawJsonLogDto, object>(x => x.Flag)">Trạng thái</MudTableSortLabel></MudTh>
            <MudTh Style="min-width:260px">Nội dung lỗi</MudTh>
            <MudTh Style="width:60px; text-align:center">JSON</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Thời gian" Style="white-space:nowrap">@context.CrtDate.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="TransactionId" Style="font-family:monospace; font-size:0.8rem">@(context.TransactionId ?? "—")</MudTd>
            <MudTd DataLabel="Loại">
                @if (!string.IsNullOrEmpty(context.DataType))
                {
                    <span style="background:var(--pos-info); color:#fff; border-radius:4px; padding:2px 8px; font-size:0.75rem; font-weight:600">@context.DataType</span>
                }
                else
                {
                    <span>—</span>
                }
            </MudTd>
            <MudTd DataLabel="Trạng thái" Style="text-align:center">
                @if (context.Flag)
                {
                    <span style="background:var(--pos-success); color:#fff; border-radius:4px; padding:2px 10px; font-size:0.75rem; font-weight:600">✓ OK</span>
                }
                else
                {
                    <div class="d-flex align-center justify-center gap-2 flex-wrap">
                        <span style="background:var(--pos-danger); color:#fff; border-radius:4px; padding:2px 10px; font-size:0.75rem; font-weight:600">✗ Lỗi</span>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_retrying.Contains(context.Id)"
                                   OnClick="@(() => RetryAsync(context))">
                            @(_retrying.Contains(context.Id) ? "Đang xử lý…" : "RETRY")
                        </MudButton>
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Nội dung lỗi">
                @if (!string.IsNullOrEmpty(context.Source))
                {
                    var (srcBg, srcLabel) = context.Source.ToUpperInvariant() switch
                    {
                        "WORKER" => ("#7E57C2", "WORKER"),
                        "WEB"    => ("var(--pos-info)", "WEB"),
                        _        => ("#9E9E9E", context.Source)
                    };
                    <span style="background:@srcBg; color:#fff; border-radius:4px; padding:2px 8px; font-size:0.7rem; font-weight:600; margin-right:6px">@srcLabel</span>
                }
                @if (!context.Flag && !string.IsNullOrEmpty(context.ErrorMessage))
                {
                    var msg = context.ErrorMessage;
                    var truncated = msg.Length > 100 ? msg[..100] + "…" : msg;
                    @if (msg.Length > 100)
                    {
                        <MudTooltip Text="@msg" Placement="Placement.Top">
                            <span style="cursor:help; color:var(--pos-danger)">@truncated</span>
                        </MudTooltip>
                    }
                    else
                    {
                        <span style="color:var(--pos-danger)">@truncated</span>
                    }
                }
                else if (string.IsNullOrEmpty(context.Source))
                {
                    <span style="color:var(--mud-palette-text-secondary)">—</span>
                }
            </MudTd>
            <MudTd DataLabel="JSON" Style="text-align:center">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Size="Size.Small" Color="Color.Primary"
                               title="Xem Message JSON"
                               OnClick="@(() => OpenMessageDialog(context))"/>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                           InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                           RowsPerPageString="Số dòng mỗi trang:"/>
        </PagerContent>
    </MudTable>

    <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--mud-palette-text-secondary)">
        Hiển thị @_records.Count dòng (tối đa @_maxRows)
    </MudText>
}

@* ── Message Dialog ────────────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DataObject" Class="mr-2" Style="vertical-align:middle"/>
            Message — @(_selectedRecord?.TransactionId ?? "—")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Style="max-height:60vh; overflow-y:auto; background:var(--mud-palette-background-grey)">
            <pre style="margin:0; padding:16px; font-size:0.8rem; white-space:pre-wrap; word-break:break-all">@_formattedMessage</pre>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy"
                   OnClick="CopyMessageAsync">Sao chép</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => _dialogOpen = false)">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool    _loading  = true;
    private bool    _isEmpty;
    private string? _errorMsg;

    private DateTime? _fromDate      = DateTime.Today;
    private DateTime? _toDate        = DateTime.Today;
    private string?   _dataTypeFilter;
    private bool?     _flagFilter;
    private int       _maxRows       = 100;

    private DataRawJsonSummaryDto    _summary = new();
    private List<DataRawJsonLogDto>  _records = [];

    // Theo dõi các dòng đang retry để disable nút + hiện spinner, tránh double-click.
    private readonly HashSet<Guid> _retrying = [];

    private bool                _dialogOpen;
    private DataRawJsonLogDto?  _selectedRecord;
    private string              _formattedMessage = string.Empty;
    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        var state    = await AuthState;
        var userName = state.User.Identity?.Name ?? "unknown";
        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu DataRaw Log.";
            KibanaService.LogException("DataRawLogPage.OnInitialized", userName, 0, "", ex.Message);
        }
        finally { _loading = false; }
    }

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _isEmpty  = false;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            var from = (_fromDate ?? DateTime.Today).Date;
            var to   = (_toDate   ?? DateTime.Today).Date;

            var summaryTask = SaleRepo.GetDataRawJsonSummaryAsync(from, to);
            var listTask    = SaleRepo.GetDataRawJsonListAsync(from, to, _dataTypeFilter, _flagFilter, _maxRows);

            await Task.WhenAll(summaryTask, listTask);

            _summary = summaryTask.Result;
            _records = listTask.Result;
            _isEmpty = _records.Count == 0;

            var state    = await AuthState;
            var userName = state.User.Identity?.Name ?? "unknown";
            KibanaService.LogInfo("DataRawLogPage.LoadData", userName,
                $"Loaded {_records.Count} records from {from:dd/MM} to {to:dd/MM}");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu DataRaw Log.";
            KibanaService.LogException("DataRawLogPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilter()
    {
        _fromDate       = DateTime.Today;
        _toDate         = DateTime.Today;
        _dataTypeFilter = null;
        _flagFilter     = null;
        _maxRows        = 100;
        await LoadDataAsync();
    }

    private void OpenMessageDialog(DataRawJsonLogDto record)
    {
        _selectedRecord   = record;
        _formattedMessage = TryFormatJson(record.Message);
        _dialogOpen       = true;
    }

    private async Task CopyMessageAsync()
    {
        Snackbar.Add("Đã sao chép nội dung Message.", Severity.Success);
        await Task.CompletedTask;
    }

    // Suy ra (StoreNo, PosNo) từ TransactionId theo loại DataType.
    // SALE        : StoreNo = 4 ký tự đầu, PosNo = 6 ký tự đầu của TransactionId.
    // Khác SALE   : tách theo '_', lấy đoạn toàn chữ số dài nhất làm PosNo (6 chữ số),
    //               StoreNo = 4 ký tự đầu của PosNo (PosNo luôn bắt đầu bằng StoreNo).
    private static (string StoreNo, string PosNo) ResolveStoreAndPos(string? transactionId, string? dataType)
    {
        var id = (transactionId ?? string.Empty).Trim();
        if (id.Length == 0) return (string.Empty, string.Empty);

        var isSale = string.Equals(dataType?.Trim(), "SALE", StringComparison.OrdinalIgnoreCase);

        // SALE (hoặc id không có '_' = chuỗi liền) → cắt theo vị trí
        if (isSale || !id.Contains('_'))
        {
            var store = id.Length >= 4 ? id[..4] : id;
            var pos   = id.Length >= 6 ? id[..6] : id;
            return (store, pos);
        }

        // Khác SALE: Register_1535_153599 | DOCNO_153599 | EOD_1535_153599_18-06-2026
        var posNo = id.Split('_', StringSplitOptions.RemoveEmptyEntries)
                      .Where(s => s.Length > 0 && s.All(char.IsDigit))
                      .OrderByDescending(s => s.Length)
                      .FirstOrDefault() ?? string.Empty;
        var storeNo = posNo.Length >= 4 ? posNo[..4] : posNo;
        return (storeNo, posNo);
    }

    private async Task RetryAsync(DataRawJsonLogDto row)
    {
        // Chốt chống double-submit phải set TRƯỚC khi mở dialog: HashSet.Add trả false
        // nếu dòng đang retry → chặn click thứ 2 cùng dòng kể cả lúc dialog đang mở.
        if (!_retrying.Add(row.Id)) return;
        StateHasChanged();
        try
        {
            var (storeNo, posNo) = ResolveStoreAndPos(row.TransactionId, row.DataType);
            if (string.IsNullOrEmpty(storeNo) || string.IsNullOrEmpty(posNo))
            {
                Snackbar.Add($"Không xác định được StoreNo/PosNo từ TransactionId '{row.TransactionId}'.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                // Một dòng — MudMessageBox render Message dạng text nên '\n' chỉ thành dấu cách.
                ["Message"]    = $"Thực thi lại transaction '{row.TransactionId}'? (Store {storeNo} / POS {posNo})",
                ["YesText"]    = "Retry",
                ["CancelText"] = "Hủy"
            };
            var dialog = await DialogService.ShowAsync<MudMessageBox>("Xác nhận Retry", parameters,
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var confirm = await dialog.Result;
            if (confirm is null or { Canceled: true }) return;

            var state    = await AuthState;
            var userName = state.User.Identity?.Name ?? "unknown";

            var (ok, msg) = await SaleRepo.InInsertToTableByJson(storeNo, posNo, row.TransactionId ?? "", row.Message ?? "", "WEB");
            if (ok)
            {
                Snackbar.Add($"Retry thành công: {row.TransactionId}", Severity.Success);
                KibanaService.LogInfo("DataRawLogPage.Retry", userName,
                    $"Retry OK {row.TransactionId} (store {storeNo}/pos {posNo})");
                await LoadDataAsync();   // reload: KPI + thời gian + filter khớp DB tuyệt đối
            }
            else
            {
                row.ErrorMessage = msg;  // cập nhật tooltip lỗi tại chỗ, không reload
                Snackbar.Add($"Retry thất bại: {msg}", Severity.Error);
                KibanaService.LogException("DataRawLogPage.Retry", userName, 0, "", $"{row.TransactionId}: {msg}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi retry: {ex.Message}", Severity.Error);
            KibanaService.LogException("DataRawLogPage.Retry", "", 0, "", ex.Message);
        }
        finally
        {
            _retrying.Remove(row.Id);
            StateHasChanged();
        }
    }

    private static string TryFormatJson(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "(trống)";
        try
        {
            var obj = Newtonsoft.Json.JsonConvert.DeserializeObject(raw);
            return Newtonsoft.Json.JsonConvert.SerializeObject(obj, Newtonsoft.Json.Formatting.Indented);
        }
        catch
        {
            return raw;
        }
    }
}
