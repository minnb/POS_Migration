@namespace POS.Web.Components.Pages.Ops
@using MudBlazor
@using POS.Common.Dtos.CentralMD
@using POS.Infrastructure.Repositories.Interfaces

@inject ICentralMDRepository MdRepo

<MudDialog>
    <DialogContent>
        @* ── Trạng thái tổng quan ───────────────────────────────────────── *@
        <div class="d-flex align-center gap-2 flex-wrap mb-4">
            @if (_editMode)
            {
                <MudSelect T="int" @bind-Value="_editClosingMethod" Label="Trạng thái"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft" Style="max-width:240px">
                    <MudSelectItem T="int" Value="0">Đang hoạt động</MudSelectItem>
                    <MudSelectItem T="int" Value="1">Đã đóng</MudSelectItem>
                </MudSelect>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(Item.IsActive ? Color.Success : Color.Error)">
                    @(Item.IsActive ? "● Hoạt động" : "● Đã đóng")
                </MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(Item.StyleProfile))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                    @Item.StyleProfile
                </MudChip>
            }
        </div>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600">Thông tin cơ bản</MudText>
            <MudGrid Spacing="2">
                @Field("Mã cửa hàng", Item.StoreNo)
                @Field("Tên cửa hàng", Item.Name)
                @Field("Địa chỉ", Item.Address)
                @Field("ĐT liên hệ", Item.PhoneNo)
                @Field("Chi nhánh / Tỉnh thành", Item.BranchNo)
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600">Cấu hình POS</MudText>
            <MudGrid Spacing="2">
                @Field("Channel (StyleProfile)", Item.StyleProfile)
                @Field("SĐT in trên bill (PrintReceiptLogo)", Item.PrintReceiptLogo)
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600">Audit</MudText>
            <MudGrid Spacing="2">
                @Field("Cập nhật lần cuối", Item.LastDateModified?.ToString("yyyy-MM-dd HH:mm:ss"))
            </MudGrid>
        </MudPaper>

        @if (_errorMsg != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_errorMsg</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_editMode)
        {
            <MudButton OnClick="CancelEdit" Variant="Variant.Text" Disabled="@_saving">Hủy</MudButton>
            <MudButton OnClick="SaveAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_saving"
                       StartIcon="@(_saving ? null : Icons.Material.Filled.Save)">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                }
                Lưu
            </MudButton>
        }
        else
        {
            <MudButton OnClick="CloseDialog" Variant="Variant.Outlined" Color="Color.Secondary">Đóng</MudButton>
            <MudButton OnClick="StartEdit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">
                Sửa
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public StoreListDto Item { get; set; } = null!;

    private bool _editMode;
    private bool _saving;
    private int _editClosingMethod;
    private string? _errorMsg;

    private void CloseDialog() => MudDialog.Close();

    private void StartEdit()
    {
        _editClosingMethod = Item.ClosingMethod;
        _errorMsg = null;
        _editMode = true;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _errorMsg = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errorMsg = null;
        try
        {
            var ok = await MdRepo.UpdateStoreClosingMethodAsync(Item.StoreNo, _editClosingMethod);
            if (ok)
                MudDialog.Close(DialogResult.Ok(_editClosingMethod));
            else
                _errorMsg = "Cập nhật thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment Field(string label, string? value) => __builder =>
    {
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:500">
                @(string.IsNullOrWhiteSpace(value) ? "—" : value)
            </MudText>
        </MudItem>
    };
}
