@page "/catalog/stores"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Newtonsoft.Json
@using POS.Common.Dtos.CentralMD
@using POS.Infrastructure.Logging
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth

@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject IDialogService DialogService
@inject IAuditLogger AuditLogger
@inject ISnackbar Snackbar

<PageTitle>Cửa hàng – POS Dashboard</PageTitle>

@* ── Header ──────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-2" Style="vertical-align:middle"/>
        Danh sách Cửa hàng
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddBusiness"
               OnClick="OpenCreateDialogAsync"
               Class="pos-page-header-btn">
        Thêm cửa hàng
    </MudButton>
</div>

@* ── Loading bar ─────────────────────────────────────────────────────── *@
@if (_loading && !_allItems.Any())
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"
                       Style="border-radius:4px"/>
}

@* ── KPI summary cards ───────────────────────────────────────────────── *@
@if (_allItems.Any())
{
    var total    = _allItems.Count;
    var active   = _allItems.Count(x => x.IsActive);
    var closed   = total - active;

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" md="4">
            <MudPaper Elevation="2" Class="pa-3 text-center">
                <MudText Typo="Typo.h5" Style="font-weight:700">@total</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng cửa hàng</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Elevation="2" Class="pa-3 text-center"
                      Style="border-left:3px solid var(--pos-success)">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--pos-success)">@active</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Đang hoạt động</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Elevation="2" Class="pa-3 text-center"
                      Style="border-left:3px solid var(--pos-danger)">
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--pos-danger)">@closed</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Đã đóng</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@* ── Filter bar ──────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="7">
            <MudTextField Value="_search" Immediate="true"
                          ValueChanged="@((string v) => { _search = v; ApplyFilter(); })"
                          Label="Tìm kiếm" Placeholder="Mã CH, Tên, Địa chỉ, Chi nhánh..."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          OnClearButtonClick="@(() => { _search = string.Empty; ApplyFilter(); })"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="5">
            <MudSelect T="string" Value="_statusFilter" Label="Trạng thái"
                       ValueChanged="@((string v) => { _statusFilter = v; ApplyFilter(); })"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("active")">Đang hoạt động</MudSelectItem>
                <MudSelectItem Value="@("closed")">Đã đóng</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Error ───────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Store list ──────────────────────────────────────────────────────── *@
<MudTable Items="@_filtered" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" Loading="@(_loading && !_allItems.Any())"
          HorizontalScrollbar="true" OnRowClick="@OnRowClick" T="StoreListDto"
          RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.StoreNo)">StoreNo</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.Name ?? string.Empty)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.Address ?? string.Empty)">Address</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.BranchNo ?? string.Empty)">BranchNo</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.IsActive ? 0 : 1)">Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<StoreListDto, object>(x => x.LastDateModified ?? DateTime.MinValue)">LastDateModified</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="StoreNo">@context.StoreNo</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Address">@context.Address</MudTd>
        <MudTd DataLabel="BranchNo">@(context.BranchNo ?? "—")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.IsActive ? Color.Success : Color.Error)"
                     Variant="Variant.Filled">
                @(context.IsActive ? "● Hoạt động" : "● Đã đóng")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="LastDateModified">
            <MudText Typo="Typo.caption">
                @(context.LastDateModified?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary" Class="pa-4" Align="Align.Center">
            @(_allItems.Any() ? "Không có kết quả khớp bộ lọc." : "Không có dữ liệu cửa hàng.")
        </MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private List<StoreListDto> _allItems = [];
    private List<StoreListDto> _filtered = [];
    private bool    _loading;
    private string? _errorMsg;
    private string  _search       = string.Empty;
    private string  _statusFilter = "active";
    private string  _currentActor = "unknown";
    private List<BranchDto> _allBranches = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        try
        {
            _allBranches = await MdRepo.GetBranchListAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("StorePage.LoadBranches", ex);
        }
        await LoadDataAsync();
    }

    // ── Thêm cửa hàng ─────────────────────────────────────────────────────
    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<StoreCreateDialog>
        {
            { x => x.Branches, _allBranches }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Medium,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<StoreCreateDialog>("Thêm cửa hàng", parameters, options);

        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is StoreCreateDto saved)
        {
            await AuditLogger.LogAsync(_currentActor, "CREATE", "Store",
                saved.StoreNo, oldValueJson: null,
                newValueJson: JsonConvert.SerializeObject(saved));

            Snackbar.Add($"Đã thêm cửa hàng \"{saved.StoreNo}\".", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            _allItems = await MdRepo.GetStoreAdminListAsync();
            FileLogger.WriteLogs($"[StorePage.Load] ops: Stores: {_allItems.Count} total, {_allItems.Count(x => x.IsActive)} active");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách cửa hàng.";
            FileLogger.WriteExpLogs("StorePage.Load", ex);
        }
        finally
        {
            _loading = false;
            ApplyFilter();
        }
    }

    private void ApplyFilter()
    {
        var filtered = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            filtered = filtered.Where(x =>
                x.StoreNo.Contains(q, StringComparison.OrdinalIgnoreCase)                    ||
                (x.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)           ||
                (x.Address?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)        ||
                (x.BranchNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)       ||
                (x.StyleProfile?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        filtered = _statusFilter switch
        {
            "active" => filtered.Where(x => x.IsActive),
            "closed" => filtered.Where(x => !x.IsActive),
            _        => filtered
        };

        _filtered = filtered.ToList();
        StateHasChanged();
    }

    private async Task OnRowClick(TableRowClickEventArgs<StoreListDto> args)
    {
        if (args.Item is null) return;
        var oldClosingMethod = args.Item.ClosingMethod;
        var dialog = await DialogService.ShowAsync<StoreDetailDialog>(
            $"Chi tiết: {args.Item.StoreNo} – {args.Item.Name}",
            new DialogParameters<StoreDetailDialog> { { x => x.Item, args.Item } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true,
                                CloseButton = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int newClosingMethod)
        {
            await AuditLogger.LogAsync(_currentActor, "UPDATE", "Store",
                args.Item.StoreNo,
                oldValueJson: JsonConvert.SerializeObject(new { ClosingMethod = oldClosingMethod }),
                newValueJson: JsonConvert.SerializeObject(new { ClosingMethod = newClosingMethod }));

            Snackbar.Add($"Đã cập nhật trạng thái cửa hàng \"{args.Item.StoreNo}\".", Severity.Success);
            await LoadDataAsync();
        }
    }
}
