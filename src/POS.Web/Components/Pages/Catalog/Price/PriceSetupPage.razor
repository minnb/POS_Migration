@page "/catalog/price-setup"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Newtonsoft.Json
@using POS.Application.Features.Price
@using POS.Common.Dtos.Price
@using POS.Common.Dtos.Promotion
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Services
@using ClosedXML.Excel

@inject IPriceService PriceService
@inject ISnackbar Snackbar
@inject IAuditLogger AuditLogger
@inject IFileLogHelper FileLogger
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Setup giá – POS Dashboard</PageTitle>

<style>
    /* Lưới setup giá: thu nhỏ chữ để text/date/select hiện đầy đủ, dòng gọn hơn */
    .pos-price-grid td { padding-top: 3px; padding-bottom: 3px; vertical-align: middle; }
    .pos-price-grid .mud-input-control { font-size: .8125rem; }
    .pos-price-grid input,
    .pos-price-grid .mud-input-slot,
    .pos-price-grid .mud-select .mud-select-input { font-size: .8125rem; }
    .pos-price-grid .mud-input.mud-input-dense .mud-input-slot { min-height: 30px; }
    .pos-price-grid .mud-input-adornment .mud-icon-root { font-size: 1rem; }
</style>

@* ── Header ─────────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Sell" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Setup giá
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="pos-page-header-btn"
               StartIcon="@Icons.Material.Filled.FormatListBulleted"
               OnClick="@(() => Nav.NavigateTo("/catalog/prices"))">
        Danh sách giá
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"/>
}
else
{
    @if (_errorMsg != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
    }

    @* ── Ngữ cảnh + khai báo / import ───────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" Value="_declType" ValueChanged="OnDeclTypeChangedAsync" Label="Loại khai báo"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var d in _lookup.DeclarationTypes)
                    {
                        <MudSelectItem T="string" Value="@d.Value">@d.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" @bind-Value="_salesType" Label="Hình thức bán hàng *"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var s in _lookup.SalesTypes)
                    {
                        <MudSelectItem T="string" Value="@s.Value">@s.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" @bind-Value="_priceGroup" Label="Nhóm giá" Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Placeholder="Tất cả (ALL)">
                    @foreach (var g in _lookup.PriceGroups)
                    {
                        <MudSelectItem T="string" Value="@g.Value">@g.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudNumericField T="int" @bind-Value="_declareCount" Label="Số lượng khai báo"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="500"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="DeclareRows">
                    Khai báo giá bán
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="8" md="4" Class="d-flex align-center gap-2 flex-wrap">
                <MudFileUpload T="IBrowserFile" @bind-Files="_importFile" Accept=".xls,.xlsx" MaximumFileCount="1">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.UploadFile">
                            @(_importFile?.Name ?? "Chọn file Excel")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                           Disabled="_importFile == null || _validating" OnClick="LoadImportAsync">
                    @(_validating ? "Đang nạp..." : "Import giá bán")
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="4" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplateAsync">
                    File mẫu
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Toolbar lưới ───────────────────────────────────────────────────── *@
    <div class="d-flex align-center gap-2 mb-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddBlankRow">Thêm dòng</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Disabled="_rows.Count == 0" OnClick="ClearRows">Xóa toàn bộ bảng giá</MudButton>
        <MudSpacer/>
        @if (_rows.Count > 0)
        {
            <div class="d-flex gap-2 flex-wrap">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Tổng: @_rows.Count</MudChip>
                @if (_errorCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Lỗi: @_errorCount</MudChip>
                }
            </div>
        }
    </div>

    @* ── Lưới khai báo / preview ────────────────────────────────────────── *@
    <MudTable Items="@_rows" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
              Elevation="2" HorizontalScrollbar="true" T="PriceEditRow"
              RowStyleFunc="@RowStyle" Class="pos-price-grid">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh Style="width:1%; white-space:nowrap">Nhóm giá</MudTh>
            <MudTh Style="width:300px">Sản phẩm</MudTh>
            @if (!IsBarcodeMode)
            {
                <MudTh Style="width:120px">Đơn vị tính</MudTh>
            }
            <MudTh Style="width:130px">Giá bán *</MudTh>
            <MudTh Style="width:150px">Từ ngày *</MudTh>
            <MudTh Style="width:150px">Đến ngày *</MudTh>
            <MudTh Style="width:44px">#</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">
                <div class="d-flex align-center gap-1">
                    <span>@(_rows.IndexOf(context) + 1)</span>
                    @if (context.HasError)
                    {
                        <MudTooltip Text="@context.Error">
                            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small"/>
                        </MudTooltip>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Nhóm giá" Style="white-space:nowrap">@PriceGroupText</MudTd>
            <MudTd DataLabel="Sản phẩm">
                @if (IsBarcodeMode)
                {
                    <MudTextField @bind-Value="context.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="Nhập barcode" Immediate="false"
                                  OnBlur="@(() => ResolveBarcodeAsync(context))"
                                  HelperText="@context.ItemName" HelperTextOnFocus="false"/>
                }
                else
                {
                    <MudAutocomplete T="ItemOptionDto" Value="context.SelectedItem"
                                     ValueChanged="@(i => OnItemSelectedAsync(context, i))"
                                     SearchFunc="@SearchItemAsync" ToStringFunc="@ItemToString"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                     Placeholder="Chọn sản phẩm" Clearable="true"
                                     MinCharacters="0" MaxItems="50"/>
                }
            </MudTd>
            @if (!IsBarcodeMode)
            {
                <MudTd DataLabel="Đơn vị tính">
                    <MudSelect T="string" @bind-Value="context.UOM" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Dense="true" Placeholder="Chọn UOM" Disabled="context.UomOptions.Count == 0">
                        @foreach (var u in context.UomOptions)
                        {
                            <MudSelectItem T="string" Value="@u">@u</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
            }
            <MudTd DataLabel="Giá bán">
                <MudTextField @bind-Value="context.UnitPrice" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputMode="InputMode.numeric" Immediate="true"/>
            </MudTd>
            <MudTd DataLabel="Từ ngày">
                <MudDatePicker @bind-Date="context.StartDate" DateFormat="dd/MM/yyyy" AutoClose="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudTd>
            <MudTd DataLabel="Đến ngày">
                <MudDatePicker @bind-Date="context.EndDate" DateFormat="dd/MM/yyyy" AutoClose="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudTd>
            <MudTd DataLabel="#">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => _rows.Remove(context))"/>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
                <MudText Typo="Typo.body2">Chưa có dòng nào. Nhập "Số lượng khai báo" rồi bấm "Khai báo giá bán", hoặc Import Excel.</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>

    @* ── Action bar ─────────────────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pa-3 mt-4 d-flex justify-end gap-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving || _rows.Count == 0" OnClick="SaveAsync">
            @(_saving ? "Đang lưu..." : "Lưu bảng giá")
        </MudButton>
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private PriceSetupLookupDto _lookup = new();
    private string _declType = string.Empty;
    private string _salesType = string.Empty;
    private string _priceGroup = string.Empty;
    private int _declareCount = 10;

    private readonly List<PriceEditRow> _rows = [];
    private IBrowserFile? _importFile;
    private int _errorCount;

    private bool _loading = true;
    private bool _saving;
    private bool _validating;
    private string? _errorMsg;
    private string _currentActor = "unknown";

    private bool IsBarcodeMode => _declType == "BARCODE";

    // Echo giá trị panel xuống từng dòng lưới (read-only).
    private string PriceGroupText
        => _lookup.PriceGroups.FirstOrDefault(g => g.Value == _priceGroup)?.Text
           ?? (string.IsNullOrEmpty(_priceGroup) ? "ALL" : _priceGroup);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";

        try
        {
            _lookup = await PriceService.GetSetupLookupAsync();
            _declType = _lookup.DeclarationTypes.FirstOrDefault()?.Value ?? string.Empty;
            // Mặc định Hình thức bán hàng = "Tại chỗ" (fallback: option đầu tiên).
            _salesType = _lookup.SalesTypes.FirstOrDefault(s =>
                             s.Text.Contains("Tại chỗ", StringComparison.OrdinalIgnoreCase))?.Value
                         ?? _lookup.SalesTypes.FirstOrDefault()?.Value ?? string.Empty;
            // Mặc định Nhóm giá = "ALL".
            _priceGroup = "ALL";
        }
        catch (Exception ex)
        {
            _errorMsg = "Không tải được dữ liệu khai báo (Hình thức bán hàng / Nhóm giá).";
            FileLogger.WriteExpLogs("PriceSetupPage.LoadLookup", ex);
        }

        _loading = false;
    }

    // ── Chọn sản phẩm inline ──────────────────────────────────────────────────
    private async Task<IEnumerable<ItemOptionDto>> SearchItemAsync(string value, CancellationToken ct)
    {
        try
        {
            var items = await PriceService.SearchItemsAsync(value ?? string.Empty, ct);
            return items.Take(50);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PriceSetupPage.SearchItem", ex);
            return [];
        }
    }

    private static string ItemToString(ItemOptionDto? i)
        => i == null ? string.Empty
           : string.IsNullOrEmpty(i.Description) ? i.No : $"{i.No}-{i.Description}";

    private async Task OnItemSelectedAsync(PriceEditRow row, ItemOptionDto? item)
    {
        row.SelectedItem = item;
        row.ItemNo = item?.No ?? string.Empty;
        row.ItemName = ItemToString(item);
        row.UOM = string.Empty;
        row.UomOptions = [];

        if (item != null && !string.IsNullOrWhiteSpace(item.No))
        {
            try
            {
                row.UomOptions = await PriceService.GetItemUomsAsync(item.No);
                if (row.UomOptions.Count == 0 && !string.IsNullOrWhiteSpace(item.Uom))
                    row.UomOptions = [item.Uom];
                row.UOM = row.UomOptions.FirstOrDefault() ?? string.Empty;
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("PriceSetupPage.LoadUoms", ex);
            }
        }
    }

    // ── Barcode: tra ItemNo/UOM (tái dùng ValidateImportAsync — nhánh barcode) ──
    private async Task ResolveBarcodeAsync(PriceEditRow row)
    {
        var code = row.Barcode?.Trim() ?? string.Empty;
        row.ItemNo = string.Empty;
        row.UOM = string.Empty;
        row.ItemName = string.Empty;
        row.Error = null;

        if (code.Length == 0) { RecalcErrors(); return; }

        try
        {
            var res = await PriceService.ValidateImportAsync(new[] { new PriceImportRow { Barcode = code } });
            var r = res.FirstOrDefault();
            if (r == null || !string.IsNullOrWhiteSpace(r.ErrorMessage) || string.IsNullOrWhiteSpace(r.ItemNo))
            {
                row.Error = string.IsNullOrWhiteSpace(r?.ErrorMessage)
                    ? $"Barcode {code} không tồn tại"
                    : r.ErrorMessage;
            }
            else
            {
                row.ItemNo = r.ItemNo!;
                row.UOM = r.Uom ?? string.Empty;
                row.ItemName = r.Text ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PriceSetupPage.ResolveBarcode", ex);
            row.Error = "Không tra được barcode";
        }
        RecalcErrors();
    }

    // ── Đổi Loại khai báo → xóa dòng (barcode vs item+đvt không tương thích) ─────
    private async Task OnDeclTypeChangedAsync(string val)
    {
        if (val == _declType) return;
        if (_rows.Count > 0 &&
            !await JS.InvokeAsync<bool>("confirm", "Đổi loại khai báo sẽ xóa các dòng đang nhập. Tiếp tục?"))
            return;   // hủy: giữ _declType cũ → MudSelect tự revert (Value bound)

        _declType = val;
        ClearRows();
    }

    // ── Khai báo tay ──────────────────────────────────────────────────────────
    private void AddBlankRow() => _rows.Add(NewBlankRow());

    private void DeclareRows()
    {
        var n = Math.Clamp(_declareCount, 1, 500);
        for (var i = 0; i < n; i++) _rows.Add(NewBlankRow());
    }

    private static PriceEditRow NewBlankRow() => new()
    {
        StartDate = DateTime.Today,
        EndDate = new DateTime(9999, 12, 31)
    };

    // ── Import Excel ─────────────────────────────────────────────────────────
    private async Task LoadImportAsync()
    {
        if (_importFile == null) return;
        _validating = true;
        try
        {
            var raw = await ReadImportFileAsync(_importFile);
            if (raw.Count == 0)
            {
                Snackbar.Add("File không có dòng dữ liệu nào.", Severity.Warning);
                return;
            }

            var results = await PriceService.ValidateImportAsync(raw);
            foreach (var v in results)
            {
                var itemNo = v.ItemNo ?? string.Empty;
                var uom = v.Uom ?? string.Empty;
                _rows.Add(new PriceEditRow
                {
                    ItemNo   = itemNo,
                    Barcode  = v.Barcode ?? string.Empty,
                    ItemName = v.Text ?? string.Empty,
                    UOM      = uom,
                    UomOptions = string.IsNullOrWhiteSpace(uom) ? [] : [uom],
                    SelectedItem = BuildOption(itemNo, v.Text, uom),
                    UnitPrice = v.UnitPrice ?? string.Empty,
                    StartDate = ParseDmy(v.StartingDate),
                    EndDate   = ParseDmy(v.EndingDate),
                    Error     = string.IsNullOrWhiteSpace(v.ErrorMessage) ? null : v.ErrorMessage
                });
            }
            RecalcErrors();
            _importFile = null;
            Snackbar.Add(_errorCount > 0
                ? $"Đã nạp {results.Count} dòng, có {_errorCount} dòng lỗi — vui lòng kiểm tra."
                : $"Đã nạp {results.Count} dòng hợp lệ.",
                _errorCount > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PriceSetupPage.LoadImport", ex);
            Snackbar.Add("Không đọc/validate được file Excel. Kiểm tra đúng định dạng file mẫu.", Severity.Error);
        }
        finally { _validating = false; }
    }

    private static ItemOptionDto? BuildOption(string itemNo, string? text, string uom)
    {
        if (string.IsNullOrWhiteSpace(itemNo)) return null;
        var desc = text ?? string.Empty;
        var prefix = itemNo + "-";
        if (desc.StartsWith(prefix, StringComparison.Ordinal)) desc = desc[prefix.Length..];
        return new ItemOptionDto { No = itemNo, Description = desc, Uom = uom };
    }

    private static async Task<List<PriceImportRow>> ReadImportFileAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
        ms.Position = 0;
        using var wb = new XLWorkbook(ms);
        var ws = wb.Worksheet(1);
        var rows = new List<PriceImportRow>();
        var last = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= last; r++)   // bỏ header dòng 1
        {
            if (ws.Row(r).IsEmpty()) continue;
            rows.Add(new PriceImportRow
            {
                ItemNo       = ws.Cell(r, 1).GetString().Trim(),
                Barcode      = ws.Cell(r, 2).GetString().Trim(),
                Uom          = ws.Cell(r, 3).GetString().Trim(),
                UnitPrice    = ws.Cell(r, 4).GetString().Trim(),
                StartingDate = CellDate(ws.Cell(r, 5)),
                EndingDate   = CellDate(ws.Cell(r, 6))
            });
        }
        return rows;
    }

    private static string CellDate(IXLCell c)
        => c.DataType == XLDataType.DateTime && c.TryGetValue<DateTime>(out var dt)
            ? dt.ToString("dd/MM/yyyy")
            : c.GetString().Trim();

    private async Task DownloadTemplateAsync()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("DataImport");
        string[] headers = ["ItemNo", "Barcode", "UOM", "UnitPrice", "StartingDate", "EndingDate"];
        for (var c = 0; c < headers.Length; c++) ws.Cell(1, c + 1).Value = headers[c];
        ws.Row(1).Style.Font.Bold = true;
        ws.Cell(2, 1).Value = "65000165";
        ws.Cell(2, 3).Value = "GOI";
        ws.Cell(2, 4).Value = 20000;
        ws.Cell(2, 5).Value = DateTime.Today.ToString("dd/MM/yyyy");
        ws.Cell(2, 6).Value = DateTime.Today.AddMonths(1).ToString("dd/MM/yyyy");
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.SaveAsFileAsync($"FileMauBangGia_{DateTime.Now:yyyyMMddHHmmss}.xlsx", ms.ToArray(),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private void ClearRows()
    {
        _rows.Clear();
        _errorCount = 0;
    }

    // ── Lưu ───────────────────────────────────────────────────────────────────
    private async Task SaveAsync()
    {
        if (_rows.Count == 0) { Snackbar.Add("Chưa có dòng bảng giá nào.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_salesType)) { Snackbar.Add("Vui lòng chọn Hình thức bán hàng.", Severity.Warning); return; }
        if (_errorCount > 0) { Snackbar.Add($"Còn {_errorCount} dòng lỗi. Vui lòng xóa/sửa trước khi lưu.", Severity.Warning); return; }

        var context = new PriceSetupContext
        {
            SalesType = _salesType,
            SalesCode = string.IsNullOrWhiteSpace(_priceGroup) ? "ALL" : _priceGroup
        };
        var rows = _rows.Select(r => new PriceSaveRow
        {
            ItemNo = r.ItemNo,
            Barcode = r.Barcode,
            UOM = r.UOM,
            UnitPrice = r.UnitPrice,
            StartDate = r.StartDate?.ToString("dd/MM/yyyy") ?? string.Empty,
            EndDate = r.EndDate?.ToString("dd/MM/yyyy") ?? string.Empty
        }).ToList();

        _saving = true;
        try
        {
            var result = await PriceService.SaveAsync(context, rows, _currentActor);
            if (!result.Ok)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            await AuditLogger.LogAsync(_currentActor, "CREATE", "SalesPrice",
                $"{context.SalesType}/{context.SalesCode} ({rows.Count} dòng)",
                oldValueJson: null, newValueJson: JsonConvert.SerializeObject(rows));

            Snackbar.Add(result.Message, Severity.Success);
            ClearRows();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PriceSetupPage.Save", ex);
            Snackbar.Add($"Lưu bảng giá thất bại: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    private void RecalcErrors() => _errorCount = _rows.Count(r => r.HasError);

    private static string RowStyle(PriceEditRow row, int _)
        => row.HasError ? "background-color:#fdecea" : string.Empty;

    private static DateTime? ParseDmy(string? dmy)
        => DateTime.TryParseExact(dmy, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    private sealed class PriceEditRow
    {
        public string ItemNo { get; set; } = string.Empty;
        public string Barcode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string UOM { get; set; } = string.Empty;
        public List<string> UomOptions { get; set; } = [];
        public ItemOptionDto? SelectedItem { get; set; }
        public string UnitPrice { get; set; } = string.Empty;
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? Error { get; set; }
        public bool HasError => !string.IsNullOrWhiteSpace(Error);
    }
}
