@page "/catalog/prices"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using MudBlazor
@using Newtonsoft.Json
@using System.Globalization
@using POS.Application.Features.Price
@using POS.Common.Dtos.Price
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Services
@using ClosedXML.Excel

@inject IPriceService PriceService
@inject ISnackbar Snackbar
@inject IAuditLogger AuditLogger
@inject IFileLogHelper FileLogger
@inject IJSRuntime JS

<PageTitle>Bảng giá – POS Dashboard</PageTitle>

@* ── Header ─────────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.PriceChange" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Danh mục Bảng giá
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" Class="pos-page-header-btn"
               StartIcon="@Icons.Material.Filled.FileDownload"
               Disabled="_exporting" OnClick="ExportExcelAsync">
        @(_exporting ? "Đang xuất..." : "Xuất Excel")
    </MudButton>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_filter.ItemNo" Label="Mã sản phẩm"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          OnKeyDown="OnFilterKeyDown"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_filter.ItemName" Label="Tên sản phẩm"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          OnKeyDown="OnFilterKeyDown"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" @bind-Value="_filter.SaleType" Label="Hình thức bán hàng"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                       Placeholder="Tất cả">
                @foreach (var s in _lookup.SalesTypes)
                {
                    <MudSelectItem T="string" Value="@s.Value">@s.Text</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" @bind-Value="_filter.SalesGroup" Label="Nhóm giá"
                       Placeholder="Tất cả"  Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var g in _lookup.PriceGroups)
                {
                    <MudSelectItem T="string" Value="@g.Value">@g.Text</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="1" Class="d-flex align-center">
            <MudCheckBox @bind-Value="_filter.OnlyActive" Label="Còn hiệu lực"
                         Color="Color.Primary" Dense="true"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="SearchAsync">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true" OnClick="ClearFilterAsync">Xóa</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Price table (server-side) ───────────────────────────────────────────── *@
<MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" Elevation="2" HorizontalScrollbar="true" T="PriceListItemDto">
    <HeaderContent>
        <MudTh Style="width:48px">STT</MudTh>
        <MudTh>Hình thức</MudTh>
        <MudTh>Nhóm giá</MudTh>
        <MudTh>Mã sản phẩm</MudTh>
        <MudTh Style="width:100%">Tên sản phẩm</MudTh>
        <MudTh>ĐVT</MudTh>
        <MudTh Style="text-align:right">Giá bán</MudTh>
        <MudTh>Ngày bắt đầu HL</MudTh>
        <MudTh>Ngày hết HL</MudTh>
        <MudTh>Trạng thái</MudTh>
        <MudTh Style="width:104px; white-space:nowrap">Thao tác</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(_offset + _rows.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Hình thức">@context.SaleTypeName</MudTd>
        <MudTd DataLabel="Nhóm giá">@context.SalesCode</MudTd>
        <MudTd DataLabel="Mã sản phẩm"><b>@context.ItemNo</b></MudTd>
        <MudTd DataLabel="Tên sản phẩm">@context.ItemName</MudTd>
        <MudTd DataLabel="ĐVT">@context.UnitOfMeasureCode</MudTd>
        <MudTd DataLabel="Giá bán" Style="text-align:right">
            @if (IsEditing(context))
            {
                <MudTextField T="string" Value="_editPrice" ValueChanged="@(v => _editPrice = FormatThousands(v))"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputMode="InputMode.numeric" Immediate="true" Style="min-width:110px"/>
            }
            else
            {
                @context.UnitPrice
            }
        </MudTd>
        <MudTd DataLabel="Ngày bắt đầu HL">@FormatEffDate(context.StartingDateStr)</MudTd>
        <MudTd DataLabel="Ngày hết HL">@FormatEffDate(context.EndingDateStr)</MudTd>
        <MudTd DataLabel="Trạng thái">
            @{ var status = GetStatus(context); }
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@status.Color">@status.Text</MudChip>
        </MudTd>
        <MudTd DataLabel="Thao tác" Style="white-space:nowrap">
            @if (IsEditing(context))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"
                               Disabled="_savingRow" OnClick="@(() => SaveEditAsync(context))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small"
                               Disabled="_savingRow" OnClick="CancelEdit"/>
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => BeginEdit(context))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context))"/>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
            <MudText Typo="Typo.body2">Không có bảng giá khớp bộ lọc.</MudText>
        </div>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Align="Align.Center" Class="pa-4">Đang tải...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private MudTable<PriceListItemDto> _table = null!;
    private readonly PriceListFilter _filter = new() { PageSize = 10 };

    private List<PriceListItemDto> _rows = [];
    private int _offset;
    private bool _exporting;
    private string? _errorMsg;

    private string _actor = "unknown";
    private PriceListItemDto? _editing;
    private string _editPrice = string.Empty;
    private bool _savingRow;
    private PriceSetupLookupDto _lookup = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _actor = state.User.Identity?.Name ?? "unknown";
        try
        {
            _lookup = await PriceService.GetSetupLookupAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PricesPage.LoadLookup", ex);
        }
    }

    private async Task<TableData<PriceListItemDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _filter.PageNumber = state.Page;
        _filter.PageSize   = state.PageSize;
        _offset            = state.Page * state.PageSize;
        try
        {
            var (items, total) = await PriceService.GetPriceListAsync(_filter, token);
            _rows = items;
            _errorMsg = null;
            return new TableData<PriceListItemDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh mục bảng giá. (Kiểm tra SP [GetSalesPriceList])";
            FileLogger.WriteExpLogs("PricesPage.Load", ex);
            _rows = [];
            return new TableData<PriceListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await SearchAsync();
    }

    private async Task SearchAsync() => await _table.ReloadServerData();

    private async Task ClearFilterAsync()
    {
        _filter.ItemNo     = null;
        _filter.ItemName   = null;
        _filter.SaleType   = null;
        _filter.SalesGroup = "ALL";
        _filter.OnlyActive = false;
        await _table.ReloadServerData();
    }

    // "01/01/9999" = sentinel vô thời hạn (StartingDateStr/EndingDateStr format dd/MM/yyyy từ SP).
    private static string? FormatEffDate(string? dmy) => dmy == "01/01/9999" ? "Vô thời hạn" : dmy;

    private static (string Text, Color Color) GetStatus(PriceListItemDto row)
    {
        var today = DateTime.Now.Date;
        var noExpiry = row.EndingDateStr == "01/01/9999";

        if (DateTime.TryParseExact(row.StartingDateStr, "dd/MM/yyyy",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var start) && today < start.Date)
            return ("Chưa hiệu lực", Color.Info);

        if (!noExpiry && DateTime.TryParseExact(row.EndingDateStr, "dd/MM/yyyy",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var end) && today > end.Date)
            return ("Hết hiệu lực", Color.Error);

        return ("Hiệu lực", Color.Success);
    }

    private async Task ExportExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var data = await PriceService.ExportPriceListAsync(_filter);
            var bytes = BuildXlsx(data);
            await JS.SaveAsFileAsync($"DanhMucBangGia_{DateTime.Now:yyyyMMddHHmmss}.xlsx", bytes,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add($"Đã xuất {data.Count} dòng bảng giá.", Severity.Success);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PricesPage.Export", ex);
            Snackbar.Add("Xuất Excel thất bại.", Severity.Error);
        }
        finally { _exporting = false; }
    }

    // ── Sửa giá / Xóa giá (9.1) ───────────────────────────────────────────────
    private bool IsEditing(PriceListItemDto row) => ReferenceEquals(_editing, row);

    private void BeginEdit(PriceListItemDto row)
    {
        _editing = row;
        _editPrice = FormatThousands(row.UnitPrice);
    }

    private void CancelEdit()
    {
        _editing = null;
        _editPrice = string.Empty;
    }

    private async Task SaveEditAsync(PriceListItemDto row)
    {
        if (!TryBuildKey(row, out var key, out var keyErr)) { Snackbar.Add(keyErr, Severity.Error); return; }
        var price = ParsePrice(_editPrice);
        if (price <= 0) { Snackbar.Add("Giá bán phải lớn hơn 0.", Severity.Warning); return; }

        _savingRow = true;
        try
        {
            var result = await PriceService.UpdatePriceAsync(key, price, _actor);
            if (!result.Ok) { Snackbar.Add(result.Message, Severity.Error); return; }

            await AuditLogger.LogAsync(_actor, "UPDATE", "SalesPrice",
                $"{row.ItemNo}/{row.SalesCode}/{row.UnitOfMeasureCode}/{row.StartingDateStr}",
                oldValueJson: JsonConvert.SerializeObject(new { row.UnitPrice }),
                newValueJson: JsonConvert.SerializeObject(new { UnitPrice = price }));

            Snackbar.Add("Đã cập nhật giá bán.", Severity.Success);
            _editing = null;
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PricesPage.Update", ex);
            var detail = ex.GetBaseException().Message;
            if (string.IsNullOrWhiteSpace(detail)) detail = ex.GetBaseException().GetType().Name;
            Snackbar.Add($"Cập nhật giá thất bại: {detail}", Severity.Error);
        }
        finally { _savingRow = false; }
    }

    private async Task DeleteAsync(PriceListItemDto row)
    {
        if (!TryBuildKey(row, out var key, out var keyErr)) { Snackbar.Add(keyErr, Severity.Error); return; }
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Xóa giá sản phẩm {row.ItemNo} ({row.UnitOfMeasureCode}) — vùng giá {row.SalesCode}?"))
            return;

        try
        {
            var result = await PriceService.DeletePriceAsync(key, _actor);
            if (!result.Ok) { Snackbar.Add(result.Message, Severity.Error); return; }

            await AuditLogger.LogAsync(_actor, "DELETE", "SalesPrice",
                $"{row.ItemNo}/{row.SalesCode}/{row.UnitOfMeasureCode}/{row.StartingDateStr}",
                oldValueJson: JsonConvert.SerializeObject(row), newValueJson: null);

            if (ReferenceEquals(_editing, row)) _editing = null;
            Snackbar.Add("Đã xóa giá.", Severity.Success);
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PricesPage.Delete", ex);
            var detail = ex.GetBaseException().Message;
            if (string.IsNullOrWhiteSpace(detail)) detail = ex.GetBaseException().GetType().Name;
            Snackbar.Add($"Xóa giá thất bại: {detail}", Severity.Error);
        }
    }

    // Khoá dòng = composite PK (bảng không có Id). StartingDate parse từ chuỗi dd/MM/yyyy (SP format 103).
    private static bool TryBuildKey(PriceListItemDto row, out PriceRowKey key, out string error)
    {
        key = new PriceRowKey();
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(row.ItemNo)) { error = "Dòng thiếu Mã sản phẩm."; return false; }
        if (!DateTime.TryParseExact(row.StartingDateStr, "dd/MM/yyyy",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var start))
        {
            error = "Không đọc được Ngày bắt đầu hiệu lực của dòng.";
            return false;
        }
        key = new PriceRowKey
        {
            ItemNo = row.ItemNo!.Trim(),
            // SalesGroupCode = mã gốc (SalesPrice.SalesCode) — SalesCode giờ là tên hiển thị (PriceGroupName),
            // KHÔNG dùng để định vị dòng (xem GetSalesPriceList_AddSaleType.sql).
            SalesCode = (row.SalesGroupCode ?? string.Empty).Trim(),
            UnitOfMeasureCode = (row.UnitOfMeasureCode ?? string.Empty).Trim(),
            StartingDate = start,
            // SalesTypeCode = mã gốc SalesPrice.SalesType — 1 item/uom/nhóm giá/ngày hiệu lực có thể có
            // nhiều dòng khác nhau theo hình thức bán hàng, thiếu field này sẽ định vị nhầm dòng.
            SalesType = (row.SalesTypeCode ?? string.Empty).Trim()
        };
        return true;
    }

    private static double ParsePrice(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return 0;
        var cleaned = raw.Replace(",", string.Empty).Replace(" ", string.Empty).Trim();
        return double.TryParse(cleaned, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? d : 0;
    }

    // Format giá bán khi nhập: chèn dấu phân cách ngàn kiểu "30,000" (khớp pattern PriceSetupPage.razor).
    // Dùng dấu ',' (InvariantCulture) — khớp cách ParsePrice tách chuỗi (Replace ",").
    private static string FormatThousands(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var digits = new string(raw.Where(char.IsDigit).ToArray()).TrimStart('0');
        if (digits.Length == 0) return raw.Any(char.IsDigit) ? "0" : string.Empty;
        return long.TryParse(digits, out var n) ? n.ToString("#,##0", CultureInfo.InvariantCulture) : digits;
    }

    private static byte[] BuildXlsx(IReadOnlyList<PriceListItemDto> data)
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("BangGia");
        string[] headers =
        [
            "STT", "Barcode", "Nhóm giá", "Site", "Mã sản phẩm", "Mã SP (PLG)", "Tên sản phẩm",
            "ĐVT", "Giá bán", "Ngày bắt đầu HL", "Ngày hết HL", "Năm hết HL"
        ];
        for (var c = 0; c < headers.Length; c++) ws.Cell(1, c + 1).Value = headers[c];
        ws.Row(1).Style.Font.Bold = true;

        var r = 2;
        var stt = 1;
        foreach (var e in data)
        {
            ws.Cell(r, 1).Value  = stt++;
            ws.Cell(r, 2).Value  = e.BarcodeNo;
            ws.Cell(r, 3).Value  = e.SalesCode;
            ws.Cell(r, 4).Value  = e.SiteNo;
            ws.Cell(r, 5).Value  = e.ItemNo;
            ws.Cell(r, 6).Value  = e.ItemNo_PLG;
            ws.Cell(r, 7).Value  = e.ItemName;
            ws.Cell(r, 8).Value  = e.UnitOfMeasureCode;
            ws.Cell(r, 9).Value  = e.UnitPrice;
            ws.Cell(r, 10).Value = e.StartingDateStr;
            ws.Cell(r, 11).Value = e.EndingDateStr;
            ws.Cell(r, 12).Value = e.EndingYearStr;
            r++;
        }
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        return ms.ToArray();
    }
}
