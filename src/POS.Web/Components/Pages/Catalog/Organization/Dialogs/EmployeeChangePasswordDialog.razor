@namespace POS.Web.Components.Pages.Catalog.Organization
@using MudBlazor
@using POS.Infrastructure.Repositories.Interfaces

@inject ICentralMDRepository MdRepo

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-2" Style="vertical-align:middle"/>
            Đổi mật khẩu POS
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Nhân viên: <b>@StaffCode</b>@(string.IsNullOrEmpty(StaffName) ? "" : $" – {StaffName}")
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_newPassword"
                                  Label="Mật khẩu mới"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Vui lòng nhập mật khẩu mới"
                                  Validation="@((Func<string?, string?>)ValidatePassword)"
                                  Immediate="true"
                                  HelperText="Chỉ số, 4–8 ký tự"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"/>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_confirmPassword"
                                  Label="Nhập lại mật khẩu"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Vui lòng nhập lại mật khẩu"
                                  Validation="@((Func<string?, string?>)ValidateConfirm)"
                                  Immediate="true"/>
                </MudItem>
            </MudGrid>
        </MudForm>

        @if (_errorMsg != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_errorMsg</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Hủy</MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Disabled="@_saving"
                   StartIcon="@(_saving ? null : Icons.Material.Filled.Key)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Đổi mật khẩu
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string StaffCode { get; set; } = string.Empty;

    [Parameter]
    public string StaffName { get; set; } = string.Empty;

    private MudForm _form = null!;
    private bool _formValid;
    private bool _saving;
    private bool _showPassword;
    private string? _errorMsg;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    private static string? ValidatePassword(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Vui lòng nhập mật khẩu mới";
        if (value.Length < 4 || value.Length > 8 || !value.All(char.IsDigit))
            return "Mật khẩu chỉ gồm số, 4–8 ký tự";
        return null;
    }

    private string? ValidateConfirm(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Vui lòng nhập lại mật khẩu";
        if (value != _newPassword) return "Mật khẩu nhập lại không khớp";
        return null;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_formValid) return;

        _saving = true;
        _errorMsg = null;
        try
        {
            var ok = await MdRepo.ChangeEmployeePasswordAsync(StaffCode, _newPassword);
            if (ok)
                MudDialog.Close(DialogResult.Ok(true)); // không trả password ra page
            else
                _errorMsg = "Không đổi được mật khẩu — nhân viên không tồn tại hoặc đã ngưng hoạt động.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
