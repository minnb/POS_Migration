@page "/catalog/employees"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using MudBlazor
@using Newtonsoft.Json
@using POS.Common.Dtos.CentralMD
@using POS.Infrastructure.Logging
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Web.Services
@using ClosedXML.Excel

@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IAuditLogger AuditLogger
@inject IJSRuntime JS

<PageTitle>Danh mục Nhân viên – POS Dashboard</PageTitle>

@* ── Header ──────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Danh mục Nhân viên
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenCreateDialogAsync"
               Class="pos-page-header-btn">
        Thêm nhân viên
    </MudButton>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudAutocomplete T="string" Value="_filter.StoreNo"
                             ValueChanged="@(v => { _filter.StoreNo = v; })"
                             SearchFunc="SearchStoreAsync" Label="Cửa hàng"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Clearable="true" MaxItems="50" ResetValueOnEmptyText="false"
                             ToStringFunc="@StoreToString"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filter.TypeGroup" Label="Nhóm loại"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("0")">Nhân viên</MudSelectItem>
                <MudSelectItem Value="@("1")">Quản lý</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filter.Status" Label="Trạng thái"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("0")">Đang hoạt động</MudSelectItem>
                <MudSelectItem Value="@("1")">Ngưng hoạt động</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_filter.StaffCode" Label="Mã nhân viên"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_filter.StaffName" Label="Tên nhân viên"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="SearchAsync">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true" OnClick="ClearFilterAsync">Xóa</MudButton>
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       FullWidth="true" Disabled="_exporting" OnClick="ExportExcelAsync">
                @(_exporting ? "Đang xuất..." : "Xuất Excel")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Employee table (server-side) ────────────────────────────────────── *@
<MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="EmployeeListItemDto">
    <HeaderContent>
        <MudTh Style="width:48px">STT</MudTh>
        <MudTh>Mã NV</MudTh>
        <MudTh>Tên nhân viên</MudTh>
        <MudTh>Quyền hủy bill</MudTh>
        <MudTh>Nhóm loại</MudTh>
        <MudTh>Nhóm quyền</MudTh>
        <MudTh>Trạng thái</MudTh>
        <MudTh>Mã CH</MudTh>
        <MudTh>Tên cửa hàng</MudTh>
        <MudTh>Điện thoại</MudTh>
        <MudTh>Ngày cập nhật</MudTh>
        <MudTh Style="text-align:center; width:80px">Thao tác</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(_offset + _rows.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Mã NV">@context.StaffCode</MudTd>
        <MudTd DataLabel="Tên nhân viên">@context.FirstName</MudTd>
        <MudTd DataLabel="Quyền hủy bill">@context.VoidTransaction</MudTd>
        <MudTd DataLabel="Nhóm loại">@context.TypeGroup</MudTd>
        <MudTd DataLabel="Nhóm quyền">@context.PermissionGroup</MudTd>
        <MudTd DataLabel="Trạng thái">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Color="@(IsActive(context.Status) ? Color.Success : Color.Error)">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Mã CH">@context.StoreNo</MudTd>
        <MudTd DataLabel="Tên cửa hàng">@context.StoreName</MudTd>
        <MudTd DataLabel="Điện thoại">@context.HomePhoneNo</MudTd>
        <MudTd DataLabel="Ngày cập nhật">
            <MudText Typo="Typo.caption">@context.LastDateModifiedStr</MudText>
        </MudTd>
        <MudTd DataLabel="Thao tác" Style="text-align:center">
            @if (IsActive(context.Status))
            {
                <MudTooltip Text="Đổi mật khẩu POS">
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenChangePasswordDialogAsync(context))"/>
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
            <MudText Typo="Typo.body2">Không có nhân viên khớp bộ lọc.</MudText>
        </div>
    </NoRecordsContent>
    <LoadingContent>
        <div class="d-flex align-center justify-center gap-2 pa-4">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
            <MudText>Đang tải...</MudText>
        </div>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private MudTable<EmployeeListItemDto> _table = null!;
    private readonly EmployeeListFilter _filter = new() { TypeGroup = "-1", Status = "-1", PageSize = 20 };

    private List<EmployeeListItemDto> _rows = [];
    private int _offset;
    private bool _exporting;
    private string? _errorMsg;
    private string _currentActor = "unknown";

    private List<StoreDto> _allStores = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        try
        {
            _allStores = await MdRepo.GetStoreListAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("EmployeesPage.LoadStores", ex);
        }
    }

    // ── Thêm nhân viên ───────────────────────────────────────────────────
    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<EmployeeFormDialog>
        {
            { x => x.Stores, _allStores }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Small,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>("Thêm nhân viên", parameters, options);

        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is EmployeeCreateDto saved)
        {
            // Audit CREATE — mask password (audit-logging.md: không ghi credential vào log)
            await AuditLogger.LogAsync(_currentActor, "CREATE", "Staff",
                saved.StaffCode,
                oldValueJson: null,
                newValueJson: JsonConvert.SerializeObject(new
                {
                    saved.StaffCode, saved.StaffName, saved.StoreNo, saved.EmploymentType,
                    saved.PermissionGroup, saved.VoidTransaction, saved.Blocked,
                    saved.HomePhoneNo, Password = "***"
                }));

            Snackbar.Add($"Đã thêm nhân viên \"{saved.StaffCode}\".", Severity.Success);
            await _table.ReloadServerData();
        }
    }

    // ── Đổi mật khẩu POS ─────────────────────────────────────────────────
    private async Task OpenChangePasswordDialogAsync(EmployeeListItemDto item)
    {
        var parameters = new DialogParameters<EmployeeChangePasswordDialog>
        {
            { x => x.StaffCode, item.StaffCode },
            { x => x.StaffName, item.FirstName }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.ExtraSmall,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<EmployeeChangePasswordDialog>(
            "Đổi mật khẩu POS", parameters, options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            // Audit — không serialize password thật (mask theo audit-logging.md)
            await AuditLogger.LogAsync(_currentActor, "CHANGE_POS_PASSWORD", "Staff",
                item.StaffCode,
                oldValueJson: JsonConvert.SerializeObject(new { Password = "***" }),
                newValueJson: JsonConvert.SerializeObject(new { Password = "***" }));

            Snackbar.Add($"Đã đổi mật khẩu POS cho \"{item.StaffCode}\".", Severity.Success);
            await _table.ReloadServerData(); // refresh Ngày cập nhật
        }
    }

    // ── Server-side data load (MudTable.ServerData) ──────────────────────
    private async Task<TableData<EmployeeListItemDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _filter.PageNumber = state.Page;          // SP OFFSET = PageSize * PageNumber (0-based)
        _filter.PageSize   = state.PageSize;
        _offset            = state.Page * state.PageSize;
        try
        {
            var (items, total) = await MdRepo.GetEmployeeListAsync(_filter, token);
            _rows = items;
            _errorMsg = null;
            return new TableData<EmployeeListItemDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách nhân viên.";
            FileLogger.WriteExpLogs("EmployeesPage.Load", ex);
            _rows = [];
            return new TableData<EmployeeListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task SearchAsync() => await _table.ReloadServerData();

    private async Task ClearFilterAsync()
    {
        _filter.StaffCode = null;
        _filter.StaffName = null;
        _filter.StoreNo   = null;
        _filter.TypeGroup = "-1";
        _filter.Status    = "-1";
        await _table.ReloadServerData();
    }

    // ── Store autocomplete ───────────────────────────────────────────────
    private Task<IEnumerable<string>> SearchStoreAsync(string value, CancellationToken ct)
    {
        IEnumerable<StoreDto> matches = string.IsNullOrWhiteSpace(value)
            ? _allStores
            : _allStores.Where(s =>
                (s.StoreNo?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false));
        return Task.FromResult(matches.Take(50).Select(s => s.StoreNo ?? string.Empty));
    }

    private string StoreToString(string? storeNo)
    {
        if (string.IsNullOrEmpty(storeNo)) return string.Empty;
        var s = _allStores.FirstOrDefault(x => x.StoreNo == storeNo);
        return s == null ? storeNo : $"{s.StoreNo} – {s.Name}";
    }

    private static bool IsActive(string? status) =>
        !string.IsNullOrEmpty(status) && status.Contains("Đang", StringComparison.OrdinalIgnoreCase);

    // ── Export Excel (ClosedXML) ─────────────────────────────────────────
    private async Task ExportExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var data = await MdRepo.ExportEmployeeListAsync(_filter);
            var bytes = BuildXlsx(data);
            var fileName = $"DanhMucNhanVien_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JS.SaveAsFileAsync(fileName, bytes,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add($"Đã xuất {data.Count} nhân viên.", Severity.Success);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("EmployeesPage.Export", ex);
            Snackbar.Add("Xuất Excel thất bại.", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static byte[] BuildXlsx(IReadOnlyList<EmployeeListItemDto> data)
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("NhanVien");

        string[] headers =
        [
            "Mã NV", "Tên nhân viên", "Quyền hủy bill", "Nhóm loại", "Nhóm quyền",
            "Trạng thái", "Mã CH", "Tên cửa hàng", "Điện thoại", "Ngày cập nhật"
        ];
        for (var c = 0; c < headers.Length; c++)
            ws.Cell(1, c + 1).Value = headers[c];
        ws.Row(1).Style.Font.Bold = true;

        var r = 2;
        foreach (var e in data)
        {
            ws.Cell(r, 1).Value = e.StaffCode;
            ws.Cell(r, 2).Value = e.FirstName;
            ws.Cell(r, 3).Value = e.VoidTransaction;
            ws.Cell(r, 4).Value = e.TypeGroup;
            ws.Cell(r, 5).Value = e.PermissionGroup;
            ws.Cell(r, 6).Value = e.Status;
            ws.Cell(r, 7).Value = e.StoreNo;
            ws.Cell(r, 8).Value = e.StoreName;
            ws.Cell(r, 9).Value = e.HomePhoneNo;
            ws.Cell(r, 10).Value = e.LastDateModifiedStr;
            r++;
        }

        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        return ms.ToArray();
    }
}
