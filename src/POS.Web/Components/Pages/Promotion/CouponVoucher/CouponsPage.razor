@page "/promotion/coupons"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Application.Features.CouponVoucher
@using POS.Common.Dtos.SetupCoupon
@using POS.Infrastructure.Logging
@using POS.Web.Auth

@inject ICouponService CouponService
@inject IFileLogHelper FileLogger
@inject NavigationManager Nav

<PageTitle>Danh sách Coupon – POS Dashboard</PageTitle>

@* ── Header ─────────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Danh sách Coupon
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Nav.NavigateTo("/promotion/coupons/issue"))"
               Class="pos-page-header-btn">
        Phát hành coupon
    </MudButton>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="5">
            <MudTextField @bind-Value="_filter.KeyWord" Label="Từ khóa (mã / tên / mã coupon)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect @bind-Value="_filter.Status" Label="Hiệu lực"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem T="string" Value="@("0")">Còn hiệu lực</MudSelectItem>
                <MudSelectItem T="string" Value="@("1")">Hết hiệu lực</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="SearchAsync">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true" OnClick="ClearFilterAsync">Xóa</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Coupon/Voucher master table (server-side, read-only) ─────────────────── *@
<MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" Elevation="2" HorizontalScrollbar="true" T="CouponHeaderListItemDto">
    <HeaderContent>
        <MudTh Style="width:48px">STT</MudTh>
        <MudTh Style="width:80px; text-align:center">Thao tác</MudTh>
        <MudTh>Mã</MudTh>
        <MudTh>Tên</MudTh>
        <MudTh>Loại giảm</MudTh>
        <MudTh Style="text-align:right">Giá trị giảm</MudTh>
        <MudTh Style="text-align:right">SL tối đa</MudTh>
        <MudTh>Tổng bill</MudTh>
        <MudTh>Từ ngày</MudTh>
        <MudTh>Đến ngày</MudTh>
        <MudTh>Hiệu lực</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(_offset + _rows.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Thao tác" Style="text-align:center">
            <MudTooltip Text="Xem chi tiết">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo($"/promotion/coupons/issue?id={context.ItemNo}&mode=view"))"/>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Mã"><b>@context.ItemNo</b></MudTd>
        <MudTd DataLabel="Tên">@context.ItemName</MudTd>
        <MudTd DataLabel="Loại giảm">@DiscountTypeText(context.ArticleType, context.DiscountType)</MudTd>
        <MudTd DataLabel="Giá trị giảm" Style="text-align:right">@context.DiscountValue.ToString("#,##0")</MudTd>
        <MudTd DataLabel="SL tối đa" Style="text-align:right">@context.LimitQty.ToString("#,##0")</MudTd>
        <MudTd DataLabel="Tổng bill">@(context.IsCheckItem ? "Không" : "Có")</MudTd>
        <MudTd DataLabel="Từ ngày">@context.StartingDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Đến ngày">@context.EndingDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Hiệu lực">
            <div class="d-flex flex-wrap gap-1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.EndingDate.Date >= DateTime.Today ? Color.Success : Color.Error)">
                    @(context.EndingDate.Date >= DateTime.Today ? "Còn hiệu lực" : "Hết hiệu lực")
                </MudChip>
                @if (context.Blocked)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning">Blocked</MudChip>
                }
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
            <MudText Typo="Typo.body2">Không có coupon/voucher khớp bộ lọc.</MudText>
        </div>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Align="Align.Center" Class="pa-4">Đang tải...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    private MudTable<CouponHeaderListItemDto> _table = null!;
    private readonly CouponHeaderListFilter _filter = new() { Status = "0", PageSize = 10 };

    private List<CouponHeaderListItemDto> _rows = [];
    private int _offset;
    private string? _errorMsg;

    private async Task<TableData<CouponHeaderListItemDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _filter.PageNumber = state.Page;
        _filter.PageSize   = state.PageSize;
        _offset            = state.Page * state.PageSize;
        try
        {
            var (items, total) = await CouponService.GetHeaderListAsync(_filter, token);
            _rows = items;
            _errorMsg = null;
            return new TableData<CouponHeaderListItemDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách Coupon/Voucher. (Kiểm tra SP usp_CpnVchBOMHeader_GetList đã deploy chưa)";
            FileLogger.WriteExpLogs("CouponsPage.Load", ex);
            _rows = [];
            return new TableData<CouponHeaderListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task SearchAsync() => await _table.ReloadServerData();

    private async Task ClearFilterAsync()
    {
        _filter.KeyWord = null;
        _filter.Status  = "0";
        await _table.ReloadServerData();
    }

    // Loại giảm hiển thị: ZCOU/ZCPN (coupon) → %/Amount theo DiscountType; ZVCN/ZVCO (voucher) → Amount.
    private static string DiscountTypeText(string articleType, int discountType) => articleType switch
    {
        "ZCOU" or "ZCPN" => discountType == 1 ? "%" : "Amount",
        "ZVCN" or "ZVCO" => "Amount",
        _                => string.Empty
    };
}
