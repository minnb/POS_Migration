@page "/promotion/coupons/issue"
@attribute [Authorize(Policy = WebPolicies.BackOfficeAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@using Newtonsoft.Json
@using POS.Application.Features.CouponVoucher
@using POS.Common.Dtos.SetupCoupon
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Components.Pages.Promotion.CouponVoucher.Dialogs
@using POS.Web.Services
@using ClosedXML.Excel

@inject ICouponService CouponService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuditLogger AuditLogger
@inject IFileLogHelper FileLogger
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Phát hành Coupon – POS Dashboard</PageTitle>

@* ── Header ─────────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Sell" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        @(IsViewMode ? $"Xem coupon {_model.ItemNo}" : IsEditing ? $"Sửa coupon {_model.ItemNo}" : "Phát hành Coupon")
    </MudText>
    <MudStack Row="true" Spacing="1" Class="pos-page-header-btn">
        <MudButton Size="Size.Small" Class="pos-btn-mockup pos-btn-secondary" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/promotion/coupons"))">Danh sách</MudButton>
        @* Xem coupon: nút PHÁT HÀNH THÊM — phát hành thêm 1 lô mã Auto mới cho coupon đã có *@
        @if (IsViewMode)
        {
            <MudButton Size="Size.Small" Class="pos-btn-mockup pos-btn-primary" Disabled="_saving"
                       StartIcon="@Icons.Material.Filled.QrCode2" OnClick="OpenIssueMoreDialogForExistingAsync">
                PHÁT HÀNH THÊM
            </MudButton>
            @* Xem coupon: nút Lưu chỉ hiện khi trạng thái Khóa (Blocked) bị đổi — ngoại lệ duy nhất được sửa *@
            @if (BlockedChanged)
            {
                <MudButton Size="Size.Small" Class="pos-btn-mockup pos-btn-primary" Disabled="_saving"
                           OnClick="SaveBlockedAsync">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2"/>
                        <span>Lưu</span>
                    }
                </MudButton>
            }
        }
        @if (!IsViewMode)
        {
            <MudButton Size="Size.Small" Class="pos-btn-mockup pos-btn-primary" Disabled="_saving" OnClick="SaveButtonClickAsync">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    <span>Đang lưu...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2"/>
                    <span>Lưu</span>
                }
            </MudButton>
        }
    </MudStack>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"/>
}
else
{
    @if (_errorMsg != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
    }

    @* ── Form nhập liệu (1 card, 1 nhóm gộp: Thông tin chung + Thời gian hiệu lực & Cấu hình giảm giá) ────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            @* Group: Thông tin chung (gộp Thời gian + Sinh mã/Import + Giảm giá + Tùy chọn).
               Giới hạn số lượng/Số lần sử dụng/Sử dụng nhiều lần: ẩn khỏi form, cố định giá trị (xem @code). *@
            <MudPaper Class="pos-filter-panel pa-4 mb-4" Style="position:relative">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary"
                         Style="position:absolute; top:-11px; left:12px; padding:0 6px; background:var(--mud-palette-surface); line-height:1;">
                    Thông tin chung
                </MudText>
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField Value="@_model.ItemNo" Label="Mã phát hành" ReadOnly="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="Tự sinh khi lưu"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="6">
                        <MudTextField @bind-Value="_model.Description" Label="Tên phát hành" Required="true"
                                      RequiredError="Vui lòng nhập tên phát hành coupon" ReadOnly="@IsViewMode"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"/>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect @bind-Value="_model.IssueType" Label="Cách phát hành" Required="true"
                                   RequiredError="Vui lòng chọn cách phát hành" Disabled="@(CodeFieldsLocked || IsViewMode)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("Auto")">Tự động tạo mã</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Import")">Import excel</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudDatePicker @bind-Date="_fromDate" Label="Từ ngày" Required="true"
                                       RequiredError="Vui lòng chọn ngày bắt đầu" DateFormat="dd/MM/yyyy"
                                       Disabled="@IsViewMode" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudDatePicker @bind-Date="_toDate" Label="Đến ngày" Required="true"
                                       RequiredError="Vui lòng chọn ngày kết thúc" DateFormat="dd/MM/yyyy"
                                       Disabled="@IsViewMode" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>

                    @* Auto: Prefix/LenCode/CharOfNumber/CharPosition/Quantity thu thập qua dialog
                       "Phát hành mã coupon" (SaveButtonClickAsync/OpenIssueMoreDialogForExistingAsync)
                       khi bấm Lưu/Phát hành thêm — không hiển thị trực tiếp trên form (khớp VoucherIssuePage). *@
                    @if (!IsAuto && !IsViewMode)
                    {
                        <MudItem xs="12" sm="12" md="12" Class="d-flex align-center gap-2 flex-wrap">
                            <MudFileUpload T="IBrowserFile" @bind-Files="_importFile" Accept=".xls,.xlsx" MaximumFileCount="1">
                                <ActivatorContent>
                                    <MudButton Class="pos-btn-primary"
                                               StartIcon="@Icons.Material.Filled.UploadFile" Disabled="CodeFieldsLocked">
                                        @(_importFile?.Name ?? "Chọn file Excel")
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            <MudButton Class="pos-btn-secondary"
                                       StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplateAsync">
                                File mẫu
                            </MudButton>
                        </MudItem>
                    }

                    <MudItem xs="12" sm="6" md="6">
                        <MudSelect @bind-Value="_model.SaleType" Label="Hình thức bán hàng" Clearable="true"
                                   Disabled="@IsViewMode" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var s in _lookup.SalesTypes)
                            {
                                <MudSelectItem T="string" Value="@s.Value">@s.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="6">
                        <MudSelect @bind-Value="_model.StoreGroupCode" Label="Nhóm cửa hàng" Clearable="true"
                                   Disabled="@IsViewMode" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                            @foreach (var g in _lookup.StoreGroups)
                            {
                                <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    @if (_showAdvancedButton)
                    {
                        <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                            <MudButton Class="pos-btn-primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenAdvancedAsync">
                                Cài đặt nâng cao
                            </MudButton>
                        </MudItem>
                    }

                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect @bind-Value="_advanced.DiscountType" Label="Kiểu giảm giá"
                                   Disabled="@IsViewMode" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="1">Discount Percent (%)</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Discount Amount (VNĐ)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_advanced.DiscountValue" Label="Giá trị giảm giá (%/VNĐ)" Variant="Variant.Outlined"
                                         Min="0" Max="@DiscountValueMax" Step="0.1" Required="true" RequiredError="Vui lòng nhập giá trị giảm giá"
                                         ReadOnly="@IsViewMode" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_advanced.MaxValue" Label="Giảm tối đa VNĐ (0=không giới hạn)" Variant="Variant.Outlined"
                                         Min="0" Step="0.1" ReadOnly="@IsViewMode" Margin="Margin.Dense"/>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex flex-wrap gap-4 align-center">
                        <MudCheckBox @bind-Value="_applyPerItem" @bind-Value:after="OnApplyPerItemChanged"
                                     Label="Áp dụng theo danh sách sản phẩm (bỏ chọn = áp dụng tổng hóa đơn)"
                                     Color="Color.Primary" Dense="true" Disabled="@IsViewMode"/>
                        <MudCheckBox @bind-Value="_advanced.IsCheckAPI" Label="Check API (cố định)" Color="Color.Primary" Dense="true" Disabled="true"/>
                        @* Xem coupon: Blocked là ngoại lệ DUY NHẤT được sửa (khớp VoucherIssuePage) — không Disabled theo IsViewMode *@
                        <MudCheckBox @bind-Value="_advanced.Blocked" Label="Khóa (Blocked)" Color="Color.Error" Dense="true"/>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudCardContent>
    </MudCard>

    @* ── Tabs: sản phẩm + mã coupon ─────────────────────────────────────── *@
    @if (!_applyPerItem && _quantityCodeInDb == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            Tick "Áp dụng theo danh sách sản phẩm" để thêm sản phẩm, hoặc lưu coupon để phát sinh mã.
        </MudAlert>
    }
    else
    {
    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        @* Tab sản phẩm chỉ hiện khi "Áp dụng theo danh sách sản phẩm" được tick *@
        @if (_applyPerItem)
        {
            <MudTabPanel Text="Danh sách sản phẩm" Icon="@Icons.Material.Filled.Inventory2">
                @if (_items.Count > 0 && !IsViewMode)
                {
                    <div class="d-flex justify-end mb-2">
                        <MudButton Class="pos-btn-mockup pos-btn-primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenItemPickerAsync">Thêm sản phẩm</MudButton>
                    </div>
                }
                <MudTable Class="pos-table" Items="@_items" Dense="true" Hover="true" Striped="true"
                          Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="CouponItemLineDto">
                    <HeaderContent>
                        <MudTh>Mã sản phẩm</MudTh>
                        <MudTh>Barcode</MudTh>
                        <MudTh>Tên sản phẩm</MudTh>
                        <MudTh>ĐVT</MudTh>
                        <MudTh Style="text-align:right; width:60px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Mã sản phẩm">@context.ItemNo</MudTd>
                        <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
                        <MudTd DataLabel="Tên sản phẩm">@context.ItemName</MudTd>
                        <MudTd DataLabel="ĐVT">@context.UOM</MudTd>
                        <MudTd Style="text-align:right">
                            @if (!IsViewMode)
                            {
                                <MudTooltip Text="Xoá sản phẩm">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => _items.Remove(context))"/>
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
                            @if (!IsViewMode)
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="OpenItemPickerAsync" Class="mb-3 pos-btn-mockup pos-btn-primary">Thêm sản phẩm</MudButton>
                            }
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
                            <MudText Typo="Typo.body2">Chưa có sản phẩm. Coupon áp dụng tổng hóa đơn.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>
        }

        @if (_quantityCodeInDb > 0)
        {
            <MudTabPanel Text="Mã coupon đã phát hành" Icon="@Icons.Material.Filled.QrCode2">
                <MudTable Class="pos-table" @ref="_codeTable" ServerData="LoadCodesData" Dense="true" Hover="true" Striped="true"
                          Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="CouponCodeDto">
                    <HeaderContent>
                        <MudTh Style="width:48px">STT</MudTh>
                        <MudTh>Mã coupon</MudTh>
                        <MudTh>Trạng thái khóa</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="text-align:right">Số tiền đã dùng</MudTh>
                        <MudTh>Đơn hàng đã dùng</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="STT">@(_codeOffset + _codeRows.IndexOf(context) + 1)</MudTd>
                        <MudTd DataLabel="Mã coupon">@context.Code</MudTd>
                        <MudTd DataLabel="Trạng thái khóa">
                            <span class="pos-status-chip @(context.Enable ? "pos-status-success" : "pos-status-error")">
                                @(context.Enable ? "Active" : "Locked")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @{
                                var (stCss, stLabel) = StatusDisplay(context.Status);
                            }
                            <span class="pos-status-chip @stCss">@stLabel</span>
                        </MudTd>
                        <MudTd DataLabel="Số tiền đã dùng" Style="text-align:right">
                            @(context.AmountUsed.HasValue ? context.AmountUsed.Value.ToString("#,##0.##") : "—")
                        </MudTd>
                        <MudTd DataLabel="Đơn hàng đã dùng">@(context.OrderUsed ?? "—")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
                            <MudText Typo="Typo.body2">Chưa có mã coupon.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                                       InfoFormat="{first_item}–{last_item} / {all_items} mã"
                                       RowsPerPageString="Số dòng/trang:"/>
                    </PagerContent>
                </MudTable>
            </MudTabPanel>
        }
    </MudTabs>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "id")]
    private string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    private string? Mode { get; set; }

    private CouponIssueSaveRequest _model = new() { IssueType = "Auto", ArticleType = "ZCPN", StoreGroupCode = "ALL", SaleType = "ALL" };
    private CouponFormLookupDto _lookup = new();
    private List<CouponItemLineDto> _items = [];
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _applyPerItem;
    private int _activeTabIndex;
    private int _quantityCodeInDb;
    private IBrowserFile? _importFile;

    // Advanced state — field nhập trực tiếp trên form chính (Card "Cấu hình giảm giá & nâng cao")
    private CouponAdvancedSaveRequest _advanced = new();

    // Nút "Cài đặt nâng cao" tạm ẩn: field đã chuyển xuống form chính, giữ dialog + nút cho thiết kế lại sau
    private readonly bool _showAdvancedButton = false;

    private MudTable<CouponCodeDto> _codeTable = null!;
    private List<CouponCodeDto> _codeRows = [];
    private int _codeOffset;

    private bool _loading = true;
    private bool _saving;
    private string? _errorMsg;
    private string _currentActor = "unknown";
    private bool _originalBlocked;

    private bool IsViewMode => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);
    private bool IsEditing => !string.IsNullOrWhiteSpace(_model.ItemNo);
    private bool IsAuto => string.Equals(_model.IssueType, "Auto", StringComparison.OrdinalIgnoreCase);
    private bool CodeFieldsLocked => IsEditing && _quantityCodeInDb > 0;

    // Xem coupon: NGOẠI LỆ DUY NHẤT được sửa là Blocked. Nút Lưu chỉ bật khi giá trị này đổi (khớp VoucherIssuePage).
    private bool BlockedChanged => IsViewMode && _advanced.Blocked != _originalBlocked;

    // Kiểu giảm giá = Percent (1) → giá trị giảm giá tối đa 100%; Amount (2) → không giới hạn theo %.
    private double DiscountValueMax => _advanced.DiscountType == 1 ? 100 : double.MaxValue;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        try
        {
            _lookup = await CouponService.GetFormLookupAsync();
            if (!string.IsNullOrWhiteSpace(Id))
                await LoadDetailAsync(Id!);
            else
                SetDefaultsForNewCoupon();
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu form. (Kiểm tra SP usp_SetupCoupon_* đã deploy chưa)";
            FileLogger.WriteExpLogs("CouponIssuePage.Init", ex);
        }
        finally { _loading = false; }
    }

    // ── Giá trị mặc định khi mở form tạo coupon mới (User vẫn sửa lại được) ────
    // Prefix/LenCode/CharOfNumber/CharPosition/Quantity: thu thập qua dialog "Phát hành mã coupon"
    // (SaveButtonClickAsync) khi IssueType=Auto — dialog tự có default riêng.
    // Giới hạn số lượng/Số lần sử dụng/Sử dụng nhiều lần: ẩn khỏi form, luôn cố định (không cho sửa).
    private void SetDefaultsForNewCoupon()
    {
        _advanced.LimitQtyUsed = 1;       // cố định
        _advanced.IsMultiUsed = false;    // cố định
        _advanced.IsCheckAPI = true;      // cố định
        _advanced.LimitQty = 199999999;   // cố định, không giới hạn
        _advanced.UOM = "CAI";            // ẩn khỏi form — cố định
        _fromDate = DateTime.Today.AddDays(1);
        _toDate = DateTime.Today.AddDays(60);
    }

    private async Task LoadDetailAsync(string itemNo)
    {
        var d = await CouponService.GetDetailAsync(itemNo);
        if (d == null) { _errorMsg = $"Không tìm thấy coupon {itemNo}."; return; }

        _model = new CouponIssueSaveRequest
        {
            ItemNo = d.ItemNo, Description = d.Description,
            IssueType = string.IsNullOrWhiteSpace(d.IssueType) ? "Auto" : d.IssueType,
            ArticleType = string.IsNullOrWhiteSpace(d.ArticleType) ? "ZCPN" : d.ArticleType,
            SaleType = string.IsNullOrWhiteSpace(d.SaleType) ? "ALL" : d.SaleType,
            StoreGroupCode = string.IsNullOrWhiteSpace(d.StoreGroupCode) ? "ALL" : d.StoreGroupCode,
            Prefix = d.Prefix, LenCode = d.LenCode, CharOfNumber = d.CharOfNumber, CharPosition = d.CharPosition,
            IsCheckItem = d.IsCheckItem, QuantityCodeInDB = d.QuantityCode
        };
        _quantityCodeInDb = d.QuantityCode;
        _applyPerItem = d.IsCheckItem;
        _items = d.Items ?? [];
        _fromDate = ParseDmy(d.StartingDate);
        _toDate = ParseDmy(d.EndingDate);

        _advanced = new CouponAdvancedSaveRequest
        {
            ItemNo = d.ItemNo, UOM = d.UOM, DiscountType = d.DiscountType == 0 ? 1 : d.DiscountType,
            DiscountValue = (double)d.DiscountValue, MaxValue = (double)d.MaxAmount, LimitQty = 199999999,
            LimitQtyUsed = 1, IsMultiUsed = false, IsCheckAPI = true,   // ẩn khỏi form — cố định
            Blocked = d.Blocked, CpnVchType = d.CpnVchType
        };
        _originalBlocked = d.Blocked;
    }

    // ── Save ────────────────────────────────────────────────────────────────
    // Sinh mã Auto chỉ khi tạo mới hoặc coupon hiện tại chưa có mã (khớp usp_SetupCoupon_SaveIssue).
    private bool NeedsCodeDialog => IsAuto && (string.IsNullOrWhiteSpace(_model.ItemNo) || _quantityCodeInDb == 0);

    private bool ValidateHeaderFields()
    {
        if (string.IsNullOrWhiteSpace(_model.Description)) { Snackbar.Add("Vui lòng nhập tên phát hành coupon", Severity.Warning); return false; }
        if (_fromDate == null) { Snackbar.Add("Vui lòng chọn ngày bắt đầu", Severity.Warning); return false; }
        if (_toDate == null) { Snackbar.Add("Vui lòng chọn ngày kết thúc", Severity.Warning); return false; }
        if (_fromDate.Value.Date >= _toDate.Value.Date) { Snackbar.Add("Từ ngày phải nhỏ hơn Đến ngày", Severity.Warning); return false; }
        if (_advanced.DiscountType == 1 && (_advanced.DiscountValue <= 0 || _advanced.DiscountValue > 100))
        {
            Snackbar.Add("Giá trị giảm giá theo % phải lớn hơn 0 và không vượt quá 100", Severity.Warning);
            return false;
        }
        return true;
    }

    // Nút "Lưu": Auto + chưa có mã → mở dialog thu thập tham số sinh mã trước, rồi mới lưu.
    // Import, hoặc Auto nhưng đã có mã (chỉ sửa header) → lưu thẳng như cũ.
    private async Task SaveButtonClickAsync()
    {
        if (NeedsCodeDialog)
            await OpenIssueMoreDialogThenSaveAsync();
        else
            await SaveAsync();
    }

    private async Task OpenIssueMoreDialogThenSaveAsync()
    {
        _errorMsg = null;
        if (!ValidateHeaderFields()) return;

        var dialog = await DialogService.ShowAsync<CouponIssueMoreDialog>("Phát hành coupon",
            new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is CouponIssueMoreRequest result)
        {
            _model.Prefix = result.Prefix;
            _model.LenCode = result.LenCode;
            _model.CharOfNumber = result.CharOfNumber;
            _model.CharPosition = result.CharPosition;
            _model.Quantity = result.Quantity;
            await SaveAsync();
        }
    }

    // Xem coupon: phát hành THÊM 1 lô mã Auto mới cho coupon đã tồn tại — ở lại trang, refresh tab mã.
    private async Task OpenIssueMoreDialogForExistingAsync()
    {
        var dialog = await DialogService.ShowAsync<CouponIssueMoreDialog>("Phát hành thêm mã coupon",
            new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is CouponIssueMoreRequest result)
        {
            result.ItemNo = _model.ItemNo;
            _saving = true;
            try
            {
                var saveResult = await CouponService.IssueMoreAsync(result);
                if (!saveResult.Ok)
                {
                    Snackbar.Add(saveResult.Message, Severity.Error);
                    return;
                }

                await AuditLogger.LogAsync(_currentActor, "ISSUE", "SetupCoupon", _model.ItemNo,
                    newValueJson: JsonConvert.SerializeObject(result));
                Snackbar.Add(saveResult.Message, Severity.Success);
                _quantityCodeInDb = Math.Max(_quantityCodeInDb, 1);   // đảm bảo tab "Mã đã phát hành" hiện ra
                if (_codeTable != null)
                    await _codeTable.ReloadServerData();
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("CouponIssuePage.IssueMore", ex);
                Snackbar.Add("Phát hành thêm mã thất bại. Vui lòng thử lại.", Severity.Error);
            }
            finally { _saving = false; }
        }
    }

    private async Task SaveAsync()
    {
        _errorMsg = null;
        if (!ValidateHeaderFields()) return;

        _model.StartingDateStr = _fromDate.Value.ToString("dd/MM/yyyy");
        _model.EndingDateStr = _toDate.Value.ToString("dd/MM/yyyy");
        _model.IsCheckItem = _applyPerItem;
        _model.Items = _applyPerItem ? _items : [];
        _model.ArticleType = "ZCPN";

        var needCodes = string.IsNullOrWhiteSpace(_model.ItemNo) || _quantityCodeInDb == 0;
        if (needCodes && !IsAuto)
        {
            // parse Excel → ImportCodes
            if (_importFile == null) { Snackbar.Add("Vui lòng chọn file excel để import", Severity.Warning); return; }
            try
            {
                _model.ImportCodes = await ParseImportFileAsync(_importFile);
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("CouponIssuePage.ParseExcel", ex);
                Snackbar.Add("Không đọc được file Excel. Kiểm tra đúng định dạng file mẫu.", Severity.Error);
                return;
            }
        }

        _saving = true;
        try
        {
            var before = IsEditing ? JsonConvert.SerializeObject(_model) : null;
            var result = await CouponService.SaveIssueAsync(_model);
            if (!result.Ok)
            {
                _errorMsg = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            await AuditLogger.LogAsync(_currentActor, IsEditing ? "UPDATE" : "CREATE", "SetupCoupon",
                result.ItemNo, oldValueJson: before, newValueJson: JsonConvert.SerializeObject(_model));

            // Đồng bộ field header sang advanced request rồi lưu cấu hình giảm giá/nâng cao
            // (field đã gộp vào form chính — xem Card "Cấu hình giảm giá & nâng cao" + ShowAdvancedButton)
            _advanced.ItemNo = result.ItemNo;
            _advanced.Description = _model.Description;
            _advanced.ArticleType = _model.ArticleType;
            _advanced.IssueType = _model.IssueType;
            _advanced.SaleType = _model.SaleType;
            _advanced.StoreGroupCode = _model.StoreGroupCode;
            _advanced.StartingDateStr = _model.StartingDateStr;
            _advanced.EndingDateStr = _model.EndingDateStr;
            _advanced.IsCheckAPI = true;
            _advanced.LimitQty = 199999999;
            _advanced.LimitQtyUsed = 1;
            _advanced.IsMultiUsed = false;

            var advResult = await CouponService.SaveAdvancedAsync(_advanced);
            if (!advResult.Ok)
            {
                _errorMsg = advResult.Message;
                Snackbar.Add(advResult.Message, Severity.Error);
                return;
            }

            await AuditLogger.LogAsync(_currentActor, IsEditing ? "UPDATE" : "CREATE", "SetupCouponAdvanced",
                advResult.ItemNo, oldValueJson: null, newValueJson: JsonConvert.SerializeObject(_advanced));

            Snackbar.Add(result.Message, Severity.Success);
            Nav.NavigateTo("/promotion/coupons");   // phát hành xong → về danh sách Coupon/Voucher
            return;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("CouponIssuePage.Save", ex);
            Snackbar.Add("Lưu thất bại. Vui lòng thử lại.", Severity.Error);
        }
        finally { _saving = false; }
    }

    // ── Xem coupon: chỉ cập nhật RIÊNG field Blocked (CpnVchBOMHeader) + audit log ─────────
    private async Task SaveBlockedAsync()
    {
        if (!BlockedChanged) return;

        _saving = true;
        try
        {
            var oldJson = JsonConvert.SerializeObject(new { _advanced.ItemNo, Blocked = _originalBlocked });
            var result = await CouponService.UpdateBlockedAsync(_advanced.ItemNo, _advanced.Blocked);
            if (!result.Ok)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            await AuditLogger.LogAsync(_currentActor, "UPDATE", "SetupCoupon", _advanced.ItemNo,
                oldValueJson: oldJson,
                newValueJson: JsonConvert.SerializeObject(new { _advanced.ItemNo, _advanced.Blocked }));

            _originalBlocked = _advanced.Blocked;
            Snackbar.Add(result.Message, Severity.Success);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("CouponIssuePage.SaveBlocked", ex);
            Snackbar.Add("Cập nhật khóa coupon thất bại. Vui lòng thử lại.", Severity.Error);
        }
        finally { _saving = false; }
    }

    // ── Advanced dialog ───────────────────────────────────────────────────────
    private async Task OpenAdvancedAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Description)) { Snackbar.Add("Vui lòng nhập tên phát hành coupon", Severity.Warning); return; }
        if (_fromDate == null) { Snackbar.Add("Vui lòng chọn ngày bắt đầu", Severity.Warning); return; }
        if (_toDate == null) { Snackbar.Add("Vui lòng chọn ngày kết thúc", Severity.Warning); return; }

        // đồng bộ phần header vào advanced request
        _advanced.ItemNo = _model.ItemNo;
        _advanced.Description = _model.Description;
        _advanced.ArticleType = _model.ArticleType;
        _advanced.IssueType = _model.IssueType;
        _advanced.SaleType = _model.SaleType;
        _advanced.StoreGroupCode = _model.StoreGroupCode;
        _advanced.StartingDateStr = _fromDate.Value.ToString("dd/MM/yyyy");
        _advanced.EndingDateStr = _toDate.Value.ToString("dd/MM/yyyy");
        _advanced.IsCheckAPI = true;
        _advanced.LimitQty = 199999999;

        var parameters = new DialogParameters<CouponAdvancedDialog>
        {
            { x => x.Model, _advanced },
            { x => x.Uoms, _lookup.Uoms }
        };
        var dialog = await DialogService.ShowAsync<CouponAdvancedDialog>("Cài đặt nâng cao", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });

        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is CouponAdvancedSaveRequest adv)
        {
            adv.IsCheckAPI = true;
            adv.LimitQty = 199999999;
            _saving = true;
            try
            {
                var result = await CouponService.SaveAdvancedAsync(adv);
                if (!result.Ok) { Snackbar.Add(result.Message, Severity.Error); return; }
                _advanced = adv;
                _advanced.ItemNo = result.ItemNo;
                _model.ItemNo = result.ItemNo;
                await AuditLogger.LogAsync(_currentActor, "UPDATE", "SetupCouponAdvanced",
                    result.ItemNo, oldValueJson: null, newValueJson: JsonConvert.SerializeObject(adv));
                Snackbar.Add(result.Message, Severity.Success);
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("CouponIssuePage.SaveAdvanced", ex);
                Snackbar.Add("Lưu cài đặt nâng cao thất bại.", Severity.Error);
            }
            finally { _saving = false; }
        }
    }

