@page "/promotion/coupons/issue"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@using Newtonsoft.Json
@using POS.Application.Features.CouponVoucher
@using POS.Common.Dtos.SetupCoupon
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Components.Pages.Promotion.CouponVoucher.Dialogs
@using POS.Web.Services
@using ClosedXML.Excel

@inject ICouponService CouponService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuditLogger AuditLogger
@inject IFileLogHelper FileLogger
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Phát hành Coupon – POS Dashboard</PageTitle>

@* ── Header ─────────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.Sell" Class="mr-2" Style="vertical-align:middle"/>
        @(IsEditing ? $"Sửa coupon {_model.ItemNo}" : "Phát hành Coupon")
    </MudText>
    <MudStack Row="true" Spacing="1" Class="pos-page-header-btn">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/promotion/coupons"))">Danh sách</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving" OnClick="SaveAsync">@(_saving ? "Đang lưu..." : "Lưu")</MudButton>
    </MudStack>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px"/>
}
else
{
    @if (_errorMsg != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
    }

    @* ── Header form ────────────────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Value="@_model.ItemNo" Label="Mã phát hành" ReadOnly="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="Tự sinh khi lưu"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Description" Label="Tên phát hành *"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_model.IssueType" Label="Cách phát hành *" Disabled="CodeFieldsLocked"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("Auto")">Tự động tạo mã</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Import")">Import excel</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenAdvancedAsync">
                    Cài đặt nâng cao
                </MudButton>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_model.SaleType" Label="Hình thức bán hàng"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    @foreach (var s in _lookup.SalesTypes)
                    {
                        <MudSelectItem T="string" Value="@s.Value">@s.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_model.StoreGroupCode" Label="Nhóm cửa hàng"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    @foreach (var g in _lookup.StoreGroups)
                    {
                        <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_fromDate" Label="Từ ngày *" DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_toDate" Label="Đến ngày *" DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>

            @if (IsAuto)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_model.Prefix" Label="Tiền tố" Disabled="CodeFieldsLocked"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="6" sm="6" md="2">
                    <MudNumericField @bind-Value="_model.LenCode" Label="Kích thước mã (5-20)" Min="0" Max="20"
                                     Disabled="CodeFieldsLocked" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"/>
                </MudItem>
                <MudItem xs="6" sm="6" md="2">
                    <MudNumericField @bind-Value="_model.CharOfNumber" Label="Số chữ cái" Min="0"
                                     Disabled="CodeFieldsLocked" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"/>
                </MudItem>
                <MudItem xs="6" sm="6" md="2">
                    <MudNumericField @bind-Value="_model.CharPosition" Label="Vị trí đứng" Min="0"
                                     Disabled="CodeFieldsLocked" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"/>
                </MudItem>
                <MudItem xs="6" sm="6" md="3">
                    <MudNumericField @bind-Value="_model.Quantity" Label="Số lượng" Min="0"
                                     Disabled="CodeFieldsLocked" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"/>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="8" md="5" Class="d-flex align-center gap-2 flex-wrap">
                    <MudFileUpload T="IBrowserFile" @bind-Files="_importFile" Accept=".xls,.xlsx" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.UploadFile" Disabled="CodeFieldsLocked">
                                @(_importFile?.Name ?? "Chọn file Excel")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Text" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplateAsync">
                        File mẫu
                    </MudButton>
                </MudItem>
            }

            <MudItem xs="12">
                <MudCheckBox @bind-Value="_applyPerItem" Label="Áp dụng theo danh sách sản phẩm (bỏ chọn = áp dụng tổng hóa đơn)"
                             Color="Color.Primary" Dense="true"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Tabs: sản phẩm + mã coupon ─────────────────────────────────────── *@
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Danh sách sản phẩm" Icon="@Icons.Material.Filled.Inventory2">
            <div class="d-flex justify-end mb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenItemPickerAsync">Thêm sản phẩm</MudButton>
            </div>
            <MudTable Items="@_items" Dense="true" Hover="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="CouponItemLineDto">
                <HeaderContent>
                    <MudTh>Mã sản phẩm</MudTh>
                    <MudTh>Barcode</MudTh>
                    <MudTh>Tên sản phẩm</MudTh>
                    <MudTh>ĐVT</MudTh>
                    <MudTh Style="text-align:right; width:60px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mã sản phẩm">@context.ItemNo</MudTd>
                    <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
                    <MudTd DataLabel="Tên sản phẩm">@context.ItemName</MudTd>
                    <MudTd DataLabel="ĐVT">@context.UOM</MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => _items.Remove(context))"/>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Style="color:#9e9e9e">Chưa có sản phẩm. Coupon áp dụng tổng hóa đơn.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Mã coupon đã phát hành" Icon="@Icons.Material.Filled.QrCode2">
            @if (!IsEditing)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Lưu coupon để phát sinh và xem danh sách mã.
                </MudAlert>
            }
            else
            {
                <MudTable @ref="_codeTable" ServerData="LoadCodesData" Dense="true" Hover="true" Striped="true"
                          Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="CouponCodeDto">
                    <HeaderContent>
                        <MudTh Style="width:48px">STT</MudTh>
                        <MudTh>Mã coupon</MudTh>
                        <MudTh>Trạng thái</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="STT">@(_codeOffset + _codeRows.IndexOf(context) + 1)</MudTd>
                        <MudTd DataLabel="Mã coupon">@context.Code</MudTd>
                        <MudTd DataLabel="Trạng thái">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@(context.Enable ? Color.Success : Color.Error)">
                                @(context.Enable ? "Active" : "Locked")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4" Style="color:#9e9e9e">Chưa có mã coupon.</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                                       InfoFormat="{first_item}–{last_item} / {all_items} mã"
                                       RowsPerPageString="Số dòng/trang:"/>
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "id")]
    private string? Id { get; set; }

    private CouponIssueSaveRequest _model = new() { IssueType = "Auto", ArticleType = "ZCPN", StoreGroupCode = "ALL", SaleType = "ALL" };
    private CouponFormLookupDto _lookup = new();
    private List<CouponItemLineDto> _items = [];
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _applyPerItem;
    private int _quantityCodeInDb;
    private IBrowserFile? _importFile;

    // Advanced state (persist giữa các lần mở dialog)
    private CouponAdvancedSaveRequest _advanced = new();

    private MudTable<CouponCodeDto> _codeTable = null!;
    private List<CouponCodeDto> _codeRows = [];
    private int _codeOffset;

    private bool _loading = true;
    private bool _saving;
    private string? _errorMsg;
    private string _currentActor = "unknown";

    private bool IsEditing => !string.IsNullOrWhiteSpace(_model.ItemNo);
    private bool IsAuto => string.Equals(_model.IssueType, "Auto", StringComparison.OrdinalIgnoreCase);
    private bool CodeFieldsLocked => IsEditing && _quantityCodeInDb > 0;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        try
        {
            _lookup = await CouponService.GetFormLookupAsync();
            if (!string.IsNullOrWhiteSpace(Id))
                await LoadDetailAsync(Id!);
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu form. (Kiểm tra SP usp_SetupCoupon_* đã deploy chưa)";
            FileLogger.WriteExpLogs("CouponIssuePage.Init", ex);
        }
        finally { _loading = false; }
    }

    private async Task LoadDetailAsync(string itemNo)
    {
        var d = await CouponService.GetDetailAsync(itemNo);
        if (d == null) { _errorMsg = $"Không tìm thấy coupon {itemNo}."; return; }

        _model = new CouponIssueSaveRequest
        {
            ItemNo = d.ItemNo, Description = d.Description,
            IssueType = string.IsNullOrWhiteSpace(d.IssueType) ? "Auto" : d.IssueType,
            ArticleType = string.IsNullOrWhiteSpace(d.ArticleType) ? "ZCPN" : d.ArticleType,
            SaleType = string.IsNullOrWhiteSpace(d.SaleType) ? "ALL" : d.SaleType,
            StoreGroupCode = string.IsNullOrWhiteSpace(d.StoreGroupCode) ? "ALL" : d.StoreGroupCode,
            Prefix = d.Prefix, LenCode = d.LenCode, CharOfNumber = d.CharOfNumber, CharPosition = d.CharPosition,
            IsCheckItem = d.IsCheckItem, QuantityCodeInDB = d.QuantityCode
        };
        _quantityCodeInDb = d.QuantityCode;
        _applyPerItem = d.IsCheckItem;
        _items = d.Items ?? [];
        _fromDate = ParseDmy(d.StartingDate);
        _toDate = ParseDmy(d.EndingDate);

        _advanced = new CouponAdvancedSaveRequest
        {
            ItemNo = d.ItemNo, UOM = d.UOM, DiscountType = d.DiscountType == 0 ? 1 : d.DiscountType,
            DiscountValue = (double)d.DiscountValue, MaxValue = (double)d.MaxAmount, LimitQty = d.LimitQty,
            LimitQtyUsed = d.LimitQtyUsed, IsMultiUsed = d.IsMultiUse, IsCheckAPI = d.IsCheckAPI,
            Blocked = d.Blocked, CpnVchType = d.CpnVchType
        };
    }

    // ── Save ────────────────────────────────────────────────────────────────
    private async Task SaveAsync()
    {
        _errorMsg = null;

        if (string.IsNullOrWhiteSpace(_model.Description)) { Snackbar.Add("Vui lòng nhập tên phát hành coupon", Severity.Warning); return; }
        if (_fromDate == null) { Snackbar.Add("Vui lòng chọn ngày bắt đầu", Severity.Warning); return; }
        if (_toDate == null) { Snackbar.Add("Vui lòng chọn ngày kết thúc", Severity.Warning); return; }

        _model.StartingDateStr = _fromDate.Value.ToString("dd/MM/yyyy");
        _model.EndingDateStr = _toDate.Value.ToString("dd/MM/yyyy");
        _model.IsCheckItem = _applyPerItem;
        _model.Items = _applyPerItem ? _items : [];

        var needCodes = string.IsNullOrWhiteSpace(_model.ItemNo) || _quantityCodeInDb == 0;
        if (needCodes && !IsAuto)
        {
            // parse Excel → ImportCodes
            if (_importFile == null) { Snackbar.Add("Vui lòng chọn file excel để import", Severity.Warning); return; }
            try
            {
                _model.ImportCodes = await ParseImportFileAsync(_importFile);
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("CouponIssuePage.ParseExcel", ex);
                Snackbar.Add("Không đọc được file Excel. Kiểm tra đúng định dạng file mẫu.", Severity.Error);
                return;
            }
        }

        _saving = true;
        try
        {
            var before = IsEditing ? JsonConvert.SerializeObject(_model) : null;
            var result = await CouponService.SaveIssueAsync(_model);
            if (!result.Ok)
            {
                _errorMsg = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            await AuditLogger.LogAsync(_currentActor, IsEditing ? "UPDATE" : "CREATE", "SetupCoupon",
                result.ItemNo, oldValueJson: before, newValueJson: JsonConvert.SerializeObject(_model));

            Snackbar.Add(result.Message, Severity.Success);
            _importFile = null;
            await LoadDetailAsync(result.ItemNo);   // reload → khóa field, cập nhật số mã
            if (IsEditing) await _codeTable.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("CouponIssuePage.Save", ex);
            Snackbar.Add("Lưu thất bại. Vui lòng thử lại.", Severity.Error);
        }
        finally { _saving = false; }
    }

    // ── Advanced dialog ───────────────────────────────────────────────────────
    private async Task OpenAdvancedAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Description)) { Snackbar.Add("Vui lòng nhập tên phát hành coupon", Severity.Warning); return; }
        if (_fromDate == null) { Snackbar.Add("Vui lòng chọn ngày bắt đầu", Severity.Warning); return; }
        if (_toDate == null) { Snackbar.Add("Vui lòng chọn ngày kết thúc", Severity.Warning); return; }

        // đồng bộ phần header vào advanced request
        _advanced.ItemNo = _model.ItemNo;
        _advanced.Description = _model.Description;
        _advanced.ArticleType = _model.ArticleType;
        _advanced.IssueType = _model.IssueType;
        _advanced.SaleType = _model.SaleType;
        _advanced.StoreGroupCode = _model.StoreGroupCode;
        _advanced.StartingDateStr = _fromDate.Value.ToString("dd/MM/yyyy");
        _advanced.EndingDateStr = _toDate.Value.ToString("dd/MM/yyyy");

        var parameters = new DialogParameters<CouponAdvancedDialog>
        {
            { x => x.Model, _advanced },
            { x => x.Uoms, _lookup.Uoms }
        };
        var dialog = await DialogService.ShowAsync<CouponAdvancedDialog>("Cài đặt nâng cao", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });

        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is CouponAdvancedSaveRequest adv)
        {
            _saving = true;
            try
            {
                var result = await CouponService.SaveAdvancedAsync(adv);
                if (!result.Ok) { Snackbar.Add(result.Message, Severity.Error); return; }
                _advanced = adv;
                _advanced.ItemNo = result.ItemNo;
                _model.ItemNo = result.ItemNo;
                await AuditLogger.LogAsync(_currentActor, "UPDATE", "SetupCouponAdvanced",
                    result.ItemNo, oldValueJson: null, newValueJson: JsonConvert.SerializeObject(adv));
                Snackbar.Add(result.Message, Severity.Success);
            }
            catch (Exception ex)
            {
                FileLogger.WriteExpLogs("CouponIssuePage.SaveAdvanced", ex);
                Snackbar.Add("Lưu cài đặt nâng cao thất bại.", Severity.Error);
            }
            finally { _saving = false; }
        }
    }

    // ── Item picker dialog ────────────────────────────────────────────────────
    private async Task OpenItemPickerAsync()
    {
        var dialog = await DialogService.ShowAsync<CouponItemPickerDialog>("Thêm sản phẩm coupon", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, BackdropClick = false });
        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is List<CouponItemLineDto> picked)
        {
            foreach (var p in picked)
                if (!_items.Any(x => x.ItemNo == p.ItemNo))
                    _items.Add(p);
        }
    }

    // ── Codes table ───────────────────────────────────────────────────────────
    private async Task<TableData<CouponCodeDto>> LoadCodesData(TableState state, CancellationToken token)
    {
        _codeOffset = state.Page * state.PageSize;
        var (items, total) = await CouponService.GetCodesAsync(new CouponCodeFilter
        {
            ItemNo = _model.ItemNo, PageSize = state.PageSize, PageNumber = state.Page
        }, token);
        _codeRows = items;
        return new TableData<CouponCodeDto> { Items = items, TotalItems = total };
    }

    // ── Excel ─────────────────────────────────────────────────────────────────
    private static async Task<List<string>> ParseImportFileAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        ms.Position = 0;
        using var wb = new XLWorkbook(ms);
        var ws = wb.Worksheet(1);
        var codes = new List<string>();
        var lastRow = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= lastRow; r++)     // bỏ header dòng 1
        {
            var val = ws.Cell(r, 1).GetString();
            if (string.IsNullOrWhiteSpace(val) && ws.Row(r).IsEmpty()) continue;
            codes.Add(val);
        }
        return codes;
    }

    private async Task DownloadTemplateAsync()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("DataImport");
        ws.Cell(1, 1).Value = "CodeCoupon";
        ws.Row(1).Style.Font.Bold = true;
        ws.Cell(2, 1).Value = "COUPON001";
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.SaveAsFileAsync($"FileMauCoupon_{DateTime.Now:yyyyMMddHHmmss}.xlsx", ms.ToArray(),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private static DateTime? ParseDmy(string? dmy)
        => DateTime.TryParseExact(dmy, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d : null;
}
