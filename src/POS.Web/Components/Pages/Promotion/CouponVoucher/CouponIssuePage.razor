    // ── Item picker dialog ────────────────────────────────────────────────────
    private async Task OpenItemPickerAsync()
    {
        if (!_applyPerItem)
        {
            Snackbar.Add("Bạn chưa chọn: Áp dụng theo danh sách sản phẩm (bỏ chọn = áp dụng tổng hóa đơn)", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<CouponItemPickerDialog>("Thêm sản phẩm coupon", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, BackdropClick = false });
        var res = await dialog.Result;
        if (res is { Canceled: false } && res.Data is List<CouponItemLineDto> picked)
        {
            foreach (var p in picked)
                if (!_items.Any(x => x.ItemNo == p.ItemNo))
                    _items.Add(p);
        }
    }

    // ── Codes table ───────────────────────────────────────────────────────────
    private async Task<TableData<CouponCodeDto>> LoadCodesData(TableState state, CancellationToken token)
    {
        _codeOffset = state.Page * state.PageSize;
        var (items, total) = await CouponService.GetCodesAsync(new CouponCodeFilter
        {
            ItemNo = _model.ItemNo, PageSize = state.PageSize, PageNumber = state.Page
        }, token);
        _codeRows = items;
        return new TableData<CouponCodeDto> { Items = items, TotalItems = total };
    }

    // ── Excel ─────────────────────────────────────────────────────────────────
    private static async Task<List<string>> ParseImportFileAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        ms.Position = 0;
        using var wb = new XLWorkbook(ms);
        var ws = wb.Worksheet(1);
        var codes = new List<string>();
        var lastRow = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= lastRow; r++)     // bỏ header dòng 1
        {
            var val = ws.Cell(r, 1).GetString();
            if (string.IsNullOrWhiteSpace(val) && ws.Row(r).IsEmpty()) continue;
            codes.Add(val);
        }
        return codes;
    }

    private async Task DownloadTemplateAsync()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("DataImport");
        ws.Cell(1, 1).Value = "CodeCoupon";
        ws.Row(1).Style.Font.Bold = true;
        ws.Cell(2, 1).Value = "COUPON001";
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.SaveAsFileAsync($"FileMauCoupon_{DateTime.Now:yyyyMMddHHmmss}.xlsx", ms.ToArray(),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private static DateTime? ParseDmy(string? dmy)
        => DateTime.TryParseExact(dmy, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d : null;
}
