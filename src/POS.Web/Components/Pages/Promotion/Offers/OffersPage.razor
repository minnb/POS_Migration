@page "/promotion/offers"
@attribute [Authorize(Policy = WebPolicies.BackOfficeAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using MudBlazor
@using POS.Application.Features.Promotion
@using POS.Common.Dtos.Promotion
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Services
@using ClosedXML.Excel

@inject IPromotionService PromotionService
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Danh mục Khuyến mãi – POS Dashboard</PageTitle>

<MudMessageBox @ref="_confirmDeactivateBox" Title="Xác nhận deactive" CancelText="Hủy">
    <MessageContent>@_confirmDeactivateMsg</MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="pos-btn-mockup">Deactive</MudButton>
    </YesButton>
</MudMessageBox>

@* ── Header ──────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Danh mục Khuyến mãi
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="pos-btn-mockup pos-page-header-btn"
               StartIcon="@Icons.Material.Filled.FileDownload"
               Disabled="_exporting" OnClick="ExportExcelAsync">
        @(_exporting ? "Đang xuất..." : "Xuất Excel")
    </MudButton>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_filter.TextSearch" Label="Mã CTKM"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_filter.PromotionName" Label="Tên CTKM"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker @bind-Date="_filterFromDate" Label="Từ ngày"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_filter.ItemNo" Label="Mã sản phẩm"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Tag"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_filter.OfferType" Label="Loại CTKM" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("")">Tất cả</MudSelectItem>
                @foreach (var o in _offerTypes)
                {
                    <MudSelectItem T="string" Value="@o.Value">@o.Text</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_filter.Status" Label="Trạng thái"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem T="string" Value="@("0")">Hiệu lực</MudSelectItem>
                <MudSelectItem T="string" Value="@("2")">Hết hiệu lực</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="pos-btn-mockup"
                           FullWidth="true" OnClick="SearchAsync">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined" Class="pos-btn-mockup pos-btn-secondary-mockup"
                           FullWidth="true" OnClick="ClearFilterAsync">Xóa</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Offer header table (server-side) ────────────────────────────────── *@
<MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
          Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="OfferHeaderListItemDto">
    <HeaderContent>
        <MudTh Style="width:48px">STT</MudTh>
        <MudTh>Action</MudTh>
        <MudTh>Mã CTKM</MudTh>
        <MudTh Style="white-space:normal">Tên CTKM</MudTh>
        <MudTh>OfferType</MudTh>
        <MudTh>Trạng thái</MudTh>
        <MudTh>Từ ngày</MudTh>
        <MudTh>Đến ngày</MudTh>
        <MudTh>SiteGroup</MudTh>
        <MudTh Style="text-align:right">LimitQty</MudTh>
        <MudTh>Ngày cập nhật</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(_offset + _rows.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Action" Style="white-space:nowrap">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                           Title="Xem chi tiết" OnClick="@(() => OpenDetailDialogAsync(context))"/>
            @if (IsActive(context.Status))
            {
                <MudIconButton Icon="@Icons.Material.Filled.ToggleOff" Size="Size.Small" Color="Color.Error"
                               Title="Deactive" OnClick="@(() => ConfirmDeactivateAsync(context))"/>
            }
        </MudTd>
        <MudTd DataLabel="Mã CTKM">@context.BonusbuyNo</MudTd>
        <MudTd DataLabel="Tên CTKM" Style="white-space:normal">@context.Description</MudTd>
        <MudTd DataLabel="OfferType">@context.OfferType</MudTd>
        <MudTd DataLabel="Trạng thái">
            @{
                var (effCss, effLabel) = EffectDisplay(IsActive(context.Status));
            }
            <span class="pos-status-chip @effCss">@effLabel</span>
        </MudTd>
        <MudTd DataLabel="Từ ngày">@context.StartingDate</MudTd>
        <MudTd DataLabel="Đến ngày">@context.EndingDate</MudTd>
        <MudTd DataLabel="SiteGroup">@context.LocalSiteGroup</MudTd>
        <MudTd DataLabel="LimitQty" Style="text-align:right">@context.LimitQty.ToString("#,##0.##")</MudTd>
        <MudTd DataLabel="Ngày cập nhật">
            <MudText Typo="Typo.caption">
                @(DateTime.TryParse(context.LastDateModified, out var lastModified)
                    ? lastModified.ToString("dd-MM-yyyy HH:mm:ss")
                    : context.LastDateModified)
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center pa-4" style="color:var(--mud-palette-text-secondary)">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2"/>
            <MudText Typo="Typo.body2">Không có khuyến mãi khớp bộ lọc.</MudText>
        </div>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Align="Align.Center" Class="pa-4">Đang tải...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    private MudTable<OfferHeaderListItemDto> _table = null!;
    private readonly OfferListFilter _filter = new() { Status = "0", PageSize = 20 };

    // Mặc định load trang: CTKM còn hiệu lực từ 12 tháng trước tới nay (chỉ lọc mốc đầu — xem
    // docs/sql/GetPromotionOfferHeaderList_AddDateRangeFilter.sql). Chốt 2026-07-10: đổi từ 90
    // ngày sang đúng 1 năm (AddYears, không phải AddDays(-365)) để luôn ra đúng cùng ngày/tháng
    // năm trước (vd hôm nay 10/07/2026 -> 10/07/2025).
    private DateTime? _filterFromDate = DateTime.Today.AddYears(-1);

    private List<OfferHeaderListItemDto> _rows = [];
    private List<OfferTypeOptionDto> _offerTypes = [];
    private int _offset;
    private bool _exporting;
    private string? _errorMsg;

    private MudMessageBox? _confirmDeactivateBox;
    private string _confirmDeactivateMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _offerTypes = await PromotionService.GetOfferTypeOptionsAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("OffersPage.LoadOptions", ex);
        }
    }

    // ── Server-side data load (auto-load trang 1 khi render) ─────────────
    private async Task<TableData<OfferHeaderListItemDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _filter.PageNumber = state.Page;          // SP OFFSET = PageSize * PageNumber (0-based)
        _filter.PageSize   = state.PageSize;
        _filter.FromDate   = _filterFromDate;
        _offset            = state.Page * state.PageSize;
        try
        {
            var (items, total) = await PromotionService.GetOfferHeaderListAsync(_filter, token);
            _rows = items;
            _errorMsg = null;
            return new TableData<OfferHeaderListItemDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh mục khuyến mãi.";
            FileLogger.WriteExpLogs("OffersPage.Load", ex);
            _rows = [];
            return new TableData<OfferHeaderListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task OpenDetailDialogAsync(OfferHeaderListItemDto row)
    {
        var parameters = new DialogParameters<OfferDetailDialog>
        {
            { x => x.OfferNo, row.BonusbuyNo }, { x => x.OfferType, row.OfferType }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<OfferDetailDialog>("Thông tin chi tiết khuyến mãi", parameters, options);
    }

    // Ported from src/legacy/Database/Stored_Procedures/Script_Stored_Procedures.sql
    // (Setup_Promotion_Insert — quy ước Status 0/1/2 + Counter sync). Tính năng mới, KHÔNG có ở
    // legacy PromotionList — legacy chỉ read-only, không cho phép tắt offer đã publish từ UI.
    private async Task ConfirmDeactivateAsync(OfferHeaderListItemDto row)
    {
        _confirmDeactivateMsg = $"Bạn có chắc muốn deactive khuyến mãi [{row.BonusbuyNo}] {row.Description}? " +
                                 "Không thể hoàn tác.";
        var confirmed = await _confirmDeactivateBox!.ShowAsync();
        if (confirmed != true) return;

        try
        {
            var (ok, message) = await PromotionService.DeactivateOfferAsync(row.BonusbuyNo);
            Snackbar.Add(message, ok ? Severity.Success : Severity.Error);
            if (ok) await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("OffersPage.Deactivate", ex);
            Snackbar.Add("Deactive khuyến mãi thất bại.", Severity.Error);
        }
    }

    private async Task SearchAsync() => await _table.ReloadServerData();

    private async Task ClearFilterAsync()
    {
        _filter.TextSearch    = null;
        _filter.PromotionName = null;
        _filter.OfferType     = null;
        _filter.ItemNo        = null;
        _filter.Status        = "0";
        _filterFromDate       = DateTime.Today.AddYears(-1);
        await _table.ReloadServerData();
    }

    private static bool IsActive(string? status) =>
        !string.IsNullOrEmpty(status)
        && status.Contains("hiệu lực", StringComparison.OrdinalIgnoreCase)
        && !status.Contains("Hết", StringComparison.OrdinalIgnoreCase);

    // CssClass là 1 trong 4 modifier .pos-status-{success,error,warning,info} (app.css) —
    // badge dạng dot-pill theo mockup docs/web/images/status.jpg (KHÔNG dùng MudChip, xem app.css).
    // Chuẩn nhãn trạng thái hiệu lực toàn dự án: "Hiệu lực" / "Hết hiệu lực" (.claude/rules/mudblazor-flat-ui.md §4a).
    private static (string CssClass, string Label) EffectDisplay(bool isActive) =>
        isActive ? ("pos-status-success", "Hiệu lực") : ("pos-status-error", "Hết hiệu lực");

    // ── Export Excel (ClosedXML) ─────────────────────────────────────────
    private async Task ExportExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            _filter.FromDate = _filterFromDate;
            var data = await PromotionService.ExportOfferHeaderListAsync(_filter);
            var bytes = BuildXlsx(data);
            var fileName = $"DanhMucKhuyenMai_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JS.SaveAsFileAsync(fileName, bytes,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add($"Đã xuất {data.Count} khuyến mãi.", Severity.Success);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("OffersPage.Export", ex);
            Snackbar.Add("Xuất Excel thất bại.", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    // Ported from src/legacy/VCM.BLUEPOS/Controllers/PromotionController.cs:224-289 (thêm 2 cột Voucher)
    private static byte[] BuildXlsx(IReadOnlyList<OfferHeaderListItemDto> data)
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("KhuyenMai");

        string[] headers =
        [
            "Mã CTKM", "Tên CTKM", "Loại CTKM", "Hình thức bán",
            "Trạng thái", "Từ ngày", "Đến ngày", "Voucher có giá trị từ ngày", "Voucher có giá trị đến ngày",
            "Local Site Group", "LimitQty", "Ngày cập nhật"
        ];
        for (var c = 0; c < headers.Length; c++)
            ws.Cell(1, c + 1).Value = headers[c];
        ws.Row(1).Style.Font.Bold = true;

        var r = 2;
        foreach (var e in data)
        {
            ws.Cell(r, 1).Value = e.BonusbuyNo;
            ws.Cell(r, 2).Value = e.Description;
            ws.Cell(r, 3).Value = e.OfferType;
            ws.Cell(r, 4).Value = e.SalesTypeName;
            ws.Cell(r, 5).Value = IsActive(e.Status) ? "Hiệu lực" : "Hết hiệu lực";
            ws.Cell(r, 6).Value = e.StartingDate;
            ws.Cell(r, 7).Value = e.EndingDate;
            ws.Cell(r, 8).Value = e.VoucherFromDate;
            ws.Cell(r, 9).Value = e.VoucherToDate;
            ws.Cell(r, 10).Value = e.LocalSiteGroup;
            ws.Cell(r, 11).Value = e.LimitQty;
            ws.Cell(r, 12).Value = e.LastDateModified;
            r++;
        }

        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        return ms.ToArray();
    }
}
