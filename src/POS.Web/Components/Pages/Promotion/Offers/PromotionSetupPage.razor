            // bắt buộc voucher (khớp trạng thái đã lưu) — để đổi OfferType sau đó reset đúng.
            _voucherForcedByOfferType = _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType)?.IsVoucher ?? false;
