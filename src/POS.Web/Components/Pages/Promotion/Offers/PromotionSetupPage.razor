@page "/promotion/setup"
@attribute [Authorize(Policy = WebPolicies.OpsAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Newtonsoft.Json
@using POS.Application.Features.Promotion
@using POS.Common.Dtos.Promotion
@using POS.Infrastructure.Logging
@using POS.Web.Auth
@using POS.Web.Components.Pages.Promotion.Offers

@inject IPromotionService PromotionService
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IAuditLogger AuditLogger

<PageTitle>Cài đặt CTKM – POS Dashboard</PageTitle>

<MudMessageBox @ref="_confirmBox" Title="Duyệt CTKM" CancelText="Hủy">
    <MessageContent>@_confirmMsg</MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success">Duyệt</MudButton>
    </YesButton>
</MudMessageBox>

<MudMessageBox @ref="_confirmDiscountBox" Title="Xác nhận" CancelText="Không">
    <MessageContent>@_confirmDiscountMsg</MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error">Có</MudButton>
    </YesButton>
</MudMessageBox>

@if (!_editing)
{
    @* ══ LIST MODE ══════════════════════════════════════════════════════ *@
    <div class="pos-page-header mb-4">
        <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
            Cài đặt CTKM
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="pos-page-header-btn"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewAsync">Thêm CTKM</MudButton>
    </div>

    <MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_filter.OfferNo" Label="Mã CTKM"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_filter.OfferName" Label="Tên CTKM"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_filter.ApproveStatus" Label="Trạng thái duyệt"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("")">Tất cả</MudSelectItem>
                    <MudSelectItem T="string" Value="@("0")">Chưa duyệt</MudSelectItem>
                    <MudSelectItem T="string" Value="@("1")">Đã duyệt</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
                <MudStack Row="true" Spacing="1" Class="w-100">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true" OnClick="SearchAsync">Tìm</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               FullWidth="true" OnClick="ClearFilterAsync">Xóa</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
              Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true" T="PromotionSetupListItemDto">
        <HeaderContent>
            <MudTh Style="width:48px">STT</MudTh>
            <MudTh>Mã CTKM</MudTh>
            <MudTh>Tên CTKM</MudTh>
            <MudTh>Loại CTKM</MudTh>
            <MudTh>Hình thức bán</MudTh>
            <MudTh>Hiệu lực</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Duyệt</MudTh>
            <MudTh Style="text-align:center">Thao tác</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_offset + _rows.IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="Mã CTKM"><b>@context.No</b></MudTd>
            <MudTd DataLabel="Tên CTKM">@context.Description</MudTd>
            <MudTd DataLabel="Loại CTKM">@context.OfferType</MudTd>
            <MudTd DataLabel="Hình thức bán">@context.SalesType</MudTd>
            <MudTd DataLabel="Hiệu lực">@FmtYmd(context.ValidFrom) – @FmtYmd(context.ValidTo)</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.Status == "0" ? Color.Success : context.Status == "1" ? Color.Info : Color.Default)">
                    @StatusText(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Duyệt">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.IsApprove ? Color.Success : Color.Default)">
                    @(context.IsApprove ? "Đã duyệt" : "Chưa duyệt")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Thao tác" Style="text-align:center">
                <MudTooltip Text="@(context.IsApprove ? "Xem" : "Sửa")">
                    <MudIconButton Size="Size.Small"
                                   Icon="@(context.IsApprove ? Icons.Material.Filled.Visibility : Icons.Material.Filled.Edit)"
                                   Color="Color.Primary" OnClick="@(() => OpenEditAsync(context.No))"/>
                </MudTooltip>
                @if (!context.IsApprove)
                {
                    <MudTooltip Text="Duyệt CTKM">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle"
                                       Color="Color.Success" OnClick="@(() => ApproveAsync(context.No))"/>
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="d-flex flex-column align-center pa-4">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:3rem;color:var(--pos-text-disabled)" Class="mb-2"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Không có CTKM khớp bộ lọc.</MudText>
            </div>
        </NoRecordsContent>
        <LoadingContent><MudText Align="Align.Center" Class="pa-4">Đang tải...</MudText></LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                           InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                           RowsPerPageString="Số dòng mỗi trang:"/>
        </PagerContent>
    </MudTable>
}
else
{
    @* ══ EDITOR MODE ════════════════════════════════════════════════════ *@
    <div class="pos-page-header mb-4">
        <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
            @(string.IsNullOrEmpty(_header.No) ? "Thêm CTKM" : $"CTKM {_header.No}")
            @if (_isReadonly)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">Đã duyệt — chỉ xem</MudChip>
            }
        </MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Class="pos-page-header-btn" OnClick="BackToList">Quay lại</MudButton>
    </div>

    @* ── Khối form cố định (ngoài 4 tab) — khớp SetupMain.cshtml gốc ── *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4" md="3">
                <MudTextField Value="@_header.No" Label="Mã CTKM" ReadOnly="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              HelperText="@(string.IsNullOrEmpty(_header.No) ? "Tự sinh khi lưu" : null)"/>
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudSelect @bind-Value="_header.SalesType" Label="Hình thức bán hàng" Required="true"
                           RequiredError="Vui lòng chọn hình thức bán hàng" Disabled="_isReadonly"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var o in _salesTypes)
                    {
                        <MudSelectItem T="string" Value="@o.Value">@o.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" md="6">
                <MudTextField @bind-Value="_header.Description" Label="Tên CTKM" Required="true"
                              RequiredError="Vui lòng nhập tên chương trình khuyến mãi" Disabled="_isReadonly"
                              Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Tên hiển thị cho thu ngân"/>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_header.Status" Label="Trạng thái" Disabled="_isReadonly"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("0")">Đang áp dụng</MudSelectItem>
                    <MudSelectItem T="string" Value="@("1")">Lên kế hoạch</MudSelectItem>
                    <MudSelectItem T="string" Value="@("2")">Ngưng áp dụng</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_header.OfferType" @bind-Value:after="OnOfferTypeChanged" Label="Loại CTKM" Required="true"
                           RequiredError="Vui lòng chọn loại CTKM" Disabled="_isReadonly"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var o in _offerTypes)
                    {
                        <MudSelectItem T="string" Value="@o.Value">@o.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_header.IsVoucher" Label="Voucher/Coupon"
                             Disabled="@(_isReadonly || VoucherCheckboxLocked)" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker @bind-Date="_fromDate" Label="Từ ngày" Required="true"
                               RequiredError="Vui lòng chọn ngày bắt đầu" Disabled="_isReadonly"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker @bind-Date="_toDate" Label="Đến ngày" Required="true"
                               RequiredError="Vui lòng chọn ngày kết thúc" Disabled="_isReadonly"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
            </MudItem>

            @if (!string.IsNullOrEmpty(CurrentOfferTypeUserGuide))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@CurrentOfferTypeUserGuide</MudText>
                </MudItem>
            }
        </MudGrid>

        <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true" Icon="@Icons.Material.Filled.ShoppingCart">
            <b>[Sản phẩm mua]</b>: Tích giá trị tổng tiền tối thiểu và nhập Số tiền tối thiểu cho đơn hàng.
            Danh sách sản phẩm để xét sum tổng tiền. Nếu để trống thì sum all.
        </MudAlert>
        <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true" Icon="@Icons.Material.Filled.CardGiftcard">
            <b>[Sản phẩm khuyến mãi]</b>: Nhập Sản phẩm/ Group sản phẩm được tặng hoặc được khuyến mại.
        </MudAlert>

        @if (!_isReadonly)
        {
            <div class="d-flex justify-end mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="@(() => SaveAsync(true))">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2"/>
                    }
                    Lưu tạm
                </MudButton>
            </div>
        }
    </MudPaper>

    <MudTabs Outlined="true" ApplyEffectsToContainer="true" PanelClass="pa-4" SliderColor="Color.Primary">
        @* ── Tab Thông tin chung — bảng tóm tắt lịch áp dụng ── *@
        <MudTabPanel Text="Thông tin chung" Icon="@Icons.Material.Filled.Info">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudTable Items="@(new[] { _header })" Dense="true" Hover="false" Elevation="0"
                              HorizontalScrollbar="true" T="PromotionSetupHeaderDto">
                        <HeaderContent>
                            <MudTh>Mã CTKM</MudTh>
                            <MudTh>Tên CTKM</MudTh>
                            <MudTh>Loại CTKM</MudTh>
                            <MudTh>Trạng thái</MudTh>
                            <MudTh Style="width:110px">Từ giờ</MudTh>
                            <MudTh Style="width:110px">Đến giờ</MudTh>
                            <MudTh>Mon</MudTh><MudTh>Tue</MudTh><MudTh>Wed</MudTh><MudTh>Thu</MudTh>
                            <MudTh>Fri</MudTh><MudTh>Sat</MudTh><MudTh>Sun</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Mã CTKM"><b>@(string.IsNullOrEmpty(context.No) ? "(chưa có)" : context.No)</b></MudTd>
                            <MudTd DataLabel="Tên CTKM">@context.Description</MudTd>
                            <MudTd DataLabel="Loại CTKM">@context.OfferType</MudTd>
                            <MudTd DataLabel="Trạng thái">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Color="@(context.Status == "0" ? Color.Success : context.Status == "1" ? Color.Info : Color.Default)">
                                    @StatusText(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Từ giờ">
                                <MudTextField @bind-Value="context.FromTime" Disabled="_isReadonly" Placeholder="hh:mm"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px"/>
                            </MudTd>
                            <MudTd DataLabel="Đến giờ">
                                <MudTextField @bind-Value="context.ToTime" Disabled="_isReadonly" Placeholder="hh:mm"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px"/>
                            </MudTd>
                            <MudTd DataLabel="Mon"><MudCheckBox @bind-Value="context.Mon" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Tue"><MudCheckBox @bind-Value="context.Tue" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Wed"><MudCheckBox @bind-Value="context.Wed" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Thu"><MudCheckBox @bind-Value="context.Thu" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Fri"><MudCheckBox @bind-Value="context.Fri" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Sat"><MudCheckBox @bind-Value="context.Sat" Disabled="_isReadonly"/></MudTd>
                            <MudTd DataLabel="Sun"><MudCheckBox @bind-Value="context.Sun" Disabled="_isReadonly"/></MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudTabPanel>

        @* ── Tab Sản phẩm mua (Buy) ── *@
        <MudTabPanel Text="Sản phẩm mua" Icon="@Icons.Material.Filled.ShoppingCart">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudTable Items="_buyRows" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                              HorizontalScrollbar="true" T="OfferBuyLineDto">
                        <ToolBarContent>
                            <MudNumericField T="int" @bind-Value="_bulkAddCountBuy" Label="Số lượng dòng" Style="max-width:140px"
                                             Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Min="1" Max="50"/>
                            <MudSelect T="string" @bind-Value="_header.ConditionBuy" Label="Điều kiện áp dụng" Dense="true"
                                       Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:200px">
                                <MudSelectItem T="string" Value="@("AND")">AND</MudSelectItem>
                                <MudSelectItem T="string" Value="@("OR")">OR</MudSelectItem>
                            </MudSelect>
                            <MudNumericField T="decimal" @bind-Value="_header.MinValue" Label="Giá trị tổng tiền tối thiểu"
                                             Disabled="@(_isReadonly || !CurrentOfferTypeIsTotalBill)" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" HideSpinButtons="true" Min="0"
                                             Adornment="Adornment.End" AdornmentText="VNĐ" Style="max-width:220px"/>
                            <MudSpacer/>
                            @if (!_isReadonly)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="BulkAddBuyRows">Thêm dòng (Ctrl+A)</MudButton>
                            }
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh Style="width:110px">Loại</MudTh>
                            <MudTh Style="width:160px">Barcode/Mã Nhóm SP</MudTh>
                            <MudTh>Sản phẩm</MudTh>
                            <MudTh Style="width:90px">ĐVT</MudTh>
                            <MudTh Style="width:110px;text-align:right">Số lượng</MudTh>
                            <MudTh Style="width:140px">Điều kiện áp dụng</MudTh>
                            <MudTh Style="width:56px;text-align:center">Xóa</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Loại">
                                <MudSelect T="int" @bind-Value="context.LineType" Dense="true" Disabled="_isReadonly"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="int" Value="0">Sản phẩm</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">Nhóm SP</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Barcode/Mã Nhóm SP">
                                @if (context.LineType == 0)
                                {
                                    <MudTextField @bind-Value="context.No" Disabled="@(_isReadonly || !string.IsNullOrEmpty(context.Description))"
                                                  Placeholder="Nhập barcode..." Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  OnBlur="@(() => OnBarcodeBlur(context))"/>
                                }
                                else
                                {
                                    <MudTextField @bind-Value="context.GroupCode" Disabled="_isReadonly" Placeholder="Nhập mã nhóm..."
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                }
                            </MudTd>
                            <MudTd DataLabel="Sản phẩm">
                                @if (context.LineType == 0)
                                {
                                    @LineItemCell(context)
                                }
                                else
                                {
                                    <div class="d-flex align-center gap-1">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   Disabled="_isReadonly" StartIcon="@Icons.Material.Filled.Settings"
                                                   OnClick="@(() => OpenItemGroupSetupDialogAsync(context))">Cấu hình nhóm</MudButton>
                                        @if (!string.IsNullOrEmpty(context.GroupCode))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.GroupCode</MudText>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd DataLabel="ĐVT">
                                <MudTextField @bind-Value="context.UnitOfMeasure" Disabled="_isReadonly"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"/>
                            </MudTd>
                            <MudTd DataLabel="Số lượng" Style="text-align:right">
                                <MudNumericField T="int" Value="@((int)context.Quantity)" ValueChanged="@(v => context.Quantity = v)"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0"/>
                            </MudTd>
                            <MudTd DataLabel="Điều kiện áp dụng">
                                <MudSelect T="string" @bind-Value="context.ScaleType" Dense="true" Disabled="_isReadonly"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="string" Value="@("A")">Tối thiểu</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("B")">Tối đa</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("C")">Vòng quay</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd Style="text-align:center">
                                @if (!_isReadonly)
                                {
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   OnClick="@(() => _buyRows.Remove(context))"/>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="d-flex flex-column align-center pa-4">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:3rem;color:var(--pos-text-disabled)" Class="mb-2"/>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có dòng sản phẩm mua.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudTabPanel>

        @* ── Tab Sản phẩm khuyến mãi (Get) ── *@
        <MudTabPanel Text="Sản phẩm khuyến mãi" Icon="@Icons.Material.Filled.CardGiftcard">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudTable Items="_getRows" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                              HorizontalScrollbar="true" T="OfferGetLineDto">
                        <ToolBarContent>
                            <MudNumericField T="int" @bind-Value="_bulkAddCountGet" Label="Số lượng dòng" Style="max-width:140px"
                                             Disabled="@(_isReadonly || _header.CheckTotalDiscount)" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" HideSpinButtons="true" Min="1" Max="50"/>
                            <MudSelect T="string" @bind-Value="_header.ConditionGet" Label="Điều kiện áp dụng" Dense="true"
                                       Disabled="@(_isReadonly || _header.CheckTotalDiscount)" Variant="Variant.Outlined"
                                       Margin="Margin.Dense" Style="max-width:200px">
                                <MudSelectItem T="string" Value="@("AND")">AND</MudSelectItem>
                                <MudSelectItem T="string" Value="@("OR")">OR</MudSelectItem>
                            </MudSelect>
                            <MudSpacer/>
                            <MudCheckBox T="bool" Value="_header.CheckTotalDiscount" ValueChanged="OnCheckTotalDiscountChanged"
                                         Label="Giảm giá tổng bill" Disabled="_isReadonly" Color="Color.Primary"/>
                            @if (_header.CheckTotalDiscount)
                            {
                                <MudSelect T="int" @bind-Value="_header.TotalDiscountType" Label="Loại khuyến mãi"
                                           Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px">
                                    <MudSelectItem T="int" Value="0">Discount Percent (%)</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">Discount Amount (VNĐ)</MudSelectItem>
                                    <MudSelectItem T="int" Value="2">Discount Price (VNĐ)</MudSelectItem>
                                </MudSelect>
                                <MudNumericField T="decimal" @bind-Value="_header.TotalDiscountValue" Label="Giá trị khuyến mãi"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0" Style="max-width:180px"/>
                            }
                            @if (!_isReadonly && !_header.CheckTotalDiscount)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="BulkAddGetRows">Thêm dòng (Ctrl+A)</MudButton>
                            }
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh Style="width:110px">Loại</MudTh>
                            <MudTh Style="width:160px">Barcode/Mã Nhóm SP</MudTh>
                            <MudTh>Sản phẩm</MudTh>
                            <MudTh Style="width:90px">ĐVT</MudTh>
                            <MudTh Style="width:100px;text-align:right">Số lượng</MudTh>
                            <MudTh Style="width:130px">Điều kiện áp dụng</MudTh>
                            <MudTh Style="width:150px">
                                <MudTooltip Text="% = giảm theo phần trăm; Số tiền = giảm số tiền cố định; Giá cố định = bán theo giá ấn định">
                                    <span>Loại khuyến mãi</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="width:120px;text-align:right">Giá trị</MudTh>
                            <MudTh Style="width:56px;text-align:center">Xóa</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Loại">
                                <MudSelect T="int" @bind-Value="context.LineType" Dense="true" Disabled="_isReadonly"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="int" Value="0">Sản phẩm</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">Nhóm SP</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Barcode/Mã Nhóm SP">
                                @if (context.LineType == 0)
                                {
                                    <MudTextField @bind-Value="context.No" Disabled="@(_isReadonly || !string.IsNullOrEmpty(context.Description))"
                                                  Placeholder="Nhập barcode..." Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  OnBlur="@(() => OnBarcodeBlur(context))"/>
                                }
                                else
                                {
                                    <MudTextField @bind-Value="context.GroupCode" Disabled="_isReadonly" Placeholder="Nhập mã nhóm..."
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                }
                            </MudTd>
                            <MudTd DataLabel="Sản phẩm">
                                @if (context.LineType == 0)
                                {
                                    @LineItemCell(context)
                                }
                                else
                                {
                                    <div class="d-flex align-center gap-1">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   Disabled="_isReadonly" StartIcon="@Icons.Material.Filled.Settings"
                                                   OnClick="@(() => OpenItemGroupSetupDialogAsync(context))">Cấu hình nhóm</MudButton>
                                        @if (!string.IsNullOrEmpty(context.GroupCode))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.GroupCode</MudText>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd DataLabel="ĐVT">
                                <MudTextField @bind-Value="context.UnitOfMeasure" Disabled="_isReadonly"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"/>
                            </MudTd>
                            <MudTd DataLabel="Số lượng" Style="text-align:right">
                                <MudNumericField T="int" Value="@((int)context.Quantity)" ValueChanged="@(v => context.Quantity = v)"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0"/>
                            </MudTd>
                            <MudTd DataLabel="Điều kiện áp dụng">
                                <MudSelect T="string" @bind-Value="context.ScaleType" Dense="true" Disabled="_isReadonly"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="string" Value="@("A")">Tối thiểu</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("B")">Tối đa</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("C")">Vòng quay</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Loại khuyến mãi">
                                <MudSelect T="int" @bind-Value="context.DiscountType" Dense="true" Disabled="_isReadonly"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="int" Value="0">Phần trăm (%)</MudSelectItem>
                                    <MudSelectItem T="int" Value="1">Số tiền</MudSelectItem>
                                    <MudSelectItem T="int" Value="2">Giá cố định</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Giá trị" Style="text-align:right">
                                <MudNumericField T="decimal" @bind-Value="context.DiscountValue" Disabled="_isReadonly"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0"/>
                            </MudTd>
                            <MudTd Style="text-align:center">
                                @if (!_isReadonly)
                                {
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   OnClick="@(() => _getRows.Remove(context))"/>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="d-flex flex-column align-center pa-4">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:3rem;color:var(--pos-text-disabled)" Class="mb-2"/>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(_header.CheckTotalDiscount ? "Đang dùng giảm giá tổng bill — không cần danh sách dòng." : "Chưa có dòng sản phẩm khuyến mãi.")
                                </MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudTabPanel>

        @* ── Tab Cửa hàng (Site) ── *@
        <MudTabPanel Text="Cửa hàng áp dụng" Icon="@Icons.Material.Filled.Store">
            <MudCard Elevation="1">
                <MudCardContent>
                    @if (!_isReadonly)
                    {
                        <div class="d-flex align-center gap-2 flex-wrap mb-3">
                            <MudAutocomplete T="OfferSiteLineDto" Label="Thêm nhóm cửa hàng" Dense="true"
                                             SearchFunc="SearchSiteGroupAsync" ToStringFunc="@(s => s == null ? "" : $"{s.SiteGroupCode} – {s.GroupName}")"
                                             ValueChanged="AddSite" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             MaxItems="50" Style="max-width:420px" Clearable="true"/>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings"
                                       OnClick="OpenSiteGroupSetupDialogAsync">Chọn nhóm CH/ST</MudButton>
                        </div>
                    }
                    <MudTable Items="_siteRows" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                              HorizontalScrollbar="true" T="OfferSiteLineDto">
                        <HeaderContent>
                            <MudTh>Site group</MudTh>
                            <MudTh>Site group name</MudTh>
                            <MudTh Style="text-align:center">Xem chi tiết</MudTh>
                            <MudTh Style="text-align:center">Xóa</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Site group">@context.SiteGroupCode</MudTd>
                            <MudTd DataLabel="Site group name">@context.GroupName</MudTd>
                            <MudTd Style="text-align:center">
                                <MudTooltip Text="Xem CH/ST cụ thể">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary"
                                                   OnClick="@(() => ViewSiteGroupStoresAsync(context))"/>
                                </MudTooltip>
                            </MudTd>
                            <MudTd Style="text-align:center">
                                @if (!_isReadonly)
                                {
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   OnClick="@(() => _siteRows.Remove(context))"/>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="d-flex flex-column align-center pa-4">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:3rem;color:var(--pos-text-disabled)" Class="mb-2"/>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có nhóm cửa hàng.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>

                    @if (_viewingSiteGroupCode != null)
                    {
                        <MudPaper Elevation="1" Class="pa-3 mt-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Danh sách CH/ST — @_viewingSiteGroupCode</MudText>
                            <MudTable Items="_viewingSiteStores" Dense="true" Hover="true" Elevation="0"
                                      HorizontalScrollbar="true" T="SiteGroupStoreItemDto">
                                <HeaderContent>
                                    <MudTh>Mã CH/ST</MudTh><MudTh>Tên CH/ST</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Mã CH/ST">@context.StoreNo</MudTd>
                                    <MudTd DataLabel="Tên CH/ST">@context.StoreName</MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2" Class="pa-2">Không có cửa hàng.</MudText>
                                </NoRecordsContent>
                            </MudTable>
                        </MudPaper>
                    }
                </MudCardContent>
            </MudCard>
        </MudTabPanel>

        @* ── Tab Cài đặt nâng cao (Advanced) ── *@
        <MudTabPanel Text="Cài đặt nâng cao" Icon="@Icons.Material.Filled.Settings">
            <MudCard Elevation="1" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary"/>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Giới hạn & ưu tiên</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Số lần áp dụng, thứ tự ưu tiên, ngày áp dụng trong tháng</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal" @bind-Value="_header.LimitQty" Label="Số lần được áp dụng"
                                             Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Min="0" HelperText="0 = không giới hạn số lần"/>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="int" @bind-Value="_header.PriorityBBY" Label="Độ ưu tiên" Disabled="_isReadonly"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Thứ tự ưu tiên khi nhiều CTKM trùng">
                                @for (var i = 1; i <= 10; i++)
                                {
                                    var v = i;
                                    <MudSelectItem T="int" Value="@v">@v</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int" @bind-Value="_header.NumOfDays" Label="Ngày áp dụng trong tháng (0 = không giới hạn)"
                                             Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Min="0" Max="31"/>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="1" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.CardMembership" Color="Color.Primary"/>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Thành viên</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Giới hạn CTKM theo hạng thẻ thành viên</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                            <MudCheckBox @bind-Value="_header.MemberOnly" Label="Chỉ áp dụng cho thành viên"
                                         Disabled="_isReadonly" Color="Color.Primary"/>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudAutocomplete T="string" @bind-Value="_header.MemberCode" Label="Hạng thẻ" Clearable="true"
                                             SearchFunc="SearchMemberCodeAsync" CoerceText="false"
                                             Disabled="@(_isReadonly || !_header.MemberOnly)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HelperText="Gõ tự do hoặc chọn gợi ý"/>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            @if (_header.IsVoucher)
            {
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary"/>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Voucher / Coupon</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cấu hình phát hành voucher (chỉ hiện khi bật Voucher/Coupon)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="3">
                                <MudDatePicker @bind-Date="_voucherFromDate" Label="Voucher từ ngày" Disabled="_isReadonly"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudDatePicker @bind-Date="_voucherToDate" Label="Voucher đến ngày" Disabled="_isReadonly"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="int" @bind-Value="_header.VoucherValidDay" Label="Số ngày hiệu lực"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0" HelperText="Số ngày voucher còn dùng được"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="int" @bind-Value="_header.VoucherLimitNumber" Label="Số lần phát hành"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0" HelperText="0 = không giới hạn"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="6">
                                <MudNumericField T="int" @bind-Value="_header.AllowUseAfterDay" Label="Được dùng sau N ngày (từ lúc ra bill)"
                                                 Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HideSpinButtons="true" Min="0"/>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="6">
                                <MudTextField @bind-Value="_header.AllowUseAfterTime" Label="Được dùng sau giờ (từ lúc ra bill)"
                                              Disabled="_isReadonly" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="hh:mm:ss"/>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }
        </MudTabPanel>
    </MudTabs>

    @if (!_isReadonly && !string.IsNullOrEmpty(_header.No))
    {
        <MudPaper Elevation="1" Class="pa-4 mt-4 d-flex justify-end gap-2 flex-wrap">
            <MudTooltip Text="Lưu tạm dữ liệu hiện tại rồi Duyệt & phát hành CTKM cho máy POS (không sửa lại được)">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           Disabled="_saving" OnClick="ApproveFromEditorAsync">Duyệt CTKM</MudButton>
            </MudTooltip>
        </MudPaper>
    }
}

@code {
    // ── List state ──
    private MudTable<PromotionSetupListItemDto> _table = null!;
    private readonly PromotionSetupListFilter _filter = new() { ApproveStatus = "", PageSize = 20 };
    private List<PromotionSetupListItemDto> _rows = [];
    private int _offset;

    private MudMessageBox? _confirmBox;
    private string _confirmMsg = string.Empty;
    private MudMessageBox? _confirmDiscountBox;
    private string _confirmDiscountMsg = string.Empty;

    // ── Options ──
    private List<OfferTypeOptionDto> _offerTypes = [];
    private List<OptionItemDto> _salesTypes = [];
    private List<OptionItemDto> _memberCodes = [];
    private List<OfferSiteLineDto> _siteGroups = [];

    // ── Editor state ──
    private bool _editing;
    private bool _isReadonly;
    private bool _saving;
    private PromotionSetupHeaderDto _header = new();
    private List<OfferBuyLineDto> _buyRows = [];
    private List<OfferGetLineDto> _getRows = [];
    private List<OfferSiteLineDto> _siteRows = [];
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private DateTime? _voucherFromDate;
    private DateTime? _voucherToDate;
    private int _bulkAddCountBuy = 10;
    private int _bulkAddCountGet = 10;
    private string? _viewingSiteGroupCode;
    private List<SiteGroupStoreItemDto> _viewingSiteStores = [];

    private string _actor = "unknown";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool VoucherCheckboxLocked => _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType)?.IsVoucher ?? false;
    private bool CurrentOfferTypeIsTotalBill => _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType)?.IsTotalBill ?? false;
    private string CurrentOfferTypeUserGuide => _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType)?.UserGuide ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _actor = state.User.Identity?.Name ?? "unknown";

        // Await + try/catch riêng từng lookup độc lập — 1 cái lỗi (vd bảng thiếu ở DEV)
        // không được kéo sập luôn các dropdown còn lại.
        try
        {
            _offerTypes = await PromotionService.GetOfferTypeOptionsAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.LoadOfferTypes", ex);
            Snackbar.Add("Không tải được danh sách Loại CTKM.", Severity.Warning);
        }

        try
        {
            _salesTypes = await PromotionService.GetSalesOrderTypeOptionsAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.LoadSalesTypes", ex);
            Snackbar.Add("Không tải được danh sách Hình thức bán.", Severity.Warning);
        }

        try
        {
            _memberCodes = await PromotionService.GetMemberCodeOptionsAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.LoadMemberCodes", ex);
            Snackbar.Add("Không tải được danh sách Hạng thẻ.", Severity.Warning);
        }

        // Preload nhóm cửa hàng (dbo.SetupGroupSite Status=1 — khớp legacy) để combobox có sẵn
        // dữ liệu và lỗi (bảng thiếu/query sai) hiện rõ thay vì combobox trống im lặng.
        try
        {
            _siteGroups = await PromotionService.GetSiteGroupOptionsAsync();
            if (_siteGroups.Count == 0)
                Snackbar.Add("Chưa có nhóm cửa hàng nào (dbo.SetupGroupSite).", Severity.Info);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.LoadSiteGroups", ex);
            Snackbar.Add("Không tải được danh sách nhóm cửa hàng.", Severity.Warning);
        }
    }

    // ── List ──
    private async Task<TableData<PromotionSetupListItemDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _filter.PageNumber = state.Page;
        _filter.PageSize = state.PageSize;
        _offset = state.Page * state.PageSize;
        try
        {
            var (items, total) = await PromotionService.GetSetupListAsync(_filter, token);
            _rows = items;
            return new TableData<PromotionSetupListItemDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.Load", ex);
            Snackbar.Add("Không thể tải danh sách CTKM.", Severity.Error);
            _rows = [];
            return new TableData<PromotionSetupListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task SearchAsync() => await _table.ReloadServerData();

    private async Task ClearFilterAsync()
    {
        _filter.OfferNo = null;
        _filter.OfferName = null;
        _filter.ApproveStatus = "";
        await _table.ReloadServerData();
    }

    // ── Open editor ──
    private Task OpenNewAsync()
    {
        _header = new PromotionSetupHeaderDto();
        _buyRows = [];
        _getRows = [];
        _siteRows = [];
        _fromDate = null;
        _toDate = null;
        _voucherFromDate = null;
        _voucherToDate = null;
        _bulkAddCountBuy = 10;
        _bulkAddCountGet = 10;
        _viewingSiteGroupCode = null;
        _isReadonly = false;
        _editing = true;
        return Task.CompletedTask;
    }

    private async Task OpenEditAsync(string bbynr)
    {
        try
        {
            var detail = await PromotionService.GetSetupDetailAsync(bbynr);
            if (detail == null) { Snackbar.Add("Không tìm thấy CTKM.", Severity.Warning); return; }
            _header = detail.Header;
            _buyRows = detail.BuyRows;
            _getRows = detail.GetRows;
            _siteRows = detail.SiteRows;
            _fromDate = ParseDmy(_header.StartingDate);
            _toDate = ParseDmy(_header.EndingDate);
            _voucherFromDate = ParseDmy(_header.VoucherFromDate);
            _voucherToDate = ParseDmy(_header.VoucherToDate);
            _bulkAddCountBuy = 10;
            _bulkAddCountGet = 10;
            _viewingSiteGroupCode = null;
            _isReadonly = _header.IsApprove;
            _editing = true;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.OpenEdit", ex);
            Snackbar.Add("Lỗi tải chi tiết CTKM.", Severity.Error);
        }
    }

    private void BackToList() => _editing = false;

    // ── Header interactions ──
    private void OnOfferTypeChanged()
    {
        var ot = _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType);
        if (ot == null) return;
        // Khớp JS legacy: auto-check + khoá Voucher/Coupon khi OfferType bắt buộc voucher
        if (ot.IsVoucher) _header.IsVoucher = true;
    }

    private async Task OnCheckTotalDiscountChanged(bool value)
    {
        if (value && _getRows.Count > 0)
        {
            _confirmDiscountMsg = "Bạn có chắc chắn xóa danh sách sản phẩm khuyến mãi hay không?";
            var confirmed = await _confirmDiscountBox!.ShowAsync();
            _header.CheckTotalDiscount = confirmed == true;
            if (confirmed == true) _getRows.Clear();
        }
        else
        {
            _header.CheckTotalDiscount = value;
        }
    }

    private void BulkAddBuyRows()
    {
        var n = Math.Clamp(_bulkAddCountBuy, 1, 50);
        for (var i = 0; i < n; i++) _buyRows.Add(new OfferBuyLineDto());
    }

    private void BulkAddGetRows()
    {
        var n = Math.Clamp(_bulkAddCountGet, 1, 50);
        for (var i = 0; i < n; i++) _getRows.Add(new OfferGetLineDto());
    }

    private async Task OnBarcodeBlur(IOfferLineItem line)
    {
        if (line.LineType != 0 || string.IsNullOrWhiteSpace(line.No) || !string.IsNullOrEmpty(line.Description)) return;
        try
        {
            var matches = await PromotionService.SearchItemsAsync(line.No);
            var exact = matches.FirstOrDefault(m => string.Equals(m.No, line.No, StringComparison.OrdinalIgnoreCase));
            if (exact != null)
            {
                line.No = exact.No;
                line.Description = exact.Description;
                line.UnitOfMeasure = exact.Uom;
            }
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.BarcodeBlur", ex);
        }
    }

    // ── Save ──
    private async Task<bool> SaveAsync(bool showSuccessSnackbar = true)
    {
        if (_saving) return false;
        _header.StartingDate = _fromDate?.ToString("dd/MM/yyyy") ?? string.Empty;
        _header.EndingDate = _toDate?.ToString("dd/MM/yyyy") ?? string.Empty;
        _header.VoucherFromDate = _header.IsVoucher ? (_voucherFromDate?.ToString("dd/MM/yyyy") ?? string.Empty) : string.Empty;
        _header.VoucherToDate = _header.IsVoucher ? (_voucherToDate?.ToString("dd/MM/yyyy") ?? string.Empty) : string.Empty;

        _saving = true;
        try
        {
            var isNew = string.IsNullOrEmpty(_header.No);
            var request = new PromotionSetupSaveRequest
            {
                Header = _header,
                BuyRows = _buyRows,
                GetRows = _getRows,
                SiteGroupCodes = _siteRows.Select(s => s.SiteGroupCode).Where(c => !string.IsNullOrWhiteSpace(c)).ToList()
            };
            var (ok, message, bbynr) = await PromotionService.SaveSetupAsync(request);
            if (!ok) { Snackbar.Add(message, Severity.Error); return false; }

            _header.No = bbynr;
            await AuditLogger.LogAsync(_actor, isNew ? "CREATE" : "UPDATE", "SetupPromotion", bbynr,
                oldValueJson: null, newValueJson: JsonConvert.SerializeObject(request));
            if (showSuccessSnackbar) Snackbar.Add(message, Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.Save", ex);
            Snackbar.Add("Lưu CTKM thất bại.", Severity.Error);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Approve ──
    // Nút Duyệt nhanh ở màn danh sách — CTKM chưa mở editor, không có state Buy/Get/Site trong
    // bộ nhớ nên KHÔNG được Lưu tạm ở đây (sẽ ghi đè dữ liệu thật thành rỗng). Chỉ publish lại
    // đúng dữ liệu nháp đã có sẵn trong DB.
    private async Task ApproveAsync(string bbynr)
    {
        _confirmMsg = $"Duyệt và phát hành CTKM {bbynr}? Sau khi duyệt sẽ không sửa được.";
        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        await ApproveCoreAsync(bbynr);
    }

    // Nút "Duyệt CTKM" trong editor — BẮT BUỘC Lưu tạm state hiện tại trước khi publish, để
    // tránh Duyệt lại dữ liệu nháp cũ (bug: user sửa Buy/Get/Site sau lần Lưu tạm gần nhất rồi
    // bấm Duyệt thẳng mà không Lưu tạm lại → dữ liệu mới không được publish).
    private async Task ApproveFromEditorAsync()
    {
        var bbynr = _header.No;
        _confirmMsg = $"Duyệt và phát hành CTKM {bbynr}? Hệ thống sẽ Lưu tạm dữ liệu hiện tại trước khi Duyệt. " +
                      "Sau khi Duyệt sẽ không sửa được.";
        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        var saveOk = await SaveAsync(showSuccessSnackbar: false);
        if (!saveOk) return;

        await ApproveCoreAsync(_header.No);
    }

    private async Task ApproveCoreAsync(string bbynr)
    {
        try
        {
            var (ok, message) = await PromotionService.ApproveSetupAsync(bbynr);
            if (!ok) { Snackbar.Add(message, Severity.Error); return; }
            await AuditLogger.LogAsync(_actor, "APPROVE", "SetupPromotion", bbynr, null, null);
            Snackbar.Add(message, Severity.Success);
            if (_editing && _header.No == bbynr) { _isReadonly = true; _header.IsApprove = true; }
            if (!_editing) await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.Approve", ex);
            Snackbar.Add("Duyệt CTKM thất bại.", Severity.Error);
        }
    }

    // ── Site autocomplete + Site Group dialog ──
    private Task<IEnumerable<OfferSiteLineDto>> SearchSiteGroupAsync(string value, CancellationToken ct)
    {
        IEnumerable<OfferSiteLineDto> matches = string.IsNullOrWhiteSpace(value)
            ? _siteGroups
            : _siteGroups.Where(s => s.SiteGroupCode.Contains(value, StringComparison.OrdinalIgnoreCase)
                                  || s.GroupName.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches.Take(50));
    }

    private void AddSite(OfferSiteLineDto? site)
    {
        if (site == null || string.IsNullOrWhiteSpace(site.SiteGroupCode)) return;
        if (_siteRows.Any(s => s.SiteGroupCode == site.SiteGroupCode)) return;
        _siteRows.Add(new OfferSiteLineDto { SiteGroupCode = site.SiteGroupCode, GroupName = site.GroupName });
    }

    private async Task OpenSiteGroupSetupDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SiteGroupSetupDialog>("Cài đặt nhóm cửa hàng", options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is ValueTuple<string?, string?> picked)
        {
            var (code, name) = picked;
            if (!string.IsNullOrEmpty(code) && !_siteRows.Any(s => s.SiteGroupCode == code))
                _siteRows.Add(new OfferSiteLineDto { SiteGroupCode = code, GroupName = name ?? string.Empty });

            try { _siteGroups = await PromotionService.GetSiteGroupOptionsAsync(); }
            catch (Exception ex) { FileLogger.WriteExpLogs("PromotionSetupPage.RefreshSiteGroups", ex); }
        }
    }

    // ── Item Group dialog (dòng Buy/Get chọn Loại "Nhóm SP") ──
    private async Task OpenItemGroupSetupDialogAsync(IOfferLineItem line)
    {
        var parameters = new DialogParameters<ItemGroupSetupDialog> { { x => x.PrefillGroupCode, line.GroupCode } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ItemGroupSetupDialog>("Cài đặt nhóm sản phẩm", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is ValueTuple<string?, string?> picked)
        {
            var (code, _) = picked;
            if (!string.IsNullOrEmpty(code)) line.GroupCode = code;
        }
    }

    private async Task ViewSiteGroupStoresAsync(OfferSiteLineDto site)
    {
        _viewingSiteGroupCode = site.SiteGroupCode;
        try
        {
            _viewingSiteStores = await PromotionService.GetSiteGroupStoresAsync(site.SiteGroupCode, string.Empty, string.Empty);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.ViewSiteStores", ex);
            Snackbar.Add("Không tải được danh sách CH/ST.", Severity.Error);
            _viewingSiteStores = [];
        }
    }

    // ── Member code autocomplete (gõ tự do + gợi ý) ──
    private Task<IEnumerable<string>> SearchMemberCodeAsync(string value, CancellationToken ct)
    {
        IEnumerable<string> matches = _memberCodes.Select(m => m.Value);
        if (!string.IsNullOrWhiteSpace(value))
            matches = matches.Where(v => v.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches.Take(50));
    }

    // ── Item autocomplete (Buy/Get rows) ──
    private async Task<IEnumerable<ItemOptionDto>> SearchItemsAsync(string value, CancellationToken ct)
        => await PromotionService.SearchItemsAsync(value ?? string.Empty, ct);

    private void OnItemSelected(IOfferLineItem line, ItemOptionDto? item)
    {
        if (item == null) return;
        line.No = item.No;
        line.Description = item.Description;
        line.UnitOfMeasure = item.Uom;
        line.GroupCode = string.Empty;
    }

    // Bỏ chọn sản phẩm để chọn lại — hiện lại ô autocomplete
    private void ClearLineItem(IOfferLineItem line)
    {
        line.No = string.Empty;
        line.Description = string.Empty;
        line.UnitOfMeasure = string.Empty;
    }

    // Cell chọn Sản phẩm (autocomplete) — dùng chung Buy & Get, chỉ cho LineType=0.
    // Đã chọn SP → hiện gọn "Mã – Tên" + nút đổi; chưa chọn → hiện ô tìm.
    private RenderFragment LineItemCell(IOfferLineItem line) => __builder =>
    {
        <text>
        @if (!string.IsNullOrEmpty(line.No) && !string.IsNullOrEmpty(line.Description))
        {
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.body2">
                    <b>@line.No</b>@(string.IsNullOrEmpty(line.Description) ? "" : $" – {line.Description}")
                </MudText>
                @if (!_isReadonly)
                {
                    <MudTooltip Text="Đổi sản phẩm">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => ClearLineItem(line))"/>
                    </MudTooltip>
                }
            </div>
        }
        else if (!_isReadonly)
        {
            <MudAutocomplete T="ItemOptionDto" SearchFunc="SearchItemsAsync" Dense="true"
                             ToStringFunc="@(i => i == null ? string.Empty : $"{i.No} – {i.Description}")"
                             ValueChanged="@(i => OnItemSelected(line, i))"
                             Variant="Variant.Outlined" Margin="Margin.Dense" MaxItems="50"
                             Clearable="true" Placeholder="Tìm sản phẩm..."/>
        }
        else
        {
            <MudText Typo="Typo.caption">(chưa chọn)</MudText>
        }
        </text>
    };

    // ── Helpers ──
    private static string FmtYmd(string ymd)
        => DateTime.TryParseExact(ymd, "yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var d) ? d.ToString("dd/MM/yyyy") : (ymd ?? "");

    private static DateTime? ParseDmy(string dmy)
        => DateTime.TryParseExact(dmy, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    private static string StatusText(string s) => s switch
    {
        "0" => "Đang áp dụng",
        "1" => "Lên kế hoạch",
        "2" => "Ngưng áp dụng",
        _ => s
    };
}
