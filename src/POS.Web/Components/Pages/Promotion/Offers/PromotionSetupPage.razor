        else
        {
            _header.CheckTotalDiscount = value;
        }
    }

    private void BulkAddBuyRows()
    {
        var n = Math.Clamp(_bulkAddCountBuy, 1, 50);
        for (var i = 0; i < n; i++) _buyRows.Add(new OfferBuyLineDto());
    }

    private void BulkAddGetRows()
    {
        var n = Math.Clamp(_bulkAddCountGet, 1, 50);
        for (var i = 0; i < n; i++) _getRows.Add(new OfferGetLineDto());
    }

    private async Task OnBarcodeBlur(IOfferLineItem line)
    {
        if (line.LineType != 0 || string.IsNullOrWhiteSpace(line.No) || !string.IsNullOrEmpty(line.Description)) return;
        try
        {
            var matches = await PromotionService.SearchItemsAsync(line.No);
            var exact = matches.FirstOrDefault(m => string.Equals(m.No, line.No, StringComparison.OrdinalIgnoreCase));
            if (exact != null)
            {
                line.No = exact.No;
                line.Description = exact.Description;
                line.UnitOfMeasure = exact.Uom;
            }
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.BarcodeBlur", ex);
        }
    }

    // ── Save ──
    // 1 dòng Buy/Get coi là "đã nhập" khi: LineType=0 có mã SP, hoặc LineType=1 có mã nhóm.
    // Giữ đồng nhất với PromotionRepository.HasLineItem (nguồn sự thật phía server).
    private static bool HasLineItem(IOfferLineItem line)
        => line.LineType == 0
            ? !string.IsNullOrWhiteSpace(line.No)
            : !string.IsNullOrWhiteSpace(line.GroupCode);

    private async Task<bool> SaveAsync(bool showSuccessSnackbar = true)
    {
        if (_saving) return false;
        _header.StartingDate = _fromDate?.ToString("dd/MM/yyyy") ?? string.Empty;
        _header.EndingDate = _toDate?.ToString("dd/MM/yyyy") ?? string.Empty;
        _header.VoucherFromDate = _header.IsVoucher ? (_voucherFromDate?.ToString("dd/MM/yyyy") ?? string.Empty) : string.Empty;
        _header.VoucherToDate = _header.IsVoucher ? (_voucherToDate?.ToString("dd/MM/yyyy") ?? string.Empty) : string.Empty;
        // Khối Voucher chỉ hiện khi IsVoucher → phải dọn luôn 2 field delay như 2 field ngày ở trên.
        // Nếu không: tick Voucher → nhập giờ sai → bỏ tick → Lưu, validate bị bỏ qua (gate theo
        // IsVoucher) nhưng tham số vẫn ghi thẳng chuỗi rác vào ZVCDAY_AFTER/ZVCTIME_AFTER.
        if (!_header.IsVoucher)
        {
            _header.AllowUseAfterDay = 0;
            _header.AllowUseAfterTime = string.Empty;
        }
        else
        {
            // Chuẩn hoá "020000"/"2:0:0" → "02:00:00" (cùng tinh thần FormatTimeDigits của Từ giờ/
            // Đến giờ) trước khi validate, để user không bị chặn chỉ vì thiếu dấu ':'.
            _header.AllowUseAfterTime = FormatTimeDigitsWithSeconds(_header.AllowUseAfterTime);
        }

        // ── Lọc dòng trống + chặn sớm (lớp chặn UI; nguồn sự thật vẫn là PromotionRepository) ──
        // Dòng trắng do bulk-add (thêm 10 dòng, nhập 3) nếu lọt xuống DB sẽ ghi MAT_QUAN='0';
        // nhánh MGP của Setup_Promotion_Insert không lọc MATGROUP<>'' → publish OfferBuy có
        // Step=0 → vỡ phép chia trong offer_procedure. Lọc ở đây để không lưu dữ liệu rác.
        var buyRowsToSave = BuyTabVisible ? _buyRows.Where(HasLineItem).ToList() : [];
        var getRowsToSave = GetTabVisible ? _getRows.Where(HasLineItem).ToList() : [];
        var skippedRows = (BuyTabVisible ? _buyRows.Count - buyRowsToSave.Count : 0)
                          + (GetTabVisible ? _getRows.Count - getRowsToSave.Count : 0);
        if (skippedRows > 0)
            Snackbar.Add($"Đã bỏ qua {skippedRows} dòng chưa chọn sản phẩm/nhóm sản phẩm.", Severity.Info);

        // Step = Quantity ở bước publish → mọi dòng đã nhập phải có Quantity ≥ 1.
        if (buyRowsToSave.Any(r => r.Quantity < 1) || getRowsToSave.Any(r => r.Quantity < 1))
        {
            Snackbar.Add("Số lượng của mỗi dòng sản phẩm phải ≥ 1", Severity.Warning);
            return false;
        }

        // CTKM tổng bill: MINVALUE là ngưỡng bill, publish ghi vào OfferBenefits.StepAmount.
        if (CurrentOfferTypeIsTotalBill && _header.MinValue <= 0)
        {
            Snackbar.Add("CTKM tổng bill cần nhập Giá trị tổng bill tối thiểu (> 0)", Severity.Warning);
            return false;
        }

        // Voucher delay: ZVCTIME_AFTER là chuỗi giờ, phải đúng hh:mm:ss (trước đây không validate).
        if (_header.IsVoucher && !string.IsNullOrWhiteSpace(_header.AllowUseAfterTime)
            && !TimeSpan.TryParseExact(_header.AllowUseAfterTime.Trim(), "hh\\:mm\\:ss",
                                       System.Globalization.CultureInfo.InvariantCulture, out _))
        {
            Snackbar.Add("Giờ được dùng sau không đúng định dạng (hh:mm:ss)", Severity.Warning);
            return false;
        }

        _saving = true;
        try
        {
            var isNew = string.IsNullOrEmpty(_header.No);
            var request = new PromotionSetupSaveRequest
            {
                Header = _header,
                // Section ẩn theo loại CTKM → gửi list rỗng (không lưu dữ liệu thừa của loại khác).
                BuyRows = buyRowsToSave,
                GetRows = getRowsToSave,
                SiteGroupCodes = _siteRows.Select(s => s.SiteGroupCode).Where(c => !string.IsNullOrWhiteSpace(c)).ToList()
            };
            var (ok, message, bbynr) = await PromotionService.SaveSetupAsync(request);
            if (!ok) { Snackbar.Add(message, Severity.Error); return false; }

            _header.No = bbynr;
            await AuditLogger.LogAsync(_actor, isNew ? "CREATE" : "UPDATE", "SetupPromotion", bbynr,
                oldValueJson: null, newValueJson: JsonConvert.SerializeObject(request));
            if (showSuccessSnackbar) Snackbar.Add(message, Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.Save", ex);
            Snackbar.Add("Lưu CTKM thất bại.", Severity.Error);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Approve ──
    // Nút Duyệt nhanh ở màn danh sách — CTKM chưa mở editor, không có state Buy/Get/Site trong
    // bộ nhớ nên KHÔNG được Lưu tạm ở đây (sẽ ghi đè dữ liệu thật thành rỗng). Chỉ publish lại
    // đúng dữ liệu nháp đã có sẵn trong DB.
    private async Task ApproveAsync(string bbynr)
    {
        _confirmMsg = $"Duyệt và phát hành CTKM {bbynr}? Sau khi duyệt sẽ không sửa được.";
        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        await ApproveCoreAsync(bbynr);
    }

    // Nút "Duyệt CTKM" trong editor — BẮT BUỘC Lưu tạm state hiện tại trước khi publish, để
    // tránh Duyệt lại dữ liệu nháp cũ (bug: user sửa Buy/Get/Site sau lần Lưu tạm gần nhất rồi
    // bấm Duyệt thẳng mà không Lưu tạm lại → dữ liệu mới không được publish).
    private async Task ApproveFromEditorAsync()
    {
        var bbynr = _header.No;
        _confirmMsg = $"Duyệt và phát hành CTKM {bbynr}? Hệ thống sẽ Lưu tạm dữ liệu hiện tại trước khi Duyệt. " +
                      "Sau khi Duyệt sẽ không sửa được.";
        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        var saveOk = await SaveAsync(showSuccessSnackbar: false);
        if (!saveOk) return;

        await ApproveCoreAsync(_header.No);
    }

    private async Task ApproveCoreAsync(string bbynr)
    {
        try
        {
            var (ok, message) = await PromotionService.ApproveSetupAsync(bbynr);
            if (!ok) { Snackbar.Add(message, Severity.Error); return; }
            await AuditLogger.LogAsync(_actor, "APPROVE", "SetupPromotion", bbynr, null, null);
            Snackbar.Add(message, Severity.Success);
            if (_editing && _header.No == bbynr) { _isReadonly = true; _header.IsApprove = true; }
            if (!_editing) await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.Approve", ex);
            Snackbar.Add("Duyệt CTKM thất bại.", Severity.Error);
        }
    }

    // ── Site autocomplete + Site Group dialog ──
    private Task<IEnumerable<OfferSiteLineDto>> SearchSiteGroupAsync(string value, CancellationToken ct)
    {
        IEnumerable<OfferSiteLineDto> matches = string.IsNullOrWhiteSpace(value)
            ? _siteGroups
            : _siteGroups.Where(s => s.SiteGroupCode.Contains(value, StringComparison.OrdinalIgnoreCase)
                                  || s.GroupName.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches.Take(50));
    }

    private void AddSite(OfferSiteLineDto? site)
    {
        if (site == null || string.IsNullOrWhiteSpace(site.SiteGroupCode)) return;
        if (_siteRows.Any(s => s.SiteGroupCode == site.SiteGroupCode)) return;
        _siteRows.Add(new OfferSiteLineDto { SiteGroupCode = site.SiteGroupCode, GroupName = site.GroupName });
    }

    private async Task OpenSiteGroupSetupDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SiteGroupSetupDialog>("Cài đặt nhóm cửa hàng", options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is ValueTuple<string?, string?> picked)
        {
            var (code, name) = picked;
            if (!string.IsNullOrEmpty(code) && !_siteRows.Any(s => s.SiteGroupCode == code))
                _siteRows.Add(new OfferSiteLineDto { SiteGroupCode = code, GroupName = name ?? string.Empty });

            try { _siteGroups = await PromotionService.GetSiteGroupOptionsAsync(); }
            catch (Exception ex) { FileLogger.WriteExpLogs("PromotionSetupPage.RefreshSiteGroups", ex); }
        }
    }

    // ── Item Group dialog (dòng Buy/Get chọn Loại "Nhóm SP") ──
    private async Task OpenItemGroupSetupDialogAsync(IOfferLineItem line)
    {
        var parameters = new DialogParameters<ItemGroupSetupDialog> { { x => x.PrefillGroupCode, line.GroupCode } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ItemGroupSetupDialog>("Cài đặt nhóm sản phẩm", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is ValueTuple<string?, string?> picked)
        {
            var (code, _) = picked;
            if (!string.IsNullOrEmpty(code)) line.GroupCode = code;
        }
    }

    private async Task ViewSiteGroupStoresAsync(OfferSiteLineDto site)
    {
        _viewingSiteGroupCode = site.SiteGroupCode;
        try
        {
            _viewingSiteStores = await PromotionService.GetSiteGroupStoresAsync(site.SiteGroupCode, string.Empty, string.Empty);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("PromotionSetupPage.ViewSiteStores", ex);
            Snackbar.Add("Không tải được danh sách CH/ST.", Severity.Error);
            _viewingSiteStores = [];
        }
    }

    // ── Member code autocomplete (gõ tự do + gợi ý) ──
    private Task<IEnumerable<string>> SearchMemberCodeAsync(string value, CancellationToken ct)
    {
        IEnumerable<string> matches = _memberCodes.Select(m => m.Value);
        if (!string.IsNullOrWhiteSpace(value))
            matches = matches.Where(v => v.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches.Take(50));
    }

    // ── Item autocomplete (Buy/Get rows) ──
    private async Task<IEnumerable<ItemOptionDto>> SearchItemsAsync(string value, CancellationToken ct)
        => await PromotionService.SearchItemsAsync(value ?? string.Empty, ct);

    private void OnItemSelected(IOfferLineItem line, ItemOptionDto? item)
    {
        if (item == null) return;
        line.No = item.No;
        line.Description = item.Description;
        line.UnitOfMeasure = item.Uom;
        line.GroupCode = string.Empty;
    }

    // Bỏ chọn sản phẩm để chọn lại — hiện lại ô autocomplete
    private void ClearLineItem(IOfferLineItem line)
    {
        line.No = string.Empty;
        line.Description = string.Empty;
        line.UnitOfMeasure = string.Empty;
    }

    // Cell chọn Sản phẩm (autocomplete) — dùng chung Buy & Get, chỉ cho LineType=0.
    // Đã chọn SP → hiện gọn "Mã – Tên" + nút đổi; chưa chọn → hiện ô tìm.
    private RenderFragment LineItemCell(IOfferLineItem line) => __builder =>
    {
        <text>
        @if (!string.IsNullOrEmpty(line.No) && !string.IsNullOrEmpty(line.Description))
        {
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.body2">
                    <b>@line.No</b>@(string.IsNullOrEmpty(line.Description) ? "" : $" – {line.Description}")
                </MudText>
                @if (!_isReadonly)
                {
                    <MudTooltip Text="Đổi sản phẩm">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => ClearLineItem(line))"/>
                    </MudTooltip>
                }
            </div>
        }
        else if (!_isReadonly)
        {
            <MudAutocomplete T="ItemOptionDto" SearchFunc="SearchItemsAsync" Dense="true"
                             ToStringFunc="@(i => i == null ? string.Empty : $"{i.No} – {i.Description}")"
                             ValueChanged="@(i => OnItemSelected(line, i))"
                             Variant="Variant.Outlined" Margin="Margin.Dense" MaxItems="50"
                             Clearable="true" Placeholder="Tìm sản phẩm..."/>
        }
        else
        {
            <MudText Typo="Typo.caption">(chưa chọn)</MudText>
        }
        </text>
    };

    // ── Helpers ──
    private static string FmtYmd(string ymd)
        => DateTime.TryParseExact(ymd, "yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var d) ? d.ToString("dd/MM/yyyy") : (ymd ?? "");

    private static DateTime? ParseDmy(string dmy)
        => DateTime.TryParseExact(dmy, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    private static string StatusText(string s) => s switch
    {
        "0" => "Đang áp dụng",
        "1" => "Lên kế hoạch",
        "2" => "Ngưng áp dụng",
        _ => s
    };

    // CssClass là 1 trong 4 modifier .pos-status-{success,error,warning,info} (app.css) —
    // badge dạng dot-pill theo mockup docs/web/images/status.jpg (KHÔNG dùng MudChip, xem app.css).
    private static (string CssClass, string Label) StatusDisplay(string s)
    {
        var css = s switch
        {
            "0" => "pos-status-success",
            "1" => "pos-status-info",
            _   => "pos-status-warning"
        };
        return (css, StatusText(s));
    }
}
