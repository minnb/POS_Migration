    private void BackToList() => _editing = false;

    // ── Header interactions ──
    private void OnOfferTypeChanged()
    {
        var ot = _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType);
        if (ot == null) return;
        // Khớp JS legacy: auto-check + khoá Voucher/Coupon khi OfferType bắt buộc voucher.
        if (ot.IsVoucher)
        {
            _header.IsVoucher = true;
            _voucherForcedByOfferType = true;
        }
        else if (_voucherForcedByOfferType)
        {
            // Đổi sang OfferType không bắt buộc voucher — chỉ reset nếu giá trị true hiện tại
            // là do hệ thống tự set (forced), KHÔNG đụng vào lựa chọn thủ công của user.
            _header.IsVoucher = false;
            _voucherForcedByOfferType = false;
        }
        // Loại tổng bill: dòng Get là SP hưởng KM (→OfferBenefits) — tắt "Giảm giá tổng bill"
        // (cơ chế whole-bill riêng, sẽ xóa Get) để tránh mất dòng benefits.
        if (ot.IsTotalBill)
            _header.CheckTotalDiscount = false;
