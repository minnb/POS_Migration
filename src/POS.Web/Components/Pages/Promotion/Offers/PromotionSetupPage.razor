    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private OfferTypeOptionDto? CurrentOfferType => _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType);
    private bool VoucherCheckboxLocked => CurrentOfferType?.IsVoucher ?? false;
    private bool CurrentOfferTypeIsTotalBill => CurrentOfferType?.IsTotalBill ?? false;
    private bool CurrentOfferTypeIsSetupBuy => CurrentOfferType?.IsSetupBuy ?? false;
    private bool CurrentOfferTypeIsSetupGet => CurrentOfferType?.IsSetupGet ?? false;
    private bool CurrentOfferTypeIsGift => CurrentOfferType?.IsGift ?? false;
    // Tab Buy ẩn khi loại thuộc BuyHidden (ZB06/ZB13 — publish loại khỏi OfferBuy) hoặc cờ IsSetupBuy=0.
    private bool BuyTabVisible => CurrentOfferTypeIsSetupBuy && !PromotionOfferTypeRules.IsBuyHidden(_header.OfferType);
    private bool GetTabVisible => CurrentOfferTypeIsSetupGet;

    // Chỉ chặn bấm Lưu khi rõ ràng thiếu field bắt buộc — validate đầy đủ (kể cả so sánh
    // ngày) vẫn nằm ở PromotionRepository.SaveSetupAsync (nguồn sự thật), đây chỉ là UX
    // tránh round-trip lên server khi form còn trống hiển nhiên.
    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_header.Description)
        && !string.IsNullOrWhiteSpace(_header.SalesType)
        && (!string.IsNullOrWhiteSpace(_header.OfferType) || !string.IsNullOrEmpty(_header.No))
        && _fromDate.HasValue
        && _toDate.HasValue
        // BẮT BUỘC chọn ≥1 nhóm cửa hàng áp dụng (tab "Cửa hàng áp dụng") — CTKM không có site
        // sẽ publish ra 0 dòng Offer* lúc Duyệt. Backend SaveSetupAsync còn validate lần nữa
        // (phòng nhóm expand ra 0 store).
        && _siteRows.Count > 0;
    private string CurrentOfferTypeUserGuide => _offerTypes.FirstOrDefault(o => o.Value == _header.OfferType)?.UserGuide ?? string.Empty;

    // Ô "Từ giờ"/"Đến giờ" (tab Thông tin chung) là MudTextField thuần — không mở picker chọn giờ.
    // User gõ tự do (vd "0900"/"900"), Enter mới format thành "HH:mm" (vẫn string, khớp DB
    // TIMEFROM/TIMETO) — không format khi user chưa Enter (đang gõ dở).
    private void OnHeaderTimeKeyUp(KeyboardEventArgs e, bool isFrom)
    {
        if (e.Key != "Enter") return;
        if (isFrom) _header.FromTime = FormatTimeDigits(_header.FromTime);
        else _header.ToTime = FormatTimeDigits(_header.ToTime);
    }

    private static string FormatTimeDigits(string? raw)
    {
        var digits = new string((raw ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return string.Empty;

        string hh, mm;
        if (digits.Length <= 2)
        {
            hh = digits;
            mm = "00";
        }
        else
        {
            digits = digits.Length > 4 ? digits[^4..] : digits.PadLeft(4, '0');
            hh = digits[..2];
            mm = digits[2..];
        }

        if (!int.TryParse(hh, out var h) || !int.TryParse(mm, out var m) || h > 23 || m > 59)
            return raw ?? string.Empty; // giữ nguyên input nếu không hợp lệ, để user tự sửa

        return $"{h:D2}:{m:D2}";
    }

    // Ô "Được dùng sau giờ" (tab Nâng cao, khối Voucher) — cùng tinh thần FormatTimeDigits nhưng
    // giữ giây vì cột ZVCTIME_AFTER lưu dạng hh:mm:ss. Enter để chuẩn hoá; input không hợp lệ giữ
    // nguyên để validate ở SaveAsync/Repository báo lỗi rõ thay vì âm thầm đổi giá trị user gõ.
    private void OnAllowUseAfterTimeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        _header.AllowUseAfterTime = FormatTimeDigitsWithSeconds(_header.AllowUseAfterTime);
    }

    private static string FormatTimeDigitsWithSeconds(string? raw)
    {
        // Rỗng = không đặt độ trễ. Có nội dung nhưng không có chữ số nào (vd "abc") thì GIỮ NGUYÊN
        // để validate báo lỗi — không âm thầm xoá thành rỗng (sẽ thành "không giới hạn giờ" sai ý).
        var digits = new string((raw ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length == 0)
            return string.IsNullOrWhiteSpace(raw) ? string.Empty : raw.Trim();

        digits = digits.Length > 6 ? digits[^6..] : digits.PadLeft(6, '0');
        if (!int.TryParse(digits[..2], out var h) || !int.TryParse(digits[2..4], out var m)
            || !int.TryParse(digits[4..], out var s) || h > 23 || m > 59 || s > 59)
            return (raw ?? string.Empty).Trim(); // giữ nguyên input sai để user tự sửa

        return $"{h:D2}:{m:D2}:{s:D2}";
    }

    protected override async Task OnInitializedAsync()
    {
