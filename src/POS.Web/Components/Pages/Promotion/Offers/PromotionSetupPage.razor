                            s.Text.Contains("Tại chỗ", StringComparison.OrdinalIgnoreCase))?.Value
                        ?? _salesTypes.FirstOrDefault()?.Value ?? string.Empty
        };
        _buyRows = [];
        _getRows = [];
        _siteRows = [];
        _fromDate = null;
        _toDate = null;
        _voucherFromDate = null;
        _voucherToDate = null;
        _voucherForcedByOfferType = false;
