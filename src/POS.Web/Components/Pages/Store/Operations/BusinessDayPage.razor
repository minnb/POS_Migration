@page "/store/business-day"
@namespace POS.Web.Components.Pages.Store
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Newtonsoft.Json
@using POS.Application.Features.StoreActivities
@using POS.Common.Dtos.CentralMD
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Infrastructure.Logging

@inject ICentralMDRepository MdRepo
@inject IBusinessDayService BusinessDayService
@inject IAuditLogger AuditLogger
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Xác nhận kết thúc ngày – POS Dashboard</PageTitle>

<MudMessageBox @ref="_confirmBox" Title="Xác nhận kết thúc ngày" CancelText="Hủy">
    <MessageContent>@_confirmMsg</MessageContent>
    <YesButton>
        <MudButton Class="pos-btn-mockup pos-btn-primary">Xác nhận</MudButton>
    </YesButton>
</MudMessageBox>

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:400">
    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
    Xác nhận kết thúc ngày
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
}

@* ── Filter Panel ─────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string"
                       @bind-Value="_selectedStoreNo"
                       Label="ST/CH"
                       Required="true"
                       RequiredError="Vui lòng chọn cửa hàng"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       AdornmentIcon="@Icons.Material.Filled.Store"
                       Adornment="Adornment.Start">
                @foreach (var s in _allowedStores)
                {
                    <MudSelectItem T="string" Value="@s.StoreNo">@($"{s.StoreNo} – {s.Name}")</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_businessDate"
                           Label="Ngày kinh doanh"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Outlined.DateRange"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudButton Class="pos-btn-mockup pos-btn-primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="@SearchAsync"
                       Disabled="@(_loading)"
                       FullWidth="true">Tìm kiếm</MudButton>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alert ────────────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}
else if (_hasSearched && _confirmInfo != null)
{
    <MudAlert Severity="Severity.Success" Class="mb-3">
        Đã xác nhận kết thúc ngày lúc @_confirmInfo.ConfirmedDate.ToString("dd/MM/yyyy HH:mm") bởi @_confirmInfo.ConfirmedBy.
    </MudAlert>
}
else if (_hasSearched && _staging.Count > 0 && _canForceConfirm && _staging.Any(s => !s.IsClosed))
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        @($"Còn {_staging.Count(s => !s.IsClosed)} máy POS chưa đóng ngày — với quyền IT Ops bạn vẫn có thể xác nhận kết thúc ngày (force).")
    </MudAlert>
}
else if (_hasSearched && _staging.Count > 0 && !_canForceConfirm && !CanConfirm)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        @if (BlockingCount > 0)
        {
            @($"Còn {BlockingCount} máy POS chưa đóng ngày — chưa thể xác nhận kết thúc ngày.")
        }
        else
        {
            @("Cửa hàng chưa có máy POS nào đóng ngày kinh doanh — chưa thể xác nhận kết thúc ngày.")
        }
    </MudAlert>
}

@* ── Table ─────────────────────────────────────────────────────────────────── *@
@if (!_hasSearched)
{
    <MudText Class="pa-4" Style="color:#9e9e9e">
        Chọn cửa hàng, ngày kinh doanh rồi bấm "Tìm kiếm" để xem dữ liệu.
    </MudText>
}
else
{
    <MudTable Class="pos-table" Items="@_staging"
              Hover="true" Striped="true" Dense="true"
              Breakpoint="Breakpoint.Sm" Elevation="2"
              Loading="@_loading" LoadingProgressColor="Color.Primary"
              HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh>Máy POS</MudTh>
            <MudTh>Loại POS</MudTh>
            <MudTh Style="text-align:center">Trạng thái</MudTh>
            <MudTh Style="text-align:center">Lần bán hàng cuối cùng</MudTh>
            <MudTh Style="text-align:center">Thời gian kết thúc ngày</MudTh>
            <MudTh Style="text-align:right">Tiền bán ra</MudTh>
            <MudTh Style="text-align:right">Tiền mặt</MudTh>
            <MudTh Style="text-align:center">Số lượt khách hàng</MudTh>
            <MudTh Style="text-align:center">Số lượng bán</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Máy POS" Style="font-weight:600">@context.PosTerminal</MudTd>
            <MudTd DataLabel="Loại POS">@(string.IsNullOrWhiteSpace(context.Placement) ? "-" : context.Placement)</MudTd>
            <MudTd DataLabel="Trạng thái" Style="text-align:center">
                @if (context.IsClosed)
                {
                    <span class="pos-status-chip pos-status-success">Đã đóng ngày</span>
                }
                else if (context.LastSaleTime == null)
                {
                    <span class="pos-status-chip pos-status-info">Chưa mở ca</span>
                }
                else
                {
                    <span class="pos-status-chip pos-status-warning">Chưa đóng ngày</span>
                }
            </MudTd>
            <MudTd DataLabel="Lần bán hàng cuối cùng" Style="text-align:center">
                @(context.LastSaleTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
            </MudTd>
            <MudTd DataLabel="Thời gian kết thúc ngày" Style="text-align:center">
                @(context.CloseTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
            </MudTd>
            <MudTd DataLabel="Tiền bán ra" Style="text-align:right">@FormatVND(context.TotalRevenue)</MudTd>
            <MudTd DataLabel="Tiền mặt" Style="text-align:right">@FormatVND(context.TienMat)</MudTd>
            <MudTd DataLabel="Số lượt khách hàng" Style="text-align:center">@context.CustomerCount</MudTd>
            <MudTd DataLabel="Số lượng bán" Style="text-align:center">@context.TotalQuantity</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd Style="font-weight:700">Total</MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd Style="text-align:right; font-weight:700">@FormatVND(_staging.Sum(s => s.TotalRevenue))</MudTd>
            <MudTd Style="text-align:right; font-weight:700">@FormatVND(_staging.Sum(s => s.TienMat))</MudTd>
            <MudTd Style="text-align:center; font-weight:700">@_staging.Sum(s => s.CustomerCount)</MudTd>
            <MudTd Style="text-align:center; font-weight:700">@_staging.Sum(s => s.TotalQuantity)</MudTd>
        </FooterContent>
        <NoRecordsContent>
            <MudText Class="pa-4" Style="color:#9e9e9e">Cửa hàng chưa có máy POS nào đang hoạt động.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@* ── Action bar ───────────────────────────────────────────────────────────── *@
<MudPaper Class="pos-filter-panel pa-4 mt-4 d-flex justify-end gap-2 flex-wrap">
    <MudButton Class="pos-btn-mockup pos-btn-primary"
               StartIcon="@Icons.Material.Filled.HourglassBottom"
               OnClick="@ConfirmAsync"
               Disabled="@(!CanConfirm || _loading || _confirming)">
        Xác nhận
    </MudButton>
</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool    _loading;
    private bool    _confirming;
    private bool    _hasSearched;
    private string? _errorMsg;
    private bool    _isStoreOperator;
    private string  _currentActor = "unknown";

    private DateTime? _businessDate = DateTime.Today;

    private List<StoreDto>          _allStores      = [];
    private List<StoreDto>          _allowedStores  = [];
    private string?                 _selectedStoreNo;
    private IReadOnlyList<string>   _userStoreCodes = [];

    private List<PosDayStagingDto>     _staging     = [];
    private BusinessDayConfirmDto?     _confirmInfo;

    private MudMessageBox? _confirmBox;
    private string _confirmMsg = string.Empty;

    // ITOps/SystemAdmin được force EOD; StoreOperator chỉ khi tất cả POS đã đóng ngày.
    private bool _canForceConfirm;

    // "Chưa đóng ngày" (đã có giao dịch nhưng chưa đóng ngày) luôn chặn xác nhận.
    // "Chưa mở ca" (chưa từng có giao dịch) KHÔNG chặn — coi như không tham gia ngày kinh doanh.
    private static bool BlocksConfirm(PosDayStagingDto s) => !s.IsClosed && s.LastSaleTime != null;
    private int BlockingCount => _staging.Count(BlocksConfirm);

    private bool CanConfirm => _hasSearched && _confirmInfo == null && _staging.Count > 0
                               && (_canForceConfirm
                                   || (_staging.Any(s => s.IsClosed) && !_staging.Any(BlocksConfirm)));

    private static string FormatVND(decimal v) => $"{v:N0} ₫";

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;
        _canForceConfirm = state.User.IsInRole(WebRoles.ITOps) || state.User.IsInRole(WebRoles.SystemAdmin);

        try
        {
            _allStores = (await MdRepo.GetStoreListAsync()).OrderBy(s => s.StoreNo).ToList();
            _allowedStores = _isStoreOperator
                ? _allStores.Where(s => _userStoreCodes.Contains(s.StoreNo ?? "")).ToList()
                : _allStores;
            _selectedStoreNo = _allowedStores.FirstOrDefault()?.StoreNo;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("BusinessDayPage.LoadStores", ex);
            _errorMsg = "Không thể tải danh sách cửa hàng.";
        }

        // Không tự load dữ liệu khi mở trang — chờ user bấm "Tìm kiếm".
        // Ngoại lệ StoreOperator: mặc định lấy ngày kinh doanh hiện tại của cửa hàng họ + tự load luôn (bớt thao tác).
        if (_isStoreOperator && _selectedStoreNo is { Length: > 0 } storeNo)
        {
            var current = await BusinessDayService.GetCurrentBusinessDateAsync(storeNo);
            if (current.HasValue) _businessDate = current.Value.Date;
            await SearchAsync();
        }
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task SearchAsync()
    {
        if (_selectedStoreNo is not { Length: > 0 } storeNo)
        {
            Snackbar.Add("Vui lòng chọn cửa hàng.", Severity.Warning);
            return;
        }

        var businessDate = (_businessDate ?? DateTime.Today).Date;

        _loading  = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            _staging     = await BusinessDayService.GetPosDayStagingAsync(storeNo, businessDate);
            _confirmInfo = await BusinessDayService.GetConfirmStatusAsync(storeNo, businessDate);
            _hasSearched = true;

            FileLogger.WriteLogs($"[BusinessDayPage.Search] {storeNo}: Loaded {_staging.Count} POS terminal(s) [{businessDate:dd/MM/yyyy}]");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            FileLogger.WriteExpLogs("BusinessDayPage.Search", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Confirm ──────────────────────────────────────────────────────────────

    private async Task ConfirmAsync()
    {
        if (_selectedStoreNo is not { Length: > 0 } storeNo) return;

        var businessDate = (_businessDate ?? DateTime.Today).Date;

        var notClosedCount = _staging.Count(s => !s.IsClosed);
        _confirmMsg = $"Xác nhận kết thúc ngày kinh doanh {businessDate:dd/MM/yyyy} cho cửa hàng {storeNo}? " +
                      (_canForceConfirm && notClosedCount > 0
                          ? $"Còn {notClosedCount} máy POS chưa đóng ngày — xác nhận force sẽ chuyển ngày cho toàn bộ máy POS. "
                          : string.Empty) +
                      $"Ngày kinh doanh của cửa hàng sẽ chuyển sang {businessDate.AddDays(1):dd/MM/yyyy} cho máy POS. " +
                      "Thao tác này không thể tự hoàn tác.";
        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        _confirming = true;
        StateHasChanged();
        try
        {
            var oldSnapshot = JsonConvert.SerializeObject(new { StoreNo = storeNo, BusinessDate = businessDate, _staging });
            var result = await BusinessDayService.ConfirmBusinessDayAsync(storeNo, businessDate, _currentActor, _canForceConfirm);

            if (result.Success)
            {
                Snackbar.Add(result.Message, Severity.Success);
                await AuditLogger.LogAsync(_currentActor, "UPDATE", "BusinessDay",
                    $"{storeNo}_{businessDate:yyyyMMdd}",
                    oldValueJson: oldSnapshot,
                    newValueJson: JsonConvert.SerializeObject(result));
                // Sau khi xác nhận, ngày kinh doanh của cửa hàng đã chuyển sang D+1 → load lại lưới theo ngày mới.
                _businessDate = businessDate.AddDays(1);
                await SearchAsync();
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Không thể xác nhận kết thúc ngày. Vui lòng thử lại.", Severity.Error);
            FileLogger.WriteExpLogs("BusinessDayPage.Confirm", ex);
        }
        finally
        {
            _confirming = false;
        }
    }
}
