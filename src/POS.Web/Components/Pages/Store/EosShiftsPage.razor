@page "/store/eos-shifts"
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@inherits PosTableBase<EosShiftDto>

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Web.Components.Shared
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject ICentralMDRepository MdRepo
@inject IKibanaService KibanaService
@inject ISnackbar Snackbar

<PageTitle>Kết thúc ca – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" Style="border-radius:4px"/>
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.LockClock" Class="mr-2" Style="vertical-align:middle"/>
    Kết thúc ca bán hàng
</MudText>

@* ── Filter Panel ──────────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="3">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@_filterStoreNo"
                              Label="Cửa hàng"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="string"
                                 @bind-Value="_filterStoreNo"
                                 Label="Cửa hàng"
                                 Placeholder="Tất cả cửa hàng"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 CoerceValue="true"/>
            }
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterDateNullable"
                           Label="Ngày kinh doanh"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           Editable="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="int?"
                       Value="@_filterStatus"
                       ValueChanged="@OnStatusChanged"
                       Label="Trạng thái"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@((int?)0)">Chưa đóng ca</MudSelectItem>
                <MudSelectItem Value="@((int?)1)">Đã đóng ca</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync"
                           Disabled="@_loading"
                           FullWidth="true">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alert ────────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── KPI Cards ────────────────────────────────────────────────────────── *@
@if (!_loading && _shifts.Count > 0)
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.h4" Color="Color.Primary">@_shifts.Count</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Tổng số ca</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.h4" Color="Color.Success">@_closedCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Đã đóng ca</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.h4" Color="Color.Error">@_openCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa đóng ca</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@* ── Table ────────────────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Style="overflow-x:auto">

    @* Info + pagination trên *@
    <div class="d-flex justify-space-between align-center px-3 py-2 flex-wrap gap-2">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @{
                var from = (_page - 1) * PageSize + 1;
                var to   = Math.Min(_page * PageSize, TotalFiltered);
            }
            @if (TotalFiltered > 0)
            {
                @($"Hiển thị {from}–{to} trong {TotalFiltered} ca")
            }
            else if (!_loading)
            {
                @("Không có dữ liệu")
            }
        </MudText>
        @if (PageCount > 1)
        {
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="5"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        }
    </div>

    <div class="pos-table-wrap">
        <table class="pos-table">
            <thead>
                <tr>
                    <th style="text-align:center" @onclick='() => SortBy("StoreNo")'>
                        Mã CH/ST<span class="pos-sort @(_sortCol=="StoreNo"?"on":"")">@SI("StoreNo")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("PosTerminal")'>
                        PosID<span class="pos-sort @(_sortCol=="PosTerminal"?"on":"")">@SI("PosTerminal")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("BussinessDate")'>
                        Ngày kinh doanh<span class="pos-sort @(_sortCol=="BussinessDate"?"on":"")">@SI("BussinessDate")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("ShiftNumber")'>
                        Ca<span class="pos-sort @(_sortCol=="ShiftNumber"?"on":"")">@SI("ShiftNumber")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("BeginAmount")'>
                        Tiền đầu ca<span class="pos-sort @(_sortCol=="BeginAmount"?"on":"")">@SI("BeginAmount")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("TienMat")'>
                        Tiền mặt<span class="pos-sort @(_sortCol=="TienMat"?"on":"")">@SI("TienMat")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("TienHeThong")'>
                        Tiền hệ thống<span class="pos-sort @(_sortCol=="TienHeThong"?"on":"")">@SI("TienHeThong")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("ChenLech")'>
                        Chênh lệch<span class="pos-sort @(_sortCol=="ChenLech"?"on":"")">@SI("ChenLech")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("CloseShiftDate")'>
                        T/G đóng ca<span class="pos-sort @(_sortCol=="CloseShiftDate"?"on":"")">@SI("CloseShiftDate")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("IsShiftClosed")'>
                        Trạng thái<span class="pos-sort @(_sortCol=="IsShiftClosed"?"on":"")">@SI("IsShiftClosed")</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="10" style="text-align:center; padding:28px">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                        </td>
                    </tr>
                }
                else if (!PagedItems.Any())
                {
                    <tr>
                        <td colspan="10" style="text-align:center; padding:28px; color:#9e9e9e">
                            Không có dữ liệu. Hãy điều chỉnh bộ lọc và nhấn Tìm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in PagedItems)
                    {
                        <tr>
                            <td style="text-align:center">@s.StoreNo</td>
                            <td style="text-align:center">@s.PosTerminal</td>
                            <td style="text-align:center">@s.BussinessDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center">@s.ShiftNumber</td>
                            <td style="text-align:right">@FormatVND(s.BeginAmount)</td>
                            <td style="text-align:right; color:@(s.TienMat > 0 ? "inherit" : "#9e9e9e")">
                                @FormatVND(s.TienMat)
                            </td>
                            <td style="text-align:right">@FormatVND(s.TienHeThong)</td>
                            <td style="text-align:right; font-weight:500; color:@(s.ChenLech < 0 ? "#f44336" : "#4caf50")">
                                @FormatVND(s.ChenLech)
                            </td>
                            <td style="text-align:center">
                                @(s.CloseShiftDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </td>
                            <td style="text-align:center">
                                @if (s.IsShiftClosed)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                        Đã đóng ca
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                                        Chưa đóng ca
                                    </MudChip>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Pagination dưới *@
    @if (PageCount > 1)
    {
        <div class="d-flex justify-end px-3 py-2">
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="5"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        </div>
    }

</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool    _loading;
    private string? _errorMsg;
    private bool    _isStoreOperator;

    private string?   _filterStoreNo;
    private DateTime? _filterDateNullable = DateTime.Today;
    private int?      _filterStatus;

    private List<EosShiftDto>     _shifts         = [];
    private IReadOnlyList<string> _userStoreCodes = [];
    private List<string>          _allStoreCodes  = [];

    private int _closedCount => _shifts.Count(s =>  s.IsShiftClosed);
    private int _openCount   => _shifts.Count(s => !s.IsShiftClosed);

    // ── PosTableBase<T> implementation ──────────────────────────────────────

    protected override IEnumerable<EosShiftDto> SortedFiltered
    {
        get
        {
            var filtered = _filterStatus switch
            {
                0 => _shifts.Where(s => !s.IsShiftClosed),
                1 => _shifts.Where(s =>  s.IsShiftClosed),
                _ => (IEnumerable<EosShiftDto>)_shifts
            };
            return _sortCol switch
            {
                "PosTerminal"    => _sortAsc ? filtered.OrderBy(s => s.PosTerminal)    : filtered.OrderByDescending(s => s.PosTerminal),
                "BussinessDate"  => _sortAsc ? filtered.OrderBy(s => s.BussinessDate)  : filtered.OrderByDescending(s => s.BussinessDate),
                "ShiftNumber"    => _sortAsc ? filtered.OrderBy(s => s.ShiftNumber)    : filtered.OrderByDescending(s => s.ShiftNumber),
                "BeginAmount"    => _sortAsc ? filtered.OrderBy(s => s.BeginAmount)    : filtered.OrderByDescending(s => s.BeginAmount),
                "TienMat"        => _sortAsc ? filtered.OrderBy(s => s.TienMat)        : filtered.OrderByDescending(s => s.TienMat),
                "TienHeThong"    => _sortAsc ? filtered.OrderBy(s => s.TienHeThong)    : filtered.OrderByDescending(s => s.TienHeThong),
                "ChenLech"       => _sortAsc ? filtered.OrderBy(s => s.ChenLech)       : filtered.OrderByDescending(s => s.ChenLech),
                "CloseShiftDate" => _sortAsc ? filtered.OrderBy(s => s.CloseShiftDate) : filtered.OrderByDescending(s => s.CloseShiftDate),
                "IsShiftClosed"  => _sortAsc ? filtered.OrderBy(s => s.IsShiftClosed)  : filtered.OrderByDescending(s => s.IsShiftClosed),
                _                => _sortAsc ? filtered.OrderBy(s => s.StoreNo)        : filtered.OrderByDescending(s => s.StoreNo),
            };
        }
    }

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
        {
            _filterStoreNo = _userStoreCodes[0];
        }
        else
        {
            try
            {
                var configs = await MdRepo.GetStoreSetConfigAsync();
                _allStoreCodes = configs?
                    .Select(c => c.StoreNo)
                    .Where(s => !string.IsNullOrEmpty(s))
                    .Distinct()
                    .OrderBy(s => s)
                    .ToList() ?? [];
            }
            catch (Exception ex)
            {
                KibanaService.LogException("EosShiftsPage.LoadStoreCodes", "", 0, "", ex.Message);
            }
        }

        await LoadDataAsync();
    }

    // ── Data ────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _page     = 1;
        StateHasChanged();
        try
        {
            var date = (_filterDateNullable ?? DateTime.Today).Date;

            IReadOnlyList<string>? storeCodes = _isStoreOperator
                ? _userStoreCodes
                : string.IsNullOrEmpty(_filterStoreNo)
                    ? null
                    : [_filterStoreNo];

            _shifts = await SaleRepo.GetEosShiftListAsync(date, storeCodes);

            KibanaService.LogInfo("EosShiftsPage.LoadData",
                _filterStoreNo ?? "all",
                $"Loaded {_shifts.Count} shifts [{date:dd/MM/yyyy}] closed={_closedCount} open={_openCount}");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            KibanaService.LogException("EosShiftsPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilterAsync()
    {
        _filterDateNullable = DateTime.Today;
        _filterStatus       = null;
        if (!_isStoreOperator) _filterStoreNo = null;
        await LoadDataAsync();
    }

    private void OnStatusChanged(int? value) { _filterStatus = value; _page = 1; }

    private Task<IEnumerable<string>> SearchStoreAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(_allStoreCodes);
        return Task.FromResult(_allStoreCodes
            .Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }
}
