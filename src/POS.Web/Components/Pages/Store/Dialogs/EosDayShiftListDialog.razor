@namespace POS.Web.Components.Pages.Store
@using MudBlazor
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject IDialogService DialogService
@inject IKibanaService KibanaService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="color:#1976d2"/>
            <MudText Typo="Typo.h6">
                @StoreName — @Day.BussinessDate.ToString("dd/MM/yyyy")
            </MudText>
            @if (Day.OpenShifts > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-1">
                    @Day.OpenShifts ca chưa đóng
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ml-1">
                    Đã đóng hết ca
                </MudChip>
            }
        </div>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
        }
        else if (_errorMsg != null)
        {
            <MudAlert Severity="Severity.Error">@_errorMsg</MudAlert>
        }
        else
        {
            <MudTable Items="@_shifts" Hover="true" Striped="true" Dense="true"
                      Breakpoint="Breakpoint.Sm" Elevation="0"
                      HorizontalScrollbar="true">
                <HeaderContent>
                    <MudTh Style="text-align:center">PosID</MudTh>
                    <MudTh Style="text-align:center">Ca</MudTh>
                    <MudTh Style="text-align:center">Thu ngân</MudTh>
                    <MudTh Style="text-align:center">Mở ca</MudTh>
                    <MudTh Style="text-align:center">Đóng ca</MudTh>
                    <MudTh Style="text-align:right">Doanh thu</MudTh>
                    <MudTh Style="text-align:right">Tiền hệ thống</MudTh>
                    <MudTh Style="text-align:center">Trạng thái</MudTh>
                    <MudTh Style="text-align:center">Chi tiết</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="PosID" Style="text-align:center">@context.PosTerminal</MudTd>
                    <MudTd DataLabel="Ca" Style="text-align:center">@context.ShiftNumber</MudTd>
                    <MudTd DataLabel="Thu ngân" Style="text-align:center">@(context.StaffCode ?? "—")</MudTd>
                    <MudTd DataLabel="Mở ca" Style="text-align:center">@(context.OpenShiftDate?.ToString("HH:mm") ?? "—")</MudTd>
                    <MudTd DataLabel="Đóng ca" Style="text-align:center">@(context.CloseShiftDate?.ToString("HH:mm") ?? "—")</MudTd>
                    <MudTd DataLabel="Doanh thu" Style="text-align:right">@FormatVND(context.TotalRevenue)</MudTd>
                    <MudTd DataLabel="Tiền hệ thống" Style="text-align:right">@FormatVND(context.TienHeThong)</MudTd>
                    <MudTd DataLabel="Trạng thái" Style="text-align:center">
                        @if (context.IsShiftClosed)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Đã đóng</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Chưa đóng</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Chi tiết" Style="text-align:center">
                        <MudTooltip Text="Xem chi tiết ca">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenShiftDetailAsync(context))"/>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Style="color:#9e9e9e">Không có ca nào trong ngày này.</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Close())">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public EosDayDto Day { get; set; } = null!;
    [Parameter] public string StoreName { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _errorMsg;
    private List<EosShiftDto> _shifts = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shifts = await SaleRepo.GetEosShiftListAsync(Day.BussinessDate, [Day.StoreNo]);
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách ca.";
            KibanaService.LogException("EosDayShiftListDialog.OnInitializedAsync", Day.StoreNo, 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenShiftDetailAsync(EosShiftDto shift)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true
        };
        var parameters = new DialogParameters<EosShiftDetailDialog>
        {
            { x => x.Shift, shift }
        };
        await DialogService.ShowAsync<EosShiftDetailDialog>("", parameters, options);
    }

    private static string FormatVND(decimal v) => $"{v:N0} ₫";
}
