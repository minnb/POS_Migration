@namespace POS.Web.Components.Pages.Store
@using MudBlazor
@using POS.Common.Dtos.CentralSale
@using POS.Common.Dtos.POS
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject IFileLogHelper FileLogger

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">Chi tiết hàng hóa</MudText>
                <MudTable Items="@_transLines" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Elevation="1" Dense="true" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Barcode</MudTh>
                        <MudTh>Mã SP</MudTh>
                        <MudTh>Tên SP</MudTh>
                        <MudTh>ĐVT</MudTh>
                        <MudTh>SL</MudTh>
                        <MudTh>Giá bán</MudTh>
                        <MudTh>Giảm giá</MudTh>
                        <MudTh>Thành tiền</MudTh>
                        <MudTh>VAT%</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
                        <MudTd DataLabel="Mã SP">@context.ItemNo</MudTd>
                        <MudTd DataLabel="Tên SP">@context.ItemName</MudTd>
                        <MudTd DataLabel="ĐVT">@context.UnitOfMeasure</MudTd>
                        <MudTd DataLabel="SL">@context.Quantity.ToString("N0")</MudTd>
                        <MudTd DataLabel="Giá bán">@context.UnitPrice.ToString("N0")</MudTd>
                        <MudTd DataLabel="Giảm giá">@context.DiscountAmount.ToString("N0")</MudTd>
                        <MudTd DataLabel="Thành tiền">@context.LineAmountIncVAT.ToString("N0")</MudTd>
                        <MudTd DataLabel="VAT%">@context.VATPercent.ToString("N0")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Hình thức thanh toán</MudText>
                <MudTable Items="@_paymentEntries" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Elevation="1" Dense="true" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Loại TT</MudTh>
                        <MudTh>Mô tả</MudTh>
                        <MudTh>Số tiền</MudTh>
                        <MudTh>Số tham chiếu</MudTh>
                        <MudTh>Mã chuẩn chi</MudTh>
                        <MudTh>POS NH</MudTh>
                        <MudTh>Loại thẻ</MudTh>
                        <MudTh>TT ngân hàng</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Loại TT">@context.TenderType</MudTd>
                        <MudTd DataLabel="Mô tả">@context.Description</MudTd>
                        <MudTd DataLabel="Số tiền">@context.AmountTendered.ToString("N0")</MudTd>
                        <MudTd DataLabel="Số tham chiếu">@context.CardNo</MudTd>
                        <MudTd DataLabel="Mã chuẩn chi">@context.AppCode</MudTd>
                        <MudTd DataLabel="POS NH">@context.POSBankTerminalNo</MudTd>
                        <MudTd DataLabel="Loại thẻ">@context.CardType</MudTd>
                        <MudTd DataLabel="TT ngân hàng">@context.BankPayment</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Outlined" Class="pos-btn-mockup pos-btn-secondary-mockup">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public TransactionListDto Transaction { get; set; } = null!;

    private bool _loading = true;
    private List<ValidateTransactionLine> _transLines = new();
    private List<TransPaymentEntryDto> _paymentEntries = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var taskLines = SaleRepo.GetTransLinesAsync(Transaction.OrderNo);
            var taskPayments = SaleRepo.GetTransPaymentEntriesAsync(Transaction.OrderNo);

            await Task.WhenAll(taskLines, taskPayments);

            _transLines = await taskLines;
            _paymentEntries = await taskPayments;
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("TransactionDetailDialog.OnInitializedAsync", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void CloseDialog()
    {
        MudDialog.Close();
    }
}
