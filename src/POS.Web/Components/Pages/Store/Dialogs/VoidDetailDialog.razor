@namespace POS.Web.Components.Pages.Store
@using MudBlazor
@using POS.Common.Dtos.CentralSale
@using POS.Common.Dtos.POS
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject IKibanaService KibanaService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else
        {
            @* ── Khối thông tin GD hủy ─────────────────────────────────── *@
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudGrid Spacing="2">
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Số hóa đơn</MudText><MudText Typo="Typo.body2"><strong>@Transaction.OrderNo</strong></MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Thời điểm hủy</MudText><MudText Typo="Typo.body2">@Transaction.OrderDate.ToString("dd/MM/yyyy") @Transaction.OrderTime.ToString("HH:mm:ss")</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Cửa hàng</MudText><MudText Typo="Typo.body2">@Transaction.StoreNo</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Máy POS / Ca</MudText><MudText Typo="Typo.body2">@Transaction.POSTerminalNo@(string.IsNullOrWhiteSpace(Transaction.ShiftNo) ? "" : $" / {Transaction.ShiftNo}")</MudText></MudItem>

                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Thu ngân lập đơn</MudText><MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Transaction.CashierID) ? "—" : Transaction.CashierID)</MudText></MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Người hủy</MudText>
                        @if (Transaction.IsSelfVoid)
                        {
                            <MudText Typo="Typo.body2" Style="color:#DC3545; font-weight:500">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="vertical-align:middle"/>
                                @Transaction.UserVoid (Tự hủy)
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Transaction.UserVoid) ? "—" : Transaction.UserVoid)</MudText>
                        }
                    </MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Thành viên</MudText><MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Transaction.MemberCardNo) ? "—" : Transaction.MemberCardNo)</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Tổng tiền</MudText><MudText Typo="Typo.body2" Style="color:#DC3545; font-weight:500">@Transaction.AmountInclVAT.ToString("N0") ₫</MudText></MudItem>
                </MudGrid>

                @if (!string.IsNullOrWhiteSpace(Transaction.Note))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" Icon="@Icons.Material.Filled.Notes">
                        <strong>Lý do hủy:</strong> @Transaction.Note
                    </MudAlert>
                }
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Chi tiết hàng hóa</MudText>
                <MudTable Items="@_transLines" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1">
                    <HeaderContent>
                        <MudTh>Barcode</MudTh>
                        <MudTh>Mã SP</MudTh>
                        <MudTh>Tên SP</MudTh>
                        <MudTh>ĐVT</MudTh>
                        <MudTh>SL</MudTh>
                        <MudTh>Giá bán</MudTh>
                        <MudTh>Giảm giá</MudTh>
                        <MudTh>Thành tiền</MudTh>
                        <MudTh>VAT%</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
                        <MudTd DataLabel="Mã SP">@context.ItemNo</MudTd>
                        <MudTd DataLabel="Tên SP">@context.ItemName</MudTd>
                        <MudTd DataLabel="ĐVT">@context.UnitOfMeasure</MudTd>
                        <MudTd DataLabel="SL">@context.Quantity.ToString("N0")</MudTd>
                        <MudTd DataLabel="Giá bán">@context.UnitPrice.ToString("N0")</MudTd>
                        <MudTd DataLabel="Giảm giá">@context.DiscountAmount.ToString("N0")</MudTd>
                        <MudTd DataLabel="Thành tiền">@context.LineAmountIncVAT.ToString("N0")</MudTd>
                        <MudTd DataLabel="VAT%">@context.VATPercent.ToString("N0")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-3" Style="color:#9e9e9e">Không có chi tiết hàng hóa.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Outlined" Color="Color.Secondary">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public VoidTransactionListDto Transaction { get; set; } = null!;

    private bool _loading = true;
    private List<ValidateTransactionLine> _transLines = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _transLines = await SaleRepo.GetVoidTransLinesAsync(Transaction.OrderNo);
        }
        catch (Exception ex)
        {
            KibanaService.LogException("VoidDetailDialog.OnInitializedAsync", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void CloseDialog()
    {
        MudDialog.Close();
    }
}
