@page "/store/transactions"
@namespace POS.Web.Components.Pages.Store
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralMD
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Giao dịch – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
}

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:400">
    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
    Giao dịch
</MudText>

@* ── Filter Panel ────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="3">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@StoreDisplayText"
                              Label="Cửa hàng"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="StoreDto"
                                 @bind-Value="_selectedStore"
                                 Label="Cửa hàng"
                                 Placeholder="Tất cả cửa hàng"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 ToStringFunc="@(s => s == null ? "" : $"{s.StoreNo} – {s.Name}")"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 MaxItems="50"/>
            }
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterFromDateNullable"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterToDateNullable"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_filterOrderNo"
                          Label="Số hóa đơn"
                          Placeholder="Nhập một phần số hóa đơn..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync"
                           Disabled="@_loading"
                           FullWidth="true">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alerts ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}
@if (_hitLimit)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
        Kết quả chỉ hiển thị tối đa 500 giao dịch mới nhất. Hãy thu hẹp bộ lọc để xem đầy đủ.
    </MudAlert>
}

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudTable Items="@_transactions"
          Hover="true" Striped="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Elevation="2"
          Loading="@_loading" LoadingProgressColor="Color.Primary"
          HorizontalScrollbar="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.OrderNo)">Số hóa đơn</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.OrderDate)">Ngày KD</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.OrderTime)">Giờ</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.StoreNo)">Cửa hàng</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.POSTerminalNo)">Máy POS</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.DiscountAmount)">Giảm giá</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.AmountInclVAT)">Tổng tiền</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.TransactionType)">Loại đơn</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<TransactionListDto, object>(x => x.CreatedDate)">Đồng bộ</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center">Thao tác</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Số hóa đơn">@context.OrderNo</MudTd>
        <MudTd DataLabel="Ngày KD" Style="text-align:center">@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Giờ" Style="text-align:center">@context.OrderTime.ToString("HH:mm:ss")</MudTd>
        <MudTd DataLabel="Cửa hàng" Style="text-align:center">@context.StoreNo</MudTd>
        <MudTd DataLabel="Máy POS" Style="text-align:center">@context.POSTerminalNo</MudTd>
        <MudTd DataLabel="Giảm giá" Style="@($"text-align:right; color:{(context.DiscountAmount > 0 ? "#F39C12" : "#9e9e9e")}")">
            @(context.DiscountAmount > 0 ? FormatVND(context.DiscountAmount) : "—")
        </MudTd>
        <MudTd DataLabel="Tổng tiền" Style="@($"text-align:right; font-weight:500; color:{(context.TransactionType == 1 ? "#27AE60" : "#DC3545")}")">
            @FormatVND(context.AmountInclVAT)
        </MudTd>
        <MudTd DataLabel="Loại đơn" Style="text-align:center">
            @{
                var (tColor, tLabel) = TransTypeDisplay(context.TransactionType);
            }
            <MudChip T="string" Color="@tColor" Size="Size.Small" Variant="Variant.Filled">@tLabel</MudChip>
        </MudTd>
        <MudTd DataLabel="Đồng bộ" Style="text-align:center">@context.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
        <MudTd DataLabel="Thao tác" Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                           Size="Size.Small" Color="Color.Primary"
                           Title="Xem chi tiết"
                           OnClick="@(() => OpenDetailAsync(context))"/>
            <MudIconButton Icon="@Icons.Material.Filled.Print"
                           Size="Size.Small" Color="Color.Default"
                           Title="Print view (sắp ra mắt)"
                           Disabled="true"/>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Style="color:#9e9e9e">Không có dữ liệu. Hãy điều chỉnh bộ lọc và nhấn Tìm.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} giao dịch"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private const int MaxRows = 500;

    private bool    _loading;
    private string? _errorMsg;
    private bool    _hitLimit;
    private bool    _isStoreOperator;

    private string?   _filterStoreNo;
    private DateTime? _filterFromDateNullable = DateTime.Today;
    private DateTime? _filterToDateNullable   = DateTime.Today;
    private string    _filterOrderNo          = string.Empty;

    private List<TransactionListDto> _transactions   = [];
    private IReadOnlyList<string>    _userStoreCodes = [];
    private List<StoreDto>           _allStores      = [];
    private StoreDto?                _selectedStore;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
            _filterStoreNo = _userStoreCodes[0];

        try
        {
            _allStores = await MdRepo.GetStoreListAsync();
            if (_allStores.Count == 0 && !_isStoreOperator)
                Snackbar.Add("Danh sách cửa hàng đang trống — không thể lọc theo cửa hàng.",
                    Severity.Warning);
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("TransactionsPage.LoadStoreCodes", ex);
            if (!_isStoreOperator)
                Snackbar.Add("Không tải được danh sách cửa hàng. Vui lòng thử lại sau.",
                    Severity.Error);
        }

        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _hitLimit = false;
        StateHasChanged();
        try
        {
            var from = (_filterFromDateNullable ?? DateTime.Today).Date;
            var to   = (_filterToDateNullable   ?? DateTime.Today).Date;
            if (from > to) to = from;

            var storeNo = _isStoreOperator ? _filterStoreNo : _selectedStore?.StoreNo;
            var result = await SaleRepo.GetTransactionListAsync(
                storeNo,
                from,
                to,
                string.IsNullOrWhiteSpace(_filterOrderNo) ? null : _filterOrderNo,
                MaxRows);

            _transactions = result;
            _hitLimit     = result.Count == MaxRows;

            FileLogger.WriteLogs($"[TransactionsPage.LoadData] {storeNo ?? "all"}: Loaded {result.Count} transactions [{from:dd/MM/yyyy}-{to:dd/MM/yyyy}]");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            FileLogger.WriteExpLogs("TransactionsPage.LoadData", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilterAsync()
    {
        _filterFromDateNullable = DateTime.Today;
        _filterToDateNullable   = DateTime.Today;
        _filterOrderNo          = string.Empty;
        if (!_isStoreOperator) _selectedStore = null;
        await LoadDataAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadDataAsync();
    }

    private Task<IEnumerable<StoreDto>> SearchStoreAsync(string value, CancellationToken ct)
    {
        // Bound kết quả ≤ 50: tránh đẩy cả nghìn store vào component.
        // (MaxItems chỉ giới hạn HIỂN THỊ, không giới hạn dữ liệu SearchFunc xử lý.)
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<StoreDto>>(_allStores.Take(50));

        var v = value.Trim();
        var matches = _allStores
            .Where(s =>
                (s.StoreNo?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Name?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false))
            // Ưu tiên store có MÃ bắt đầu bằng từ khóa → gõ mã luôn nổi đầu, không bị Take(50) cắt
            .OrderByDescending(s => s.StoreNo?.StartsWith(v, StringComparison.OrdinalIgnoreCase) ?? false)
            .ThenBy(s => s.StoreNo, StringComparer.OrdinalIgnoreCase)
            .Take(50);

        return Task.FromResult<IEnumerable<StoreDto>>(matches);
    }

    private string StoreDisplayText => _allStores.FirstOrDefault(s => s.StoreNo == _filterStoreNo) is { } st
        ? $"{st.StoreNo} – {st.Name}"
        : (_filterStoreNo ?? "");

    private async Task OpenDetailAsync(TransactionListDto t)
    {
        await DialogService.ShowAsync<TransactionDetailDialog>(
            $"Chi tiết giao dịch: {t.OrderNo}",
            new DialogParameters<TransactionDetailDialog> { { x => x.Transaction, t } },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true,
                                CloseButton = true, CloseOnEscapeKey = true });
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string FormatVND(decimal v) => $"{v:N0} ₫";

    private static (Color Color, string Label) TransTypeDisplay(int type) => type switch
    {
        1      => (Color.Success, "Bán hàng"),
        2 or 3 => (Color.Warning, "Trả hàng"),
        _      => (Color.Default, $"Loại {type}")
    };
}
