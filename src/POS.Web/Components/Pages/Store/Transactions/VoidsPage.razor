@page "/store/voids"
@namespace POS.Web.Components.Pages.Store
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralMD
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar

<PageTitle>Hủy GD – POS Dashboard</PageTitle>

@if (_loading && !_voids.Any())
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
}

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:400">
    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
    Lịch sử hủy giao dịch
</MudText>

@* ── Filter Panel ────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-3 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="3">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@StoreDisplayText"
                              Label="Cửa hàng"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="StoreDto"
                                 @bind-Value="_selectedStore"
                                 Label="Cửa hàng"
                                 Placeholder="Tất cả cửa hàng"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 ToStringFunc="@(s => s == null ? "" : $"{s.StoreNo} – {s.Name}")"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 MaxItems="50"/>
            }
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_filterFromDateNullable"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_filterToDateNullable"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="_filterVoidType"
                       Label="Loại hủy"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@string.Empty">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("InvoiceVoid")">Hủy cả hóa đơn</MudSelectItem>
                <MudSelectItem Value="@("LineVoid")">Hủy dòng</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_filterOrderNo"
                          Label="Số hóa đơn"
                          Placeholder="Nhập một phần số hóa đơn..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_filterUserVoid"
                          Label="Người hủy"
                          Placeholder="Tên/ID người hủy..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PersonOff"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_filterPosNo"
                          Label="Máy POS"
                          Placeholder="Mã máy POS..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PointOfSale"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync"
                           Disabled="@_loading"
                           FullWidth="true">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alerts ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}
@if (_hitLimit)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
        Kết quả chỉ hiển thị tối đa @MaxRows dòng hủy mới nhất. Hãy thu hẹp bộ lọc để xem đầy đủ.
    </MudAlert>
}

@* ── KPI Row ─────────────────────────────────────────────────────────── *@
<div class="d-flex flex-wrap gap-3 mb-4">
    <div style="flex:1 1 200px">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-left:4px solid var(--mud-palette-error)">
            <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Error">@InvoiceVoidCount</MudText>
            <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Số hóa đơn hủy cả đơn</MudText>
        </MudPaper>
    </div>
    <div style="flex:1 1 200px">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-left:4px solid var(--mud-palette-error)">
            <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Error">@FormatVND(InvoiceVoidAmount)</MudText>
            <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Tổng tiền hủy hóa đơn</MudText>
        </MudPaper>
    </div>
    <div style="flex:1 1 200px">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-left:4px solid var(--mud-palette-warning)">
            <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Warning">@LineVoidCount</MudText>
            <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Số dòng hủy lẻ</MudText>
        </MudPaper>
    </div>
    <div style="flex:1 1 200px">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-left:4px solid var(--mud-palette-primary)">
            <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Primary">@FormatVND(TotalVoidAmount)</MudText>
            <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Tổng tiền hủy dòng (mọi loại)</MudText>
        </MudPaper>
    </div>
</div>

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudTable Items="@_voids"
          Hover="true" Dense="true" Striped="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading" LoadingProgressColor="Color.Primary"
          HorizontalScrollbar="true"
          RowClassFunc="@RowClassFunc">
    <HeaderContent>
        <MudTh Style="text-align:center">Loại hủy</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.OrderNo)">Số hóa đơn</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center">Dòng</MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.ScanTime)">Ngày hủy</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center">Giờ hủy</MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.StoreNo ?? string.Empty)">Cửa hàng</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.POSTerminalNo ?? string.Empty)">Máy POS</MudTableSortLabel></MudTh>
        <MudTh>Mã hàng</MudTh>
        <MudTh>Tên hàng</MudTh>
        <MudTh Style="text-align:right">SL</MudTh>
        <MudTh Style="text-align:right">Đơn giá</MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.LineAmountIncVAT)">Thành tiền dòng</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.OrderAmountInclVAT ?? 0)">Tổng hóa đơn</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center">Loại GD gốc</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<VoidReportLineDto, object>(x => x.UserVoid ?? string.Empty)">Người hủy</MudTableSortLabel></MudTh>
        <MudTh>Ghi chú</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Loại hủy" Style="text-align:center">
            @if (context.VoidType == "InvoiceVoid")
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">HỦY HÓA ĐƠN</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">HỦY DÒNG</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Số hóa đơn">@context.OrderNo</MudTd>
        <MudTd DataLabel="Dòng" Style="text-align:center">@context.LineNo</MudTd>
        <MudTd DataLabel="Ngày hủy" Style="text-align:center">@context.ScanTime.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Giờ hủy" Style="text-align:center">@context.ScanTime.ToString("HH:mm:ss")</MudTd>
        <MudTd DataLabel="Cửa hàng" Style="text-align:center">@(context.StoreNo ?? "—")</MudTd>
        <MudTd DataLabel="Máy POS" Style="text-align:center">@(context.POSTerminalNo ?? "—")</MudTd>
        <MudTd DataLabel="Mã hàng">@(context.ItemNo ?? "—")</MudTd>
        <MudTd DataLabel="Tên hàng">@(context.ItemName ?? "—")</MudTd>
        <MudTd DataLabel="SL" Style="text-align:right">@context.Quantity.ToString("N0")</MudTd>
        <MudTd DataLabel="Đơn giá" Style="text-align:right">@FormatVND(context.UnitPrice)</MudTd>
        <MudTd DataLabel="Thành tiền dòng" Style="text-align:right; font-weight:500; color:var(--pos-danger)">
            @FormatVND(context.LineAmountIncVAT)
        </MudTd>
        <MudTd DataLabel="Tổng hóa đơn" Style="text-align:right">
            @if (context.VoidType == "InvoiceVoid")
            {
                <span style="font-weight:500; color:var(--pos-danger)">@FormatVND(context.OrderAmountInclVAT ?? 0)</span>
            }
            else
            {
                <MudTooltip Text="Đơn hàng gốc vẫn hoàn tất bình thường — đây KHÔNG phải tiền bị mất">
                    <span style="color:var(--pos-text-muted)">@FormatVND(context.OrderAmountInclVAT ?? 0) <small>(đơn không hủy)</small></span>
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Loại GD gốc" Style="text-align:center">
            @{
                var (tColor, tLabel) = TransTypeDisplay(context.TransactionType);
            }
            <MudChip T="string" Color="@tColor" Size="Size.Small" Variant="Variant.Outlined">@tLabel</MudChip>
        </MudTd>
        <MudTd DataLabel="Người hủy">
            @if (context.IsSelfVoid)
            {
                <MudTooltip Text="Tự hủy: người hủy trùng thu ngân lập đơn">
                    <span class="d-inline-flex align-center gap-1" style="color:var(--pos-danger); font-weight:500">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small"/>
                        @context.UserVoid
                    </span>
                </MudTooltip>
            }
            else
            {
                @(string.IsNullOrWhiteSpace(context.UserVoid) ? "—" : context.UserVoid)
            }
        </MudTd>
        <MudTd DataLabel="Ghi chú">
            @if (string.IsNullOrWhiteSpace(context.Note))
            {
                <span style="color:var(--pos-text-muted)">—</span>
            }
            else
            {
                <MudTooltip Text="@context.Note">
                    <span style="display:inline-block; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:bottom">@context.Note</span>
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Style="color:#9e9e9e">Không có dữ liệu. Hãy điều chỉnh bộ lọc và nhấn Tìm.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng hủy"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private const int MaxRows = 1000;

    private bool    _loading;
    private string? _errorMsg;
    private bool    _hitLimit;
    private bool    _isStoreOperator;

    private string?   _filterStoreNo;
    private DateTime? _filterFromDateNullable = DateTime.Today.AddDays(-6);
    private DateTime? _filterToDateNullable   = DateTime.Today;
    private string    _filterOrderNo          = string.Empty;
    private string    _filterUserVoid         = string.Empty;
    private string    _filterPosNo            = string.Empty;
    private string    _filterVoidType         = string.Empty;

    private List<VoidReportLineDto> _voids          = [];
    private IReadOnlyList<string>   _userStoreCodes = [];
    private List<StoreDto>          _allStores      = [];
    private StoreDto?               _selectedStore;

    // ── KPI ──────────────────────────────────────────────────────────────────

    private int InvoiceVoidCount =>
        _voids.Where(x => x.VoidType == "InvoiceVoid").Select(x => x.OrderNo).Distinct().Count();

    private decimal InvoiceVoidAmount =>
        _voids.Where(x => x.VoidType == "InvoiceVoid").DistinctBy(x => x.OrderNo).Sum(x => x.OrderAmountInclVAT ?? 0);

    private int LineVoidCount => _voids.Count(x => x.VoidType == "LineVoid");

    private decimal TotalVoidAmount => _voids.Sum(x => x.LineAmountIncVAT);

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
            _filterStoreNo = _userStoreCodes[0];

        try
        {
            _allStores = await MdRepo.GetStoreListAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("VoidsPage.LoadStoreCodes", ex);
        }

        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _hitLimit = false;
        StateHasChanged();
        try
        {
            var from = (_filterFromDateNullable ?? DateTime.Today).Date;
            var to   = (_filterToDateNullable   ?? DateTime.Today).Date;
            if (from > to) to = from;

            var storeNo = _isStoreOperator ? _filterStoreNo : _selectedStore?.StoreNo;
            var result = await SaleRepo.GetVoidReportAsync(
                storeNo,
                from,
                to,
                string.IsNullOrWhiteSpace(_filterOrderNo)  ? null : _filterOrderNo,
                string.IsNullOrWhiteSpace(_filterUserVoid) ? null : _filterUserVoid,
                string.IsNullOrWhiteSpace(_filterPosNo)    ? null : _filterPosNo,
                string.IsNullOrWhiteSpace(_filterVoidType) ? null : _filterVoidType,
                MaxRows);

            _voids    = result;
            _hitLimit = result.Count == MaxRows;

            FileLogger.WriteLogs($"[VoidsPage.LoadData] {storeNo ?? "all"}: Loaded {result.Count} void report rows [{from:dd/MM/yyyy}-{to:dd/MM/yyyy}]");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            FileLogger.WriteExpLogs("VoidsPage.LoadData", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilterAsync()
    {
        _filterFromDateNullable = DateTime.Today.AddDays(-6);
        _filterToDateNullable   = DateTime.Today;
        _filterOrderNo          = string.Empty;
        _filterUserVoid         = string.Empty;
        _filterPosNo            = string.Empty;
        _filterVoidType         = string.Empty;
        if (!_isStoreOperator) _selectedStore = null;
        await LoadDataAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadDataAsync();
    }

    private Task<IEnumerable<StoreDto>> SearchStoreAsync(string value, CancellationToken ct)
    {
        // Bound kết quả ≤ 50: tránh đẩy cả nghìn store vào component.
        // (MaxItems chỉ giới hạn HIỂN THỊ, không giới hạn dữ liệu SearchFunc xử lý.)
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<StoreDto>>(_allStores.Take(50));

        var v = value.Trim();
        var matches = _allStores
            .Where(s =>
                (s.StoreNo?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Name?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false))
            // Ưu tiên store có MÃ bắt đầu bằng từ khóa → gõ mã luôn nổi đầu, không bị Take(50) cắt
            .OrderByDescending(s => s.StoreNo?.StartsWith(v, StringComparison.OrdinalIgnoreCase) ?? false)
            .ThenBy(s => s.StoreNo, StringComparer.OrdinalIgnoreCase)
            .Take(50);

        return Task.FromResult<IEnumerable<StoreDto>>(matches);
    }

    private string StoreDisplayText => _allStores.FirstOrDefault(s => s.StoreNo == _filterStoreNo) is { } st
        ? $"{st.StoreNo} – {st.Name}"
        : (_filterStoreNo ?? "");

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string FormatVND(decimal v) => $"{v:N0} ₫";

    private string RowClassFunc(VoidReportLineDto item, int index)
        => item.VoidType == "InvoiceVoid" ? "pos-row-invoice-void" : string.Empty;

    // Loại GD gốc bị hủy — màu trung tính (mọi dòng đều là GD đã hủy)
    private static (Color Color, string Label) TransTypeDisplay(int? type) => type switch
    {
        1      => (Color.Info,    "GD bán"),
        2 or 3 => (Color.Warning, "GD trả"),
        null   => (Color.Default, "—"),
        _      => (Color.Default, $"Loại {type}")
    };
}
