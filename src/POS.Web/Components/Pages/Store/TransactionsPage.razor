@page "/store/transactions"
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@inherits PosTableBase<TransactionListDto>

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Web.Components.Shared
@using POS.Infrastructure.Logging

@inject ICentralSaleRepository SaleRepo
@inject ICentralMDRepository MdRepo
@inject IKibanaService KibanaService
@inject ISnackbar Snackbar

<PageTitle>Giao dịch – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" Style="border-radius:4px"/>
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Style="vertical-align:middle"/>
    Giao dịch
</MudText>

@* ── Filter Panel ────────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="3">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@_filterStoreNo"
                              Label="Cửa hàng"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="string"
                                 @bind-Value="_filterStoreNo"
                                 Label="Cửa hàng"
                                 Placeholder="Tất cả cửa hàng"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 CoerceValue="true"/>
            }
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterFromDateNullable"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           Editable="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterToDateNullable"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           Editable="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_filterOrderNo"
                          Label="Số hóa đơn"
                          Placeholder="Nhập một phần số hóa đơn..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync"
                           Disabled="@_loading"
                           FullWidth="true">Tìm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alerts ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}
@if (_hitLimit)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
        Kết quả chỉ hiển thị tối đa 500 giao dịch mới nhất. Hãy thu hẹp bộ lọc để xem đầy đủ.
    </MudAlert>
}

@* ── Result summary ──────────────────────────────────────────────────── *@
@if (!_loading && _transactions.Count > 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Tìm thấy <strong>@_transactions.Count</strong> giao dịch
        — Tổng doanh thu: <strong>@FormatSummaryVND(_transactions.Where(t => t.TransactionType == 1).Sum(t => t.AmountInclVAT))</strong>
        &nbsp;|&nbsp; Tổng trả hàng: <strong>@FormatSummaryVND(_transactions.Where(t => t.TransactionType is 2 or 3).Sum(t => t.AmountInclVAT))</strong>
    </MudText>
}

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudPaper Elevation="2">

    @* Info + pagination trên *@
    <div class="d-flex justify-space-between align-center px-3 py-2 flex-wrap gap-2">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @{
                var from = (_page - 1) * PageSize + 1;
                var to   = Math.Min(_page * PageSize, TotalFiltered);
            }
            @if (TotalFiltered > 0)
            {
                @($"Hiển thị {from}–{to} trong {TotalFiltered} giao dịch")
            }
            else if (!_loading)
            {
                @("Không có dữ liệu")
            }
        </MudText>
        @if (PageCount > 1)
        {
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="5"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        }
    </div>

    <div class="pos-table-wrap">
        <table class="pos-table">
            <thead>
                <tr>
                    <th @onclick='() => SortBy("OrderNo")'>
                        Số hóa đơn<span class="pos-sort @(_sortCol=="OrderNo"?"on":"")">@SI("OrderNo")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("OrderDate")'>
                        Ngày KD<span class="pos-sort @(_sortCol=="OrderDate"?"on":"")">@SI("OrderDate")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("OrderTime")'>
                        Giờ<span class="pos-sort @(_sortCol=="OrderTime"?"on":"")">@SI("OrderTime")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("StoreNo")'>
                        Cửa hàng<span class="pos-sort @(_sortCol=="StoreNo"?"on":"")">@SI("StoreNo")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("POSTerminalNo")'>
                        Máy POS<span class="pos-sort @(_sortCol=="POSTerminalNo"?"on":"")">@SI("POSTerminalNo")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("DiscountAmount")'>
                        Giảm giá<span class="pos-sort @(_sortCol=="DiscountAmount"?"on":"")">@SI("DiscountAmount")</span>
                    </th>
                    <th style="text-align:right" @onclick='() => SortBy("AmountInclVAT")'>
                        Tổng tiền<span class="pos-sort @(_sortCol=="AmountInclVAT"?"on":"")">@SI("AmountInclVAT")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("TransactionType")'>
                        Loại đơn<span class="pos-sort @(_sortCol=="TransactionType"?"on":"")">@SI("TransactionType")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("CreatedDate")'>
                        Đồng bộ<span class="pos-sort @(_sortCol=="CreatedDate"?"on":"")">@SI("CreatedDate")</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:28px">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                        </td>
                    </tr>
                }
                else if (!PagedItems.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:28px; color:#9e9e9e">
                            Không có dữ liệu. Hãy điều chỉnh bộ lọc và nhấn Tìm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in PagedItems)
                    {
                        <tr>
                            <td>@t.OrderNo</td>
                            <td style="text-align:center">@t.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center">@t.OrderTime.ToString("HH:mm:ss")</td>
                            <td style="text-align:center">@t.StoreNo</td>
                            <td style="text-align:center">@t.POSTerminalNo</td>
                            <td style="text-align:right; color:@(t.DiscountAmount > 0 ? "#F39C12" : "#9e9e9e")">
                                @(t.DiscountAmount > 0 ? FormatVND(t.DiscountAmount) : "—")
                            </td>
                            <td style="text-align:right; font-weight:500; color:@(t.TransactionType == 1 ? "#27AE60" : "#DC3545")">
                                @FormatVND(t.AmountInclVAT)
                            </td>
                            <td style="text-align:center">
                                @{
                                    var (tColor, tLabel) = TransTypeDisplay(t.TransactionType);
                                }
                                <MudChip T="string" Color="@tColor" Size="Size.Small" Variant="Variant.Filled">
                                    @tLabel
                                </MudChip>
                            </td>
                            <td style="text-align:center">@t.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Pagination dưới *@
    @if (PageCount > 1)
    {
        <div class="d-flex justify-end px-3 py-2">
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="5"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        </div>
    }

</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private const int MaxRows = 500;

    private bool    _loading;
    private string? _errorMsg;
    private bool    _hitLimit;
    private bool    _isStoreOperator;

    private string?   _filterStoreNo;
    private DateTime? _filterFromDateNullable = DateTime.Today;
    private DateTime? _filterToDateNullable   = DateTime.Today;
    private string    _filterOrderNo          = string.Empty;

    private List<TransactionListDto> _transactions   = [];
    private IReadOnlyList<string>    _userStoreCodes = [];
    private List<string>             _allStoreCodes  = [];

    // ── PosTableBase<T> implementation ──────────────────────────────────────

    protected override IEnumerable<TransactionListDto> SortedFiltered => _sortCol switch
    {
        "OrderDate"       => _sortAsc ? _transactions.OrderBy(t => t.OrderDate)       : _transactions.OrderByDescending(t => t.OrderDate),
        "OrderTime"       => _sortAsc ? _transactions.OrderBy(t => t.OrderTime)       : _transactions.OrderByDescending(t => t.OrderTime),
        "StoreNo"         => _sortAsc ? _transactions.OrderBy(t => t.StoreNo)         : _transactions.OrderByDescending(t => t.StoreNo),
        "POSTerminalNo"   => _sortAsc ? _transactions.OrderBy(t => t.POSTerminalNo)   : _transactions.OrderByDescending(t => t.POSTerminalNo),
        "DiscountAmount"  => _sortAsc ? _transactions.OrderBy(t => t.DiscountAmount)  : _transactions.OrderByDescending(t => t.DiscountAmount),
        "AmountInclVAT"   => _sortAsc ? _transactions.OrderBy(t => t.AmountInclVAT)   : _transactions.OrderByDescending(t => t.AmountInclVAT),
        "TransactionType" => _sortAsc ? _transactions.OrderBy(t => t.TransactionType) : _transactions.OrderByDescending(t => t.TransactionType),
        "CreatedDate"     => _sortAsc ? _transactions.OrderBy(t => t.CreatedDate)     : _transactions.OrderByDescending(t => t.CreatedDate),
        _                 => _sortAsc ? _transactions.OrderBy(t => t.OrderNo)         : _transactions.OrderByDescending(t => t.OrderNo),
    };

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
        {
            _filterStoreNo = _userStoreCodes[0];
        }
        else
        {
            try
            {
                var configs = await MdRepo.GetStoreSetConfigAsync();
                _allStoreCodes = configs?
                    .Select(c => c.StoreNo)
                    .Where(s => !string.IsNullOrEmpty(s))
                    .Distinct()
                    .OrderBy(s => s)
                    .ToList() ?? [];
            }
            catch (Exception ex)
            {
                KibanaService.LogException("TransactionsPage.LoadStoreCodes", "", 0, "", ex.Message);
            }
        }

        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _hitLimit = false;
        _page     = 1;
        StateHasChanged();
        try
        {
            var from = (_filterFromDateNullable ?? DateTime.Today).Date;
            var to   = (_filterToDateNullable   ?? DateTime.Today).Date;
            if (from > to) to = from;

            var result = await SaleRepo.GetTransactionListAsync(
                _filterStoreNo,
                from,
                to,
                string.IsNullOrWhiteSpace(_filterOrderNo) ? null : _filterOrderNo,
                MaxRows);

            _transactions = result;
            _hitLimit     = result.Count == MaxRows;

            KibanaService.LogInfo("TransactionsPage.LoadData",
                _filterStoreNo ?? "all",
                $"Loaded {result.Count} transactions [{from:dd/MM/yyyy}-{to:dd/MM/yyyy}]");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            KibanaService.LogException("TransactionsPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilterAsync()
    {
        _filterFromDateNullable = DateTime.Today;
        _filterToDateNullable   = DateTime.Today;
        _filterOrderNo          = string.Empty;
        if (!_isStoreOperator) _filterStoreNo = null;
        await LoadDataAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadDataAsync();
    }

    private Task<IEnumerable<string>> SearchStoreAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(_allStoreCodes);
        return Task.FromResult(_allStoreCodes
            .Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static (Color Color, string Label) TransTypeDisplay(int type) => type switch
    {
        1      => (Color.Success, "Bán hàng"),
        2 or 3 => (Color.Warning, "Trả hàng"),
        _      => (Color.Default, $"Loại {type}")
    };

    // Dùng cho summary totals (có thể đến hàng tỷ)
    private static string FormatSummaryVND(decimal amount) => amount switch
    {
        >= 1_000_000_000m => $"{amount / 1_000_000_000m:N1} tỷ",
        >= 1_000_000m     => $"{amount / 1_000_000m:N0} tr",
        _                 => $"{amount:N0} ₫"
    };
}
