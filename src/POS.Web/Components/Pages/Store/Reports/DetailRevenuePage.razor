@page "/store/revenue-detail"
@namespace POS.Web.Components.Pages.Store
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralMD
@using POS.Common.Dtos.RptCentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Infrastructure.Logging

@inject IRptCentralSaleRepository RptSaleRepo
@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar

<PageTitle>Doanh thu chi tiết – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
}

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:400">
    <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
    Doanh thu chi tiết
</MudText>

@* ── Filter Panel ────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterFromDateNullable"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_filterToDateNullable"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@StoreDisplayText"
                              Label="Cửa hàng"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="StoreDto"
                                 @bind-Value="_selectedStore"
                                 Label="Cửa hàng"
                                 Placeholder="Tất cả"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 ToStringFunc="@(s => s == null ? "" : $"{s.StoreNo} – {s.Name}")"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 MaxItems="50"/>
            }
        </MudItem>

        <MudItem xs="12" sm="12" md="4">
            <MudTextField @bind-Value="_filterTextSearch"
                          Label="Tìm kiếm"
                          Placeholder="Số đơn, Barcode, Mã SP..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleKeyDownAsync"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filterOrderType"
                       Label="Loại đơn"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@(string.Empty)">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("0")">Đơn bán</MudSelectItem>
                <MudSelectItem Value="@("1")">Đơn trả</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filterSalesType"
                       Label="Hình thức bán"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("10")">Tại chỗ</MudSelectItem>
                <MudSelectItem Value="@("30")">ShopeeFood</MudSelectItem>
                <MudSelectItem Value="@("21")">BeFood</MudSelectItem>
                <MudSelectItem Value="@("40")">Beamin</MudSelectItem>
                <MudSelectItem Value="@("50")">Gojek</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filterPartner"
                       Label="Đối tác"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@("-1")">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("APY")">AirPay</MudSelectItem>
                <MudSelectItem Value="@("WPH")">Dr.Win</MudSelectItem>
                <MudSelectItem Value="@("PNP")">Phano</MudSelectItem>
                <MudSelectItem Value="@("MBC")">MBC</MudSelectItem>
                <MudSelectItem Value="@("PLG")">Phúc Long</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudSelect @bind-Value="_filterVatCode"
                       Label="Thuế VAT"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@(string.Empty)">Tất cả</MudSelectItem>
                <MudSelectItem Value="@("4")">10%</MudSelectItem>
                <MudSelectItem Value="@("6")">8%</MudSelectItem>
                <MudSelectItem Value="@("5")">5%</MudSelectItem>
                <MudSelectItem Value="@("2")">0%</MudSelectItem>
                <MudSelectItem Value="@("1")">Non Tax</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_filterReturnOrder"
                          Label="Đơn hàng gốc"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Undo"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_filterUserId"
                          Label="Thu ngân / Nguồn"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Person"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Class="pos-btn-mockup pos-btn-primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@SearchAsync"
                           Disabled="@_loading"
                           FullWidth="true">Tìm</MudButton>
                <MudButton Class="pos-btn-mockup pos-btn-secondary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true">Xóa</MudButton>
            </MudStack>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ── Alerts ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudTable Class="pos-table" @ref="_table"
          ServerData="ServerReloadAsync"
          Hover="true" Striped="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Elevation="2"
          Loading="@_loading" LoadingProgressColor="Color.Primary"
          HorizontalScrollbar="true">
    <HeaderContent>
        <MudTh Style="width:100px">Ngày</MudTh>
        <MudTh Style="width:80px">Giờ</MudTh>
        <MudTh Style="width:120px">Số đơn</MudTh>
        <MudTh Style="width:60px">CH</MudTh>
        <MudTh Style="width:60px">POS</MudTh>
        <MudTh Style="width:80px">Thu ngân</MudTh>
        <MudTh Style="width:80px">Loại đơn</MudTh>
        <MudTh Style="width:80px">Barcode</MudTh>
        <MudTh Style="width:80px">Mã SP</MudTh>
        <MudTh Style="width:150px">Tên SP</MudTh>
        <MudTh Style="width:60px">ĐVT</MudTh>
        <MudTh Style="text-align:right; width:70px">SL</MudTh>
        <MudTh Style="text-align:right; width:80px">Đơn giá</MudTh>
        <MudTh Style="text-align:right; width:80px">Giảm giá</MudTh>
        <MudTh Style="width:50px">Thuế%</MudTh>
        <MudTh Style="text-align:right; width:80px">Thuế VND</MudTh>
        <MudTh Style="text-align:right; width:100px">Thành tiền</MudTh>
        <MudTh Style="width:100px">Hình thức bán</MudTh>
        <MudTh Style="width:80px">Đối tác</MudTh>
        <MudTh Style="width:80px">Khuyến mãi</MudTh>
        <MudTh Style="width:80px">Coupon</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Ngày">@context.OrderDateStr</MudTd>
        <MudTd DataLabel="Giờ" Style="text-align:center">@context.OrderTimeStr</MudTd>
        <MudTd DataLabel="Số đơn">@context.OrderNo</MudTd>
        <MudTd DataLabel="CH" Style="text-align:center">@context.StoreNo</MudTd>
        <MudTd DataLabel="POS" Style="text-align:center">@context.POSTerminalNo</MudTd>
        <MudTd DataLabel="Thu ngân">@context.CashierID</MudTd>
        <MudTd DataLabel="Loại đơn" Style="text-align:center">
            @{
                var (otCss, otLabel) = OrderTypeDisplay(context.OrderType);
            }
            <span class="pos-status-chip @otCss">@otLabel</span>
        </MudTd>
        <MudTd DataLabel="Barcode">@context.Barcode</MudTd>
        <MudTd DataLabel="Mã SP">@context.ItemNo</MudTd>
        <MudTd DataLabel="Tên SP">@context.Description</MudTd>
        <MudTd DataLabel="ĐVT" Style="text-align:center">@context.UnitOfMeasure</MudTd>
        <MudTd DataLabel="SL" Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
        <MudTd DataLabel="Đơn giá" Style="text-align:right">@context.UnitPrice.ToString("N0")</MudTd>
        <MudTd DataLabel="Giảm giá" Style="text-align:right; color:#F39C12">@context.DiscountAmount.ToString("N0")</MudTd>
        <MudTd DataLabel="Thuế%" Style="text-align:center">@context.VATCode</MudTd>
        <MudTd DataLabel="Thuế VND" Style="text-align:right">@context.VATAmount.ToString("N0")</MudTd>
        <MudTd DataLabel="Thành tiền" Style="text-align:right; font-weight:500">@context.LineAmountIncVAT.ToString("N0")</MudTd>
        <MudTd DataLabel="Hình thức bán">@context.SalesType</MudTd>
        <MudTd DataLabel="Đối tác">@context.PartnerStr</MudTd>
        <MudTd DataLabel="Khuyến mãi">@context.PromotionID</MudTd>
        <MudTd DataLabel="Coupon">@context.CouponCode</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Style="color:#9e9e9e">Không có dữ liệu. Hãy điều chỉnh bộ lọc và nhấn Tìm.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool _loading;
    private string? _errorMsg;
    private bool _isStoreOperator;

    private DateTime? _filterFromDateNullable = DateTime.Today;
    private DateTime? _filterToDateNullable = DateTime.Today;
    private string _filterStoreNo = string.Empty;
    private string _filterTextSearch = string.Empty;
    private string _filterOrderType = string.Empty;
    private string _filterSalesType = "-1";
    private string _filterPartner = "-1";
    private string _filterVatCode = string.Empty;
    private string _filterReturnOrder = string.Empty;
    private string _filterUserId = string.Empty;

    private MudTable<DetailRevenueSalesDto> _table = null!;
    private IReadOnlyList<string> _userStoreCodes = [];
    private List<StoreDto> _allStores = [];
    private StoreDto? _selectedStore;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
            _filterStoreNo = _userStoreCodes[0];

        try
        {
            _allStores = await MdRepo.GetStoreListAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("DetailRevenuePage.LoadStoreCodes", ex);
        }
        // MudTable tự gọi ServerReloadAsync lần đầu khi render — không cần load thủ công.
    }

    // Server-side paging: MudTable gọi callback này mỗi khi đổi trang / số dòng.
    private async Task<TableData<DetailRevenueSalesDto>> ServerReloadAsync(TableState state, CancellationToken token)
    {
        _loading = true;
        _errorMsg = null;
        try
        {
            var fromDate = (_filterFromDateNullable ?? DateTime.Today).Date;
            var toDate = (_filterToDateNullable ?? DateTime.Today).Date;
            if (fromDate > toDate) toDate = fromDate;

            var storeNo   = _isStoreOperator ? _filterStoreNo : (_selectedStore?.StoreNo ?? "");
            var orderType = string.IsNullOrEmpty(_filterOrderType) ? "" : _filterOrderType;
            var salesType = string.IsNullOrEmpty(_filterSalesType) ? "-1" : _filterSalesType;
            var partner   = string.IsNullOrEmpty(_filterPartner) ? "-1" : _filterPartner;

            var result = await RptSaleRepo.GetDetailRevenueSalesAsync(
                fromDate, toDate, storeNo, orderType, salesType,
                string.IsNullOrEmpty(_filterReturnOrder) ? "" : _filterReturnOrder,
                string.IsNullOrEmpty(_filterVatCode) ? "" : _filterVatCode,
                string.IsNullOrEmpty(_filterTextSearch) ? "" : _filterTextSearch,
                string.IsNullOrEmpty(_filterUserId) ? "" : _filterUserId,
                partner, state.PageSize, state.Page);

            var total = result.FirstOrDefault()?.Total ?? 0;

            FileLogger.WriteLogs($"[DetailRevenuePage.LoadData] {_filterStoreNo ?? "all"}: Loaded {result.Count} items [{fromDate:dd/MM/yyyy}-{toDate:dd/MM/yyyy}] page {state.Page}");

            return new TableData<DetailRevenueSalesDto> { Items = result, TotalItems = total };
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            FileLogger.WriteExpLogs("DetailRevenuePage.LoadData", ex);
            return new TableData<DetailRevenueSalesDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SearchAsync() => _table.ReloadServerData();

    private async Task ResetFilterAsync()
    {
        _filterFromDateNullable = DateTime.Today;
        _filterToDateNullable = DateTime.Today;
        _filterTextSearch = string.Empty;
        _filterOrderType = string.Empty;
        _filterSalesType = "-1";
        _filterPartner = "-1";
        _filterVatCode = string.Empty;
        _filterReturnOrder = string.Empty;
        _filterUserId = string.Empty;
        if (!_isStoreOperator) _selectedStore = null;
        await _table.ReloadServerData();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await _table.ReloadServerData();
    }

    private Task<IEnumerable<StoreDto>> SearchStoreAsync(string value, CancellationToken ct)
    {
        // Bound kết quả ≤ 50: tránh đẩy cả nghìn store vào component.
        // (MaxItems chỉ giới hạn HIỂN THỊ, không giới hạn dữ liệu SearchFunc xử lý.)
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<StoreDto>>(_allStores.Take(50));

        var v = value.Trim();
        var matches = _allStores
            .Where(s =>
                (s.StoreNo?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Name?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false))
            // Ưu tiên store có MÃ bắt đầu bằng từ khóa → gõ mã luôn nổi đầu, không bị Take(50) cắt
            .OrderByDescending(s => s.StoreNo?.StartsWith(v, StringComparison.OrdinalIgnoreCase) ?? false)
            .ThenBy(s => s.StoreNo, StringComparer.OrdinalIgnoreCase)
            .Take(50);

        return Task.FromResult<IEnumerable<StoreDto>>(matches);
    }

    private string StoreDisplayText => _allStores.FirstOrDefault(s => s.StoreNo == _filterStoreNo) is { } st
        ? $"{st.StoreNo} – {st.Name}"
        : _filterStoreNo;

    // CssClass là 1 trong 4 modifier .pos-status-{success,error,warning,info} (app.css) —
    // badge dạng dot-pill theo mockup docs/web/images/status.jpg (KHÔNG dùng MudChip, xem app.css).
    private static (string CssClass, string Label) OrderTypeDisplay(string? orderType)
    {
        var label = orderType?.Substring(0, Math.Min(6, orderType.Length)) ?? "-";
        var isReturn = orderType?.Contains("trả") ?? false;
        return (isReturn ? "pos-status-error" : "pos-status-success", label);
    }
}
