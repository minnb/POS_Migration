@page "/store/revenue-category"
@namespace POS.Web.Components.Pages.Store
@attribute [Authorize(Policy = WebPolicies.StoreAndAbove)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Common.Dtos.CentralMD
@using POS.Common.Dtos.RptCentralSale
@using POS.Infrastructure.Repositories.Interfaces
@using POS.Web.Auth
@using POS.Web.Services
@using POS.Web.Services.Pdf
@using POS.Infrastructure.Logging
@using System.Security.Claims

@inject IRptCentralSaleRepository RptSaleRepo
@inject ICentralMDRepository MdRepo
@inject IFileLogHelper FileLogger
@inject ISnackbar Snackbar
@inject IPdfExportService PdfExport
@inject IJSRuntime JS

<PageTitle>Doanh thu theo ngành hàng – POS Dashboard</PageTitle>

@* ── Page header ─────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Doanh thu theo ngành hàng
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.PictureAsPdf"
               OnClick="@OnExportPdfClick"
               Disabled="@(_loading || _isEmpty || _exporting)"
               Class="pos-page-header-btn">Xuất PDF</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3"/>
}

@* ── Filter Panel ────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            @if (_isStoreOperator)
            {
                <MudTextField Value="@StoreDisplayText"
                              Label="Mã CH/ST (*)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Store"/>
            }
            else
            {
                <MudAutocomplete T="StoreDto"
                                 @bind-Value="_selectedStore"
                                 Label="Mã CH/ST (*)"
                                 Placeholder="Tất cả"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchStoreAsync"
                                 ToStringFunc="@(s => s == null ? "" : $"{s.StoreNo} – {s.Name}")"
                                 Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.Store"
                                 Adornment="Adornment.Start"
                                 MinCharacters="0"
                                 MaxItems="50"/>
            }
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_filterFromDateNullable"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_filterToDateNullable"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"
                           AutoClose="true"/>
        </MudItem>

        <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync"
                           Disabled="@_loading"
                           FullWidth="true"
                           Style="align-self:center; white-space:nowrap">Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ResetFilterAsync"
                           Disabled="@_loading"
                           FullWidth="true"
                           Style="align-self:center; white-space:nowrap">Xóa</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── PDF Preview Overlay ─────────────────────────────────────────────── *@
@if (_showPdfPreview && _pdfBlobUrl != null)
{
    <div style="position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;background:#222;">
        <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:8px 16px;background:#1A2B45;color:white;flex-shrink:0;">
            <span style="font-size:0.9rem;font-weight:500;overflow:hidden;text-overflow:ellipsis;
                         white-space:nowrap;max-width:60%;">@_pdfFileName</span>
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Download"
                           Size="Size.Small"
                           OnClick="@OnDownloadPdfFromPreviewAsync">Tải xuống</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Style="color:white"
                               OnClick="@ClosePdfPreviewAsync"/>
            </MudStack>
        </div>
        <iframe src="@_pdfBlobUrl"
                style="flex:1;border:none;"
                title="Xem trước PDF"/>
    </div>
}

@* ── Alerts ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMsg</MudAlert>
}
else if (_isEmpty)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">Không có dữ liệu trong khoảng thời gian này.</MudAlert>
}

@* ── Report Content ───────────────────────────────────────────────────── *@
@if (!_isEmpty && _pivotRows.Any())
{
    <MudPaper Elevation="2" Class="mb-4 pa-4">

        @* ─ Report header: user info + timestamp ─ *@
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px; margin-bottom:12px; font-size:0.82rem; color:#555;">
            <div>
                <div>ID của người dùng: <strong>@_userId</strong></div>
                <div>Tên người dùng: <strong>@_userFullName</strong></div>
            </div>
            <div style="text-align:right;">
                Ngày giờ: <strong>@_printedAt</strong>
            </div>
        </div>

        <div style="text-align:center; margin-bottom:16px;">
            <div style="font-size:1.1rem; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;">
                Tổng hợp doanh thu theo ngành hàng
            </div>
        </div>

        <div style="font-size:0.84rem; margin-bottom:12px;">
            <div>
                Cửa hàng:
                <strong>
                    @if (!string.IsNullOrEmpty(_reportStoreNo))
                    { @($"{_reportStoreNo} – {_reportStoreName}") }
                    else
                    { @("Tất cả") }
                </strong>
            </div>
            <div>
                Ngày giao dịch:
                <strong>
                    @_reportFromDate.ToString("dd/MM/yyyy")
                    –
                    @_reportToDate.ToString("dd/MM/yyyy")
                </strong>
            </div>
        </div>

        @* ─ Pivot Table ─ *@
        <div style="overflow-x:auto;">
            <table class="pos-table rpt-pivot-table">
                <thead>
                    <tr>
                        <th style="width:48px; text-align:center;">STT</th>
                        <th style="min-width:200px;">Tên gian hàng</th>
                        <th style="min-width:110px; text-align:right;">
                            Số lượng/<br/>Số tiền
                        </th>
                        @foreach (var date in _dates)
                        {
                            <th style="min-width:90px; text-align:right;">
                                @date.ToString("dd/MM")<br/>
                                <span style="font-weight:400; font-size:0.78rem;">(@GetDow(date))</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var row in _pivotRows)
                    {
                        <tr>
                            <td style="text-align:center; vertical-align:top;">@(stt++)</td>
                            <td style="vertical-align:top;">
                                <div style="font-weight:600; font-size:0.88rem;">@row.MCHCode</div>
                                <div style="color:#1976D2; font-size:0.82rem;">@row.MCHName</div>
                            </td>
                            <td style="text-align:right; vertical-align:top; white-space:nowrap;">
                                <div>@row.TotalQty.ToString("N0")</div>
                                <div style="color:#1976D2; font-weight:500;">@row.TotalAmt.ToString("N0")</div>
                            </td>
                            @foreach (var date in _dates)
                            {
                                var cellQty = row.ByDate.TryGetValue(date, out var cv) ? cv.Item1 : 0;
                                var cellAmt = row.ByDate.TryGetValue(date, out var ca) ? ca.Item2 : 0.0;
                                <td style="text-align:right; vertical-align:top; white-space:nowrap;">
                                    <div>@(cellQty > 0 ? cellQty.ToString("N0") : "")</div>
                                    <div style="color:#1976D2;">@(cellAmt > 0 ? cellAmt.ToString("N0") : "")</div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="rpt-pivot-total">
                        <td colspan="2" style="text-align:center; font-weight:700;">Total</td>
                        <td style="text-align:right; white-space:nowrap;">
                            <div>@_totalQty.ToString("N0")</div>
                            <div>@_totalAmt.ToString("N0")</div>
                        </td>
                        @foreach (var date in _dates)
                        {
                            var qty = _pivotRows.Sum(r => r.ByDate.TryGetValue(date, out var v) ? v.Item1 : 0);
                            var amt = _pivotRows.Sum(r => r.ByDate.TryGetValue(date, out var va) ? va.Item2 : 0.0);
                            <td style="text-align:right; white-space:nowrap;">
                                <div>@(qty > 0 ? qty.ToString("N0") : "")</div>
                                <div>@(amt > 0 ? amt.ToString("N0") : "")</div>
                            </td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>

    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    // ── State ─────────────────────────────────────────────────────────────
    private bool    _loading = true;
    private string? _errorMsg;
    private bool    _isEmpty;
    private bool    _isStoreOperator;
    private bool    _exporting;

    // ── PDF preview ───────────────────────────────────────────────────────
    private string? _pdfBlobUrl;
    private string  _pdfFileName    = string.Empty;
    private bool    _showPdfPreview;

    // ── Filter values ──────────────────────────────────────────────────────
    private DateTime? _filterFromDateNullable = DateTime.Today.AddDays(-6);
    private DateTime? _filterToDateNullable   = DateTime.Today;
    private string    _filterStoreNo          = string.Empty;

    // ── Store autocomplete ─────────────────────────────────────────────────
    private IReadOnlyList<string> _userStoreCodes = [];
    private List<StoreDto>        _allStores      = [];
    private StoreDto?             _selectedStore;

    // ── Raw data ───────────────────────────────────────────────────────────
    private List<SalesByCategoryDto> _items = [];

    // ── Pivot model ────────────────────────────────────────────────────────
    private record PivotRow(
        string MCHCode,
        string MCHName,
        int    TotalQty,
        double TotalAmt,
        Dictionary<DateTime, (int Qty, double Amt)> ByDate);

    private List<DateTime>  _dates     = [];
    private List<PivotRow>  _pivotRows = [];
    private int             _totalQty;
    private double          _totalAmt;

    // ── Report header info ─────────────────────────────────────────────────
    private string _userId       = string.Empty;
    private string _userFullName = string.Empty;
    private string _printedAt    = string.Empty;

    // ── Resolved store for report header ──────────────────────────────────
    private string _reportStoreNo   = string.Empty;
    private string _reportStoreName = string.Empty;

    // ── Resolved range/timestamp chốt lúc load — nguồn sự thật cho header màn hình + PDF ──
    private DateTime _reportFromDate;
    private DateTime _reportToDate;
    private DateTime _reportPrintedAt;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Read claims
        var state = await AuthState;
        _userId       = state.User.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty;
        _userFullName = state.User.FindFirst("full_name")?.Value ?? string.Empty;

        var json = state.User.FindFirst("store_codes")?.Value;
        _userStoreCodes = string.IsNullOrEmpty(json)
            ? []
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(json) ?? [];

        _isStoreOperator = _userStoreCodes.Count > 0;

        if (_isStoreOperator)
            _filterStoreNo = _userStoreCodes[0];

        try
        {
            _allStores = await MdRepo.GetStoreListAsync();
        }
        catch (Exception ex)
        {
            FileLogger.WriteExpLogs("SalesByCategoryPage.LoadStoreCodes", ex);
        }

        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu.";
            FileLogger.WriteExpLogs("SalesByCategoryPage.OnInitialized", ex);
            _loading = false;
        }
    }

    // ── Load & Pivot ───────────────────────────────────────────────────────
    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _isEmpty  = false;
        StateHasChanged();

        try
        {
            var fromDate = (_filterFromDateNullable ?? DateTime.Today).Date;
            var toDate   = (_filterToDateNullable   ?? DateTime.Today).Date;
            if (fromDate > toDate) toDate = fromDate;

            var storeNo = _isStoreOperator ? _filterStoreNo : (_selectedStore?.StoreNo ?? "");

            var result = await RptSaleRepo.GetSalesByCategoryAsync(storeNo, fromDate, toDate);

            _items   = result ?? [];
            _isEmpty = _items.Count == 0;

            // Chốt range của lần load này — header màn hình + PDF dùng chung, không theo date-picker hiện tại
            _reportFromDate = fromDate;
            _reportToDate   = toDate;

            if (!_isEmpty)
            {
                BuildPivot(fromDate, toDate);
                _reportStoreNo   = storeNo;
                _reportStoreName = _allStores.FirstOrDefault(s => s.StoreNo == storeNo)?.Name ?? string.Empty;
                if (string.IsNullOrEmpty(_reportStoreNo))
                    _reportStoreName = string.Empty;
            }

            _reportPrintedAt = DateTime.Now;
            _printedAt = _reportPrintedAt.ToString("dd/MM/yyyy HH:mm:ss");

            FileLogger.WriteLogs($"[SalesByCategoryPage.LoadData] {(storeNo.Length > 0 ? storeNo : "all")}: Loaded {_items.Count} items [{fromDate:dd/MM/yyyy}-{toDate:dd/MM/yyyy}]");
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu. Vui lòng thử lại.";
            FileLogger.WriteExpLogs("SalesByCategoryPage.LoadData", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildPivot(DateTime fromDate, DateTime toDate)
    {
        // Collect all distinct dates in range
        _dates = _items
            .Select(x => x.BussinessDate.Date)
            .Distinct()
            .OrderBy(d => d)
            .ToList();

        // Group by MCHCode
        var groups = _items
            .GroupBy(x => new { x.MCHCode, x.MCHName })
            .OrderBy(g => g.Key.MCHCode)
            .ToList();

        _pivotRows = groups.Select(g =>
        {
            var byDate = g
                .GroupBy(x => x.BussinessDate.Date)
                .ToDictionary(
                    d => d.Key,
                    d => (Qty: d.Sum(x => x.OrderTotal), Amt: d.Sum(x => x.AmountTotal)));

            return new PivotRow(
                MCHCode:  g.Key.MCHCode,
                MCHName:  g.Key.MCHName,
                TotalQty: g.Sum(x => x.OrderTotal),
                TotalAmt: g.Sum(x => x.AmountTotal),
                ByDate:   byDate);
        }).ToList();

        _totalQty = _pivotRows.Sum(r => r.TotalQty);
        _totalAmt = _pivotRows.Sum(r => r.TotalAmt);
    }

    // ── Helpers ────────────────────────────────────────────────────────────
    private static string GetDow(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday    => "Mon",
        DayOfWeek.Tuesday   => "Tue",
        DayOfWeek.Wednesday => "Wed",
        DayOfWeek.Thursday  => "Thu",
        DayOfWeek.Friday    => "Fri",
        DayOfWeek.Saturday  => "Sat",
        DayOfWeek.Sunday    => "Sun",
        _ => ""
    };

    private const int MaxPdfDateColumns = 31;

    private async Task OnExportPdfClick()
    {
        if (_exporting) return;
        if (_isEmpty || _pivotRows.Count == 0) return;

        // PDF không đủ chỗ cho quá nhiều cột-ngày trên 1 khổ giấy → chặn sớm với thông báo rõ ràng
        if (_dates.Count > MaxPdfDateColumns)
        {
            Snackbar.Add($"Khoảng thời gian quá rộng (>{MaxPdfDateColumns} ngày) để xuất PDF. Vui lòng thu hẹp.", Severity.Warning);
            return;
        }

        _exporting = true;
        StateHasChanged();
        try
        {
            // Dùng đúng dữ liệu đang hiển thị (không query lại) → PDF khớp 100% form trên màn hình
            var header = new ReportHeaderModel
            {
                Title        = "Tổng hợp doanh thu theo ngành hàng",
                UserId       = _userId,
                UserFullName = _userFullName,
                PrintedAt    = _reportPrintedAt,
                StoreLabel   = string.IsNullOrEmpty(_reportStoreNo)
                    ? "Tất cả"
                    : $"{_reportStoreNo} – {_reportStoreName}",
                FromDate = _reportFromDate,
                ToDate   = _reportToDate
            };

            var data = new PivotReportData
            {
                Dates     = _dates,
                TotalQty  = _totalQty,
                TotalAmt  = _totalAmt,
                Rows      = _pivotRows.Select(r => new PivotReportRow(
                    r.MCHCode,
                    r.MCHName,
                    r.TotalQty,
                    r.TotalAmt,
                    r.ByDate.ToDictionary(
                        kv => kv.Key,
                        kv => ((long)kv.Value.Qty, kv.Value.Amt)))).ToList()
            };

            // Offload render native (SkiaSharp) khỏi Blazor circuit để không đứng UI
            var bytes    = await Task.Run(() => PdfExport.BuildPivotReport(header, data));
            var storePart = string.IsNullOrEmpty(_reportStoreNo) ? "All" : _reportStoreNo;
            var fileName  = $"DoanhThuNganhHang_{storePart}_{header.FromDate:yyyyMMdd}-{header.ToDate:yyyyMMdd}.pdf";

            _pdfBlobUrl     = await JS.CreatePdfBlobUrlAsync(bytes);
            _pdfFileName    = fileName;
            _showPdfPreview = true;

            FileLogger.WriteLogs($"[SalesByCategoryPage.ExportPdf] {(_reportStoreNo.Length > 0 ? _reportStoreNo : "all")}: Exported {_pivotRows.Count} rows, {_dates.Count} dates");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Không thể xuất PDF. Vui lòng thử lại.", Severity.Error);
            FileLogger.WriteExpLogs("SalesByCategoryPage.ExportPdf", ex);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private async Task ClosePdfPreviewAsync()
    {
        _showPdfPreview = false;
        await JS.RevokeBlobUrlAsync(_pdfBlobUrl);
        _pdfBlobUrl = null;
    }

    private async Task OnDownloadPdfFromPreviewAsync()
    {
        if (_pdfBlobUrl != null)
            await JS.DownloadFromBlobUrlAsync(_pdfBlobUrl, _pdfFileName);
    }

    private async Task ResetFilterAsync()
    {
        _filterFromDateNullable = DateTime.Today.AddDays(-6);
        _filterToDateNullable   = DateTime.Today;
        if (!_isStoreOperator) _selectedStore = null;
        await LoadDataAsync();
    }

    private Task<IEnumerable<StoreDto>> SearchStoreAsync(string value, CancellationToken ct)
    {
        // Bound kết quả ≤ 50: tránh đẩy cả nghìn store vào component.
        // (MaxItems chỉ giới hạn HIỂN THỊ, không giới hạn dữ liệu SearchFunc xử lý.)
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<StoreDto>>(_allStores.Take(50));

        var v = value.Trim();
        var matches = _allStores
            .Where(s =>
                (s.StoreNo?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Name?.Contains(v, StringComparison.OrdinalIgnoreCase) ?? false))
            // Ưu tiên store có MÃ bắt đầu bằng từ khóa → gõ mã luôn nổi đầu, không bị Take(50) cắt
            .OrderByDescending(s => s.StoreNo?.StartsWith(v, StringComparison.OrdinalIgnoreCase) ?? false)
            .ThenBy(s => s.StoreNo, StringComparer.OrdinalIgnoreCase)
            .Take(50);

        return Task.FromResult<IEnumerable<StoreDto>>(matches);
    }

    private string StoreDisplayText => _allStores.FirstOrDefault(s => s.StoreNo == _filterStoreNo) is { } st
        ? $"{st.StoreNo} – {st.Name}"
        : (_filterStoreNo ?? "");
}
