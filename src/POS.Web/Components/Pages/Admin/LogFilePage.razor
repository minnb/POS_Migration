@page "/admin/logs"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Web.Services

@inject ILogFileService LogFileService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Nhật ký hệ thống – POS Dashboard</PageTitle>

<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Nhật ký hệ thống
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               Class="pos-page-header-btn pos-btn-mockup" OnClick="RefreshAsync">
        Làm mới
    </MudButton>
</div>

@if (!string.IsNullOrEmpty(_errorMsg))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.LockPerson">
        @_errorMsg
    </MudAlert>
}

<MudText Typo="Typo.caption" Class="d-block mb-3" Style="color:var(--mud-palette-text-secondary)">
    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Class="mr-1" Style="vertical-align:middle"/>
    Thư mục gốc đang quét: <b>@LogFileService.RootDirectory</b>
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-2">
            @if (_treeLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
            }
            else if (_rootItems.Count == 0)
            {
                <MudText Class="pa-2" Style="color:var(--mud-palette-text-secondary)">Không có thư mục log nào.</MudText>
            }
            else
            {
                @* KHÔNG dùng ExpandOnClick: click thân node = chọn (load file panel phải),
                   caret = expand/collapse. ExpandOnClick khiến click bị nuốt thành expand → không select. *@
                <MudTreeView T="string" Items="_rootItems" ServerData="LoadTreeItemsAsync"
                             SelectedValue="_selectedPath" SelectedValueChanged="OnSelectedValueChangedAsync"
                             SelectionMode="SelectionMode.SingleSelection"
                             Hover="true" Dense="true"/>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9">
        <MudTable Items="@_files" Hover="true" Striped="true" Dense="true"
                  Breakpoint="Breakpoint.Sm" Elevation="2" Loading="@_filesLoading"
                  HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.FileName)">Tên file</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.SizeBytes)">Dung lượng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.LastModifiedUtc)">Lần cuối sửa</MudTableSortLabel></MudTh>
                <MudTh>Hành động</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tên file">@context.FileName</MudTd>
                <MudTd DataLabel="Dung lượng">@FormatSize(context.SizeBytes)</MudTd>
                <MudTd DataLabel="Lần cuối sửa">@context.LastModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="Hành động">
                    <MudTooltip Text="Tải file log">
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => DownloadAsync(context))"/>
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">@NoFilesText</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                               InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                               RowsPerPageString="Số dòng mỗi trang:"/>
            </PagerContent>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private List<TreeItemData<string>> _rootItems = [];
    private string _selectedPath = "";
    private IReadOnlyList<LogFileInfo> _files = [];
    private string? _errorMsg;
    private bool _treeLoading = true;
    private bool _filesLoading = true;
    private readonly CancellationTokenSource _cts = new();

    private string NoFilesText =>
        string.IsNullOrEmpty(_selectedPath)
            ? "Thư mục gốc không chứa file log trực tiếp — hãy chọn một thư mục con ở cây bên trái để xem file log."
            : "Thư mục này không có file log nào.";

    protected override async Task OnInitializedAsync()
    {
        await LoadTreeRootAsync();
        await LoadFilesAsync("");
    }

    private async Task LoadTreeRootAsync()
    {
        _treeLoading = true;
        try
        {
            var listing = await LogFileService.GetDirectoryListingAsync("", _cts.Token);
            _rootItems = listing.Folders.Select(MapToTreeItem).ToList();
            if (listing.ErrorMessage is not null)
                _errorMsg = listing.ErrorMessage;
        }
        catch (OperationCanceledException) { /* circuit đang dispose */ }
        finally { _treeLoading = false; }
    }

    private async Task<IReadOnlyCollection<TreeItemData<string>>> LoadTreeItemsAsync(string parentPath)
    {
        try
        {
            var listing = await LogFileService.GetDirectoryListingAsync(parentPath, _cts.Token);
            if (listing.ErrorMessage is not null)
            {
                _errorMsg = listing.ErrorMessage;
                StateHasChanged();
            }
            return listing.Folders.Select(MapToTreeItem).ToList();
        }
        catch (OperationCanceledException)
        {
            return [];
        }
    }

    private static TreeItemData<string> MapToTreeItem(LogFolderInfo folder) => new()
    {
        Text = folder.Name,
        Value = folder.RelativePath,
        Icon = Icons.Material.Filled.Folder,
        Expandable = folder.HasSubfolders
    };

    private async Task OnSelectedValueChangedAsync(string value)
    {
        _selectedPath = value;
        await LoadFilesAsync(value);
    }

    private async Task LoadFilesAsync(string relativePath)
    {
        _filesLoading = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            var listing = await LogFileService.GetDirectoryListingAsync(relativePath, _cts.Token);
            _files = listing.Files;
            _errorMsg = listing.ErrorMessage;
        }
        catch (OperationCanceledException) { /* circuit đang dispose */ }
        finally
        {
            _filesLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await LoadTreeRootAsync();
        await LoadFilesAsync(_selectedPath);
    }

    private async Task DownloadAsync(LogFileInfo file)
    {
        try
        {
            var result = await LogFileService.DownloadLogFileAsync(file.RelativePath, _cts.Token);
            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? "Không thể tải file.", Severity.Error);
                return;
            }
            // Streaming thật (FileStream) — dispose ngay sau khi JS interop đọc xong toàn bộ nội dung.
            await using (result.Content)
            {
                await JS.SaveAsFileAsync(result.FileName!, result.Content!, "text/plain");
            }
        }
        catch (OperationCanceledException) { /* circuit đang dispose */ }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F1} MB"
    };

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
