@page "/admin/logs"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Web.Services

@inject ILogFileService LogFileService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Nhật ký hệ thống – POS Dashboard</PageTitle>

<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Nhật ký hệ thống
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               Class="pos-page-header-btn pos-btn-mockup" OnClick="RefreshAsync">
        Làm mới
    </MudButton>
</div>

@if (!string.IsNullOrEmpty(_errorMsg))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.LockPerson">
        @_errorMsg
    </MudAlert>
}

<MudText Typo="Typo.caption" Class="d-block mb-3" Style="color:var(--mud-palette-text-secondary)">
    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Class="mr-1" Style="vertical-align:middle"/>
    Thư mục gốc đang quét: <b>@LogFileService.RootDirectory</b>
</MudText>

@* Breadcrumb thủ công bằng MudLink — MudBreadcrumbs thiết kế cho Href/URL navigation thật,
   không hợp để chỉ đổi state nội bộ trong cùng 1 trang. *@
<MudPaper Elevation="1" Class="pa-3 mb-4 d-flex align-center flex-wrap gap-1">
    <MudLink OnClick="NavigateToRootAsync" Style="cursor:pointer">
        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Class="mr-1" Style="vertical-align:middle"/>
        Gốc
    </MudLink>
    @for (var i = 0; i < BreadcrumbSegments.Count; i++)
    {
        var idx = i; // capture đúng biến vòng lặp cho closure OnClick bên dưới
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="vertical-align:middle"/>
        <MudLink OnClick="@(() => NavigateToBreadcrumbAsync(idx))" Style="cursor:pointer">
            @BreadcrumbSegments[idx]
        </MudLink>
    }
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"/>
}
else
{
    @if (_folders.Count > 0)
    {
        <MudList T="string" Clickable="true" Class="mb-4">
            @foreach (var folder in _folders)
            {
                <MudListItem T="string" @key="folder.RelativePath"
                             Icon="@Icons.Material.Filled.Folder"
                             OnClick="@(() => NavigateToFolderAsync(folder))">
                    @folder.Name
                </MudListItem>
            }
        </MudList>
    }

    <MudTable Items="@_files" Hover="true" Striped="true" Dense="true"
              Breakpoint="Breakpoint.Sm" Elevation="2"
              HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.FileName)">Tên file</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.SizeBytes)">Dung lượng</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.LastModifiedUtc)">Lần cuối sửa</MudTableSortLabel></MudTh>
            <MudTh>Hành động</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tên file">@context.FileName</MudTd>
            <MudTd DataLabel="Dung lượng">@FormatSize(context.SizeBytes)</MudTd>
            <MudTd DataLabel="Lần cuối sửa">@context.LastModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="Hành động">
                <MudTooltip Text="Tải file log">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => DownloadAsync(context))"/>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-4">Thư mục này không có file log nào.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                           InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                           RowsPerPageString="Số dòng mỗi trang:"/>
        </PagerContent>
    </MudTable>
}

@code {
    private string _currentPath = ""; // relative path, "" = gốc
    private IReadOnlyList<LogFolderInfo> _folders = [];
    private IReadOnlyList<LogFileInfo> _files = [];
    private string? _errorMsg;
    private bool _loading = true;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<string> BreadcrumbSegments =>
        string.IsNullOrEmpty(_currentPath) ? [] : _currentPath.Split('/');

    protected override async Task OnInitializedAsync() => await LoadAsync("");

    private async Task LoadAsync(string path)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await LogFileService.GetDirectoryListingAsync(path, _cts.Token);
            _currentPath = result.CurrentRelativePath;
            _folders = result.Folders;
            _files = result.Files;
            _errorMsg = result.ErrorMessage;
        }
        catch (OperationCanceledException) { /* circuit đang dispose */ }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task NavigateToFolderAsync(LogFolderInfo folder) => LoadAsync(folder.RelativePath);

    private Task NavigateToBreadcrumbAsync(int index)
    {
        var segments = BreadcrumbSegments;
        var path = string.Join('/', segments.Take(index + 1));
        return LoadAsync(path);
    }

    private Task NavigateToRootAsync() => LoadAsync("");

    private Task RefreshAsync() => LoadAsync(_currentPath);

    private async Task DownloadAsync(LogFileInfo file)
    {
        try
        {
            var result = await LogFileService.DownloadLogFileAsync(file.RelativePath, _cts.Token);
            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? "Không thể tải file.", Severity.Error);
                return;
            }
            // Streaming thật (FileStream) — dispose ngay sau khi JS interop đọc xong toàn bộ nội dung.
            await using (result.Content)
            {
                await JS.SaveAsFileAsync(result.FileName!, result.Content!, "text/plain");
            }
        }
        catch (OperationCanceledException) { /* circuit đang dispose */ }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F1} MB"
    };

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
