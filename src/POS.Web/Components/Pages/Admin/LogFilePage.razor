@page "/admin/logs"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Web.Services

@inject ILogFileService LogFileService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Nhật ký hệ thống – POS Dashboard</PageTitle>

<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Nhật ký hệ thống
    </MudText>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               Class="pos-page-header-btn" OnClick="LoadFilesAsync">
        Làm mới
    </MudButton>
</div>

<MudTable Items="@_files" Hover="true" Striped="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Elevation="2" Loading="@_loading"
          HorizontalScrollbar="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.FolderName)">Thư mục</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.FileName)">Tên file</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.SizeBytes)">Dung lượng</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.LastModifiedUtc)">Lần cuối sửa</MudTableSortLabel></MudTh>
        <MudTh>Hành động</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Thư mục">@context.FolderName</MudTd>
        <MudTd DataLabel="Tên file">@context.FileName</MudTd>
        <MudTd DataLabel="Dung lượng">@FormatSize(context.SizeBytes)</MudTd>
        <MudTd DataLabel="Lần cuối sửa">@context.LastModifiedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
        <MudTd DataLabel="Hành động">
            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                           OnClick="@(() => DownloadAsync(context))"/>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Align="Align.Center" Class="pa-4">Không có file log nào.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    private IReadOnlyList<LogFileInfo> _files = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadFilesAsync();

    private async Task LoadFilesAsync()
    {
        _loading = true;
        _files = await LogFileService.GetLogFilesAsync();
        _loading = false;
    }

    private async Task DownloadAsync(LogFileInfo file)
    {
        var result = await LogFileService.DownloadLogFileAsync(file.RelativePath);
        if (result is null)
        {
            Snackbar.Add("Không thể tải file (không tồn tại hoặc không hợp lệ).", Severity.Error);
            return;
        }
        await JS.SaveAsFileAsync(result.Value.FileName, result.Value.Bytes, "text/plain");
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F1} MB"
    };
}
