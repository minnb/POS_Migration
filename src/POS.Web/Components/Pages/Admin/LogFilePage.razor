@page "/admin/logs"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Web.Services

@inject ILogFileService LogFileService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Nhật ký hệ thống – POS Dashboard</PageTitle>

<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Nhật ký hệ thống
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               Class="pos-page-header-btn pos-btn-mockup" OnClick="RefreshAsync">
        Làm mới
    </MudButton>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-2">
            @if (_treeLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
            }
            else if (_rootItems.Count == 0)
            {
                <MudText Class="pa-2" Style="color:var(--mud-palette-text-secondary)">Không có thư mục log nào.</MudText>
            }
            else
            {
                <MudTreeView T="string" Items="_rootItems" ServerData="LoadTreeItemsAsync"
                             SelectedValue="_selectedPath" SelectedValueChanged="OnSelectedValueChangedAsync"
                             SelectionMode="SelectionMode.SingleSelection"
                             Hover="true" Dense="true" ExpandOnClick="true"/>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9">
        <MudTable Items="@_files" Hover="true" Striped="true" Dense="true"
                  Breakpoint="Breakpoint.Sm" Elevation="2" Loading="@_filesLoading"
                  HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.FileName)">Tên file</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.SizeBytes)">Dung lượng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<LogFileInfo, object>(x => x.LastModifiedUtc)">Lần cuối sửa</MudTableSortLabel></MudTh>
                <MudTh>Hành động</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tên file">@context.FileName</MudTd>
                <MudTd DataLabel="Dung lượng">@FormatSize(context.SizeBytes)</MudTd>
                <MudTd DataLabel="Lần cuối sửa">@context.LastModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="Hành động">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                   OnClick="@(() => DownloadAsync(context))"/>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">Thư mục này không có file log nào.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                               InfoFormat="{first_item}–{last_item} / {all_items} dòng"
                               RowsPerPageString="Số dòng mỗi trang:"/>
            </PagerContent>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private List<TreeItemData<string>> _rootItems = [];
    private string _selectedPath = "";
    private IReadOnlyList<LogFileInfo> _files = [];
    private bool _treeLoading = true;
    private bool _filesLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTreeRootAsync();
        await LoadFilesAsync("");
    }

    private async Task LoadTreeRootAsync()
    {
        _treeLoading = true;
        var roots = await LogFileService.GetSubfoldersAsync("");
        _rootItems = roots.Select(MapToTreeItem).ToList();
        _treeLoading = false;
    }

    private async Task<IReadOnlyCollection<TreeItemData<string>>> LoadTreeItemsAsync(string parentPath)
    {
        var children = await LogFileService.GetSubfoldersAsync(parentPath);
        return children.Select(MapToTreeItem).ToList();
    }

    private static TreeItemData<string> MapToTreeItem(LogFolderInfo folder) => new()
    {
        Text = folder.Name,
        Value = folder.RelativePath,
        Icon = Icons.Material.Filled.Folder,
        Expandable = true
    };

    private async Task OnSelectedValueChangedAsync(string value)
    {
        _selectedPath = value;
        await LoadFilesAsync(value);
    }

    private async Task LoadFilesAsync(string relativePath)
    {
        _filesLoading = true;
        StateHasChanged();
        var listing = await LogFileService.GetDirectoryListingAsync(relativePath);
        _files = listing.Files;
        _filesLoading = false;
    }

    private async Task RefreshAsync()
    {
        await LoadTreeRootAsync();
        await LoadFilesAsync(_selectedPath);
    }

    private async Task DownloadAsync(LogFileInfo file)
    {
        var result = await LogFileService.DownloadLogFileAsync(file.RelativePath);
        if (result is null)
        {
            Snackbar.Add("Không thể tải file (không tồn tại hoặc không hợp lệ).", Severity.Error);
            return;
        }
        await JS.SaveAsFileAsync(result.Value.FileName, result.Value.Bytes, "text/plain");
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F1} MB"
    };
}
