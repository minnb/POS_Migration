@page "/admin/users"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Infrastructure.Logging

@inject IWebUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IKibanaService KibanaService

<PageTitle>Quản lý người dùng – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" Style="border-radius:4px"/>
}

@* ── Header ─────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" Style="vertical-align:middle"/>
        Quản lý người dùng
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenDialogAsync(null))"
               Class="pos-page-header-btn">
        Thêm người dùng
    </MudButton>
</div>

@* ── Error ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMsg</MudAlert>
}

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudTable Items="@FilteredUsers"
          Hover="true" Striped="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Elevation="2"
          Loading="@_loading" LoadingProgressColor="Color.Primary"
          HorizontalScrollbar="true">
    <ToolBarContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (FilteredUsers.Count() != _users.Count)
            {
                @($"Hiển thị {FilteredUsers.Count()} / {_users.Count} người dùng")
            }
            else
            {
                @($"Tổng: {_users.Count} người dùng")
            }
        </MudText>
        <MudSpacer/>
        <MudTextField @bind-Value="_searchField"
                      Placeholder="Tìm kiếm..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-0"
                      Immediate="true"
                      Style="flex:0 1 240px; min-width:160px"/>
    </ToolBarContent>
    <HeaderContent>
        <MudTh Style="text-align:center; width:60px"><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Id)">ID</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Username)">Tên đăng nhập</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.FullName)">Họ và tên</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Role)">Vai trò</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.IsActive)">Trạng thái</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right; width:100px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID" Style="text-align:center">@context.Id</MudTd>
        <MudTd DataLabel="Tên đăng nhập">@context.Username</MudTd>
        <MudTd DataLabel="Họ và tên">@context.FullName</MudTd>
        <MudTd DataLabel="Vai trò" Style="text-align:center">
            @{
                var (rColor, rLabel) = RoleDisplay(context.Role);
            }
            <MudChip T="string" Color="@rColor" Size="Size.Small" Variant="Variant.Filled">@rLabel</MudChip>
        </MudTd>
        <MudTd DataLabel="Trạng thái" Style="text-align:center">
            @if (context.IsActive)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled"
                         Icon="@Icons.Material.Filled.CheckCircle">Hoạt động</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Block">Tạm khóa</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="" Style="text-align:right">
            <MudTooltip Text="Sửa">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenDialogAsync(context))"/>
            </MudTooltip>
            <MudTooltip Text="Khóa tài khoản">
                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                               Disabled="@(!context.IsActive)"
                               OnClick="@(() => ConfirmDeleteAsync(context))"/>
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Style="color:#9e9e9e">Không có dữ liệu.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                       InfoFormat="{first_item}–{last_item} / {all_items} người dùng"
                       RowsPerPageString="Số dòng mỗi trang:"/>
    </PagerContent>
</MudTable>

@code {
    private bool    _loading = true;
    private string? _errorMsg;
    private string  _searchField = string.Empty;
    private List<DashboardUser> _users = [];

    // Search filter applied to MudTable source; sort handled by MudTableSortLabel.
    private IEnumerable<DashboardUser> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchField)
            ? _users
            : _users.Where(u =>
                u.Username.Contains(_searchField, StringComparison.OrdinalIgnoreCase)
                || u.FullName.Contains(_searchField, StringComparison.OrdinalIgnoreCase)
                || u.Role.Contains(_searchField, StringComparison.OrdinalIgnoreCase));

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        try
        {
            var result = await UserService.GetAllAsync();
            _users = [.. result];
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách người dùng.";
            KibanaService.LogException("UsersPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Dialog handlers ──────────────────────────────────────────────────────

    private async Task OpenDialogAsync(DashboardUser? user)
    {
        var parameters = new DialogParameters<UserFormDialog>
        {
            { x => x.ExistingUser, user }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Small,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<UserFormDialog>(
            user is null ? "Thêm người dùng" : "Sửa người dùng",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(user is null ? "Tạo người dùng thành công!" : "Cập nhật thành công!",
                Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task ConfirmDeleteAsync(DashboardUser user)
    {
        var parameters = new DialogParameters
        {
            ["Message"]    = $"Bạn có chắc muốn khóa tài khoản \"{user.Username}\" ({user.FullName})?",
            ["YesText"]    = "Khóa",
            ["CancelText"] = "Hủy"
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Xác nhận khóa tài khoản", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null or { Canceled: true }) return;

        var ok = await UserService.DeleteAsync(user.Id);
        if (ok)
        {
            Snackbar.Add($"Đã khóa tài khoản {user.Username}.", Severity.Info);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add("Khóa tài khoản thất bại. Vui lòng thử lại.", Severity.Error);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static (Color Color, string Label) RoleDisplay(string role) => role switch
    {
        WebRoles.SystemAdmin   => (Color.Error,   "System Admin"),
        WebRoles.ITOps         => (Color.Warning,  "IT Ops"),
        WebRoles.StoreOperator => (Color.Primary,  "Cửa hàng"),
        _                      => (Color.Default,  role)
    };
}
