@page "/admin/users"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@inherits PosTableBase<DashboardUser>

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Web.Components.Shared
@using POS.Infrastructure.Logging

@inject IWebUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IKibanaService KibanaService

<PageTitle>Quản lý người dùng – POS Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" Style="border-radius:4px"/>
}

@* ── Header ─────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" Style="vertical-align:middle"/>
        Quản lý người dùng
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenDialogAsync(null))"
               Class="pos-page-header-btn">
        Thêm người dùng
    </MudButton>
</div>

@* ── Error ──────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMsg</MudAlert>
}

@* ── Table ───────────────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Style="overflow-x:auto">

    @* Toolbar: count + search *@
    <div class="d-flex justify-space-between align-center px-3 py-2 flex-wrap gap-2">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (TotalFiltered != _users.Count)
            {
                @($"Hiển thị {TotalFiltered} / {_users.Count} người dùng")
            }
            else
            {
                @($"Tổng: {_users.Count} người dùng")
            }
        </MudText>
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudTextField @bind-Value="SearchText"
                          Placeholder="Tìm kiếm..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mt-0"
                          Immediate="true"
                          Style="flex:1; min-width:160px"/>
            @if (PageCount > 1)
            {
                <MudPagination @bind-Selected="_page"
                               Count="@PageCount"
                               BoundaryCount="1"
                               MiddleCount="3"
                               ShowFirstButton="true"
                               ShowLastButton="true"
                               Color="Color.Primary"
                               Size="Size.Small"/>
            }
        </div>
    </div>

    <div class="pos-table-wrap">
        <table class="pos-table">
            <thead>
                <tr>
                    <th style="text-align:center; width:60px" @onclick='() => SortBy("Id")'>
                        ID<span class="pos-sort @(_sortCol=="Id"?"on":"")">@SI("Id")</span>
                    </th>
                    <th @onclick='() => SortBy("Username")'>
                        Tên đăng nhập<span class="pos-sort @(_sortCol=="Username"?"on":"")">@SI("Username")</span>
                    </th>
                    <th @onclick='() => SortBy("FullName")'>
                        Họ và tên<span class="pos-sort @(_sortCol=="FullName"?"on":"")">@SI("FullName")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("Role")'>
                        Vai trò<span class="pos-sort @(_sortCol=="Role"?"on":"")">@SI("Role")</span>
                    </th>
                    <th style="text-align:center" @onclick='() => SortBy("IsActive")'>
                        Trạng thái<span class="pos-sort @(_sortCol=="IsActive"?"on":"")">@SI("IsActive")</span>
                    </th>
                    <th style="text-align:right; width:100px"></th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:28px">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                        </td>
                    </tr>
                }
                else if (!PagedItems.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:28px; color:#9e9e9e">
                            Không có dữ liệu.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in PagedItems)
                    {
                        <tr>
                            <td style="text-align:center">@u.Id</td>
                            <td>@u.Username</td>
                            <td>@u.FullName</td>
                            <td style="text-align:center">
                                @{
                                    var (rColor, rLabel) = RoleDisplay(u.Role);
                                }
                                <MudChip T="string" Color="@rColor" Size="Size.Small" Variant="Variant.Filled">
                                    @rLabel
                                </MudChip>
                            </td>
                            <td style="text-align:center">
                                @if (u.IsActive)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.CheckCircle">
                                        Hoạt động
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Filled.Block">
                                        Tạm khóa
                                    </MudChip>
                                }
                            </td>
                            <td style="text-align:right">
                                <MudTooltip Text="Sửa">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenDialogAsync(u))"/>
                                </MudTooltip>
                                <MudTooltip Text="Khóa tài khoản">
                                    <MudIconButton Icon="@Icons.Material.Filled.Block"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   Disabled="@(!u.IsActive)"
                                                   OnClick="@(() => ConfirmDeleteAsync(u))"/>
                                </MudTooltip>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Pagination dưới *@
    @if (PageCount > 1)
    {
        <div class="d-flex justify-end px-3 py-2">
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="3"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        </div>
    }

</MudPaper>

@code {
    private bool    _loading = true;
    private string? _errorMsg;
    private string  _searchField = string.Empty;
    private List<DashboardUser> _users = [];

    private string SearchText
    {
        get => _searchField;
        set { _searchField = value; _page = 1; }
    }

    // ── PosTableBase<T> implementation ──────────────────────────────────────

    protected override IEnumerable<DashboardUser> SortedFiltered
    {
        get
        {
            var filtered = string.IsNullOrWhiteSpace(_searchField)
                ? (IEnumerable<DashboardUser>)_users
                : _users.Where(u =>
                    u.Username.Contains(_searchField, StringComparison.OrdinalIgnoreCase)
                    || u.FullName.Contains(_searchField, StringComparison.OrdinalIgnoreCase)
                    || u.Role.Contains(_searchField, StringComparison.OrdinalIgnoreCase));

            return _sortCol switch
            {
                "Username" => _sortAsc ? filtered.OrderBy(u => u.Username) : filtered.OrderByDescending(u => u.Username),
                "FullName" => _sortAsc ? filtered.OrderBy(u => u.FullName) : filtered.OrderByDescending(u => u.FullName),
                "Role"     => _sortAsc ? filtered.OrderBy(u => u.Role)     : filtered.OrderByDescending(u => u.Role),
                "IsActive" => _sortAsc ? filtered.OrderBy(u => u.IsActive) : filtered.OrderByDescending(u => u.IsActive),
                _          => _sortAsc ? filtered.OrderBy(u => u.Id)       : filtered.OrderByDescending(u => u.Id),
            };
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        try
        {
            var result = await UserService.GetAllAsync();
            _users = [.. result];
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách người dùng.";
            KibanaService.LogException("UsersPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Dialog handlers ──────────────────────────────────────────────────────

    private async Task OpenDialogAsync(DashboardUser? user)
    {
        var parameters = new DialogParameters<UserFormDialog>
        {
            { x => x.ExistingUser, user }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Small,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<UserFormDialog>(
            user is null ? "Thêm người dùng" : "Sửa người dùng",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(user is null ? "Tạo người dùng thành công!" : "Cập nhật thành công!",
                Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task ConfirmDeleteAsync(DashboardUser user)
    {
        var parameters = new DialogParameters
        {
            ["Message"]    = $"Bạn có chắc muốn khóa tài khoản \"{user.Username}\" ({user.FullName})?",
            ["YesText"]    = "Khóa",
            ["CancelText"] = "Hủy"
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Xác nhận khóa tài khoản", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null or { Canceled: true }) return;

        var ok = await UserService.DeleteAsync(user.Id);
        if (ok)
        {
            Snackbar.Add($"Đã khóa tài khoản {user.Username}.", Severity.Info);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add("Khóa tài khoản thất bại. Vui lòng thử lại.", Severity.Error);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static (Color Color, string Label) RoleDisplay(string role) => role switch
    {
        WebRoles.SystemAdmin   => (Color.Error,   "System Admin"),
        WebRoles.ITOps         => (Color.Warning,  "IT Ops"),
        WebRoles.StoreOperator => (Color.Primary,  "Cửa hàng"),
        _                      => (Color.Default,  role)
    };
}
