@page "/admin/users"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Infrastructure.Logging
@using Newtonsoft.Json

@inject IWebUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IFileLogHelper FileLogger
@inject IAuditLogger AuditLogger

<PageTitle>Quản lý người dùng – POS Dashboard</PageTitle>

<MudMessageBox @ref="_confirmBox" Title="@_confirmTitle" CancelText="Hủy">
    <MessageContent>@_confirmMsg</MessageContent>
    <YesButton>
        <MudButton Class="@($"pos-btn-mockup {(_confirmYesColor == Color.Success ? "pos-btn-primary" : "pos-btn-secondary")}")">@_confirmYesText</MudButton>
    </YesButton>
</MudMessageBox>

@* ── Header ─────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title" Style="font-weight:400">
        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Class="mr-2" Style="vertical-align:middle"/>
        Quản lý người dùng
    </MudText>
    <MudButton Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Lock"
               OnClick="@OpenChangePinDialogAsync"
               Class="pos-page-header-btn pos-btn-primary">
        Đổi mã PIN
    </MudButton>
    <MudButton Size="Size.Small"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenDialogAsync(null))"
               Class="pos-page-header-btn pos-btn-mockup pos-btn-primary">
        Thêm người dùng
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"/>
}

@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMsg</MudAlert>
}
else
{
    @* ── KPI Row ─────────────────────────────────────────────────────── *@
    <div class="d-flex flex-wrap gap-3 mb-4">
        <div style="flex:1 1 160px">
            <MudPaper Class="pos-filter-panel pa-4 pos-kpi-card-icon" Style="border-left:4px solid var(--mud-palette-primary)">
                <div>
                    <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Tổng tài khoản</MudText>
                    <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Primary">@_users.Count</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Group" Class="pos-kpi-icon" Style="color:var(--mud-palette-primary)"/>
            </MudPaper>
        </div>
        <div style="flex:1 1 160px">
            <MudPaper Class="pos-filter-panel pa-4 pos-kpi-card-icon" Style="border-left:4px solid var(--mud-palette-success)">
                <div>
                    <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Đang hoạt động</MudText>
                    <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Success">@_users.Count(u => u.IsActive)</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="pos-kpi-icon" Style="color:var(--mud-palette-success)"/>
            </MudPaper>
        </div>
        <div style="flex:1 1 160px">
            <MudPaper Class="pos-filter-panel pa-4 pos-kpi-card-icon" Style="border-left:4px solid var(--mud-palette-error)">
                <div>
                    <MudText Typo="Typo.body2" Class="pos-kpi-label" Color="Color.Secondary">Tạm khóa</MudText>
                    <MudText Typo="Typo.h5" Class="pos-kpi-value" Color="Color.Error">@_users.Count(u => !u.IsActive)</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Block" Class="pos-kpi-icon" Style="color:var(--mud-palette-error)"/>
            </MudPaper>
        </div>
    </div>

    @* ── Filter Panel ─────────────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pos-filter-panel pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_filterSearch"
                              Label="Tìm theo tên / username"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <MudSelect @bind-Value="_filterRole"
                           Label="Vai trò"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@string.Empty">Tất cả vai trò</MudSelectItem>
                    <MudSelectItem Value="@WebRoles.StoreOperator">Cửa hàng</MudSelectItem>
                    <MudSelectItem Value="@WebRoles.BackOffice">BackOffice / Vận hành nghiệp vụ</MudSelectItem>
                    <MudSelectItem Value="@WebRoles.ITOps">IT Ops</MudSelectItem>
                    <MudSelectItem Value="@WebRoles.SystemAdmin">System Admin</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <MudSelect @bind-Value="_filterStatus"
                           Label="Trạng thái"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="-1">Tất cả trạng thái</MudSelectItem>
                    <MudSelectItem Value="1">Đang hoạt động</MudSelectItem>
                    <MudSelectItem Value="0">Tạm khóa</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
                <MudStack Row="true" Spacing="1" Class="w-100">
                    <MudButton Class="pos-btn-mockup pos-btn-primary"
                               FullWidth="true" OnClick="ApplyFilter">Tìm</MudButton>
                    <MudButton Class="pos-btn-mockup pos-btn-secondary"
                               FullWidth="true" OnClick="ClearFilter">Xóa</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Table ───────────────────────────────────────────────────────────── *@
    <MudTable Class="pos-table" Items="@_filteredUsers"
              Hover="true" Striped="true" Dense="true"
              Breakpoint="Breakpoint.Sm" Elevation="2"
              Loading="@_loading" LoadingProgressColor="Color.Primary"
              HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh Style="text-align:center; width:60px">
                <MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Id)">Id</MudTableSortLabel>
            </MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Username)">Username</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.FullName)">Họ tên</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:center">
                <MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.Role)">Vai trò</MudTableSortLabel>
            </MudTh>
            <MudTh Style="text-align:center">
                <MudTableSortLabel SortBy="new Func<DashboardUser, object>(x => x.IsActive)">Trạng thái</MudTableSortLabel>
            </MudTh>
            <MudTh Style="text-align:right; width:100px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id" Style="text-align:center">@context.Id</MudTd>
            <MudTd DataLabel="Username">@context.Username</MudTd>
            <MudTd DataLabel="Họ tên">@context.FullName</MudTd>
            <MudTd DataLabel="Vai trò" Style="text-align:center">
                @{
                    var (rCss, rLabel) = RoleDisplay(context.Role);
                }
                <span class="pos-status-chip @rCss">@rLabel</span>
            </MudTd>
            <MudTd DataLabel="Trạng thái" Style="text-align:center">
                @{
                    var (sCss, sLabel) = ActiveStatusDisplay(context.IsActive);
                }
                <span class="pos-status-chip @sCss">@sLabel</span>
            </MudTd>
            <MudTd DataLabel="" Style="text-align:right">
                <MudTooltip Text="Sửa">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenDialogAsync(context))"/>
                </MudTooltip>
                @if (context.IsActive)
                {
                    <MudTooltip Text="Khóa tài khoản">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => ConfirmToggleAsync(context))"/>
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Kích hoạt lại">
                        <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => ConfirmToggleAsync(context))"/>
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4" Style="color:#9e9e9e">Không có dữ liệu.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }"
                           InfoFormat="{first_item}–{last_item} / {all_items} người dùng"
                           RowsPerPageString="Số dòng mỗi trang:"/>
        </PagerContent>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private string  _currentActor = "unknown";
    private bool    _loading      = true;
    private string? _errorMsg;
    private string  _filterSearch = string.Empty;
    private string  _filterRole   = string.Empty;
    private int     _filterStatus = -1;
    private List<DashboardUser> _users         = [];
    private List<DashboardUser> _filteredUsers = [];

    private MudMessageBox? _confirmBox;
    private string _confirmMsg       = string.Empty;
    private string _confirmTitle     = string.Empty;
    private string _confirmYesText   = string.Empty;
    private Color  _confirmYesColor  = Color.Primary;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _currentActor = state.User.Identity?.Name ?? "unknown";
        await LoadDataAsync();
    }

    // ── Data ─────────────────────────────────────────────────────────────────

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        try
        {
            var result = await UserService.GetAllAsync();
            _users = [.. result];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải danh sách người dùng.";
            FileLogger.WriteExpLogs("UsersPage.LoadData", ex);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Filter ───────────────────────────────────────────────────────────────

    private void ApplyFilter()
    {
        _filteredUsers = _users
            .Where(u => string.IsNullOrWhiteSpace(_filterSearch) ||
                        u.Username.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase) ||
                        u.FullName.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase))
            .Where(u => string.IsNullOrWhiteSpace(_filterRole) || u.Role == _filterRole)
            .Where(u => _filterStatus < 0 || (u.IsActive ? 1 : 0) == _filterStatus)
            .ToList();
    }

    private void ClearFilter()
    {
        _filterSearch = string.Empty;
        _filterRole   = string.Empty;
        _filterStatus = -1;
        _filteredUsers = [.. _users];
    }

    // ── Dialog handlers ──────────────────────────────────────────────────────

    private async Task OpenDialogAsync(DashboardUser? user)
    {
        var parameters = new DialogParameters<UserFormDialog>
        {
            { x => x.ExistingUser, user }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Small,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<UserFormDialog>(
            user is null ? "Thêm người dùng" : "Sửa người dùng",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is DashboardUser savedUser)
        {
            if (user is null)
            {
                await AuditLogger.LogAsync(_currentActor, "CREATE", "DashboardUser",
                    savedUser.Username,
                    null,
                    JsonConvert.SerializeObject(savedUser));
            }
            else
            {
                await AuditLogger.LogAsync(_currentActor, "UPDATE", "DashboardUser",
                    user.Username,
                    JsonConvert.SerializeObject(new { user.Id, user.Username, user.FullName, user.Role, user.StoreCodes, user.IsActive }),
                    JsonConvert.SerializeObject(savedUser));
            }
            Snackbar.Add(user is null ? "Tạo người dùng thành công!" : "Cập nhật thành công!",
                Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenChangePinDialogAsync()
    {
        var parameters = new DialogParameters<ChangeMyPinDialog>
        {
            { x => x.Username, _currentActor }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton      = true,
            MaxWidth         = MaxWidth.Small,
            FullWidth        = true,
            BackdropClick    = false
        };
        var dialog = await DialogService.ShowAsync<ChangeMyPinDialog>("Đổi mã PIN", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await AuditLogger.LogAsync(_currentActor, "CHANGE_PIN", "DashboardUser", _currentActor,
                null, JsonConvert.SerializeObject(new { Username = _currentActor, Note = "PIN đã được đổi bởi chính chủ" }));
            Snackbar.Add("Đổi mã PIN thành công!", Severity.Success);
        }
    }

    private async Task ConfirmToggleAsync(DashboardUser user)
    {
        var isLocking = user.IsActive;
        _confirmTitle    = isLocking ? "Xác nhận khóa tài khoản" : "Xác nhận kích hoạt";
        _confirmMsg      = isLocking
            ? $"Bạn có chắc muốn khóa tài khoản \"{user.Username}\" ({user.FullName})?"
            : $"Kích hoạt lại tài khoản \"{user.Username}\" ({user.FullName})?";
        _confirmYesText  = isLocking ? "Khóa" : "Kích hoạt";
        _confirmYesColor = isLocking ? Color.Error : Color.Success;

        var confirmed = await _confirmBox!.ShowAsync();
        if (confirmed != true) return;

        var ok = isLocking
            ? await UserService.DeleteAsync(user.Id)
            : await UserService.ActivateAsync(user.Id);

        if (ok)
        {
            await AuditLogger.LogAsync(_currentActor,
                isLocking ? "LOCK" : "UNLOCK",
                "DashboardUser",
                user.Username,
                JsonConvert.SerializeObject(new { user.Id, user.Username, user.FullName, user.IsActive }),
                JsonConvert.SerializeObject(new { user.Id, user.Username, user.FullName, IsActive = !user.IsActive }));
            Snackbar.Add(isLocking
                ? $"Đã khóa tài khoản {user.Username}."
                : $"Đã kích hoạt tài khoản {user.Username}.",
                Severity.Info);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(isLocking
                ? "Khóa tài khoản thất bại. Vui lòng thử lại."
                : "Kích hoạt tài khoản thất bại. Vui lòng thử lại.",
                Severity.Error);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    // CssClass là 1 trong 4 modifier .pos-status-{success,error,warning,info} (app.css) —
    // badge dạng dot-pill theo mockup docs/web/images/status.jpg (KHÔNG dùng MudChip, xem app.css).
    private static (string CssClass, string Label) RoleDisplay(string role) => role switch
    {
        WebRoles.SystemAdmin   => ("pos-status-error",   "System Admin"),
        WebRoles.ITOps         => ("pos-status-warning", "IT Ops"),
        WebRoles.BackOffice    => ("pos-status-info",    "BackOffice"),
        WebRoles.StoreOperator => ("pos-status-info",    "Cửa hàng"),
        _                      => ("pos-status-info",    role)
    };

    private static (string CssClass, string Label) ActiveStatusDisplay(bool isActive) =>
        isActive ? ("pos-status-success", "Hoạt động") : ("pos-status-info", "Tạm khóa");
}
