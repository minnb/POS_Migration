@page "/admin/encrypt-secret"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using POS.Web.Auth
@using POS.Infrastructure.Security

@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Mã hóa Secret – POS Dashboard</PageTitle>

@* ── Header ────────────────────────────────────────────────────────── *@
<div class="pos-page-header mb-4">
    <MudText Typo="Typo.h5" Class="pos-page-header-title">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Style="vertical-align:middle"/>
        Mã hóa Secret
    </MudText>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    Nhập secret plaintext → nhận chuỗi <strong>enc:...</strong> để dán vào <code>appsettings.*.json</code>
    (vd <code>Password=enc:...</code> trong connection string, hoặc RabbitMQ <code>Password</code>).
    Khóa lấy từ biến môi trường <strong>POS_SECRET_KEY</strong> — khóa này dùng chung cho cả POS.Web và
    POS.Api. Trang này <strong>chỉ mã hóa</strong>, không giải mã.
</MudAlert>

@if (!_hasKey)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Chưa cấu hình <strong>POS_SECRET_KEY</strong>. Bấm <strong>"Tạo khóa mới"</strong>, đặt vào
        <code>.env</code> (KHÔNG commit) rồi khởi động lại app trước khi mã hóa.
    </MudAlert>
}

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudTextField @bind-Value="_plain"
                          Label="Plaintext (secret cần mã hóa)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2"/>
        </MudItem>

        <MudItem xs="12" Class="d-flex">
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="DoEncrypt" Disabled="@(!_hasKey)">Mã hóa</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Key"
                           OnClick="DoGenerateKey">Tạo khóa mới</MudButton>
            </MudStack>
        </MudItem>

        @if (_result != null)
        {
            <MudItem xs="12">
                <MudTextField Value="@_result" T="string"
                              Label="Kết quả — dán vào appsettings"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              ReadOnly="true" Lines="3"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                              OnAdornmentClick="@(() => CopyAsync(_result!))"/>
            </MudItem>
        }

        @if (_newKey != null)
        {
            <MudItem xs="12">
                <MudTextField Value="@_newKey" T="string"
                              Label="Khóa mới — đặt vào .env: POS_SECRET_KEY=..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              ReadOnly="true" Lines="2"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                              OnAdornmentClick="@(() => CopyAsync(_newKey!))"/>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    private string? _plain;
    private string? _result;
    private string? _newKey;
    private bool    _hasKey;

    protected override void OnInitialized()
        => _hasKey = !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("POS_SECRET_KEY"));

    private void DoEncrypt()
    {
        var key = Environment.GetEnvironmentVariable("POS_SECRET_KEY");
        if (string.IsNullOrWhiteSpace(key)) { Snackbar.Add("Chưa có POS_SECRET_KEY.", Severity.Warning); return; }
        if (string.IsNullOrEmpty(_plain))   { Snackbar.Add("Nhập plaintext trước.", Severity.Warning); return; }
        try
        {
            _result = SecretProtector.Encrypt(_plain, key);
            Snackbar.Add("Đã mã hóa.", Severity.Success);
        }
        catch (Exception ex)
        {
            _result = null;
            Snackbar.Add($"Lỗi mã hóa: {ex.Message}", Severity.Error);
        }
    }

    private void DoGenerateKey()
    {
        _newKey = SecretProtector.GenerateKey();
        Snackbar.Add("Đã tạo khóa mới. Đặt vào .env và khởi động lại app.", Severity.Info);
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Đã copy.", Severity.Success);
        }
        catch
        {
            // navigator.clipboard chỉ có ở secure context (HTTPS/localhost) → fallback chọn tay.
            Snackbar.Add("Không copy tự động được (HTTP) — hãy bôi đen và copy thủ công.", Severity.Info);
        }
    }
}
