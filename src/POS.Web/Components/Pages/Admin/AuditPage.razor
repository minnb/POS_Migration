@page "/admin/audit"
@attribute [Authorize(Policy = WebPolicies.AdminOnly)]
@rendermode InteractiveServer

@using POS.Infrastructure.Database
@using POS.Infrastructure.Logging
@using Microsoft.Data.SqlClient

@inject CentralMDConnectionFactory DbFactory
@inject IKibanaService KibanaService

<PageTitle>Audit Log – POS Dashboard</PageTitle>

@* ── Header ────────────────────────────────────────────────────────── *@
<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Style="vertical-align:middle"/>
    Audit Log – SQL Console
</MudText>

@* ── Filter panel ──────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_fromDate"
                           Label="Từ ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_toDate"
                           Label="Đến ngày"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_filterActor"
                          Label="Actor (username)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"/>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" @bind-Value="_filterStatus"
                       Label="Trạng thái"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value='@("")'>Tất cả</MudSelectItem>
                <MudSelectItem Value="@("COMMITTED")">COMMITTED</MudSelectItem>
                <MudSelectItem Value="@("ROLLED_BACK")">ROLLED_BACK</MudSelectItem>
                <MudSelectItem Value="@("AUTO_ROLLBACK")">AUTO_ROLLBACK</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudStack Row="true" Spacing="1" Class="w-100">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@LoadDataAsync" FullWidth="true">
                    Tìm
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           OnClick="@ResetFilter" FullWidth="true">
                    Xóa
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Loading ───────────────────────────────────────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Style="border-radius:4px"/>
}

@* ── Error ─────────────────────────────────────────────────────────── *@
@if (_errorMsg != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMsg</MudAlert>
}

@* ── Table ─────────────────────────────────────────────────────────── *@
<MudPaper Elevation="2" Style="overflow-x:auto">

    @* Toolbar *@
    <div class="d-flex justify-space-between align-center px-3 py-2 flex-wrap gap-2">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (!_loading)
            {
                @($"Tổng: {_records.Count} bản ghi")
            }
        </MudText>
        @if (PageCount > 1)
        {
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="3"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        }
    </div>

    <div class="pos-table-wrap">
        <table class="pos-table">
            <thead>
                <tr>
                    <th style="width:60px; text-align:center">ID</th>
                    <th style="width:120px">Actor</th>
                    <th style="width:160px">Database</th>
                    <th style="width:130px; text-align:center">Trạng thái</th>
                    <th style="width:70px; text-align:right">Rows</th>
                    <th style="width:80px; text-align:center">WHERE</th>
                    <th>SQL</th>
                    <th style="width:80px; text-align:right">ms</th>
                    <th style="width:160px">Thời gian chạy</th>
                    <th style="width:160px">Quyết định lúc</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="10" style="text-align:center; padding:28px">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                        </td>
                    </tr>
                }
                else if (!PagedItems.Any())
                {
                    <tr>
                        <td colspan="10" style="text-align:center; padding:28px; color:#9e9e9e">
                            Không có dữ liệu.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in PagedItems)
                    {
                        <tr>
                            <td style="text-align:center">@r.Id</td>
                            <td>@r.Actor</td>
                            <td style="font-size:12px">@r.DbCatalog<br/><span style="color:#9e9e9e">@r.DbKey</span></td>
                            <td style="text-align:center">
                                @{
                                    var (sc, sl) = StatusDisplay(r.Status);
                                }
                                <MudChip T="string" Color="@sc" Size="Size.Small" Variant="Variant.Filled">
                                    @sl
                                </MudChip>
                            </td>
                            <td style="text-align:right">@r.RowsAffected</td>
                            <td style="text-align:center">
                                @if (r.HasWhere)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"/>
                                }
                                else
                                {
                                    <MudTooltip Text="Không có WHERE — đã ảnh hưởng toàn bộ bảng!">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small"/>
                                    </MudTooltip>
                                }
                            </td>
                            <td>
                                <MudTooltip Text="@r.SqlText" Placement="Placement.Bottom">
                                    <span style="font-family:monospace; font-size:12px; cursor:help">
                                        @(r.SqlText.Length > 160 ? r.SqlText[..160] + "…" : r.SqlText)
                                    </span>
                                </MudTooltip>
                            </td>
                            <td style="text-align:right">@r.ElapsedMs</td>
                            <td style="font-size:12px">@r.ExecutedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td style="font-size:12px">@r.DecidedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Pagination bottom *@
    @if (PageCount > 1)
    {
        <div class="d-flex justify-end px-3 py-2">
            <MudPagination @bind-Selected="_page"
                           Count="@PageCount"
                           BoundaryCount="1"
                           MiddleCount="3"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           Color="Color.Primary"
                           Size="Size.Small"/>
        </div>
    }

</MudPaper>

@code {
    private const int PageSize = 50;

    private sealed class AuditRecord
    {
        public long Id { get; init; }
        public string Actor { get; init; } = string.Empty;
        public string DbKey { get; init; } = string.Empty;
        public string DbCatalog { get; init; } = string.Empty;
        public string SqlText { get; init; } = string.Empty;
        public int RowsAffected { get; init; }
        public bool HasWhere { get; init; }
        public string Status { get; init; } = string.Empty;
        public long ElapsedMs { get; init; }
        public DateTime ExecutedAt { get; init; }
        public DateTime DecidedAt { get; init; }
    }

    private bool _loading;
    private string? _errorMsg;
    private List<AuditRecord> _records = [];
    private int _page = 1;

    private DateTime? _fromDate = DateTime.Today.AddDays(-7);
    private DateTime? _toDate   = DateTime.Today;
    private string _filterActor  = string.Empty;
    private string _filterStatus = string.Empty;

    private int PageCount => (int)Math.Ceiling(_records.Count / (double)PageSize);
    private IEnumerable<AuditRecord> PagedItems =>
        _records.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading  = true;
        _errorMsg = null;
        _page     = 1;
        try
        {
            var from = (_fromDate ?? DateTime.Today.AddDays(-7)).Date;
            var to   = (_toDate   ?? DateTime.Today).Date.AddDays(1);  // include full "to" day

            var whereClauses = new List<string>
            {
                "ExecutedAt >= @From",
                "ExecutedAt < @To"
            };
            if (!string.IsNullOrWhiteSpace(_filterActor))
                whereClauses.Add("Actor LIKE @Actor");
            if (!string.IsNullOrWhiteSpace(_filterStatus))
                whereClauses.Add("Status = @Status");

            var sql = $@"
                SELECT Id, Actor, DbKey, DbCatalog, SqlText,
                       RowsAffected, HasWhere, Status, ElapsedMs,
                       ExecutedAt, DecidedAt
                FROM SqlConsoleAuditLog (NOLOCK)
                WHERE {string.Join(" AND ", whereClauses)}
                ORDER BY ExecutedAt DESC";

            await using var conn = (SqlConnection)await DbFactory.CreateOpenConnectionAsync();
            await using var cmd = new SqlCommand(sql, conn) { CommandTimeout = 30 };
            cmd.Parameters.AddWithValue("@From", from);
            cmd.Parameters.AddWithValue("@To",   to);
            if (!string.IsNullOrWhiteSpace(_filterActor))
                cmd.Parameters.AddWithValue("@Actor", $"%{_filterActor}%");
            if (!string.IsNullOrWhiteSpace(_filterStatus))
                cmd.Parameters.AddWithValue("@Status", _filterStatus);

            await using var reader = await cmd.ExecuteReaderAsync();
            var list = new List<AuditRecord>();
            while (await reader.ReadAsync())
            {
                list.Add(new AuditRecord
                {
                    Id           = reader.GetInt64(0),
                    Actor        = reader.GetString(1),
                    DbKey        = reader.GetString(2),
                    DbCatalog    = reader.GetString(3),
                    SqlText      = reader.GetString(4),
                    RowsAffected = reader.GetInt32(5),
                    HasWhere     = reader.GetBoolean(6),
                    Status       = reader.GetString(7),
                    ElapsedMs    = reader.GetInt64(8),
                    ExecutedAt   = reader.GetDateTime(9),
                    DecidedAt    = reader.GetDateTime(10)
                });
            }
            _records = list;
        }
        catch (Exception ex)
        {
            _errorMsg = "Không thể tải dữ liệu audit log.";
            KibanaService.LogException("AuditPage.LoadData", "", 0, "", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilter()
    {
        _fromDate     = DateTime.Today.AddDays(-7);
        _toDate       = DateTime.Today;
        _filterActor  = string.Empty;
        _filterStatus = string.Empty;
        await LoadDataAsync();
    }

    private static (Color Color, string Label) StatusDisplay(string status) => status switch
    {
        "COMMITTED"     => (Color.Success, "COMMITTED"),
        "ROLLED_BACK"   => (Color.Info,    "ROLLED_BACK"),
        "AUTO_ROLLBACK" => (Color.Warning, "AUTO_ROLLBACK"),
        _               => (Color.Default, status)
    };
}
