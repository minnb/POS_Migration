    [Interface_Errors].[ErrorLine] AS [ErrorLine], 
    [Interface_Errors].[ErrorProcedure] AS [ErrorProcedure], 
    [Interface_Errors].[ErrorMessage] AS [ErrorMessage], 
    [Interface_Errors].[ErrorDateTime] AS [ErrorDateTime], 
    [Interface_Errors].[ProcessID] AS [ProcessID]
    FROM [dbo].[Interface_Errors] AS [Interface_Errors]</DefiningQuery>
