@using VCM.BLUEPOS.Model.Authen;

@{
    ViewBag.Title = "Nhóm quyền";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstMenu = ViewBag.ListMenu as List<MenuModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hệ thống</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Nhóm quyền</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btnAddRole"><i class="la la-cog"></i> Phân quyền</button>
        </div>

    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <input type="text" id="searchRoleCode" class="form-control" placeholder="Mã nhóm quyền" />
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <input type="text" id="searchRoleName" class="form-control" placeholder="Tên nhóm quyền" />
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">

                                <select id="slSearchActive" class="form-control select2">
                                    <option value="-">--------------</option>
                                    <option value="1">Active</option>
                                    <option value="0">Locked</option>
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <!--begin::Stats Widget 1-->
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <!--begin::Body-->
                    <div class="card-body">
                        <!--begin: Datatable-->
                        <table id="tblData" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>MÃ NHÓM QUYỀN</th>
                                    <th>TÊN NHÓM QUYỀN</th>
                                    <th>TRẠNG THÁI</th>
                                    <th>NGƯỜI TẠO</th>
                                    <th>NGÀY TẠO</th>
                                    <th>NGƯỜI CHỈNH SỬA</th>
                                    <th>NGÀY CHỈNH SỬA</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <!--end: Datatable-->
                    </div>
                    <!--end::Body-->
                </div>
                <!--end::Stats Widget 1-->
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalAddRole" tabindex="-1" role="dialog" aria-labelledby="exampleModalSizeXl" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Phân quyền menu</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label style="font-weight:bold">Tên nhóm quyền</label>
                            <input type="text" id="txtRoleName" class="form-control" placeholder="Nhập tên nhóm quyền" />
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label style="font-weight:bold">Trạng thái</label>
                            <select id="slStatus" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="1">Đang hoạt động</option>
                                <option value="0">Ngưng hoạt động</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-3" style="margin-top:27px;">
                        <button type="button" id="btnSave" class="btn btn-primary font-weight-bold">Cập nhật</button>
                    </div>
                </div>
                <div class="row">

                    <div class="col-sm-12">
                        @if (lstMenu != null && lstMenu.Count() > 0)
                        {
                            <div class="accordion accordion-toggle-arrow" id="accordionExample4">
                                @{var lst1 = lstMenu.Where(d => d.ParentMenu == 0).ToList();
                                    var stt = 1;
                                    foreach (var item in lst1)
                                    {
                                        var showContent = stt == 1 ? "show" : "";
                                        var stt2 = 1;
                                        var list2 = lstMenu.Where(d => d.ParentMenu == item.ID).ToList();
                                        <div class="card">
                                            <div class="card-header" id="headingOne4">
                                                <div class="card-title" data-toggle="collapse" data-target="#collapseOne_@stt">
                                                    <i class="flaticon2-layers-1"></i> @item.MenuName
                                                </div>
                                            </div>
                                            <div id="collapseOne_@stt" class="collapse @showContent" data-parent="#accordionExample4">
                                                <div class="card-body">
                                                    <table id="tblDataMenu" class="table table-bordered" style="width:100%;">
                                                        <tbody>
                                                            @{
                                                                foreach (var item2 in list2)
                                                                {
                                                                    var lst3 = lstMenu.Where(d => d.ParentMenu == item2.ID).ToList();
                                                                    if (lst3.Count == 0)
                                                                    {

                                                                        <tr>
                                                                            <td style="text-align:center;vertical-align:middle">@stt2</td>
                                                                            <td style="vertical-align:middle">@item2.MenuName</td>
                                                                            <td style="text-align:center;vertical-align:middle">
                                                                                <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                                                                    <label class="checkbox checkbox-lg">
                                                                                        <input type="checkbox" name="Menu" id="chkMenu_@item2.ID" value="@item2.ID" data-parentmenu="@item2.ParentMenu" />
                                                                                        <span></span>
                                                                                    </label>
                                                                                </div>
                                                                            </td>
                                                                        </tr>

                                                                    }
                                                                    else
                                                                    {
                                                                        <tr style="font-weight:bold;background-color:#c5d3de">
                                                                            <td style="text-align:center">@stt2</td>
                                                                            <td colspan="2">
                                                                                @item2.MenuName
                                                                            </td>
                                                                        </tr>
                                                                        if (lst3.Count > 0)
                                                                        {
                                                                            var stt3 = 1;
                                                                            foreach (var item3 in lst3)
                                                                            {
                                                                                <tr>
                                                                                    <td style="text-align:center;vertical-align:middle">@stt3</td>
                                                                                    <td style="vertical-align:middle">@item3.MenuName</td>
                                                                                    <td style="text-align:center;vertical-align:middle">

                                                                                        <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                                                                            <label class="checkbox checkbox-lg">
                                                                                                <input type="checkbox" name="Menu" id="chkMenu_@item3.ID" value="@item3.ID" data-parentmenu="@item3.ParentMenu" data-parentmenuc1="@item2.ParentMenu" />
                                                                                                <span></span>
                                                                                            </label>
                                                                                        </div>

                                                                                    </td>
                                                                                </tr>
                                                                                stt3++;
                                                                            }
                                                                        }
                                                                    }
                                                                    stt2++;
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        stt++;
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

            </div>
        </div>
    </div>
</div>

<div style="display:none">
    <input type="text" id="HiddenCode" class="form-control" value="" disabled />
</div>

@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {

            LoadData();

            $("#btnSearch").on("click", function (e) {
                //debugger
                table.search(this.value).draw();
            });

            $("#btnAddRole").on("click", function (e) {
                $('input[name="Menu"]').prop('checked', false);
                //$('#txtRoleName').prop('readonly', false);
                $('#txtRoleName').val('');
                $("#HiddenCode").val('');

                $('#modalAddRole').modal({
                    backdrop: 'static',
                    keyboard: false
                });
            });

            $("#btnSave").on("click", function (e) {
                SaveRole();
            });

        });

        function LoadData() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                responsive: true,
                processing: false,      // for show progress bar
                serverSide: true,       // for process server side
                filter: false,          // this is for disable filter (search box)
                orderMulti: false,      // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("LoadDataRole", "Role")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.RoleCode = $("#searchRoleCode").val();
                        d.RoleName = $("#searchRoleName").val();
                        d.Status = $("#slSearchActive").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {

                    $(row).attr('id', "rowRecord" + data.ID);
                },
                columns: [
                    {
                        data: 'RoleCode',
                        className: 'text-center'
                    },//0
                    { data: 'RoleName' },//1
                    {
                        data: 'Status',
                        render: function (data, type, full, meta) {
                            var html = "";

                            if (full.Status == 1) {
                                html ='<span class="label label-lg font-weight-bold label-success label-inline">Active</span>';
                            }
                            else {
                                html = '<span class="label label-lg font-weight-bold label-danger label-inline">Locked</span>';
                            }
                            return html;
                        },
                        className: 'text-center'
                    },//2
                    {
                        data: 'CreatedUser',
                        className: 'text-center'
                    },//3
                    {
                        data: 'CreatedDate',
                        render: function (data, type, full, meta) {
                            if (full.CreatedDate != null) {
                                return moment(full.CreatedDate).format("DD/MM/YYYY HH:mm");
                            }
                            Element
                            {
                                return "";
                            }
                        }
                    },//4
                    {
                        data: 'LastUpdateUser',
                        className: 'text-center'},//5
                    {
                        data: 'LastupdateDate',
                        render: function (data, type, full, meta) {
                            if (full.LastupdateDate != null) {
                                return moment(full.LastupdateDate).format("DD/MM/YYYY HH:mm");
                            }
                            else
                                return "";
                        }
                    },//6
                    {
                        data: "ID",
                        render: function (data, type, full, meta) {
                            var html = "";
                            html += "<a onclick=\"ModalUpdate('" + full.RoleCode + "',\'" + full.RoleName + "'\," + full.Status + ")\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\">";
                            html += "<i class=\"flaticon2-gear\"></i>";
                            html += "<span class=\"pulse-ring\"></span>";
                            html += "</a>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }

        function ModalUpdate(roleCode, roleName, status) {
            var enable = status == true ? 1 : 0;
            $("#HiddenCode").val(roleCode);
            $("#txtRoleName").val(roleName);
            $('#slStatus').prop('disabled', false);
            $("#slStatus").select2('val', [enable]);
            $('input[name="Menu"]').prop('checked', false);

            var fromData = new FormData();
            fromData.append('RoleCode', roleCode);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadMenuRole", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    debugger
                    if (data != null && data.length > 0) {
                        data.forEach((name, i) => {
                            $('#chkMenu_' + name.MenuID).prop('checked', true);
                        });
                    }

                },
                error: function () {
                }
            });

            $('#modalAddRole').modal({
                backdrop: 'static',
                keyboard: false
            });
        }
        function SaveRole() {
            var arrMenu = [];
            var roleCode = $("#HiddenCode").val();
            var roleName = $("#txtRoleName").val();
            var status = $("#slStatus").val();

            if (roleName == "" || roleName.length == 0) {
                toastr.error("Chưa nhập tên nhóm quyền");
                return;
            }

            $('input[name="Menu"]:checked').each(function () {
                debugger
                var parentMn = $(this).data('parentmenu');
                var parentMnC1 = $(this).data('parentmenuc1');
                arrMenu.push({ ID: this.value, ParentMenu: parentMn, ParentMenuC1: parentMnC1 });
            });

            var jsonMenu = JSON.stringify(arrMenu);

            loading.showloading();

            var fromData = new FormData();
            fromData.append('RoleCode', roleCode);
            fromData.append('RoleName', roleName);
            fromData.append('Status', status);
            fromData.append('ListMenu', jsonMenu);
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateRole", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data == true) {
                        toastr.success("Phân quyền thành công");
                        $('#modalAddRole').modal('hide');
                        table.draw();
                    }
                    loading.hideloading();
                },
                error: function () {
                }
            });
        }
    </script>
}

