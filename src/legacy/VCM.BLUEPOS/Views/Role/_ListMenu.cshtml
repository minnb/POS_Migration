@using VCM.BLUEPOS.Model.Authen
@{
    /**/

    var lstMenu = Model as List<MenuModel>;
}

@if (lstMenu != null && lstMenu.Count() > 0)
{
    <div class="accordion accordion-toggle-arrow" id="accordionExample4">
        @{var lst1 = lstMenu.Where(d => d.ParentMenu == 0).OrderBy(d=>d.Orderby).ToList();
            var stt = 1;
            foreach (var item in lst1)
            {
                var showContent = stt == 1 ? "show" : "";
                var stt2 = 1;
                var list2 = lstMenu.Where(d => d.ParentMenu == item.ID).OrderBy(d => d.Orderby).ToList();

                <div class="card">
                    <div class="card-header">
                        <div onclick="ModalUpdateMenu(1,@item.ID,'Insert')" style="float:left;padding: 1rem 0rem !important;">
                            <i class="la la-plus-circle font-size-h1 color-success" title="Thêm menu" style="color:#ff6a00"></i>
                        </div>

                        <div class="card-title" data-toggle="collapse" data-target="#collapseOne_@stt">
                            @item.MenuName
                        </div>
                    </div>

                    <div id="collapseOne_@stt" class="collapse" data-parent="#accordionExample4">
                        <div class="card-body">

                            <table id="tblDataMenu_@item.ID" class="table table-bordered" style="width:100%;padding-left:30px;">
                                <tbody>
                                    @{
                                        foreach (var item2 in list2)
                                        {
                                            var lst3 = lstMenu.Where(d => d.ParentMenu == item2.ID).OrderBy(d => d.Orderby).ToList();
                                            var trangthai = item2.Status.ToString().ToLower();
                                            if (lst3.Count == 0)
                                            {
                                                <tr id="trMenu_@item2.ID">
                                                    <td style="vertical-align:middle"><span id="updMenuName_@item2.ID">@item2.MenuName</span></td>
                                                    <td style="vertical-align:middle"><span id="updContrllerName_@item2.ID">@item2.Controller</span></td>
                                                    <td style="vertical-align:middle"><span id="updActionName_@item2.ID">@item2.Action</span></td>
                                                    <td style="text-align:center;vertical-align:middle">
                                                        <p id="updStatus_@item2.ID">
                                                            @if (item2.Status == true)
                                                            {
                                                                <span class="label label-lg font-weight-bold label-success label-inline">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="label label-lg font-weight-bold label-danger label-inline">Locked</span>
                                                            }
                                                        </p>
                                                    </td>
                                                    <td style="text-align:center;vertical-align:middle">
                                                        <a onclick="ModalUpdateMenu(2,@item2.ID,'Insert')" title="Thêm" class="btn btn-icon btn-light-primary"><i class="la la-plus-circle"></i><span class="pulse-ring"></span></a>
                                                        <a onclick="ModalUpdateMenu(2,@item2.ID,'Update')" title="Sửa" class="btn btn-icon btn-light-warning"><i class="la la-edit"></i><span class="pulse-ring"></span></a>
                                                        <a onclick="DeleteMenu(2,@item2.ID)" title="Xóa" class="btn btn-icon btn-light-danger"><i class="la la-close"></i><span class="pulse-ring"></span></a>

                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr id="trMenu_@item2.ID" style="font-weight:bold;background-color:#c5d3de">
                                                    <td colspan="3" style="vertical-align:middle">
                                                        <span id="updMenuName_@item2.ID">@item2.MenuName</span>
                                                    </td>

                                                    <td style="text-align:center;vertical-align:middle">
                                                        <p id="updStatus_@item2.ID">
                                                            @if (item2.Status == true)
                                                            {
                                                                <span class="label label-lg font-weight-bold label-success label-inline">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="label label-lg font-weight-bold label-danger label-inline">Locked</span>
                                                            }
                                                        </p>
                                                    </td>
                                                    <td id="" style="text-align:center;vertical-align:middle">
                                                        <a onclick="ModalUpdateMenu(2,@item2.ID,'Insert')" title="Thêm" class="btn btn-icon btn-light-primary"><i class="la la-plus-circle"></i><span class="pulse-ring"></span></a>
                                                        <a onclick="ModalUpdateMenu(2,@item2.ID,'Update')" title="Sửa" class="btn btn-icon btn-light-warning"><i class="la la-edit"></i><span class="pulse-ring"></span></a>
                                                        <a onclick="DeleteMenu(2,@item2.ID)" title="Xóa" class="btn btn-icon btn-light-danger"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                                    </td>
                                                </tr>

                                                if (lst3.Count > 0)
                                                {
                                                    var stt3 = 1;
                                                    foreach (var item3 in lst3)
                                                    {
                                                        <tr id="trMenu_@item3.ID" class="trMenu_@item2.ID">
                                                            <td style="vertical-align:middle"><span id="updMenuName_@item3.ID">@item3.MenuName</span></td>
                                                            <td style="vertical-align:middle"><span id="updContrllerName_@item3.ID">@item3.Controller</span></td>
                                                            <td style="vertical-align:middle"><span id="updActionName_@item3.ID">@item3.Action</span></td>
                                                            <td style="text-align:center;vertical-align:middle">
                                                                <p id="updStatus_@item3.ID">
                                                                    @if (item3.Status == true)
                                                                    {
                                                                        <span class="label label-lg font-weight-bold label-success label-inline">Active</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="label label-lg font-weight-bold label-danger label-inline">Locked</span>
                                                                    }
                                                                </p>
                                                            </td>
                                                            <td id="" style="text-align:center;vertical-align:middle">
                                                                <a onclick="ModalUpdateMenu(3,@item3.ID,'Update')" title="Sửa" class="btn btn-icon btn-light-warning"><i class="la la-edit"></i><span class="pulse-ring"></span></a>
                                                                <a onclick="DeleteMenu(3,@item3.ID)" title="Xóa" class="btn btn-icon btn-light-danger"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                                            </td>
                                                        </tr>
                                                        stt3++;
                                                    }
                                                }
                                            }
                                            stt2++;
                                        }
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
                stt++;
            }
        }
    </div>
}