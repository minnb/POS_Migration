@using VCM.BLUEPOS.Model.Authen;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Phân quyền người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstRole = ViewBag.ListRole as List<RoleModel>;
    var lstStore = ViewBag.ListStore as List<StorePartnerModel>;
}

<style>
    .dropdown-menu {
        border: 1px solid rgb(12, 113, 61);
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hệ thống</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Phân quyền người dùng</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btnAddPermUser"><i class="la la-cog"></i> Phân quyền user</button>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Loại login</label>
                                <div class="form-group">
                                    <select id="slTypeSearch" class="form-control select2 select2-blue changeEventSearch" data-placeholder="">
                                        <option value="-">Tất cả</option>
                                        <option value="AD">Tài khoản AD</option>
                                        <option value="LOCAL">Tài khoản LOCAL</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Nhóm quyền</label>
                                <div class="form-group">
                                    <select id="slNhomQuyenSearch" class="form-control select2 select2-blue changeEventSearch" data-placeholder="">
                                        <option value="-">Tất cả</option>
                                        @if (lstRole != null && lstRole.Count() > 0)
                                        {
                                            foreach (var item in lstRole)
                                            {
                                                <option value="@item.RoleCode">@item.RoleName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <input type="text" id="searchStoreNo" class="form-control changeEventSearch" placeholder="Mã CH/ST" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Từ khóa</label>
                                <div class="form-group">
                                    <input type="text" id="searchUsername" class="form-control changeEventSearch" placeholder="Tài khoản/Mã NV/Tên NV" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Trạng thái</label>
                                <div class="form-group">
                                    <select id="slSearchActive" class="form-control select2 changeEventSearch">
                                        <option value="-">Tất cả</option>
                                        <option value="1">Active</option>
                                        <option value="0">Locked</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tblData" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>LOẠI LOGIN</th>
                                    <th>MÃ NHÂN VIÊN</th>
                                    <th>TÊN NHÂN VIÊN</th>
                                    <th>TÀI KHOẢN</th>
                                    <th>NHÓM QUYỀN</th>
                                    <th>TRẠNG THÁI</th>
                                    <th>NGƯỜI CẬP NHẬT</th>
                                    <th>NGÀY CẬP NHẬT</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalAddPermUser" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Tạo quyền người dùng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Hình thức đăng nhập</label>
                            <select id="slType" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="AD">Tài khoản AD</option>
                                <option value="LOCAL">Tài khoản LOCAL</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Tài khoản</label>
                            <textarea id="txtUsernameLogin" rows="3" class="form-control" placeholder="Nhập danh sách tài khoản (cách nhau dấu chấm phẩy (;) hoặc dấu phẩy (,) hoặc khoảng trắng)">
                            </textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Trạng thái</label>
                            <select id="slStatus" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="1">Active</option>
                                <option value="0">Locked</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Nhóm quyền</label>
                            <select id="slNhomQuyen" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="-" selected>--- Chọn ---</option>
                                @if (lstRole != null && lstRole.Count() > 0)
                                {
                                    foreach (var item in lstRole)
                                    {
                                        <option value="@item.RoleCode">@item.RoleName</option>
                                    }
                                }                                
                            </select>
                        </div>
                    </div>

                    <!-- 30/06/2025: tungnt8 -->

                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <label class="req" style="font-size: 13px; font-weight: 700;font-family: Roboto,Arial,sans-serif;">Import Cửa hàng</label>
                        <div class="form-group">
                            <select class="form-control select2 required" style="width: 100%" id="auto-import-st" name="AutoImportST">
                                <option value="false" selected>Manual</option>
                                <option value="true">Auto</option>
                            </select>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="div-store-manual">
                        <div class="form-group">
                            <label class="req" style="font-weight:bold">Cửa hàng</label>
                            <select id="slStore" class="form-control" multiple="multiple">
                                @if (lstStore != null && lstStore.Count() > 0)
                                {
                                    foreach (var item in lstStore)
                                    {
                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                        <option value="@item.SiteNo">@storeName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12" id="div-store-auto" style="display: none;">
                        <label class="req" style="font-size: 13px; font-weight: 700;font-family: Roboto,Arial,sans-serif;">Danh sách cửa hàng</label>
                        <span id="badge-count-store" class="badge badge-info">0</span>
                        <textarea class="form-control" id="mutilCodeST" rows="10" placeholder="Nhập danh sách mã cửa hàng, và cách nhau bởi dấu phẩy (,). VD: 2001,2002,2003"></textarea>
                    </div>
                </div>
            </div>

            <input type="hidden" id="hdd-type-login-temp" name="TypeLogIn" />

            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"><i class="la la-save"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
            </div>
        </div>
    </div>
</div>


