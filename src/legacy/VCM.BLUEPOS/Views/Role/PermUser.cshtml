                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ModalStore('" + full.UserName + "')\"><i class=\"nav-icon la la-database\"></i><span class=\"nav-text\" style=\"color: #0c713d;\">Quyền xem CH</span></a></li>";

