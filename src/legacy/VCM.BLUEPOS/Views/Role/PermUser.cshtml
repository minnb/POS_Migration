@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {

            $('#slType').change(function () {
                //debugger
                var checkType = $('#slType').val();
                if (checkType == "LOCAL") {
                    $('#auto-import-st').prop('disabled', true);
                } else {
                    $('#auto-import-st').prop('disabled', false);
                }
            });

            $('#sel-update-type').change(function () {
                //debugger
                var checkType = $('#sel-update-type').val();
                if (checkType == "LOCAL") {
                    $('#update-auto-import-st').prop('disabled', true);
                } else {
                    $('#update-auto-import-st').prop('disabled', false);
                }
            });

            $('#slStore').fSelect({
                placeholder: 'Chọn cửa hàng',
                numDisplayed: 1,
                overflowText: '{n} Cửa hàng được chọn',
                searchText: 'Tìm kiếm....',
                noResultsText: 'Không tìm thấy cửa hàng',
                showSearch: true,
                optionFormatter: false,
                isSelectAll: true
            });

            $('#sel-update-store').fSelect({
                placeholder: 'Chọn cửa hàng',
                numDisplayed: 1,
                overflowText: '{n} Cửa hàng được chọn',
                searchText: 'Tìm kiếm....',
                noResultsText: 'Không tìm thấy cửa hàng',
                showSearch: true,
                optionFormatter: false,
                isSelectAll: true
            });

            LoadData();

            $("#btnSearch").on("click", function (e) {
                //debugger
                table.search(this.value).draw();
            });

            $(".changeEventSearch").on("change", function () {
                table.draw();
            });

            $('#auto-import-st').on('change', function () {
                if ($(this).val() == 'true') {
                    $('#div-store-manual').hide();
                    $('#auto-import-st').val('true');
                    $('#div-store-auto').show();
                }
                else {
                    $('#div-store-manual').show();
                    $('#auto-import-st').val('false');
                    $('#div-store-auto').hide();
                }
            });

            $('#update-auto-import-st').on('change', function () {
                //debugger
                if ($(this).val() == 'true') {
                    $('#div-store-manual-update').hide();
                    $('#div-store-auto-update').show();
                    GetStoreByUser();
                }
                else
                {
                    $('#div-store-manual-update').show();
                    $('#div-store-auto-update').hide();
                }
            });

            $('#slType').on('change', function () {
                //R0007 : SM_Phúc Long
                if ($(this).val() == 'LOCAL') {
                    $('#slNhomQuyen').val('R0007').trigger('change');
                }
                else {
                    $('#slNhomQuyen').val('-').trigger('change');
                }
            });

            $("#btnAddPermUser").on("click", function (e) {
                //debugger
                $("#HiddenCode").val('');
                $("#txtUsernameLogin").val('');
                $("#txtUsernameLogin").prop("disabled", false);
                $("#slStatus").select2('val', [1]);
                $("#slType").select2('val', ['AD']);
                DisplayInfoStaff();
                $('.fs-option').removeClass('selected');
                $('.fs-label').html('Chọn cửa hàng');
                $('#modalAddPermUser').modal({
                    backdrop: 'static',
                    keyboard: false
                });
            });

            $("#slType").on("change", function () {
                DisplayInfoStaff();
            });

            $("#btnSave").on("click", function (e) {
                //SaveQuyen();
                SaveQuyenV2();
            });

            $("#sel-update-type").on("change", function () {
                DisplayInfoStaff();
            });

            $("#btn-update-save").on("click", function (e) {
                UpdateQuyenV2();
            });

        });

        function DisplayInfoStaff() {
            if ($("#slType").val() == "AD") {
                $("#displayInfoStaff").css("display", "none");
            }
            else {
                $("#displayInfoStaff").css("display", "-webkit-box");
            }
        }

        function LoadData() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("LoadDataPermission", "Role")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.UserName = $("#searchUsername").val();
                        d.StoreNo = $("#searchStoreNo").val();
                        d.Status = $("#slSearchActive").val();
                        d.LoginType = $("#slTypeSearch").val();
                        d.RoleCode = $("#slNhomQuyenSearch").val();
                    }
                },

                columns: [
                    {
                        data: "TypeLogin",
                        className: 'text-center'
                    },
                    {
                        data: "StaffCode",
                        className: 'text-center'
                    },
                    {
                        data: "FullName"
                    },
                    {
                        data: "UserName",
                        className: 'text-center'
                    },
                    {
                        data: "RoleName",
                        render: function (data, type, row) {
