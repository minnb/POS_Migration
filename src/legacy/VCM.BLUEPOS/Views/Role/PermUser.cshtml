        function SaveQuyenV2() {
            //debugger
            var mutilCodeStore = $('#mutilCodeST').val().trim();
            var isAutoImportStore = false;
            if ($('#auto-import-st').val() == "true") {
                isAutoImportStore = true;
            }
            var storeNo = $('#slStore').val() == "" ? "" : JSON.stringify($('#slStore').val());
            var listStore = "";
            var userName = $("#txtUsernameLogin").val();
            var roleCode = $("#slNhomQuyen").val();
            var status = $("#slStatus").val();
            var typeLogin = $("#slType").val();
            var isAllStore = $('.fs-label-wrap').attr('data-selectall');
            
            if (typeLogin == "LOCAL") {
                if (isAutoImportStore == false) {
                    if (storeNo != null) {
                        var countStore = storeNo.split(',').filter(element => element).length;
                        if (countStore > 1) {
                            toastr.error("Loại tài khoản (LOCAL) chỉ được chọn 01 mã cửa hàng để phân quyền");
                            return;
                        }
                    }
                }
                else
                {
                    if (mutilCodeStore != null) {
                        var countStore = mutilCodeStore.length; // VD: 2001;2002
                        if (countStore > 4) {
                            toastr.error("Loại tài khoản (LOCAL) chỉ được chọn 01 mã cửa hàng để phân quyền");
                            return;
                        }
                    }
                }                
            }

            if (userName == "") {
                toastr.error("Vui lòng nhập tài khoản");
                return;
            }

            if (status == "" || status == null) {
                toastr.error("Vui lòng chọn trạng thái");
                return;
            }
            else {
                if (status == "1") {
                    status = true;
                }
                else
                    status = false;
            }

            if (roleCode == "-" || roleCode.length == 0) {
                toastr.error("Vui lòng chọn nhóm quyền");
                return;
            }
            else {
                if (typeLogin =="LOCAL" && roleCode != "R0007") {
                    toastr.error("Tài khoản LOCAL chỉ được chọn nhóm quyền SM_Phúc Long. Vui lòng kiểm tra lại");
                    return;
                }
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('TypeLogin', typeLogin);
            fromData.append('UserName', userName);
            fromData.append('RoleCode', roleCode);
            fromData.append('IsActive', status);
            fromData.append('StoreNo', storeNo);
