                            </select>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="div-store-manual-update">
                        <div class="form-group">
                            <label class="req" style="font-weight:bold">Cửa hàng</label>
                            <select id="sel-update-store" class="form-control" multiple="multiple">
                                @if (lstStore != null && lstStore.Count() > 0)
                                {
                                    foreach (var item in lstStore)
                                    {
                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                        <option value="@item.SiteNo">@storeName</option>
                                    }
