                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PosTerminal",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PosTerminal == null || row.PosTerminal == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.PosTerminal + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsActive",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsActive == true) {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                            }
                            else {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsMobile",  // Giao diện màn hình
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsMobile == true) {
                                html += '<span style="display:block;font-weight:400;">'+ "Mobile" +'</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">'+ "POS" +'</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CreatedBy",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CreatedBy == null || row.CreatedBy == "") {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + row.CreatedBy + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CreatedDate",
                        className: 'text-center',
                        render: function (data, type, full, meta) {
                            if (full.UpdatedDate != null)
                            {
                                return moment(full.UpdatedDate).format("DD/MM/YYYY HH:mm");
                            }
                            else
                            {
                                if (full.CreatedDate != null)
                                {
                                    return moment(full.CreatedDate).format("DD/MM/YYYY HH:mm");
                                }
                                else
                                {
                                    return "";
                                }
                            }
                        }
                    },

                    {
                        data: "UserName",
                        className: 'text-center',
                        render: function (data, type, full, meta) {
                            var typeLogin = full.TypeLogin;
                            var userName = full.UserName;
                            var html = "";
                            html += "<a href=\"javascript:;\" class=\"btn btn-icon btn-light-warning pulse pulse-warning btn-update-perm-user-pos-web\" style=\"cursor:pointer\" id=\"btn-update-perm-user-pos-web\" data-type-login= '" + full.TypeLogin + "'  data-user-name= '" + full.UserName + "' data-store-no= '" + full.StoreNo + "' data-posterminal= '" + full.PosTerminal + "' data-is-mobile= '" + full.IsMobile + "' >";
                                html += "<i class=\"flaticon2-gear\"></i>";
                                html += "</a>";
                                html += "<a href=\"javascript:;\" class=\"btn btn-icon btn-light-danger btn-delete-perm-user-pos-web\" style=\"cursor:pointer;margin-left: 5px;\" id=\"btn-delete-perm-user-pos-web\" data-type-login= '" + full.TypeLogin + "'  data-user-name= '" + full.UserName + "' data-store-no= '" + full.StoreNo + "' data-posterminal= '" + full.PosTerminal + "'>";
                                html += "<i class=\"la la-close\"></i>";
                                html += "</a>";
                            return html;
                        }
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function SaveQuyen() {
            //debugger
            var storeNo = $('#sel-store-no').val() == "" ? "" : JSON.stringify($('#sel-store-no').val());
            var posTerminal = $('#sel-pos-terminal').val();
            var listStore = "";
            var roleCode = $("#slNhomQuyen").val();
            var status = $("#slStatus").val();
            var typeLogin = $("#slType").val();
            var isMobile = $("#sel-is-mobile").val();

            var userName = "";
            if (typeLogin == "AD")
            {
                userName = $("#txt-user-name-login").val();
            }
            else
            {
                userName = $("#txt-staff-code-login").val();
            }

            if (userName == "") {
                toastr.error("Chưa nhập tài khoản/mã nhân viên");
                return;
            }

            if (posTerminal == "" || posTerminal.length == 0) {
                toastr.error("Chưa chọn máy POS bán hàng");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('TypeLogin', typeLogin);
            fromData.append('UserName', userName);
            fromData.append('Status', status);
            fromData.append('StoreNo', storeNo);
            fromData.append('PosTerminal', posTerminal);
            fromData.append('RoleCode', roleCode);
            fromData.append('IsMobile', isMobile);

            $.ajax({
                type: "POST",
                url: '@Url.Action("CreatePermUserByPOSWeb", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                        table.draw();
                        $('#modal-add-perm-user-pos-web').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function UpdatePermUserByPOSWeb () {
            //debugger
            var typeLogin = $('#sl-update-type-login').val();
