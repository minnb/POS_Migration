
@using VCM.BLUEPOS.Model.Authen;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Phân quyền user POS Web";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstRole = ViewBag.ListRole as List<RoleModel>;
    var lstStore = ViewBag.ListStore as List<StorePartnerModel>;

}

<style>
    .dropdown-menu {
        border: 1px solid rgb(12, 113, 61);
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a><span style="color:#0C713D;">Hệ thống</span></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a><span style="color:#0C713D;">Phân quyền user POSWeb</span></a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btn-add-perm-user-pos-web"><i class="la la-plus"></i> Thêm mới</button>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-weight:600">Loại login</label>
                                <div class="form-group">
                                    <select id="slTypeSearch" class="form-control select2 select2-blue changeEventSearch" data-placeholder="">
                                        <option value="-">Tất cả</option>
                                        <option value="AD">Tài khoản AD</option>
                                        <option value="LOCAL">Tài khoản LOCAL</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-weight:600">ST/CH</label>
                                <div class="form-group">
                                    <input type="text" id="searchStoreNo" class="form-control changeEventSearch" placeholder="Nhập mã ST/CH..." />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-weight:600">Từ khóa</label>
                                <div class="form-group">
                                    <input type="text" id="searchUsername" class="form-control changeEventSearch" placeholder="Nhập tài khoản/mã nhân viên/tên nhân viên..." />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-weight:600">Trạng thái</label>
                                <div class="form-group">
                                    <select id="slSearchActive" class="form-control select2 changeEventSearch">
                                        <option value="-">Tất cả</option>
                                        <option value="1">Active</option>
                                        <option value="0">Locked</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-permission-role-pos-web" class="table table-bordered table-hover">
                            <thead style="text-transform:uppercase;">
                                <tr class="text-center">
                                    <th>Loại login</th>
                                    <th>Tài khoản login</th>
                                    <th>Mật khẩu</th>
                                    <th>Mã nhân viên</th>
                                    <th>Tên nhân viên</th>
                                    <th>ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Trạng thái</th>
                                    <th>Giao diện màn hình</th>
                                    <th>Người cập nhật</th>
                                    <th>Ngày cập nhật</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modal-add-perm-user-pos-web" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Tạo mới phân quyền user POSWEB</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:400">Hình thức đăng nhập <strong style="color:#ff0000"> (*)</strong></label>
                            <select id="slType" class="form-control select2" data-placeholder="">
                                <option value="AD" selected>Tài khoản AD</option>
                                <option value="LOCAL">Tài khoản LOCAL</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label id="lbl-user-name-login" style="font-weight:400">Tài khoản nhân viên (AD) <strong style="color:#ff0000"> (*)</strong></label>
                            <textarea id="txt-user-name-login" rows="6" class="form-control" placeholder="Nhập danh sách cách nhau dấu ; hoặc dấu , hoặc khoảng trắng"></textarea>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label id="lbl-staff-code-login" style="font-weight:400">Mã nhân viên <strong style="color:#ff0000"> (*)</strong></label>
                            <textarea id="txt-staff-code-login" rows="6" class="form-control" placeholder="Nhập danh sách cách nhau dấu ; hoặc dấu , hoặc khoảng trắng"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:400">Nhóm quyền</label>
                            <select id="slNhomQuyen" class="form-control select2" data-placeholder="">
                                @if (lstRole != null && lstRole.Count() > 0)
                                {
                                    foreach (var item in lstRole)
                                    {
                                        <option value="@item.RoleCode">@item.RoleName</option>
                                    }
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Giao diện màn hình <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="sel-is-mobile" class="form-control select2" data-placeholder="">
                                <option value="0">POS</option>
                                <option value="1" selected>Mobile</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Trạng thái <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="slStatus" class="form-control select2" data-placeholder="">
                                <option value="1">Active</option>
                                <option value="0">Locked</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label style="font-weight:400">ST/CH <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="sel-store-no" class="form-control select2">
                                @if (lstStore != null && lstStore.Count() > 0)
                                {
                                    foreach (var item in lstStore)
                                    {
                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                        <option value="@item.SiteNo">@storeName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Máy POS <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="sel-pos-terminal" class="form-control select2"></select>
                        </div>
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="modal-update-perm-user-pos-web" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cập nhật phân quyền user POSWEB</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Hình thức đăng nhập</label>
                        <div class="form-group">
                            <select id="sl-update-type-login" class="form-control select2" disabled>
                                <option value="AD" selected>Tài khoản AD</option>
                                <option value="LOCAL">Tài khoản LOCAL</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Tài khoản (AD) / Mã nhân viên</label>
                        <div class="form-group">
                            <input type="text" class="form-control changeEventSearch"  id="txt-update-user-login" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">ST/CH</label>
                        <div class="form-group">
                            <input type="text" class="form-control" id="sel-update-store-no" name="StoreNo" disabled>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Máy POS</label>
                        <div class="form-group">
                            <input type="text" class="form-control" id="sel-update-pos-terminal" name="POSTerminal" disabled>                           
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Giao diện màn hình <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="sel-update-is-mobile" class="form-control select2" data-placeholder="">
                                <option value="1" selected>Mobile</option>
                                <option value="0">POS</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label style="font-weight:400">Trạng thái <strong style="color:#ff0000"> (*)</strong></label>
                        <div class="form-group">
                            <select id="sl-update-status" class="form-control select2">
                                <option value="1" selected>Active</option>
                                <option value="0">Locked</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" id="btn-update-perm-user-pos-web" class="btn btn-primary font-weight-bold"><i class="la la-save"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="modalPopupStore" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">DANH SÁCH ST/CH</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="card-body">
                    <div id="divPermStore"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>

</div>


@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function LoadComboxPOSTerminalByStore(storeNo) {
            //debugger
            loading.showloading();
            if (storeNo == null || storeNo == '') {
                var html = "<option value=\"\" selected>Vui lòng chọn ST/CH</option>";
                return $('#sel-pos-terminal').html(html);
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: { StoreNo: storeNo },
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].PosID + "'>" + data[0].PosID + "</option>";
                            $('#sel-pos-terminal').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.PosID != "") {
                                    html += "<option value='" + name.PosID + "'>" + name.PosID + "</option>";
                                }
                            });
                            $('#sel-pos-terminal').html(html);
                        }
                    }
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });
        };

        function ClearText_Create() {
            $('#slType').trigger('change');
            $('#txt-user-name-login').val('');
            $('#txt-staff-code-login').val('');
            $('#slStatus').trigger('change');
            $('#sel-store-no').trigger('change');
            $('#sel-pos-terminal').trigger('change');
            $('#sel-is-mobile').trigger('change');
        }


        $(document).ready(function () {
            $('.select2').select2();

            $("#slType").on("change", function (e) {
                var option = $("#slType").val();
                if (option == "AD") {
                    $('#lbl-user-name-login').show();
                    $('#txt-user-name-login').show();

                    $('#lbl-staff-code-login').hide();
                    $('#txt-staff-code-login').val('').hide();
                }
                else if (option == "LOCAL") {
                    $('#lbl-staff-code-login').show();
                    $('#txt-staff-code-login').show();

                    $('#lbl-user-name-login').hide();
                    $('#txt-user-name-login').val('').hide();
                }
            });

            LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            $("#sel-store-no").on("change", function (e) {
                LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            });

            LoadData();

            $("#btnSearch").on("click", function (e) {
                table.search(this.value).draw();
            });

            $(".changeEventSearch").on("change", function () {
                table.draw();
            });

            $("#btn-add-perm-user-pos-web").on("click", function (e) {
                ClearText_Create();
                $('#modal-add-perm-user-pos-web').modal({
                    backdrop: 'static',
                    keyboard: false
                });
            });

            $("#slType").on("change", function () {
                DisplayInfoStaff();
            });

            $("#btnSave").on("click", function (e) {
                SaveQuyen();
            });

            $("#btn-update-perm-user-pos-web").on("click", function (e) {
                UpdatePermUserByPOSWeb();
            });

        });

        function DisplayInfoStaff() {
            if ($("#slType").val() == "AD")
            {
                $("#displayInfoStaff").css("display", "none");
            }
            else
            {
                $("#displayInfoStaff").css("display", "-webkit-box");
            }
        }

        function LoadData() {
            table = $('#tbl-permission-role-pos-web').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                drawCallback: function (settings) {
                    $(".btn-update-perm-user-pos-web").click(function () {
                        //debugger
                        var typeLogin = $(this).attr("data-type-login");
                        if (typeLogin == "AD")
                        {
                            typeLogin = "AD";
                        }
                        else
                        {
                            typeLogin = "LOCAL";
                        }
                        $('#sl-update-type-login').val(typeLogin).trigger('change');

                        var userName = $(this).attr("data-user-name");
                        $('#txt-update-user-login').val(userName);

                        var storeNo = $(this).attr("data-store-no");
                        $('#sel-update-store-no').val(storeNo);

                        var postreminal = $(this).attr("data-posterminal");
                        $('#sel-update-pos-terminal').val(postreminal);

                        var status = $(this).parents('tr').find('td:nth-child(8)').find('span:nth-child(1)').html();
                        if (status == "Active") {
                            status = "1";
                        }
                        else if (status == "Locked")  // Locked
                        {
                            status = "0";
                        }
                        $('#sl-update-status').val(status).trigger('change');

                        var isMobile = $(this).parents('tr').find('td:nth-child(9)').find('span:nth-child(1)').html();
                        if (isMobile == "Mobile") {
                            isMobile = "1";
                        }
                        else {
                            isMobile = "0";
                        }
                        $('#sel-update-is-mobile').val(isMobile).trigger('change');

                        $('#modal-update-perm-user-pos-web').modal({
                            backdrop: 'static',
                            keyboard: true
                        });
                    });

                     // Xóa
                    $('.btn-delete-perm-user-pos-web').click(function () {
                        var typeLogin = $(this).attr("data-type-login");
                        var userName = $(this).attr("data-user-name");
                        var storeNo = $(this).attr("data-store-no");
                        var postreminal = $(this).attr("data-posterminal");
                        $.confirm({
                            backgroundDismiss: true,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: 'Bạn có chắc chắn muốn xóa thông tin này không?',
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        loading.showloading();
                                        $.ajax({
                                            url: '@Url.Action("DeleteUserAdminByPOSWeb", "Role")',
                                            type: "POST",
                                            dataType: "json",
                                            data: {
                                                TypeLogin: typeLogin,
                                                UserName: userName
                                            },
                                            success: function (data) {
                                                if (data.Status == 200)
                                                {
                                                    toastr.success(data.Message);
                                                }
                                                else
                                                {
                                                    toastr.error(data.Message);
                                                }

                                                $('#btnSearch').trigger('click');
                                                loading.hideloading();
                                            },
                                            error: function () {
                                                loading.hideloading();
                                                toastr.error("Lỗi hệ thống");
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });

                },

                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("GetPermissionListByPosWeb", "Role")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.UserName = $("#searchUsername").val();
                        d.StoreNo = $("#searchStoreNo").val();
                        d.Status = $("#slSearchActive").val();
                        d.LoginType = $("#slTypeSearch").val();
                    }
                },
                columns: [
                    {
                        data: "TypeLogin",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TypeLogin == null || row.TypeLogin == "") {
                                html += '<span style="display:block;font-weight:700;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:700;text-align:center;">' + row.TypeLogin + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UserName",  // Tai khoan login may pos
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UserName == null || row.UserName == "") {
                                html += '<span style="display:block;font-weight:700;text-align:left;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:700;text-align:left;">' + row.UserName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Password",  // Mat khau login may pos
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Password == null || row.Password == "") {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + row.Password + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "StaffCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StaffCode == null || row.StaffCode == "") {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;text-align:center;">' + row.StaffCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "FullName",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.FullName == null || row.FullName == "") {
                                html += '<span style="display:block; font-weight:400; text-align:left;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block; font-weight:400; text-align:left;">' + row.FullName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
