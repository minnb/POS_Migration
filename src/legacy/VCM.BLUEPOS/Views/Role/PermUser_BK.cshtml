@using VCM.BLUEPOS.Model.Authen;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Phân quyền người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstRole = ViewBag.ListRole as List<RoleModel>;
    var lstStore = ViewBag.ListStore as List<StorePartnerModel>;

}
<style>
    .dropdown-menu {
        border: 1px solid rgb(12, 113, 61);
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hệ thống</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Phân quyền người dùng</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btnAddPermUser"><i class="la la-cog"></i> Phân quyền user</button>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Loại login</label>
                                <div class="form-group">
                                    <select id="slTypeSearch" class="form-control select2 select2-blue changeEventSearch" data-placeholder="">
                                        <option value="-">Tất cả</option>
                                        <option value="AD">Tài khoản AD</option>
                                        <option value="LOCAL">Tài khoản LOCAL</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Nhóm quyền</label>
                                <div class="form-group">
                                    <select id="slNhomQuyenSearch" class="form-control select2 select2-blue changeEventSearch" data-placeholder="">
                                        <option value="-">Tất cả</option>
                                        @if (lstRole != null && lstRole.Count() > 0)
                                        {
                                            foreach (var item in lstRole)
                                            {
                                                <option value="@item.RoleCode">@item.RoleName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <input type="text" id="searchStoreNo" class="form-control changeEventSearch" placeholder="Mã CH/ST" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Từ khóa</label>
                                <div class="form-group">
                                    <input type="text" id="searchUsername" class="form-control changeEventSearch" placeholder="Tài khoản/Mã NV/Tên NV" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Trạng thái</label>
                                <div class="form-group">
                                    <select id="slSearchActive" class="form-control select2 changeEventSearch">
                                        <option value="-">Tất cả</option>
                                        <option value="1">Active</option>
                                        <option value="0">Locked</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tblData" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>LOẠI LOGIN</th>
                                    <th>MÃ NV</th>
                                    <th>TÊN NV</th>
                                    <th>TÀI KHOẢN</th>
                                    <th>NHÓM QUYỀN</th>
                                    <th>TRẠNG THÁI</th>
                                    <th>NGƯỜI CẬP NHẬT</th>
                                    <th>NGÀY CẬP NHẬT</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalAddPermUser" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cập nhật quyền người dùng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Hình thức đăng nhập</label>
                            <select id="slType" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="AD">Tài khoản AD</option>
                                <option value="LOCAL">Tài khoản LOCAL</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Username</label>
                            <textarea id="txtUsernameLogin" rows="6" class="form-control" placeholder="Nhập danh sách tài khooản (cách nhau dấu chấm phẩy (;) hoặc dấu phẩy (,) hoặc khoảng trắng)">
                            </textarea>
                        </div>
                    </div>
                </div>

                @*<div class="row" style="clear:both;display:-webkit-box" id="displayInfoStaff">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label style="font-weight:bold">Mã nhân viên</label>
                                <input type="text" class="form-control" id="txtStaffCode" value="" disabled />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label style="font-weight:bold">Tên người dùng</label>
                                <input type="text" class="form-control" id="txtFullName" value="" disabled />
                            </div>
                        </div>
                    </div>*@

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Trạng thái</label>
                            <select id="slStatus" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="1">Active</option>
                                <option value="0">Locked</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Nhóm quyền</label>
                            <select id="slNhomQuyen" class="form-control select2 select2-blue" data-placeholder="">
                                @if (lstRole != null && lstRole.Count() > 0)
                                {
                                    foreach (var item in lstRole)
                                    {
                                        <option value="@item.RoleCode">@item.RoleName</option>
                                    }
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Cửa hàng</label>
                            <select id="slStore" class="form-control" multiple="multiple">
                                @if (lstStore != null && lstStore.Count() > 0)
                                {
                                    foreach (var item in lstStore)
                                    {
                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                        <option value="@item.SiteNo">@storeName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="modalPopupStore" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">DANH SÁCH CỬA HÀNG</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-body">
                    <div id="divPermStore"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Thoát</button>
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {

            $('#slStore').fSelect({
                placeholder: 'Chọn cửa hàng',
                numDisplayed: 1,
                overflowText: '{n} CH được chọn',
                searchText: 'Tìm kiếm....',
                noResultsText: 'Không tìm thấy cửa hàng',
                showSearch: true,
                optionFormatter: false,
                isSelectAll: true
            });

            LoadData();

            $("#btnSearch").on("click", function (e) {
                //debugger
                table.search(this.value).draw();
            });

            $(".changeEventSearch").on("change", function () {
                table.draw();
            });

            $("#btnAddPermUser").on("click", function (e) {
                $("#HiddenCode").val('');
                $("#txtUsernameLogin").val('');
                $("#txtUsernameLogin").prop("disabled", false);

                //$("#txtStaffCode").val('');
                //$("#txtFullName").val('');

                $("#slStatus").select2('val', [1]);
                $("#slType").select2('val', ['AD']);

                DisplayInfoStaff();

                $('.fs-option').removeClass('selected');
                $('.fs-label').html('Chọn cửa hàng');

               // $("#slStore option[value='CH02']").prop("selected", true);

                $('#modalAddPermUser').modal({
                    backdrop: 'static',
                    keyboard: false
                });
            });

            $("#slType").on("change", function () {
                DisplayInfoStaff();
            });

            $("#btnSave").on("click", function (e) {
                SaveQuyen();
            });
        });

        function DisplayInfoStaff() {
            if ($("#slType").val() == "AD") {
                $("#displayInfoStaff").css("display", "none");
            }
            else {
                $("#displayInfoStaff").css("display", "-webkit-box");
            }
        }

        function LoadData() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("LoadDataPermission", "Role")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.UserName = $("#searchUsername").val();
                        d.StoreNo = $("#searchStoreNo").val();
                        d.Status = $("#slSearchActive").val();
                        d.LoginType = $("#slTypeSearch").val();
                        d.RoleCode = $("#slNhomQuyenSearch").val();
                    }
                },

                //createdRow: function (row, data, dataIndex) {
                //    $(row).attr('id', "rowRecord" + data.ID);
                //},

                columns: [
                    {
                        data: "TypeLogin",
                        className: 'text-center'
                    },
                    {
                        data: "StaffCode",
                        className: 'text-center'
                    },
                    {
                        data: "FullName"
                    },
                    {
                        data: "UserName",
                        className: 'text-center'
                    },
                    {
                        data: "RoleName",
                        render: function (data, type, row) {
                            var html = "<span class=\"badge\" style=\"color: #fff;background-color:#007bff;\">" + row.RoleName + "</span>";
                            return html;
                        },
                        className: 'text-center'
                    },
                    {
                        data: "IsActive",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsActive == true) {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                            }
                            else {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                            }
                            return html;
                        },
                        className: 'text-center'
                    },
                    {
                        data: "CreatedBy",
                        render: function (data, type, full, meta) {
                            if (full.UpdatedBy != null) {
                                return full.UpdatedBy
                            }
                            else {
                                return full.CreatedBy
                            }
                        },
                        className: 'text-center'
                    },
                    {
                        data: "CreatedDate",
                        render: function (data, type, full, meta) {
                            if (full.UpdatedDate != null) {
                                return moment(full.UpdatedDate).format("DD/MM/YYYY HH:mm");
                            }
                            else {
                                if (full.CreatedDate != null) {
                                    return moment(full.CreatedDate).format("DD/MM/YYYY HH:mm");
                                }
                                else
                                    return "";
                            }
                        },
                        className: 'text-center'
                    },
                    {
                        data: "UserName",
                        render: function (data, type, full, meta) {
                            var html = "";

                            //html += "<a onclick=\"ModalUpdate('" + full.TypeLogin + "',\'" + full.UserName + "'\)\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\">";

                            html += "<a href=\"javascript:;\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\" data-toggle=\"dropdown\">";
                            html += "<i class=\"flaticon2-gear\"></i>";
                            html += "<span class=\"pulse-ring\"></span>";
                            html += "</a>";

                            html += "<div class=\"dropdown-menu dropdown-menu-sm dropdown-menu-right\">";
                            html += "<ul class=\"nav nav-hoverable flex-column\">";

                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ModalUpdate('" + full.TypeLogin + "','" + full.UserName + "')\"><i class=\"nav-icon la la-edit\"></i><span class=\"nav-text\" style=\"color: #0c713d;\">Sửa phân quyền</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ModalStore('" + full.UserName + "')\"><i class=\"nav-icon la la-database\"></i><span class=\"nav-text\" style=\"color: #0c713d;\">Quyền xem CH/ST</span></a></li>";

                            //if (full.TypeLogin == "LOCAL") {
                            //    html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ViewPass('" + full.UserName+"')\"><i class=\"nav-icon la la-eye\"></i><span class=\"nav-text\">Xem mật khẩu</span></a></li>";
                            //}

                            html += "</ul>";
                            html += "</div>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function SaveQuyen() {
            debugger
            var storeNo = $('#slStore').val() == "" ? "" : JSON.stringify($('#slStore').val());
            var listStore = "";
            var userName = $("#txtUsernameLogin").val();

            //var staffCode = $("#txtStaffCode").val();
            //var fullName = $("#txtFullName").val();

            var roleCode = $("#slNhomQuyen").val();
            var status = $("#slStatus").val();
            var typeLogin = $("#slType").val();
            var isAllStore = $('.fs-label-wrap').attr('data-selectall');

            if (userName == "") {
                toastr.error("Chưa nhập username");
                return;
            }
            if (roleCode == "" || roleCode.length == 0) {
                toastr.error("Chưa chọn nhóm quyền");
                return;
            }

            loading.showloading();

            var fromData = new FormData();
            fromData.append('TypeLogin', typeLogin);
            fromData.append('UserName', userName);

            //fromData.append('StaffCode', staffCode);
            //fromData.append('FullName', fullName);

            fromData.append('RoleCode', roleCode);
            fromData.append('Status', status);
            fromData.append('StoreNo', storeNo);
            fromData.append('IsAllStore', isAllStore);

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdatePerm", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                        table.draw();
                        $('#modalAddPermUser').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function ModalUpdate(typeLogin, userName) {
            //debugger
            if (typeLogin == "AD") {
                $("#displayInfoStaff").css("display", "none");
            }
            else {
                $("#displayInfoStaff").css("display", "-webkit-box");
            }
            $("#txtUsernameLogin").val('');
            $("#txtUsernameLogin").prop("disabled", true);

            var fromData = new FormData();
            fromData.append('UserName', userName);

            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadUserByUserName", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 200) {
                        var result = data.Data;
                        if (result != null) {
                            var listStore = result.StoreNo;
                            var isAllStore = result.IsAllStore;

                            $("#slType").select2('val', [typeLogin]);

                            $('.fs-option').removeClass('selected');
                            if (isAllStore) {
                                $('.fs-label-wrap').attr('data-selectall', 1);

                                $(".fs-option").toggleClass('selected');
                                //$("#slStore").fSelect('reloadDropdownLabel');
                            }
                            else {
                                $('.fs-label-wrap').attr('data-selectall', 0);
                                if (listStore != "") {
                                    
                                    var listArray = JSON.parse(listStore);
                                    $("#slStore").val(listArray);
                                    jQuery.each(listArray, function (i, val) {
                                        $(".fs-option[data-value='" + val + "']").toggleClass('selected');
                                    });

                                    //$.each(listStore.split(","), function (i, e) {
                                    //    $(".fs-option[data-value='" + e + "']").toggleClass('selected');
                                    //});
                                    //$("#slStore").fSelect('reloadDropdownLabel');
                                }
                                else {
                                    $('.fs-label').html('Chọn cửa hàng');
                                }
                            }
                            $("#slStore").fSelect('reloadDropdownLabel');
                            $("#slStore").change();

                            $("#txtUsernameLogin").val(userName);

                            //$("#txtStaffCode").val(result.StaffCode);
                            //$("#txtFullName").val(result.FullName);

                            var active = result.IsActive == true ? 1 : 0;
                            $("#slStatus").select2('val', [active]);
                            $("#slNhomQuyen").select2('val', [result.RoleCode]);

                        }
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });

            $('#modalAddPermUser').modal({
                backdrop: 'static',
                keyboard: false
            });
        }

        function ViewPass(userName) {
            var fromData = new FormData();
            fromData.append('UserName', userName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewPass", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 200) {
                        var result = data.Data;
                        $.alert(result, "Mật khẩu");
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function ModalStore(userName) {
            debugger

            //$.ajax({
            //    type: "GET",
            //    url: "/Role/_PermStore?userName=" + userName+ "",
            //    dataType: 'html',
            //    contentType: false,
            //    processData: false,
            //    success: function (result) {
            //        $("#divPermStore").html(result);

            //        $('#modalPopupStore').modal({
            //            backdrop: 'static',
            //            keyboard: false
            //        });
            //    },
            //    error: function (event) {
            //    }
            //});

            var fromData = new FormData();
            fromData.append('userName', userName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("_PermStore", "Role")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (result) {
                    //debugger
                    if (result.Status == 200) {
                        var viewHtml = result.ViewPartial;
                        $("#divPermStore").html(viewHtml);
                        $('#modalPopupStore').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    }
                    else {
                        toastr.error(result.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }
    </script>

}