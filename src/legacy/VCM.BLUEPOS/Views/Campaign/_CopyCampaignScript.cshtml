    function ClearModalCopy() {
        $('#copy-offerNo').val('');
        $('#copy-objectID').val('');
        $('#copy-offerType').val('');
        $('#copy-sub-text-title').text('');
    }

    $(document).ready(function () {
        $('#btn-save-copy-campaign').off('click');
      
        $('#btn-save-copy-campaign').on('click', function () {
            var data = {
                ObjectIDs: $('#copy-objectID').val(),
                StartTime: $('#copy-startTime').val(),
                EndTime: $('#copy-endTime').val(),
                OfferNo: $('#copy-offerNo').val(),
            };

            var isValid = true;

            if (data.OfferNo == '' || data.OfferNo == null) {
                toastr.error("Vui lòng chọn Mã khuyến mãi");
                isValid = false;
            }

            if (!isValid) return;

            $.ajax({
                url: "/Campaign/CopyCampaign",
                type: "POST",
                data: data,
                success: function (response) {
                    if (response.Meta.Code == 200) {
                        toastr.success(response.Meta.Message, { showMethod: "fadeIn", hideMethod: "fadeOut", timeOut: 2000 });
                        $('#modal-copy-campaign').modal('hide');
                        $("#btn-search").trigger('click');
                    } else {
                        toastr.error(response.Meta.Message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Lỗi hệ thống !", "Error");
                }
            });
        })
    });
</script>