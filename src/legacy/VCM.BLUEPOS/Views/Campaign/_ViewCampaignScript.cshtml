    function ClearModalView() {
        $('#view-objectID').val('');
        $('.view-item-row').each(function () {
            $(this).remove();
        });

        $('#view-startTime').val('');
        $('#view-endTime').val('');
        $('#view-offerNo').val('');
        $('#view-priceCampaign').val('');
        $('#view-valueCampaign').val('');
        $('#view-storeNo').val('');
        $('#view-photo').val('');
        $('#view-description').val('');
        $('#view-name').val('');
        $('#view-campaign-items-container').html('');
    }

    $(document).ready(function () {
        $('#btn-copy-view-campaign').off('click'); 
      
        $('#btn-copy-view-campaign').on('click', function () {
            var data = {
                ObjectIDs: $('#view-objectID').val(),
                StartTime: $('#view-startTime').val(),
                EndTime: $('#view-endTime').val(),
                OfferNo: $('#view-offerNo').val(),
            };

            var isValid = true;

            if (data.OfferNo == '' || data.OfferNo == null) {
                toastr.error("Vui lòng chọn Mã khuyến mãi");
                isValid = false;
            }

            if (!isValid) return;

            $.ajax({
                url: "/Campaign/CopyCampaign",
                type: "POST",
                data: data,
                success: function (response) {
                    if (response.Meta.Code == 200) {
                        toastr.success(response.Meta.Message, { showMethod: "fadeIn", hideMethod: "fadeOut", timeOut: 2000 });
                        $('#modal-view-campaign').modal('hide');
                        $("#btn-search").trigger('click');
                    } else {
                        toastr.error(response.Meta.Message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Lỗi hệ thống !", "Error");
                }
            });
        })
    });
</script>