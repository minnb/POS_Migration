@{
    Layout = null;
}
<script>
    function GetDetail() {
        var object_id = $('#view-objectID').val();
        $.ajax({
            url: "/Campaign/Detail",
            type: "POST",
            data: { objectId: object_id },
            success: function (response_detail) {
                if (response_detail.Meta.Code == 200) {
                    var data = response_detail.Data;
                    $('#view-merchantID').val(data.MerchantID).trigger('change');
                    $('#view-name').val(data.Name);
                    $('#view-startTime').val(data.StartTime);
                    $('#view-endTime').val(data.EndTime);
                    $('#view-offerType').val(data.OfferType);
                    $('#view-offerNo').val(data.OfferNo);
                    $('#view-priceCampaign').val(data.Price.toLocaleString('vi-VN'));
                    $('#view-valueCampaign').val(data.Value.toLocaleString('vi-VN'));
                    $('#view-photo').val(data.Photo);
                    $('#view-description').val(data.Description);

                    if (data.CampaignStores != null && data.CampaignStores != undefined && data.CampaignStores.length > 0) {
                        var storeNo = data.CampaignStores.map(x => x.PartnerMerchantID).join(', ');
                        $('#view-storeNo').val(storeNo);
                    }

                    const grouped = data.CampaignItems.reduce((acc, item) => {
                        const key = item.Sequence;
                        if (!acc[key]) {
                            acc[key] = [];
                        }
                        acc[key].push(item);
                        return acc;
                    }, {});

                    const groupedArray = Object.keys(grouped).map(key => ({
                        Sequence: parseInt(key),
                        Items: grouped[key]
                    }));

                    $.each(groupedArray, function (index, item) {
                        var htmlItemNoList = ``;

                        $.each(item.Items, function (index, itemNo) {
                            htmlItemNoList += `<div class="w-100 mt-2 view-item-row">
                                                <div class="w-100 d-flex">
                                                    <div class="col-5 p-0">
                                                        <input type="text" class="form-control item-discount inp-number" value ="${itemNo.ItemNo}" disabled>
                                                    </div>
                                                    <div class="col-7 pe-0">
                                                        <input type="text" class="form-control item-name" value ="${(itemNo.ItemName?? '')}" disabled>
                                                    </div>
                                                </div>
                                            </div>`;
                        });

                        $('#view-campaign-items-container').append(`
                                 <div class="card card-body row w-100 mt-2 view-session-row align-items-center">
                                    <div class="row w-100 mt-2 " style="border-bottom: 1px solid; border-bottom-color: #d4e3f0; padding-bottom: 7px;">
                                        <div class="d-flex align-items-center" style="background-color: #bcc2c7; border-radius: 7px; width: 70px !important; padding-left: 12px; ">
                                            <label style="white-space: nowrap; margin:0 7px 0 0;font-weight:700 !important">Món</label>
                                            <span class="item-stt" style="white-space: nowrap; margin:0 7px 0 0;font-weight:700 !important">${item.Sequence}</span>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-start pe-0" style="width:140px !important; margin-left:10px">
                                            <label for="is-topping" style="white-space: nowrap; margin: 0 7px 0 0;font-weight: 800;">Có Topping ?</label>
                                            <input type="checkbox" ${item.Items[0].IsTopping ? 'checked' : ''} class="form-control item-is-topping item-is-topping-disabled" min="0" style="width:20px;" name="is-topping">
                                        </div>

                                        <div class="d-flex" style="flex:1">
                                            <div class="col-6 d-flex align-items-center">
                                                <label style="white-space: nowrap; margin:0 7px 0 0;">Giá bán</label>
                                                <input type="text" class="form-control item-special-price inp-number" value="${item.Items[0].SpecialPrice.toLocaleString('vi-VN')}" disabled>
                                            </div>

                                            <div class="col-6 d-flex align-items-center">
                                                <label style="white-space: nowrap; margin: 0 7px 0 0;">Khuyến mãi</label>
                                                <input type="text" class="form-control item-discount inp-number" value="${item.Items[0].Discount.toLocaleString('vi-VN')}" disabled>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row w-100 mt-2 d-flex align-items-center justify-content-center">
                                        <div class="col-12 list-item-no d-flex flex-wrap w-100 mt-2">
                                            <div class="d-flex w-100 item-header" style="background-color: #d2d2d2; padding: 5px;">
                                                <div class="col-5">Mã sản phẩm</div>
                                                <div class="col-7">Tên sản phẩm</div>
                                            </div>
                                            ${htmlItemNoList}
                                        </div>
                                    </div>
                                </div>
                            `)
                    });
                } else {
                    toastr.error(response_detail.Meta.Message);
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr);
                console.log(status);
                console.log(error);
                toastr.error("Lỗi hệ thống !", "Error");
            }
        });
    }

