@{
    Layout = null;
}

<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="copy-startTime" class="form-label">Thời gian bắt đầu</label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="copy-startTime">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right datetime-picker" id="copy-startTime" placeholder="Từ ngày" name="copy-startTime">
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="copy-endTime" class="form-label">Thời gian kết thúc</label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="copy-endTime">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right datetime-picker" id="copy-endTime" placeholder="Đến ngày" name="copy-endTime">
            </div>
        </div>
    </div>

    @*<div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="copy-offerNo" class="form-label">Mã CTKM</label>
        <select class="select2" id="copy-offerNo" name="copy-offerNo">
            <option value="">Chọn CTKM</option>
        </select>
    </div>*@

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="copy-offerNo" class="form-label required">Mã CTKM</label>
        <input type="text" class="form-control" id="copy-offerNo" name="copy-offerNo">
    </div>
</div>