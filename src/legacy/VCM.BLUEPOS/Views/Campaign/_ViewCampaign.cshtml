@{
    Layout = null;
}

<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="merchantId" class="form-label">Loại dịch vụ</label>
        <select class="select2" id="view-merchantID" name="view-merchantId" disabled>
            <option value="BEFOOD">BEFOOD</option>
            <option value="GRABFOOD">GRABFOOD</option>
        </select>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-startTime" class="form-label">Thời gian bắt đầu</label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="view-startTime">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right datetime-picker" id="view-startTime" placeholder="Từ ngày" name="view-startTime">
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-endTime" class="form-label">Thời gian kết thúc</label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="view-endTime">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right datetime-picker" id="view-endTime" placeholder="Đến ngày" name="view-endTime">
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="name" class="form-label">Tên món</label>
        <input type="text" class="form-control" id="view-name" name="Name" disabled>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-photo" class="form-label">Ảnh món</label>
        <input type="text" class="form-control" id="view-photo" name="Photo" disabled>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-description" class="form-label">Mô tả món</label>
        <textarea class="form-control" id="view-description" name="view-description" rows="1" disabled></textarea>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-offerType" class="form-label">Loại CTKM</label>
        <select class="select2" id="view-offerType" name="view-offerType" disabled>
            <option value="ZB02">ZB02</option>
            <option value="ZB07">ZB07</option>
        </select>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3">
        <label for="view-offerNo" class="form-label">Mã CTKM</label>
        <input type="text" class="form-control" id="view-offerNo" name="offerNo">
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 form-group mb-3 row" style="padding-right: 0;">
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 form-group mb-3">
            <label for="view-price" class="form-label">Tổng tiền combo</label>
            <input type="text" class="form-control" id="view-priceCampaign" name="view-Price" min="0" disabled>
        </div>

        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 form-group mb-3" style="padding-right: 0;">
            <label for="view-value" class="form-label">Giảm giá combo</label>
            <input type="text" class="form-control" id="view-valueCampaign" name="view-Value" min="0" disabled>
        </div>
    </div>

    <div class="col-12 form-group mb-3">
        <label for="view-storeNo" class="form-label">Danh sách cửa hàng</label>
        <input type="text" class="form-control" id="view-storeNo" disabled>
    </div>

    <div class="col-12 form-group mb-3">
        <div class="d-flex justify-content-start align-items-center">
            <h6 style="color: #0C713D">Danh sách món trong Campaign</h6>
        </div>

        <div class="border border-1 rounded p-4" style="border-color:antiquewhite">
            <div id="view-campaign-items-container" class="d-flex justify-content-center align-items-center flex-column">

            </div>
        </div>
    </div>
</div>

<style>
    label.form-label {
        font-weight: 700;
    }

    .lb-stt {
        height: 100%;
        width: 100%;
        background-color: #9193a1;
        color: white;
        border-radius: 7px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .pe-0 {
        padding-right: 0 !important;
    }

    .item-is-topping-disabled {
        pointer-events: none;
    }
</style>