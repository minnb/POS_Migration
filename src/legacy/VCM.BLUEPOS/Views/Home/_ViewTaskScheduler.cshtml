@using VCM.BLUEPOS.Model.Home;

@{
    var model = Model as List<TaskSchedulerJobModel>;
    if (model != null && model.Count > 0)
    {
        <table class="table table-bordered" id="tblData" style="margin-bottom:0px !important">
            <thead>
                <tr style="text-align:center;background-color:#3699ff;color:#000000 !important">
                    <th style="">Folder</th>
                    <th style="">Name</th>
                    <th style="">Status</th>
                    <th>Triggers</th>
                    @*<th>NextRunTime</th>*@
                    <th>LastRunTime</th>
                    <th>LastRunResult</th>
                    @*<th>#</th>*@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in model)
                {
                    if (item.ErrorCode == 1)
                    {
                        var backgroundColor = item.Status == "Ready" ? "" : "background-color: #f6f39c;";
                        <tr style="@backgroundColor">
                            <td style="vertical-align:middle;text-align:center">@item.Folder</td>
                            <td style="vertical-align:middle">@item.NameJob</td>
                            <td style="vertical-align:middle;text-align:center">@item.Status</td>
                            <td style="vertical-align:middle">@item.Trigger</td>
                            @*<td style="vertical-align:middle">@string.Format("{0:dd/MM/yyyy HH:mm:ss}", item.NextRunTime)</td>*@
                            <td style="vertical-align:middle">@string.Format("{0:dd/MM/yyyy HH:mm:ss}", item.LastRunTime)</td>
                            <td style="vertical-align:middle">@item.LastRunResult</td>
                            @*<td class="text-center">
                                <a href="javascript:;" class="btn btn-icon btn-light-warning pulse pulse-warning" data-toggle="dropdown">

                                    <i class="flaticon2-gear"></i>
                                    <span class="pulse-ring"></span>

                                </a>
                                <div class="dropdown-menu dropdown-menu-sm dropdown-menu-right" style="">
                                    <ul class="nav nav-hoverable flex-column">
                                        @if (item.Status == "Disabled")
                                        {
                                            <li class="nav-item"><a class="nav-link" style="cursor:pointer" onclick="TaskEnable('@item.IPServer','@item.NameJob')"><i class="nav-icon fas fa-caret-square-up" style="color:#1b8e4b"></i><span class="nav-text" style="color: #1b8e4b;">  Enable</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="nav-item"><a class="nav-link" style="cursor:pointer" onclick="TaskDisable('@item.IPServer','@item.NameJob')"><i class=" nav-icon fas fa-caret-square-down"></i><span class="nav-text" style="color: #7E8299;">  Disable</span></a></li>
                                            <li class="nav-item"><a class="nav-link" style="cursor:pointer" onclick="TaskEnd('@item.IPServer','@item.NameJob')"><i class="nav-icon fas fa-caret-square-right" style="color:#1b8e4b"></i><span class="nav-text" style="color: #0c713d;">  Run</span></a></li>
                                        }
                                    </ul>
                                </div>
                            </td>*@
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="text-center" style="color:#ff0000;font-weight:bold" colspan="6">@item.ErrorMessage</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    <script type="text/javascript">
        $(document).ready(function () {
            
        });
        function TaskEnd(IPServer, TaskName) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', IPServer);
            fromData.append('TaskName', TaskName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckActionTaskScheduler", "Home")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (d) {
                    
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

    </script>
}

