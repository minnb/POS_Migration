<div class="row">
    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
        <label style="font-weight: bold;">Từ ngày<strong style="color:#ff0000">(*)</strong></label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="txt-from-date">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
        <label style="font-weight: bold">Đến ngày<strong style="color:#ff0000">(*)</strong></label>
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-btn" for="txt-to-date">
                        <span class="btn btn-default">
                            <span class="glyphicon glyphicon-calendar">
                                <i class="far fa-calendar-alt"></i>
                            </span>
                        </span>
                    </label>
                </div>
                <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12" style="margin-top:25px;">
        <button type="button" id="btn-view-report-checklist" class="btn btn-primary"><i class="fa fa-search"></i>Xem</button>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="tableReportCheckList">

    </div>
</div>


<script>
    var start = moment().subtract(7, 'day');
    $('#txt-from-date').val(start.format('DD/MM/YYYY'));
    $('#txt-from-date').datepicker(
        {
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });

    $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
    $('#txt-to-date').datepicker(
        {
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });


    $("#btn-view-report-checklist").click(function () {
        loading.showloading();
        var fromDate = $('#txt-from-date').val();
        var toDate = $('#txt-to-date').val();
        $.ajax({
            type: "GET",
            url: "/Home/_ViewResponseReportCheckList?fromDate=" + fromDate + "&toDate=" + toDate + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#tableReportCheckList").html(result);
                loading.hideloading();
            },
            error: function (event) {
                loading.hideloading();
            }
        });
    });


</script>
