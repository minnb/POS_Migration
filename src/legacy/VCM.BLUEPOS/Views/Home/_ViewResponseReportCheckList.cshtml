@using VCM.BLUEPOS.Model.Home;

@{
    var model = Model as List<ReportCheckListResponse>;

    if (model != null && model.Count > 0)
    {
        var stt = 1;
        var listUser = model.GroupBy(d => new { d.UserCheck }).Select(a => a.FirstOrDefault().UserCheck).ToList();
        var listDateCheck = model.GroupBy(d => new { d.DayCheck }).Select(a => new { DayCheck = a.FirstOrDefault().DayCheck }).ToList();
        <table class="table table-bordered" id="tblCheckList" style="width:100%;">
            <thead>
                <tr>
                    <th style='text-align:left;'>Ngày check</th>
                    @if (listUser.Count > 0)
                    {
                        foreach (var us in listUser)
                        {
                            <th style="text-align:center">@us</th>
                        }
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in listDateCheck)
                {
                    var dayCheck = item.DayCheck.ToString("dd-MM-yyyy");
                    //var thuTrongTuan = _SalesByMCHDetailLoad;
                    //var day = item.DayCheck.Subtract(Model.FromDate.Value.Date).TotalDays;
                    var thuNgay = item.DayCheck.DayOfWeek.ToString().Substring(0, 3);
                    var disp = item.DayCheck.ToString("dd-MM-yyyy") +"("+ thuNgay + ")";
                    <tr>
                        <td><span style="font-weight:bold">@disp</span></td>
                        @foreach (var us in listUser)
                        {
                            var userCheck = model.Where(d => d.DayCheck.ToString("dd-MM-yyyy") == dayCheck && d.UserCheck == us).FirstOrDefault();
                            if (userCheck != null)
                            {
                                if (userCheck.IsSuccess == 1)
                                {
                                    <td style="text-align:center"><span style="color:#00ff90;font-weight:bold">OK</span></td>
                                }
                                else
                                {
                                    var numberCheck = userCheck.TotalCheck - userCheck.CountCheck;
                                    <td style="text-align:center"><span style="color:#ffd800;font-weight:bold">Thiếu @numberCheck đầu việc</span></td>
                                }
                            }
                            else
                            {
                                <td style="text-align:center"><span style="color:#ff0000;font-weight:bold">Chưa làm</span></td>
                            }

                        }
                    </tr>
                    stt = stt + 1;
                }
            </tbody>
        </table>
    }
    else
    {
    }

}