@using VCM.BLUEPOS.Model.Home;

@{
    var model = Model as List<ServerWebModel>;
    if (model != null && model.Count > 0)
    {
        var firstIP = model.FirstOrDefault().IPSERVER;
        <div class="row">
            <div class="col-2">
                <ul class="nav flex-column nav-pills">
                    @foreach (var item in model)
                    {
                        var ipServer = item.IPSERVER;
                        var ipSvrR = item.IPSERVER.Replace(".", "");
                        // var active = firstIP == item.IPSERVER ? "active" : "";
                        <li class="nav-item mb-2 clickSvr" style="background-color:#bde1cf" data-ipserver="@ipServer" data-folder="@item.FOLDERJOB">
                            <a class="nav-link" id="tab_@ipSvrR" data-toggle="tab" href="#content_@ipSvrR">
                                <span class="nav-icon">
                                    <i class="fas fa-arrow-alt-circle-right" style="color:#FFFFFF;font-weight:bold"></i>
                                </span>
                                <span class="nav-text" style="color:#FFFFFF;font-weight:bold">@ipServer</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="col-10">
                <div class="tab-content" id="myTabContent5">
                    @*@foreach (var item in model)
                        {
                            var active = firstIP == item.IPSERVER ? "active show" : "";

                            var ipServer = item.IPSERVER;
                            var ipSvrR = item.IPSERVER.Replace(".", "");
                            <div class="tab-pane fade @active" id="content_@ipSvrR" role="tabpanel" aria-labelledby="tab_@ipSvrR"></div>

                        }*@

                    <div class="tab-pane fade active show table-responsive" id="contentTab" role="tabpanel" aria-labelledby="tabContent" style="height:500px">
                        <strong style="color:#0094ff;font-weight:bold;font-size: 25px;">Vui lòng click vào server IP để để hiển thị TASK</strong>
                    </div>

                </div>
            </div>
        </div>
    }


    <script type="text/javascript">

        $(document).ready(function () {

            $(".clickSvr").on("click", function () {
                $("#contentTab").html("");
                var ipServer = $(this).attr("data-ipserver");
                var arrayFolder = $(this).attr("data-folder");
                //alert(ipServer);
                //$("#content_" + ipServer.replace(".", "")).html(ipServer);
                loading.showloading();
                $.ajax({
                    type: "GET",
                    url: "/Home/_ViewTaskScheduler?ipserver=" + ipServer + "&arrayFolder=" + arrayFolder + "",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        $("#contentTab").html(result);
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });
            });
        });
    </script>

}
