@using VCM.BLUEPOS.Model.Home;

@{
    var model = Model as AgentSQLResult;
    <div class="row table-responsive" style="height:500px">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <table class="table table-bordered" id="tblDataAgent" style="margin-bottom:0px !important;">
                <thead class="classAgentHead">
                    <tr style="text-align:center;background-color:#3699ff;color:#000000 !important">
                        <th>JobName</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>RunDateAndTime</th>
                        <th>RunStatus</th>
                        <th>Run_Duration</th>
                        <th>Message</th>
                        <th>ScheduleName</th>
                        <th>Frequency</th>
                        <th>SubFrequency</th>
                        <th>ScheduleTime</th>
                        <th>NextRunDate</th>
                    </tr>
                </thead>
                <tbody class="classAgentBody">
                    @if (model.ListJobAgent !=null && model.ListJobAgent.Count > 0)
                    {
                        var listJob = model.ListJobAgent;
                        foreach (var item in listJob)
                        {
                            var backgroundColor = item.RunStatus == "Succeeded" ? "" : "background-color: #f6f39c;";
                            <tr style="@backgroundColor">
                                <td style="vertical-align:middle;">@item.jobName</td>
                                <td style="vertical-align:middle">@item.description</td>
                                <td style="vertical-align:middle;">@item.Status</td>
                                <td style="vertical-align:middle">@item.RunDateAndTime</td>
                                <td style="vertical-align:middle">@item.RunStatus</td>
                                <td style="vertical-align:middle">@item.Run_duration</td>
                                <td style="vertical-align:middle">@item.message</td>
                                <td style="vertical-align:middle">@item.ScheduleName</td>
                                <td style="vertical-align:middle">@item.Frequency</td>
                                <td style="vertical-align:middle">@item.SubFrequency</td>
                                <td style="vertical-align:middle">@item.ScheduleTime</td>
                                <td style="vertical-align:middle">@item.NextRunDate</td>
                            </tr>
                        }
                    }
                    else
                    {
                        var mesageError = model.ErrorMessage;
                        <tr>
                            <td class="text-center" style="color:#ff0000;font-weight:bold" colspan="12">@mesageError</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

