@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Kiểm tra voucher partner";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = Model as List<StoreModel>;
}

<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>

<style>
    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Check API</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Kiểm tra voucher partner</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                <label style="font-weight: bold">Partner</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width: 100%;" id="slPartner" name="Partner">
                                        <option value="PLG">Phúc Long</option>
                                        <option value="UrBox">UrBox</option>
                                        <option value="GiftBox">GiftBox</option>
                                        <option value="GotIt">GotIt</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12 classPLH">
                                <label style="font-weight: bold">Loại VC</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width: 100%;" id="slIsVoucher" name="IsVoucher">
                                        <option value="X">Voucher</option>
                                        <option value="">Prepaid/OnAccount</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12 classPLH">
                                <label style="font-weight: bold">Khuyến mãi</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width: 100%;" id="slIsEmployee" name="IsEmployee">
                                        <option value="X">Nhân viên</option>
                                        <option value="">Khách hàng</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 classGiftBox" style="display:none">
                                <label style="font-weight:bold">Mã site<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                        @if (listStore != null && listStore.Count > 0)
                                        {
                                            if (listStore.Count == 1)
                                            {
                                                var ht = $"{ listStore.FirstOrDefault().StoreNo} : {listStore.FirstOrDefault().StoreName}";
                                                <option value="@listStore.FirstOrDefault().StoreNo">@ht</option>
                                            }
                                            else
                                            {
                                                foreach (var item in listStore)
                                                {
                                                    var ht = $"{ item.StoreNo} : {item.StoreName}";
                                                    <option value="@item.StoreNo">@ht</option>
                                                }
                                            }
                                        }

                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                <label style="font-weight: bold;">Số Voucher</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="txtKey" name="Voucher" placeholder="Nhập số voucher, cách nhau dấu ;,">
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Kiểm tra</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div id="detail-json" style="display:none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">

        function getJson(json) {
            try {
                $("#detail-json").css("display", "block");
                return JSON.parse(json);
            } catch (ex) {
                $("#detail-json").css("display", "block");
            }
        }

        $(document).ready(function () {

            $('.select2').select2();

            $("#slPartner").on("change", function (e) {
                var partner = $(this).val();
                if (partner == "PLG") {
                    $(".classPLH").css("display", "block");

                    $(".classGiftBox").css("display", "none");
                }
                else {
                    if (partner == "GiftBox") {
                        $(".classGiftBox").css("display", "block");
                    }
                    else {
                        $(".classGiftBox").css("display", "none");
                    }
                    $(".classPLH").css("display", "none");
                }               
            });


            $("#btn-search").on("click", function (e) {
                var partner = $("#slPartner").val();               
                var storeGiftBox = $("#slSiteNo").val();
                var keyWord = $("#txtKey").val();
                if (keyWord == "") {
                    toastr.error("Chưa nhập nội dung tìm kiếm");
                    return;
                }
                if (partner == "GiftBox") {
                    $.confirm({
                        backgroundDismiss: false,
                        escapeKey: true,
                        icon: 'fa fa-warning',
                        type: 'red',
                        typeAnimated: true,
                        title: 'Thông báo',
                        content: '<strong><span style=color:Red>Chú ý:</span> Khi check voucher GiftBox ở CH <span style=color:Red>' + storeGiftBox + '</span> thì chỉ được sử dụng ở CH đó, Nếu sử dụng ở CH khác thì 60 phút sau nhé nhé nhé!!!</strong>',
                        buttons: {
                            "ĐỒNG Ý CHECK": {
                                btnClass: 'btn btn-default',
                                keys: ['ctrl'],
                                action: function () {
                                    CheckAPIVoucher();
                                }
                            },
                            "KHÔNG": {
                                btnClass: 'btn-default',
                                action: function () { }
                            }
                        }
                    });
                }
                else {
                    CheckAPIVoucher();
                }                
            });
        })

        function CheckAPIVoucher() {
            var partner = $("#slPartner").val();
                var isVoucher = $("#slIsVoucher").val();
                var isEmployee = $("#slIsEmployee").val();  
                var storeGiftBox = $("#slSiteNo").val();
                var keyWord = $("#txtKey").val();
                if (keyWord == "") {
                    toastr.error("Chưa nhập nội dung tìm kiếm");
                    return;
                }               

                loading.showloading();
                var fromData = new FormData();
                fromData.append('Partner', partner);
                fromData.append('IsVoucher', isVoucher);
                fromData.append('IsEmployee', isEmployee);
                fromData.append('StoreGiftBox', storeGiftBox);
                fromData.append('ListSerial', keyWord);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Partner_Check", "CheckAPI")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        //debugger
                        var dataResponse = JSON.stringify(data.Data);
                        var jsonResponseCX = JSON.parse(dataResponse);
                        var editor = new JsonEditor('#detail-json', getJson(jsonResponseCX));
                        editor.load(getJson(jsonResponseCX));
                        loading.hideloading();
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });
        }
    </script>
}