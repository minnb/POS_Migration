
@{
    ViewBag.Title = "Kiểm tra Coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>

<style>
    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Check API</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Kiểm tra Coupon</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">                            
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <label style="font-weight: bold;">Mã Coupon</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="txtKey" name="ValueCode" placeholder="Mã coupon cách nhau dấu ;,">
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div id="detail-json" style="display:none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">

        function getJson(json) {
            try {
                $("#detail-json").css("display", "block");
                return JSON.parse(json);
            } catch (ex) {
                $("#detail-json").css("display", "block");
            }
        }

        $(document).ready(function () {

            $('.select2').select2();

            $("#btn-search").on("click", function (e) {               
                var keyWord = $("#txtKey").val();
                if (keyWord == "") {
                    toastr.error("Chưa nhập nội dung tìm kiếm");
                    return;
                }
                loading.showloading();
                var fromData = new FormData();               
                fromData.append('ListCoupon', keyWord);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Coupon_Check", "CheckAPI")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        //debugger
                        var dataResponse = JSON.stringify(data.Data);
                        var jsonResponseCX = JSON.parse(dataResponse);
                        var editor = new JsonEditor('#detail-json', getJson(jsonResponseCX));
                        editor.load(getJson(jsonResponseCX));
                        loading.hideloading();
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });
            });
        })

    </script>
}