@using VCM.BLUEPOS.Model.CrownX;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo hạn mức sử dụng của Masaner";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listOrderType = ViewBag.ListOrderType as List<OptionDataModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">CrownX</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo hạn mức sử dụng của Masaner</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>

    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "CrownX", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Công ty</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-comp-code" name="CompCode">
                                            <option value="">Tất cả</option>
                                            <option value="MSG">Masan Group</option>
                                            <option value="MSC">Masan Consumer</option>
                                            <option value="TCX">The CrownX</option>
                                            <option value="TSA">The Supra</option>
                                            <option value="WCM">WinCommerce</option>
                                            <option value="PLH">Phúc Long</option>
                                            <option value="WPH">Dr.WiN</option>
                                            <option value="WNT">Wintel</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label for="monthyear" style="font-weight:bold">Thời gian</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="monthyear">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right search-month" name="monthyear" id="sel-search-month">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-staff-status" name="StaffStatus">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Có hiệu lực</option>
                                            <option value="1">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="Nhập số thẻ khách hàng / mã nhân viên / tên nhân viên">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" class="btn btn-primary" id="btn-search"><i class="fa fa-search"></i>Tìm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-check-remn-staff-member-mansan" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th>STT</th>
                                    <th>Công ty</th>
                                    <th>Mã nhân viên</th>
                                    <th>Tên nhân viên</th>
                                    <th>Số thẻ khách hàng</th>
                                    <th>Hạn mức</th>
                                    <th>Hạn mức đã sử dụng</th>
                                    <th>Hạn mức còn lại</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái</th>
                                    <th>Hội viên</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="modal-detail-staff-code-list">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-detail-order">Danh sách đơn hàng trong tháng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="modal-detail-staff-code-list-body">
                <div class="card">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-hover text-nowrap" id="tbl-order-list-by-staff">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Cửa hàng</th>
                                    <th>Ngày mua hàng</th>
                                    <th>Số đơn hàng</th>
                                    <th>Loại đơn hàng</th>
                                    <th>Số đơn hàng gốc</th>
                                    <th>Tổng số tiền</th>
                                    @*<th>Mã nhân viên</th>*@
                                    <th>Số thẻ khách hàng</th>
                                    <th>Hội viên</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <input type="hidden" id="view-detail-month-year-temp" name="ViewMonthYear">
            <input type="hidden" id="view-detail-staff-code-temp" name="ViewStaffCode">
            <input type="hidden" id="view-detail-phone-number-temp" name="ViewPhoneNumber">

            <div class="modal-footer">
                <button type="button" id="close-modal-detail-order-list" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

    $(document).ready(function () {

        var table;
        var table_order_list;
        $('.select2').select2();

        $('.search-month').val(moment().format('MM-YYYY'));
        $('.search-month').datepicker({
            format: "mm-yyyy",
            startView: "months",
            minViewMode: "months",
            autoclose: true
        });

        table = $('#tbl-check-remn-staff-member-mansan').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },
                drawCallback: function (settings) {
                    $(".btn-detail-list-staff").click(function () {
                        //debugger
                        var monthYaer = $("#sel-search-month").val();
                        $('#view-detail-month-year-temp').val(monthYaer);

                        var staffCode = $(this).attr("data-staff-code");
                        $('#view-detail-staff-code-temp').val(staffCode);

                        var phoneNumber = $(this).attr("data-phone-number");
                        $('#view-detail-phone-number-temp').val(phoneNumber);

                        table_order_list.draw();

                        $('#modal-detail-staff-code-list').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: true,                 // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("GetStaffMemberRemnList", "CrownX")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.CompCode = $("#sel-comp-code").val();
                        d.MonthYear = $("#sel-search-month").val();
                        d.StaffStatus = $("#sel-staff-status").val();
                        d.TextSearch = $("#txt-text-search").val();
                    }
                },

            columns: [

                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "CompCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400;display:block;text-align:center;">' + row.CompCode + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StaffCode",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StaffCode == null || row.StaffCode == "") {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<a type="button" class="btn-detail-list-staff"   data-staff-code ="' + row.StaffCode + '"  data-phone-number ="' + row.PhoneNumber + '" data-toggle="tooltip" data-placement="left" title="Xem chi tiết"  style="display:block;text-align:center;float:left;" ><span style="font-weight:700;display:block;text-align:center;float:left;"><i class="fa fa-plus-circle" style="color:green;font-size:18px;"></i></span></a>';
                                html += '<span style="font-weight:700;display:block;text-align:center;float:left;padding-left:10px;">' + row.StaffCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "StaffName",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StaffName == null || row.StaffName == "") {
                                html += '<span style="display: block;text-align:left;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display: block;text-align:left;font-weight:400;">' + row.StaffName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PhoneNumber",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PhoneNumber == null || row.PhoneNumber == "") {
                                html += '<span style="display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;text-align:center;">' + row.PhoneNumber + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "InitQuota",  // Hạn mức
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.InitQuota == null || row.InitQuota == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + parseFloat(row.InitQuota).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "QuotaUsed",  // Hạn mức da su dung
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.QuotaUsed == null || row.QuotaUsed == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + parseFloat(row.QuotaUsed).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "RemainQuota",  // Hạn mức con lai
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.RemainQuota == null || row.RemainQuota == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + parseFloat(row.RemainQuota).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Month",  // Thời gian
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Month == null || row.Month == "") {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + row.Month + '</span>';
                            }
                            return html;
                        }
                     },

                    {
                        data: "Blocked",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Blocked == "Hết hiệu lực") {
                                html += '<span style="font-weight:700;display:block;text-align:center; color:red;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;text-align:center; color:green;">' + row.Blocked + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ClubCode",  // Hội viên
                        render: function (data, type, row) {
                        var html = "";
                        if (row.ClubCode == null || row.ClubCode == "") {
                            html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                        }
                        else {
                            html += '<span style="font-weight:400;display:block;text-align:center;">' + row.ClubCode + '</span>';
                        }
                        return html;
                    }
                }
            ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });


        $('#tbl-check-remn-staff-member-mansan tbody').on('click', 'tr', function () {
            $(this).toggleClass('selected');
        });


        $("#btn-search").on("click", function (e) {
            var monthyear = $('.search-month').val();
            if (monthyear == null || monthyear == "") {
                toastr.error('Vui lòng chọn thời gian');
                return;
            }
            table.draw();
        });

        table_order_list = $('#tbl-order-list-by-staff').DataTable({
            initComplete: function (settings, json) {
                $("#tbl-order-list-by-staff").wrap("<div style='overflow:auto; width:100%; position:relative;'></div>");
            },

            destroy: true,
            deferLoading: 0,
            select: {
                style: 'single'
            },
            dom: '<"top"iflp<"clear">>rt',
            paging: true,
            pagingType: "simple_numbers",
            responsive: false,
            processing: false,          // for show progress bar
            serverSide: true,           // for process server side
            filter: false,              // this is for disable filter (search box)
            orderMulti: false,          // for disable multiple column at once
            info: true,                 // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
            autoWidth: false,
            ordering: false,
            displayLength: 10,
            searching: false,
            lengthChange: false,
            scrollCollapse: false,

            ajax: {
                 url: '@Url.Action("GetOrderListByStaffRemn", "CrownX")',
                 type: "POST",
                 datatype: "json",
                 data: function (d) {
                     d.MonthYear = $('#view-detail-month-year-temp').val();  
                     d.StaffCode = $('#view-detail-staff-code-temp').val();
                     d.PhoneNumber = $('#view-detail-phone-number-temp').val();
                 }
            },

            columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null | row.StoreNo == "") {
                                html += '<span style="font-weight:700 display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;text-align:center;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CrtDateStr",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CrtDateStr == null | row.CrtDateStr == "") {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + row.CrtDateStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderNo",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null || row.OrderNo == "") {
                                html += '<span style="display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderType",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderType == null || row.OrderType == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else if (row.OrderType == "Đơn hàng trả") {
                                html += '<span style="display:block;text-align:center;font-weight:700;color:red;">' + row.OrderType + '</span>';
                            } else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.OrderType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ReturnedOrderNo",  // so don hàng gõc
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ReturnedOrderNo == null || row.ReturnedOrderNo == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.ReturnedOrderNo + '</span>';
                            }
                            return html;
                        }
                    },


                    {
                        data: "AmountInclVAT",  // Tông số tiền
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.AmountInclVAT == null || row.AmountInclVAT == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + parseFloat(row.AmountInclVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    //{
                    //    data: "StaffCode",  // ma nhan vien
                    //    render: function (data, type, row) {
                    //        var html = "";
                    //        if (row.StaffCode == null || row.StaffCode == "") {
                    //            html += '<span style="display:block;text-align:center;">' + "" + '</span>';
                    //        }
                    //        else {
                    //            html += '<span style="font-weight:400;display:block;text-align:center;">' + row.StaffCode + '</span>';
                    //        }
                    //        return html;
                    //    }
                    //},

                    {
                        data: "PhoneNumber",  // so the kh
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PhoneNumber == null || row.PhoneNumber == "") {
                                html += '<span style="display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;text-align:center;">' + row.PhoneNumber + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ClubCode",  // Hội viên
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ClubCode == null || row.ClubCode == "") {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + row.ClubCode + '</span>';
                            }
                            return html;
                        }
                    }

            ]

            }).on('processing.dt', function (e, settings, processing)
            {
                if (processing)
                {
                    loading.showloading();
                    var staffCode = $('#view-detail-staff-code-temp').val();
                    $('#modal-title-detail-order').text('Danh sách đơn hàng mua trong tháng - MNV :' + staffCode);
                }
                else
                {
                    loading.hideloading();
                }

                $('#tbl-order-list-by-staff tbody').on('click', 'tr', function () {
                    $(this).toggleClass('selected');
                });

            });


        //$("#btn-export-excel").on("click", function (e) {
        //    var fromDate = getFromDate();
        //    var toDate = getToDate();
        //    if (fromDate > toDate) {
        //        toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
        //        return;
        //    }

        //    $('#hdFromDate').val(fromDate);
        //    $('#hdToDate').val(toDate);
        //    $('#frm-export-excel').submit();

        //});

    });

    </script>
}

<style>
    .ui-datepicker-calendar {
        display: none;
    }
</style>


