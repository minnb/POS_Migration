@using VCM.BLUEPOS.Model.SetupPrice;
@{
    int i = 1;
    var model = Model as ViewSetupItemPriceModel;
    var IsImport = model.IsImport;

    var ListItemResultFromExcel = model.ListItemResultFromExcel;

    var row = model.QtyRow == "" ? 10 : Convert.ToInt32(model.QtyRow);
    var typeSetup = model.TypeSetup;
    var saleGroupCode = model.saleGroupCode;
    var salesType = model.SalesType;
    var region = model.RegionCode;
    var store = model.Store;

    var SalesTypeName = model.SalesTypeName;
    var saleGroupName = model.saleGroupName;
}

    <table id="tblItemPrice" class="table table-bordered table-hover">
        <thead>
            <tr class="text-center">
                <th style="text-align:center;vertical-align:middle">STT</th>
                <th style="text-align:center;vertical-align:middle;display:none;">Mã Hình thức bán hàng</th>
                <th style="text-align:center;vertical-align:middle">Hình thức bán hàng</th>
                <th style="text-align:center;vertical-align:middle;display:none;">Mã Nhóm giá</th>
                <th style="text-align:center;vertical-align:middle">Nhóm giá</th>

                <th style="text-align:center;vertical-align:middle">SẢN PHẨM</th>
                <th style="text-align:center;vertical-align:middle">ĐƠN VỊ TÍNH</th>
                
                <th style="text-align:center;vertical-align:middle">BARCODE</th>
        
                <th style="text-align:center;vertical-align:middle">GIÁ BÁN</th>
                <th style="text-align:center;vertical-align:middle">TỪ NGÀY</th>
                <th style="text-align:center;vertical-align:middle">ĐẾN NGÀY</th>
                <th style="text-align:center;vertical-align:middle">#</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var itemPrice in ListItemResultFromExcel)
            {
                
                <tr class="bgSelect_@i">
                    <td class="text-center" style="vertical-align:middle">@i</td>
                    <td class="text-center" style="vertical-align:middle;display:none;">@salesType</td>
                    <td class="text-center" style="vertical-align:middle">@SalesTypeName</td>
                    <td class="text-center" style="vertical-align: middle; display: none;">@saleGroupCode</td>
                    <td class="text-center" style="vertical-align:middle">@saleGroupName</td>

                    @if (@itemPrice.ErrorMessage == "")
                    {
                    <td class="text-center" style="vertical-align:middle">  
                        <select class="form-control select2 slItem slchangeItem_@i" data-stt="@i" disabled>
                            <option value="@itemPrice.id" data-barcode="@itemPrice.barcode" data-uom="@itemPrice.uom">@itemPrice.text</option>
                        </select>
                    </td>
                    }
                    else
                    {
                        <td class="text-center" style="vertical-align:middle;color:red;"><span class="error error_@i">@itemPrice.ErrorMessage</span></td>
                    }


                    <td class="text-center" style="vertical-align:middle"><span class="dvt_@i">@itemPrice.uom</span></td>

                    <td class="text-center" style="vertical-align:middle">
                        <input type="text" class="form-control barcode changeBarcode_@i" value="@itemPrice.barcode" disabled data-stt="@i" />
                    </td>

                    <td class="text-center" style="vertical-align:middle">
                        <input type="text" class="form-control money" value="@itemPrice.UnitPrice" placeholder="0" data-stt="@i" />
                    </td>

                    <td class="text-center" style="vertical-align:middle">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="far fa-calendar-alt"></i>
                                </span>
                            </div>
                            <input type="text" class="form-control fromDate" value="@Convert.ToDateTime(itemPrice.StartingDate).ToString("dd/MM/yyyy")">
                        </div>
                    </td>
                    <td class="text-center" style="vertical-align:middle">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="far fa-calendar-alt"></i>
                                </span>
                            </div>
                            <input type="text" class="form-control toDate" value="@Convert.ToDateTime(itemPrice.EndingDate).ToString("dd/MM/yyyy")">
                        </div>
                    </td>
                    <td class="text-center" style="vertical-align:middle">
                        <span>
                            <a title="Xóa" class="btn btn-icon btn-light-danger removeItem" data-stt="@i"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                        </span>
                    </td>
                </tr>
                i = i + 1;
            }
        </tbody>
    </table>



<script>

    $(document).ready(function () {
        $(".select2").select2();
        $('.money').mask('000,000,000', {
            placeholder: "0",
            reverse: true,
            rightAlign: true
        });

        var date = new Date();
        var lastDay = new Date(9999, 12, 0);

       // $('.fromDate').val(moment().format("DD/MM/YYYY"));
        $('.fromDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });

        //$('.toDate').val(moment(lastDay).format("DD/MM/YYYY"));
        $('.toDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });
        /*
        $(".slItem").on("change", function () {

            var stt = $(this).attr("data-stt");
            var uom = $(this).find(':selected').data('uom');
            var barcode = $(this).find(':selected').data('barcode');
            var itemNo = $(this).val();
            $(".dvt_" + stt).html(uom);
            $(".changeBarcode_" + stt).val(barcode);

            if (itemNo != "") {
                $(".bgSelect_" + stt).css("background-color", "#f9eddd");
            }
            else {
                $(".bgSelect_" + stt).css("background-color", "#FFFFFF");
            }
        });
        */
        $(".removeItem").on("click", function () {
            var stt = $(this).attr("data-stt");
            $(".bgSelect_" + stt).remove();
        });

        //$(".barcode").on("change", function () {

        //});
        
        
        
    });
</script>
