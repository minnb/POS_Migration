<script>

    $(document).ready(function () {
        $(".slItem").each(function () {
            var stt = $(this).data("stt");
            initRow(stt);
        });

        ///xu ly copy excel vao
        $(document).on("paste", ".barcode", function (e) {
            debugger
            let pasteData = (e.originalEvent || e).clipboardData.getData('text');

            if (!pasteData) return;
            // 🔥 detect Excel
            if (!isExcelData(pasteData)) {
                // 👉 text thường → cho nhập bình thường
                return;
            }
            if (pasteData === "") {
                toastr.error("Copy chưa thành công, vui lòng copy lại");
                resolve();
            }
            e.preventDefault();

            // 👉 tách dòng + cột
            let rows = pasteData.split(/\r?\n/)
                .map(r => r.split(/\t/))
                .filter(r => r.length > 0 );
               // .filter(r => r.length > 0 && r[0]);

            let startStt = $(this).data("stt");

            processExcelFull(rows, startStt);
        });
        //end
    });
    function isExcelData(pasteData) {

        // có xuống dòng (nhiều dòng)
        const hasNewLine = pasteData.includes("\n");

        // có tab (nhiều cột)
        const hasTab = pasteData.includes("\t");

        // 👉 Excel thật sự khi có cả 2
        return hasNewLine && hasTab;
    }
    function handleScanBarcode(input, barcode) {

        return new Promise((resolve, reject) => {

            var row = input.closest("tr");
            var stt = input.data("stt");

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetInfoBarcode", "SetupPrice")',
                data: { barcode: barcode },
                dataType: "json",

                success: function (response) {

                    if (response.Status != 200) {
                        toastr.error(response.Message);
                        return resolve();
                    }
                    if (response.items != null && response.items.length > 0) {
                        var data = response.items[0];

                        setItemAndUom(row, data, "");
                    } else {
                        row.find(".barcode").val("Not found");
                        row.find(".error").val("Not found");
                        row.css("background-color", "#ffe6e6"); 
                    }
                    resolve();
                },
                error: function () {
                    row.find(".barcode").val("Not found");
                    row.find(".error").val("Not found");
                    row.css("background-color", "#ffe6e6"); 
                    //toastr.error("Lỗi hệ thống");
                    resolve();
                }
            });

        });
    }
    function handleScanItem(input, item,uom) {

    return new Promise((resolve, reject) => {
        debugger
        var row = input.closest("tr");
        var stt = input.data("stt");

        $.ajax({
            type: "POST",
            url: '@Url.Action("SearchItem", "SetupPrice")',
            data: { keyword: item },
            dataType: "json",

            success: function (response) {

                if (response.Status != 200) {
                    toastr.error(response.Message);
                    return resolve();
                }
                debugger
                if (response.items != null && response.items.length > 0) {
                    var data = response.items[0];

                    setItemAndUom(row, data, uom);

                    resolve();
                } else {
                    var selectItem = row.find(".slItem");

                    selectItem.empty(); // 🔥 tránh trùng option

                    var option = new Option("Not Found", "Not", true, true);
                    selectItem.append(option).trigger('change');

                    row.css("background-color", "#ffe6e6"); 
                    resolve();
                }
               
            },
            error: function () {
               // debugger
                toastr.error("Lỗi hệ thống");
                resolve();
            }
        });

    });
}
    function setItemAndUom(row, data,i_uom) {
        debugger
        var itemNo = data.id;
        var text = data.text;
        var uom = data.uom;
        var barcode = data.barcode;

        // ===== SET ITEM =====
        var selectItem = row.find(".slItem");

        selectItem.empty(); // 🔥 tránh trùng option

        var option = new Option(text, itemNo, true, true);
        selectItem.append(option).trigger('change');

        // ===== SET UOM =====
        var selectUom = row.find(".slUom");

        selectUom.empty(); // 🔥 clear trước

        if (uom) {

            var uomList = uom.includes(",") ? uom.split(",") : [uom];

            for (var i = 0; i < uomList.length; i++) {

                var iuom = uomList[i].trim();
                if (i_uom === "") {
                    var isSelected = (i === 0);

                    var opt = new Option(iuom, iuom, isSelected, isSelected);
                    selectUom.append(opt);
                } else {
                    if (i_uom === iuom) {
                        var opt = new Option(iuom, iuom, isSelected, isSelected);
                        selectUom.append(opt);
                    } else {
                        var opt = new Option("Not Found", "Not", isSelected, isSelected);
                        selectUom.append(opt);

                        row.css("background-color", "#ffe6e6"); 
                    }
                }
               
            }
        }

        selectUom.trigger("change");

        // ===== SET BARCODE (nếu cần sync lại) =====
        if (barcode) {
            row.find(".barcode").val(barcode);
        }


    }
    async function processExcelFull(list, startStt) {
        //debugger
        for (let index = 0; index < list.length; index++) {

            let stt = startStt + index;
            let row = $(".bgSelect_" + stt);

            if (row.length === 0) {
                addRow();
                row = $(".bgSelect_" + stt);
            }

            let cols = list[index];

            let barcode = cols[2]?.trim();
            let item = cols[0]?.trim();
            let uom = cols[1]?.trim();
            let price = cols[3]?.trim();
            let fromDate = cols[4]?.trim();
            let toDate = cols[5]?.trim();

            if ((barcode === undefined || barcode === null || barcode === "") && (item === undefined || item === null || item === "")) {
                continue;
            }
            // ===== BARCODE =====
            if (barcode != undefined && barcode != null && barcode != "") {
                row.find(".barcode").val(barcode);
                await handleScanBarcode(row.find(".barcode"), barcode); // 🔥 chờ xong
            } else {
                // fallback
                await handleScanItem(row.find(".slItem"), item, uom);
                /*
                if (item) {
                    let selectItem = row.find(".slItem");
                    let option = new Option(item, item, true, true);
                    selectItem.empty();
                    selectItem.append(option).trigger('change');
                }

                if (uom) {
                    let selectUom = row.find(".slUom");
                    let opt = new Option(uom, uom, true, true);
                    selectUom.empty();
                    selectUom.append(opt).trigger("change");
                }
                */
            }

            // ===== PRICE =====
            if (price) {
                row.find(".money").val(price).trigger("input");
            }

            // ===== DATE =====
            if (fromDate) row.find(".fromDate").val(fromDate);
            if (toDate) row.find(".toDate").val(toDate);

            //highlightRow(stt);
        }
    }
   /////////////////////////////////////////////////////////////

    function initRow(stt) {
        /*
$('.slItem').select2({
    data: [
        { id: "1", text: "Laptop Dell" },
        { id: "2", text: "Laptop HP" }
    ]
});
*/
        var row = $(".bgSelect_" + stt);
        row.find('.slUom').select2({
            placeholder: "Chọn UOM",
            width: '100%'
        });

        row.find('.slItem').select2({
            placeholder: "Chọn sản phẩm",

            minimumInputLength: 1,

            language: {
                searching: function () {
                    return "Đang tải dữ liệu...";
                },
                noResults: function () {
                    return "Không tìm thấy dữ liệu";
                }
            },

            ajax: {

                url: '/SetupPrice/SearchItem',

                type: 'POST',

                dataType: 'json',

                delay: 250,

                data: function (params) {

                    return {
                        keyword: params.term,
                        page: params.page || 1
                    };

                },

                processResults: function (data, params) {
                    //console.log(data);
                    params.page = params.page || 1;

                    var more = (params.page * data.pageSize) < data.total;

                    if (!more) {

                        setTimeout(function () {
                            $(".select2-results__options")
                                .append('<li class="select2-results__option text-center" style="color:#999">--- Đã hết dữ liệu ---</li>');
                        }, 100);

                    }

                    return {
                        results: data.items,
                        pagination: {
                            more: more
                        }
                    };

                },

                cache: true
            }

        });
        //$(".select2").select2();
        row.find('.money').mask('000,000,000', {
            placeholder: "0",
            reverse: true,
            rightAlign: true
        });

        var date = new Date();
        var lastDay = new Date(9999, 12, 0);

        row.find('.fromDate').val(moment().format("DD/MM/YYYY"));
        row.find('.fromDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });

        row.find('.toDate').val(moment(lastDay).format("DD/MM/YYYY"));
        row.find('.toDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });

        $(document).on("select2:select", ".slchangeItem_" + stt, function (e) {
            // Xóa barcode khi người dùng chọn sản phẩm từ dropdown
            $(".changeBarcode_" + stt).val("");

            var data = e.params.data;
            // check trung
            var itemNo = data.id;
            var uom = data.uom;
            // check null
            if (!uom) return;

            // split list
            var uomList = uom.includes(",") ? uom.split(",") : [uom];

            if (uomList.length === 1) {
                // lấy UOM đầu tiên để check
                var firstUom = uom && uom.includes(",") ? uom.split(",")[0].trim() : uom;
                if (isDuplicateItem(itemNo, firstUom, stt)) {

                    toastr.warning("Sản phẩm: [" + itemNo + " - " + firstUom + "] đã tồn tại ");

                    // clear dòng hiện tại
                    $(this).val(null).trigger("change");
                    $(".slchangeUom_" + stt).empty().trigger("change");
                    $(".changeBarcode_" + stt).val("");

                    return;
                }
            }
            //end check trung

            var barcode = data.barcode;

            //var uom = data.uom;

            var selectuom = $(".slchangeUom_" + stt);

            // clear
            selectuom.empty();

            // add option
            for (var i = 0; i < uomList.length; i++) {

                var iuom = uomList[i].trim();

                // chỉ selected item đầu tiên
                var isSelected = (i === 0);

                var option = new Option(iuom, iuom, isSelected, isSelected);

                selectuom.append(option);

                $(".changeBarcode_" + stt).val("");
            }
            $(".error_" + stt).text("");
            // trigger 1 lần duy nhất
            selectuom.trigger('change');
            //$(".dvt_" + stt).text(uom);

            // $(".changeBarcode_" + stt).val(barcode);

        });


        row.find(".removeItem").on("click", function () {
            var stt = $(this).attr("data-stt");
            $(".bgSelect_" + stt).remove();
        });

        row.find('.barcode').keydown(function (e) {
            //debugger
            var stt = $(this).attr("data-stt");
            var valueBarecode = $(this).val();
            var key = e.keyCode || e.which;
            if ((key == 13 || key == 9) && valueBarecode != "") {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetInfoBarcode", "SetupPrice")',
                    data: { barcode: valueBarecode },
                    dataType: "json",
                    success: function (response) {
                        //debugger
                        if (response.Status == 200) {
                            debugger
                            var data = response.items;
                            if (data == null || data.length == 0) {
                                toastr.error('không tồn tại ' + valueBarecode);
                                //$(this).css("background", "#d4edda");
                                return;
                            }
                            var itemNo = data[0].id;
                            var uom = data[0].uom;
                            var text = data[0].text;
                            // 🔥 CHECK TRÙNG
                            if (isDuplicateBarcode(valueBarecode, stt)) {

                                toastr.warning("Barcode " + valueBarecode + " đã tồn tại");

                                // clear dòng
                                $(".slchangeItem_" + stt).val(null).trigger("change");
                                $(".slchangeUom_" + stt).empty().trigger("change");
                                $(".changeBarcode_" + stt).val("");
                                $(".barcode[data-stt='" + stt + "']").val("");

                                return;
                            }
                            // ===== set dữ liệu =====
                            // $(".dvt_" + stt).html(uom);
                            var selectuom = $(".slchangeUom_" + stt);
                            var optionUom = new Option(uom, uom, true, true);
                            selectuom.append(optionUom).trigger('change');

                            var select = $(".slchangeItem_" + stt);
                            var optionItem = new Option(text, itemNo, true, true);
                            select.append(optionItem).trigger('change');

                            $(".error_" + stt).text("");
                            //select.select2();
                            //$(".slchangeItem_" + stt).select2('data: [{ id: "1", text: "Laptop Dell" }]');
                        }
                        else {
                            toastr.error(response.Message);
                        }
                    },
                    error: function () {
                        toastr.error('Lỗi hệ thống');
                    }
                });
            }
        });


    }

    function isDuplicateItem(itemNo, uom, currentStt) {
        debugger
        var isDup = false;

        $(".slItem").each(function () {

            var stt = $(this).data("stt");

            if (stt == currentStt) return;

            var item = $(this).val();
            var uomVal = $(".slchangeUom_" + stt).val();

            if (item == itemNo && uomVal == uom) {
                isDup = true;
                return false;
            }
        });

        return isDup;
    }

    function isDuplicateBarcode(barcodeno, currentStt) {
        debugger
        var isDup = false;

        $(".barcode").each(function () {

            var stt = $(this).data("stt");

            if (stt == currentStt) return;
            var barcode = $(".changeBarcode_" + stt).val();

            if (barcode == barcodeno) {
                isDup = true;
                return false;
            }
        });

        return isDup;
    }


</script>