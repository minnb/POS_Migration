@using VCM.BLUEPOS.Model.SyncData;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Đồng bộ dữ liệu theo bảng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lstStore = ViewBag.ListStore as List<StorePartnerModel>;
    var listTable = (List<SyncTableListModel>)ViewBag.ListTableSync;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu theo bảng</a>
                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0px !important;">Mã ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                <select id="slStore" class="form-control select2" multiple="multiple">
                                    @if (lstStore != null && lstStore.Count() > 0)
                                    {
                                        foreach (var item in lstStore)
                                        {
                                            var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                            <option value="@item.SiteNo">@storeName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label class="font-weight-bold" style="margin-bottom: 0px !important;">Group table</label>
                                    <select class="form-control select2" style="width:100%;" id="slGroupName" name="GroupName">
                                        @if (listTable != null && listTable.Count > 0)
                                        {
                                            foreach (var item in listTable)
                                            {
                                                <option value="@item.GroupName">@item.GroupName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label class="font-weight-bold" style="margin-bottom: 0px !important;">Loại counter</label>
                                    <select class="form-control select2" style="width:100%;" id="slCounter" name="Counter">
                                        <option value="LAST">Last change</option>
                                        <option value="ALL">ALL</option>
                                        <option value="INP">Input counter</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="display:none" id="displayCounter">
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Counter</label>
                                    <div class="form-group">
                                        <input type="number" class="form-control" id="txtCounter" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="margin-top:17px;">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary btn-search" style="" id="btnSearch"><i class="fa fa-sync"></i> Đồng bộ</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-header">
                            <h5 class="card-title">Kết quả ST/CH tạo file đồng bộ</h5>
                        </div>
                        <div class="card-body p-0">
                            <div id="divPOSOK"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            $('#slStore').fSelect({
                placeholder: 'Chọn mã CH/ST',
                numDisplayed: 1,
                overflowText: '{n} CH/ST được chọn',
                searchText: 'Tìm kiếm....',
                noResultsText: 'Không tìm thấy CH/ST',
                showSearch: true,
                optionFormatter: false,
                isSelectAll: true
            });

            $("#btnSearch").on("click", function (e) {
                $.confirm({
                    backgroundDismiss: false,
                    escapeKey: true,
                    icon: 'fa fa-warning',
                    type: 'red',
                    typeAnimated: true,
                    title: 'Thông báo',
                    content: 'Bạn có chắc chắn tạo file để đồng bộ data hay không?',
                    buttons: {
                        "CÓ": {
                            btnClass: 'btn btn-default',
                            keys: ['ctrl'],
                            action: function () {
                                SyncTable();
                            }
                        },
                        "KHÔNG": {
                            btnClass: 'btn-default',
                            action: function () { }
                        }
                    }
                });
            });

            $("#slCounter").on("change", function (e) {
                if ($("#slCounter").val() == "INP") {
                    $("#displayCounter").css("display", "block");
                }
                else {
                    $("#displayCounter").css("display", "none");
                }
            });
        });

        function LoadStore() {
            var html = '<select class="form-control" multiple="multiple" style="width: 100%;" id="slSiteNo">';
            var fromData = new FormData();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreNoForSyncDataTable", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value=" + name.SiteNo + ">" + name.DisplayCombo + "</option>";
                            }
                        });
                        html += '</select>';
                        $("#divStoreNo").html(html);

                        $('#slSiteNo').fSelect({
                            placeholder: 'Chọn ST/CH',
                            numDisplayed: 1,
                            overflowText: '{n} ST/CH được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy ST/CH',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true
                        });
                    }
                },
                error: function () {}
            });
        }


        function SyncTable() {
            var storeNo = $('#slStore').val();
            var groupName = $('#slGroupName').val();
            var typeCounter = $('#slCounter').val();
            var counter = $('#txtCounter').val();

            if (storeNo.length == 0) {
                toastr.error("Chưa chọn mã CH/ST");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('GroupName', groupName);
            fromData.append('TypeCounter', typeCounter);
            fromData.append('Counter', counter);

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSyncDataByTable", "SyncData")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    var html = "<ul class=\"nav nav-pills flex-column\">";
                    if (data != null && data.length > 0) {
                        var countError = 0;
                        var countOK = 0;
                        data.forEach((name, i) => {
                            //debugger
                            var check = name.Message.indexOf("OK");
                            if (check != -1) {
                                html += "<li class=\"nav-item active\">";
                                html += "<a class=\"nav-link\">";
                                html += "<i class=\"fas fa-address-card\"></i> " + name.SiteNo + "(" + name.TotalRecord + " record, Filename: " + name.FileName + " )";
                                html += "<span class=\"badge bg-primary float-right\">OK</span>";
                                html += "</a>";
                                html += "</li>";
                            }
                            else {
                                html += "<li class=\"nav-item active\">";
                                html += "<a class=\"nav-link\">";
                                html += "<i class=\"fas fa-address-card\"></i> " + name.SiteNo + " (" + name.Message + ")";
                                html += "<span class=\"badge bg-danger float-right\">Fail</span>";
                                html += "</a>";
                                html += "</li>";
                            }
                        });
                    }
                    else {
                        html += "<li class=\"nav-item active\">";
                        html += "<a class=\"nav-link\">";
                        html += "<i class=\"fas fa-address-card\"></i> Không có file để đồng bộ";
                        html += "</a>";
                        html += "</li>";
                    }
                    html += "</ul>";

                    $("#divPOSOK").html(html);
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }


    </script>
}



