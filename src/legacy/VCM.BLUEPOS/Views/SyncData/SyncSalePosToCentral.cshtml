@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Đồng bộ sale lên central";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = Model as List<StoreModel>;
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ sale lên central</a>
                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">

        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <label style="margin-bottom: 0px !important;font-weight:bold">Mã CH/ST<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                        @if (listStore != null && listStore.Count > 0)
                                        {
                                            <option value="">Vui lòng chọn CH/ST</option>

                                            foreach (var item in listStore)
                                            {
                                                <option value="@item.StoreNo">@item.StoreNo - @item.StoreName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="">
                                <label style="margin-bottom: 0px !important;font-weight:bold">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slPosTerminal" name="POSTerminal">
                                        <option value="">Vui lòng chọn POS</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="margin-bottom: 0px !important;font-weight:bold">Ngày kinh doanh</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="dateBussinessDate" name="BussinessDate" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12" style="margin-top:17px;">
                                <div class="form-group">
                                    <button type="button" class="btn btn-success" id="btnSearch" onclick="SearchSalePOS()"><i class="fa fa-search"></i> Tìm</button>
                                    <button type="button" class="btn btn-primary btn-search" id="btnSyncSale" onclick="SyncSaleToCentral()" style="display:none"><i class="fa fa-sync"></i> Đồng bộ</button>
                                </div>
                            </div>
                        </div>
                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <table class="table table-bordered table-hover text-nowrap" id="tblData">
                                    <thead>
                                        <tr style="text-align:center">
                                            <th>STT</th>
                                            <th>Đơn hàng</th>
                                            <th>Khách hàng</th>
                                            <th>Thu ngân</th>
                                            <th>Amount</th>
                                            <th><input type="checkbox" class="chkAll" id="chkAll" value="" style="height:20px;width:20px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>



    </div>
</div>

@section scripts {
    <script type="text/javascript">

        $('.select2').select2();

        $(document).ready(function () {
            $('#dateBussinessDate').val(moment().format('DD/MM/YYYY'));
            $('#dateBussinessDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $("#slSiteNo").on("change", function (e) {
                var storeNo = $(this).val();
                if (storeNo != "") {
                    ListPosterminal(storeNo);
                }
                else {
                    $('#slPosTerminal').html("<option value='' data-ipaddress=''>Vui lòng chọn POS</option>");
                }
            });

            $("#chkAll").click(function () {

                if ($("#chkAll").is(':checked'))
                    $('.chkOrder').prop('checked', true);
                else
                    $('.chkOrder').prop('checked', false);
            });
        });

        function ListPosterminal(siteCode) {
            $("#slPosTerminal").empty();
            var fromData = new FormData();
            fromData.append('StoreNo', siteCode);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadIPAddressPOSByStoreNo", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";
                    if (data.length > 0) {
                        data.forEach((name, i) => {
                            html += "<option value='" + name.PosID + "' data-ipaddress='" + name.IpAddress + "'>" + name.PosID + "</option>";
                        });
                    }
                    else {
                        html = "<option value='' data-ipaddress=''>Vui lòng chọn POS</option>";
                    }
                    $('#slPosTerminal').html(html);
                },
                error: function () {
                }

            });
        }

        function SearchSalePOS() {
            var storeNo = $('#slSiteNo').val();
            var ipAddress = $('#slPosTerminal').find(':selected').attr('data-ipaddress');
            var posID = $('#slPosTerminal').val();
            var businessDate = $("#dateBussinessDate").val();
            if (storeNo == "" || storeNo.length == 0) {
                toastr.error("Vui lòng chọn mã siêu thị");
                return;
            }
            if (posID == "" || posID.length == 0) {
                toastr.error("Vui lòng chọn POS");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('POSID', posID);
            fromData.append('IPAddress', ipAddress);
            fromData.append('BussinessDate', businessDate);
             $.ajax({
                type: "POST",
                url: '@Url.Action("GetSaleMisCentral", "SyncData")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                 success: function (res) {
                     var html = "";
                     if (res.Status == "true") {
                         var data = res.Data;
                         if (data != null) {
                             if (data.length > 0) {
                                 $("#btnSyncSale").css("display", "inline-block");
                                 var stt = 1;
                                 data.forEach((name, i) => {
                                     html += "<tr id=\"tr" + name.OrderNo+"\">";
                                     html += "<td style=\"text-align:center\">" + stt + "</td>";
                                     html += "<td style=\"text-align:center\">" + name.OrderNo + "</td>";
                                     html += "<td style=\"text-align:center\">" + name.CustomerName + "</td>";
                                     html += "<td style=\"text-align:center\">" + name.CashierID + "</td>";
                                     html += "<td style=\"text-align:center\">" + parseFloat(name.Amount).toLocaleString('en') + "</td>";
                                     html += "<td style=\"text-align:center\"> <input type=\"checkbox\" class=\"chkOrder\" value=" + name.OrderNo + " style=\"height: 18px; width: 18px;\" \></td>";
                                     html += "</tr>";
                                     stt++;
                                 });
                             }
                         }
                         else {
                             $("#btnSyncSale").css("display", "none");
                         }
                     }
                     else {
                         $("#btnSyncSale").css("display", "none");
                         toastr.error("Không kết nối được POS " + posID);
                     }
                     $("#tblData tbody").html(html);
                     loading.hideloading();
                },
                error: function () {
                }
            });

        }


        function SyncSaleToCentral() {
            var listOrder = [];
            $('#tblData input.chkOrder:checkbox:checked').each(function () {
                listOrder.push($(this).val());
            });
            //debugger
            if (listOrder.length == 0) {
                toastr.error("Vui lòng chọn đơn hàng để đồng bộ");
            }
            else {
                $.confirm({
                    backgroundDismiss: false,
                    escapeKey: true,
                    icon: 'fa fa-warning',
                    type: 'red',
                    typeAnimated: true,
                    title: 'Thông báo',
                    content: 'Bạn có chắc chắn đồng bộ ' + listOrder.length + ' đơn hàng này không',
                    buttons: {
                        "CÓ": {
                            btnClass: 'btn btn-default',
                            keys: ['ctrl'],
                            action: function () {
                                loading.showloading();
                                var storeNo = $('#slSiteNo').val();
                                var posID = $('#slPosTerminal').val();
                                var ipAddress = $('#slPosTerminal').find(':selected').attr('data-ipaddress');
                                var businessDate = $("#dateBussinessDate").val();
                                var fromData = new FormData();
                                fromData.append('ListOrder', listOrder);
                                fromData.append('StoreNo', storeNo);
                                fromData.append('PosTerminal', posID);
                                fromData.append('IPAddress', ipAddress);
                                fromData.append('BussinessDate', businessDate);
                                $.ajax({
                                    type: "POST",
                                    url: '@Url.Action("SyncSale", "SyncData")',
                                    data: fromData,
                                    contentType: "application/json",
                                    dataType: "json",
                                    contentType: false,
                                    processData: false,
                                    success: function (data) {
                                        //debugger
                                        var dataOK = data.OK;
                                        var dataFail = data.Fail;
                                        if (dataOK.length > 0) {
                                            dataOK.forEach((name, i) => {
                                                $("#tr" + name.OrderNo).remove();
                                            });
                                            toastr.success("Đồng bộ thành công " + dataOK.length + " đơn hàng");
                                        }
                                        if (dataFail.length > 0) {
                                            toastr.error("Đồng bộ thất bại " + dataFail.length + " đơn hàng");
                                        }
                                        loading.hideloading();
                                    },
                                    error: function () {
                                        loading.hideloading();
                                    }
                                });
                            }
                        },
                        "KHÔNG": {
                            btnClass: 'btn-default',
                            action: function () { }
                        }
                    }
                });
            }
        }
    </script>
}


