@using VCM.BLUEPOS.Model.Store;
@{
    ViewBag.Title = "Query script";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = Model as List<StoreModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Query script</a>
                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Loại kết nối</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slTypeQuery">
                                            <option value="POS">POS</option>
                                            <option value="SERVER">SERVER</option>
                                        </select>
                                    </div>
                                </div>


                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <label id="lbName1" style="font-weight:bold">Cửa hàng</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo">
                                            @if (listSite != null && listSite.Count > 0)
                                            {
                                                if (listSite.Count == 1)
                                                {
                                                    <option value="@listSite.FirstOrDefault().StoreNo">@listSite.FirstOrDefault().DisplayStore</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSite)
                                                    {
                                                        <option value="@item.StoreNo">@item.DisplayStore</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <label id="lbName2" style="font-weight:bold">Máy POS</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slPOS"></select>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <div class="row">
                                        <div class="col-lg-10 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <label style="font-weight:bold">Table</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slTable"></select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <label style="font-weight:bold">TOP</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slTOP">
                                                    <option value="10">10</option>
                                                    <option value="50">50</option>
                                                    <option value="100" selected>100</option>
                                                    <option value="200">200</option>
                                                    <option value="500">500</option>
                                                    <option value="1000">1000</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <div class="row">
                                        <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mb-1">
                                            <label style="font-weight:bold">Column</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slFilter1">
                                                    <option value="">Column</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">
                                            <label style="font-weight:bold">Điều kiện</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slWhere1">
                                                    <option value="=">=</option>
                                                    <option value=">=">>=</option>
                                                    <option value="<="><=</option>
                                                    <option value=">">></option>
                                                    <option value="<"><</option>
                                                    <option value="<>"><></option>
                                                    <option value="LIKE">LIKE</option>
                                                    <option value="IN">IN</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 col-md-12 col-sm-12 col-xs-12 mb-1">
                                            <label style="font-weight:bold">Giá trị cần tìm</label>
                                            <div class="input-group">
                                                <input type="text" id="txtValue1" placeholder="Giá trị cần tìm 1" class="form-control">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">
                                            <label style="font-weight:bold">Sort</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSort1">
                                                    <option value="">Sort</option>
                                                    <option value="ASC">ASC</option>
                                                    <option value="DESC">DESC</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <div class="row">
                                        <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slFilter2">
                                                    <option value="">Column</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slWhere2">
                                                    <option value="=">=</option>
                                                    <option value=">=">>=</option>
                                                    <option value="<="><=</option>
                                                    <option value=">">></option>
                                                    <option value="<"><</option>
                                                    <option value="<>"><></option>
                                                    <option value="LIKE">LIKE</option>
                                                    <option value="IN">IN</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <input type="text" id="txtValue2" placeholder="Giá trị cần tìm 2" class="form-control">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSort2">
                                                    <option value="">Sort</option>
                                                    <option value="ASC">ASC</option>
                                                    <option value="DESC">DESC</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <div class="row">
                                        <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slFilter3">
                                                    <option value="">Column</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slWhere3">
                                                    <option value="=">=</option>
                                                    <option value=">=">>=</option>
                                                    <option value="<="><=</option>
                                                    <option value=">">></option>
                                                    <option value="<"><</option>
                                                    <option value="<>"><></option>
                                                    <option value="LIKE">LIKE</option>
                                                    <option value="IN">IN</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <input type="text" id="txtValue3" placeholder="Giá trị cần tìm 3" class="form-control">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSort3">
                                                    <option value="">Sort</option>
                                                    <option value="ASC">ASC</option>
                                                    <option value="DESC">DESC</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                    <div class="row">
                                        <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slFilter4">
                                                    <option value="">Column</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slWhere4">
                                                    <option value="=">=</option>
                                                    <option value=">=">>=</option>
                                                    <option value="<="><=</option>
                                                    <option value=">">></option>
                                                    <option value="<"><</option>
                                                    <option value="<>"><></option>
                                                    <option value="LIKE">LIKE</option>
                                                    <option value="IN">IN</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <input type="text" id="txtValue4" placeholder="Giá trị cần tìm 4" class="form-control">
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1">

                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSort4">
                                                    <option value="">Sort</option>
                                                    <option value="ASC">ASC</option>
                                                    <option value="DESC">DESC</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
                                <div class="row">
                                    <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-1">
                                        <div class="form-group" style="">
                                            <button type="button" class="btn btn-primary" style="display:block;width:100px" onclick="APPLY()"><i class="la la-plus-circle"></i> APPLY </button>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-1">
                                        <div class="form-group" style="">
                                            <button type="button" class="btn btn-danger" style="display:block;width:100px" onclick="RUN()"><i class="la la-sync"></i> RUN </button>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-1">
                                        <div class="form-group" style="">
                                            <button type="button" class="btn btn-success" style="display:block;width:100px" onclick="ExportExcel()"><i class="la la-file-excel-o"></i> EXCEL </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <textarea cols="1" rows="20" placeholder="select * from a left join b on a.Id=b.Id" class="form-control pull-right" id="txtSql" name="SqlScript"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;"></div>

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                                <div id="listResult" style="width:100%;float:left"></div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

