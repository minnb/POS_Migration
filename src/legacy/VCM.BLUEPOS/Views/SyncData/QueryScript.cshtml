                toastr.error('Vui lòng nhập script', 'Thông báo');
                return;
            }
            if (sql.toLowerCase().indexOf("delete") >= 0){
                toastr.error('Không được phép delete data', 'Thông báo');
                return;
            }
            if (sql.toLowerCase().indexOf("update") >= 0) {
                toastr.error('Không được phép update data', 'Thông báo');
                return;
            }
            if (sql.toLowerCase().indexOf("insert") >= 0) {
                toastr.error('Không được phép insert data', 'Thông báo');
