@section scripts {

    <script type="text/javascript">

        $('.select2').select2();
        var table = "";

        $(document).ready(function () {
           LoadPOSByStore($("#slTypeQuery").val(),$("#slSiteNo").val());
        });

        $("#slTypeQuery").on("change", function (e) {
            if ($(this).val() == "POS") {
                $("#lbName1").html("Cửa hàng");
                $("#lbName2").html("Máy POS");
            }
            else {
                $("#lbName1").html("Server");
                $("#lbName2").html("Database");
            }
            LoadServerStoreNo();

        });

        $("#slSiteNo").on("change", function (e) {
            LoadPOSByStore($("#slTypeQuery").val(),$("#slSiteNo").val());

        });

        $("#slPOS").on("change", function (e) {
            LoadTableByPOS($("#slPOS").val());
        });

        $("#slTable").on("change", function (e) {
            LoadColumByTable($("#slPOS").val(), $("#slTable").val())
        });

        function LoadServerStoreNo() {
            var typeQuery = $("#slTypeQuery").val();

            if (typeQuery == "POS") {//POS
                var fromData = new FormData();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadStoreNo", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "<option value=''>Vui lòng chọn cửa hàng</option>";
                            data.forEach((name, i) => {
                                html += "<option value=" + name.StoreNo + ">" + name.DisplayStore + "</option>";
                            });
                            $("#slSiteNo").html(html);
                        }
                    },
                    error: function () {
                    }
                });
            }
            else {//SERVER
                var fromData = new FormData();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadServerSql", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "<option value=''>Vui lòng chọn server</option>";
                            data.forEach((name, i) => {
                                html += "<option value=" + name.IPServer + "|" + name.UserID + "|" + name.Password + ">" + name.NameSvr + "</option>";
                            });
                            $("#slSiteNo").html(html);
                        }
                    },
                    error: function () {
                    }
                });
            }
        }

        function LoadPOSByStore(typeQuery,storeNo) {

            if (typeQuery == "POS") {
                var html = "<option value=''>Vui lòng chọn máy POS</option>";
                var fromData = new FormData();
                fromData.append('StoreNo', storeNo);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadTerminalByStoreNo", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            data.forEach((name, i) => {
                                if (name.PosTerminalID != "") {
                                    html += "<option value=" + name.IpAddress + ">" + name.PosTerminalID + "-" + name.IpAddress + "</option>";
                                }
                            });
                            $("#slPOS").html(html);
                            //LoadTableByPOS($("#slPOS").val());
                        }
                    },
                    error: function () {
                    }
                });
            }
            else {

                //debugger
                var html = "<option value=''>Vui lòng chọn database</option>";
                var infoserver = $("#slSiteNo").val();
                var ipServer = infoserver.split('|')[0];
                var userServer = infoserver.split('|')[1];
                var passServer = infoserver.split('|')[2];
                var fromData = new FormData();
                fromData.append('IPServer', ipServer);
                fromData.append('UserSA', userServer);
                fromData.append('Password', passServer);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadDatabaseServer", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            data.forEach((name, i) => {
                                    html += "<option value=" + name.DatabaseName + ">" + name.DatabaseName + "</option>";
                            });
                            $("#slPOS").html(html);
                            //LoadTableByPOS($("#slPOS").val());
                        }
                    },
                    error: function () {
                    }
                });

            }
        }

        function LoadTableByPOS(IPAddress) {
            var typeQuery = $("#slTypeQuery").val();
            if (typeQuery == "POS") {
                loading.showloading();
                var fromData = new FormData();
                fromData.append('IPAddress', IPAddress);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadTableByPOS", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "<option value=''>Vui lòng chọn table</option>";
                            data.forEach((name, i) => {
                                html += "<option value=" + name.TABLE_NAME + ">" + name.TABLE_NAME + "</option>";
                            });
                            $("#slTable").html(html);

                            if ($("#slTable").val() == "") {
                                //$("#slFilter1").empty();
                                //$("#slFilter2").empty();
                                //$("#slFilter3").empty();
                                //$("#slFilter4").empty();
                            }
                        }
                        loading.hideloading();
                    },
                    error: function () {
                    }
                });
            }
            else {

                var infoserver = $("#slSiteNo").val();
                var ipServer = infoserver.split('|')[0];
                var userServer = infoserver.split('|')[1];
                var passServer = infoserver.split('|')[2];
                var database = $("#slPOS").val();

                loading.showloading();

                var fromData = new FormData();
                fromData.append('IPServer', ipServer);
                fromData.append('UserSA', userServer);
                fromData.append('Password', passServer);
                fromData.append('Database', database);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadTableByDatabaseSvr", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "<option value=''>Vui lòng chọn table</option>";
                            data.forEach((name, i) => {
                                html += "<option value=" + name.TABLE_NAME + ">" + name.TABLE_NAME + "</option>";
                            });
                            $("#slTable").html(html);

                            if ($("#slTable").val() == "") {
                                //$("#slFilter1").empty();
                                //$("#slFilter2").empty();
                                //$("#slFilter3").empty();
                                //$("#slFilter4").empty();
                            }
                        }
                        loading.hideloading();
                    },
                    error: function () {
                    }
                });

            }
        }

        function LoadColumByTable(IPAddress, TableName) {
            var typeQuery = $("#slTypeQuery").val();
            if (typeQuery == "POS") {
                var fromData = new FormData();
                fromData.append('IPAddress', IPAddress);
                fromData.append('TableName', TableName);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadColumnByTable", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "";
                            data.forEach((name, i) => {

                                html += "<option value=" + name.COLUMN_NAME + ">" + name.COLUMN_NAME + "</option>";

                            });
                            $("#slFilter1").html(html);
                            $("#slFilter2").html(html);
                            $("#slFilter3").html(html);
                            $("#slFilter4").html(html);
                        }
                    },
                    error: function () {
                    }
                });
            }
            else {
                var fromData = new FormData();

                var infoserver = $("#slSiteNo").val();
                var ipServer = infoserver.split('|')[0];
                var userServer = infoserver.split('|')[1];
                var passServer = infoserver.split('|')[2];
                var database = $("#slPOS").val();

                fromData.append('IPServer', ipServer);
                fromData.append('UserSA', userServer);
                fromData.append('Password', passServer);
                fromData.append('Database', database);
                fromData.append('TableName', TableName);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadColumnServerByTable", "SyncData")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            var html = "";
                            data.forEach((name, i) => {
                                html += "<option value=" + name.COLUMN_NAME + ">" + name.COLUMN_NAME + "</option>";
                            });
                            $("#slFilter1").html(html);
                            $("#slFilter2").html(html);
                            $("#slFilter3").html(html);
                            $("#slFilter4").html(html);
                        }
                    },
                    error: function () {
                    }
                });
            }
        }

        function APPLY() {
            var table = $("#slTable").val();
            var top = $("#slTOP").val();

            var column1 = $("#slFilter1").val();
            var column2 = $("#slFilter2").val();
            var column3 = $("#slFilter3").val();
            var column4 = $("#slFilter4").val();

            var where1 = $("#slWhere1").val();
            var where2 = $("#slWhere2").val();
            var where3 = $("#slWhere3").val();
            var where4 = $("#slWhere4").val();

            var value1 = $("#txtValue1").val();
            var value2 = $("#txtValue2").val();
            var value3 = $("#txtValue3").val();
            var value4 = $("#txtValue4").val();

            var sort1 = $("#slSort1").val();
            var sort2 = $("#slSort2").val();
            var sort3 = $("#slSort3").val();
            var sort4 = $("#slSort4").val();

            if (table == "") {
                toastr.error('Vui lòng chọn table', 'Thông báo');
                return;
            }
            var clauseWhere = "";
            var orderby = "";
            var filter1 = value1 != "" ? column1 != "" ? "[" + column1 + "] " + (where1 == "IN" ? " IN(" + value1 + ")" : "" + where1 == "LIKE" ? " LIKE '%" + value1 + "%'" : "" + where1 + "'" + value1 + "'") : "" : "";
            var filter2 = value2 != "" ? column2 != "" ? "[" + column2 + "] " + (where2 == "IN" ? " IN(" + value2 + ")" : "" + where2 == "LIKE" ? " LIKE '%" + value2 + "%'" : "" + where2 + "'" + value2 + "'") : "" : "";
            var filter3 = value3 != "" ? column3 != "" ? "[" + column3 + "] " + (where3 == "IN" ? " IN(" + value3 + ")" : "" + where3 == "LIKE" ? " LIKE '%" + value3 + "%'" : "" + where3 + "'" + value3 + "'") : "" : "";
            var filter4 = value4 != "" ? column4 != "" ? "[" + column4 + "] " + (where4 == "IN" ? " IN(" + value4 + ")" : "" + where4 == "LIKE" ? " LIKE '%" + value4 + "%'" : "" + where4 + "'" + value4 + "'") : "" : "";

            if (filter1 != "" || filter2 != "" || filter3 != "" || filter4 != "") {
                clauseWhere = " WHERE ";
            }

            if (sort4 != "") {
                orderby = " ORDER BY [" + column4 + "] " + sort4;
            }
            if (sort3 != "") {
                orderby = " ORDER BY [" + column3 + "] " + sort3;
            }
            if (sort2 != "") {
                orderby = " ORDER BY [" + column2 + "] " + sort2;
            }
            if (sort1 != "") {
                orderby = " ORDER BY [" + column1 + "] " + sort1;
            }

            var scriptSQL = "SELECT TOP " + top + " * FROM [" + table + "](nolock)" + clauseWhere + filter1 + (filter2 != "" ? " AND " + filter2 : "") + (filter3 != "" ? " AND " + filter3 : "") + (filter4 != "" ? " AND " + filter4 : "") + orderby;
            if (filter1 == "")
                scriptSQL = scriptSQL.replace("AND","");
            $("#txtSql").val(scriptSQL);

        }

        function RUN() {

            var sql = $("#txtSql").val();
