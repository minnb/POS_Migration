@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Kiểm tra đồng bộ sales POS - Central";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = Model as List<StoreModel>;
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Kiểm tra sales POS - Central by Store All</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <label style="margin-bottom: 0px !important;font-weight:bold">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="sl-store-no" name="StoreNo">
                                        @if (listStore != null && listStore.Count > 0)
                                        {
                                            <option value="ALL">Tất cả</option>
                                            @*foreach (var item in listStore)
                                            {
                                                <option value="@item.StoreNo">@item.StoreNo - @item.StoreName</option>
                                            }*@
                                        }
                                    </select>
                                </div>
                            </div>

                            @*<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="">
                                <label style="margin-bottom: 0px !important;font-weight:bold">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slPosTerminal" name="POSTerminal">
                                        <option value="">Vui lòng chọn POS</option>
                                    </select>
                                </div>
                            </div>*@

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="margin-bottom: 0px !important;font-weight:bold">Ngày kinh doanh</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="dateBussinessDate" name="BussinessDate" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12" style="margin-top:17px;">
                                <div class="form-group">
                                    <button type="button" class="btn btn-success" id="btn-search" onclick="GetMissOrderSalesPOSToCentral()"><i class="fa fa-search"></i>Tìm</button>
                                    @*<button type="button" class="btn btn-primary btn-search" id="btnSyncSale" onclick="SyncSaleToCentral()" style="display:none"><i class="fa fa-sync"></i> Đồng bộ</button>*@
                                </div>
                            </div>
                        </div>

                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                        
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <table class="table table-bordered table-hover text-nowrap" id="tbl-miss-order-sales-pos-to-central-list">
                                    <thead>
                                        <tr style="text-align:center">
                                            <th>STT</th>
                                            <th>Ngày kinh doanh</th>
                                            <th>ST/CH</th>
                                            <th>Máy POS</th>
                                            <th>Trạng thái máy POS</th>
                                            <th>Tổng số đơn hàng POS</th>
                                            <th>Tổng số đơn hàng Central</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

