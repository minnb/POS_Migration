@using VCM.BLUEPOS.Model.SyncData;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Đồng bộ dữ liệu POS Web";
    Layout = "~/Views/Shared/_Layout.cshtml";    
    var listStore = ViewBag.ListStore as List<StorePartnerModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đồng bộ dữ liệu POS Web</a>
                    </li>
                </ul>
            </div>
        </div>    

    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0px !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                <select id="sl-store-no" class="form-control" multiple="multiple">
                                    @if (listStore != null && listStore.Count() > 0)
                                    {
                                        foreach (var item in listStore)
                                        {
                                            var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteNo + ":" + item.SiteName;
                                            <option value="@item.SiteNo">@storeName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:17px;">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary btn-search" style="" id="btn-search"><i class="fa fa-sync"></i> Thực hiện</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-header">
                            <h5 class="card-title" style="margin-bottom: 5px;">Kết quả</h5>
                        </div>
                        <div class="card-body p-0" style="padding-top:10px;">
                            <div id="divSyncDataToPOS"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {
    <script type="text/javascript">
        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            $('#sl-store-no').fSelect({
                placeholder: 'Vui lòng chọn ST/CH',
                numDisplayed: 1,
                overflowText: '{n} ST/CH được chọn',
                searchText: 'Tìm kiếm....',
                noResultsText: 'Không tìm thấy ST/CH',
                showSearch: true,
                optionFormatter: false,
                isSelectAll: true,
                includeSelectAllOption: true
            });

            $("#btn-search").on("click", function (e) {
                var storeNo = $('#sl-store-no').val();
                if (storeNo.length == 0) {
                    toastr.error("Vui lòng chọn ST/CH để đồng bộ dữ liệu POS WEB");
                    return;
                }
                $.confirm({
                    backgroundDismiss: false,
                    escapeKey: true,
                    icon: 'fa fa-warning',
                    type: 'red',
                    typeAnimated: true,
                    title: 'Thông báo',
                    content: 'Bạn có chắc chắn muốn đồng bộ dữ liệu POS WEB không?',
                    buttons: {
                        "CÓ": {
                            btnClass: 'btn btn-default',
                            keys: ['ctrl'],
                            action: function () {                
                                SynDataByPOSWEB();
                            }
                        },
                        "KHÔNG": {
                            btnClass: 'btn-default',
                            action: function () {}
                        }
                    }
                });

            });
        });


        function SynDataByPOSWEB() {
            //debugger
            var storeNo1 = $('#sl-store-no').val();
            if (storeNo1.length == 0) {
                toastr.error("Vui lòng chọn ST/CH để đồng bộ dữ liệu POS WEB");
                return;
            }
            var store1 = storeNo1;

            var selectAllStore = $('#sl-store-no > option').prop('selected', true); // Chọn tất cả
            var store2 = selectAllStore;

            var storeNo = "";
            if (store1.length == store2.length) {
                storeNo = "ALL";
            }
            else {
                storeNo = store1; 
            }
            
            $('#loadPartialView').html('');
            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);  // Danh sách Store

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSyncDataByPOSWEB", "SyncData")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    var html = "<ul class=\"nav nav-pills flex-column\">";
                    if (data.Status == 200) {
                        html += "<li class=\"nav-item active\">";
                        html += "<a class=\"nav-link\">";
                        html += "<span class=\"badge bg-primary float-right\" style=\"color:#FFFFFF\">Đồng bộ dữ liệu POS WEB thành công</span>";
                        html += "</a>";
                        html += "</li>";
                    }
                    else {
                        html += "<li class=\"nav-item active\">";
                        html += "<a class=\"nav-link\">";
                        html += "<span class=\"badge bg-danger float-right\" style=\"color:#FFFFFF\">Đồng bộ dữ liệu POS WEB thất bại</span>";
                        html += "</a>";
                        html += "</li>";
                    }
                    html += "</ul>";
                    $("#divSyncDataToPOS").html(html);
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        } 


    </script>
}
