@using VMC.BLUEPOS.Common
@using VCM.BLUEPOS.Model.Common;


@{
    var model = Model as List<ResultExecuteModel>;

    if (model != null && model.Count > 0)
    {
        <table class="table table-bordered" style="width:100%;max-height:500px">
            <thead>
                <tr>
                    <th style='text-align:center;width:120px'>IPAddress</th>
                    <th style='text-align:center;width:120px'>Máy POS</th>
                    <th style='text-align:center;max-width:400px'>Message</th>
                    <th style='text-align:center;width:120px'>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in model)
                {
                <tr>
                    <td>@item.IPAddress</td>
                    <td style="text-align:center;">@item.PosTerminal</td>
                    <td>
                        @{
                            if (item.GetDataTable != null && item.GetDataTable.ToList().Count > 0)
                            {
                                var listTable = item.GetDataTable.ToList();
                                foreach (var item2 in listTable)
                                {
                                    <table class="table table-bordered table-striped table-responsive">
                                        <thead>
                                            <tr>
                                                @foreach (var header in item2.DataColumn)
                                                {
                                                    <th>@header</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var dataRow = item2.DataRow;
                                                for (int i = 0; i < dataRow.Length; i++)
                                                {
                                                    <tr>
                                                        @{var col = dataRow[i];
                                                            for (int j = 0; j < col.Length; j++)
                                                            {
                                                                <td>@col[j]</td>
                                                            }
                                                        }
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                            else
                            {
                                <strong>@Html.Raw(item.Message)</strong>
                            }
                        }
                    </td>
                    <td>
                        @if (item.Status == 1)
                        {
                            var ipReplace = item.IPAddress.Replace(".", "");
                            <span class="badge bg-success" style="color:#fff;">Success</span>
                        }
                        else
                        {
                            <span class="badge bg-danger" style="color:#fff;">Fail</span>
                        }
                    </td>
                </tr>

                }
            </tbody>
        </table>
    }
}
