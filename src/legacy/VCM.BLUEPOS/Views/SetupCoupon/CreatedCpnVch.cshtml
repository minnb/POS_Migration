
@{
    ViewBag.Title = "Tạo mã Voucher/Coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý Voucher</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Tạo mã Voucher / Coupon</a>
                    </li>
                </ul>
            </div>

        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnAddCoupon"><i class="la la-plus-circle"></i> Tạo mã coupon/voucher</button>
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>

        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div id="loadItem">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">

                        <div class="card card-custom">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Mã phát hành</label>
                                            <div class="input-group">
                                                <input type="text" id="searchItemNo" class="form-control" placeholder="Mã phát hành" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Tên phát hành</label>
                                            <div class="input-group">
                                                <input type="text" id="searchDescription" class="form-control" placeholder="Tên phát hành" />
                                            </div>
                                        </div>
                                    </div>
                                    @*<div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold" style="font-weight:bold !important">Cách phát hành</label>
                                                <div class="input-group">
                                                    <select class="form-control select2" style="width:100%;" id="slSearchIssueType" name="IssueType">
                                                        <option value="">Tất cả</option>
                                                        <option value="Auto">Tự động tạo mã</option>
                                                        <option value="Import">Import excel</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>*@
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSearchBlocked" name="Blocked">
                                                    <option value="">Tất cả</option>
                                                    <option value="1">Hiệu lực</option>
                                                    <option value="0">Hết hiệu lực</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <button type="button" id="btnSearch" class="btn btn-primary" style="margin-top:27px;"><i class="fa fa-search"></i> Tìm</button>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>


            <div class="row">

                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <table id="tblData" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center">
                                        <th>STT</th>
                                        <th>MÃ PHÁT HÀNH</th>
                                        <th>MÔ TẢ</th>
                                        <th>ĐVT</th>
                                        <th>LOẠI VC/CP</th>
                                        <th>LOẠI GIẢM GIÁ</th>
                                        <th>GIÁ TRỊ GIẢM</th>
                                        <th>NGÀY BẮT ĐẦU</th>
                                        <th>NGÀY KẾT THÚC</th>
                                        <th>HIỆU LỰC</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @*<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importFileExcel">
                        <div class="form-group">
                            <label class="font-weight-bold" style="font-weight:bold !important">File Excel</label>
                            <div class="custom-file">
                                <input type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" id="browseFileExcel" class="custom-file-input" />
                                <label id="selectedFile" class="custom-file-label" for="browseFileExcel">Chọn file excel</label>
                            </div>
                            <span class="form-text" id="clickDownFileExample" style="cursor:pointer; color:blue"><i class="fas fa-cloud-download-alt" style="color:blue"></i>Download file excel mẫu(chỉ import đúng định dạng file mẫu)</span>
                        </div>

                    </div>*@

            </div>
        </div>

        <div id="updateCoupon" style="display:none">

        </div>
    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table = "";
        $(document).ready(function () {
            $(".select2").select2();
            LoadDataCpnVch();

            $("#btnSearch").on("click", function (e) {
                debugger
                table.search(this.value).draw();
            });

            $("#btnAddCoupon").on("click", function (e) {
                GetInfoCouponVoucher("");

            });


            $("#btnCancle").on("click", function (e) {

                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddCoupon").css("display", "block");

                $("#loadItem").css("display", "block");
                $("#updateCoupon").css("display", "none");

                table.draw();
            });
            $("#btnSave").on("click", function (e) {
                var itemNo = $("#hdtxtItemNo").val();
                var itemName = $("#txtItemName").val();
                var saleType = $("#slSalesType").val();
                var storeGroup = $("#slStoreGroup").val();
                var fromDate = $("#fromDate").val();
                var toDate = $("#toDate").val();

                var articleType = $("#slArticleType").val();
                var typeCpn = $("#slTypeCpn").val();
                var couponCode = "";// $("#txtCouponCode").val();

                var dvt = $("#slUOM").val();
                var discountType = $("#slDiscountType").val();
                var discountValue = $("#txtDiscountValue").val().replace(/\,/g, '');
                var maxAmount = $("#txtMaxAmount").val().replace(/\,/g, '');
                var limitQty = $("#txtLimitQty").val().replace(/\,/g, '');
                var soLanSuDung = $("#txtLimitQtyUsed").val().replace(/\,/g, '');
                
                var isMultiUse = false;
                var checkAPI = true;
                var isBlock = 0;
                var isCheckItem = true;
                if ($("#chkBlocked").prop('checked')) {
                    isBlock = 1;
                }
                if ($("#chkIsCheckItem").prop('checked')) {
                    isCheckItem = false;
                }

                if (itemNo == "") {
                    toastr.error("Vui lòng chọn mã phát hành voucher/coupon");
                    return;
                }

                if (itemName == "") {
                    toastr.error("Vui lòng nhập tên phát hành coupon");
                    return;
                }

                if (fromDate == "") {
                    toastr.error("Vui lòng chọn ngày bắt đầu");
                    return;
                }
                if (toDate == "") {
                    toastr.error("Vui lòng chọn ngày kết thúc");
                    return;
                }
                if (dvt == "") {
                    toastr.error("Vui lòng chọn đơn vị tính");
                    return;
                }
                if (discountValue == "" || discountValue == "0") {
                    toastr.error("Vui lòng nhập giá trị giảm giá");
                    return;
                }

                if (parseInt(discountType) == 1 && parseInt(discountValue) > 100) {
                    toastr.error("Giá trị phần trăm giảm giá không lơn hơn 100");
                    return;
                }

                var arrayItem = [];
                $('#tblItemCoupon tbody tr').each(function (e) {
                    var itemLine = {};
                    var itemNo = $(this).find('td:nth-child(1)').html();
                    var barcode = $(this).find('td:nth-child(2)').html();
                    var itemName = $(this).find('td:nth-child(3)').html();
                    var uom = $(this).find('td:nth-child(4)').html();

                    itemLine['ItemNo'] = itemNo;
                    itemLine['ItemName'] = itemName;
                    itemLine['Barcode'] = barcode;
                    itemLine['UOM'] = uom;

                    arrayItem.push(itemLine);
                });

                var jsonItem = arrayItem.length > 0 ? JSON.stringify(arrayItem) : "";

                loading.showloading();

                var fromData = new FormData();
                fromData.append('ItemNo', itemNo);
                fromData.append('ItemName', itemName);
                fromData.append('ArticleType', articleType);
                fromData.append('CouponCode', couponCode);
                fromData.append('DiscountType', discountType);
                fromData.append('DiscountValue', discountValue);
                fromData.append('CpnVchType', typeCpn);
                fromData.append('StartingDateStr', fromDate);
                fromData.append('EndingDateStr', toDate);
                fromData.append('SaleType', saleType);
                fromData.append('StoreGroupCode', storeGroup);
                fromData.append('UnitOfMeasure', dvt);
                fromData.append('MaxAmount', maxAmount);
                fromData.append('LimitQty', limitQty);
                fromData.append('Blocked', isBlock);
                fromData.append('IsCheckAPI', checkAPI);
                fromData.append('IsMultiUse', isMultiUse);
                fromData.append('IsCheckItem', isCheckItem);
                fromData.append('LimitQtyUsed', soLanSuDung);
                
                fromData.append('JsonItem', jsonItem);

                $.ajax({
                    url: '@Url.Action("SaveCpnVch", "SetupCoupon")',
                    type: "POST",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    data: fromData,
                    success: function (response) {
                        if (response.Status == 200) {
                            debugger
                            toastr.success(response.Message);
                            $("#btnCancle").trigger("click");
                            table.draw();
                            var model = response.Data;
                            $("#hdtxtItemNo").val(model.ItemNo);
                            $(".btnSearchCpnVch").css("display","none");
                        }
                        else {
                            toastr.error(response.Message);
                        }
                        loading.hideloading();

                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });
            });



        });

        function LoadDataCpnVch() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                //paging: true,
               // pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: false, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("SetupCpnVchLoad", "SetupCoupon")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemNo = $("#searchItemNo").val();
                        d.ItemName = $("#searchDescription").val();
                        d.Blocked = $("#slSearchBlocked").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {

                    //$(row).attr('class', "clssRow");
                    //$(row).attr('data-itemno', data.ItemNo);

                   // var a = $(row).find('td:eq(2)').html();
                    $(row).find('.clssRow').attr('data-itemno', data.ItemNo);
                },
                drawCallback: function (settings) {
                    $(".clssRow").click(function () {
                        //var itemOffer = {};
                        var itemNo = $(this).attr("data-itemno");
                        GetInfoCouponVoucher(itemNo);
                        //itemOffer["OfferNo"] = offerNo;

                        //$("#txtMaCTKM").val(offerNo);
                        //$('#chkPromotion').prop('checked', true);
                        //$('#txtMaCTKM').prop('readonly', false);
                        //$("#slOfferType").prop("disabled", true);
                        //$("#displayBtnFinish").css("display", "block");

                        //$('#modalListOfferHeader').modal('hide');
                        //GetOfferHeader(offerNo);
                    });
                },
                columns: [
                    {
                        data: "ItemNo",
                        "className": "text-center clssRow",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "ItemNo",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "ItemName",
                        className: 'clssRow'
                    },
                    {
                        data: "UnitOfMeasure",
                        className: 'text-center clssRow'
                    },
                    {
                        data: "ArticleType",
                        className: 'text-center clssRow'
                    },
                    {
                        data: "DiscountType",
                        className: 'text-center clssRow',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.DiscountType == 1) {
                                html = "Percent(%)";
                            }
                            else if (row.DiscountType == 2){
                                html = "Amount(VNĐ)";
                            }
                            return html;
                        }
                    },
                    {
                        data: "DiscountValue",
                        className: 'text-center clssRow',
                        render: function (data, type, row) {
                            html = parseFloat(row.DiscountValue).toLocaleString("en");
                            return html;
                        }
                    },
                    {
                        data: "StartingDate",
                        className: 'text-center clssRow',
                        render: function (data, type, full, meta) {
                            if (full.StartingDate != null) {
                                return moment(full.StartingDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        }
                    },
                    {
                        data: "EndingDate",
                        className: 'text-center clssRow',
                        render: function (data, type, full, meta) {
                            if (full.EndingDate != null) {
                                return moment(full.EndingDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        }
                    },
                    {
                        data: "Status",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Status == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Hiệu lực</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>";
                            }
                            return html;
                        },
                        className: 'text-center clssRow'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function GetInfoCouponVoucher(itemNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/SetupCoupon/_SetupCouponVoucher?Id=" + itemNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadItem").css("display", "none");
                    $("#updateCoupon").html(result);
                    $("#updateCoupon").css("display", "block");

                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddCoupon").css("display", "none");

                    loading.hideloading();
                },
                error: function (event) {

                }
            });
        }
    </script>
}


