
@{
    ViewBag.Title = "Phát hành coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý Voucher</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Phát hành Coupon</a>
                    </li>
                </ul>
            </div>

        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnAddCoupon"><i class="la la-plus-circle"></i> Phát hành coupon</button>
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>

        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div id="loadItem">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">

                        <div class="card card-custom">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Mã phát hành</label>
                                            <div class="input-group">
                                                <input type="text" id="searchItemNo" class="form-control" placeholder="Mã phát hành" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Tên phát hành</label>
                                            <div class="input-group">
                                                <input type="text" id="searchDescription" class="form-control" placeholder="Tên phát hành" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Cách phát hành</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSearchIssueType" name="IssueType">
                                                    <option value="">Tất cả</option>
                                                    <option value="Auto">Tự động tạo mã</option>
                                                    <option value="Import">Import excel</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSearchBlocked" name="Blocked">
                                                    <option value="">Tất cả</option>
                                                    <option value="1">Hiệu lực</option>
                                                    <option value="0">Hết hiệu lực</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <button type="button" id="btnSearch" class="btn btn-primary" style="margin-top:27px;"><i class="fa fa-search"></i> Tìm</button>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>


            <div class="row">

                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <table id="tblData" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center">
                                        <th>STT</th>
                                        <th>MÃ PHÁT HÀNH</th>
                                        <th>MÔ TẢ</th>
                                        <th>CÁCH PHÁT HÀNH</th>
                                        <th>TIỀN TỐ</th>
                                        <th>KÍCH THƯỚC MÃ</th>
                                        <th>SỐ CHỮ CÁI</th>
                                        <th>VỊ TRÍ ĐỨNG</th>
                                        <th>SỐ LƯỢNG</th>
                                        <th>HIỆU LỰC</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @*<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importFileExcel">
                        <div class="form-group">
                            <label class="font-weight-bold" style="font-weight:bold !important">File Excel</label>
                            <div class="custom-file">
                                <input type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" id="browseFileExcel" class="custom-file-input" />
                                <label id="selectedFile" class="custom-file-label" for="browseFileExcel">Chọn file excel</label>
                            </div>
                            <span class="form-text" id="clickDownFileExample" style="cursor:pointer; color:blue"><i class="fas fa-cloud-download-alt" style="color:blue"></i>Download file excel mẫu(chỉ import đúng định dạng file mẫu)</span>
                        </div>

                    </div>*@

            </div>
        </div>

        <div id="updateCoupon" style="display:none">

        </div>
    </div>
</div>




@section Scripts
{
    <script type="text/javascript">
        var table = "";
        var tableCode = "";
        $(document).ready(function () {
            $(".select2").select2();
            LoadData();

            $("#btnSearch").on("click", function (e) {
                debugger
                table.search(this.value).draw();
            });

            $("#btnAddCoupon").on("click", function (e) {
                GetInfoCoupon("");

            });
            $("#btnCancle").on("click", function (e) {

                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddCoupon").css("display", "block");

                $("#loadItem").css("display", "block");
                $("#updateCoupon").css("display", "none");

                table.draw();
            });
            $("#btnSave").on("click", function (e) {
                var itemNo = $("#hdtxtItemNo").val();
                var itemName = $("#txtItemName").val();
                var saleType = $("#slSalesType").val();
                var storeGroup = $("#slStoreGroup").val();
                var typeIssue = $("#slIssueType").val();
                var prefix = $("#txtPrefix").val();
                var lenCode = $("#txtLenCode").val().replace(/\,/g, '');
                var charOfNumber = $("#txtCharOfNumber").val().replace(/\,/g, '');
                var charPosition = $("#txtCharPosition").val().replace(/\,/g, '');
                var quantity = $("#txtQuantity").val().replace(/\,/g, '');

                var fromDate = $("#fromDate").val();
                var toDate = $("#toDate").val();
                var quantityCodeInDB = $("#hdQuantityCodeDB").val();

                var isCheckItem = true;
                if ($("#chkIsCheckItem").prop('checked')) {
                    isCheckItem = false;
                }

                var files = $("#browseFileExcel").get(0).files;

                if (itemName == "") {
                    toastr.error("Vui lòng nhập tên phát hành coupon");
                    return;
                }

                if (typeIssue == "") {
                    toastr.error("Vui lòng chọn cách phát hành");
                    return;
                }

                if (fromDate == "") {
                    toastr.error("Vui lòng chọn ngày bắt đầu");
                    return;
                }
                if (toDate == "") {
                    toastr.error("Vui lòng chọn ngày kết thúc");
                    return;
                }

                if (typeIssue == "Import") {
                    if (files[0] == null && parseInt(quantityCodeInDB) == 0) {
                        toastr.error("Vui lòng chọn file excel để import");
                        return;
                    }
                }
                else {

                    if (lenCode == "" || lenCode == "0") {
                        toastr.error("Vui lòng nhập kích thước mã");
                        return;
                    }
                    if (charOfNumber == "") {
                        toastr.error("Vui lòng nhập số chữ cái");
                        return;
                    }
                    if (charPosition == "") {
                        toastr.error("Vui lòng nhập vị trí đứng");
                        return;
                    }
                    if (quantity == "" || quantity == "0") {
                        toastr.error("Vui lòng nhập số lượng phát hành");
                        return;
                    }
                    if (parseInt(lenCode) < 5 || parseInt(lenCode) > 20) {
                        toastr.error("Kích thước mã từ 5->20 ký tự");
                        return;
                    }
                }
                var arrayItem = [];
                $('#tblItemCoupon tbody tr').each(function (e) {
                    var itemLine = {};
                    var itemNo = $(this).find('td:nth-child(1)').html();
                    var barcode = $(this).find('td:nth-child(2)').html();
                    var itemName = $(this).find('td:nth-child(3)').html();
                    var uom = $(this).find('td:nth-child(4)').html();

                    itemLine['ItemNo'] = itemNo;
                    itemLine['ItemName'] = itemName;
                    itemLine['Barcode'] = barcode;
                    itemLine['UOM'] = uom;

                    arrayItem.push(itemLine);
                });

                var jsonItem = arrayItem.length > 0 ? JSON.stringify(arrayItem) : "";

                debugger
                loading.showloading();

                var fromData = new FormData();
                fromData.append('ItemNo', itemNo);
                fromData.append('Description', itemName);
                fromData.append('Prefix', prefix);
                fromData.append('LenCode', lenCode);
                fromData.append('IssueType', typeIssue);
                fromData.append('CharOfNumber', charOfNumber);
                fromData.append('CharPosition', charPosition);
                fromData.append('Quantity', quantity);
                fromData.append('StartingDateStr', fromDate);
                fromData.append('EndingDateStr', toDate);
                fromData.append('SaleType', saleType);
                fromData.append('StoreGroupCode', storeGroup);
                fromData.append('QuantityCodeInDB', quantityCodeInDB);
                fromData.append('ImportFile', files[0]);
                fromData.append('IsCheckItem', isCheckItem);
                fromData.append('JsonItem', jsonItem);


                $.ajax({
                    url: '@Url.Action("SaveIssueCoupon", "SetupCoupon")',
                    type: "POST",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    data: fromData,
                    success: function (response) {
                        if (response.Status == 200) {
                            debugger
                            toastr.success(response.Message);
                            //$("#btnCancle").trigger("click");
                            //table.draw();
                            var model = response.Data;
                            $("#hdtxtItemNo").val(model.ItemNo);
                            $("#hdQuantityCodeDB").val(model.QuantityCodeInDB);

                            if (typeIssue == "Auto") {
                                $(".importExcel").css("display", "block");
                                $(".importFileExcel").css("display", "none");

                                $("#txtPrefix").prop("disabled", "disabled");
                                $("#txtLenCode").prop("disabled", "disabled");
                                $("#txtCharOfNumber").prop("disabled", "disabled");
                                $("#txtCharPosition").prop("disabled", "disabled");
                                $("#txtQuantity").prop("disabled", "disabled");
                                $("#slIssueType").prop("disabled", "disabled");

                            }
                            else {
                                $(".importExcel").css("display", "none");
                                $(".importFileExcel").css("display", "block");
                                $("#browseFileExcel").prop("disabled", "disabled");

                            }

                            LoadDataCoupon();
                            tableCode.draw();
                        }
                        else {
                            toastr.error(response.Message);
                            const file = document.querySelector('#browseFileExcel');
                            file.value = '';
                            $("#selectedFile").html("");     
                        }
                        loading.hideloading();

                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });
            });



        });
        function SaveAdvance() {
            var itemNo = $("#hdtxtItemNo").val();
            var saleType = $("#slSalesType").val();
            var storeGroup = $("#slStoreGroup").val();
            var itemName = $("#txtItemName").val();
            var typeIssue = $("#slIssueType").val();
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            var dvt = $("#slUOM").val();
            var typeCpn = $("#slTypeCpn").val();
            var discountType = $("#slDiscountType").val();
            var discountValue = $("#txtDiscountValue").val().replace(/\,/g, '');
            var maxAmount = $("#txtMaxAmount").val().replace(/\,/g, '');
            var limitQty = $("#txtLimitQty").val().replace(/\,/g, '');
            var limitQtyUsed = $("#txtLimitQtyUsed").val().replace(/\,/g, '');


            debugger;
            var isBlock = false;
            if ($("#chkBlocked").prop('checked')) {
                isBlock = true;
            }

            var isMultiUse = false;
            if ($("#chkIsMultiUse").prop('checked')) {
                isMultiUse = true;
            }
            var checkAPI = false;
            if ($("#chkCheckAPI").prop('checked')) {
                checkAPI = true;
            }

            if (isMultiUse == true) {
                if (parseInt(limitQtyUsed) == 0) {
                    toastr.error("Vui lòng nhập số lần sử dụng");
                    return;
                }
            }

            if (itemName == "") {
                toastr.error("Vui lòng nhập tên phát hành coupon");
                return;
            }

            if (typeIssue == "") {
                toastr.error("Vui lòng chọn cách phát hành");
                return;
            }

            if (dvt == "") {
                toastr.error("Vui lòng chọn đơn vị tính");
                return;
            }
            if (discountValue == "" || discountValue == "0") {
                toastr.error("Vui lòng nhập giá trị giảm giá");
                return;
            }

            if (parseInt(discountType) == 1 && parseInt(discountValue) > 100) {
                toastr.error("Giá trị phần trăm giảm giá không lơn hơn 100");
                return;
            }

            if (fromDate == "") {
                toastr.error("Vui lòng chọn ngày bắt đầu");
                return;
            }
            if (toDate == "") {
                toastr.error("Vui lòng chọn ngày kết thúc");
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SaveAdvancedCoupon", "SetupCoupon")',
                type: "POST",
                dataType: "json",
                data: {

                    ItemNo: itemNo,
                    Description: itemName,
                    IssueType: typeIssue,
                    UOM: dvt,
                    CpnVchType: typeCpn,
                    DiscountType: discountType,
                    DiscountValue: discountValue,
                    StartingDateStr: fromDate,
                    EndingDateStr: toDate,
                    MaxValue: maxAmount,
                    Blocked: isBlock,
                    LimitQty: limitQty,
                    IsMultiUsed: isMultiUse,
                    LimitQtyUsed: limitQtyUsed,
                    IsCheckAPI: checkAPI,
                    SaleType: saleType,
                    StoreGroupCode: storeGroup

                },
                success: function (response) {
                    if (response.Status == 200) {
                        toastr.success(response.Message);

                        var model = response.Data;
                        $("#hdtxtItemNo").val(model.ItemNo);

                        //if (typeIssue == "Auto") {
                        //    $(".importExcel").css("display", "block");
                        //    $(".importFileExcel").css("display", "none");

                        //    $("#txtPrefix").prop("disabled", "disabled");
                        //    $("#txtLenCode").prop("disabled", "disabled");
                        //    $("#txtCharOfNumber").prop("disabled", "disabled");
                        //    $("#txtCharPosition").prop("disabled", "disabled");
                        //    $("#txtQuantity").prop("disabled", "disabled");
                        //    $("#slIssueType").prop("disabled", "disabled");

                        //}
                        //else {
                        //    $(".importExcel").css("display", "none");
                        //    $(".importFileExcel").css("display", "block");
                        //    $("#browseFileExcel").prop("disabled", "disabled");
                        //}

                        $('#modalAdvanced').modal('hide');
                    }
                    else {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();

                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }
        function LoadData() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                //paging: true,
               // pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: false, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("SetupCouponLoad", "SetupCoupon")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.IssueType = $("#slSearchIssueType").val();
                        d.ItemNo = $("#searchItemNo").val();
                        d.Description = $("#searchDescription").val();
                        d.Blocked = $("#slSearchBlocked").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {

                    //$(row).attr('class', "clssRow");
                    //$(row).attr('data-itemno', data.ItemNo);

                   // var a = $(row).find('td:eq(2)').html();
                    $(row).find('.clssRow').attr('data-itemno', data.ItemNo);
                },
                drawCallback: function (settings) {
                    $(".clssRow").click(function () {
                        //var itemOffer = {};
                        var itemNo = $(this).attr("data-itemno");
                        GetInfoCoupon(itemNo);
                        //itemOffer["OfferNo"] = offerNo;

                        //$("#txtMaCTKM").val(offerNo);
                        //$('#chkPromotion').prop('checked', true);
                        //$('#txtMaCTKM').prop('readonly', false);
                        //$("#slOfferType").prop("disabled", true);
                        //$("#displayBtnFinish").css("display", "block");

                        //$('#modalListOfferHeader').modal('hide');
                        //GetOfferHeader(offerNo);
                    });
                    $(".deleteItem").on("click", function (e) {
                        var itemNo = $(this).attr("data-itemno");
                        var thongbao = "Bạn có chắc chắn xóa item " + itemNo + " này không?";
                        $.confirm({
                            backgroundDismiss: false,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: thongbao,
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        debugger
                                        var fromData = new FormData();
                                        fromData.append('ItemNo', itemNo);
                                        $.ajax({
                                            type: "POST",
                                            url: '@Url.Action("DeleteItemCoupon", "SetupCoupon")',
                                            data: fromData,
                                            contentType: "application/json",
                                            dataType: "json",
                                            contentType: false,
                                            processData: false,
                                            success: function (data) {
                                                if (data.Status == 200) {
                                                    toastr.success(data.Message);
                                                    table.draw();
                                                }
                                                else {
                                                    toastr.error(data.Message);
                                                }

                                            },
                                            error: function () {
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });
                },
                columns: [
                    {
                        data: "ItemNo",
                        "className": "text-center clssRow",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "ItemNo",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "Description",
                        className: 'clssRow'
                    },
                    {
                        data: "IssueType",
                        className: 'text-center clssRow'
                    },
                    {
                        data: "Prefix",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "LenCode",
                        className: 'text-center clssRow'

                    },
                    //{
                    //    data: "IssueType"

                    //},
                    {
                        data: "CharOfNumber",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "CharPosition",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "QtyCoupon",
                        render: function (data, type, row) {
                            var html = "";
                            html = parseInt(row.QtyCoupon).toLocaleString("en");

                            return html;
                        },
                        className: 'text-center clssRow'
                    },
                    {
                        data: "Blocked",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Status == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Hiệu lực</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>";
                            }
                            return html;
                        },
                        className: 'text-center clssRow'
                    },
                    {
                        data: "ItemNo",
                        render: function (data, type, full, meta) {
                            var html = "";
                            if (parseInt(full.QtyCoupon) == 0) {
                                html += "<a title=\"Xóa item coupon\" style=\"height:30px\" data-itemno='" + full.ItemNo + "' class=\"btn btn-icon btn-light-danger deleteItem\"><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                            }
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function GetInfoCoupon(itemNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/SetupCoupon/_SetupCoupon?Id=" + itemNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadItem").css("display", "none");
                    $("#updateCoupon").html(result);
                    $("#updateCoupon").css("display", "block");

                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddCoupon").css("display", "none");

                    loading.hideloading();
                },
                error: function (event) {

                }
            });
        }

        function LoadDataCoupon() {

        tableCode = $('#tblDataCoupon').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                responsive: true,
                processing: false,      // for show progress bar
                serverSide: true,       // for process server side
                filter: false,          // this is for disable filter (search box)
                orderMulti: false,      // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("CouponCodeLoad", "SetupCoupon")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemNo = $("#hdtxtItemNo").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {
                    $(row).attr('id', "rowRecord" + data.ID);
                },
                drawCallback: function (settings) {
                },
                columns: [
                    {
                        data: "ItemNo",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "Code",
                        className: 'text-center'
                    },
                    {
                        data: "Enable",
                        render: function (data, type, row) {

                            var html = "";
                            if (row.Enable == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                            }
                            return html;
                        },
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }
    </script>
}


