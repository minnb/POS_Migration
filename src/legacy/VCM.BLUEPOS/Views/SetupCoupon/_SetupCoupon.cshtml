@using VCM.BLUEPOS.Model.SetupCoupon;
@using VCM.BLUEPOS.Model.SetupPromotion;
@{
    var model = Model as ViewSetupCouponModel;
    var listUOM = model.ListUOM;
    var cpnRule = model.CpnRule;
    var listIssueType = model.ListIssueType;
    var listSalesType = model.ListSalesType;
    var listStoreGroup = model.ListStoreGroup;
    var quantityCode = model.QuantityCode;
    var listCpnItemLine = model.ListItemLine;

    string itemNo = "", description = "", uom = "", saleType = "", storeGroup = "";
    int discountType = 0;
    double discountValue = 0;
    var fromDate = "";
    var toDate = "";
    string cpnType = "";
    string preFix = "";
    int lenCode = 0;
    string issueType = "";
    int charNumber = 0;
    int charPosition = 0;
    var createdDate = new DateTime();
    var displayCachPhatHanh = "";
    var displayEdit = "";
    var disableBrowse = "";
    var isCheckItem = false;
    if (!string.IsNullOrEmpty(cpnRule.ItemNo))
    {
        itemNo = cpnRule.ItemNo;
        description = cpnRule.Description;
        uom = cpnRule.UOM;
        discountType = cpnRule.DiscountType ?? 0;
        discountValue = cpnRule.DiscountValue ?? 0;
        fromDate = cpnRule.StartingDate == null ? "" : cpnRule.StartingDate.Value.ToString("dd/MM/yyyy");
        toDate = cpnRule.EndingDate == null ? "" : cpnRule.EndingDate.Value.ToString("dd/MM/yyyy");
        cpnType = cpnRule.CpnVchType;
        preFix = cpnRule.Prefix;
        lenCode = cpnRule.LenCode ?? 0;
        issueType = cpnRule.IssueType;
        charNumber = cpnRule.CharOfNumber ?? 0;
        charPosition = cpnRule.CharPosition ?? 0;
        createdDate = (DateTime)cpnRule.CreatedDate;
        saleType = cpnRule.SaleType;
        storeGroup = cpnRule.StoreGroupCode;
        displayCachPhatHanh = "disabled";
        isCheckItem = cpnRule.IsCheckItem ?? false;
    }
    if (quantityCode > 0 && !string.IsNullOrEmpty(cpnRule.ItemNo))
    {
        displayEdit = "disabled";
        disableBrowse = "disabled";
    }
    var checkItem = string.IsNullOrEmpty(cpnRule.ItemNo) ? "" : (isCheckItem == false ? "checked" : "");
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
            <div class="card card-custom">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã phát hành</label>
                                        <div class="input-group">
                                            <input type="text" id="hdtxtItemNo" class="form-control" disabled value="@itemNo" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên phát hành</label>
                                        <div class="input-group">
                                            <input type="text" id="txtItemName" class="form-control" value="@description" />
                                            <div class="input-group-append">
                                                <button class="btn btn-primary" type="button" id="btnAdvanced"><i class="flaticon2-gear"></i>Advanced</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Cách phát hành</label>
                                        <div class="input-group">
                                            <select class="form-control select2" @displayCachPhatHanh style="width:100%;" id="slIssueType" name="IssueType">
                                                @if (listIssueType != null && listIssueType.Count > 0)
                                                {
                                                    foreach (var item in listIssueType)
                                                    {
                                                        var selected = item.IssueType == issueType ? "selected" : "";
                                                        <option @selected value="@item.IssueType">@item.IssueName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hình thức bán hàng</label>
                                        <div class="input-group">
                                            <select class="form-control select2" style="width:100%;" id="slSalesType" name="SalesType">
                                                @if (listSalesType != null && listSalesType.Count > 0)
                                                {
                                                    <option value="ALL">ALL</option>
                                                    foreach (var item in listSalesType)
                                                    {
                                                        var selected = item.Code == saleType ? "selected" : "";
                                                        <option @selected value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="fromDate" name="StartingDate" value="@fromDate">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="toDate" name="EndingDate" value="@toDate">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Nhóm cửa hàng</label>
                                        <div class="input-group">
                                            <select class="form-control select2" style="width:100%;" id="slStoreGroup" name="StoreGroupCode">
                                                @if (listStoreGroup != null && listStoreGroup.Count > 0)
                                                {
                                                    <option value="ALL">ALL</option>
                                                    foreach (var item in listStoreGroup)
                                                    {
                                                        var selected = item.GroupCode == storeGroup ? "selected" : "";
                                                        <option @selected value="@item.GroupCode">@item.GroupCode</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tiền tố</label>
                                        <div class="input-group">
                                            <input type="text" id="txtPrefix" @displayEdit class="form-control" value="@preFix" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Kích thước mã (5->20)</label>
                                        <div class="input-group">
                                            <input type="text" id="txtLenCode" @displayEdit class="form-control money" value="@lenCode" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số chữ cái</label>
                                        <div class="input-group">
                                            <input type="text" id="txtCharOfNumber" @displayEdit class="form-control money" value="@charNumber" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Vị trí đứng</label>
                                        <div class="input-group">
                                            <input type="text" id="txtCharPosition" @displayEdit class="form-control money" value="@charPosition" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số lượng</label>
                                        <div class="input-group">
                                            <input type="text" id="txtQuantity" @displayEdit class="form-control money" value="@quantityCode" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 importFileExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">File Excel</label>
                                        <div class="custom-file">
                                            <input type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" id="browseFileExcel" @disableBrowse class="custom-file-input" />
                                            <label id="selectedFile" class="custom-file-label" for="browseFileExcel">Chọn file excel</label>
                                        </div>
                                        <span class="form-text" id="clickDownFileExample" style="cursor:pointer; color:#3699FF"><i class="fas fa-cloud-download-alt" style="color:#3699FF"></i>Download file excel mẫu(chỉ import đúng định dạng file mẫu)</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                    <div class="input-group" style="margin-top:27px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <label class="checkbox checkbox-inline" title="Tổng hóa đơn">
                                                    <input type="checkbox" @checkItem id="chkIsCheckItem" class="chkIsCheckItem" />
                                                    <span></span>
                                                </label>
                                            </span>
                                        </div>
                                        <div class="input-group-append"><span class="input-group-text">Tổng hóa đơn</span></div>
                                    </div>

                                </div>
                            </div>
                            </div>
                        </div>

                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                    
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <ul class="nav nav-tabs" id="myTab" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link classTab active" id="listItem-tab" data-toggle="tab" href="#listItem">

                                        <span class="nav-text font-weight-bold" style="font-weight:bold !important">
                                            Danh sách sản phẩm coupon
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link classTab" id="listCoupon-tab" data-toggle="tab" href="#listCoupon" aria-controls="profile">
                                        <span class="nav-text font-weight-bold" style="font-weight:bold !important">Danh sách phát hành couupon</span>
                                    </a>
                                </li>

                            </ul>
                            <div class="tab-content mt-5" id="myTabContent">
                                <div class="tab-pane fade show active" id="listItem" role="tabpanel" aria-labelledby="listItem-tab">
                                    <div class="card card-custom">
                                        <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                                            <div class="card-title">
                                                <h3 class="card-label">
                                                    <i class="fas fa-barcode"></i>
                                                    Danh sách sản phẩm
                                                </h3>
                                            </div>

                                            <div class="card-toolbar">
                                                <a style="cursor:pointer" class="btn btn-primary font-weight-bolder btnAddItem">
                                                    <i class="la la-plus-circle"></i>
                                                    Thêm sản phẩm
                                                </a>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <table id="tblItemCoupon" class="table table-bordered text-nowrap">
                                                <thead>
                                                    <tr style="background-color:#eaeaf0 !important">
                                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Mã sản phẩm</th>
                                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Barcode</th>
                                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Tên sản phẩm</th>
                                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Đơn vị tính</th>
                                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">#</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="text-align:center">
                                                    @if (listCpnItemLine != null && listCpnItemLine.Count > 0)
                                                    {
                                                        foreach (var item in listCpnItemLine)
                                                        {
                                                            <tr class="itemCoupon_@item.ItemNo">
                                                                <td>@item.ItemNo</td>
                                                                <td>@item.Barcode</td>
                                                                <td>@item.ItemName</td>
                                                                <td>@item.UOM</td>
                                                                <td style="text-align:center;vertical-align:middle">
                                                                    <a title="Xóa" class="btn btn-icon btn-light-danger btnItemCouponDelete" data-itemno="@item.ItemNo"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="listCoupon" role="tabpanel" aria-labelledby="listCoupon-tab">
                                    <div class="card card-custom">
                                        <table id="tblDataCoupon" class="table table-bordered table-hover">
                                            <thead>
                                                <tr class="text-center">
                                                    <th>STT</th>
                                                    <th>MÃ COUPON</th>
                                                    <th>TRẠNG THÁI</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div style="display:none">
    <input type="hidden" id="hdQuantityCodeDB" value="@quantityCode" />
</div>


<div class="modal fade" id="modalAdvanced" tabindex="-1" role="dialog" aria-hidden="true">
    <div id="divPopupSetupAdvanceCoupon"></div>
</div>


<div class="modal fade" id="modalListItemCoupon" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">THÊM SẢN PHẨM COUPON</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupListItemCoupon"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Hủy</button>
                <button type="button" class="btn btn-light-primary font-weight-bold btnSelectedItemCoupon"><i class="la la-check"></i>Chọn</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    
    $(".select2").select2();

        if ('@issueType' == "Auto") {
            $(".importExcel").css("display", "block");
            $(".importFileExcel").css("display", "none");
        }
        else {
            $(".importExcel").css("display", "none");
            $(".importFileExcel").css("display", "block");
        }

        $('#fromDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });

        $('#toDate').datepicker({
            format: 'dd/mm/yyyy',
            autoUpdateInput: false,
            todayHighlight: true,
            singleDatePicker: true,
            autoclose: true
        });


        $('.money').mask('000,000,000', {
            placeholder: "0",
            reverse: true,
            rightAlign: true
        });

        $("#slIssueType").on("change", function () {
            var issueType = $(this).val();
            if (issueType == "Auto") {
                $(".importExcel").css("display", "block");
                $(".importFileExcel").css("display", "none");
            }
            else {
                $(".importExcel").css("display", "none");
                $(".importFileExcel").css("display", "block");
            }
        });

        $("#btnAdvanced").on("click", function () {
            var itemNo = $("#hdtxtItemNo").val();
            var itemName = $("#txtItemName").val();
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            if (itemName == "") {
                toastr.error("Vui lòng nhập tên phát hành coupon");
                return;
            }
            if (fromDate == "") {
                toastr.error("Vui lòng chọn ngày bắt đầu");
                return;
            }
            if (toDate == "") {
                toastr.error("Vui lòng chọn ngày kết thúc");
                return;
            }

            var fromData = new FormData();
            fromData.append('itemNo', itemNo);
            $.ajax({
                type: "POST",
                url: '@Url.Action("PopupAdvanceCoupon", "SetupCoupon")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (result) {
                    if (result.Status == 200) {
                        var viewHtml = result.ViewPartial;
                        $("#divPopupSetupAdvanceCoupon").html(viewHtml);
                        $('#modalAdvanced').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    }
                    else {
                        toastr.error(result.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
    });

    $("#clickDownFileExample").click(function (e) {
        loading.showloading();
        e.preventDefault();
        var req = new XMLHttpRequest();
        var url = "/SetupCoupon/ExcelExampleCoupon";
        req.open("GET", url, true);
        req.responseType = "blob";
        req.onload = function (event) {
            //debugger
            var blob = req.response;
            console.log(blob.size);
            if (blob.size > 10) {
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "FileMauCoupon_" + fileName + ".xlsx";
                link.click();
            }
            else {
                toastr.error("Excel không có dữ liệu, nên không xuất được");
            }
            loading.hideloading();
        };
        req.send();

    });

    $("input[type='file']").change(function () {
        //debugger
        $('#selectedFile').text(this.value.replace(/C:\\fakepath\\/i, ''));
    });

    $(".btnAddItem").on("click", function (e) {
        $.ajax({
            type: "GET",
            url: "/SetupCoupon/_ViewListItemCoupon",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#divPopupListItemCoupon").html(result);
                $('#modalListItemCoupon').modal({
                    backdrop: 'static',
                    keyboard: false
                });
                loading.hideloading();
            },
            error: function (event) {
                loading.hideloading();
            }
        });
    });

    $(".btnSelectedItemCoupon").on("click", function (e) {
        var isAllStore = $('.fs-label-wrap').attr('data-selectall');
        if (isAllStore == 1) {
            $("#txtListStore").val('')
        }
        else {
            var arrayItem = [];
            var listStore = $('#slItemCoupon').val();
            var listStoreInArea = $("#viewListItemNoCoupon").val();
            if (listStoreInArea == "") {
                $("#viewListItemNoCoupon").val(listStore.join(";"));
            }
            else {
                $('.fs-option').removeClass('selected');
                $.each(listStoreInArea.split(/\;*\b\,*\ */), function (i, e) {
                    $(".fs-option[data-value='" + e + "']").toggleClass('selected');
                    arrayItem.push(e);
                });
                $("#slItemCoupon").val(arrayItem);
                $("#slItemCoupon").fSelect('reloadDropdownLabel');
            }
        }

        var listCoupon = $('#slItemCoupon').val();
        if (listCoupon.length > 0) {
            var arrayItemArea = [];
            var jsonItem = JSON.stringify(listCoupon);
            var listCouponInArea = $("#viewListItemNoCoupon").val();
            $.each(listCouponInArea.split(/\;*\b\,*\ */), function (i, e) {
                $(".fs-option[data-value='" + e + "']").toggleClass('selected');
                arrayItemArea.push(e);
            });

            //debugger
            var valItem = JSON.stringify(arrayItemArea);
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CheckListItemExists", "SetupCoupon")',
                type: "POST",
                dataType: "json",
                data: {
                    jsonItem: jsonItem,
                    jsonItemArea: valItem
                },
                success: function (response) {
                    //debugger
                    if (response.Status == 200) {
                        var html = "";
                        var arraySelectedItem = response.Data;
                        $('#tblItemCoupon tbody tr').each(function () {
                            var itemNoCurrent = $(this).find('td:nth-child(1)').html();
                            arraySelectedItem = arraySelectedItem.filter(item => item.ItemNo !== itemNoCurrent);
                        });
                        arraySelectedItem.forEach((name, i) => {
                            html += "<tr class=\"itemCoupon_" + name.ItemNo + "\">";
                            html += "<td>" + name.ItemNo + "</td>";
                            html += "<td>" + name.Barcode + "</td>";
                            html += "<td>" + name.ItemName + "</td>";
                            html += "<td>" + name.UOM + "</td>";
                            html += "<td>";
                            html += "<a title=\"Xóa\" class=\"btn btn-icon btn-light-danger btnItemCouponDelete\" data-itemno=" + name.ItemNo + "><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                            html += "</td>";
                            html += "</tr>";
                        });

                        $("#tblItemCoupon tbody").append(html);
                        $('#modalListItemCoupon').modal('hide');

                        $(".btnItemCouponDelete").on("click", function (e) {
                            var itemNo = $(this).attr("data-itemno");
                            $(".itemCoupon_" + itemNo).remove();
                        });
                    }
                    else {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }
        else {
            toastr.error("Vui lòng chọn sản phẩm coupon");
        }
    });

    $(".btnItemCouponDelete").on("click", function (e) {
        var itemNo = $(this).attr("data-itemno");
        $(".itemCoupon_" + itemNo).remove();
    });

    LoadDataCoupon();

</script>
