
@{
    ViewBag.Title = "Phát hành mã dự thưởng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Loyalty</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Phát hành mã dự thưởng</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnAddExtraFee"><i class="la la-plus-circle"></i> Phát hành mã dự thưởng</button>
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div id="loadExtraFee">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card card-custom">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Mã dự thưởng</label>
                                            <div class="input-group">
                                                <input type="text" id="searchRewardNo" class="form-control" placeholder="Mã dự thưởng" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Tiêu đề</label>
                                            <div class="input-group">
                                                <input type="text" id="searchRewardTitle" class="form-control" placeholder="Tiêu đề" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSearchEnalbe" name="Enalbe">
                                                    <option value="">Tất cả</option>
                                                    <option value="1">Hiệu lực</option>
                                                    <option value="0">Hết hiệu lực</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <button type="button" id="btnSearch" class="btn btn-primary" style="margin-top:27px;"><i class="fa fa-search"></i> Tìm</button>
                                    </div>
                                </div>

                                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                                
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">

                                        <table id="tblData" class="table table-bordered table-hover">
                                            <thead>
                                                <tr class="text-center">
                                                    <th>STT</th>
                                                    <th>MÃ DỰ THƯỞNG</th>
                                                    <th>TIÊU ĐỀ</th>
                                                    <th>KHUYẾN MÃI</th>
                                                    <th>TỪ NGÀY</th>
                                                    <th>ĐẾN NGÀY</th>
                                                    <th>TRẠNG THÁI</th>
                                                    @*<th>#</th>*@
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="updateExtraFee" style="display:none">

        </div>
    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        var table = "";
        var tableCode = "";

        $(document).ready(function () {

            $(".select2").select2();
            LoadDataReward();

            $("#btnSearch").on("click", function (e) {
                table.search(this.value).draw();
            });

            $("#btnAddExtraFee").on("click", function (e) {
                GetInfoReward("");
            });

            $("#btnCancle").on("click", function (e) {
                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddExtraFee").css("display", "block");

                $("#loadExtraFee").css("display", "block");
                $("#updateExtraFee").css("display", "none");
                table.draw();
            });

            $("#btnSave").on("click", function (e) {
                var rewardNo = $("#hdtxtRewardNo").val();
                var title = $("#txtTitle").val();
                var offerNo = $("#txtOfferNo").val();
                var link = $("#txtLink").val();
                var mota = $("#txtDescription").val();
                var fromDate = $("#fromDate").val();
                var toDate = $("#toDate").val();

                var files = $("#browseFileExcel").get(0).files;

                var isCheckStatus = false;
                if ($("#chkStatus").prop('checked')) {
                    isCheckStatus = true;
                }

                var isChkReWard = false;
                if ($("#chkIsReWard").prop('checked')) {
                    isChkReWard = true;
                }

                if (title == "") {
                    toastr.error("Vui lòng nhập tiêu đề dự thưởng");
                    return;
                }
                if (offerNo == "") {
                    toastr.error("Vui lòng CTKM dự thưởng");
                    return;
                }

                if (fromDate == "") {
                    toastr.error("Vui lòng chọn ngày bắt đầu");
                    return;
                }
                if (toDate == "") {
                    toastr.error("Vui lòng chọn ngày kết thúc");
                    return;
                }

                if (isChkReWard==true && files[0] == null && rewardNo == "") {
                    toastr.error("Vui lòng chọn file excel để import");
                    return;
                }

                loading.showloading();

                var fromData = new FormData();
                fromData.append('RewardNo', rewardNo);
                fromData.append('Title', title);
                fromData.append('Link', link);
                fromData.append('Description', mota);
                fromData.append('Enabled', isCheckStatus);
                fromData.append('IsReward', isChkReWard);
                fromData.append('FromDateStr', fromDate);
                fromData.append('ToDateStr', toDate);
                fromData.append('OfferNo', offerNo);
                fromData.append('ImportFile', files[0]);

                $.ajax({
                    url: '@Url.Action("SaveReward", "Reward")',
                    type: "POST",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    data: fromData,
                    success: function (response) {
                        if (response.Status == 200) {
                            toastr.success(response.Message);
                            LoadDataReward();
                            $("#hdtxtRewardNo").val('');
                            $("#btnCancle").trigger("click");
                        }
                        else {
                            toastr.error(response.Message);
                        }
                        loading.hideloading();
                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });

            });
        });

        function LoadDataReward() {

            table = $('#tblData').DataTable({

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                responsive: true,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("RewardIssueLoad", "Reward")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.RewardNo = $("#searchRewardNo").val();
                        d.Title = $("#searchRewardTitle").val();
                        d.OfferNo = "";
                        d.Enable = $("#slSearchEnalbe").val();


                    }
                },
                createdRow: function (row, data, dataIndex) {

                    //$(row).attr('class', "clssRow");
                    //$(row).attr('data-itemno', data.ItemNo);

                   // var a = $(row).find('td:eq(2)').html();
                    $(row).find('.clssRow').attr('data-code', data.RewardNo);
                },

                drawCallback: function (settings) {
                    $(".clssRow").click(function () {
                        //debugger
                        var code = $(this).attr("data-code");
                        GetInfoReward(code);
                    });

                    $(".deleteExtraFee").on("click", function (e) {
                        var code = $(this).attr("data-code");
                        var thongbao = "Bạn có chắc chắn xóa phụ thu " + code + " này không?";
                        $.confirm({
                            backgroundDismiss: false,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: thongbao,
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        //debugger
                                        var fromData = new FormData();
                                        fromData.append('Code', code);
                                        $.ajax({
                                            type: "POST",
                                            url: '@Url.Action("DeleteExtraFee", "ExtraFee")',
                                            data: fromData,
                                            contentType: "application/json",
                                            dataType: "json",
                                            contentType: false,
                                            processData: false,
                                            success: function (data) {
                                                if (data.Status == 200) {
                                                    toastr.success(data.Message);
                                                    table.draw();
                                                }
                                                else {
                                                    toastr.error(data.Message);
                                                }

                                            },
                                            error: function () {
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });
                },
                columns: [
                    {
                        data: "RewardNo",
                        className: "text-center clssRow",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "RewardNo",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "Title",
                        className: 'clssRow'
                    },
                    {
                        data: "OfferNo",
                        className: 'clssRow',
                        render: function (data, type, full, meta) {
                            return full.OfferNo;
                        },
                    },
                    {
                        data: "FromDate",
                        render: function (data, type, full, meta) {
                            if (full.FromDate != null) {
                                return moment(full.FromDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        },
                        className: 'text-center clssRow'
                    },
                    {
                        data: "ToDate",
                        render: function (data, type, full, meta) {
                            if (full.ToDate != null) {
                                return moment(full.ToDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        },
                        className: 'text-center clssRow'
                    },
                    {
                        data: "Enabled",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Enabled == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Hiệu lực</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>";
                            }
                            return html;
                        },
                        className: 'text-center clssRow'
                    }

                    //{
                    //    data: "RewardNo",
                    //    render: function (data, type, full, meta) {
                    //        var html = "";
                    //        html += "<a title=\"Xóa phụ thu\" style=\"height:30px\" data-code='" + full.RewardNo + "' class=\"btn btn-icon btn-light-danger deleteExtraFee\"><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                    //        return html;
                    //    },
                    //    className: 'text-center'
                    //}

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function GetInfoReward(rewardNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/Reward/_RewardIssue?code=" + rewardNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadExtraFee").css("display", "none");
                    $("#updateExtraFee").html(result);
                    $("#updateExtraFee").css("display", "block");

                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddExtraFee").css("display", "none");
                    loading.hideloading();
                },
                error: function (event) {
                }
            });
        }

        function LoadDataRewardCoupon() {

        tableCode = $('#tblDataCoupon').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                responsive: true,
                processing: false,      // for show progress bar
                serverSide: true,       // for process server side
                filter: false,          // this is for disable filter (search box)
                orderMulti: false,      // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("CouponCodeLoad", "SetupCoupon")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemNo = $("#hdtxtItemNo").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {
                    $(row).attr('id', "rowRecord" + data.ID);
                },
                drawCallback: function (settings) {
                },
                columns: [
                    {
                        data: "ItemNo",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "Code",
                        className: 'text-center'
                    },
                    {
                        data: "Enable",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Enable == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                            }
                            return html;
                        },
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }
    </script>
}

