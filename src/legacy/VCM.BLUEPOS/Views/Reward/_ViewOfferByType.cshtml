
@using VCM.BLUEPOS.Model.Reward
@{
    var model = Model as ViewOfferByTypeRequest;
    var offerType = model.OfferType;
}

<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <input type="text" id="viewOfferNo" class="form-control eventChangeOffer" placeholder="Mã sản phẩm" />
    </div>

    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
        <input type="text" id="viewOfferName" class="form-control eventChangeOffer" placeholder="Tên sản phẩm" />
    </div>

</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="tblItemHeader" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>Stt</th>
                    <th>Mã CTKM</th>
                    <th>Tên CTKM</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<script type="text/javascript">
    $(".select2").select2();
    var tableItem = "";
    var offerType = '@offerType';
    $(document).ready(function () {

        $(".eventChangeOffer").on("change", function () {
            tableItem.draw();
        });

        tableItem = $('#tblItemHeader').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false, // for show progress bar
            serverSide: true, // for process server side
            filter: true, // this is for disable filter (search box)
            orderMulti: false, // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 10,
            searching: false,
            lengthChange: false,
            ajax: {
               url: '@Url.Action("LoadOfferReward", "Reward")',
                type: "POST",
                datatype: "json",
                data: function (d) {              

                    d.OfferType = offerType;
                    d.No = $("#viewOfferNo").val();
                    d.Description = $("#viewOfferName").val();
                }
            },
            drawCallback: function (settings) {
                $(".chkItem").click(function () {
                    var itemNo = $(this).attr("data-itemno");
                    $("#txtOfferNo").val(itemNo);
                    $('#modalListCTKM').modal('hide');

                });
            },
            columns: [
                {
                    data: "No",
                    "className": "text-center",
                    "render": function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "No",
                    className: 'text-center'
                },
                {
                    data: "Description"
                },
                
                {
                    data: "No",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<label class=\"radio radio-lg radio-rounded\">";
                        html += "<input type=\"radio\"  class=\"chkItem\" data-itemno=" + full.No + " name=\"chkItem\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });
</script>
