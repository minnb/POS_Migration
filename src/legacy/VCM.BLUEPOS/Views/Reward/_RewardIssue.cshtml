@using VCM.BLUEPOS.Model.Reward;
@{
    var model = Model as ViewRewardModel;
    string rewardNo = "", title = "", mota = "", link = "", offerNo = "", tuNgay = "", denNgay = "";
    string displaySearchCTKM = "", disabledImport = "";
    string checkStatus = "checked";
    string isReward = "";
    string disableIsReward = "";
    if (model != null)
    {
        var info = model.infoReward;
        if (info != null)
        {
            rewardNo = info.RewardNo;
            title = info.Title;
            mota = info.Description;
            link = info.Link;
            offerNo = info.OfferNo;
            tuNgay = info.FromDate.Value.ToString("dd/MM/yyyy");
            denNgay = info.ToDate.Value.ToString("dd/MM/yyyy");
            displaySearchCTKM = "display:none";
            disabledImport = "disabled";
            checkStatus = info.Enabled == true ? "checked" : "";
            isReward = info.IsReward == true ? "checked" : "";
            disableIsReward = "disabled";
        }
    }
}
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
            <div class="card card-custom">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã phát hành</label>
                                        <div class="input-group">
                                            <input type="text" id="hdtxtRewardNo" class="form-control" disabled value="@rewardNo" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tiêu đề</label>
                                        <div class="input-group">
                                            <input type="text" id="txtTitle" class="form-control" value="@title" />
                                        </div>
                                    </div>
                                </div>



                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">CTKM</label>
                                        <div class="input-group">
                                            <input type="text" id="txtOfferNo" disabled class="form-control" value="@offerNo" />
                                            <div class="input-group-prepend btnSearchCTKM" style="cursor:pointer;">
                                                <span class="input-group-text">
                                                    <i class="fa fa-search"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Link quay thưởng</label>
                                        <div class="input-group">
                                            <input type="text" id="txtLink" class="form-control" value="@link" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mô tả</label>
                                        <div class="input-group">
                                            <input type="text" id="txtDescription" class="form-control" value="@mota" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                    <div class="input-group" style="margin-top:27px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <label class="checkbox checkbox-inline" title="Blocked">
                                                    <input type="checkbox" @checkStatus id="chkStatus" class="chkStatus" name="chkStatus" />
                                                    <span></span>
                                                </label>
                                            </span>
                                        </div>
                                        <div class="input-group-append"><span class="input-group-text">Hiệu lực</span></div>
                                    </div>

                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                    <div class="input-group" style="margin-top:27px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <label class="checkbox checkbox-inline" title="Blocked">
                                                    <input type="checkbox" @isReward id="chkIsReWard" class="IsReWard" name="IsReWard" @disableIsReward />
                                                    <span></span>
                                                </label>
                                            </span>
                                        </div>
                                        <div class="input-group-append"><span class="input-group-text">Phát hành mã</span></div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="fromDate" name="StartingDate" value="@tuNgay">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="toDate" name="EndingDate" value="@denNgay">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 importFileExcel">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">File Excel</label>
                                        <div class="custom-file">
                                            <input type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" id="browseFileExcel" class="custom-file-input" @disabledImport />
                                            <label id="selectedFile" class="custom-file-label" for="browseFileExcel">Chọn file excel</label>
                                        </div>
                                        <span class="form-text" id="clickDownFileExample" style="cursor:pointer; color:#3699FF"><i class="fas fa-cloud-download-alt" style="color:#3699FF"></i>Download file excel mẫu(chỉ import đúng định dạng file mẫu)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                    <div class="row">



                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <table id="tblDataCode" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center">
                                        <th>STT</th>
                                        <th>MÃ DỰ THƯỞNG</th>
                                        <th>TRẠNG THÁI</th>
                                        <th>ĐÃ SEND</th>
                                        <th>ĐƠN HÀNG</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalListCTKM" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">DANH SÁCH CHƯƠNG TRÌNH KHUYẾN MÃI</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupListCTKM">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var tableCode = "";
    $(".select2").select2();
    $('#fromDate').datepicker({
        format: 'dd/mm/yyyy',
        autoUpdateInput: false,
        todayHighlight: true,
        singleDatePicker: true,
        autoclose: true
    });
    $('#toDate').datepicker({
        format: 'dd/mm/yyyy',
        autoUpdateInput: false,
        todayHighlight: true,
        singleDatePicker: true,
        autoclose: true
    });
    $("input[type='file']").change(function () {
        debugger
        $('#selectedFile').text(this.value.replace(/C:\\fakepath\\/i, ''));
    });

    $("#clickDownFileExample").click(function (e) {
        loading.showloading();
        e.preventDefault();
        var req = new XMLHttpRequest();
        var url = "/Reward/ExcelExampleReward";
        req.open("GET", url, true);
        req.responseType = "blob";
        req.onload = function (event) {
            debugger
            var blob = req.response;
            console.log(blob.size);
            if (blob.size > 10) {
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "FileMauMaDuThuong_" + fileName + ".xlsx";
                link.click();
            }
            else {
                toastr.error("Excel không có dữ liệu, nên không xuất được");
            }
            loading.hideloading();
        };
        req.send();

    });

    $(".btnSearchCTKM").on("click", function () {
        var offerType = "ZB16";
        $.ajax({
            type: "GET",
            url: "/Reward/_ViewOfferByType?offerType=" + offerType + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {

                $("#divPopupListCTKM").html(result);
                $('#modalListCTKM').modal({
                    backdrop: 'static',
                    keyboard: false
                });
                loading.hideloading();
            },
            error: function (event) {
                loading.hideloading();
            }
        });

    });


    tableCode = $('#tblDataCode').DataTable({
        dom: '<"top"iflp<"clear">>rt',
        destroy: true,
        // paging: true,
        // pagingType: "simple_numbers",
        responsive: true,
        processing: false, // for show progress bar
        serverSide: true, // for process server side
        filter: false, // this is for disable filter (search box)
        orderMulti: false, // for disable multiple column at once
        autoWidth: true,
        ordering: false,
        displayLength: 10,
        searching: false,
        lengthChange: false,
        ajax: {
            url: '@Url.Action("RewardCodeLoad", "Reward")',
            type: "POST",
            datatype: "json",
            data: function (d) {
                d.RewardNo = $("#hdtxtRewardNo").val();
            }
        },
        createdRow: function (row, data, dataIndex) {
            $(row).attr('id', "rowRecord" + data.Code);
        },
        drawCallback: function (settings) {
        },
        columns: [
            {
                data: "RewardNo",
                "className": "text-center",
                "render": function (data, type, row, meta) {
                    var start = meta.settings._iDisplayStart;
                    return meta.row + 1 + start;
                }
            },
            {
                data: "Code",
                className: 'text-center'
            },
            {
                data: "Enabled",
                render: function (data, type, row) {

                    var html = "";
                    if (row.Enabled == true) {
                        html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                    }
                    else {
                        html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                    }
                    return html;
                },
                className: 'text-center'
            },
            {
                data: "OrderNo",
                render: function (data, type, row) {

                    var html = "";
                    if (row.OrderNo == "" || row.OrderNo == null) {
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" disabled />";
                        html += "<span></span>";
                        html += "</label>";
                    }
                    else {
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" disabled checked />";
                        html += "<span></span>";
                        html += "</label>";
                    }
                    return html;
                },
                className: 'text-center'
            },
            {
                data: "OrderNo",
                className: 'text-center'
            }

        ]
    }).on('processing.dt', function (e, settings, processing) {

        if (processing) {
            loading.showloading();
        } else {
            loading.hideloading();
        }
    });
</script>