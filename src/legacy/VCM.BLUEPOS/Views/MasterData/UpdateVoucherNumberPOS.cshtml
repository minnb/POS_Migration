@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Helpers;

@{
    ViewBag.Title = "Cập nhật số chứng từ POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Cập nhật số chứng từ POS</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Loại chứng từ</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-voucher-type" name="VoucherType">
                                            <option value="ORDER">Order</option>
                                            <option value="VOUCHER">Voucher</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-5 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH</label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count() > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNo" data-array="@listStore.FirstOrDefault().ValueJson">@listStore.FirstOrDefault().StoreNo - @listStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.StoreName) ? item.StoreNo : item.StoreName;
                                                        <option value="@item.StoreNo" data-array="@item.ValueJson">@item.StoreNo - @storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Máy POS</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-pos-terminal" name="POSID"></select>
                                    </div>
                                </div>

                                <input type="hidden" id="update-store-no" />
                                <input type="hidden" id="update-pos-id"  />
                                <input type="hidden" id="update-trans-date" />
                                <input type="hidden" id="update-document-number"  />
                                <input type="hidden" id="update-voucher-type" />

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" name="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered text-nowrap row-border" id="tbl-update-voucher-number-pos">
                            <thead>
                                <tr class="text-center" style="text-align:center;text-transform:uppercase;">
                                    <th>STT</th>
                                    <th>StoreNo</th>
                                    <th>POSTerminal</th>
                                    <th>TransDate</th>
                                    <th>LastNumber</th>
                                    <th>LastDateTime</th>
                                    <th>DocumentType</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div id="modal-update-pos-document-no-list" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5><span class="modal-title" id="modal-title-update">Cập nhật số chứng từ POS</span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-pos-document-no-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                    <table id="list-pos-document-no-table" class="table table-bordered table-striped" style="width: 700px;">
                                        <thead>
                                            <tr style="text-transform:uppercase;">
                                                <th style="text-align:center">Số chứng từ</th>
                                            </tr>
                                        </thead>
                                        <tbody id="pos-document-no-body"></tbody>
                                    </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btn-save-update-voucher-number-pos"><i class="fa fa-save"></i>&nbsp;Đồng ý</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal" id="btn-close"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
    </div> 
</div> 


@section scripts {
    <script type="text/javascript">
        var table;
        var childtable;

        $(document).ready(function () {
            $(".select2").select2();
            LoadPOSByStore($("#sel-voucher-type").val(), $("#sel-store-no").val());

            $("#sel-store-no").on("change", function (e) {
                LoadPOSByStore($("#sel-voucher-type").val(), $("#sel-store-no").val());
            });

            $('#btn-save-update-voucher-number-pos').on('click', function () {
                var _lastnumber = $('#update-document-number').val();
                if (_lastnumber == null || _lastnumber.length == 0) {
                    InsertPOSDocumentNo();
                }
                else {
                    UpdatePOSDocumentNo();
                }
            });

            table = $('#tbl-update-voucher-number-pos').DataTable({
                destroy: true,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    $(".btn-edit-voucher-number-pos").on("click", function () {
                        var storeNo = $(this).parents('tr').find('td:nth-child(2)').html();
                        $('#update-store-no').val(storeNo);

                        var posID = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                        $('#update-pos-id').val(posID);

                        var transDate = $(this).parents('tr').find('td:nth-child(4)').html();
                        $('#update-trans-date').val(transDate);

                        var lastNumber = $(this).parents('tr').find('td:nth-child(5)').html();
                        $('#update-document-number').val(lastNumber);

                        var documnentType = $(this).parents('tr').find('td:nth-child(7)').html();
                        $('#update-voucher-type').val(documnentType);

                        LoadChildData(storeNo, posID, transDate, lastNumber, documnentType);

                        $('#modal-update-pos-document-no-list').modal({
                            backdrop: "static",
                            keyboard: false
                        });
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                processing: false,              
                serverSide: true,              
                lengthChange: false,            
                filter: false,                  
                orderMulti: false,            
                searching: false,    
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetVoucherNumberToPOSList", "MasterData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.PosID = getPOSTerminal();
                        d.IPAddress = getIPAddress(); 
                        d.VoucherType = $('#sel-voucher-type').val();
                        d.StoreNo = $('#sel-store-no').val();
                        d.TransDate = $('#update-trans-date').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: "text-center"
                    },

                    {
                        data: "POSTerminal",
                        render: function (data, type, row) {
                            var _posterminal = row.POSTerminal;
                            var html = '<span style="font-weight:700;display: block;text-align:center;">' + _posterminal + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TransDate",
                        className: "text-center"
                    },

                    {
                        data: "LastNumber",
                        className: "text-center"
                    },

                    {
                        data: "LastDateTime",
                        className: "text-center"
                    },

                    {
                        data: "DocumentType",
                        className: "text-center"
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var _storeNo = row.StoreNo;
                            var _posID = row.POSTerminal;
                            var _documentType = row.DocumentType;
                            var html = '<button type="button" class="btn btn-bg-editor btn-edit-voucher-number-pos"  data-toggle="tooltip" data-placement="left" title="Cập nhật" data-store-no="' + _storeNo + '"  data-pos-id="' + _posID + '"  data-document-type="' + _documentType + '" style="color:#fff;text-align:center;font-size:12px;"><i class="fas fa-pencil-alt" style="color:#fff;text-align:center;"></i></button>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });

            $('#tbl-update-voucher-number-pos tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var posTerminal = getPOSTerminal();
                if (posTerminal == null || posTerminal == "") {
                    toastr.error('Vui lòng chọn máy POS');
                    table.draw();
                    return;
                } else {
                    table.draw();
                }
            });

        });

        function getTransDate() {
            var result = "";
            var transDate = $('#update-trans-date').val();  // dd/MM/yyyy --> yyyy-MM-dd

            if (transDate != null && transDate != "") {
                result = transDate.split('/')[2] + "-" + transDate.split('/')[1] + "-" + transDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function LoadPOSByStore(typeQuery, _storeNo) {
            var html = "<option value=''>Chọn máy POS</option>";
            var fromData = new FormData();
            fromData.append('StoreNo', _storeNo);
            loading.showloading();

            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                         data.forEach((name, i) => {
                             if (name.PosID != "") {
                                 html += "<option value=" + name.PosID + "-" + name.IpAddress + ">" + name.PosID + " - " + name.IpAddress + "</option>";
                             }
                         });
                        $('#sel-pos-terminal').html(html);
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });

        };

        function getPOSTerminal() {
            debugger
            var result = "";
            var pos = $('#sel-pos-terminal').val();
            if (pos != null && pos != "") {
                result = pos.split('-')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getIPAddress() {
            debugger
            var result = "";
            var pos = $('#sel-pos-terminal').val();
            if (pos != null && pos != "") {
                result = pos.split('-')[1];
            }
            else {
                result = "";
            }
            return result;
        };

        function getDocumentNumber() {
            var data = [];
            $('#list-pos-document-no-table tbody tr').each(function () {
                var item = {};
                item['DocumentNumber'] = $(this).find('td:nth-child(1)').find('span:nth-child(1)').html();
                data.push(item);
            });
            return data;
        };

         function UpdatePOSDocumentNo() {
            //debugger
            var storeNo = $('#update-store-no').val();
            var posID = $('#update-pos-id').val();
            var transDate = $('#update-trans-date').val();
            var documentType = $('#update-voucher-type').val();            
            var documentNumber = getDocumentNumber();
            if (documentNumber == null || documentNumber.length == 0) {
                toastr.warning('Không có dữ liệu');
                return;
            }
            var ipaddress = getIPAddress();
            var lastNumber = '';
            for (var i = 0; i < documentNumber.length; i++) {
                lastNumber = documentNumber[i].DocumentNumber
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("UpdatePOSDocumentNo", "MasterData")',
                type: "POST",
                dataType: "text",
                data: {
                    StoreNo: storeNo,
                    POSTerminal: posID,
                    TransDate: transDate,
                    IPAddress: ipaddress,
                    LastNumber: lastNumber,
                    DocumentType: documentType
                },
                success: function (response) {
                    loading.hideloading();
                    toastr.success('Cập nhật thành công');
                    $('#modal-update-pos-document-no-list').modal("hide");
                    $('#btn-search').trigger('click');                   
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }

            });
        };

        function InsertPOSDocumentNo() {
            var storeNo = $('#update-store-no').val();
            var posID = $('#update-pos-id').val();
            var documentType = $('#update-voucher-type').val();
            var ipaddress = getIPAddress();
            var documentNumber = getDocumentNumber();
            if (documentNumber == null || documentNumber.length == 0) {
                toastr.warning('Không có dữ liệu');
                return;
            }

            var lastNumber = '';
            for (var i = 0; i < documentNumber.length; i++) {
                lastNumber = documentNumber[i].DocumentNumber
            }

            loading.showloading();
            $.ajax({
                url: '@Url.Action("InsertPOSDocumentNo", "MasterData")',
                type: "POST",
                dataType: "text",
                data: {
                    StoreNo: storeNo,
                    POSTerminal: posID,
                    IPAddress: ipaddress,
                    LastNumber: lastNumber,
                    DocumentType: documentType
                },
                success: function (response) {
                    loading.hideloading();
                    toastr.success('Thêm mới thành công');
                    $('#modal-update-pos-document-no-list').modal("hide");
                    $('#btn-search').trigger('click');
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
       };

        function LoadChildData(storeNo, posID, transDate, lastNumber, documnentType) {
            childtable = $('#list-pos-document-no-table').DataTable({
                destroy: true,
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                processing: false,             
                serverSide: true,            
                lengthChange: false,        
                filter: false,              
                orderMulti: false,        
                searching: false,    
                autoWidth: false,
                ordering: false,
                displayLength: 10,

                ajax: {
                    url: '@Url.Action("GetDocumentNoList", "MasterData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo = storeNo;
                        d.PosID = posID;
                        d.TransDate = transDate;
                        d.DocumnentType = documnentType;
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        data: "DocumentNumber",
                        render: function (data, type, row) {
                            var DocumentNumber = row.DocumentNumber;
                            var html = '<span>' + DocumentNumber + '</span>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (settings._iRecordsTotal > 0) {
                    $('#btn-save-update-voucher-number-pos').prop("disabled", false);
                }
                else {
                    $('#btn-save-update-voucher-number-pos').prop("disabled", true);
                }

                //if (processing) {
                //    //debugger
                //    var _posid = $('#update-pos-id').val();
                //    var _storeNo = $('#update-store-no').val();
                //    var _docType = $('#update-voucher-type').val();
                //    $('#modal-title-update').text('Cập nhật số chứng từ POS - PosID/StoreNo/DocumentType:' + _posid + " / " + _storeNo + " / " + _docType);
                //}
                //else {
                //}

            });
        };


    </script>
}

<style>
        .btn.btn-bg-editor {
            background-color: #00A09D;
            border-color: #00A09D;
            box-shadow: none;
            color: #ffffff;
            font-weight: 500;
        }
</style>