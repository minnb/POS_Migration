                                <div class="row">
                                    <!-- 0: offline ; 1: Online -->
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Thanh toán Online<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-is-online" name="CreateIsOnline">
