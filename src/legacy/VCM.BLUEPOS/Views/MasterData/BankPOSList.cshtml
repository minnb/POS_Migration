@using VCM.BLUEPOS.Model.Bank;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Khai báo máy POS ngân hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listBank = ViewBag.ListBank as List<OptionModel>;
}

