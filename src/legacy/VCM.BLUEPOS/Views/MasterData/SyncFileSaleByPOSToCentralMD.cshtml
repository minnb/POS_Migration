$(document).ready(function () {

        $('.select2').select2();
        LoadComboxStoreNo();

        $('#txt-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#chk-open-partner-id').change(function () {
            if (this.checked) {
                $('#modal-create-partner-id').prop('disabled', false);
                $('#modal-create-partner-id').val('');
            }
            else {
                var partnerID = "bf1742f3-d321-4e75-bbd6-da5b3c54b8ae";
                $('#modal-create-partner-id').prop('disabled', true);
                $('#modal-create-partner-id').val(partnerID);
            }
        });

        $("#btn-import-excel").on("click", function () {
            $('#file-excel').val('');
            $('#modal-import-excel-pos-bank').modal({
                backdrop: 'static',
                keyboard: false
            });
        });

        $("#btn-save-import-pos-bank").on("click", function (e) {
            ImportBankPOSList();
        });

        $('#modal-create-bank-code').change(function () {
                var _bankCode = $('#modal-create-bank-code').val();
                if (_bankCode == null || _bankCode == "") {
                    _bankCode = $('#modal-create-bank-code').val();
                }
                else
                {
                    $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetBankPOSName", "MasterData")',
                    data: { BankCode: _bankCode},
                    dataType: "json",
                    success: function (data) {
                         if (data.Status != "2" && data != null)
                         {
                             $('#modal-create-bank-pos-name').val(data);
                         }
                         else
                         {
                             $('#modal-create-bank-pos-name').val('');
                             toastr.warning(data.Message);
                         }
                    },
                    error: function () {
                         toastr.error('Lỗi hệ thống');
                    }

                    });
                }
        });

        $('#modal-create-bank-pos-no').change(function () {
                //debugger
                var _bankCode = $("#modal-create-bank-code").val();
                var _storeNo = $("#modal-create-store-no").val();
                var _posNo = $("#modal-create-bank-pos-no").val();
                 $.ajax({
                    type: "POST",
                     url: '@Url.Action("GetBankPOSCode", "MasterData")',
                     data: { StoreNo: _storeNo, BankCode: _bankCode, POSNo: _posNo },
                     dataType: "json",
                     success: function (data) {
                         if (data.Status != "2" && data != null) {
                             $('#modal-create-bank-pos-code').val(data);
                         }
                         else
                         {
                             $('#modal-create-bank-pos-code').val('');
                             toastr.error(data.Message);
                         }
                     },
                     error: function () {
                         toastr.error('Lỗi hệ thống');
                     }
                 });
            });

        $('#modal-create-store-no').on('change', function () {
                loading.showloading();
                var _storeNo = $('#modal-create-store-no').val();
                 $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxPOSTerminalByStore", "Common")',
                    data: { StoreNo: _storeNo},
                    dataType: "json",
                     success: function (data) {
                         var html = "<option value=\"\" disabled selected>----- Chọn -----</option>";
                         if (data.length > 0)
                         {
                             data.forEach((name, i) => {
                                 html += "<option value='" + name.Value + "'>" + name.Value + "</option>"
                             });
                         }
                         $('#modal-create-pos-terminal').html(html);
                         loading.hideloading();
                     },
                     error: function ()
                     {
                         toastr.error('Lỗi hệ thống');
                     }
                 });
            });

        $('#btn-add-new-bank-pos').on('click', function () {
            ClearText();
            $('#modal-create-bank-pos').modal({
                backdrop: "static"
            });
        })

        $('#btn-save-create-bank-pos').on("click", function ()
        {
             CreateBankPOSList();
        })

        $('#btn-save-update-bank-pos').on("click", function ()
        {
            UpdateBankPOSList();
        })

