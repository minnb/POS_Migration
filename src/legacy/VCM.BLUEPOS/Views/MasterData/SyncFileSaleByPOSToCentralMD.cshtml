<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-date" name="TxtDate" placeholder="">
                                        </div>
                                    </div>
                                </div>


                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>


                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count() > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo" data-array="@listStore.FirstOrDefault().ValueJson">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteName;
                                                        <option value="@item.SiteNo" data-array="@item.ValueJson">@item.SiteNo - @storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>


                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="POSTerminal" disabled></select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-search" name="TextSearch" placeholder="Nhập số đơn hàng, tên file ...">
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" class="btn btn-primary btn-search" name="btnSearch"><i class="fa fa-search"></i>Tìm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered table-hover text-nowrap tbl-document-log-list">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th width="90px">#</th>
                                    <th width="90px">STT</th>
                                    <th>ID</th>
                                    <th>StoreNo</th>
                                    <th>PosTerminal</th>
                                    <th>OrderNo</th>
                                    <th>DocumentType</th>
                                    <th>FileName</th>
                                    <th>IsCreatedFile</th>
                                    <th>IsFinish</th>
                                    <th>BussinessDate</th>
                                    <th>FinishDate</th>
                                    <th>CreatedDate</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



