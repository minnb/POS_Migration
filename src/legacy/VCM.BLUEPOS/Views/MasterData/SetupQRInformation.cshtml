        //
        function CreateInformationQR() {
            var storeNo = $('#modal-create-store-no').val();
            var posID = $('#modal-create-pos-id').val();
            var contentQR = $('#modal-create-content-QR').val();
            var linkQR = $('#modal-create-link-QR').val();
            var contentType = $('#modal-create-content-type').val();
            var status = $('#modal-create-is-active').val();

            var _isStatus = "";
            if (status == "1") {
                _isStatus = true;
            } else {
                _isStatus = false;
            }

            var order = $('#modal-create-order-display').val();
            var fromDate = getCreateFromDate();
            var toDate = getCreateToDate();

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateInformationQRList", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    StoreNo: storeNo,
                    POSID: posID,
                    Content: contentQR,
                    QRLink: linkQR,
                    FromDate: fromDate,
                    ToDate: toDate,
                    ContentType: contentType,
                    IsActive: status,
                    Order: order
                },
                success: function (data) {
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        $('#modal-create-information-QR').modal("hide");
                    }
                    else if (data.Status == 2) {
                        toastr.error(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    $('#btn-search').trigger('click');
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function UpdateInformationQR() {
