                        $('#modal-update-information-QR').modal('hide');
                   }
                   else if (data.Status == 2)
                   {
                        toastr.error(data.Message);
                   }
                   else
                   {
                        toastr.error(data.Message);
                   }
                   $('#btn-search').trigger('click');
                   loading.hideloading();
               },
               error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
               }
           });
        }

