@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getCreateFromDate() {
            var result = "";
            var toDate = $('#txt-create-from-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getCreateToDate() {
            var result = "";
            var toDate = $('#txt-create-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getUpdateFromDate(date) {
