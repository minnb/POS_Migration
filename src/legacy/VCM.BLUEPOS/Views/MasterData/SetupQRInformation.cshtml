            var status = $('#modal-update-is-active').val();

            var _isStatus = "";
            if (status == "1") {
                _isStatus = true;
            } else {
                _isStatus = false;
            }

            var order = $('#modal-update-order-display').val();

            var _fromDate = $('#txt-update-from-date').val();
            var _toDate = $('#txt-update-to-date').val();
            var fromDate = getUpdateFromDate(_fromDate);
            var toDate = getUpdateToDate(_toDate);

           loading.showloading();

           $.ajax({
               url: '@Url.Action("UpdateQRInformationList", "MasterData")',
