@using VCM.BLUEPOS.Model.Bank;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Khai báo thẻ ngân hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        /* margin: 2px 0; */
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
        margin-top: -35px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo thẻ ngân hàng</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Mã thẻ ngân hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-bank-card-code" name="BankCardCode">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên thẻ ngân hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-bank-card-name" name="BankCardName">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-status" name="Status" style="width: 100%;">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Có hiệu lực</option>
                                            <option value="0">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="col-4">
                            <button type="button" id="btn-add-new-bank-card-type" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
                        </div>
                        <table id="tbl-bank-card-type-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th width="90px;">#</th>
                                    <th>STT</th>
                                    <th>Mã thẻ ngân hàng</th>
                                    <th>Tên thẻ ngân hàng</th>
                                    <th>Hiệu lực</th>
                                    <th>Ngày tạo</th>
                                    <th>Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-create-bank-card-type" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-bank-card-type">Khai báo thông tin thẻ Ngân hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-bank-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã thẻ Ngân hàng (*)</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-create-bank-card-code" name="BankCardCode" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên thẻ Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-create-bank-card-name" name="BankCardName" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-create-status" name="CreateStatus" style="width: 100%;">
                                                <option value="1">Có hiệu lực</option>
                                                <option value="0">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-bank-card-type" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-update-bank-card-type" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-bank-bank-card-type">Cập nhật thông tin thẻ Ngân hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-bank-card-type-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã thẻ Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-bank-card-code" name="UpdateBankCardCode" disabled />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên thẻ Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-bank-card-name" name="UpdateBankCardName" placeholder="Vui lòng nhập tên thẻ ngân hàng" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-update-status" name="UpdateStatus" style="width: 100%;">
                                                <option value="1">Có hiệu lực</option>
                                                <option value="0">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                    <button type="button" id="btn-save-update-bank-card-type" class="btn btn-bg-primary" style="color:#fff;"><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function CreateBankCardType() {
            //debugger
            var _bankCardCode = $('#txt-create-bank-card-code').val();
            var _bankCardName = $('#txt-create-bank-card-name').val();
            var _status = $('#sel-create-status').val();

            if (_status == "1") {
                _status = true;
            } else if (_status == "0") {
                _status = false;
            }

            if (_bankCardCode == null || _bankCardCode == "") {
                toastr.error('Nhập mã thẻ ngân hàng. Vui lòng kiểm tra lại');
                return;
            }

            if (_bankCardName == null || _bankCardName == "") {
                toastr.error('Nhập tên thẻ ngân hàng. Vui lòng kiểm tra lại');
                return;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateBankCardType", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    BankCardCode: _bankCardCode,
                    BankCardName: _bankCardName,
                    Status: _status
                },
                success: function (data) {
                    //debugger
                    var _isStatus = "";
                    if (data.Item3 == true) {
                        _isStatus = "1";
                    }
                    else {
                        _isStatus = "0";
                    }
                    $('#btn-search').trigger('click');
                    loading.hideloading();

                    if (data.Status = 1)    // Thành công
                    {
                         toastr.success(data.Message);
                         $('#modal-create-bank-card-type').modal("hide");
                    }
                    else if (data.Status = 2)
                    {
                        toastr.error(data.Message);
                    }
                    else
                    {
                         toastr.error(data.Message);
                         $('#btn-save-create-bank-card-type').attr('disabled', true);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


        //
        function UpdateBankCardType() {
            //debugger
            var _bankCardCode = $('#txt-update-bank-card-code').val();
            var _bankCardName = $('#txt-update-bank-card-name').val();
            var _status       = $('#sel-update-status').val();
            if (_status == "1")
            {
                _status = true;
            }
            else if (_status == "0")
            {
                _status = false;
            }

            if (_bankCardCode == null || _bankCardCode == "") {
                toastr.error('Nhập mã thẻ ngân hàng. Vui lòng kiểm tra lại');
                return;
            }

            if (_bankCardName == null || _bankCardName == "") {
                toastr.error('Nhập tên thẻ ngân hàng. Vui lòng kiểm tra lại');
                return;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("UpdateBankCardType", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    BankCardCode: _bankCardCode,
                    BankCardName: _bankCardName,
                    Status: _status
                },
                success: function (data) {
                    //debugger
                    var _isStatus = "";
                    if (data.Item3 == true) {
                        _isStatus = "1";
                    }
                    else {
                        _isStatus = "0";
                    }

                    $('#btn-search').trigger('click');
                    if (data.Status == 1)   // Thành công
                    {
                        toastr.success(data.Message);
                        $('#modal-update-bank-card-type').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                        toastr.error(data.Message);
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function ClearText() {
            $('#txt-create-bank-card-code').val('');
            $('#txt-create-bank-card-name').val('');
        }

    $(document).ready(function () {
        $('.select2').select2();

        $('#btn-add-new-bank-card-type').on('click', function () {
            ClearText();
            $('#modal-create-bank-card-type').modal({
                "backdrop": "static"
            });
        });

        $('#btn-save-create-bank-card-type').on("click", function () {
            CreateBankCardType();
        });

        $('#btn-save-update-bank-card-type').on("click", function () {
            UpdateBankCardType();
        });

        table = $('#tbl-bank-card-type-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    //
                    $(".btn-editor-bank-card-type").click(function () {
                        //debugger
                        var _bankCardCode = $(this).attr("data-bank-card-code");
                        $('#txt-update-bank-card-code').val(_bankCardCode);

                        var _bankCardName = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        $('#txt-update-bank-card-name').val(_bankCardName);

                        var _isStatus = $(this).parents('tr').find('td:nth-child(5)').find('span:nth-child(1)').html();
                        var status = "";
                        if (_isStatus == "Có hiệu lực") {
                            status = "1";  // true = 1
                        }
                        else if (_isStatus == "Hết hiệu lực") {
                            status = "0";  // false = 0
                        }
                        $('#sel-update-status').val(status).trigger('change');

                        $('#modal-update-bank-card-type').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                    });

                    $('.btn-delete-bank-card-type').click(function () {
                        var _bankCardCode = $(this).attr("data-bank-card-code");
                        $.confirm({
                            backgroundDismiss: true,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: 'Bạn có chắc chắn muốn xóa thông tin này không?',
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        loading.showloading();
                                        $.ajax({
                                            url: '@Url.Action("DeleteBankCardType", "MasterData")',
                                            type: "POST",
                                            dataType: "json",
                                            data: { BankCardCode: _bankCardCode },
                                            success: function (data) {
                                                if (data.Status == 1)
                                                {
                                                    toastr.success(data.Message); 
                                                }
                                                else if (data.Status == 2)
                                                {
                                                    toastr.warning(data.Message);
                                                }
                                                else
                                                {
                                                    toastr.error(data.Message);
                                                }
                                                $('#btn-search').trigger('click');
                                                loading.hideloading();
                                            },
                                            error: function () {
                                                toastr.error("Lỗi hệ thống");
                                                loading.hideloading();
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });

                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: false,                // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("LoadBankCardTypeList", "MasterData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.BankCardCode = $('#txt-bank-card-code').val();
                        d.BankCardName = $('#txt-bank-card-name').val();
                        d.Status = $('#sel-status').val();
                    }
                },

                columns: [
                    {
                        render: function (data, type, row) {
                            var _bankCardCode = row.BankCardCode;
                            var html ="";
                            html += '<a type="button" class="btn btn-icon btn-light-warning btn-editor-bank-card-type"  data-bank-card-code ="' + _bankCardCode + '"  data-toggle="tooltip" data-placement="left" title="Cập nhật"  style="color:#ffffff;text-align:center;"><i class="la la-edit"></i><span class="pulse-ring"></span></a>';
                            html += '<a type="button" class="btn btn-icon btn-light-danger btn-delete-bank-card-type"  data-bank-card-code ="' + _bankCardCode + '"  data-toggle="tooltip" data-placement="left" title="Xóa"  style="margin-left: 3px; color:#ffffff;text-align:center;"><i class="la la-close"></i><span class="pulse-ring"></span></a>';
                            return html;
                        }
                    },

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "BankCardCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.BankCardCode + '</span>';
                        }
                    },

                    {
                        data: "BankCardName",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.BankCardName + '</span>';
                        }
                    },

                    {
                        data: "Status",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var _status = row.Status;
                            if (_status == "1") // co hieu luc
                            {
                                return '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Có hiệu lực</span>';
                            }
                            else if (_status == "0")
                            {
                                return '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>';
                            }
                        }

                    },

                    {
                        data: "CreatedDateStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.CreatedDateStr + '</span>';
                        }
                    },

                    {
                        data: "UpdatedDateStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.UpdatedDateStr + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });

            $('#tbl-bank-card-type-list tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                $('#frm-export-excel').submit();
            });


    });

    </script>
}





