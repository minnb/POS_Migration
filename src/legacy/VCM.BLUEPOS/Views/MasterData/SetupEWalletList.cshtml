    <script type="text/javascript">
        var table = "";

        function CreateSetupEWallet() {
            //debugger
            var _storeNo        = $('#modal-create-store-no').val();
            var _eWalletcode    = $('#modal-create-ewallet-code').val();
            var _posTerminal    = $('#modal-create-pos-terminal').val();
            var _posNo          = $('#modal-create-pos-no').val();
            var _terminalCode   = $('#modal-create-terminal-code').val();
            var _paymentType    = $('#modal-create-payment-type').val();
            var _mode           = $('#modal-create-is-online').val();
            var _status         = $('#modal-create-status').val();
            var _accessKey      = $('#modal-create-access-key').val();
            var _partnerID      = $('#modal-create-partner-id').val();
            var _tenderType     = $('#modal-create-tender-type').val();

            if (_storeNo == null || _storeNo == "") {
                toastr.error("Chọn ST/CH. Vui lòng kiểm tra lại");
                return;
            }

            if (_eWalletcode == null || _eWalletcode == "") {
                toastr.error("Chọn loại ví điện tử. Vui lòng kiểm tra lại");
                return;
            }

            if (_posTerminal == null || _posTerminal == "") {
                toastr.error("Chọn máy POS. Vui lòng kiểm tra lại");
                return;
            }

            if (_posNo == null || _posNo == "") {
                toastr.error("Nhập số thứ tự máy POS. Vui lòng kiểm tra lại");
                return;
            }
            else if (_posNo.length > 3 || _posNo.length < 3) {
                toastr.error("Số thứ tự máy POS bao gồm 03 ký tự số nguyên dương. Vui lòng kiểm tra lại");
                return;
            }

            if (_accessKey == null || _accessKey == "") {
                toastr.error("Nhập Access Key. Vui lòng kiểm tra lại");
                return;
            }

            if (_partnerID == null || _partnerID == "") {
                // PRD
                _partnerID = "bf1742f3-d321-4e75-bbd6-da5b3c54b8ae";
            }

            var isTPay = $('#modal-create-is-tpay').val();
            var _isTPay = true;
            if (isTPay == "1")
            {
                _isTPay = true;
            }
            else if (isTPay == "0")
            {
                _isTPay = false;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateSetupEWallet", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    PartnerID: _partnerID,
                    TerminalCode: _terminalCode,
                    EWalletCode: _eWalletcode,
                    StoreNoFull: _storeNo,
                    StoreNo: _storeNo,
                    POSNo: _posNo,
                    POSTerminal: _posTerminal,
                    PaymentType: _paymentType,
                    TenderType: _tenderType,
                    Mode: _mode,
                    Status: _status,
                    AccessKey: _accessKey,
                    IsTPay: _isTPay
                },
                success: function (data) {
                    //debugger
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#sel-store-no').val(data.Item1).trigger('change');
                        $('#sel-e-wallet-type').val(data.Item2);
                        $('#sel-status').val(data.Item3);
                        $('#btn-search').trigger('click');
                        $('#modal-create-ewallet-list').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                        toastr.error(data.Message);
                    }
                    else if (data.Status == 3)
                    {
                        toastr.error(data.Message);
                        $('#btn-save-create-ewallet').attr('disabled', true);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

