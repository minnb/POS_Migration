        function LoadComboxStoreList() {
            $('#modal-create-store-no').empty();

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetComboxStoreList", "Common")',
                dataType: "json",
                success: function (data) {
                    var html = "<option value=\"\" selected>--- Chọn ---</option>";
                    if (data.length > 0) {
                        data.forEach((name, i) => {
                            html += "<option value='" + name.Value + "'>" + name.Value +"-"+ name.Text + "</option>"
                        });
                    }
                    $('#modal-create-store-no').html(html);
                },
                error: function ()
                {
                }
            });
        }

        function LoadComboxTenderTypeByWallet() {
            //debugger
            $('#modal-create-tender-type').empty();
            var _walletCode = $('#modal-create-ewallet-code').val();
            if (_walletCode == null || _walletCode == "") {
                $('#modal-create-tender-type').val('');
                return;
            }

            $.ajax({
                url: '@Url.Action("LoadTenderTypeByWallet", "Common")',
                type: "POST",
                dataType: "json",
                data: {
                    EWalletCode: _walletCode
                },
                success: function (data) {
                    $('#modal-create-tender-type').val(data);
                },
                error: function ()
                {
                }
            });
        }

        function LoadEwalletCode() {
                loading.showloading();
                var _eWalletCode = $("#modal-create-ewallet-code").val();
                var _storeNo = $("#modal-create-store-no").val();
                var _posNo = $("#modal-create-pos-no").val();

                $.ajax({
                    type: "POST",
                     url: '@Url.Action("GetEWalletTerminalCode", "MasterData")',
                     data: {
                         StoreNo: _storeNo,
                         EWalletCode: _eWalletCode,
                         POSNo: _posNo
                     },
                     dataType: "json",
                     success: function (data)
                     {
                         if (data.Status != "2" && data != null)
                         {
                                 $('#modal-create-terminal-code').val(data);
                         }
                         else
                         {
                                 $('#modal-create-terminal-code').val('');
                                 toastr.error(data.Message);
                         }
                        loading.hideloading();
                     },
                     error: function () {
                         toastr.error('Lỗi hệ thống');
                     }
                 });

        };

        function LoadPosTerminalByCreate() {
                loading.showloading();
                var _storeNo = $('#modal-create-store-no').val();

                 $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxPOSTerminalByStore", "Common")',
                    data: { StoreNo: _storeNo},
                    dataType: "json",
                     success: function (data) {
                         var html = "<option value=\"\" disabled selected>--- Chọn ---</option>";
                         if (data.length > 0)
                         {
                             data.forEach((name, i) => {
                                 html += "<option value='" + name.Value + "'>" + name.Value + "</option>"
                             });
                         }
                         $('#modal-create-pos-terminal').html(html);
                         loading.hideloading();
                     },
                     error: function ()
                     {
                         toastr.error('Lỗi hệ thống');
                     }
                 });
        };

        function ClearText() {
            $('#modal-create-store-no').val('').trigger('change');
            $('#modal-create-pos-terminal').val('').trigger('change');
            $('#modal-create-terminal-code').val('');
            $('#modal-create-pos-no').val('');
            $('#modal-create-access-key').val('');
            $('#modal-create-partner-id').val('');
        }

        function ImportEWalletList() {
            loading.showloading();
            var files = $('#importFile').get(0).files;
            var fileData = new FormData();
            fileData.append('importFile', files[0]);

            $.ajax({
                url: '/MasterData/ImportExcelEWallet',
                data: fileData,
                type: 'POST',
                datatype: 'json',
                contentType: false,
                processData: false,
                async: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        $('#importFile').val('');
                        table.draw();
                        $('#modal-import-excel-set-up-ewallet').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }
                }
            });
        }

