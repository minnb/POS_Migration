@using VCM.BLUEPOS.Model.Bank;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;

@{

    ViewBag.Title = "Khai báo Ví điện tử";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listEWallet = ViewBag.ListEWallet as List<OptionModel>;
    var listPayment = ViewBag.ListPaymentType as List<OptionModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo Ví điện tử</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <button type="button" id="btn-import-excel" class="btn btn-bg-warning font-weight-bold"><i class="fas fa-file-import" style="color:#fff;"></i><span style="color:#fff;">Import File Excel</span></button>
                <button type="button" id="btn-add-new-ewallet" class="btn btn-bg-success font-weight-bold"><i class="la la-plus-circle" style="color:#fff;"></i><span style="color:#fff;">Thêm mới</span></button>
            </div>            
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelSetupEWalletList", "MasterData", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count() > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNo" data-array="@listStore.FirstOrDefault().ValueJson">@listStore.FirstOrDefault().StoreNo - @listStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    <option value="">Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.StoreName) ? item.StoreNo : item.StoreName;
                                                        <option value="@item.StoreNo" data-array="@item.ValueJson">@item.StoreNo - @storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Loại ví điện tử<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-e-wallet-type" name="EWalletType">
                                            <option value="" selected>Tất cả</option>
                                            @if (listEWallet != null && listEWallet.Count > 0)
                                            {
                                                if (listEWallet.Count == 1)
                                                {
                                                    <option value="@listEWallet.FirstOrDefault().Value">@listEWallet.FirstOrDefault().Text</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listEWallet)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- 0: false ; 1: true -->
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-status" name="Status" style="width: 100%;">
                                            <option value="-1" selected>Tất cả</option>
                                            <option value="true">Đang được sử dụng</option>
                                            <option value="false">Không sử dụng</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-key-search" name="TextSearch" placeholder="Nhập mã máy thanh toán ví; số máy POS; số POSNo">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary" name="btnSearch"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-e-wallet-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th width="90px">#</th>
                                    <th>STT</th>
                                    <th>Mã máy thanh toán ví</th>
                                    <th>POSNo</th>
                                    <th>Máy POS</th>
                                    <th>ST/CH</th>
                                    <th>Tên ST/CH</th>
                                    <th>Trạng thái</th>
                                    <th>Mã loại ví điện tử</th>
                                    <th>Tên loại ví điện tử</th>
                                    <th>Loại thanh toán</th>
                                    <th>TenderType</th>
                                    <th>Model</th>
                                    <th>Thanh toán Tpay</th>
                                    <th>AccessKey</th>
                                    <th>PartnerID</th>
                                    <th>Ngày tạo</th>
                                    <th>Người tạo</th>
                                    <th>Ngày cập nhật</th>
                                    <th>Người cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-create-ewallet-list" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-ewallet-list">Khai báo Ví điện tử</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-ewallet-list-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">

                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">ST/CH <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-store-no" name="CreateStoreNo"></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Máy POS bán hàng <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width: 100%;" id="modal-create-pos-terminal" name="CreatePOSTerminal">
                                                <option value="-1" disabled selected>--- Chọn ---</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số thứ tự máy POS <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-pos-no" name="CreatePOSNo" placeholder="Nhập 3 ký tự số">
                                        </div>
                                    </div>
                                </div> 

                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Loại ví điện tử <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-ewallet-code" name="CreateEWalletCode">
                                                @if (listEWallet != null && listEWallet.Count > 0)
                                                {
                                                    if (listEWallet.Count == 1)
                                                    {
                                                        <option value="@listEWallet.FirstOrDefault().Value">@listEWallet.FirstOrDefault().Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="" selected disabled>--- Chọn ---</option>
                                                        foreach (var item in listEWallet)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã máy thanh toán ví</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-terminal-code" name="TerminalCode" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">TenderType</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-tender-type" name="TenderType" disabled>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Loại thanh toán<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-payment-type" name="CreatePaymentType">
                                                <option value="QRPAY" selected>QRCode tại quầy</option>
                                                <option value="QUICKPAY">QRCode thanh toán</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label style="font-weight:bold !important">Thanh toán TPay</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-is-tpay" name="CreateIsTPAY">
                                                <option value="0" selected>Không</option>
                                                <option value="1">Có</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- 0: offline ; 1: Online -->
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Thanh toán Online<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-is-online" name="CreateIsOnline">
                                                <option value="ALL" selected>ALL</option>
                                                <option value="OFFLINE">Offline</option>
                                                <option value="ONLINE">Online</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-status" name="CreateStatus">
                                                <option value="true" selected>Đang được sử dụng</option>
                                                <option value="false">Không sử dụng</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Access Key<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-access-key" name="AccessKey">
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Partner ID<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-partner-id" name="PartnerID" placeholder="bf1742f3-d321-4e75-bbd6-da5b3c54b8ae">
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-ewallet" class="btn btn-bg-primary" style="color:#fff;"><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close" style="color:#fff;"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>


