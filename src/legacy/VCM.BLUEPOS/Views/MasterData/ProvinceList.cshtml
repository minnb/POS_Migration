@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Danh mục tỉnh thành";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh mục tỉnh thành</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" id="btn-add-new-province" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Mã Tỉnh / Thành</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-province-code" name="ProvinceCode">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên Tỉnh / Thành</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-province-name" name="ProvinceName">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="">Tất cả</option>
                                            <option value="1">Đang hoạt động</option>
                                            <option value="0">Ngưng hoạt động</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                     <button type="button" class="btn btn-primary btn-search" id="btn-search"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body"> 
                        <table id="tbl-province-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>#</th>
                                    <th>STT</th>
                                    <th>ID</th>
                                    <th>Mã Tỉnh / Thành</th>
                                    <th>Tên Tỉnh / Thành</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th>Người tạo</th>
                                    <th>Ngày cập nhật</th>
                                    <th>Người cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div id="modal-create-province-list" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Thêm mới thông tin Tỉnh / Thành</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-province-body">
                    <div class="row">
                        <div class="col-lg-9 col-md-6 col-sm-12 col-xs-12">
                            <label class="font-weight-bold" style="font-weight:bold !important;">Mã Tỉnh / Thành</label>
                            <div class="form-group">
                                <input type="text" class="form-control" id="create-province-code" placeholder="Vui lòng nhập mã tỉnh / thành phố">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-group">
                                 <button type="button" id="btn-check-province-code" class="btn btn-warning" style="margin-top:25px;float:right;">
                                        <i class="fa fa-search"></i><span>Kiểm tra</span>
                                 </button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <label class="font-weight-bold" style="font-weight:bold !important;">Tên Tỉnh / Thành</label>
                            <div class="form-group">
                                <input type="text" class="form-control" id="create-province-name" name="ProvinceName" disabled>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                            <div class="form-group">
                                <select class="form-control select2" id="create-status" name="Status">
                                    <option value="1" selected>Đang hoạt động</option>
                                    <option value="0">Ngưng hoạt động</option>
                                </select>
                            </div>
                        </div>
                    </div>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary" id="btn-save-create-province" disabled><i class="fa fa-save" aria-hidden="true"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal" id="cancel">Đóng</button>
            </div>

        </div>
    </div>
</div>


<div id="modal-update-province-list" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Cập nhật thông tin Tỉnh / Thành</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-province-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="font-weight:bold !important;">Mã Tỉnh / Thành</label>
                        <div class="form-group">
                            <input type="text" class="form-control" id="update-province-code" placeholder="" disabled>
                        </div>
                    </div>
                </div>

                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <label class="font-weight-bold" style="font-weight:bold !important;">Tên Tỉnh / Thành</label>
                            <div class="form-group">
                                <input type="text" class="form-control" id="update-province-name" name="ProvinceName">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                            <div class="form-group">
                                <select class="form-control select2" id="update-status" name="Status">
                                    <option value="1">Đang hoạt động</option>
                                    <option value="0">Ngưng hoạt động</option>
                                </select>
                            </div>
                        </div>
                    </div>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary" id="btn-save-update-province"> <i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>
        var table;
        function CreateProvinceList() {
            debugger
            var provinceCode = $('#create-province-code').val();
            var provinceName = $('#create-province-name').val();
            var status = $('#create-status').val();
            var enable = true;
            if (status == "1") {
                enable = true;
            }
            else {
                enable = false;
            }

            loading.showloading();

            $.ajax({
                    url: '@Url.Action("CreateProvinceList", "MasterData")',
                    type: "POST",
                    dataType: "json",
                    data: {
                        ProvinceCode: provinceCode,
                        ProvinceName: provinceName,
                        Status: enable
                    },
                    success: function (data) {
                        if (data.Status == 1)
                        {
                            ClearText();
                            toastr.success(data.Message);
                            $('#modal-create-province-list').modal("hide");
                        }
                        else if (data.Status == 2)
                        {
                            toastr.warning(data.Message);
                        }
                        else
                        {
                            toastr.error(data.Message);
                            $('#btn-save-create-province').attr('disabled', true);
                        }

                        $('#sel-status').val(data.isFlag);
                        $('#btn-search').trigger('click');
                        loading.hideloading();
                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });
        }

        
        function UpdateProvinceList() {
            //debugger
           var provinceCode = $('#update-province-code').val();
           var provinceName = $('#update-province-name').val();
           var status = $('#update-status').val();
           var enable = true;
           if (status == "1") {
                enable = true;
           }
           else {
                enable = false;
           }

           loading.showloading();

           $.ajax({
               url: '@Url.Action("UpdateProvinceList", "MasterData")',
               type: "POST",
               dataType: "json",
               data: {
                   ProvinceCode: provinceCode,
                   ProvinceName: provinceName,
                   Status: enable
               },
               success: function (data) {
                   if (data.Status == 1)
                   {
                        toastr.success(data.Message);
                        $('#modal-update-province-list').modal('hide');
                   }
                   else if (data.Status == 2)
                   {
                        toastr.warning(data.Message);
                   }
                   else
                   {
                        toastr.error(data.Message);
                   }

                   $('#sel-status').val('');
                   $('#btn-search').trigger('click');
                   loading.hideloading();
               },
               error: function (data) {
                  loading.hideloading();
                  toastr.error('Lỗi hệ thống');
               }
           });
        };

        function ClearText() {
            $('#create-province-code').val('');
            $('#create-province-name').val('');
        };

        $(document).ready(function () {
            $('.select2').select2();

            $('#btn-add-new-province').on('click', function () {
                $('#modal-create-province-list').modal(
                    { "backdrop": "static" }
                );
            });

            $('#btn-save-create-province').on('click', function () {
                CreateProvinceList();
            });

            $('#btn-check-province-code').on('click', function () {
                var provinceCode = $('#create-province-code').val();
                loading.showloading();
                $.ajax({
                    url: '@Url.Action("CheckProvinceCode", "MasterData")',
                    type: "POST",
                    dataType: "json",
                    data: { ProvinceCode: provinceCode },
                    success: function (data) {
                        loading.hideloading();
                        if (data.Status)
                        {
                            toastr.error('Mã tỉnh / thành này đã có trong hệ thống. Vui lòng kiểm tra lại');
                            $('#create-province-name').attr('disabled', true);
                            $('#btn-save-create-province').attr('disabled', true);
                        }
                        else  
                        {
                            toastr.success('Mã tỉnh / thành này chưa có trong hệ thống. Bạn có thể thêm mới');
                            $('#create-province-name').attr('disabled', false);
                            $('#create-province-code').val(data.ProvinceCode);
                            $('#create-province-name').val(data.ProvinceName);
                            $('#btn-save-create-province').attr('disabled', false);
                        }
                    },
                    error: function (data) {
                        loading.hideloading();
                        $('#btn-save-create-province').attr('disabled', true);
                        toastr.error('Lỗi hệ thống');
                    }
                });
            });

            $('#btn-save-update-province').on("click", function () {
                UpdateProvinceList();
            });

            table = $("#tbl-province-list").DataTable({
                destroy: true,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    $(".btn-edit-province").on("click", function () {
                        //debugger
                        var provinceCode = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        $('#update-province-code').val(provinceCode);

                        var provinceName = $(this).parents('tr').find('td:nth-child(5)').html();
                        $('#update-province-name').val(provinceName);

                        var status = $(this).parents('tr').find('td:nth-child(6)').find('span:nth-child(1)').html();
                        var _status = "";
                        if (status == "Đang hoạt động") {
                            _status = "1";
                        }
                        else if (status == "Ngưng hoạt động")
                        {
                            _status = "0";
                        }

                        $('#update-status').val(_status).trigger('change');

                        $('#modal-update-province-list').modal({
                            "backdrop": "static"
                        });

                    });

                    $(".btn-delete-province").click(function () {
                        var provinceCode = $(this).attr("data-province-code");
                        $.confirm({
                            backgroundDismiss: true,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: 'Bạn có chắc chắn muốn xóa tỉnh thành này không?',
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        loading.showloading();
                                        $.ajax({
                                            url: '@Url.Action("DeleteProvinceList", "MasterData")',
                                            type: "POST",
                                            dataType: "json",
                                            data: { ProvinceCode: provinceCode },
                                            success: function (data) {

                                                $('#btn-search').trigger('click');
                                                loading.hideloading();

                                                if (data.Status == 1) {
                                                    toastr.success(data.Message); 
                                                }
                                                else if (data.Status == 2) {
                                                    toastr.warning(data.Message);
                                                }
                                                else {
                                                    toastr.error(data.Message);
                                                }
                                            },
                                            error: function () {
                                                toastr.error("Lỗi hệ thống");
                                                loading.hideloading();
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                processing: false,               // for show progress bar
                serverSide: true,                // for process server side
                lengthChange: false,             // disable lenghthMenu
                filter: false,                   // this is for disable filter (search box)
                orderMulti: false,               // for disable multiple column at once
                searching: false,                // Show (search box)
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetProvinceList", "MasterData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ProvinceCode = $('#txt-province-code').val();
                        d.ProvinceName = $('#txt-province-name').val();
                        d.Status = $('#sel-status').val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var provinceCode = row.ProvinceCode;
                            var html = '<button type="button" class="btn btn-bg-editor btn-edit-province"  data-toggle="tooltip" data-placement="left" title="Chỉnh sửa"   data-province-code="' + provinceCode + '" style="margin-left:5px;"><i class="fas fa-pencil-alt" style="color:#fff;margin-left:5px;"></i></button>';
                                html += '<button type="button" class="btn btn-danger btn-delete-province"  data-toggle="tooltip" data-placement="left" title="Xóa"   data-province-code="' + provinceCode + '"  style="margin-left:5px;"><i class="fas fa-trash" style="color:#fff;margin-left:5px;"></i></button>';
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ID",
                        className: "text-center"
                    },

                    {
                        data: "ProvinceCode",
                        className: "text-center",
                        render: function (data, type, row) {
                            var _ProvinceCode = row.ProvinceCode;
                            return '<span style="display: block; font-weight: 700;">' + _ProvinceCode + '</span>';
                        }
                    },

                    {
                        data: "ProvinceName",
                        className: "text-center"
                    },

                    {
                        data: "Status",
                        className: "text-center",
                        render: function (data, type, row) {
                            var _status = row.Status;
                            if (_status == "Đang hoạt động") {
                                return '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đang hoạt động</span>';
                            }
                            else if (_status == "Ngưng hoạt động") {
                                return '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Ngưng hoạt động</span>';
                            }
                        }
                    },

                    {
                        data: "CreatedDateStr",
                        className: "text-center"
                    },

                    {
                        data: "CreatedUser",
                        className: "text-center"
                    },

                    {
                        data: "LastUpdateDateStr",
                        className: "text-center"
                    },

                    {
                        data: "LastUpdateUser",
                        className: "text-center"
                    }
 
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('#tbl-province-list tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                table.draw();
            });
        })

    </script>
}


<style>
        .btn.btn-bg-editor {
            background-color: #00A09D;
            border-color: #00A09D;
            box-shadow: none;
            color: #ffffff;
            font-weight: 500;
        }
</style>

