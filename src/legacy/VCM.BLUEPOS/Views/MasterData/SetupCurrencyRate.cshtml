@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function getCreateFromDate() {
            var result = "";
            var fromDate = $('#create-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getCreateToDate() {
            var result = "";
            var toDate = $('#create-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getUpdateFromDate() {
            var result = "";
            var fromDate = $('#update-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getUpdateToDate() {
            var result = "";
            var toDate = $('#update-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function parseDate(str) {
            var mdy = str.split('/');
            return new Date(mdy[2], mdy[1], mdy[0]);
        };

        function getYearByToDate(str) {
            var result = "";
            if (str != null && str != "") {
                //result = str.split('/')[2] + "/" + str.split('/')[1] + "/" + str.split('/')[0];
                result = str.split('/')[2]; // Yeaar
            }
            else {
                result = "";
            }
            return result;
        };

        function CreateCurrencyRate() {
            //debugger
            var CurrCode = $('#sel-create-currency-code').val();
            var ExchangeRate = $('#txt-create-exchange-rate').val().replace(/,/g,''); // remove dau phay
            var CreateFromDate = $('#create-from-date').val();
            var CreateToDate = $('#create-to-date').val();
            var Status = $('#sel-create-status').val();

            var _fromDate = getCreateFromDate(); // yyyy/MM/dd
            var _toDate = getCreateToDate();     // yyyy/MM/dd

            if (CurrCode == null || CurrCode == "") {
                toastr.error("Chọn đơn vị tiền tệ cần quy đổi");
                return;
            }

            if (ExchangeRate == null || ExchangeRate == "") {
                toastr.error("Nhập tỷ giá quy đổi sang tiền VNĐ (số dương > 0)");
                return;
            }

            if (Status == null || Status == "") {
                toastr.error("Chọn trạng thái hiệu lực");
                return;
            }

            if (ExchangeRate < 0 || ExchangeRate == 0) {
                toastr.error("Nhập tỷ giá quy đổi sang tiền VNĐ (số dương > 0)");
                return;
            }

            if (CreateFromDate == null || CreateFromDate.length == 0) {
                toastr.error('Chọn hiệu lực từ ngày. Vui lòng kiểm tra lại');
                return;
            }

            if (CreateToDate == null || CreateToDate.length == 0) {
                toastr.error('Chọn hiệu lực đến ngày. Vui lòng kiểm tra lại');
                return;
            }

            var dateNow = new Date();
            var year = dateNow.getFullYear();
            var month = dateNow.getMonth() + 1;
            var day = dateNow.getDate();
            var paramDate = day + '/' + month + '/' + year;
            var getTimeNow = parseDate(paramDate).getTime();
            var dateFrom = parseDate(CreateFromDate).getTime();
            var dateTo = parseDate(CreateToDate).getTime();

            if (dateTo < dateFrom) {
                toastr.error('Hiệu lực từ ngày phải <= hiệu lực đến ngày. Vui lòng kiểm tra lại');
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateCurrencyRate", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    CurrencyCode: CurrCode,
                    ExchangeRate: ExchangeRate,
                    StartingDate: _fromDate,
                    EndingDate: _toDate,
                    Status: Status
                },
                success: function (data) {
                    //debugger
                    $('#sel-unit-currency').val(data.Item1).trigger('change');
                    $('#btn-search').trigger('click');
                    loading.hideloading();
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#modal-create-currency-rate').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function UpdateCurrencyRate() {
            //debugger
            var CurrCode = $('#sel-update-currency-code').val();
            var ExchangeRate = $('#txt-update-exchange-rate').val().replace(/,/g,'');  // remove dau phay
            var UpdateFromDate = $('#update-from-date').val();
            var UpdateToDate = $('#update-to-date').val();
            var Status = $('#sel-update-status').val();
            var _Pkey = $('#temp-update-pkey').val();

            var _fromDate = getUpdateFromDate(); // yyyy/MM/dd
            var _toDate = getUpdateToDate();     // yyyy/MM/dd

            if (CurrCode == null || CurrCode == "") {
                toastr.error("Chọn đơn vị tiền tệ cần quy đổi");
                return;
            }

            if (ExchangeRate == null || ExchangeRate == "") {
                toastr.error("Nhập tỷ giá quy đổi sang tiền VNĐ (số dương > 0)");
                return;
            }

            if (Status == null || Status == "") {
                toastr.error("Chọn trạng thái hiệu lực");
                return;
            }

            if (ExchangeRate < 0 || ExchangeRate == 0) {
                toastr.error("Nhập tỷ giá quy đổi sang tiền VNĐ (số dương > 0)");
                return;
            }

            if (UpdateFromDate == null || UpdateFromDate.length == 0) {
                toastr.error('Chọn hiệu lực từ ngày. Vui lòng kiểm tra lại');
                return;
            }

            var dateNow = new Date();
            var year = dateNow.getFullYear();
            var month = dateNow.getMonth() + 1;
            var day = dateNow.getDate();
            var paramDate = day + '/' + month + '/' + year;
            var getTimeNow = parseDate(paramDate).getTime();
            var dateFrom = parseDate(UpdateFromDate).getTime();
            var dateTo = parseDate(UpdateToDate).getTime();

            if (dateTo < dateFrom) {
                toastr.error('Hiệu lực từ ngày phải <= hiệu lực đến ngày. Vui lòng kiểm tra lại');
                return;
            }

            if (dateTo < getTimeNow) {
                if (Status == "1") {
                    toastr.error('Hiệu lực đến ngày nhỏ hơn ngày hiện tại. Vui lòng chọn trạng thái hết hiệu lực khi cập nhật');
                    return;
                }
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("UpdateCurrencyRate", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    CurrencyCode: CurrCode,
                    ExchangeRate: ExchangeRate,
                    StartingDate: _fromDate,
                    EndingDate: _toDate,
                    Status: Status,
                    Pkey: _Pkey
                },
                success: function (data) {
                    //debugger
                    $('#sel-unit-currency').val(data.Item1).trigger('change');
