@section Scripts
{
    <script type="text/javascript">
        var table = "";

        $("#chk-store-no-slider-not").change(function () {            
            var check = $('#chk-store-no-slider-not').prop('checked');
            if (check == true) {
                $("#store-slider-not").show();
            }
            else {
                $("#store-slider-not").hide();
                $('#txt-create-store-no-slider-not').val(null).trigger("change");
                $("#txt-create-store-no-slider-not").fSelect('reload');
            }
        });

        // Kiêm tra chuoi JSON la [] rỗng
        //function isEmptyObject(obj) {
        //    for (var key in obj) {
        //        if (Object.prototype.hasOwnProperty.call(obj, key)) {
        //            return false;
        //        }
        //    }
        //    return true;
        //}

        function CreateImageSlider() {
            //debugger
            var imgItem = $(".image-input-wrapper").css('background-image');
            var indexBase64 = imgItem.indexOf("base64,");
            var imgBase64 = "";
            if (indexBase64 > 0) {
                var lenghBase64 = indexBase64 + 7;
                imgBase64 = imgItem.substring(lenghBase64, imgItem.lenght);
                imgBase64 = imgBase64.replace('\")', '');
            }

            //debugger
            var storeNo = $('#txt-create-store-no').val();
            if (storeNo == null || storeNo == "") {
                toastr.error("Vui lòng chọn ST/CH");
                return;
            }

            var storeNoSliderNot = $('#txt-create-store-no-slider-not').val();
            var difference = storeNo.filter(x => storeNoSliderNot.indexOf(x) === -1);
            
            if (difference == undefined || difference.length  < 1) {                
                toastr.error("Không có ST/CH phù hợp");
                return;
            }
          
            var fileName = $('#txt-create-file-name').val();
            var urlFile = $('#txt-create-url-file').val();
            var description = $('#txt-create-description').val();
            var status = $('#sel-create-status').val();

            // --------------------
            var flag = true;
            var selectAllStore = $('#txt-create-store-no > option').prop('selected', true);
            var totalSelectAll = JSON.stringify(selectAllStore);
            var totalStoreNo = JSON.stringify(storeNo);
            var a, b= 0;
            a = selectAllStore.length;
            b = storeNo.length;
            var totalStore = a - b;
            
            if (totalStore == 0 || totalStore == 1) // Chọn tất cả Store
            {
                flag = true;
            }
            else
            {
                flag = false;
            }
            // --------------------
            var flag2 = true;
            var checkStore = true;
            var selectAllStore2 = $('#txt-create-store-no-slider-not > option').prop('selected', true);

            //var StoreNoListNotSlider = JSON.stringify(storeNoSliderNot);
            //var isStoreList = isEmptyObject(StoreNoListNotSlider);
            //if (isStoreList == true) {
            //    storeNoSliderNot = "";
            //}

            //var totalSelectAll2 = JSON.stringify(selectAllStore2);
            //var totalStoreNo2 = JSON.stringify(storeNoSliderNot);
            //var totalStore2 = totalSelectAll2.length - totalStoreNo2.length;

            var c, d = 0;
            c = selectAllStore2.length;
            d = storeNoSliderNot.length;
            var totalStore2 = c - d;

            var chkStoreNoSliderNot = $('#chk-store-no-slider-not').prop('checked');
            if (chkStoreNoSliderNot == true)
            {
                checkStore = true;
                if (totalStore2 == 0) // Chon tat ca Store
                {
                    flag2 = true;
                }
                else
                {
                    flag2 = false;
                }
            }
            else
            {
                flag2 = false;
                checkStore = false;
            }
            // -------------------
            if (imgBase64 == null || imgBase64 == "") {
                toastr.error("Vui lòng chọn file hình");
                return;
            }
            var img_item_create = $('#imgItem-create').val();
            fileName = img_item_create;           
            // Kiểm tra định dạng file hình
            var extension = fileName.split('.').pop().toLowerCase();
            if ($.inArray(extension, ['png', 'gif', 'jpeg', 'jpg']) == -1) {
                toastr.error("Tên file ảnh không hợp lệ!");
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateImageSlider", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    StoreListStr: JSON.stringify(storeNo),
                    StoreListStr2: JSON.stringify(storeNoSliderNot),
                    FileName: fileName,
                    UrlFile: urlFile,
                    Description: description,
                    ImageBase64: imgBase64,
                    Status: status,
                    IsSelectAll: flag,
                    IsSelectAll2: flag2,
                    CheckStore: checkStore
                },
                success: function (data) {
                    //debugger
                    if (data.Status == 1)
                    {
                        toastr.success("Thêm mới thành công");
                        $("#txt-create-store-no").fSelect('reload');
                        $('#txt-create-store-no > option').prop('selected', false);
                        $("#chk-store-no-slider-not").prop('checked', false);
                        $("#txt-create-store-no-slider-not").fSelect('reload');
                        $('#txt-create-store-no-slider-not > option').prop('selected', false);
                        $("#store-slider-not").css('display', 'none'); 
                        $('#modal-create-image-slider').modal('hide');
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    $('#btn-search').trigger('click');
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }
    
        function UpdateImageSlider() {
             //debugger
             var id = $('#txt-update-image-slider-id').val();
             var pkey = $('#txt-update-image-slider-pkey').val();
             var fileName = $('#txt-update-file-name').val();
             var fileNameNew = $('#txt-update-file-name-new').val();
             var fileNameOld = $('#txt-update-file-name-old').val();
             var urlFile = $('#txt-update-url-file-temp').val();
             var status = $('#sel-update-status').val();
             var description = $('#txt-update-description').val();
             var storeNo = $('#txt-update-store-no').val();
             var imgItemUpdate = $("#tbl-update-img-slider").find(".image-input-wrapper").css('background-image');
             var indexBase64 = imgItemUpdate.indexOf("base64,");
             var imgBase64 = "";
             if (indexBase64 > 0) {
                var lenghBase64 = indexBase64 + 7;
                imgBase64 = imgItemUpdate.substring(lenghBase64, imgItemUpdate.lenght);
                imgBase64 = imgBase64.replace('\")', '');
             }
            // debugger
            if (fileName == null || fileName == "") {
                toastr.error("Vui lòng nhập tên file hình ảnh");
                return;
            }
            if (imgBase64 == null || imgBase64 == "") {
                toastr.error("Vui lòng chọn hình ảnh");
                return;
            }
            // Kiểm tra định dạng file hình
            var extension = fileName.split('.').pop().toLowerCase();
            if ($.inArray(extension, ['png', 'gif', 'jpeg', 'jpg']) == -1) {
                toastr.error("Tên file ảnh không hợp lệ!");
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateImageSlider", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    ID: id,
                    StoreNo: storeNo,
                    FileName: fileName,
                    FileNameNew: fileNameNew,
                    FileNameOld: fileNameOld,
                    UrlFile: urlFile,
                    Description: description,
                    ImageBase64: imgBase64,
                    Status: status,
                    Pkey: pkey
                },
                success: function (data) {
                    //debugger
                    if (data.Status == 1)
                    {
                        toastr.success("Cập nhật thành công");
                        $('#modal-update-image-slider').modal('hide');
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    $('#btn-search').trigger('click');
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function GetImagesBase64(id, pkey) {
            //debugger
            loading.showloading();
            $.ajax({
                url: '@Url.Action("GetImagesSilder", "MasterData")',
                type: "POST",
                dataType: "json",
                data: { ID: id,Pkey: pkey },
                success: function (data) {                     
                    if (data.Status == "1") {
                        var imgUpdate = "/Uploads/imgs/placeholder.png";
                        var imageChange = "image-input image-input-outline";
                        if (data.ImageBase64 != null && data.ImageBase64 != '') {
                            imgUpdate = "data:image/jpeg;base64," + data.ImageBase64;
                            imageChange = "image-input image-input-outline image-input-changed";
                        }
                        var urlImg = imgUpdate;
                        var html = "";
                        html += '<div class=\"' + imageChange + '\" id="kt_img_item_update">';
                        html += '<div class=\"image-input-wrapper\" style=\"background-image: url(' + urlImg + ')\"></div>';
                        html += '<label class=\"btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow\" data-action=\"change\" data-toggle=\"tooltip\" title="" data-original-title=\"Change avatar\">';
                        html += '<i class=\"fa fa-pen icon-sm text-muted\"></i>';
                        html += '<input type="file" id="imgItem-update" name="imgItemUpdate" accept=".png, .jpg, .jpeg" />';
                        html += '<input type="hidden" name="imgItem_remove" />';
                        html += '</label>';
                        html += '<span id="btnCancleImg-update" class=\"btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow\" data-action=\"cancel\" data-toggle=\"tooltip\" title=\"Cancel avatar\">';
                        html += '<i class=\"ki ki-bold-close icon-xs text-muted\"></i>';
                        html += '</span>';
                        html += '</div>';
                        $("#tbl-update-img-slider").html(html);

                        // --- Luu tên hinh khi chon file để cập nhật ---
                        $("#imgItem-update").on("change", function (e) {
                            var img_item_update = $('#imgItem-update').val();
                            var fileName = img_item_update.split('\\')[2];
                            $("#txt-update-file-name").val(fileName);
                            $("#txt-update-file-name-new").val('');
                            $("#txt-update-file-name-new").val(fileName);
                        });

                        new KTImageInput('kt_img_item_update');
                        $("#btnCancleImg-update").on("click", function (e) {
                            //debugger
                            $("#tbl-update-img-slider").find(".image-input-wrapper").css("background-image", 'url("/Uploads/imgs/placeholder.png"');
                        });
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error("Không tìm thấy file hình này trên CDN");
                }
            });
        }

