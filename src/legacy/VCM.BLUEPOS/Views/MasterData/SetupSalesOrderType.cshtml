@section Scripts
{
    <script type="text/javascript">

        var table = "";

        function LoadComboxSalesOrderType() {
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxSalesOrderType", "Common")',
                dataType: "json",
                success: function (data) {   
                    if (data != null) {
                        if (data.length == 1) {
                            data.forEach((name, i) => {
                                var html = "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + "</option>"
                            });
                            $('#sel-sales-order-type').html(html);
                        }
                        else if (data.length > 1)
                        {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.Code != "") {
                                    html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + "</option>";
                                }
                            });
                            $('#sel-sales-order-type').html(html);
                        }                        
                    }
                    loading.hideloading();
                },
                error: function ()
                {
                }
            });
        }


    $(document).ready(function () {

        $(".select2").select2();
        LoadComboxSalesOrderType();

        $('#btn-add-new-sales-order-type').on('click', function (e) {
            ClearText();
            $('#modal-create-sales-order-type').modal({
                backdrop: "static"
            });
        });

        $('#btn-save-create-sales-order-type').on('click', function (e) {
            CreateOrderSalesType();
        });

        $('#btn-editor-sales-order-type').on('click', function (e) {
            $('#modal-update-sales-order-type').modal({
                backdrop: "static"
            });
        });

        $('#btn-save-update-sales-order-type').on('click', function (e) {
            UpdateOrderSalesType();
        });

        $("#create-percent").change(function () {
            var value = $("#create-percent").val();
            if (value > 0) {
                $('#create-tender-type').attr('disabled', false);
            } else {
                $('#create-tender-type').attr('disabled',true);
            }
        });

        $("#update-percent").change(function () {
            var value = $("#update-percent").val();
            if (value > 0) {
                $('#update-tender-type').attr('disabled', false);
            } else {
                $('#update-tender-type').attr('disabled', true);
            }
        });

        table = $('#tbl-sales-order-type').DataTable({
                destroy: true,
                select: {
                    style: 'single'
                },
                drawCallback: function (settings) {
                    $(".btn-editor-sales-order-type").click(function () {
                        //var _salesCode = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                        //$('#update-sales-order-type-code').val(_salesCode);

                        //var _salesName = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        //$('#update-sales-order-type-name').val(_salesName);

                        //var _tenderType = $(this).parents('tr').find('td:nth-child(5)').find('span:nth-child(1)').html();
                        //$('#update-tender-type').val(_tenderType).trigger('change');

                        //var _paymentTenderType = $(this).parents('tr').find('td:nth-child(7)').find('span:nth-child(1)').html();
                        //$('#update-payment-tender-type').val(_paymentTenderType).trigger('change');

                        //var _percent = $(this).parents('tr').find('td:nth-child(9)').find('span:nth-child(1)').html();
                        //$('#update-percent').val(_percent);

                        var _salesCode = $(this).attr("data-code");
                        $('#update-sales-order-type-code').val(_salesCode);

                        var _salesName = $(this).attr("data-sales-type-name");
                        $('#update-sales-order-type-name').val(_salesName);

                        var _tenderType = $(this).attr("data-tender-type");
                        $('#update-tender-type').val(_tenderType).trigger('change');

                        var _paymentTenderType = $(this).attr("data-payment-tender-type");
                        $('#update-payment-tender-type').val(_paymentTenderType).trigger('change');

                        var _percent = $(this).attr("data-percent");
                        $('#update-percent').val(_percent);

                        var allowedCardService = $(this).attr("data-card-service");
                        var _isAllowedCardService = "";
                        if (allowedCardService == "Có") {
                            _isAllowedCardService = "1";            // true = 1
                        }
                        else if (allowedCardService == "Không") {
                            _isAllowedCardService = "0";            // false = 0
