@using VCM.BLUEPOS.Model.MasterData;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Khai báo Sales OrderType";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var model = Model as SalesType;
    var listSalesType = model.ListSalesType;
    var listTenderType = ViewBag.ListTenderType as List<OptionModel>;
    var listPaymentTenderType = ViewBag.ListPaymentTenderType as List<OptionModel>;
}

<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
        margin-top: -35px;
    }
</style>


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo Sales OrderType</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Hình thức bán hàng</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-sales-order-type" name="SalesOrderType"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-status-sales-order-type" name="StatusType" style="width: 100%;">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Có hiệu lực</option>
                                            <option value="0">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="col-4">
                            <button type="button" id="btn-add-new-sales-order-type" class="btn btn-bg-success font-weight-bold"><i class="la la-plus-circle" style="color:#fff;"></i><span style="color:#fff;">Thêm mới</span></button>
                        </div>
                        <div style="padding-top:5px;">
                            <table id="tbl-sales-order-type" class="table table-bordered table-hover text-nowrap">
                                <thead>
                                    <tr class="text-center" style="text-transform:uppercase">
                                        <th width="130px">#</th>
                                        <th>STT</th>
                                        @*<th style="display:none;">Mã hình thức bán hàng</th>*@
                                        @*<th>Mã chiết khấu (TenderType)</th>*@
                                        @*<th>Mã hình thức thanh toán</th>*@
                                        <th>Hình thức bán hàng</th>
                                        <th>Hình thức thanh toán</th>
                                        <th>Chiết khấu</th>
                                        <th>Percent (%)</th>
                                        <th>Dịch vụ thẻ</th>
                                        <th>Trạng thái</th>
                                        <th>Trả hàng</th>
                                        <th>Tích điểm Loyalty</th>
                                        <th>Order</th>
                                        <th>Hình ảnh</th>
                                        <th>Ngày tạo</th>
                                        <th>Người tạo</th>
                                        <th>Ngày cập nhật</th>
                                        <th>Người cập nhật</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-create-sales-order-type" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Khai báo Sales Order Type</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-sales-order-type-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã hình thức bán hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="create-sales-order-type-code" name="SalesOrderTypeCode" placeholder="">
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên hình thức bán hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="create-sales-order-type-name" name="SalesOrderTypeName" placeholder="">
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hình thức thanh toán</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width: 100%;" id="create-payment-tender-type" name="CreatePaymentTenderType">
                                                <option value="" selected disabled>--- Chọn ---</option>
                                                @if (listPaymentTenderType != null && listPaymentTenderType.Count > 0)
                                                {
                                                    if (listPaymentTenderType.Count == 1)
                                                    {
                                                        <option value="@listPaymentTenderType.FirstOrDefault().Value">@listPaymentTenderType.FirstOrDefault().Text</option>
                                                    }
                                                    else
                                                    {
                                                        foreach (var item in listPaymentTenderType)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Loại chiết khấu</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width: 100%;" id="create-tender-type" name="TenderType">
                                                <option value="" selected disabled>--- Chọn ---</option>
                                                @if (listTenderType != null && listTenderType.Count > 0)
                                                {
                                                    if (listTenderType.Count == 1)
                                                    {
                                                        <option value="@listTenderType.FirstOrDefault().Value">@listTenderType.FirstOrDefault().Text</option>
                                                    }
                                                    else
                                                    {
                                                        foreach (var item in listTenderType)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Percent (%)</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="create-percent" name="Percent" value="" placeholder="Nhập percent %">
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="create-status-sales-order-type" name="CreateStatusSalesOrderType">
                                                <option value="1" selected>Có hiệu lực</option>
                                                <option value="0">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trả hàng</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="create-return-order" name="ReturnOrder">
                                                <option value="0" selected>Không được trả hàng</option>
                                                <option value="1">Được trả hàng</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tích điểm Loyalty</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="create-blocked-loyalty" name="BlockedLoyalty">
                                                <option value="0">Có tích điểm</option>
                                                <option value="1" selected>Không tích điểm</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-1 col-md-1 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Dịch vụ thẻ</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="create-allowed-card-service" name="CreateAllowedCardService">
                                                <option value="0">Không</option>
                                                <option value="1" selected>Có</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hình ảnh</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="create-image-name" name="ImageName" placeholder="Nhập tên file hình ảnh...">
                                        </div>
                                    </div>
                                   
                                    <div class="col-lg-1 col-md-1 col-sm-6 col-xs-6">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số thứ tự</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" id="create-order" name="CreateOrder" placeholder="Nhập số thứ tự">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-sales-order-type" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

