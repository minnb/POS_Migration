        function CreateOrderSalesType() {
            //debugger
            var salesCode           = $('#create-sales-order-type-code').val();
            var salesName           = $('#create-sales-order-type-name').val();
            var percent             = $('#create-percent').val();
            var tenderType          = $('#create-tender-type').val();
            var paymentTenderType   = $('#create-payment-tender-type').val();
            var statusType          = $('#create-status-sales-order-type').val();
            var order               = $('#create-order').val();
            var imageName           = $('#create-image-name').val();
            var returnOrder         = $('#create-return-order').val();
            var blockLoyalty        = $('#create-blocked-loyalty').val();
            var allowedCardService  = $('#create-allowed-card-service').val();
            
            if (salesCode == null || salesCode == "") {
                toastr.error("Nhập mã hình thức bán hàng");
                return;
            }

            if (salesName == null || salesName == "") {
                toastr.error("Nhập tên hình thức bán hàng");
                return;
            }

            if (percent == null || percent == "") {
                toastr.error("Nhập giá trị percent");
                return;
            }

            if (percent > 0) {
                if (tenderType == null || tenderType == "") {
                    toastr.error("Vui lòng chọn TenderType");
                    return;
                }
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateSalesOrderType", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    SalesTypeCode: salesCode,
                    TenderType: tenderType,
                    PaymentTenderType: paymentTenderType,
                    Description: salesName,
                    Percent: percent,
                    ImageName:imageName,
                    IsActive: statusType,
                    Order: order,
                    ReturnOrder: returnOrder,
                    BlockedLoyaltyStr: blockLoyalty,
                    AllowedCardService: allowedCardService
                },
                success: function (data) {
                    LoadComboxSalesOrderType();
                    $('#sel-status-sales-order-type').val(data.Item2).trigger('change');
                    $('#btn-search').trigger('click');
                    loading.hideloading();

                    if (data.Status == 1)
                    {                        
                        toastr.success(data.Message);
                        $('#modal-create-sales-order-type').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                        toastr.error(data.Message);
                    }
                    else if (data.Status == 3)
                    {
                        toastr.error(data.Message);
                        //$('#btn-save-create-sales-order-type').attr('disabled', true);
                    }   
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });

    }

