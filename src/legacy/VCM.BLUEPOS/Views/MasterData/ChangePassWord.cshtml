@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đổi mật khẩu</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-search-key-word" name="KeyWord" placeholder="Nhập mã nhân viên; tên nhân viên">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-change-password-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th width="50px;">#</th>
                                    <th>STT</th>
                                    <th>Mã nhân viên</th>
                                    <th>Tên nhân viên</th>
                                    <th>Mật khẩu</th>
                                    <th>Chức vụ</th>
                                    <th>Loại tài khoản</th>
                                    <th>Mã cửa hàng</th>
                                    <th>Tên cửa hàng</th>
                                    <th>Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Popup : Thay đổi mật khẩu -->

<div id="modal-change-pass-word" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-change-pass-word">ĐỔI MẬT KHẨU</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-change-pass-word-body">
                <form id="myForm" method="POST">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                            <div class="card card-custom bgi-no-repeat card-stretch">
                                <div class="card-body">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Mã nhân viên</label>
                                            <input type="text" class="form-control" id="update-staff-code" name="UpdateStaffCode" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Tên nhân viên</label>
                                            <input type="text" class="form-control" id="update-staff-name" name="UpdateStaffName" disabled>
                                        </div>
                                    </div>

                                    <input type="hidden" class="form-control" id="update-store-no" name="UpdateStoreNo">

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Mật khẩu cũ</label>
                                            <input type="text" class="form-control" id="update-password-old" name="UpdatePassWordOld" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Mật khẩu mới<strong style="color:#ff0000"> (*)</strong></label>
                                            <input type="text" class="form-control" id="update-password-new" name="UpdatePassWordNew">
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary" id="btn-save-change-pass-word" name="btnSaveUpdateChangePassword"> <i class="fa fa-save"></i>Lưu lại</button>
                <button type="button" id="close-modal-detail-payment-order" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>

        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var table = "";

        $('#txt-search-key-word').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        function ChangePassWord() {
            //debugger
            var staffCode = $('#update-staff-code').val();
            var staffName = $('#update-staff-name').val();
            var storeNo = $('#update-store-no').val();
            var passWordOld = $('#update-password-old').val();
            var passWordNew = $('#update-password-new').val();
            if (passWordNew == null || passWordNew == '') {
                toastr.error('Vui lòng nhập mật khẩu mới');
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("ChangePassWord", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    StaffCode: staffCode,
                    StaffName: staffName,
                    StoreNo: storeNo,
                    PassWordOld: passWordOld,
                    PassWordNew: passWordNew
                },
                success: function (data) {                         
                    loading.hideloading();                    
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#modal-change-pass-word').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    $('#btn-search').trigger('click');
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxStoreByServer(ipServer) {
            //debugger
            if (ipServer == null || ipServer == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-store-no').html(html);
            }              
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1)
                        {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1)
                        {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }                    
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        };

        function ClearText() {
            $('#update-password-new').val('');
        }

        $('#update-password-new').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSaveUpdateChangePassword]').click();
                return false;
            }
        });

        function CountString(str) {
            var totalStr = 0;
            totalStr = str.length;
            return totalStr;
        }

        function generateStars(str) {
            var stars = '';
            var n = CountString(str);
            if (n == 0) {
                return stars;
            }
            for (var i = 1; i <= n; i++) {
                stars += '*';
            }
            return stars;
        }


        $(document).ready(function () {

                $('.select2').select2();

                LoadComboxStoreByServer($("#sel-set-server").val());

                $("#sel-set-server").on("change", function (e) {
                    LoadComboxStoreByServer($("#sel-set-server").val());
                });

                $('#btn-save-change-pass-word').on("click", function () {
                    ChangePassWord();
                });

                table = $('#tbl-change-password-list').DataTable({
                        destroy: true,
                        select: {
                            style: 'single'
                        },
                        drawCallback: function (settings) {

                            $(".btn-update-change-password").click(function () {
                                var staffCode = $(this).attr("data-staff-code");
                                $('#update-staff-code').val(staffCode);

                                var staffName = $(this).attr("data-staff-name");
                                $('#update-staff-name').val(staffName);

                                var storeNo = $(this).attr("data-store-no");
                                $('#update-store-no').val(storeNo);

                                var passWordOld = $(this).attr("data-pass-word-old");
                                $('#update-password-old').val(passWordOld);

                                ClearText();

                                $('#modal-change-pass-word').modal({
                                    backdrop: 'static',
                                    keyboard: true
                                });

                                $('#update-password-new').focus();

                            });
                        },

                    dom: '<"top"iflp<"clear">>rt',
                    paging: true,
                    pagingType: "simple_numbers",
                    responsive: false,
                    processing: false,          // for show progress bar
                    serverSide: true,           // for process server side
                    filter: false,              // this is for disable filter (search box)
                    orderMulti: false,          // for disable multiple column at once
                    info: true,                 // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                    autoWidth: true,
                    ordering: false,
                    displayLength: 15,
                    searching: false,
                    lengthChange: false,
                    scrollCollapse: false,
                    scrollX: true,

                    ajax: {
                        url: '@Url.Action("ChangePassWordList", "MasterData")',
                        type: "POST",
                        datatype: "json",
                        data: function (d) { 
                            d.SetDB = $('#sel-set-server').val();
                            d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                            d.StoreNo = $('#sel-store-no').val();
                            d.TextSearch = $('#txt-search-key-word').val();
                        }
                    },

                    columns: [
                            {
                                className: "text-center",
                                render: function (data, type, row) {
                                    var html = '<a type="button" class="btn btn-icon btn-light-warning btn-update-change-password"  data-staff-code ="' + row.StaffCode + '"  data-staff-name="' + row.StaffName + '"  data-store-no="' + row.StoreNo + '"  data-pass-word-old="' + row.PassWord + '"  data-toggle="tooltip" data-placement="left" title="Cập nhật"  style="color:#fff;text-align:center;"><i class="la la-edit"></i><span class="pulse-ring"></span></a>';
                                    return html;
                                }
                            },

                            {
                                className: "text-center",
                                render: function (data, type, row, meta) {
                                    var start = meta.settings._iDisplayStart;
                                    return meta.row + 1 + start;
                                }
                            },

                            {
                                data: "StaffCode",            
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:700;display:block;text-align:left;">' + row.StaffCode + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "StaffName",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display:block;text-align:left;">' + row.StaffName + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "PassWord",
                                render: function (data, type, row) {
                                    //var _pass = row.PassWord;
                                    //var _encPWD = generateStars(_pass);
                                    var html = '<span style="font-weight:400;display: block;text-align:left;color:blue;">' + row.PassWord + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "EmploymentType",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display: block;text-align:left;">' + row.EmploymentType + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "PermissionGroup",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display: block;text-align:center;color:#0C713D">' + row.PermissionGroup + '</span>';
                                    return html;
                                }
                            },

                            {  
                                data: "StoreNo",
                                className: "text-center",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display: block;">' + row.StoreNo + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "StoreName",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display:block;text-align:left">' + row.StoreName + '</span>';
                                    return html;
                                }
                            },

                            {
                                data: "UpdatedDateStr",
                                className: "text-center",
                                render: function (data, type, row) {
                                    var html = '<span style="font-weight:400;display: block;">' + row.UpdatedDateStr + '</span>';
                                    return html;
                                }
                            }

                        ]

                    }).on('processing.dt', function (e, settings, processing) {
                        if (processing) {
                            loading.showloading();
                        } else {
                            loading.hideloading();
                        }

                        });

                    $('#tbl-change-password-list tbody').on('click', 'tr', function () {
                        $(this).toggleClass('selected');
                    });

                $("#btn-search").on("click", function (e) {
                    table.draw();
                });


    });

    </script>
}






