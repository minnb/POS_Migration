        function CreateImageSlider_V2() {
            //debugger
            var imgItem = $(".image-input-wrapper").css('background-image');
            var indexBase64 = imgItem.indexOf("base64,");
            var imgBase64 = "";
            if (indexBase64 > 0) {
                var lenghBase64 = indexBase64 + 7;
                imgBase64 = imgItem.substring(lenghBase64, imgItem.lenght);
                imgBase64 = imgBase64.replace('\")', '');
            }

            //debugger
            var storeNo = $('#sel-modal-add-store-no').val(); 
            if (storeNo == null || storeNo == "") {
                toastr.error("Vui lòng chọn cửa hàng");
                return;
            }

            //var storeNoSliderNot = $('#txt-create-store-no-slider-not').val();
            var storeNoSliderNot = $('#sel-modal-add-store-no-slider-not').val();
            var difference = storeNo.filter(x => storeNoSliderNot.indexOf(x) === -1);            
            if (difference == undefined || difference.length  < 1) {                
                toastr.error("Không có cửa hàng phù hợp");
                return;
            }

            var urlFile = $('#txt-create-url-file').val();

            var fileName = $('#txt-create-file-name').val();
            if (fileName == null || fileName == "") {
                toastr.error("Vui lòng chọn file hình ảnh");
                return;
            }

            var description = $('#txt-create-description').val();
            if (description == null || description == "") {
                toastr.error("Vui lòng nhập tên chương trình");
                return;
            }

            var status = $('#sel-create-status').val();
            var fromDate = $('#txt-create-from-date').val();
            var toDate = $('#txt-create-to-date').val();

            if (fromDate == null || fromDate == "") {
                toastr.error("Vui lòng chọn hiệu lực từ ngày");
                return;
            }
            if (toDate == null || toDate == "") {
                toastr.error("Vui lòng chọn hiệu lực đến ngày");
                return;
            }

            if (toDate.Date < fromDate.Date) {
                toastr.error('Hiệu lực đến ngày >= Hiệu lực từ ngày. Vui lòng kiểm tra lại');
                return;
            }

            var _fromDate = getCreateFromDate();
            var _toDate = getCreateToDate();

            var dateNow = new Date();
            var year = dateNow.getFullYear();
            var month = dateNow.getMonth() + 1;
            var day = dateNow.getDate();
            var paramDate = day + '/' + month + '/' + year;
            var getTimeNow = parseDate(paramDate).getTime();
            var dateFrom = parseDate(fromDate).getTime();
            var dateTo = parseDate(toDate).getTime();

            if (dateFrom < getTimeNow) {
                toastr.error('Hiệu lực từ ngày >= ngày hiện tại. Vui lòng kiểm tra lại');
                return;
            }

            if (dateTo < getTimeNow) {
                toastr.error('Hiệu lực đến ngày >= ngày hiện tại. Vui lòng kiểm tra lại');
                return;
            }

            // --------------------

            var flag = true;
            var selectAllStore = $('#sel-modal-add-store-no > option').prop('selected', true);

            //var selectAllStore = $('#txt-create-store-no > option').prop('selected', true);
            var totalSelectAll = JSON.stringify(selectAllStore);
            var totalStoreNo = JSON.stringify(storeNo);
            var a, b= 0;
            a = selectAllStore.length;
            b = storeNo.length;
            var totalStore = a - b;
            
            if (totalStore == 0 || totalStore == 1) // Chọn tất cả Store
            {
                flag = true;
            }
            else
            {
                flag = false;
            }

            // --------------------
            var flag2 = true;
            var checkStore = true;
            var selectAllStore2 = $('#sel-modal-add-store-no-slider-not > option').prop('selected', true);

            //var selectAllStore2 = $('#txt-create-store-no-slider-not > option').prop('selected', true);

            //var StoreNoListNotSlider = JSON.stringify(storeNoSliderNot);
            //var isStoreList = isEmptyObject(StoreNoListNotSlider);
            //if (isStoreList == true) {
            //    storeNoSliderNot = "";
            //}

            //var totalSelectAll2 = JSON.stringify(selectAllStore2);
            //var totalStoreNo2 = JSON.stringify(storeNoSliderNot);
            //var totalStore2 = totalSelectAll2.length - totalStoreNo2.length;

            var c, d = 0;
            c = selectAllStore2.length;
            d = storeNoSliderNot.length;
            var totalStore2 = c - d;

            var chkStoreNoSliderNot = $('#chk-store-no-slider-not').prop('checked');
            if (chkStoreNoSliderNot == true)
            {
                checkStore = true;
                if (totalStore2 == 0) // Chon tat ca Store
                {
                    flag2 = true;
                }
                else
                {
                    flag2 = false;
                }
            }
            else
            {
                flag2 = false;
                checkStore = false;
            }

            // -------------------

            if (imgBase64 == null || imgBase64 == "") {
                toastr.error("Vui lòng chọn file hình");
                return;
            }

            var img_item_create = $('#imgItem-create').val();
            fileName = img_item_create;     
            
            // Kiểm tra định dạng file hình
            var extension = fileName.split('.').pop().toLowerCase();
            if ($.inArray(extension, ['png', 'gif', 'jpeg', 'jpg']) == -1) {
                toastr.error("Tên file ảnh không hợp lệ!");
                return;
            }
            loading.showloading();

            $.ajax({
                @*url: '@Url.Action("CreateImageSlider", "MasterData")',*@
                url: '@Url.Action("CreateImageSlider_V2", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    StoreListStr: JSON.stringify(storeNo),
                    StoreListStr2: JSON.stringify(storeNoSliderNot),
                    FileName: fileName,
                    UrlFile: urlFile,
                    Description: description,
                    ImageBase64: imgBase64,
                    Status: status,
                    IsSelectAll: flag,
                    IsSelectAll2: flag2,
                    CheckStore: checkStore,
                    FromDate: _fromDate,
                    ToDate: _toDate
                },
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 1)
                    {
                        toastr.success("Thêm mới thành công");
                        ClearTextForCreate();

