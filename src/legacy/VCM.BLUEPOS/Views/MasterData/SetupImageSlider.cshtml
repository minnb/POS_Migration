@using Newtonsoft.Json;
@using System.Web.Configuration;
@using VCM.BLUEPOS.Model.MasterData;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Khai báo Images Slider";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    string urlImgServer = WebConfigurationManager.AppSettings["urlImg"];
    var imgBase64 = ViewBag.ImagesBase64;
    var listStore = ViewBag.StoreList as List<OptionModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo Images Slider</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <button type="button" id="btn-images-slider-block" class="btn btn-warning"><i class="fa fa-lock" style="color:#fff;"></i><span style="color:#fff;font-weight:700;">&nbsp;Khóa</span></button>
                <button type="button" id="btn-add-new-image-slider" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>&nbsp;Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_ImagesSliderList", "MasterData", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Kênh</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-style-profile" name="StyleProfile">
                                            <option value="ALL">Tất cả</option>
                                            <option value="FS">FlashShip</option>
                                            <option value="KS">Kiosk</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng</label>
                                    <div class="form-group" id="div-store-no"> 
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status-file" name="StatusFile">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Có hiệu lực</option>
                                            <option value="0">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-5 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên chương trình</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-description" name="Description" placeholder="Nhập tên chương trình...">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên file hình ảnh</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-file-name" name="FileName" placeholder="Nhập tên file hình...">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">               
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">                    
                    <div class="card-body">                     
                        <table id="tbl-images-slider-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th width="90px;">#</th>
                                    <th>Stt</th>
                                    <th>ID</th>
                                    <th>Cửa hàng</th>
                                    <th>Tên chương trình</th>
                                    <th>Trạng thái</th>
                                    <th>Hiệu lực từ ngày</th>
                                    <th>Hiệu lực đến ngày</th>
                                    <th>Tên file hình ảnh</th>
                                    <th>Url</th>
                                    <th>Ngày tạo</th>
                                    <th>Người tạo</th>
                                    <th>Ngày cập nhật</th>
                                    <th>Người cập nhật</th>
                                    <th>Pkey</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-create-image-slider" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-image-slider">Khai báo thông tin Images Slider</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="modal-create-images-slider-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Kênh<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-modal-add-style-profile" name="StyleProfile">
                                                <option value="ALL">Tất cả</option>
                                                <option value="FS">FlashShip</option>
                                                <option value="KS">Kiosk</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group" id="div-modal-add-store-no"></div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <input type="checkbox" id="chk-store-no-slider-not" style="height:25px; width:25px; cursor:pointer; padding-top: 5px; margin-left: 1px; margin-top:10px;">
                                        <label for="chk-store-no-slider-not" style="font-size:12px; font-weight:700 !important; position: absolute; top: 15px; padding-left: 8px;">Chọn cửa hàng không áp dụng (nếu có)</label>
                                    </div>

                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12" style="display:none; margin-top:8px;" id="store-slider-not">
                                        <div class="form-group" id="div-modal-add-store-slider-not">
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;margin-top:18px;">Upload file hình ảnh<strong style="color:#ff0000"> (*)</strong></label>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-left:5px;margin-top:5px;">
                                        @{
                                            var urlImg = "/Uploads/imgs/placeholder.png";
                                            var isChangeImg = "";
                                            if (!string.IsNullOrEmpty(imgBase64))
                                            {
                                                urlImg = "data:image/jpeg;base64," + imgBase64;
                                                isChangeImg = "image-input-changed";
                                            }
                                        }

                                        <div class="image-input image-input-outline @isChangeImg" id="kt_img_item_create">
                                            <div class="image-input-wrapper" style="background-image: url(@urlImg)"></div>
                                            <label class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-toggle="tooltip" title="" data-original-title="Change avatar">
                                                <i class="fa fa-pen icon-sm text-muted"></i>
                                                <input type="file" id="imgItem-create" name="imgItemCreate" accept=".png, .jpg, .jpeg" />
                                                <input type="hidden" name="imgItem_remove" />
                                            </label>
                                            <span id="btnCancleImg" class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="cancel" data-toggle="tooltip" title="Cancel avatar">
                                                <i class="ki ki-bold-close icon-xs text-muted"></i>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên file hình ảnh<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" id="txt-create-file-name" name="FileName" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên chương trình<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" id="txt-create-description" name="CreateDescription" placeholder="Nhập tên chương trình..." />
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-create-from-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right" id="txt-create-from-date" name="CreateFromDate">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-create-to-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right date-pick" id="txt-create-to-date" name="CreateToDate" />
                                            </div>
                                        </div>
                                    </div>
  
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-status" name="CreateStatusFile">
                                                <option value="1" selected>Có hiệu lực</option>
                                                <option value="0">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-image-slider" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal" id="btn-close-modal-create"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-update-image-slider" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-update-image-slider">Cập nhật thông tin Images Slider</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="modal-update-image-slider-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold">Cửa hàng</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="txt-update-store-no" name="UpdateStoreNo" disabled>
                                                @if (listStore != null && listStore.Count > 0)
                                                {
                                                    if (listStore.Count == 1)
                                                    {
                                                        <option value="@listStore.FirstOrDefault().Value">@listStore.FirstOrDefault().Value - @listStore.FirstOrDefault().Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="" selected>Tất cả</option>
                                                        <option value="ALL">ALL</option>
                                                        foreach (var item in listStore)
                                                        {
                                                            <option value="@item.Value">@item.Value - @item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold">Upload file hình ảnh<strong style="color:#ff0000"> (*)</strong></label>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-left:5px;min-height:120px;" id="tbl-update-img-slider">

                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12" style="padding-top: 10px;">
                                        <label class="font-weight-bold">Tên file hình ảnh<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-update-file-name" name="UpdateFileName">
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12" style="padding-top: 10px;">
                                        <label class="font-weight-bold">Tên chương trình<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" id="txt-update-description" name="UpdateDescription" />
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold">Hiệu lực từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-update-from-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right" id="txt-update-from-date" name="UpdateFromDate">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold">Hiệu lực đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-update-to-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right date-pick" id="txt-update-to-date" name="UpdateToDate" />
                                            </div>
                                        </div>
                                    </div>

                                    <input type="hidden" id="txt-update-url-file-temp" />
                                    <input type="hidden" id="txt-update-file-name-new" />
                                    <input type="hidden" id="txt-update-file-name-old" />
                                    <input type="hidden" id="txt-update-from-date-temp" />
                                    <input type="hidden" id="txt-update-to-date-temp" />

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold">Trạng thái<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-update-status" name="UpdateStatusFile">
                                                <option value="1">Có hiệu lực</option>
                                                <option value="0">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="txt-update-image-slider-id" />
            <input type="hidden" id="txt-update-image-slider-pkey" />

            <div class="modal-footer">
                <button type="button" id="btn-save-update-image-slider" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-block-image-slider" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-image-slider-block">Khóa: Images Slider</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-images-slider-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên chương trình <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <textarea rows="3" class="form-control" id="search-description" name="SearchDescription" placeholder="Nhập tên chương trình cần khóa"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <button type="button" id="btn-search-description" class="btn btn-success" style="color:#fff;margin-top:27px;"><i class="fa fa-search" style="color:#fff"></i>Tìm</button>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Kết quả:</label>
                                        <div class="form-group">
                                            <textarea rows="3" id="txt-description-kq" name="TxtDescription" class="form-control" disabled></textarea>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-status-block" name="StatusBlock">
                                                <option value="0" selected>Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-block-image-slider" class="btn btn-bg-primary" style="color:#fff" disabled><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal" id="btn-close-modal-block"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var table = "";

        function getCreateFromDate() {
            //debugger
            var result = "";
            var fromDate = $('#txt-create-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "-" + fromDate.split('/')[1] + "-" + fromDate.split('/')[0];
                //result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getCreateToDate() {
            //debugger
            var result = "";
            var toDate = $('#txt-create-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "-" + toDate.split('/')[1] + "-" + toDate.split('/')[0];
