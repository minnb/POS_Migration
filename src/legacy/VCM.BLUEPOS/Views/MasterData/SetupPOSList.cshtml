@section Scripts
{
    <script type="text/javascript">

        var table = "";

        function LoadComboxStoreByChanel() {
                var chanelNo = $('#sel-chanel-no').val();
                loading.showloading();
                var html = '<select class="form-control select2" style="width: 100%;" id="sel-store-no" name="StoreNo">';

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxStoreByChanel", "Common")',
                    data: {
                        ChanelNo: chanelNo
                    },
                    dataType: "json",
                    success: function (data) {
                        html += "<option value=\"\">Tất cả</option>";
                        if (data.length > 0)
                        {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "'>" + name.SiteNo + " - " + name.SiteName + " </option>"
                           });
                        }
                        html += '</select>';
                        $('#sel-store-no').html(html);
                        loading.hideloading();
                    },
                    error: function ()
                    {
                        toastr.error('Lỗi hệ thống');
                    }
                });
        };

        function LoadComboxStoreByChanelForCreate() {
                loading.showloading();
                var chanelNo = $('#modal-create-chanel-no').val();
                var html = '<select class="form-control select2" style="width: 100%;" id="modal-create-store-no" name="CreateStoreNo">';

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxStoreByChanel", "Common")',
                    data: {ChanelNo: chanelNo},
                    dataType: "json",
                    success: function (data) {
                        html += "<option value=\"\">--- Chọn ---</option>";
                        if (data.length > 0)
                        {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "'>" + name.SiteNo + " - " + name.SiteName + " </option>"
                           });
                        }
                        html += '</select>';
                        $('#modal-create-store-no').html(html);
                        loading.hideloading();
                    },
                    error: function ()
                    {
                        toastr.error('Lỗi hệ thống');
                    }
                });

        };

        function LoadComboxStoreByChanelForUpdate() {
            loading.showloading();
            var chanelNo = $('#modal-update-chanel-no').val();
            var storeNo = $('#modal-update-store-no-temp').val();

            $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxSiteByChanelAndStore", "Common")',
                    data: {
                        ChanelNo: chanelNo,
                        StoreNo: storeNo
                    },
                    dataType: "json",
                    success: function (data) {
                        var html = "";
                        if (data.length > 0)
                        {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "'>" + name.SiteNo + " - " + name.SiteName + " </option>"
                           });
                        }
                        $('#modal-update-store-no').html(html);
                        loading.hideloading();
                    },
                    error: function ()
                    {
                        toastr.error('Lỗi hệ thống');
                    }
                });
        };

        function CreatePOSTerminal() {
            //debugger
            var salesChanelType = $("#modal-create-sales-chanel-type").val();
            var channelNo = $('#modal-create-chanel-no').val();
            var permisionType = $('#modal-create-default-sales-type').val();
            var ipAddress = $('#modal-create-ip-address').val();
            var posID = $('#modal-create-pos-id').val();
            var storeNo = $('#modal-create-store-no').val();
            var text = $('#modal-create-customerDisplayText1').val();
            /*
            if (salesChanelType == null || salesChanelType == "") {
                toastr.error("Chọn loại máy POS bán hàng");
                return;
            }
            if (channelNo == null || channelNo == "") {
                toastr.error("Chọn kênh bán hàng");
                return;
            }
            */
            if (storeNo == null || storeNo == "") {
                toastr.error("Chọn cửa hàng");
                return;
            }

            if (posID == null || posID == "") {
                toastr.error("Nhập mã máy POS bán hàng");
                return;
            }

            var checkStore = posID.substring(0, 4); // lấy mã storeno (4 ky tu)
            if (checkStore != storeNo) {
                toastr.error("Mã máy POS " + posID + " này không phải của cửa hàng : "+ storeNo + ". Vui lòng kiểm tra lại");
                return;
            }

            if (salesChanelType == "POS" && (ipAddress == null || ipAddress == "")) {
                toastr.error("Nhập địa chỉ IP");
                return;
            }

            if (permisionType == null || permisionType == "") {
                toastr.error("Chọn quyền...");
                return;
            }

