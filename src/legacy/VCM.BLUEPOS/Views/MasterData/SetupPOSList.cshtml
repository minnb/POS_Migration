                url: '@Url.Action("CreatePOSTerminalList", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    SalesChanelType: salesChanelType,
                    DefaultSalesType: permisionType,
                    IPAddress: ipAddress,
                    POSID: posID,
                    StoreNo: storeNo,
                    CustomerDisplayText1: text
                },
