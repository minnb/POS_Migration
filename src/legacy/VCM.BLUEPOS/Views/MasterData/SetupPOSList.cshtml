                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#sel-chanel-no').trigger('change');
                        $('#sel-store-no').trigger('change');
                        $('#sel-pos-type').trigger('change');
                        $('#sel-status-active').trigger('change');
                        $('#txt-ip-address').val('');
                        $('#txt-pos-id').val('');
                        $('#btn-search').trigger('click');
                        $('#modal-create-pos-set-up').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

