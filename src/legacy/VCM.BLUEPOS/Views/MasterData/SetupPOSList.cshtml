        function ImportSetupPOSTerminal() {
            loading.showloading();
            var files = $("#file-excel").get(0).files;
            var formData = new FormData();
            formData.append('ImportFile', files[0]);

            $.ajax({
                url: '/MasterData/ImportExcelPOSTerminal',
                data: formData,
                type: 'POST',
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        table.draw();
                        $('#modal-import-excel-pos-terminal-setup').modal('hide');
                    } else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                }
            });
        }


