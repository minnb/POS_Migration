                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-pos-id" name="POSID" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:400 !important;">Địa chỉ IP <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="modal-create-ip-address" name="IPAddress">
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:400 !important;">Quyền <strong style="color:#ff0000"> (*)</strong></label>
