@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Danh mục ngân hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listProvince = ViewBag.ListProvince as List<OptionModel>;
}

<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        /* margin: 2px 0; */
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
        margin-top: -35px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh mục ngân hàng</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportBankList", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Mã ngân hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-bank-code" name="BankCode">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên ngân hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-bank-name" name="BankName">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="col-4">
                            <button type="button" id="btn-add-new-bank" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
                        </div>
                        <table id="tbl-bank-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th width="90px;">#</th>
                                    <th>STT</th>
                                    <th>Mã ngân hàng</th>
                                    <th>Tên ngân hàng</th>
                                    <th>Ngày tạo</th>
                                    <th>Ngày cập nhật</th>                                   
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-create-bank" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-bank">Thêm mới thông tin Ngân hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-bank-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" id="txt-create-bank-code" name="BankCode" placeholder="Nhập mã ngân hàng" />
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" id="txt-create-bank-name" name="BankName" placeholder="Nhập tên ngân hàng" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-bank" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-update-bank" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-bank">Cập nhật thông tin Ngân hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-bank-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-update-bank-code" name="UpdateBankCode" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên Ngân hàng</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-update-bank-name" name="UpdateBankName">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="btn-save-update-bank" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save" style="color:#fff"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function CreateBankList() {
            //debugger
            var _bankCode = $('#txt-create-bank-code').val();
            var _bankName = $('#txt-create-bank-name').val();          
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateBankList", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    BankCode: _bankCode,
                    BankName: _bankName
                },
                success: function (data) {
                    //debugger
                    $('#txt-bank-code').val(data.Item1);
                    $('#txt-bank-name').val(data.Item2);
                    $('#btn-search').trigger('click');
                    loading.hideloading();
                    $('#txt-bank-code').val('');
                    $('#txt-bank-name').val('');
                    if (data.Status == 1) 
                    {
                         toastr.success(data.Message);
                         $('#modal-create-bank').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                         toastr.warning(data.Message);
                    }
                    else
                    {
                         toastr.error(data.Message);
                         $('#btn-save-create-bank').attr('disabled', false);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


        //
        function UpdateBankList() {
            //debugger
            var _bankCode = $('#txt-update-bank-code').val();
            var _bankName = $('#txt-update-bank-name').val();            
            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateBankList", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    BankCode: _bankCode,
                    BankName: _bankName
                },
                success: function (data) {
                    $('#txt-bank-code').val(data.Item1);
                    $('#txt-bank-name').val(data.Item2);
                    $('#btn-search').trigger('click');
                    loading.hideloading();

                    $('#txt-bank-code').val(data.Item1);
                    $('#txt-bank-name').val(data.Item2);

                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#modal-update-bank').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                        toastr.warning(data.Message);
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function ClearText() {
            $('#txt-create-bank-code').val('');
            $('#txt-create-bank-name').val('');
            $('#btn-save-create-bank').attr('disabled', false);
        }

    $(document).ready(function () {
        $('.select2').select2(); 
        $('#btn-add-new-bank').on('click', function () {
            ClearText();
            $('#modal-create-bank').modal({
                "backdrop": "static"
            });
        })

        $('#btn-save-create-bank').on("click", function ()
        {
             CreateBankList();
        })

        $('#btn-save-update-bank').on("click", function ()
        {
             UpdateBankList();
        })

        table = $('#tbl-bank-list').DataTable({
                destroy: true,
                //deferLoading: 0,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    $(".btn-editor-bank").click(function () {
                        //debugger
                        var _bankCode = $(this).attr("data-bank-code");
                        $('#txt-update-bank-code').val(_bankCode);
                        var _bankName = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        $('#txt-update-bank-name').val(_bankName);
                        $('#modal-update-bank').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                    });

                    $('.btn-delete-bank').click(function () {
                        var _bankCode = $(this).attr("data-bank-code");
                        $.confirm({
                            backgroundDismiss: true,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: 'Bạn có chắc chắn muốn xóa thông tin này không?',
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        loading.showloading();
                                        $.ajax({
                                            url: '@Url.Action("DeleteBankList", "MasterData")',
                                            type: "POST",
                                            dataType: "json",
                                            data: { BankCode: _bankCode},
                                            success: function (data) {
                                                if (data.Status == 1)
                                                {
                                                    toastr.success(data.Message); 
                                                }
                                                else if (data.Status == 2)
                                                {
                                                    toastr.warning(data.Message);
                                                }
                                                else
                                                {
                                                    toastr.error(data.Message);
                                                }
                                                $('#btn-search').trigger('click');
                                                loading.hideloading();
                                            },
                                            error: function () {
                                                toastr.error("Lỗi hệ thống");
                                                loading.hideloading();
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });

                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: false,                // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetBankList", "MasterData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.BankCode = $('#txt-bank-code').val();
                        d.BankName = $('#txt-bank-name').val();
                    }
                },

                columns: [
                    {
                        render: function (data, type, row) {
                            var _bankCode = row.BankCode;
                            var html ="";
                            html += '<a type="button" class="btn btn-icon btn-light-warning btn-editor-bank"  data-bank-code ="' + _bankCode + '"  data-toggle="tooltip" data-placement="left" title="Cập nhật"  style="color:#ffffff;text-align:center;"><i class="la la-edit"></i><span class="pulse-ring"></span></a>';
                            html += '<a type="button" class="btn btn-icon btn-light-danger btn-delete-bank"  data-bank-code ="' + _bankCode + '"  data-toggle="tooltip" data-placement="left" title="Xóa"  style="margin-left: 3px; color:#ffffff;text-align:center;"><i class="la la-close"></i><span class="pulse-ring"></span></a>';
                            return html;
                        }
                    },

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "BankCode",                
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.BankCode + '</span>';
                        }
                    },

                    {
                        data: "BankName",         
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.BankName + '</span>';
                        }
                    },

                    {
                        data: "CreatedDateStr",          
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.CreatedDateStr + '</span>';
                        }
                    },

                    {
                        data: "UpdatedDateStr",  
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.UpdatedDateStr + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

                });

            $('#tbl-bank-list tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

        $("#btn-search").on("click", function (e) {
            table.draw();
        });

        $("#btn-export-excel").on("click", function (e) {
            $('#frm-export-excel').submit();
        });


    });

    </script>
}






