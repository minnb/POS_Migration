        function UpdatePartnerSetup() {
            //debugger
            var checkValidInput = customValidateForm('modal-update-partner-setup-body');
            var checkValidSelect2 = customValidateFormSelect2('modal-update-partner-setup-body');
            if (checkValidInput == false || checkValidSelect2 == false) {
                return;
            }

            var chanelNo = $('#sel-update-chanel-no').val();
            var storeNo = $('#sel-update-store-no').val();
            var partnerCode = $('#sel-update-partner-code').val();
            var partnerName = "";

            if (partnerCode == "SNG") {
                partnerName = "Scan And Go";
            }
            else if (partnerCode == "WMT") {
                partnerName = "ĐH Online";
            }
            else if (partnerCode == "MBC") {
                partnerName = "MBC";
            }
            else if (partnerCode == "PLG") {
                partnerName = "PHUC LONG";
            }
            else if (partnerCode == "PNP") {
                partnerName = "Phano";
            }

            var hotKey = $('#sel-update-hot-key').val();
            var status = $('#sel-update-status').val();
            var isActive = true;
            if (status == "1") {
                isActive = true;
            }
            else if (status == "0") {
                isActive = false;
            }

            var serviceCode = partnerCode;
            var serviceName = partnerName;

            loading.showloading();

            $.ajax({
               url: '@Url.Action("UpdatePartnerSetup", "StorePOS")',
               type: "POST",
               dataType: "json",
                data: {
                    StoreNo: storeNo,
                    PartnerCode: partnerCode,
                    PartnerName: partnerName,
                    ServiceCode: serviceCode,
                    ServiceName: serviceName,
                    HotKey: hotKey,
                    IsActive: isActive
                },
               success: function (data) {
                   loading.hideloading();
                   if (data.Status == 1)   // case: success
                   {
                       var _status = "0";
                       if (status == "1") {
                           _status = "1";   // true = 1
                       }
                       else if (status == "0") {
                           _status == "0";  // false = 0
                       }

                       $('#sel-store-no').val(storeNo).trigger('change');
                       $('#sel-partner-code').val(partnerCode).trigger('change');
                       $('#sel-status').val(_status).trigger('change');

                       $('#btn-search').trigger('click');
                       toastr.success(data.Message);
                       $('#modal-update-partner-setup').modal('hide');
                   }
                   else if (data.Status == 2)
                   {
                        toastr.warning(data.Message);
                   }
                   else
                   {
                        toastr.error(data.Message);
                   }
               },
               error: function (data) {
                   loading.hideloading();
                   toastr.error('Lỗi hệ thống');
               }
           });
        }

