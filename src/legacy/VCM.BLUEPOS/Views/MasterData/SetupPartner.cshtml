@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Helpers;

@{
    ViewBag.Title = "Khai báo thông tin đối tác";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<StoreModel>;
}

<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
        margin-top: -35px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo thông tin đối tác</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MasterData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">ST/CH</label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count() > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNo" data-array="@listStore.FirstOrDefault().ValueJson">@listStore.FirstOrDefault().StoreNo - @listStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.StoreName) ? item.StoreNo : item.StoreName;
                                                        <option value="@item.StoreNo" data-array="@item.ValueJson">@item.StoreNo - @storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label>Partner</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-partner-code" name="PartnerCode">
                                            <option value="">Tất cả</option>
                                            <option value="SNG">Scan And Go</option>
                                            <option value="WMT">ĐH Online</option>
                                            <option value="MBC">MBC</option>
                                            <option value="PLG">Phúc Long</option>
                                            <option value="PNP">Phano</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label>Trạng thái hoạt động</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Đang hoạt động</option>
                                            <option value="0">Ngưng hoạt động</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="col-4">
                            <button type="button" id="btn-add-new-bank-card-type" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
                        </div>

                        <table class="table table-bordered table-hover text-nowrap" id="tbl-partner-setup-list">
                            <thead>
                                <tr class="text-center" style="text-align:center;text-transform:uppercase;">
                                    <th>#</th>
                                    <th>STT</th>
                                    <th>ST/CH</th>
                                    <th>PartnerCode</th>
                                    <th>PartnerName</th>
                                    <th>ServiceCode</th>
                                    <th>ServiceName</th>
                                    <th>Trạng thái hoạt động</th>
                                    <th>HotKey</th>
                                    <th>Ngày tạo</th>
                                    <th>Người tạo</th>
                                    <th>Ngày cập nhật</th>
                                    <th>Người cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-create-partner-setup" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sticky" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-create-partner-setup">Khai báo Partner Setup</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-partner-setup-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">ST/CH</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-store-no" name="StoreNo"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">Partner</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-partner-code" name="PartnerCode">
                                                <option value="" selected disabled>Vui lòng chọn</option>
                                                <option value="SNG">Scan And Go</option>
                                                <option value="WMT">ĐH Online</option>
                                                <option value="MBC">MBC</option>
                                                <option value="PLG">Phúc Long</option>
                                                <option value="PNP">Phano</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">Trạng thái hoạt động</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-status" name="CreateStatus">
                                                <option value="1" selected>Đang hoạt động</option>
                                                <option value="0">Ngưng hoạt động</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">HotKey</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-hot-key" name="HotKey" disabled>
                                                <option value="F2">F2</option> <!-- Scan And Go -->
                                                <option value="F3">F3</option> <!-- ĐH Online -->
                                                <option value="F4">F4</option> <!-- MBC -->
                                                <option value="F5">F5</option> <!-- PLG -->
                                                <option value="F6">F6</option> <!-- PNP -->
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">DynamicLogic</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-is-dynamic-logic" name="IsDynamicLogic" disabled>
                                                <option value="0">False</option> <!-- Scan And Go -->
                                                <option value="1">True</option>  <!-- ĐH Online -->
                                                <option value="1">True</option>  <!-- MBC -->
                                                <option value="1">True</option>  <!-- PLG -->
                                                <option value="1">True</option>  <!-- PNP -->
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 0 !important;">Order</label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-order" name="Order" disabled>
                                                <option value="1">1</option>     <!-- Scan And Go -->
                                                <option value="2">2</option>     <!-- ĐH Online -->
                                                <option value="3">3</option>     <!-- MBC -->
                                                <option value="4">4</option>     <!-- PLG -->
                                                <option value="5">5</option>     <!-- PNP -->
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-partner-setup" class="btn btn-bg-primary" style="color:#fff"><i class="fa fa-save"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

