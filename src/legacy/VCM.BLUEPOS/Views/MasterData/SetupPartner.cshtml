@section Scripts
{
    <script>
        var table;
        function LoadComboxStoreByChanelAndSite(chanelNo, storeNo) {
            //debugger
            var html = '<select class="form-control required" style="width: 100%;" id="sel-store-no" name="StoreNo">';
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxStoreByChanel_V2", "StorePOS")',
                    data: {
                        ChanelNo: chanelNo,
                        StoreNo: storeNo
                    },
                    dataType: "json",
                    success: function (data) {
                        if (data.length > 0) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + " </option>"
                            });
                        }
                        html += '</select>';
                        $('#sel-store-no').html(html);
                    },
                    error: function () {
                        toastr.error('Lỗi hệ thống');
                    }
                });

        };

        //
        function LoadComboxStoreByChanelForCreate() {
            var chanelNo = $('#sel-create-chanel-no').val();
            var html = '<select class="form-control required" style="width: 100%;" id="sel-create-store-no" name="StoreNo">';
            $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxStoreByChanel", "StorePOS")',
                    data: { ChanelNo: chanelNo },
                    dataType: "json",
                    success: function (data) {
                    if (data.length > 0)
                    {
                        data.forEach((name, i) => {
                            html += "<option value='" + name.StoreNo + "'>" + name.StoreNo + " - " + name.StoreName + " </option>"
                        });
                     }
                        html += '</select>';
                        $('#sel-create-store-no').html(html);
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }

            });

        };

        function LoadComboxHotKeyByPartnerForCreate() {
            var partnerCode = $('#sel-create-partner-code').val();
            var html = "";
            html += '<select class="form-control required" style="width: 100%;" id="sel-create-hot-key" name="HotKey">';
            if (partnerCode == "SNG") {
                html += '<option value="F2">F2</option>';
            }
            else if (partnerCode == "WMT") {
                html += '<option value="F3">F3</option>';
            }
            else if (partnerCode == "MBC") {
                html += '<option value="F4">F4</option>';
            }
            else if (partnerCode == "PLG") {
                html += '<option value="F5">F5</option>';
            }
            else if (partnerCode == "PNP") {
                html += '<option value="F6">F6</option>';
            }

            html += '</select>';
            $('#sel-create-hot-key').html(html);
        }

        function LoadComboxDynamicLogicByPartnerForCreate() {
            var partnerCode = $('#sel-create-partner-code').val();
            var html = "";
            html += '<select class="form-control required" style="width: 100%;" id="sel-is-dynamic-logic" name="DynamicLogic">';
            if (partnerCode == "SNG") {
                html += '<option value="0">False</option>';
            }
            else if (partnerCode == "WMT") {
                html += '<option value="1">True</option>';
            }
            else if (partnerCode == "MBC") {
                html += '<option value="1">True</option>';
            }
            else if (partnerCode == "PLG") {
                html += '<option value="1">True</option>';
            }
            else if (partnerCode == "PNP") {
                html += '<option value="1">True</option>';
            }
            html += '</select>';
            $('#sel-is-dynamic-logic').html(html);
        }

        function LoadComboxOrderByPartnerForCreate() {
            var partnerCode = $('#sel-create-partner-code').val();
            var html = "";
            html += '<select class="form-control required" style="width: 100%;" id="sel-order" name="Order">';
            if (partnerCode == "SNG") {
                html += '<option value="1">1</option>';
            }
            else if (partnerCode == "WMT") {
                html += '<option value="2">2</option>';
            }
            else if (partnerCode == "MBC") {
                html += '<option value="3">3</option>';
            }
            else if (partnerCode == "PLG") {
                html += '<option value="4">4</option>';
            }
            else if (partnerCode == "PNP") {
                html += '<option value="5">5</option>';
            }
            html += '</select>';
            $('#sel-order').html(html);
        }

        function LoadComboxStoreByChanelForUpdate() {
            //debugger
            var chanelNo = $('#sel-update-chanel-no').val();
            var storeNo = $('#sel-update-store-no-temp').val();
            var html = '<select class="form-control required" style="width: 100%;" id="sel-update-store-no" name="UpdateStoreNo">';
            $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxStoreByChanel_V2", "StorePOS")',
                    data: {
                        ChanelNo: chanelNo,
                        StoreNo: storeNo
                    },
                    dataType: "json",
                    success: function (data) {
                    if (data.length > 0)
                    {
                        data.forEach((name, i) => {
                            html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + " </option>"
                       });
                    }
                    html += '</select>';
                    //debugger
                    $('#sel-update-store-no').html(html);
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });

        };

        //
        function LoadComboxHotKeyByPartnerForUpdate() {
            var partnerCode = $('#sel-update-partner-code').val();
            var html = "";
            html += '<select class="form-control" style="width: 100%;" id="sel-update-hot-key" name="UpdateHotKey" disabled>';
            if (partnerCode == "SNG") {
                html += '<option value="F2">F2</option>';
            }
            else if (partnerCode == "WMT") {
                html += '<option value="F3">F3</option>';
            }
            else if (partnerCode == "MBC") {
                html += '<option value="F4">F4</option>';
            }
            else if (partnerCode == "PLG") {
                html += '<option value="F5">F5</option>';
            }
            else if (partnerCode == "PNP") {
                html += '<option value="F6">F6</option>';
            }
            html += '</select>';
            $('#sel-update-hot-key').html(html);
        }

        function CreatePartnerSetup() {
            //debugger
            var checkValidInput = customValidateForm('modal-create-partner-setup-body');
            var checkValidSelect2 = customValidateFormSelect2('modal-create-partner-setup-body');
            if (checkValidInput == false || checkValidSelect2 == false) {
                    return;
            }

            var chanelNo = $('#sel-create-chanel-no').val();
            $('#sel-chanel-no-temp').val(chanelNo);
            var storeNo = $('#sel-create-store-no').val();
            $('#sel-store-no-temp').val(storeNo);

            var partnerCode = $('#sel-create-partner-code').val();
            var partnerName = "";

            if (partnerCode == "SNG") {
                partnerName = "Scan And Go";
            }
            else if (partnerCode == "WMT") {
                partnerName = "ĐH Online";
            }
            else if (partnerCode == "MBC") {
                partnerName = "MBC";
            }
            else if (partnerCode == "PLG") {
                partnerName = "PHUC LONG";
            }
            else if (partnerCode == "PNP") {
                partnerName = "Phano";
            }

            var hotKey = $('#sel-create-hot-key').val();
            var status = $('#sel-create-status').val();
            var isActive = true;
            if (status == "1") {
                isActive = true;
            }
            else if (status == "0"){
                isActive = false;
            }

            var serviceCode = partnerCode;
            var serviceName = partnerName;

            var isDynamic = $('#sel-is-dynamic-logic').val();
            var _isDynamicLogic = true;
            if (isDynamic == "0") {
                _isDynamicLogic = false;
            }
            else if (isDynamic == "1"){
                _isDynamicLogic = true;
            }
            var order = $('#sel-order').val();

            loading.showloading();
            $.ajax({
                    url: '@Url.Action("CreatePartnerSetup", "StorePOS")',
                    type: "POST",
                    dataType: "json",
                    data: {
                        StoreNo: storeNo,
                        PartnerCode: partnerCode,
                        PartnerName: partnerName,
                        ServiceCode: serviceCode,
                        ServiceName: serviceName,
                        HotKey: hotKey,
                        IsActive: isActive,
                        IsDynamicLogic: _isDynamicLogic,
                        Order: order
                    },
                    success: function (data) {
                        //debugger
                        loading.hideloading();

                        if (data.Status == 1)
                        {
                            var _status = "0";
                            if (data.Item3 == "True") {
                                _status = "1";   // true = 1
                            }
                            else if (data.Item3 == "False") {
                                _status = "0";  // false = 0
                            }

                            $('#sel-chanel-no').val(chanelNo).trigger('change');
                            $('#sel-store-no').val(storeNo).trigger('change');
                            $('#sel-partner-code').val(partnerCode).trigger('change');
                            $('#sel-status').val(_status).trigger('change');

                            $('#btn-search').trigger('click');

                            toastr.success(data.Message);
                            $('#modal-create-partner-setup').modal("hide");
                        }
                        else if (data.Status == 2)
                        {
                            toastr.warning(data.Message);
                        }
                        else
                        {
                            toastr.error(data.Message);
                            $('#btn-save-create-partner-setup').attr('disabled', false);
                        }

                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
