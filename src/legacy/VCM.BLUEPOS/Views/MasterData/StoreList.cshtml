        function LoadComboxStoreList() {
            $('#sel-create-store-no').empty();
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetComboxStoreList", "Common")',
                dataType: "json",
                success: function (data) {
                    var html = "<option value=\"\" selected>Tất cả</option>";
                    if (data.length > 0) {
                        data.forEach((name, i) => {
                            html += "<option value='" + name.Value + "'>" + name.Value +"-"+ name.Text + "</option>"
                        });
                    }
                    $('#sel-create-store-no').html(html);
                },
                error: function ()
                {
                }
            });
        }

