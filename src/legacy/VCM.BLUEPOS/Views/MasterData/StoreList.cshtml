@section Scripts
{
    <script type="text/javascript">

        var table = "";

        function LoadComboxStoreByChanel() {
            //debugger
            var chanelNo = $('#sel-chanel-no').val();
            var html = '<select class="form-control select2" style="width: 100%;" id="sel-store-no" name="StoreNo">';
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxStoreByChanel", "Common")',
                    data: {
                        ChanelNo: chanelNo
                    },
                    dataType: "json",
                    success: function (data) {
                        html += "<option value=\"\">Tất cả</option>";
                        if (data.length > 0)
                        {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "'>" + name.SiteNo + " - " + name.SiteName + " </option>"
                           });
                        }
                        html += '</select>';
                        $('#sel-store-no').html(html);
                    },
                    error: function ()
                    {
                        toastr.error('Lỗi hệ thống');
                    }
                });

        };

        function CreateStoreList() {
            //debugger
            var _storeNo = $('#txt-create-store-no').val();
            var _storeName = $('#txt-create-store-name').val();
            var _address = $('#txt-create-address').val();
            var _chanelNo = $('#sel-create-chanel-no').val();
            var _provinceNo = $('#sel-create-province').val();
            var _taxCode = $('#txt-create-tax-code').val();
            var _openTime = $('#input-open-time-create').val();
            var _closeTime = $('#input-close-time-create').val();
            var _phoneNo = $('#txt-create-phone-number').val();
            var _voucherOnline = $('#sel-create-voucher-online').val();
            var _passwordWifi = $('#txt-create-password-wifi').val();

            if (_storeNo == null || _storeNo == "") {
                toastr.error("Nhập mã ST/CH");
                return;
            }

            if (_chanelNo == null || _chanelNo == "") {
                toastr.error("Chọn kênh bán hàng");
                return;
            }

            if (_storeName == null || _storeName == "") {
                toastr.error("Nhập tên cửa hàng");
                return;
            }

            if (_provinceNo == null || _provinceNo == "") {
                toastr.error("Chọn tỉnh/thành phố");
                return;
            }

            if (_openTime == null || _openTime == "") {
                toastr.error("Chọn giờ mở cửa của cửa hàng");
                return;
            }

            if (_closeTime == null || _closeTime == "") {
                toastr.error("Chọn giờ đóng cửa của cửa hàng");
                return;
            }

            if (_address == null || _address == "") {
                toastr.error("Nhập thông tin địa chỉ");
                return;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateStoreList", "MasterData")',
                type: "POST",
                dataType: "json",
                data: {
                    StoreNo: _storeNo,
                    StoreName: _storeName,
                    Address: _address,
                    TaxCode: _taxCode,
                    PhoneNo: _phoneNo,
                    StyleProfile: _chanelNo,
                    ProvinceNo: _provinceNo,
                    VoucherOnline: _voucherOnline,
                    OpenTime: _openTime,
                    CloseTime: _closeTime,
                    PassWordWifi: _passwordWifi
                },
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#modal-create-store').modal("hide");
                        $('#sel-province-no').val(data.Item1);
                        $('#sel-chanel-no').val(data.Item2);
                        $('#sel-store-no').val(data.Item3);
                        $('#txt-tax-code').val(data.Item4);
                        $('#btn-search').trigger('click');
                        $('#sel-province-no').val('');
                        $('#sel-chanel-no').val('');
                        $('#sel-store-no').val('');
                        $('#txt-tax-code').val('');
                    }
                    else if (data.Status == 2)
                    {
                        toastr.error(data.Message);
                        $('#btn-save-create-store').attr('disabled', false);
                    }
                    else
                    {
                        toastr.error(data.Message);
                        $('#btn-save-create-store').attr('disabled', false);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function UpdateStoreList() {
