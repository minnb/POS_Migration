            if (_provinceNo == null || _provinceNo == "") {
                toastr.error("Chọn tỉnh / thành phố");
                return;
            }

            if (_voucherOnline == null || _voucherOnline == "") {
                toastr.error("Chọn phát hành voucher online ?");
                return;
            }

            if (_openTime == null || _openTime == "") {
                toastr.error("Chọn giờ mở cửa CH");
                return;
            }

            if (_closeTime == null || _closeTime == "") {
                toastr.error("Chọn giờ đóng cửa CH");
                return;
            }

            if (_address == null || _address == "") {
                toastr.error("Nhập thông tin địa chỉ");
                return;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("UpdateStoreList", "MasterData")',
                type: "POST",
