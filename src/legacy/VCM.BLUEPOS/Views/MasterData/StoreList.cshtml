@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Danh mục cửa hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listProvince = ViewBag.ListProvince as List<OptionModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh mục cửa hàng</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div class="col-12">
                <button type="button" id="btn-add-new-store" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
            </div>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelStoreList", "MasterData", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tỉnh / Thành phố<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-province-no" name="ProvinceNo">
                                            @if (listProvince != null && listProvince.Count > 0)
                                            {
                                                if (listProvince.Count == 1)
                                                {
                                                    <option value="@listProvince.FirstOrDefault().Value">@listProvince.FirstOrDefault().Text</option>
                                                }
                                                else
                                                {
                                                    <option value="">Tất cả</option>
                                                    foreach (var item in listProvince)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Kênh bán hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-chanel-no" name="ChanelNo">
                                            <option value="" selected>Tất cả</option>
                                            <option value="KS">Kiosk</option>
                                            <option value="FS">FlagShip</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                @*<div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Mã số thuế</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-tax-code" name="TaxCode" placeholder="Nhập mã số thuế" />
                                    </div>
                                </div>*@

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">

                        @*<div class="col-4">
                            <button type="button" id="btn-add-new-store" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
                        </div>*@

                        <table id="tbl-store-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>#</th>
                                    <th>STT</th>
                                    <th>Mã Cửa hàng</th>
                                    <th>Tên Cửa hàng</th>
                                    <th>Địa chỉ</th>
                                    <th>Kênh bán hàng</th>
                                    <th>Giờ mở cửa</th>
                                    <th>Giờ đóng cửa</th>
                                    <th>Số điện thoại</th>
                                    <th>Password Wifi</th>
                                    <th>Mã tỉnh thành</th>
                                    <th>Tên tỉnh thành</th>
                                    <th>Phát hánh voucher online</th>
                                    <th>Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-create-store" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-store">Thêm mới thông tin siêu thị / cửa hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-create-store-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-8 col-md-8 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">ST / CH<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-create-store-no" name="StoreNo" placeholder="Nhập mã ST/CH..." />
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-6">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <button type="button" id="btn-check-store-no" class="btn btn-bg-warning" style="margin-top: 25px; text-align:center;color:#fff;"><i class="fa fa-search" style="color:#fff;"></i><span>Kiểm tra</span></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Kênh bán hàng<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-chanel-no" name="CreateChanelNo" disabled>
                                                <option value="-1" disabled selected>----- Chọn -----</option>
                                                <option value="KS">Kiosk</option>
                                                <option value="FS">FlagShip</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Tên ST / CH<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-create-store-name" name="CreateStoreName" placeholder="Nhập tên ST/CH" disabled />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Tỉnh / Thành phố<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" style="width:100%;" id="sel-create-province" name="CreateProvince" disabled>
                                                @if (listProvince != null && listProvince.Count > 0)
                                                {
                                                    if (listProvince.Count == 1)
                                                    {
                                                        <option value="@listProvince.FirstOrDefault().Value">@listProvince.FirstOrDefault().Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="-1" selected disabled>----- Chọn -----</option>
                                                        foreach (var item in listProvince)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Phát hành voucher online<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-create-voucher-online" name="CreateVoucherOnline" disabled>
                                                <option value="1" selected>Có</option>
                                                <option value="0">Không</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Mã số thuế</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-create-tax-code" name="CreateTaxCode" placeholder="Nhập mã số thuế" disabled>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Điện thoại</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-create-phone-number" name="CreatePhoneNumber" placeholder="Nhập số điện thoại" disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Password Wifi</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-create-password-wifi" name="PasswordWifi" placeholder="Nhập password wifi..." disabled>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Giờ mở cửa<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <div class="input-group input-group-solid date" id="txt-create-open-time" data-target-input="nearest">
                                                <input type="text" class="form-control form-control-solid datetimepicker-input" id="input-open-time-create" placeholder="Chọn giờ mở cửa..." data-target="#txt-create-open-time" />
                                                <div class="input-group-append" data-target="#txt-create-open-time" data-toggle="datetimepicker">
                                                    <span class="input-group-text">
                                                        <i class="ki ki-clock"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Giờ đóng cửa<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <div class="input-group input-group-solid date" id="txt-create-close-time" data-target-input="nearest">
                                                <input type="text" class="form-control form-control-solid datetimepicker-input" id="input-close-time-create" placeholder="Chọn giờ đóng cửa..." data-target="#txt-create-close-time" />
                                                <div class="input-group-append" data-target="#txt-create-close-time" data-toggle="datetimepicker">
                                                    <span class="input-group-text">
                                                        <i class="ki ki-clock"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Địa chỉ<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-create-address" name="CreateAddress" placeholder="Nhập thông tin địa chỉ" disabled>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-store" class="btn btn-bg-primary" style="color:#fff;" disabled><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

