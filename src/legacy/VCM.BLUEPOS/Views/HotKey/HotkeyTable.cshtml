@using VCM.BLUEPOS.Model.HotKey;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Bảng chọn chạm 1";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listProvince = (List<VCM.BLUEPOS.Model.Common.ProvinceModel>)ViewBag.ListProvince;
}

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">

        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Tỉnh thành<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="slProvince">
                                        @if (listProvince.Count > 0)
                                        {
                                            foreach (var item in listProvince)
                                            {
                                                <option value="@item.ProvinceCode">@item.ProvinceName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã Barcode <strong style="color:#ff0000"> (*)</strong></label>
                                <div class="form-group">
                                    <input type="text" id="txtBarcode" placeholder="Nhập mã barcode" class="form-control" onchange="GetBarCode()" />
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <button type="button" class="btn btn-primary" id="btnSave" onclick="GetBarCode()" style="color: #ffffff;cursor:pointer;margin-top: 27px;"> <i class="fa fa-save"></i>&nbsp;&nbsp;Thêm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered table-hover" id="tblData">
                            <thead>
                                <tr style="text-center">
                                    <th>Tỉnh thành</th>
                                    <th>Barcode</th>
                                    <th>ItemNo</th>
                                    <th>Description</th>
                                    <th>Seq</th>
                                    <th>Trạng thái</th>
                                    <th>Counter</th>
                                    <th>PKey</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {
    <script type="text/javascript">
        $('.select2').select2();

        var table = "";
        $(document).ready(function () {
           LoadItem();

        });

        $("#btnSearch").on("click", function (e) {
            table.draw();
        });

        $("#slProvince").on("change", function (e) {
            LoadItem();
        });

        function LoadItem() {
            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: true,           // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("HotKeyLoad", "HotKey")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreGroup = $("#slProvince").val();
                    }
                },

                columns: [
                    {
                        data: "ProvinceName",
                        className: 'text-center'
                    },

                    {
                        data: "Barcode",
                        render: function (data, type, row) {
                            var _barCode = row.Barcode;
                            return '<span style="display: block;text-align:center;font-weight:700;">' + _barCode + '</span>';
                        }

                    },

                    {
                        data: "ItemNo",
                        render: function (data, type, row) {
                            var _item = row.ItemNo;
                            return '<span style="display: block;text-align:center;">' + _item + '</span>';
                        }
                    },

                    {
                        data: "Description"
                    },

                    {
                        data: "Seq",
                        className: 'text-center'
                    },

                    {
                        data: "Status",
                        render: function (data, type, row) {
                            var _status = row.Status;
                            if (_status == true) {
                                return '<span style="display: block;text-align:center;color:green;font-weight:700;">' + "Thành công" + '</span>';
                            }
                            else
                            {
                                return '<span style="display: block;text-align:center;color:red">' + "Thất bại" + '</span>';
                            }
                        }
                    },

                    {
                        data: "Counter",
                        className: 'text-center'
                    },

                    {
                        data: "Pkey",
                        render: function (data, type, row) {
                            var _pkey = row.Pkey;
                            return '<span style="display: block;text-align:center;">' + _pkey + '</span>';
                        }
                    },

                    {
                        render: function (data, type, row) {
                            var html = "<a onclick=\"DeleteBarcode('" + row.StoreGroup + "','"+row.Barcode+"')\" class=\"btn btn-danger btn-sm\" titel=\"Xóa\"><i class=\"fa fa-trash-alt\" style =\"color:#FFF\"></i></a>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            });
        }

        function DeleteBarcode(StoreGroup, Barcode) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn xóa mã barcode này không?',
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            loading.showloading();
                            var fromData = new FormData();
                            fromData.append('StoreGroup', StoreGroup);
                            fromData.append('Barcode', Barcode);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("DeleteHotKeyBarcode", "HotKey")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    if (data != null) {
                                        if (data.Item1 == 1) {
                                            table.draw();
                                            toastr.success(data.Item2);
                                        }
                                        else {
                                            toastr.error(data.Item2);
                                        }
                                    }
                                    loading.hideloading();
                                },
                                error: function () {
                                    loading.hideloading();
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });
        }

        function GetBarCode() {
            var province = $("#slProvince").val();
            var barcode = $("#txtBarcode").val();

            if (province == "" || province.length == 0) {
                toastr.error("Vui lòng chọn tỉnh thành");
                return;
            }

            if (barcode == "" || barcode.length == 0) {
                toastr.error("Vui lòng nhập barcode");
                return;
            }

            var fromData = new FormData();
            fromData.append('ProvinceCode', province);
            fromData.append('BarCode', barcode);

            $.ajax({
                type: "POST",
                url: '@Url.Action("InsertBarCode", "HotKey")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger;
                    if (data != null) {
                        if (data.Item1 == 1) {
                            LoadItem();
                            $("#txtBarcode").val('');    // Clear Barcode khi them thanh cong
                            toastr.success(data.Item2);
                        }
                        else {
                            toastr.error(data.Item2);
                        }
                    }
                    else {}
                    loading.hideloading();
                },
                error: function () {}
            });
        }

    </script>
}



