@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Scan đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = Model as List<StoreModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Hoạt động cửa hàng</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Scan đơn hàng</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnScan"><i class="la la-plus-circle"></i> Scan đơn hàng</button>
        </div>
    </div>
</div>
<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slStore" name="SiteNo">
                                        @if (listSite != null && listSite.Count > 0)
                                        {
                                            foreach (var item in listSite)
                                            {
                                                var ht = $"{ item.StoreNo} : {item.StoreName}";
                                                <option value="@item.StoreNo" data-server="@item.ServerIP">@ht</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Ngày scan</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchNgayScan" name="NgayKinhDoanh" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Đơn hàng</label>
                                <div class="form-group">
                                    <input type="text" id="txtSearchOrderNo" placeholder="" class="form-control">
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="margin-top:25px">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary" id="btnSearch"><i class="fa fa-search"></i> Tìm </button>
                                </div>
                            </div>
                        </div>
                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <table class="table table-bordered table-striped" id="tblData">
                                    <thead>
                                        <tr style="text-align:center">
                                            <th>STT</th>
                                            <th>CH/ST</th>
                                            <th>Đơn hàng</th>
                                            <th>Ngày kinh doanh</th>
                                            <th>Mã SP tặng</th>
                                            <th>Tổng tiền ĐH</th>
                                            <th>Thời gian bill</th>
                                            <th>Ghi chú</th>
                                            <th>Thời gian scan</th>
                                            <th>#</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalViewScan" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titleScanPopup">SCAN ĐƠN HÀNG</h5>
                <button type="button" id="closemodal" class="close" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupScanOrder" style="min-height:100px">
            </div>
            @*<div class="modal-footer">
                    <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

                </div>*@
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        var table = "";
        $(document).ready(function () {

            $('#searchNgayScan').val(moment().format('DD/MM/YYYY'));
            $('#searchNgayScan').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $("#btnSearch").on("click", function (e) {
                table.draw();
            });

            $('#closemodal').click(function () {
                $('#modalViewScan').modal('hide');
                table.draw();
            });

            $("#btnScan").on("click", function (e) {
                loading.showloading();
                var serverStore = $("#slStore").select2().find(":selected").data("server");
                var storeNo = $("#slStore").val();
                var bussinessDate = $("#searchBussinessDate").val();
                $.ajax({
                    type: "GET",
                    url: "/Common/_ScanOrderView?serverStore=" + serverStore + "&storeNo=" + storeNo + "",
                    dataType: 'html',
                    contentType: true,
                    processData: true,
                    success: function (result) {
                        $("#titleScanPopup").html("SCAN ĐƠN HÀNG, CH/ST :<strong style='color:#ebae36'>" + storeNo + "</strong>, NGÀY SCAN : <strong style='color:#ebae36'>" + moment().format('DD/MM/YYYY') + "</strong>");
                        $("#divPopupScanOrder").html(result);

                        $('#modalViewScan').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });
            });

            table = $('#tblData').DataTable({

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: true, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                deferLoading: 0,
                info: true,
                ajax: {
                    url: '@Url.Action("ScanOrderLoad", "Common")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {

                        d.ServerStore = $("#slStore").select2().find(":selected").data("server");
                        d.StoreNo = $("#slStore").val();
                        d.OrderNo = $("#txtSearchOrderNo").val();
                        d.NgayScan = $("#searchNgayScan").val();

                    }
                },
                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },
                    {
                        data: "OrderNo"
                    },
                    {
                        data: "OrderDate",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsCentral == 1) {
                                if (row.OrderDate != null) {
                                    return moment(row.OrderDate).format("DD/MM/YYYY");
                                }
                                else
                                    return "";
                            }
                            return html;
                        },
                        className: 'text-center'
                    },

                    {
                        data: "ItemNo"
                    },

                    {
                        data: "TotalAmount",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsCentral == 1) {
                                if (row.TotalAmount > 0) {
                                    var TotalAmount = row.TotalAmount;
                                    html = '<span style="">' + parseFloat(TotalAmount).toLocaleString('en') + '</span>';
                                }
                            }
                            return html;
                        },
                        className: 'text-right'
                    },
                    {
                        data: "OrderTime",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsCentral == 1) {
                                if (row.OrderTime != null) {
                                    return moment(row.OrderTime).format("DD/MM/YYYY HH:mm");
                                }
                                else
                                    return "";
                            }
                            return html;
                        },
                        className: 'text-center'
                    },
                    {
                        data: "IsCentral",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsCentral == 1) {
                                html = "<span style='color:Green'>Tồn tại</span>"
                            }
                            else {
                                html = "<span style='color:red'>Không tồn tại</span>"
                            }
                            return html;
                        },
                    },

                    {
                        data: "ScanDate",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ScanDate != null) {
                                return moment(row.ScanDate).format("DD/MM/YYYY HH:mm");
                            }
                            else {
                                return "";
                            }         
                            return html;
                        },
                        className: 'text-center'
                    },
                    {
                        data: "OrderNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            html = "<a onclick=\"DeleteScanOrder(" + row.ID +",'" + row.StoreNo + "','" + row.OrderNo + "')\" type=\"button\" class=\"btn btn-icon btn-light-danger\" data-toggle=\"tooltip\" title=\"xóa đơn hàng scan\"   style=\"text-align:center;color:#d40f36;\"><i class=\"la la-close\"></i></a>";
                            return html;
                        }
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

                });

        });

        function DeleteScanOrder(id,storeNo, orderNo) {
            $.confirm({
                backgroundDismiss: false,
                //escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn xóa đơn hàng <strong>' + orderNo + '</strong> này ???',
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            loading.showloading();
                            var fromData = new FormData();
                            fromData.append('StoreNo', storeNo);
                            fromData.append('OrderNo', orderNo);
                            fromData.append('ID', id);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("DeleteScanOrder", "Common")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    debugger
                                    if (data != null) {
                                        if (data.Item1 == 1) {
                                            table.draw();
                                            toastr.success(data.Item2);
                                        }
                                        else {
                                            toastr.error(data.Item2);
                                        }
                                    }
                                    loading.hideloading();
                                },
                                error: function () {
                                    loading.hideloading();
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });
        }
    </script>
}

