

@using VCM.BLUEPOS.Model.Common
@{
    var model = Model as ScanOrderViewModel;
    //var modelListStore = model.ListStore;
    var ngayKD = model.BussinessDate;
    var storeNo = model.StoreNo;
    var serverStore = model.ServerStore;

}
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1" style="margin:auto;">
    <div class="row">
        
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
            <strong>Scan đơn hàng</strong>
            <div class="input-group">
                <input type="text" id="txtScanOrderNo" placeholder="Scan đơn hàng" class="form-control">
            </div>
        </div>
    </div>
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="margin-top:20px; display:none">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff">Đơn hàng</strong>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff" id="resultOrderNo"></strong>
        </div>
    </div>
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff">Ngày kinh doanh</strong>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff" id="resultOrderDate"></strong>
        </div>
    </div>

</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">

        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff">Tổng tiền</strong>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff" id="resultOrderAmount"></strong>
        </div>
    </div>
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">

        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff">Loại đơn hàng</strong>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff" id="resultOrderType"></strong>
        </div>
    </div>
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">

        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <label style="color:#0026ff">Sản phẩm tặng</label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <label style="color:#0026ff" id="resultItemNo"></label>
        </div>
    </div>
</div>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">

        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong style="color:#0026ff">Ghi chú</strong>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
            <strong id="resultNote"></strong>
        </div>
    </div>
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 displayResult" style="display:none">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
            <strong style="color:red" id="resultExists"></strong>
        </div>
    </div>
</div>

<div style="display:none">
    <input type="text" value="@storeNo" id="hdScanStore" />
    <input type="text" value="@ngayKD" id="hdScanNgayKD" />
    <input type="text" value="@serverStore" id="hdServerStore" />
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $("#txtScanOrderNo").focus();
        $('.select2').select2();


        $('#modalViewScan').on('shown.bs.modal', function () {
            $("#txtScanOrderNo").focus();
        })

        $('#txtScanOrderNo').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $("#resultOrderNo").html("");
                $("#resultOrderType").html("");
                $("#resultNote").html("");
                $("#resultOrderDate").html("");
                $("#resultOrderAmount").html("");
                $("#resultItemNo").html("");
                $("#resultExists").html("");


              

                var storeNo = $("#hdScanStore").val();
                var scanText = $(this).val();
                var orderNo = scanText;

                var serverStore = $("#hdServerStore").val();
                if (orderNo == "") {
                    toastr.error("Vui lòng scan đơn hàng", "Thông báo");
                    return
                }
                
                var itemNo = "";
                if (scanText.indexOf('|') > 0) {
                    orderNo = scanText.split('|')[0];
                    itemNo = scanText.split('|')[1];
                }

                if (orderNo.length < 15) {
                    toastr.error("Vui lòng scan lại đơn hàng", "Thông báo");
                    return
                }
                $(".displayResult").css("display", "block");

                loading.showloading();
                var fromData = new FormData();
                fromData.append('StoreNo', storeNo);
                fromData.append('Barcode', scanText);
                fromData.append('OrderNo', orderNo);
                fromData.append('ItemNo', itemNo);
                fromData.append('ServerStore', serverStore);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("InsertScanOrder", "Common")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        debugger
                        if (data != null) {
                            if (data.Item1 == 1) {
                                $("#txtScanOrderNo").val('');
                                $("#txtScanOrderNo").focus();

                                var dataRequest = data.Item3;
                                $("#resultOrderNo").html(dataRequest.OrderNo);
                                $("#resultOrderType").html(dataRequest.IsCentral == 0 ? "" : (dataRequest.SalesIsReturn == 0 ? "<strong style='color:Blue'>Đơn hàng bán</strong>" : "<strong style='color:red'>Đơn hàng trả</strong>"));
                                $("#resultNote").html(dataRequest.IsExists == 1 ? "" : (dataRequest.IsCentral == 1 ? "<strong style='color:Blue'>Tồn tại</strong>" : "<strong style='color:red'>Không tồn tại</strong>"));
                                $("#resultItemNo").html(dataRequest.IsCentral == 1 ? "<strong style='color:Blue'>" + dataRequest.ItemNo + "</strong>" : "");
                                $("#resultOrderDate").html(dataRequest.IsCentral == 0 ? "" : (moment(dataRequest.OrderDate).format("DD/MM/YYYY")));
                                $("#resultOrderAmount").html(dataRequest.IsCentral == 0 ? "" : parseFloat(dataRequest.TotalAmount).toLocaleString('en'));
                                $("#resultExists").html(dataRequest.IsExists == 0 ? "" : "Đã scan đơn hàng này " + dataRequest.OrderNo + " lúc " + moment(dataRequest.ScanDate).format("DD/MM/YYYY HH:mm") + "");

                            }
                            else {
                                $(".displayResult").css("display", "none");
                                toastr.error(data.Item2);
                            }
                        }
                        loading.hideloading();
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });

            }
        });

    })

</script>
