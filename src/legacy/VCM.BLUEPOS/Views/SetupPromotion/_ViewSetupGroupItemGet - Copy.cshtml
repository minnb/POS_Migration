@using VCM.BLUEPOS.Model.SetupPromotion;
@{

    var model = Model as ViewSetupGroupItemBuyModel;
    var offerNo = model.OfferNo;
    var lineNo = model.LineNo;
    var offerType = model.OfferType;
    var condition = model.Condition;
    var tabOffer = model.TabOffer;
    var isTotalBill = model.IsTotalBill;
    var isSetupGet = model.IsSetupGet;
    var groupCode = model.GroupCode;
    var totalBill = model.TotalBill;

    var scaleType = model.ScaleType;
    var quantity = model.Quantity;
    var listItem = model.ListItem;

}


<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="titleModalMenu">SETUP GROUP ITEM</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <i aria-hidden="true" class="ki ki-close"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">

                    <nav class="w-100">
                        <div class="nav nav-tabs" id="product-tab" role="tablist">
                            <a class="nav-item nav-link active" data-toggle="tab" href="#getItemGroup-setup" role="tab" aria-controls="getItemGroup-setup" aria-selected="false">Cài đặt item group</a>
                            <a class="nav-item nav-link" id="buyListItem" data-toggle="tab" href="#getItemGroup-list" role="tab" aria-controls="getItemGroup-list" aria-selected="true">Danh sách group</a>
                        </div>
                    </nav>
                    <div class="tab-content p-3" id="nav-tabContent" style="width:100%">
                        <div class="tab-pane fade show active" id="getItemGroup-setup" role="tabpanel" aria-labelledby="getItemGroup-setup">
                            <div class="row">
                                <div class="col-sm-12" style="width:100%">
                                    <div class="row">
                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Mã nhóm</label>
                                                <div class="input-group">
                                                    <input type="text" id="txtGetGroupCode" class="form-control" placeholder="Nhập mã nhóm" />

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Tên nhóm</label>
                                                <div class="input-group">
                                                    <input type="text" id="txtGetGroupName" class="form-control" placeholder="Nhập tên nhóm" />
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Sản phẩm</label>
                                                <select id="slItemGet" class="form-control" multiple="multiple">
                                                    @if (listItem != null && listItem.Count() > 0)
                                                    {
                                                        foreach (var item in listItem)
                                                        {
                                                            var display = $"{item.No} : {item.Description}";
                                                            <option value="@item.No">@display</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;"></div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Nhập list item</label>
                                                <textarea class="form-control" rows="12" placeholder="Nhập list item cách nhau dấu ; hoặc dấu , hoặc khoảng trắng (10078166;10000012 10000014,10000246....)" id="txtListGetItem"></textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" style="text-align:right">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                            <div class="input-group text-right">
                                                <button type="button" class="btn btn-primary font-weight-bold" id="btnSaveGetGroup"><i class="fa fa fa-save"></i> Lưu</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="getItemGroup-list" role="tabpanel" aria-labelledby="getItemGroup-list">
                            <div class="row">
                                <div class="col-sm-12" id="loadGroupGetItem" style="width:100%">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

        </div>
    </div>
</div>

<script type="text/javascript">
    var offerNo = '@offerNo';
    var groupCodeOld = '@groupCode';
    var lineNo = '@lineNo';
    var tabOffer = '@tabOffer';
    var isTotalBill = '@isTotalBill';
    var isSetupGet = '@isSetupGet';
    var conditionGet = '@condition';
    var offerType = '@offerType';
    var totalBill = '@totalBill';
     var scaleType = '@scaleType';
    var quantity = '@quantity';

    $(document).ready(function () {
        $('#slItemGet').fSelect({
            placeholder: 'Chọn mã sản phẩm',
            numDisplayed: 1,
            overflowText: '{n} sản phẩm được chọn',
            searchText: 'Tìm kiếm....',
            noResultsText: 'Không tìm thấy sản phẩm',
            showSearch: true,
            optionFormatter: false,
            isSelectAll: true
        });
        LoadGetGroupItem();
        $("#btnSaveGetGroup").on("click", function () {
            SaveGroupGetItem();
        });

        $("#buyListItem").on("click", function () {
            LoadGetGroupItem();
        });

    });

    function LoadGetGroupItem() {
        $.ajax({
            type: "GET",
            url: "/SetupPromotion/_ViewDataGetGroupItem?groupCode=" + groupCodeOld + "&offerNo=" + offerNo + "&offerType=" + offerType + "&conditionGet=" + conditionGet + "&lineNo=" + lineNo + "&tabOffer=" + tabOffer + "&isTotalBill=" + isTotalBill + "&isSetupGet=" + isSetupGet + "&totalBill=" + totalBill + "&scaleType=" + scaleType + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#loadGroupGetItem").html(result);
            },
            error: function (event) {

            }
        });
    }

    function SaveGroupGetItem() {
        debugger
        //var listStore = $('#slStore').val() == "" ? "" : JSON.stringify($('#slStore').val());
        var groupCode = $("#txtGetGroupCode").val();
        var groupName = $("#txtGetGroupName").val();

        var listItem = $("#txtListGetItem").val();

        if (groupCode == "") {
            toastr.error("Vui lòng nhập group code");
            return;
        }
        if (groupName == "") {
            toastr.error("Vui lòng nhập group name");
            return;
        }
        var filter = /^([a-zA-Z\-0-9_]+)$/;
        if (!filter.test(groupCode)) {
            toastr.error("Mã nhóm không có ký tự đăc biệt, không khoảng trắng hoặc không có dấu tiếng việt");
            return;
        }
        var arrayGetItem = [];
        var isAllStore = $('.fs-label-wrap').attr('data-selectall');
        if (isAllStore == 1) {
            $("#txtListGetItem").val('')
        }
        else {
            debugger
            isAllStore = 0;
            var listItemGetArray = $('#slItemGet').val()
            var listItemGetInArea = $("#txtListGetItem").val();
            if (listItemGetInArea == "") {
                $("#txtListGetItem").val(listItemGetArray.join(";"));
            }
            else {
                debugger
                // var arrayStore = [];
                $('.fs-option').removeClass('selected');
                $.each(listItemGetInArea.split(/\;*\n*\b\,*\ */), function (i, e) {
                    debugger
                    $(".fs-option[data-value='" + e + "']").toggleClass('selected');
                    arrayGetItem.push(e);
                });

                $("#slItemGet").val(arrayGetItem);
                $("#slItemGet").fSelect('reloadDropdownLabel');
            }
        }

        var listItemGetFinal = $('#slItemGet').val() == "" ? "" : JSON.stringify($('#slItemGet').val());

        if (arrayGetItem.length > 0 && isAllStore == 0) {
            debugger
            listItemGetFinal = JSON.stringify(arrayGetItem);
        }

        if (listItemGetFinal == "" || listItemGetFinal == "[]") {
            toastr.error("Vui lòng chọn sản phẩm để thêm vào nhóm");
            return;
        }

        loading.showloading();

        var fromData = new FormData();
        fromData.append('GroupCode', groupCode);
        fromData.append('GroupName', groupName);
        fromData.append('ListItem', listItemGetFinal);

        $.ajax({
            type: "POST",
            url: '@Url.Action("SetupBuyGroupItem", "SetupPromotion")',
            data: fromData,
            contentType: "application/json",
            dataType: "json",
            contentType: false,
            processData: false,
            success: function (data) {
                debugger
                if (data.Status == 200) {
                   // toastr.success(data.Message);
                    var arrayGroupCode = [];
                    arrayGroupCode.push(groupCode);
                    var jsonGroupCode = JSON.stringify(arrayGroupCode);

                    InsertUpdateGroupItemOfferGet(offerNo, offerType, conditionGet, lineNo, 1, jsonGroupCode, groupCodeOld, 0, 0, quantity, scaleType, isTotalBill, isSetupGet, totalBill);



                    $("#txtBuyGroupCode").val("");
                    $("#txtBuyGroupName").val("");
                    $("#txtListBuyItem").val("");
                }
                else {
                    toastr.error(data.Message);
                }
                loading.hideloading();
            },
            error: function () {
                loading.hideloading();
            }
        });
    }

</script>