@using VCM.BLUEPOS.Model.SetupPromotion
@{
    var data = Model.GetOfferGet as List<OfferGetModel>;
    var comboLineType = ComboboxModel.ComboLineType();
    var comboScaleType = ComboboxModel.ComboScaleType();
    var comboDiscountType = ComboboxModel.ComboDiscountType();

    var model = Model as GetBBModel;
    var offerHeader = model.GetOfferHearder;
    var offerNo = model.OfferNo;
    var offerType = model.OfferType;
    var isTotalBill = model.IsTotalBill;
    var isSetupGet = model.IsSetupGet;
    var totalBill = isTotalBill == true ? (data != null && data.Count > 0 ? data.FirstOrDefault().Step : 0) : 0;

    List<string> listGetLink = new List<string>(new string[] { "AND", "OR" });
    var getLinkCat = offerHeader.GetLinkCat == "O" ? "OR" : "AND";
    var checkDiscount = offerHeader.CheckDiscount == "1" ? "checked" : "";
    var discountType = offerHeader.DiscountType == "%" ? "0" : offerHeader.DiscountType == "R" ? "1" : "2";
    var discountValue = string.Format("{0:###,###}", offerHeader.DiscountValue);

    var displayButton = offerHeader.CheckDiscount == "1" ? "display:none" : "display:block";
    var displayTable = offerHeader.CheckDiscount == "1" ? "display:inline-table" : "display:none";
    var uomDiscount = offerHeader.DiscountType == "%" ? "%" : "VNĐ";

}
<div class="d-flex justify-content-between align-items-end mb-3">

    <!-- LEFT: Button only -->
    <div class="d-flex align-items-end" style="gap:12px;">
        <div>
            <button type="button"
                    class="btn btn-primary font-weight-bold"
                    id="btnAppendTableGet"
                    onclick="AppendGetTable()">
                <i class="la la-plus-circle"></i> Thêm dòng (Ctrl + A)
            </button>
        </div>
    </div>

    <!-- RIGHT: Số lượng + Điều kiện + Giảm giá tổng bill -->
    <div class="d-flex align-items-end" style="gap:12px;">
        <div>
            <label class="font-weight-bold d-block">Số lượng dòng</label>
            <input type="number"
                   id="txt-Qty-Row-Get"
                   value="10"
                   style="width:80px;"
                   class="form-control">
        </div>
        <div>
            <label class="font-weight-bold d-block">Điều kiện áp dụng</label>
            <select class="form-control select2 changeEventDiscount" style="width:120px;" id="slDKApDungGet">
                @{
                    foreach (var item in listGetLink)
                    {
                        var selected = item == getLinkCat ? "selected" : "";
                        <option value="@item" @selected>@item</option>
                    }
                }
            </select>
        </div>
        <div>
            <div class="input-group" style="position: relative;">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <label class="checkbox checkbox-inline" title="Giảm giá tổng bill">
                            <input type="checkbox" id="chkDiscountBill" @checkDiscount class="chkDiscountBill" />
                            <span></span>
                        </label>
                    </span>
                </div>
                <div class="input-group-append">
                    <span class="input-group-text">Giảm giá tổng bill</span>
                </div>

                <table id="tableDiscount" class="table table-bordered text-nowrap shadow"
                       style="position:absolute;
                          top: 100%;
                          right: 0;
                          z-index: 1050;
                          background-color: #fff;
                          width: 300px;
                          margin-top: 5px;
                          border: 1px solid #f77ce6;
                          @displayTable">
                    <tr style="background-color:#f77ce6; color:#FFFFFF; font-weight:bold">
                        <td colspan="2">Giảm giá tổng bill</td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle">Loại khuyến mãi</td>
                        <td style="vertical-align:middle">
                            <select class="form-control select2 changeEventDiscount" id="slTypeDiscount" style="width:100%">
                                @foreach (var loai in comboDiscountType)
                                {
                                    var selected = loai.value == discountType ? "selected" : "";
                                    <option value="@loai.value" @selected data-uom="@loai.UOM">@loai.Display</option>
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle">Giá trị khuyến mãi</td>
                        <td style="vertical-align:middle">
                            <input type="text" id="txtDiscountValue" value="@discountValue" class="form-control money changeEventDiscount" />
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle">ĐVT</td>
                        <td style="vertical-align:middle; font-weight:bold;">
                            <span id="uomDiscountType" style="font-family:Arial,'Helvetica Neue',sans-serif;">@uomDiscount</span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card-body table-responsive">

            <table class="table table-bordered text-nowrap" id="tableOfferGet">
                <thead>
                    <tr class="text-center">
                        <th>Loại</th>
                        <th>Barcode/Mã Nhóm SP</th>
                        <th>Sản phẩm</th>
                        <th>Đơn vị tính</th>
                        <th>Số lượng</th>
                        <th>Điều kiện áp dụng</th>
                        <th>Loại khuyến mãi</th>
                        <th>Giá trị</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody id="deleteAllTr">
                    @if (data != null && data.Count > 0)
                    {
                        foreach (var item in data)
                        {
                            var tagTr = $"trGet_{item.OfferNo}_{item.LineNo}";
                            var clssItem = $"itemGet_{item.OfferNo}_{item.LineNo}";
                            var clssHiddenItem = $"itemHiddenGet_{item.OfferNo}_{item.LineNo}";
                            var clssDesc = $"descGet_{item.OfferNo}_{item.LineNo}";
                            var clssUOM = $"uomGet_{item.OfferNo}_{item.LineNo}";
                            var clssLineType = $"selectLineTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssDiscountType = $"selectDiscountTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssDiscountValue = $"txtDiscountValueGet_{item.OfferNo}_{item.LineNo}";
                            var clssScaleType = $"selectScaleTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssQuantity = $"txtQuantityGet_{item.OfferNo}_{item.LineNo}";
                            var spanHtml = $"spanActionGet_{item.OfferNo}_{item.LineNo}";
                            var placeHolder = item.LineType == 1 ? "groupCode" : "itemNo";
                            var disableLineType = !string.IsNullOrEmpty(item.No) ? "disabled" : "";
                            var classHiddenLineType = $"hiddenLineTypeGet_{item.OfferNo}_{item.LineNo}";
                            <tr id="@tagTr">
                                <td style="min-width:120px;vertical-align:middle">
                                    <input type="hidden" class="form-control @classHiddenLineType" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@item.LineType" />
                                    <select @disableLineType class="form-control eventGetGrid select2 @clssLineType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboLineType)
                                        {
                                            var selected = loai.value == "" + item.LineType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="min-width:150px;vertical-align:middle">
                                    <input type="hidden" class="form-control @clssHiddenItem @clssItem"
                                           data-offerno="@item.OfferNo"
                                           data-lineno="@item.LineNo"
                                           data-linetype="@item.LineType"
                                           data-groupcode="@item.BonusBuyNo" value="@item.No" />
                                    <span class="font-weight-bold">@item.No</span>
                                </td>
                                <td style="vertical-align:middle">
                                    <span class="@clssDesc">@item.Description</span>
                                </td>

                                <td style="vertical-align:middle;text-align:center"><span class="@clssUOM">@item.UnitOfMeasure</span></td>
                                <td style="vertical-align:middle">
                                    <input type="text" style="width:100%" class="form-control eventGetGrid @clssQuantity money" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@string.Format("{0:###,###}", item.Quantity)" />
                                </td>

                                <td style="width:100px;vertical-align:middle">
                                    <select class="form-control select2 eventGetGrid @clssScaleType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboScaleType)
                                        {
                                            var selected = loai.value == "" + item.ScaleType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="width:100px;vertical-align:middle">
                                    <select class="form-control select2 eventGetGrid @clssDiscountType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboDiscountType)
                                        {
                                            var selected = loai.value == "" + item.DiscountType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="vertical-align:middle;text-align:center">
                                    <input type="text" style="width:100%" class="form-control money eventGetGrid money @clssDiscountValue" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@string.Format("{0:###,###}", item.DiscountValue)" />
                                </td>
                                @*<td style="vertical-align:middle;text-align:center">@item.LineGroup</td>*@
                                <td style="vertical-align:middle;width:80px; text-align:center">
                                    <span class="@spanHtml">
                                        <a onclick="DeleteOfferGet('@item.OfferNo',@item.LineNo,'@item.No','false','true',@item.LineType,'@item.BonusBuyNo')" title="Xóa" class="btn btn-icon btn-light-danger" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-no="@item.No"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<div class="modal fade" id="modalListItemSetupGet" tabindex="-1" role="dialog" aria-hidden="true">
    <div id="divPopupListItemGet"></div>
</div>

<script type="text/javascript">
    var offerNo = '@offerNo';
    var offerType = '@offerType';
    var isTotalBill = '@isTotalBill';
    var isSetupGet = '@isSetupGet';
    var totalBill = '@totalBill';

    $(document).on("keydown", function (e) {
        if (e.ctrlKey && e.key.toLowerCase() === "a") {
            e.preventDefault();
            $("#btnAppendTableGet").click();
        }
    });

    $(document).ready(function () {

        // $(".select2").select2();
        $("#slDKApDungGet").select2();

        // Init select2 cho các DB rows
        $("#tableOfferGet tbody tr[id^='trGet_']").find(".select2").each(function () {
            if (!$(this).hasClass("select2-hidden-accessible")) {
                $(this).select2({ width: '100%' });
            }
        });

        $('.money').mask('000,000,000', {
            placeholder: "0",
            reverse: true,
            rightAlign: true
        });


        $("#chkDiscountBill").on("change", function () {
           // return;//tam dong lai. honglk:28.03.2026
            var checkData = 0;
            $('#tableOfferGet > tbody > tr').each(function () {
                checkData++;
                //break;
            });
            if (checkData > 0) {
                $.confirm({
                    backgroundDismiss: false,
                    escapeKey: true,
                    icon: 'fa fa-warning',
                    type: 'red',
                    typeAnimated: true,
                    title: 'Thông báo',
                    content: "Bạn có chắc chắn xóa danh sách sản phẩm khuyến mãi hay không?",
                    buttons: {
                        "CÓ": {
                            btnClass: 'btn btn-default',
                            keys: ['ctrl'],
                            action: function () {
                                $('#tableOfferGet tbody').empty(); // Dùng empty() sạch hơn remove() tr
                                $('#btnAppendTableGet').prop('disabled', true);
                                $("#slDKApDungGet").prop('disabled', true);
                                $('#tableDiscount').css('display', "inline-table");
                            }
                        },
                        "KHÔNG": {
                            btnClass: 'btn-default',
                            action: function () {
                                // $("#offGet-tab").trigger("click");
                                $("#chkDiscountBill").prop('checked',false)
                            }
                        }
                    }
                });

            }
            else {
                if ($("#chkDiscountBill").prop('checked')) {
                    // $('#btnAppendTableGet').css('display', "none");
                    $('#btnAppendTableGet').prop('disabled', true);
                    $("#slDKApDungGet").prop('disabled', true);
                    $('#tableDiscount').css('display', "inline-table");
                    var uom = $("#slTypeDiscount").select2().find(":selected").data("uom");
                    $("#uomDiscountType").html(uom);
                }
                else {
                    $("#txtDiscountValue").val("0");
                    // $('#btnAppendTableGet').css('display', "block");
                    $('#btnAppendTableGet').prop('disabled', false);
                    $("#slDKApDungGet").prop('disabled', false);
                    $('#tableDiscount').css('display', "none");
                }
                //UpdateHeaderGet();
            }


        });

    });

    function UpdateHeaderGet_bk() {

        var uom = $("#slTypeDiscount").select2().find(":selected").data("uom");
            var typeDiscount = $("#slTypeDiscount").val();
            $("#uomDiscountType").html(uom);

            var conditionGet = $("#slDKApDungGet").val();
            var chkDiscount = "";
            var discountValue = "";

            if ($("#chkDiscountBill").prop('checked')) {
                chkDiscount = 1;
                discountValue = $("#txtDiscountValue").val().replace(/\,/g, '');
            }
            else {
                discountValue = "";
                typeDiscount = "";
                chkDiscount = "";
            }

            if (typeDiscount == "0" && discountValue > 100) {
                toastr.error("Vui lòng nhập giá trị không được lớn hơn 100");
            }
            else {

                var fromData = new FormData();
                fromData.append('OfferNo', offerNo);
                fromData.append('GetLinkCat', conditionGet);
                fromData.append('CheckDiscount', chkDiscount);
                fromData.append('TypeDiscount', typeDiscount);
                fromData.append('DiscountDiscount', discountValue);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SetupHeaderGet", "SetupPromotion")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.Status == 200) {

                        }
                        else {
                            toastr.error(data.Message);
                            $("#offGet-tab").trigger("click");
                        }

                    },
                    error: function () {
                    }
                });
            }

    }

    function AppendGetTable() {

        let startLineNo = getMaxLineNoGet();
        let iRow = parseInt($("#txt-Qty-Row-Get").val(), 10) || 1;

        let html = "";

        for (let i = 1; i <= iRow; i++) {
            let lineNo = startLineNo + i;

            html += `
            <tr class="text-center _row bgSelect_${lineNo}" id="${lineNo}" data-lineno="${lineNo}">
                 <td style="width:100px;vertical-align:middle">

                     <select class="form-control LineType sLineType_${lineNo} select2" data-stt="${lineNo}" id="LineTypeGet_${lineNo}">
                         @foreach (var loai in comboLineType)
                         {
                             <option value="@loai.value">@loai.Display</option>
                         }
                     </select>
                 </td>
                 <td class="text-left" style="min-width:100px;vertical-align:middle">
                     <div class="input-group">
                         <input type="text" class="form-control barcode changeBarcode_${lineNo}" id="codeGet_${lineNo}" value="" data-stt="${lineNo}" placeholder="Nhập barcode..."/>
                         <div class="input-group-append eventGetPopup sGroupitem_${lineNo}" data-stt="${lineNo}" style="display:none;"><span class="input-group-text"><i class="flaticon2-search-1 icon-md"></i></span></div>
                     </div>
                 </td>
                 <td style="min-width:250px;vertical-align:middle">
                     <select class="form-control select2 slItem slchangeItem_${lineNo}" data-stt="${lineNo}">
                         <option value="">Chọn sản phẩm</option>
                     </select>
                 </td>
                 <td style="vertical-align:middle;text-align:center;">
                     <select class="form-control select2 slUom slchangeUom_${lineNo}" data-stt="${lineNo}" style="width:100%">
                         <option value="">Chọn UOM</option>
                     </select>
                 </td>
                 <td style="vertical-align: middle; text-align: right;">
                     <input type="text" style="width:100%" class="form-control quantity  money changeQuantity_${lineNo}" data-lineno="${lineNo}" value="1" />
                 </td>

                 <td style="width:100px;vertical-align:middle">
                     <select class="form-control select2 ScaleType SChangecaleType_${lineNo}" data-stt="${lineNo}">
                         @foreach (var loai in comboScaleType)
                         {
                             var selected = loai.value == "C" ? "selected" : "";
                             <option value="@loai.value" @selected>@loai.Display</option>
                         }
                     </select>
                 </td>
                 <td style="width:100px;vertical-align:middle">
                     <select class="form-control select2 sDiscountType_${lineNo}"   data-lineno="${lineNo}" >
                         @foreach (var loai in comboDiscountType)
                         {
                             <option value="@loai.value">@loai.Display</option>
                         }
                     </select>
                 </td>
                 <td style="vertical-align:middle;text-align:center">
                     <input type="text" style="width:100%" class="form-control money  money discountValue sDiscountValue_${lineNo}"   data-lineno="${lineNo}"  value="0" />
                 </td>
                 <td style="vertical-align:middle;text-align:center">
                     <span>
                         <a title="Xóa" class="btn btn-icon btn-light-danger removeItem removeItem_${lineNo}" data-stt="${lineNo}"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                     </span>
                 </td>
                 <td class="text-center" style="vertical-align:middle;color:red; display:none"><span class="error error_${lineNo}"></span></td>
             </tr>
            `;
        }

        // append 1 lần (tối ưu)
        $("#tableOfferGet tbody").append(html);

        // init từng row
        for (let i = 1; i <= iRow; i++) {
            let lineNo = startLineNo + i;
            initRowGet(lineNo);
        }
    }
    function AppendGetTable_bk() {
        debugger;
        let startLineNo = getMaxLineNoGet();
        let iRow = parseInt($("#txt-Qty-Row-Get").val(), 10) || 1;
        var conditionGet = $("#slDKApDungGet").val();

        loading.showloading();

        // build list lineno
        let linenos = [];
        for (let i = 1; i <= iRow; i++) {
            linenos.push(startLineNo + i);
        }

        // Sử dụng tên biến thống nhất: formData
        var formData = new FormData();
        formData.append('offerNo', typeof offerNo !== 'undefined' ? offerNo : '');
        formData.append('offerType', typeof offerType !== 'undefined' ? offerType : '');
        formData.append('conditionGet', conditionGet);
        formData.append('isTotalBill', typeof isTotalBill !== 'undefined' ? isTotalBill : false);
        formData.append('isSetupGet', typeof isSetupGet !== 'undefined' ? isSetupGet : false);
        formData.append('totalBill', typeof totalBill !== 'undefined' ? totalBill : 0);

        // Append mảng linenos
        linenos.forEach(x => formData.append('linenos', x));

        $.ajax({
            type: "POST",
            url: '@Url.Action("_AppendOfferGet", "SetupPromotion")',
            data: formData, // Đã sửa tên biến
            dataType: "json",
            contentType: false, // Bắt buộc khi dùng FormData
            processData: false, // Bắt buộc khi dùng FormData
            success: function (result) {
                debugger;
                if (result.Status == 200) {
                    // Append HTML vào table
                    $("#tableOfferGet tbody").append(result.ViewPartial);

                    // Init từng row mới dựa trên danh sách lineno
                    if (Array.isArray(linenos)) {
                        linenos.forEach(x => {
                            if (typeof initRowGet === "function") {
                                initRowGet(x);
                            }
                        });
                    }
                } else {
                    toastr.error(result.Message || "Có lỗi xảy ra");
                    $("#offGet-tab").trigger("click");
                }
                loading.hideloading();
            },
            error: function (xhr, status, error) {
                console.error(error);
                toastr.error("Lỗi hệ thống khi tải dòng mới");
                loading.hideloading();
            }
        });
    }

    function initRowGet(stt) {
        //$(".select2").select2();

        var row = $(".bgSelect_" + stt);

        // Chỉ init các select thông thường; slItem được init riêng bên dưới với AJAX config
        row.find('.select2:not(.slItem)').each(function () {
            if (!$(this).hasClass("select2-hidden-accessible")) {
                $(this).select2({ width: '100%' });
            }
        });
        row.find('.slItem').select2({
            placeholder: "Chọn sản phẩm",
            minimumInputLength: 1,
            language: {
                searching: () => "Đang tải dữ liệu...",
                noResults: () => "Không tìm thấy dữ liệu"
            },
            ajax: {
                url: '/SetupPrice/SearchItem',
                type: 'POST',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        keyword: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * data.pageSize) < data.total
                        }
                    };
                }
            }
        });

        row.find('.money').mask('000,000,000', {
            reverse: true
        });
    }

    // Xóa handlers cũ để tránh tích lũy khi partial view được reload nhiều lần
    $(document).off('.getTab');

    $(document).on('change.getTab', '.LineType', function () {
        var data = $(this).select2('data');
        var stt = $(this).data("stt");
        var lineTypeVal = data[0].id;
        if (lineTypeVal === "1") {//theo nhóm
            $(".changeBarcode_" + stt).val("");
            setTimeout(function () {
                $(".changeBarcode_" + stt).attr("placeholder", "Nhập mã nhóm...");
            }, 0);
            $(".slchangeItem_" + stt).val("");
            $(".slchangeUom_" + stt).val("");
            $(".slchangeUom_" + stt).prop("disabled", true);
            $(".slchangeItem_" + stt).prop("disabled", true);
            $(".sGroupitem_" + stt).show();
        } else {// theo item
            $(".changeBarcode_" + stt).val("");
            $(".slchangeUom_" + stt).prop("disabled", false);
            $(".slchangeItem_" + stt).prop("disabled", false);
            $(".sGroupitem_" + stt).hide();
            setTimeout(function () {
                $(".changeBarcode_" + stt).attr("placeholder", "Nhập barcode...");
            }, 0);
        }
    });

    $(document).on("select2:select.getTab", ".slItem", function (e) {
        var stt = $(this).data("stt");
        var data = e.params.data;

        var itemNo = data.id;
        var uom = data.uom;
        if (!uom) return;

        var uomList = uom.includes(",") ? uom.split(",") : [uom];

        // FIX: ===
        if (uomList.length === 1) {
            var firstUom = uomList[0].trim();

            if (isDuplicateItemGet(itemNo, firstUom, stt)) {
                toastr.warning(`Sản phẩm [${itemNo} - ${firstUom}] đã tồn tại`);

                $(this).val(null).trigger("change");
                $(".slchangeUom_" + stt).empty().trigger("change");
                $(".changeBarcode_" + stt).val("");
                return;
            }
        }

        $(".changeBarcode_" + stt).val("");

        var selectuom = $(".slchangeUom_" + stt);
        selectuom.empty();

        uomList.forEach(function (iuom, i) {
            var isSelected = i === 0;
            var option = new Option(iuom.trim(), iuom.trim(), isSelected, isSelected);
            selectuom.append(option);
        });

        $(".error_" + stt).text("");
        selectuom.trigger('change');
    });
    $(document).on("click.getTab", ".removeItem", function () {
        var stt = $(this).data("stt");
        $(".bgSelect_" + stt).remove();
    });

    $(document).on("click.getTab", ".eventGetPopup", function () {
        var stt = $(this).data("stt");
        var lineTypeVal = $(".sLineType_" + stt).val();
        var codeBuy = $("#codeGet_" + stt).val();
        if (lineTypeVal === "0") {//theo item
            return;
        } else {
            var filter = /^([a-zA-Z\-0-9_]+)$/;
            if (!filter.test(codeBuy)) {
                toastr.error("Mã nhóm không có ký tự đăc biệt, không khoảng trắng hoặc không có dấu tiếng việt");
                $("#codeGet_" + stt).focus();
                return;
            }
        }
        loading.showloading();
        //$("#divPopupListItem").html("");
        /////////////////////////////////////////////////////
        $.ajax({
            type: "GET",
            url: "/SetupPromotion/_ViewSetupGroupItemGet?LineNo=" + stt + "&groupGetCode=" + codeBuy,
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#divPopupListItem").html(result);

                $('#modalListItemSetup').modal({
                    backdrop: 'static',
                    keyboard: false
                });

            },
            error: function (event) {

            }
        });
        /////////////////////////////////////////////////////

        loading.hideloading();
    });
    function getMaxLineNoGet() {
        var max = 0;
        // Quét tất cả rows: cả DB rows lẫn new rows
        $("#tableOfferGet tbody tr").each(function () {
            var lineno = parseInt($(this).find("[data-lineno]").first().attr("data-lineno")) || 0;
            if (lineno > max) max = lineno;
        });
        return max;
    }

    $(document).on("change.getTab", ".barcode", function (e) {
        var stt = $(this).data("stt");
        var value = $(this).val();
        var lineTypeVal = $(".sLineType_" + stt).val();
        if (lineTypeVal === "1") {
            if (isDuplicateBarcodeGet(value, stt)) {
                // Ngăn chặn trình duyệt nhảy sang ô tiếp theo nếu là phím Tab
                e.preventDefault();
                toastr.warning("Mã đã tồn tại");
                $(this).focus();
                $(".changeBarcode_" + stt).val("");
            }
        }
    });
    $(document).on("keydown.getTab", ".barcode", function (e) {
        var stt = $(this).data("stt");
        var value = $(this).val();
        if (value === "") {
            return;
        }
        var lineTypeVal = $(".sLineType_" + stt).val();
        if (lineTypeVal === "1") {
            if ((e.key === "Enter" || e.key === "Tab") && value !== "") {
                if (isDuplicateBarcodeGet(value, stt)) {
                    // Ngăn chặn trình duyệt nhảy sang ô tiếp theo nếu là phím Tab
                    e.preventDefault();
                    toastr.error("Mã " + value + "đã tồn tại");
                    $(this).focus();
                    $(".changeBarcode_" + stt).val("");
                }
            }
            return;
        }

        if ((e.key === "Enter" || e.key === "Tab") && value !== "") {

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetInfoBarcode", "SetupPrice")',
                data: { barcode: value },
                success: function (response) {

                    if (response.Status == 200) {
                        var data = response.items;

                        if (!data || data.length === 0) {
                            toastr.error('Không tồn tại ' + value);
                            $(".barcode[data-stt='" + stt + "']").val("");
                            return;
                        }

                        if (isDuplicateBarcodeGet(value, stt)) {
                            toastr.warning("Mã " + value + " đã tồn tại");

                            $(".slchangeItem_" + stt).val(null).trigger("change");
                            $(".slchangeUom_" + stt).empty().trigger("change");
                            $(".changeBarcode_" + stt).val("");
                            $(".barcode[data-stt='" + stt + "']").val("");
                            return;
                        }

                        var item = data[0];

                        // set UOM
                        var selectuom = $(".slchangeUom_" + stt);
                        selectuom.empty();
                        selectuom.append(new Option(item.uom, item.uom, true, true)).trigger('change');

                        // set Item
                        var select = $(".slchangeItem_" + stt);
                        select.append(new Option(item.text, item.id, true, true)).trigger('change');

                        $(".error_" + stt).text("");
                    }
                    else {

                        toastr.error(response.Message);
                    }
                }
            });
        }
    });
    function isDuplicateItemGet(itemNo, uom, currentStt) {
        var isDup = false;

        $(".slItem").each(function () {
            var stt = $(this).data("stt");
            if (stt == currentStt) return;

            var item = $(this).val();
            var uomVal = $(".slchangeUom_" + stt).val();

            if (item == itemNo && uomVal == uom) {
                isDup = true;
                return false;
            }
        });

        return isDup;
    }
    function isDuplicateBarcodeGet(barcode, currentStt) {
        var isDup = false;

        $(".barcode").each(function () {
            var stt = $(this).data("stt");
            if (stt == currentStt) return;

            var val = $(".changeBarcode_" + stt).val();
            if (val == barcode) {
                isDup = true;
                return false;
            }
        });

        return isDup;
    }
</script>
