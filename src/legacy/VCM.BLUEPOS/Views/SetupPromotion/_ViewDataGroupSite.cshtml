@{
    var offerNo = ViewBag.OfferNo;
}

<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <input type="text" id="viewGroupCode" class="form-control eventChangeGroup" placeholder="groupCode" />
    </div>

    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
        <input type="text" id="viewGroupName" class="form-control eventChangeGroup" placeholder="groupName" />
    </div>

</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="viewtblDataGroup" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>GROUP CODE</th>
                    <th>GROUP NAME</th>
                    <th>CH/ST</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>



<script type="text/javascript">
    var offerNo = '@offerNo';
    var table = "";
    $(document).ready(function () {
        $(".eventChangeGroup").on("change", function () {
            table.draw();
        });
        $("#viewbtnSearchGroup").on("click", function () { table.draw(); });


        table = $('#viewtblDataGroup').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false, // for show progress bar
            serverSide: true, // for process server side
            filter: true, // this is for disable filter (search box)
            orderMulti: false, // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 5,
            searching: false,
            lengthChange: false,
            ajax: {
                url: '@Url.Action("ListGroupSite", "SetupPromotion")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.GroupCode = $("#viewGroupCode").val();
                    d.GroupName = $("#viewGroupName").val();
                }
            },
            //data, type, full, meta
            createdRow: function (row, data, full, meta) {
                debugger
                $(row).attr('id', "rowRecord" + data.GroupCode);
                $(row).attr('class', "classGroupCode");
                $(row).attr('data-groupcode', data.GroupCode);
            },
            drawCallback: function (settings) {
                $(".eventGroupCode").click(function () {
                    var groupcode = $(this).attr("data-groupcode");

                    ViewListStore(groupcode);

                });

                $(".radioChkGroupCode").click(function () {

                    var arrayGroupCode = [];
                   
                    var groupCode = $(this).attr("data-groupcode");
                    var groupName = $(this).attr("data-groupname");

                    arrayGroupCode.push(groupCode);
                    var jsonGroupCode = JSON.stringify(arrayGroupCode);

                    SetGroupSite(offerNo, jsonGroupCode, groupName);
                 
                });
            },
            columns: [
                {
                    data: "GroupCode",
                    "className": "text-center",
                    "render": function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "GroupCode",
                    className: 'text-center classGroupCode'

                },
                {
                    data: "GroupName",     
                    className: 'text-center classGroupCode'
                },
                {
                    data: "GroupCode",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<a title=\"Xem CH/ST\" data-groupcode='" + full.GroupCode + "' class=\"btn btn-icon btn-light-primary eventGroupCode\"><i class=\"flaticon2-gear\"></i><span class=\"pulse-ring\"></span></a>";
                    
                        return html;
                    },
                    className: 'text-center'
                },
                {
                    data: "GroupCode",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<label class=\"radio radio-lg radio-rounded\" title=\"Chọn groupCode\">";
                        html += "<input type=\"radio\" data-groupcode='" + full.GroupCode + "' data-groupname='" + full.GroupName + "' class=\"radioChkGroupCode\" name=\"radioGroup\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });

    function SetGroupSite(offerNo, groupCode,groupName) {

        loading.showloading();
        var url = "SetupPromotion/InsertUpdateOfferSite";
        var fromData = new FormData();
        fromData.append('OfferNo', offerNo);
        fromData.append('JsonGroupCode', groupCode);
        $.ajax({
            type: "POST",
            url: url,
            data: fromData,
            contentType: "application/json",
            dataType: "json",
            contentType: false,
            processData: false,
            success: function (result) {
                debugger
                if (result.Status == 200) {                
                    toastr.success(result.Message);
                    $("#groupNo_" + offerNo).val(JSON.parse(groupCode)[0]);
                    $("#groupName_" + offerNo).html(groupName);
                    var html = "";
                    html += "<a onclick=\"ViewListStoreSetup('" + groupCode + "')\" title=\"Xem CH/ST\" class=\"btn btn-icon btn-light-primary\"><i class=\"flaticon2-gear\"></i><span class=\"pulse-ring\"></span></a>";
                    $(".spanGroupView_" + offerNo).html(html);
                }
                else {                  
                    toastr.error(result.Message);
                }

                loading.hideloading();
            },
            error: function () {
                loading.hideloading();
            }
        });

    }

    function ViewListStore(groupCode) {
        $.ajax({
            type: "GET",
            url: "/SetupPromotion/_ViewListStore?groupCode=" + groupCode + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#divDataGroupSite").html(result);

            },
            error: function (event) {

            }
        });
    }
</script>
