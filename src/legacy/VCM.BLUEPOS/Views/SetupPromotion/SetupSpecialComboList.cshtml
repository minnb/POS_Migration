                    <!-- Chi tiet -->

                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <table id="tbl-modal-update-detail-special-combo" class="table table-bordered table-hover text-nowrap">
                                            <thead>
                                                <tr style="text-transform:uppercase;text-align:center;">
                                                    <th style="min-width:120px;">#</th>
                                                    <th style="min-width:50px;">STT</th>
                                                    <th style="min-width:150px;">Mã nhóm</th>
                                                    <th style="min-width:350px;">Tên nhóm</th>
                                                    <th style="min-width:150px;">Mã sản phẩm</th>
                                                    <th style="min-width:250px;">Tên sản phẩm</th>
                                                    <th style="min-width:120px;">Đơn vị tính</th>
                                                    <th style="min-width:120px;">Giá bán</th>
                                                    <th style="min-width:120px;">Số lượng (Min)</th>
                                                    <th style="min-width:120px;">Số lượng (Max)</th>
                                                    <th style="min-width:120px;">Trạng thái</th>
                                                    <th style="min-width:250px;">Loại sản phẩm</th>
                                                    <th style="min-width:100px;">Order</th>
                                                </tr>
                                            </thead>
