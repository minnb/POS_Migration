        function LoadComboxItemV2(id) {
            $('#' + id).select2({
            ajax: {
                type: "POST",
                url: '@Url.Action("LoadComboxItemV2", "SetupPromotion")',
                dataType: "json",
                delay: 250,
                global: false,
                data: function (params) {
                    //debugger
                    var query = {
                        searchText: params.term,
                        page: params.page || 1,
                        pageSize: 20,
                        itemNo: ""
                    }
                    return query;
                },

                processResults: function (data, params) {
                    params.page = params.page || 1;
                    var results = [];
                    var firstChoice = [{
                        text: '--- Chọn ---',
                        id: ""
                    }];

                    var optionValue = $.map(data.data, function (item) {
                        return {
                            text: item.No + " - " + item.Description,
                            id: item.No
                        };
                    });

                    if (params.page == 1) {
                        results = results.concat(firstChoice);
                    }
                    results = results.concat(optionValue);

                    return {
                        results: results,
                        pagination: {
                            more: params.page < Math.ceil(data.count / 20)
                        }
                    };
                },
                cache: true
               }
          });
        }

        function LoadComboxUOM(uomID, itemID) {
            var itemNo = $('#' + itemID).val();
            if (itemNo == null) {
                toastr.error("Vui lòng chọn sản phẩm");
                return;
            }
            var html = '';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxUOM", "SetupPromotion")',
                dataType: "json",
                data: { ItemNo: itemNo },
                success: function (data) {
                    //debugger
                    if (data == null) {
                        html += "<option value=\"\" selected>--- Chọn ---</option>";
                    }
                    else
                    {
                        if (data.length > 1) {
                            html += "<option value=\"\" selected>--- Chọn ---</option>";
                            data.forEach((name, i) => {
                                if (name.UOM != "") {
                                    html += "<option value=" + name.UOM + ">" + name.UOM + "</option>";
                                }
                            });
                        }
                        else if (data.length == 1) {
                            data.forEach((name, i) => {
                                if (name.UOM != "") {
                                    html += "<option value=" + name.UOM + " selected>" + name.UOM + "</option>";
                                }
                            });
                        }
                        else {
                            html += "<option value=\"\" selected>--- Chọn ---</option>";
                        }
                    }
                    $('#' + uomID).html(html);
                    $('#' + uomID).select2();
                },
                error: function () {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

