                html += '</select>';
                $("#div-store-no").html(html);

                $('#sel-store-no').fSelect({
                    showSearch: false,
                    isSelectAll: false,
                    includeSelectAllOption: false
                });
            }
            else {

                loading.showloading();
                var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-store-no" name="StoreNo">';
                $.ajax({
                url: '@Url.Action("LoadComboxStoreByUserChannel", "Common")',
                type: "POST",
                dataType: "json",
                data: {channelSales: channelSales},
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value=" + name.SiteNo + ">" + name.SiteNo + "-" + name.SiteName + "</option>";
                            }
                        });
                        html += '</select>';
                        $("#div-store-no").html(html);

                        $('#sel-store-no').fSelect({
                            placeholder: '--- Chọn ---',
                            numDisplayed: 1,
                            overflowText: '{n} Cửa hàng được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy cửa hàng',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true,
                            includeSelectAllOption: true
                        });
                    }
                },
                error: function () {
                }
                });
            }
        }

