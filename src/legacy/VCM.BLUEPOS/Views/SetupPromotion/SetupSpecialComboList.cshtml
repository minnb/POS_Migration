        function colectDataSpecialComboLine() {
            // debugger
            var data = [];
            $('#main-div-group-code').find('.div-row-collapse').each(function () {
                var GroupCode = $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.txt-group-code').val();
                var GroupName = $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.txt-group-name').val();
                var MinimumQuantity = $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.txt-min-quantity').val();
                var MaximumQuantity = $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.txt-max-quantity').val();
                var Order = $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.txt-order').val();
                $(this).find('.div-card-special-combo-line').find('.div-card-body-special-combo-line').find('.div-row-special-combo-line').find('.special-combo-item').each(function () {
                    var item = {};
                    // Add Group
                    item['GroupCode'] = GroupCode;
                    item['GroupName'] = GroupName;
                    item['MinimumQuantity'] = MinimumQuantity;
                    item['MaximumQuantity'] = MaximumQuantity;
                    item['Order'] = Order;
                    // Add Prodcut
                    item['ItemNo'] = $(this).find('.sel-item-no').val();
                    item['UOM'] = $(this).find('.sel-uom').val();
                    item['UnitPrice'] = $(this).find('.txt-price-sales').val();
                    item['IsDynamicPrice'] = $(this).find('.sel-item-type-by-price').val();
                    item['IsEnable'] = $(this).find('.chk-enable').val();
                    item['IsSendSAP'] = $(this).find('.chk-sendSAP').val();
                    data.push(item);
                });
            });
