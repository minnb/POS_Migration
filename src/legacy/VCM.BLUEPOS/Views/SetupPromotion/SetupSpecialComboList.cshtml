<!-- Modal thêm sản phẩm cho nhóm -->

<div class="modal fade" id="modal-add-item-by-group-code" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document" style="width:80%;margin-top:75px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Thêm sản phẩm cho nhóm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="card">
                            <div class="card-body" style="background-color:antiquewhite">
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12" style="display:none;">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã combo</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-modal-add-item-combo-code" placeholder="" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã nhóm</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-modal-add-item-group-code" placeholder="" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên nhóm</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-modal-add-item-group-name" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số lượng (Min)</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" id="txt-modal-add-item-min-quantity" min="0" step="1" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length == 13) return false;return isNumberKey(event);" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số lượng (Max)</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" id="txt-modal-add-item-max-quantity" min="0" step="1" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length == 13) return false;return isNumberKey(event);" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Order</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" id="txt-modal-add-item-order" min="0" step="1" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length == 13) return false;return isNumberKey(event);" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Sản phẩm</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-modal-add-item-by-item-no" name="CreateItemNo">
                                                @if (listItem != null && listItem.Count > 0)
                                                {
                                                    if (listItem.Count == 1)
                                                    {
                                                        <option value="@listItem.FirstOrDefault().No">@listItem.FirstOrDefault().No - @listItem.FirstOrDefault().Description</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="" selected>--- Chọn ---</option>
                                                        foreach (var item in listItem)
                                                        {
                                                            <option value="@item.No">@item.No - @item.Description</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Đơn vị tính</label>
                                        <div class="form-group" id="div-add-detail-uom">
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Giá bán</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-modal-add-unit-price" name="UnitPrice" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Loại sản phẩm</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-modal-add-item-is-dynamic-price" name="AddIsDynamicPrice">
                                                <option value="">--- Chọn ---</option>
                                                <option value="0" selected>Sản phẩm thường</option>
                                                @*<option value="1">Sản phẩm mặc định có giá bán thường</option>*@  <!-- Tạm cho ẩn, sau này dùng đến thì mở -->
                                                <option value="2">Sản phẩm mặc định có giá bán động</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="display:none;">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-modal-add-item-is-enable" name="AddIsEnabled">
                                                <option value="">--- Chọn ---</option>
                                                <option value="1" selected>Active</option>
                                                <option value="0">Deactive</option>
                                            </select>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="float:right;border-color:cadetblue">
                <button type="button" class="btn btn-primary font-weight-bold btn-save-add-item-no-by-group-code" id="btn-save-add-item-no-by-group-code"><i class="fa fa-save"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>


