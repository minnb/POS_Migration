        function UpdateStatusStore(code, storeno, status) {
            if (code == null || code == "") {
                toastr.error('Vui lòng chọn mã combo');
                return;
            }

            if (storeno == null || storeno == "") {
                toastr.error('Vui lòng chọn cửa hàng');
                return;
            }

            var fromData = new FormData();
            fromData.append('code', code);
            fromData.append('storeno', storeno);
            fromData.append('status', status);
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateStatusStore", "SetupPromotion")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == 1) {
                        $('#update-text-search-store').val(code);
                        $('#btn-search-status-store').trigger('click');
                        toastr.success(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                },
                error: function () {
                }
            });
        }

        function DeleteItemNoByGroupCode() {
             //debugger
            var code = $('#hdd-modal-detail-combo-code').val();
            var groupCode = $('#hdd-modal-detail-item-group-code').val();
            var itemNo = $('#hdd-modal-detail-item-by-item-no').val();
            var uom = $('#hdd-modal-detail-item-by-uom').val();
            loading.showloading();
            $.ajax({
                url: '@Url.Action("DeleteItemNoByGroupCode", "SetupPromotion")',
                type: "POST",
                dataType: "json",
                data: {
                    Code: code,
                    GroupCode: groupCode,
                    ItemNo: itemNo,
                    UOM: uom
                },
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 200) // thanh cong
                    {
                        $('.btn-search').trigger('click');
                        toastr.success(data.Message);
                        tbl_detail_update_special_combo.draw();
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

