@using VCM.BLUEPOS.Model.Promotion;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.SetupPromotion;
@using VCM.BLUEPOS.Model.SetupPromotion.SetupSpecialComboModel;

@{
    ViewBag.Title = "Khai báo SpecialCombo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listSalesType = ViewBag.ListSalesType as List<OptionDataModel>;
    var listStore = ViewBag.ListStore as List<StorePartnerModel>;
    var listCode = ViewBag.ListCode as List<CodeBySpecialComboHeaderModel>;
    var listItem = ViewBag.ListItem as List<ItemByComboLineModel>;
    var listUOM = ViewBag.ListUOM as List<ItemByComboLineModel>;
    var listMemberType = ViewBag.ListMemberCode as List<OptionDataModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khuyến mãi</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khai báo SpecialCombo</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-success font-weight-bold btn-add-new" id="btn-add-new"><i class="la la-plus-circle"></i>Thêm mới</button>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "SetupPromotion", FormMethod.Post, new { @id = "frm-export-excel" }))
        {
            <div class="card">
                <div class="card-body">
                    <div class="">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-store-no-header" name="StoreNoHeader">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.SiteNo - @item.SiteName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Hình thức bán hàng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-sales-type-header" name="SalesType">
                                            <option value="" selected>Tất cả</option>
                                            @if (listSalesType != null && listSalesType.Count > 0)
                                            {
                                                foreach (var item in listSalesType)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Hạng thẻ</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-member-type" name="MemberType">
                                            @if (listMemberType != null && listMemberType.Count == 1)
                                            {
                                                <option value="@listMemberType.FirstOrDefault().Code">@listMemberType.FirstOrDefault().Description</option>
                                            }
                                            else if (listMemberType != null && listMemberType.Count > 0)
                                            {
                                                <option value="" selected>Tất cả</option>
                                                foreach (var item in listMemberType)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-status" name="Status">
                                            <option value="">Tất cả</option>
                                            <option value="1">Active</option>
                                            <option value="0">Deactive</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="Nhập mã combo; tên combo..." />
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group" style="margin-top:25px;">
                                        <button type="button" class="btn btn-primary font-weight-bold btn-search"><i class="la la-search"></i>Tìm</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:5px;margin-top:5px"></div>

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <table id="tbl-special-combo-header-list" class="table table-bordered table-hover text-nowrap" style="width:100%;">
                                            <thead>
                                                <tr style="text-transform:uppercase;text-align:center;">
                                                    <th>#</th>
                                                    <th style="min-width:50px;">STT</th>
                                                    <th style="min-width:120px;">Mã Combo</th>
                                                    <th style="min-width:350px;">Tên Combo</th>
                                                    <th style="min-width:100px;">Hình thức bán hàng</th>
                                                    <th style="min-width:100px;">Số lượng</th>
                                                    <th style="min-width:100px;">Giá trị</th>
                                                    <th style="min-width:100px;">Trạng thái</th>
                                                    <th style="min-width:150px;">Từ ngày</th>
                                                    <th style="min-width:150px;">Đến ngày</th>
                                                    <th style="min-width:100px;">Hội viên WIN</th>
                                                    <th style="min-width:100px;">Hạng thẻ</th>
                                                    <th style="min-width:100px;">Người tạo</th>
                                                    <th style="min-width:100px;">Thời gian tạo</th>
                                                    <th style="min-width:100px;">Người cập nhật</th>
                                                    <th style="min-width:100px;">Thời gian cập nhật</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Special Combo -->

<div class="modal fade fixed-padding" id="modal-add-combo-header" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-mode" role="document">
        <div class="modal-content">
            <div class="modal-header" style="margin-top:-30px;">
                <h5 class="modal-title">Khai báo Special Combo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Mã combo</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-combo-code" name="ComboCode" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tên combo</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="txt-combo-name" placeholder="Nhập tên combo" />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hình thức bán hàng</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-sales-type" name="SalesType">
                                                @if (listSalesType != null && listSalesType.Count > 0)
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listSalesType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày</label>
                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-from-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="dd/MM/yyyy">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày</label>
                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <label class="input-group-btn" for="txt-to-date">
                                                        <span class="btn btn-default">
                                                            <span class="glyphicon glyphicon-calendar">
                                                                <i class="far fa-calendar-alt"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="dd/MM/yyyy">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Số lượng</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" min="0" step="1" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length == 13) return false;return isNumberKey(event);" id="txt-combo-quantity-header" name="ComboQuantity" value="" />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Giá trị</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" min="0" step="1" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length == 13) return false;return isNumberKey(event);" id="txt-amount-header" name="Amount" value="" />
                                        </div>
                                    </div>

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hạng thẻ</label>

                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-member-code-type" name="MemberCodeType" disabled>
                                                @if (listMemberType != null && listMemberType.Count > 0)
                                                {
                                                    <option value="" selected>--- Chọn ---</option>
                                                    foreach (var item in listMemberType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="input-group-prepend" style="padding-top:25px;">
                                        <span class="input-group-text-custom" style="border:none;">
                                            <input type="checkbox" id="chk-ismember-header" style="width:25px;height:25px;" />
                                            <span class="font-weight-bold" style="font-weight:bold !important">&nbsp;&nbsp;Hội viên WIN</span>
                                        </span>
                                    </div>

                                    <div class="input-group-prepend" style="padding-top:25px;">
                                        <span class="input-group-text-custom" style="border:none;">
                                            <input type="checkbox" id="chk-isenable-header" style="width:25px;height:25px;" />
                                            <span class="font-weight-bold" style="font-weight:bold !important">&nbsp;&nbsp;Hết hiệu lực</span>
                                        </span>
                                    </div>

                                    <div class="input-group-prepend" style="padding-top:27px;padding-left:10px;">
                                        <div class="form-group">
                                            <button type="button" class="btn btn-outline-warning font-weight-bold btn-add-store"><i class="la la-plus-circle"></i>Cửa hàng</button>
                                        </div>
                                    </div>

                                    <div class="input-group-prepend" style="padding-top:27px;padding-left:10px;">
                                        <div class="form-group">
                                            <button type="button" class="btn btn-success font-weight-bold btn-add-group-code" id="btn-add-group-code"><i class="la la-plus-circle"></i>Thêm nhóm</button>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:5px;margin-top:5px"></div>

                            <!-- Table: SpecialComboLine -->
                            <div class="card-body">
                                <div class="card-body-custom" id="main-div-group-code"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="float:right">
                    <button type="button" class="btn btn-outline-primary font-weight-bold btn-save-special-combo" id="btn-save-special-combo"><i class="fa fa-save"></i>Lưu</button>
                </div>

            </div>
        </div>
    </div>
</div>


<!-- Update Special Combo-->

