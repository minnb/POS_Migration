<script>
    window.IsLoadPage = false;
    window.IsResetting = false;

    $(document).ready(function () {

        LoadFromSession('@groupByID');
    });

    function SaveToSessionGroupGet() {
        debugger
        let groupCode = $("#txtGetGroupCode").val();
        let groupName = $("#txtGetGroupName").val();

        let items = [];

        $('#tblItemGetGroup tbody tr._rowGet').each(function () {
            let itemNo = $(this).find('.slItemGet').val();
            let uom = $(this).find('.slUomGet').val();
            let itemText = $(this).find('.slItemGet option:selected').text();
            let uomText = $(this).find('.slUomGet option:selected').text();

           // if (!itemNo) return;
            if (itemNo && uom) {
                items.push({
                    itemNo: itemNo, // Đồng nhất tên key
                    uom: uom,
                    itemText: itemText,
                    uomText: uomText
                });
            }
        });

        // ===== lấy data cũ =====
        let str = sessionStorage.getItem("promo_get_groups");
        let groups = str ? JSON.parse(str) : [];

        let index = groups.findIndex(x => x.groupID == '@groupByID');

        let groupData = {
            groupID: '@groupByID',
            groupCode: groupCode,
            groupName: groupName,
            items: items
        };

        if (index >= 0) {
            groups[index] = groupData;
        } else {
            groups.push(groupData);
        }

        sessionStorage.setItem("promo_get_groups", JSON.stringify(groups));
        //check neu da ton tai item trogn group thi k duoc chuyen LineType vè Item
        if (items.length > 0) {
            $("#LineTypeGet_"+@groupByID).prop("disabled", true);
        } else {
            $("#LineTypeGet_" + @groupByID).prop("disabled",false);
        }

    }
    function LoadFromSession(groupID) {
        debugger
        let str = sessionStorage.getItem("promo_get_groups");
        if (!str) return;

        let groups = JSON.parse(str);

        let group = groups.find(x => x.groupID == groupID);
        if (!group) return;
        if ('@groupByCode' === "") {
            $("#txtGetGroupCode").val(group.groupCode);
        } else {
            $("#txtGetGroupCode").val('@groupByCode');
        }

        $("#txtGetGroupName").val(group.groupName);

        renderBuyGroupGrid(group.items);

    }

    function renderBuyGroupGrid(items) {
        debugger
        var table = $("#tblItemGetGroup tbody");
        table.empty();
        if (!items || !Array.isArray(items)) return;

        window.IsLoadPage = true;

        items.forEach(function (item, index) {
            let newIndex = index + 1;

            // Gọi hàm Append dòng của bạn (nhớ truyền tham số nếu cần)
            // Ở đây mình minh họa logic append:

            var html = `
            <tr class="text-center _rowGet rowGetSelect_${newIndex}" id="rowBuy_${newIndex}" data-lineno="${newIndex}">
                <td class="stt-column text-center" style="vertical-align:middle">${newIndex}</td>
                <td style="min-width:250px;vertical-align:middle">
                    <select class="form-control select2 slItemGet slchangeItem_${newIndex}" data-stt="${newIndex}" data-ItemNo="${item.itemNo}">
                       <option selected value="${item.itemNo}">${item.itemText}</option>
                    </select>
                </td>
                <td style="vertical-align:middle;text-align:center;">
                    <select class="form-control select2 slUomGet slchangeUomBuy_${newIndex}" data-stt="${newIndex}" data-UOM="${item.uom}" style="width:100%">
                        <option selected value="${item.uom}">${item.uomText}</option>
                    </select>
                </td>
                <td class="text-center" style="vertical-align:middle">
                    <span>
                        <a title="Xóa" class="btn btn-icon btn-light-danger removeItemGet" data-stt="${newIndex}">
                            <i class="la la-close"></i>
                        </a>
                    </span>
                </td>
            </tr>`;

           // var html = getRowHtml(newIndex, item);
            table.append(html);

            // QUAN TRỌNG: Khởi tạo lại Select2 và set giá trị
            if (typeof initRowGroupGet === "function") {

                initRowGroupGet(newIndex);
            }
            $(`.slItemGet[data-stt="${newIndex}"]`).val(item.itemNo).trigger('change');
            $(`.slUomGet[data-stt="${newIndex}"]`).val(item.uom).trigger('change');
            /*
            let itemSelect = $(`.slItemGet[data-stt="${newIndex}"]`);
            let itemOption = new Option(item.itemText, item.itemNo, true, true);
            itemSelect.append(itemOption).trigger('change');

            // ===== FIX SELECT UOM =====
            let uomSelect = $(`.slUomGet[data-stt="${newIndex}"]`);
            let uomOption = new Option(item.uomText, item.uom, true, true);
            uomSelect.append(uomOption).trigger('change');
            */
        });

        window.IsLoadPage = false;
    }

    function ClearGroupSession(groupID) {
        let str = sessionStorage.getItem("promo_get_groups");
        if (!str) return;

        let groups = JSON.parse(str);

        groups = groups.filter(x => x.groupID != groupID);

        sessionStorage.setItem("promo_get_groups", JSON.stringify(groups));
    }
    ///////////////////////////////////////////////////////////////////////////////////////////////////

    function  getMaxLineNoGroupGet() {
        // Lấy dòng cuối cùng có class _rowGet
        let lastRow = $("#tblItemGetGroup tbody tr._rowGet").last();
        if (lastRow.length > 0) {
            return parseInt(lastRow.data('lineno')) || 0;
        }
        return 0;
    }

    $("#btnCancle").click(function () {
        if (confirm("Bạn có chắc muốn xóa dữ liệu ?")) {
            $('#tblItemGetGroup tbody').empty(); // Dùng empty() sạch hơn remove() tr
            ClearGroupSession('@groupByID');
            $("#LineTypeGet_" + '@groupByID').prop("disabled",false);
            // Có thể cần reset cả txtGetGroupCode và txtGetGroupName
           // $("#txtGetGroupCode, #txtGetGroupName").val('');
        }
    });


    $(document).off("click", "#btnAddRowGroupGet").on("click", "#btnAddRowGroupGet", function () {
         console.log("CLICK ADD ROW");

        var groupCode = $("#txtGetGroupCode").val();
        var groupName = $("#txtGetGroupName").val();

        // var listItem = $("#txtListBuyItem").val();

        if (groupCode == "") {
            toastr.error("Vui lòng nhập group code");
            $("#txtGetGroupCode").focus();
            return;
        }
        if (groupName == "") {
            toastr.error("Vui lòng nhập group name");
            $("#txtGetGroupName").focus();
            return;
        }
        var filter = /^([a-zA-Z\-0-9_]+)$/;
        if (!filter.test(groupCode)) {
            toastr.error("Mã nhóm không có ký tự đăc biệt, không khoảng trắng hoặc không có dấu tiếng việt");
            $("#txtGetGroupCode").focus();
            return;
        }
        //////////////////////////////////////////////////////////
        //set lai code o form cha
        var groupID = '@groupByID';
        $(`#codeBuy_${groupID}`).val(groupCode);
        //////////////////////////////////////////////////////////
        var table = $("#tblItemGetGroup tbody");

        var a = $("#txt-Qty-Row-Get").val();
        let iRowToAdd = parseInt(a, 10) || 0;
        loading.showloading();
        // Luôn lấy số lượng dòng thực tế tại thời điểm click
        //var currentRows = table.find("tr._rowGet").length;
        var currentRows =  getMaxLineNoGroupGet();

        var html = '';
        for (let i = 1; i <= iRowToAdd; i++) {
            // newIndex sẽ nối tiếp số dòng đang có
            let newIndex = currentRows + i;

            html += `
            <tr class="text-center _rowGet rowGetSelect_${newIndex}" id="rowBuy_${newIndex}" data-lineno="${newIndex}">
                <td class="stt-column text-center" style="vertical-align:middle">${newIndex}</td>
                <td style="min-width:250px;vertical-align:middle">
                    <select class="form-control select2 slItemGet slchangeItem_${newIndex}" data-stt="${newIndex}">
                        <option value="">Chọn sản phẩm</option>
                    </select>
                </td>
                <td style="vertical-align:middle;text-align:center;">
                    <select class="form-control select2 slUomGet slchangeUomBuy_${newIndex}" data-stt="${newIndex}" style="width:100%">
                        <option value="">Chọn UOM</option>
                    </select>
                </td>
                <td class="text-center" style="vertical-align:middle">
                    <span>
                        <a title="Xóa" class="btn btn-icon btn-light-danger removeItemGet" data-stt="${newIndex}">
                            <i class="la la-close"></i>
                        </a>
                    </span>
                </td>
            </tr>`;

            //var html = getRowHtml(newIndex, item);
           // table.append(html);
        }

        table.append(html);

        // Khởi tạo Select2 và các logic cho từng dòng mới
        for (let i = 1; i <= iRowToAdd; i++) {
            let targetIndex = currentRows + i;
            if (typeof initRowGroupGet === "function") {
                initRowGroupGet(targetIndex);
            }
        }

        // Cập nhật lại STT một lần nữa cho chắc chắn
        reIndexGroupTableGet();

        loading.hideloading();
    });
    /*
    $(document).on("keydown", function (e) {
        if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === "a") {
            e.preventDefault();
            $("#btnAddRowGroupGet").click();ss
        }
    });
    */
    // Hàm quan trọng: Đánh lại số thứ tự để không bao giờ bị nhảy số
    function reIndexGroupTableGet() {
        $("#tblItemGetGroup tbody tr._rowGet").each(function (index) {
            let realIndex = index + 1;
            $(this).find(".stt-column").text(realIndex); // Cập nhật hiển thị
            //$(this).attr("data-lineno", realIndex);     // Cập nhật attribute
        });
    }

    function initRowGroupGet(stt) {
        var row = $(".rowGetSelect_" + stt);

        row.find('.slUomGet').select2({
            placeholder: "Chọn UOM",
            width: '100%'
        });


        row.find('.slItemGet').select2({
            placeholder: "Chọn sản phẩm",

            minimumInputLength: 1,

            language: {
                searching: function () {
                    return "Đang tải dữ liệu...";
                },
                noResults: function () {
                    return "Không tìm thấy dữ liệu";
                }
            },

            ajax: {

                url: '/SetupPrice/SearchItem',

                type: 'POST',

                dataType: 'json',

                delay: 250,

                data: function (params) {

                    return {
                        keyword: params.term,
                        page: params.page || 1
                    };

                },

                processResults: function (data, params) {
                    //console.log(data);
                    params.page = params.page || 1;

                    var more = (params.page * data.pageSize) < data.total;

                    if (!more) {

                        setTimeout(function () {
                            $(".select2-results__options")
                                .append('<li class="select2-results__option text-center" style="color:#999">--- Đã hết dữ liệu ---</li>');
                        }, 100);

                    }

                    return {
                        results: data.items,
                        pagination: {
                            more: more
                        }
                    };

                },

                cache: true
            }

        });


        row.find(".slItemGet").on("select2:select", function (e) {
            var data = e.params.data;
            var selectuom = row.find(".slUomGet");

            selectuom.empty();

            if (data.uom) {
                // Giả sử data.uom trả về chuỗi "Cái, Thùng, Hộp"
                var uomList = data.uom.split(",").map(item => item.trim());

                uomList.forEach((iuom, i) => {
                    var isSelected = (i === 0);
                    var option = new Option(iuom, iuom, isSelected, isSelected);
                    selectuom.append(option);
                });

                selectuom.trigger('change');

                debounceSaveGroupGet();
            }
        });


        row.find(".removeItemGet").on("click", function () {
            debugger
           // var stt = $(this).attr("data-stt");
           // $(".rowGetSelect_" + stt).remove();
            $(this).closest('tr').remove();
            reIndexGroupTableGet();
            //update lai sessionStorage
            //neu remove dong co data moi save lai
            let currentRow = $(this).closest('tr');
            let itemNo = currentRow.find('.slItemGet').val();
            if (itemNo) {
                debounceSaveGroupGet();
            }

        });

    }

    function checkFinalDuplicateGroupGet() {
        let seen = new Set();
        let hasDuplicate = false;

        $('._rowGet').each(function () {
            let itemNo = $(this).find('.slItemGet').val();
            let uom = $(this).find('.slUomGet').val();
            let combinedKey = itemNo + '-' + uom;

            if (seen.has(combinedKey)) {
                hasDuplicate = true;
                $(this).css('background-color', '#ffe6e6'); // Tô đỏ dòng trùng
            } else {
                seen.add(combinedKey);
                $(this).css('background-color', 'transparent');
            }
        });

        return hasDuplicate;
    }
    $("#btnSaveGetGroup").on("click", function () {
        var checkDupBuy = checkFinalDuplicateGroupGet();
        if (checkDupBuy === false) {
            SaveGroupBuyItem();
        }

    });
    function SaveGroupBuyItem() {

        var groupCode = $("#txtGetGroupCode").val();
        var groupName = $("#txtGetGroupName").val();

        // var listItem = $("#txtListBuyItem").val();

        if (groupCode == "") {
            toastr.error("Vui lòng nhập group code");
            return;
        }
        if (groupName == "") {
            toastr.error("Vui lòng nhập group name");
            return;
        }
        /////////////////////////////////////////////////////////////////////////////////
        var isStepValid = true; // Biến kiểm tra hợp lệ

        $('#tblItemGetGroup tbody tr._rowGet').each(function (index) {
           // console.log(index);
            // Lấy giá trị từ các select (Nên dùng class để chính xác hơn nth-child)
            var itemNo = $(this).find('.slItemGet').val(); // Hoặc dùng td:nth-child(2) tùy cấu trúc của bạn
            var uom = $(this).find('.slUomGet').val();     // Hoặc dùng td:nth-child(3)

            if (!itemNo || itemNo === "" || !uom || uom === "") {
                var rowOrder = index + 1; // Số thứ tự dòng để báo lỗi cho chuẩn
                // Hiển thị thông báo (Sử dụng Alert hoặc Toastr/Swal nếu có)
                alert("Vui lòng chọn đầy đủ Sản phẩm và Đơn vị tính tại dòng số " + rowOrder);

                $(this).addClass("table-danger"); // (Tùy chọn) Tô đỏ dòng lỗi để người dùng dễ thấy

                isStepValid = false;
                return false; // Thoát vòng lặp each ngay lập tức
            } else {
                $(this).removeClass("table-danger");
            }
        });
        /////////////////////////////////////////////////////////////////////////////////
        if (!isStepValid) {
            return; // Dừng hàm Lưu, không cho chạy tiếp xuống Ajax
        }

        var filter = /^([a-zA-Z\-0-9_]+)$/;
        if (!filter.test(groupCode)) {
            toastr.error("Mã nhóm không có ký tự đăc biệt, không khoảng trắng hoặc không có dấu tiếng việt");
            return;
        }

        debounceSaveGroupGet();
    }
    $("#tblItemGetGroup").off('change', '.slItemGet, .slUomGet')
        .on('change', '.slItemGet, .slUomGet', function () {

            if (window.IsLoadPage || window.IsResetting) return;

            let currentRow = $(this).closest('tr');
            let currentIndex = currentRow.data('lineno');

            let itemNo = currentRow.find('.slItemGet').val();
            let uom = currentRow.find('.slUomGet').val();

            if (!itemNo || !uom) return;

            let isDuplicate = false;

            $('._rowGet').each(function () {
                let rowId = $(this).data('lineno');

                if (rowId != currentIndex) {
                    let otherItemNo = $(this).find('.slItemGet').val();
                    let otherUom = $(this).find('.slUomGet').val();

                    if (itemNo === otherItemNo && uom === otherUom) {
                        isDuplicate = true;
                        return false;
                    }
                }
            });

            if (isDuplicate) {
                toastr.error("Sản phẩm và Đơn vị tính này đã được nhập ở dòng khác!");

                window.IsResetting = true;

                currentRow.find('.slItemGet').val(null).trigger('change.select2');
                currentRow.find('.slUomGet').val(null).trigger('change.select2');

                setTimeout(() => {
                    window.IsResetting = false;
                }, 100);
                return;
            }
            debounceSaveGroupGet();
        });

    ////////////////////////////////////////////////
    window.saveTimeout = window.saveTimeout || null;

    function debounceSaveGroupGet() {

        clearTimeout(saveTimeout);
        window.saveTimeout  = setTimeout(() => {
            SaveToSessionGroupGet();
        }, 200);
    }
</script>