<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <input type="text" id="viewOfferNo" class="form-control eventChangeOffer" placeholder="Mã CTKM" />
    </div>

    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <input type="text" id="viewOfferName" class="form-control eventChangeOffer" placeholder="Tên CTKM" />
    </div>
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <select class="form-control select2 eventChangeOffer" style="width:100%;" id="slApprove" name="Approve">
            <option value="">Tất cả</option>
            <option value="1">Đã duyệt</option>
            <option value="0">Chưa duyệt</option>
        </select>
    </div>

</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="tblOfferHeader" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>Mã CTKM</th>
                    <th>Tên CTKM</th>
                    <th>Loại CTKM</th>
                    <th>Duyệt</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<script type="text/javascript">
    $(".select2").select2();
    var tableOffer = "";
    $(document).ready(function () {

        $(".eventChangeOffer").on("change", function () {
            tableOffer.draw();
        });
        tableOffer = $('#tblOfferHeader').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false, // for show progress bar
            serverSide: true, // for process server side
            filter: true, // this is for disable filter (search box)
            orderMulti: false, // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 8,
            searching: false,
            lengthChange: false,
            ajax: {
                url: '@Url.Action("ListOfferHeaderLoad", "SetupPromotion")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.OfferNo = $("#viewOfferNo").val();
                    d.OfferName = $("#viewOfferName").val();
                    d.Approve = $("#slApprove").val();
                }
            },
            drawCallback: function (settings) {
                $(".chkOffer").click(function () {
                    //var itemOffer = {};
                    var offerNo = $(this).attr("data-offerno");
                    //itemOffer["OfferNo"] = offerNo;

                    $("#txtMaCTKM").val(offerNo);
                    $('#chkPromotion').prop('checked', true);
                    $('#txtMaCTKM').prop('readonly', false);
                    $("#slOfferType").prop("disabled", true);
                    $("#displayBtnFinish").css("display", "block");

                    $('#modalListOfferHeader').modal('hide');

                    GetOfferHeader(offerNo);
                    $("#offHeader-tab").trigger("click");
                });
            },
            columns: [
                {
                    data: "No",
                    "className": "text-center",
                    "render": function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "No",
                    className: 'text-center'
                },
                {
                    data: "Description"
                },
                {
                    data: "OfferType",
                    "className": "text-center",

                },
                {
                    data: "IsApprove",
                    render: function (data, type, full, meta) {

                        var html = "";
                        if (full.IsApprove == true) {
                            html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đã duyệt</span>";
                        }
                        else {
                            html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Chưa duyệt</span>";
                        }


                        return html;
                    },
                    className: 'text-center'
                },
                {
                    data: "No",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<label class=\"radio radio-lg radio-rounded\">";
                        html += "<input type=\"radio\"  class=\"chkOffer\" data-offerno=" + full.No + " name=\"chkOffer\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });
</script>

