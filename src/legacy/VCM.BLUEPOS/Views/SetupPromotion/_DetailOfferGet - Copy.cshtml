@using VCM.BLUEPOS.Model.SetupPromotion
@{
    var data = Model.GetOfferGet as List<OfferGetModel>;
    var comboLineType = ComboboxModel.ComboLineType();
    var comboScaleType = ComboboxModel.ComboScaleType();
    var comboDiscountType = ComboboxModel.ComboDiscountType();

    var model = Model as GetBBModel;
    var offerHeader = model.GetOfferHearder;
    var offerNo = model.OfferNo;
    var offerType = model.OfferType;
    var isTotalBill = model.IsTotalBill;
    var isSetupGet = model.IsSetupGet;
    var totalBill = isTotalBill == true ? (data != null && data.Count > 0 ? data.FirstOrDefault().Step : 0) : 0;

    List<string> listGetLink = new List<string>(new string[] { "AND", "OR" });
    var getLinkCat = offerHeader.GetLinkCat == "O" ? "OR" : "AND";
    var checkDiscount = offerHeader.CheckDiscount == "1" ? "checked" : "";
    var discountType = offerHeader.DiscountType == "%" ? "0" : offerHeader.DiscountType == "R" ? "1" : "2";
    var discountValue = string.Format("{0:###,###}", offerHeader.DiscountValue);

    var displayButton = offerHeader.CheckDiscount == "1" ? "display:none" : "display:block";
    var displayTable = offerHeader.CheckDiscount == "1" ? "display:inline-table" : "display:none";
    var uomDiscount = offerHeader.DiscountType == "%" ? "%" : "VNĐ";

}
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="form-group row">
            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                <div class="row">
                    <label class="col-form-label col-6 text-left font-weight-bold">Điều kiện áp dụng</label>
                    <div class="col-6">
                        <select class="form-control select2 changeEventDiscount" style="width:100%;" id="slDKApDungGet">
                            @{
                                foreach (var item in listGetLink)
                                {
                                    var selected = item == getLinkCat ? "selected" : "";
                                    <option value="@item" @selected>@item</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                <div class="row">
                    <div class="col-12">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <label class="checkbox checkbox-inline" title="Giảm giá tổng bill">
                                        <input type="checkbox" id="chkDiscountBill" @checkDiscount class="chkDiscountBill" data-toggle="popover" data-trigger="click" />
                                        <span></span>
                                    </label>
                                </span>
                            </div>
                            <div class="input-group-append chkDiscountBill"><span class="input-group-text">Giảm giá tổng bill</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-4">
                <button type="button" class="btn btn-primary font-weight-bold" id="btnAppendTableGet" onclick="AppendGetTable()" style="@displayButton"><i class="la la-plus-circle"></i> Thêm sản phẩm khuyến mãi</button>

                <table id="tableDiscount" class="table table-bordered text-nowrap" style="position:absolute; z-index:1000;background-color:#cfc8c8;width:70%;@displayTable">
                    <tr style="background-color:#f77ce6;color:#FFFFFF;font-weight:bold">
                        <td colspan="2">Giảm giá tổng bill</td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle">Loại khuyến mãi</td>
                        <td style="vertical-align:middle">
                            <select class="form-control select2 changeEventDiscount" id="slTypeDiscount" style="z-index:1200">
                                @foreach (var loai in comboDiscountType)
                                {
                                    var selected = loai.value == discountType ? "selected" : "";
                                    <option value="@loai.value" @selected data-uom="@loai.UOM">@loai.Display</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td style="vertical-align:middle">Giá trị khuyến mãi</td>
                        <td style="vertical-align:middle"><input type="text" id="txtDiscountValue" value="@discountValue" class="form-control money changeEventDiscount" /></td>
                    </tr>

                    <tr>
                        <td style="vertical-align:middle">ĐVT</td>
                        <td style="vertical-align:middle"><span id="uomDiscountType">@uomDiscount</span></td>
                    </tr>

                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card-body table-responsive">

            <table class="table table-bordered text-nowrap" id="tableOfferGet">
                <thead>
                    <tr class="text-center">
                        <th>Loại</th>
                        <th>Mã</th>
                        <th>Mô tả</th>
                        <th>Đơn vị tính</th>
                        <th>Số lượng</th>
                        <th>Điều kiện áp dụng</th>
                        <th>Loại khuyến mãi</th>
                        <th>Giá trị</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody id="deleteAllTr">
                    @if (data != null && data.Count > 0)
                    {
                        foreach (var item in data)
                        {
                            var tagTr = $"trGet_{item.OfferNo}_{item.LineNo}";
                            var clssItem = $"itemGet_{item.OfferNo}_{item.LineNo}";
                            var clssHiddenItem = $"itemHiddenGet_{item.OfferNo}_{item.LineNo}";
                            var clssDesc = $"descGet_{item.OfferNo}_{item.LineNo}";
                            var clssUOM = $"uomGet_{item.OfferNo}_{item.LineNo}";
                            var clssLineType = $"selectLineTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssDiscountType = $"selectDiscountTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssDiscountValue = $"txtDiscountValueGet_{item.OfferNo}_{item.LineNo}";
                            var clssScaleType = $"selectScaleTypeGet_{item.OfferNo}_{item.LineNo}";
                            var clssQuantity = $"txtQuantityGet_{item.OfferNo}_{item.LineNo}";
                            var spanHtml = $"spanActionGet_{item.OfferNo}_{item.LineNo}";
                            var placeHolder = item.LineType == 1 ? "groupCode" : "itemNo";
                            var disableLineType = !string.IsNullOrEmpty(item.No) ? "disabled" : "";
                            var classHiddenLineType = $"hiddenLineTypeGet_{item.OfferNo}_{item.LineNo}";
                            <tr id="@tagTr">
                                <td style="width:100px;vertical-align:middle">
                                    <input type="hidden" class="form-control @classHiddenLineType" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@item.LineType" />
                                    <select @disableLineType class="form-control eventGetGrid select2 @clssLineType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboLineType)
                                        {
                                            var selected = loai.value == "" + item.LineType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="min-width:150px;vertical-align:middle">
                                    <input type="hidden" class="form-control @clssHiddenItem"
                                           data-offerno="@item.OfferNo"
                                           data-lineno="@item.LineNo"
                                           data-linetype="@item.LineType"
                                           data-groupcode="@item.BonusBuyNo" value="@item.No" />
                                    <div class="input-group">
                                        <input type="text" class="form-control @clssItem eventItemGetKeyPress"
                                               data-offerno="@item.OfferNo" data-lineno="@item.LineNo"
                                               data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo"
                                               placeholder="@placeHolder" name="No" value="@item.No" />
                                        <div class="input-group-append eventGetPopup" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo"><span class="input-group-text"><i class="flaticon2-search-1 icon-md"></i></span></div>
                                    </div>
                                </td>
                                <td style="vertical-align:middle">
                                    <span class="@clssDesc">@item.Description</span>
                                </td>

                                <td style="vertical-align:middle;text-align:center"><span class="@clssUOM">@item.UnitOfMeasure</span></td>
                                <td style="vertical-align:middle">
                                    <input type="text" style="width:70px" class="form-control eventGetGrid @clssQuantity money" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@string.Format("{0:###,###}", item.Quantity)" />
                                </td>

                                <td style="width:100px;vertical-align:middle">
                                    <select class="form-control select2 eventGetGrid @clssScaleType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboScaleType)
                                        {
                                            var selected = loai.value == "" + item.ScaleType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="width:100px;vertical-align:middle">
                                    <select class="form-control select2 eventGetGrid @clssDiscountType"
                                            data-offerno="@item.OfferNo"
                                            data-lineno="@item.LineNo"
                                            data-linetype="@item.LineType"
                                            data-groupcode="@item.BonusBuyNo">
                                        @foreach (var loai in comboDiscountType)
                                        {
                                            var selected = loai.value == "" + item.DiscountType ? "selected" : "";
                                            <option value="@loai.value" @selected>@loai.Display</option>
                                        }
                                    </select>
                                </td>
                                <td style="vertical-align:middle;text-align:center">
                                    <input type="text" style="width:100px" class="form-control money eventGetGrid money @clssDiscountValue" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-linetype="@item.LineType" data-groupcode="@item.BonusBuyNo" value="@string.Format("{0:###,###}", item.DiscountValue)" />
                                </td>
                                @*<td style="vertical-align:middle;text-align:center">@item.LineGroup</td>*@
                                <td style="vertical-align:middle;width:80px; text-align:center">
                                    <span class="@spanHtml">
                                        <a onclick="DeleteOfferGet('@item.OfferNo',@item.LineNo,'@item.No','false','true',@item.LineType,'@item.BonusBuyNo')" title="Xóa" class="btn btn-icon btn-light-danger" data-offerno="@item.OfferNo" data-lineno="@item.LineNo" data-no="@item.No"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<div class="modal fade" id="modalListItemSetupGet" tabindex="-1" role="dialog" aria-hidden="true">
    <div id="divPopupListItemGet"></div>
</div>

<script type="text/javascript">
    var offerNo = '@offerNo';
    var offerType = '@offerType';
    var isTotalBill = '@isTotalBill';
    var isSetupGet = '@isSetupGet';
     var totalBill = '@totalBill';
    $(document).ready(function () {

        $(".select2").select2();
        $('.money').mask('000,000,000', {
            placeholder: "0",
            reverse: true,
            rightAlign: true
        });

        $('.eventItemGetKeyPress').keydown(function (e) {
            var code = e.keyCode || e.which;
            debugger
            if (code === 9 || code == 13) {//Tab or Enter
                //e.preventDefault();
                var offerNo = $(this).attr("data-offerno");
                var lineNo = $(this).attr("data-lineno");
                var itemNo = $(this).val();
                var groupCode = $(this).attr("data-groupcode");
                var conditionGet = $("#slDKApDungGet").val();
                GetItemTabGet(offerNo, lineNo, itemNo, offerType, conditionGet, groupCode, isTotalBill, isSetupGet, totalBill);
            }
        });

        $(".eventGetGrid").on("change", function () {
            debugger
            var offerNo = $(this).attr("data-offerno");
            var lineNo = $(this).attr("data-lineno");
            var groupCode = $(this).attr("data-groupcode");
            var conditionGet = $("#slDKApDungGet").val();
            ParamOfferGet(offerNo, offerType, conditionGet, lineNo, groupCode, isTotalBill, isSetupGet, totalBill);

        });

        $(".eventGetPopup").on("click", function () {
            loading.showloading();
            debugger
            var offerNo = $(this).attr("data-offerno");
            var lineNo = $(this).attr("data-lineno");
            var lineType = $(this).attr("data-linetype");//0:Item,1:Group
            var groupCode = $(this).attr("data-groupcode");
            var conditionGet = $("#slDKApDungGet").val();
            if (lineType == 1) {
                var scaleType = $(".selectScaleTypeGet_" + offerNo + "_" + lineNo).val();
                var quantity = $(".txtQuantityGet_" + offerNo + "_" + lineNo).val();
                $.ajax({
                    type: "GET",
                    url: "/SetupPromotion/_ViewSetupGroupItemGet?groupCode=" + groupCode + "&offerNo=" + offerNo + "&offerType=" + offerType + "&condition=" + conditionGet + "&lineNo=" + lineNo + "&tabOffer=OfferGet&isTotalBill=" + isTotalBill + "&isSetupGet=" + isSetupGet + "&totalBill=" + totalBill + "&scaleType=" + scaleType + "&quantity=" + quantity + "",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        loading.hideloading();
                        $("#divPopupListItemGet").html(result);

                        $('#modalListItemSetupGet').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    },
                    error: function (event) {

                    }
                });

                loading.hideloading();
            }
            else {
                $.ajax({
                    type: "GET",
                    url: "/SetupPromotion/_ViewListItemGetSetup?offerNo=" + offerNo + "&offerType=" + offerType + "&conditionGet=" + conditionGet + "&lineNo=" + lineNo + "&tabOffer=OfferGet&isTotalBill=" + isTotalBill + "&isSetupGet=" + isSetupGet + "&totalBill=" + totalBill + "",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        $("#divPopupListItemGet").html(result);

                        $('#modalListItemSetupGet').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });
            }
        });

        $("#chkDiscountBill").on("change", function () {            

            var checkData = 0;
            $('#tableOfferGet > tbody > tr').each(function () {
                checkData++;
            });
            if (checkData > 0) {
                $.confirm({
                    backgroundDismiss: false,
                    escapeKey: true,
                    icon: 'fa fa-warning',
                    type: 'red',
                    typeAnimated: true,
                    title: 'Thông báo',
                    content: "Bạn có chắc chắn xóa danh sách sản phẩm khuyến mãi hay không?",
                    buttons: {
                        "CÓ": {
                            btnClass: 'btn btn-default',
                            keys: ['ctrl'],
                            action: function () {
                                var fromData = new FormData();
                                fromData.append('offerNo', offerNo);

                                $.ajax({
                                    type: "POST",
                                    url: '@Url.Action("DeleteOfferGetByOfferNo", "SetupPromotion")',
                                    data: fromData,
                                    contentType: "application/json",
                                    dataType: "json",
                                    contentType: false,
                                    processData: false,
                                    success: function (data) {
                                        if (data.Status == 200) {
                                            if ($("#chkDiscountBill").prop('checked')) {
                                                $('#btnAppendTableGet').css('display', "none");
                                                $('#tableDiscount').css('display', "inline-table");
                                                var uom = $("#slTypeDiscount").select2().find(":selected").data("uom");
                                                $("#uomDiscountType").html(uom);
                                            }
                                            else {
                                                $("#txtDiscountValue").val("0");
                                                $('#btnAppendTableGet').css('display', "block");
                                                $('#tableDiscount').css('display', "none");
                                            }
                                            $('#tableOfferGet tbody').empty();
                                            //$("#deleteAllTr").empty();
                                            UpdateHeaderGet();
                                        }
                                        else {
                                            toastr.error(data.Message);
                                        }

                                    },
                                    error: function () {
                                    }
                                });
                            }
                        },
                        "KHÔNG": {
                            btnClass: 'btn-default',
                            action: function () {
                                $("#offGet-tab").trigger("click");
                            }
                        }
                    }
                });

            }
            else {
                if ($("#chkDiscountBill").prop('checked')) {
                    $('#btnAppendTableGet').css('display', "none");
                    $('#tableDiscount').css('display', "inline-table");
                    var uom = $("#slTypeDiscount").select2().find(":selected").data("uom");
                    $("#uomDiscountType").html(uom);
                }
                else {
                    $("#txtDiscountValue").val("0");
                    $('#btnAppendTableGet').css('display', "block");
                    $('#tableDiscount').css('display', "none");
                }
                UpdateHeaderGet();
            }

           
        });
        $(".changeEventDiscount").on("change", function () {
            UpdateHeaderGet();
        });
    });

    function UpdateHeaderGet() {

        var uom = $("#slTypeDiscount").select2().find(":selected").data("uom");
            var typeDiscount = $("#slTypeDiscount").val();
            $("#uomDiscountType").html(uom);

            var conditionGet = $("#slDKApDungGet").val();
            var chkDiscount = "";
            var discountValue = "";

            if ($("#chkDiscountBill").prop('checked')) {
                chkDiscount = 1;
                discountValue = $("#txtDiscountValue").val().replace(/\,/g, '');
            }
            else {
                discountValue = "";
                typeDiscount = "";
                chkDiscount = "";
            }

            if (typeDiscount == "0" && discountValue > 100) {
                toastr.error("Vui lòng nhập giá trị không được lớn hơn 100");
            }
            else {

                var fromData = new FormData();
                fromData.append('OfferNo', offerNo);
                fromData.append('GetLinkCat', conditionGet);
                fromData.append('CheckDiscount', chkDiscount);
                fromData.append('TypeDiscount', typeDiscount);
                fromData.append('DiscountDiscount', discountValue);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SetupHeaderGet", "SetupPromotion")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.Status == 200) {

                        }
                        else {
                            toastr.error(data.Message);
                            $("#offGet-tab").trigger("click");
                        }

                    },
                    error: function () {
                    }
                });
            }

    }

    function DeleteOfferGet(offerNo, lineNo, itemNo, isTotalBill, isSetupGet, lineType, groupCode) {
        debugger
        var thongbao = lineType == 1 ? "Bạn có chắc chắn xóa group " + groupCode + " này không?" : "Bạn có chắc chắn xóa item " + itemNo + " này không?";
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: thongbao,
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            var fromData = new FormData();
                            fromData.append('offerNo', offerNo);
                            fromData.append('lineNo', lineNo);
                            fromData.append('isTotalBill', isTotalBill);
                            fromData.append('isSetupGet', isSetupGet);
                            fromData.append('LineType', lineType);
                            fromData.append('GroupCode', groupCode);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("DeleteOfferGet", "SetupPromotion")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    if (data.Status == 200) {
                                        debugger
                                        toastr.success("Xóa thành công");
                                        $("#trGet_" + offerNo + "_" + lineNo).remove();
                                    }
                                    else {
                                        toastr.error(data.Message);
                                        $("#offGet-tab").trigger("click");
                                    }

                                },
                                error: function () {
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });


        }
    function AppendGetTable() {
        debugger
        var conditionGet = $("#slDKApDungGet").val();

        loading.showloading();
        var fromData = new FormData();
        fromData.append('offerNo', offerNo);
        fromData.append('offerType', offerType);
        fromData.append('conditionGet', conditionGet);
        fromData.append('isTotalBill', isTotalBill);
        fromData.append('isSetupGet', isSetupGet);
        fromData.append('totalBill', totalBill);

        $.ajax({
            type: "POST",
            url: '@Url.Action("_AppendOfferGet", "SetupPromotion")',
            data: fromData,
            contentType: "application/json",
            dataType: "json",
            contentType: false,
            processData: false,
            success: function (result) {
                debugger
                if (result.Status == 200) {
                    var viewHtml = result.ViewPartial;
                    $("#tableOfferGet tbody").append(viewHtml);
                }
                else {
                    toastr.error(result.Message);
                    $("#offGet-tab").trigger("click");
                }

                loading.hideloading();
            },
            error: function () {
                loading.hideloading();
            }
        });
    }
</script>
