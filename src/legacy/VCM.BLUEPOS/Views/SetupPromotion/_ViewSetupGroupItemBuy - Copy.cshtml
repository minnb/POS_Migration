
@using VCM.BLUEPOS.Model.SetupPromotion;
@{

    var model = Model as ViewSetupGroupItemBuyModel;
    var offerNo = model.OfferNo;
    var lineNo = model.LineNo;
    var offerType = model.OfferType;
    var conditionBuy = model.Condition;
    var tabOffer = model.TabOffer;
    var isTotalBill = model.IsTotalBill;
    var isSetupGet = model.IsSetupGet;
    var groupCode = model.GroupCode;
    var scaleType = model.ScaleType;
    var quantity = model.Quantity;
    var listItem = model.ListItem;

}


<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="titleModalMenu">CÀI ĐẶT NHÓM SẢN PHẨM</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <i aria-hidden="true" class="ki ki-close"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">

                    <nav class="w-100">
                        <div class="nav nav-tabs" id="product-tab" role="tablist">
                            <a class="nav-item nav-link active" data-toggle="tab" href="#buyItemGroup-setup" role="tab" aria-controls="buyItemGroup-setup" aria-selected="false">Cài đặt item group</a>
                            <a class="nav-item nav-link" id="buyListItem" data-toggle="tab" href="#buyItemGroup-list" role="tab" aria-controls="buyItemGroup-list" aria-selected="true">Danh sách group</a>
                        </div>
                    </nav>
                    <div class="tab-content p-3" id="nav-tabContent" style="width:100%">

                        <div class="tab-pane fade show active" id="buyItemGroup-setup" role="tabpanel" aria-labelledby="buyItemGroup-setup">
                            <div class="row">
                                <div class="col-sm-12" style="width:100%">
                                    <div class="row">
                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Mã nhóm</label>
                                                <div class="input-group">
                                                    <input type="text" id="txtBuyGroupCode" class="form-control" placeholder="Nhập mã nhóm" />

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Tên nhóm</label>
                                                <div class="input-group">
                                                    <input type="text" id="txtBuyGroupName" class="form-control" placeholder="Nhập tên nhóm" />
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Sản phẩm</label>
                                                <select id="slItem" class="form-control" multiple="multiple">
                                                    @if (listItem != null && listItem.Count() > 0)
                                                    {
                                                        foreach (var item in listItem)
                                                        {
                                                            var display = $"{item.No} : {item.Description}";
                                                            <option value="@item.No">@display</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;"></div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold">Nhập danh sách sản phẩm</label>
                                                <textarea class="form-control" rows="12" placeholder="Nhập list item cách nhau dấu ; hoặc dấu , hoặc khoảng trắng (10078166;10000012 10000014,10000246....)" id="txtListBuyItem"></textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" style="text-align:right">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                            <div class="input-group text-right">
                                                <button type="button" class="btn btn-primary font-weight-bold" id="btnSaveBuyGroup"><i class="fa fa fa-save"></i> Lưu</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="buyItemGroup-list" role="tabpanel" aria-labelledby="buyItemGroup-list">
                            <div class="row">
                                <div class="col-sm-12" id="loadGroupBuyItem" style="width:100%">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

        </div>
    </div>
</div>

<script type="text/javascript">
    var offerNo = '@offerNo';
    var groupCodeOld = '@groupCode';
    var lineNo = '@lineNo';
    var tabOffer = '@tabOffer';
    var isTotalBill = '@isTotalBill';
    var isSetupGet = '@isSetupGet';
    var conditionBuy = '@conditionBuy';
    var offerType = '@offerType';
    var scaleType = '@scaleType';
    var quantity = '@quantity';

    $(document).ready(function () {
        $('#slItem').fSelect({
            placeholder: 'Chọn mã sản phẩm',
            numDisplayed: 1,
            overflowText: '{n} sản phẩm được chọn',
            searchText: 'Tìm kiếm....',
            noResultsText: 'Không tìm thấy sản phẩm',
            showSearch: true,
            optionFormatter: false,
            isSelectAll: true
        });


        LoadBuyGroupItem();
        $("#btnSaveBuyGroup").on("click", function () {
            SaveGroupBuyItem();
        });

        $("#buyListItem").on("click", function () {
            LoadBuyGroupItem();
        });

    });


    function LoadBuyGroupItem() {
        $.ajax({
            type: "GET",
            url: "/SetupPromotion/_ViewDataBuyGroupItem?groupCode=" + groupCodeOld + "&offerNo=" + offerNo + "&offerType=" + offerType + "&conditionBuy=" + conditionBuy + "&lineNo=" + lineNo + "&tabOffer=" + tabOffer + "&isTotalBill=" + isTotalBill + "&isSetupGet=" + isSetupGet + "&scaleType=" + scaleType + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#loadGroupBuyItem").html(result);
            },
            error: function (event) {

            }
        });
    }

    function SaveGroupBuyItem() {
        debugger
        //var listStore = $('#slStore').val() == "" ? "" : JSON.stringify($('#slStore').val());
        var groupCode = $("#txtBuyGroupCode").val();
        var groupName = $("#txtBuyGroupName").val();

       // var listItem = $("#txtListBuyItem").val();

        if (groupCode == "") {
            toastr.error("Vui lòng nhập group code");
            return;
        }
        if (groupName == "") {
            toastr.error("Vui lòng nhập group name");
            return;
        }

        var arrayItem = [];
        var isAllStore = $('.fs-label-wrap').attr('data-selectall');
        if (isAllStore == 1) {
            $("#txtListBuyItem").val('')
        }
        else {
            debugger
            isAllStore = 0;
            var listStoreArray = $('#slItem').val()
            var listStoreInArea = $("#txtListBuyItem").val();
            if (listStoreInArea == "") {
                $("#txtListBuyItem").val(listStoreArray.join(";"));
            }
            else {
                debugger
                // var arrayStore = [];
                $('.fs-option').removeClass('selected');
                $.each(listStoreInArea.split(/\;*\n*\b\,*\ */), function (i, e) {
                    debugger
                    $(".fs-option[data-value='" + e + "']").toggleClass('selected');
                    arrayItem.push(e);
                });

                $("#slItem").val(arrayItem);
                $("#slItem").fSelect('reloadDropdownLabel');
            }
        }

        var listItemFinal = $('#slItem').val() == "" ? "" : JSON.stringify($('#slItem').val());

        if (arrayItem.length > 0 && isAllStore == 0) {
            debugger
            listItemFinal = JSON.stringify(arrayItem);
        }

        if (listItemFinal == "" || listItemFinal == "[]") {
            toastr.error("Vui lòng chọn sản phẩm để thêm vào nhóm");
            return;
        }


        //if (listItem == "") {
        //    toastr.error("Vui lòng nhập danh sách item");
        //    return;
        //}

        var filter = /^([a-zA-Z\-0-9_]+)$/;
        if (!filter.test(groupCode)) {
            toastr.error("Mã nhóm không có ký tự đăc biệt, không khoảng trắng hoặc không có dấu tiếng việt");
            return;
        }

        loading.showloading();

        var fromData = new FormData();
        fromData.append('GroupCode', groupCode);
        fromData.append('GroupName', groupName);
        fromData.append('ListItem', listItemFinal);

        $.ajax({
            type: "POST",
            url: '@Url.Action("SetupBuyGroupItem", "SetupPromotion")',
            data: fromData,
            contentType: "application/json",
            dataType: "json",
            contentType: false,
            processData: false,
            success: function (data) {
                debugger
                if (data.Status == 200) {
                   // toastr.success(data.Message);

                    $("#txtBuyGroupCode").val("");
                    $("#txtBuyGroupName").val("");
                    $("#txtListBuyItem").val("");


                    var arrayGroupCode = [];
                    arrayGroupCode.push(groupCode);
                    var jsonGroupCode = JSON.stringify(arrayGroupCode);

                    InsertUpdateGroupItemOfferBuy(offerNo, offerType, conditionBuy, lineNo, 1, jsonGroupCode, groupCodeOld, quantity, scaleType, isTotalBill, isSetupGet);

                }
                else {
                    toastr.error(data.Message);
                }
                loading.hideloading();
            },
            error: function () {
                loading.hideloading();
            }
        });
    }

</script>