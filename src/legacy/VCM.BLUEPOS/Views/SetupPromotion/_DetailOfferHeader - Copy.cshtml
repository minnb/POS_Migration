@using VCM.BLUEPOS.Model.SetupPromotion
@{
    var data = Model.GetOfferHearder as OfferHeaderModel;
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table class="table table-bordered text-nowrap">
            <thead>
                <tr>
                    <th class="text-center">Mã CTKM</th>
                    <th class="text-center">Tên CTKM</th>
                    <th class="text-center">Loại CTKM</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Mon</th>
                    <th class="text-center">Tue</th>
                    <th class="text-center">Wed</th>
                    <th class="text-center">Thu</th>
                    <th class="text-center">Fri</th>
                    <th class="text-center">Sat</th>
                    <th class="text-center">Sun</th>
                </tr>
            </thead>
            <tbody>
                @if (data != null /*&& !string.IsNullOrEmpty(data.No)*/)
                {
                    <tr>
                        @{
                            var trangthai = data.Status == 0 ? "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Activated</span>" : data.Status == 1 ? "<span class=\"badge\" style=\"color: #fff;background-color:#007bff;\">Planned</span>" : data.Status == 2 ? "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Deactivated</span>" : "";

                        }
                        <td class="text-center">@data.No</td>
                        <td>@data.Description</td>
                        <td class="text-center">@data.OfferType</td>
                        <td class="text-center">@Html.Raw(trangthai)</td>
                        <td class="text-center">
                            @{ var checkMon = data.Mon == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkMon />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkTue = data.Tue == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkTue />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkWed = data.Wed == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkWed />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkThu = data.Thu == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkThu />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkFri = data.Fri == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkFri />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkSat = data.Sat == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkSat />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td class="text-center">
                            @{ var checkSun = data.Sun == 0 ? "" : "checked=checked";}
                            <div class="icheck-warning d-inline" style="margin-bottom:0 !important">
                                <label class="checkbox checkbox-lg">
                                    <input type="checkbox" disabled="disabled" @checkSun />
                                    <span></span>
                                </label>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

