@using VCM.BLUEPOS.Model.SetupPromotion
@{
    var groupCode = ViewBag.GroupCode;
}
<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="">DANH SÁCH SITE</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <i aria-hidden="true" class="ki ki-close"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <input type="text" id="viewStoreNo" class="form-control eventChangeStore" placeholder="storeNo" />
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <input type="text" id="viewStoreName" class="form-control eventChangeStore" placeholder="storeName" />
                    </div>
                   
                </div>

                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <table id="viewtblDataSite" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>STT</th>
                                    <th>STORE NO</th>
                                    <th>STORE NAME</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
        </div>
    </div>
</div>
<script type="text/javascript">
            var tableStoreSetup = "";
            var groupCode = '@groupCode';
            $(document).ready(function () {
                tableStoreSetup = $('#viewtblDataSite').DataTable({
                    dom: '<"top"iflp<"clear">>rt',
                    destroy: true,
                    paging: true,
                    pagingType: "simple_numbers",
                    responsive: true,
                    processing: false, // for show progress bar
                    serverSide: true, // for process server side
                    filter: true, // this is for disable filter (search box)
                    orderMulti: false, // for disable multiple column at once
                    autoWidth: true,
                    ordering: false,
                    displayLength: 10,
                    searching: false,
                    lengthChange: false,
                    ajax: {
                        url: 'SetupPromotion/LoadStoreSetup',
                        type: "POST",
                        datatype: "json",
                        data: function (d) {
                            d.SiteNo = $("#viewStoreNo").val();
                            d.SiteName = $("#viewStoreName").val();
                            d.GroupCode = groupCode;
                        }
                    },
                    columns: [
                        {
                            data: "SiteNo",
                            "className": "text-center",
                            "render": function (data, type, row, meta) {
                                var start = meta.settings._iDisplayStart;
                                return meta.row + 1 + start;
                            }
                        },
                        {
                            data: "SiteNo",
                            className: 'text-center'

                        },
                        {
                            data: "SiteName"

                        }
                    ]
                }).on('processing.dt', function (e, settings, processing) {

                    if (processing) {
                        loading.showloading();
                    } else {
                        loading.hideloading();
                    }

                });

                $(".backAgaint").on("click", function () {
                    LoadGroupSite();
                });
                $(".eventChangeStore").on("change", function () {
                    tableStoreSetup.draw();
                });
            });
</script>

