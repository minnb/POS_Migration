@using VCM.BLUEPOS.Model.SetupPromotion
@{
    var offerNo = ViewBag.OfferNo;
}
<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="">DANH SÁCH SITE GROUP</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <i aria-hidden="true" class="ki ki-close"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="card-body" id="divDataGroupSite">

            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
        </div>
    </div>
</div>
<script type="text/javascript">
    var offerNo = '@offerNo';
    $(document).ready(function () {
        LoadGroupSite(offerNo);
    }); 

    function LoadGroupSite(offerNo) {
        $.ajax({
            type: "GET",
            url: "/SetupPromotion/_ViewDataGroupSite?offerNo=" + offerNo+"",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#divDataGroupSite").html(result);
            },
            error: function (event) {

            }
        });
    }
</script>
