@section Scripts
{
    <script>
        var table_list_combo_header = "";

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode
            return !(charCode > 31 && (charCode < 48 || charCode > 57));
        }

        $('#chk-ismember-header').on('click', function (e) {
            var checked = $('#chk-ismember-header').prop('checked');
            if (checked == true) {
                $('#txt-member-code-header').val('');
                $('#txt-member-code-header').prop('disabled', false);
            }
            else {
                $('#txt-member-code-header').val('');
                $('#txt-member-code-header').prop('disabled', true);
            }
        });

        function LoadComboxItemByComboLine() {
            //debugger
            var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-item-no-combo-line" name="ItemNo">';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxItemByComboLine", "SetupPromotion")',
