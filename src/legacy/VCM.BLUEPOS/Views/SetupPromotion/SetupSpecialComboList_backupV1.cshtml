                error: function () {
                }
            });
        }

        function SaveComboHeader() {
            //debugger
            var code = $('#txt-code-header').val();
            var name = $('#txt-name-header').val();
            var salesType = $('#sel-sales-type-header').val();
            var fromDate = $('#txt-from-date').val();
            var toDate = $('#txt-to-date').val();
            var comboQuantity = $('#txt-combo-quantity-header').val();
            var amount = $('#txt-amount-header').val();
            var memberCode = $('#txt-member-code-header').val();
            var isMember = $('#chk-ismember-header').prop('checked');
            var isEnable = $('#chk-isenable-header').prop('checked');

            if (code == null || code == "") {
                toastr.error("Vui lòng nhập mã");
                return;
            }

            if (name == null || name == "") {
                toastr.error("Vui lòng nhập tên");
                return;
            }

            if (salesType == null || salesType == "") {
                toastr.error("Vui lòng nhập hình thức BH");
                return;
            }

            if (fromDate == null || fromDate == "") {
                toastr.error("Vui lòng nhập từ ngày");
                return;
            }

            if (toDate == null || toDate == "") {
                toastr.error("Vui lòng nhập đến ngày");
                return;
            }

            var _fromDate = getFromDate();
            var _toDate = getToDate();

            if (_fromDate > _toDate) {
                toastr.error('Từ ngày phải nhỏ hơn (hoặc) bằng đến ngày');
                return;
            }

            if (comboQuantity == null || comboQuantity == "") {
                toastr.error("Vui lòng nhập số lượng");
                return;
            }

            if (amount == null || amount == "") {
                toastr.error("Vui lòng nhập giá trị");
                return;
            }

            if (isMember == true) {
                isMember = 1;
                if (memberCode == null || memberCode == "") {
                    toastr.error("Vui lòng nhập mã thành viên");
                    return;
                }
            }
            else {
                isMember = 0;
            }

            if (isEnable == true) {
                isEnable = 1;
            }
            else {
                isEnable = 0;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("CreateSpecialComboHeader", "SetupPromotion")',
                type: "POST",
                dataType: "json",
                data: {
                    Code: code,
                    SalesType: salesType,
                    Name: name,
                    FromDate: _fromDate,
                    ToDate: _toDate,
                    Quantity: comboQuantity,
                    Amount: amount,
                    IsMember: isMember,
                    MemberCode: memberCode,
                    IsEnable: isEnable
                },
                success: function (data) {
                    //debugger
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        //$('#sel-store-no').val(data.Item1).trigger('change');
                        //$('#sel-e-wallet-type').val(data.Item2);
                        //$('#sel-status').val(data.Item3);
                        //$('#btn-search').trigger('click');
                        ///$('#modal-create-ewallet-list').modal("hide");
                    }
                    else if (data.Status == 2)
                    {
                        toastr.error(data.Message);
                    }
                    else if (data.Status == 3)
                    {
                        toastr.error(data.Message);
                        //$('#btn-save-create-ewallet').attr('disabled', true);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

