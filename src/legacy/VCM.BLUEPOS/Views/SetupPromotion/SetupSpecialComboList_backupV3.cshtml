        function CreateSpecialComboV2() {
            //debugger
            var code = $('#txt-combo-code').val();
            var name = $('#txt-combo-name').val();
            var salesType = $('#sel-sales-type').val();
            var fromDate = $('#txt-from-date').val();
            var toDate = $('#txt-to-date').val();
            var comboQuantity = $('#txt-combo-quantity-header').val();
            var amount = $('#txt-amount-header').val();
            //var memberCode = $('#txt-member-code-header').val();           
            var memberCode = $('#sel-member-code-type').val();
            var isMember = $('#chk-ismember-header').prop('checked');
            var isEnable = $('#chk-isenable-header').prop('checked');
            var channel = $('#sel-channel').val();
            var storeNo = $('#sel-store-no').val();
            var statusStore = $('#sel-status-store').val();

            var groupCode = $('#txt-group-code').val();
            var groupName = $('#txt-group-name').val();
            var itemNo = $('#sel-item-no').val();
            var itemName = "";
            var uom = $('#sel-uom').val();
            var minQuantity = $('#txt-min-quantity').val();
            var maxQuantity = $('#txt-max-quantity').val();
            var order = $('#txt-order').val();
            var isEnableLine = $('#chk-is-enable').prop('checked');
            var isSendSAP = $('#chk-is-send-sap').prop('checked');
            var priceType = $('#sel-item-type-by-price').val(); // Loại san pham theo gia

            if (name == null || name == "") {
                toastr.error("Nhập tên combo");
                return;
            }

            if (salesType == null || salesType == "") {
                toastr.error("Chọn hình thức bán hàng");
                return;
            }

            if (fromDate == null || fromDate == "") {
                toastr.error("Nhập từ ngày");
                return;
            }

            if (toDate == null || toDate == "") {
                toastr.error("Nhập đến ngày");
                return;
            }

            var _fromDate = getFromDate();
            var _toDate = getToDate();

            if (_fromDate > _toDate) {
                toastr.error('Từ ngày phải nhỏ hơn (hoặc) bằng đến ngày');
                return;
            }

            if (channel != "ALL" && (storeNo == null || storeNo == "")) {
                toastr.error('Chọn cửa hàng');
                return;
            }

            if (channel == "ALL") {
                storeNo = "ALL";
            }

            if (comboQuantity == null || comboQuantity == "") {
                toastr.error("Nhập số lượng");
                return;
            }

            if (amount == null || amount == "") {
                toastr.error("Nhập giá trị");
                return;
            }

            if (isMember == true) {
                isMember = 1;
                if (memberCode == null || memberCode == "") {
                    toastr.error("Chọn loại hạng thẻ");
                    return;
                }
            }
            else {
                isMember = 0;
            }

            if (isEnable == true) // Check box: Không có hiệu lực
            {
                isEnable = 0; 
            }
            else  // mặc định có hiệu lực
            {
                isEnable = 1;
            }

            var isDefault = 0;
            var isDynamicPrice = 0;

            if (priceType == "0") {
                isDefault = 1;
                isDynamicPrice = 0;
            }
            else if (priceType == "1") {
                isDefault = 0;
                isDynamicPrice = 0;
            }
            else if (priceType == "2") {
                isDefault = 1;
                isDynamicPrice = 1;
            }

            // Check list data
            var data = colectDataSpecialComboLine();
            if (data == null || data.length == 0) {
                toastr.error('Không có dữ liệu để lưu. Vui lòng kiểm tra lại');
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateSpecialComboV2", "SetupPromotion")',
                type: "POST",
                dataType: "json",
                data: {
                    Code: code,
                    SalesType: salesType,
                    StoreNo: storeNo,
                    StatusStore: statusStore,
                    Name: name,
                    FromDate: _fromDate,
                    ToDate: _toDate,
                    ComboQuantity: comboQuantity,
                    Amount: amount,
                    IsMember: isMember,
                    MemberCode: memberCode,
                    IsEnable: isEnable,
                    ListComboLine: JSON.stringify(data)  // SpecialComboLine
                },
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 200) // thanh cong
                    {
                        $('.btn-search').trigger('click');
                        toastr.success(data.Message);
                        ClearTextCreate();
                        //$("#main-div-group-code").val('');
                        $('#modal-add-combo-header').modal('hide');
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

