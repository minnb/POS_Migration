            var amount = $('#update-txt-amount-header').val();
            //var memberCode = $('#update-txt-member-code-header').val();
            var memberCode = $('#sel-update-member-code-type').val();
            var isMember = $('#update-chk-ismember-header').prop('checked');
            var isEnable = $('#update-chk-isenable-header').prop('checked');

            if (name == null || name == "") {
