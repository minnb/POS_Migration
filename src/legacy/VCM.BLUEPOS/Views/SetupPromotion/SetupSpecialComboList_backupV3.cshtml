            if (fromDate == null || fromDate == "") {
                toastr.error("Nhập từ ngày");
                return;
            }

            if (toDate == null || toDate == "") {
                toastr.error("Nhập đến ngày");
                return;
            }

            var _fromDate = getFromDate();
            var _toDate = getToDate();

            if (_fromDate > _toDate) {
                toastr.error('Từ ngày phải nhỏ hơn (hoặc) bằng đến ngày');
                return;
            }

            if (comboQuantity == null || comboQuantity == "") {
                toastr.error("Nhập số lượng");
                return;
            }

            if (amount == null || amount == "") {
                toastr.error("Nhập giá trị");
                return;
            }

            if (isMember == true) {
                isMember = 1;
                if (memberCode == null || memberCode == "") {
                    toastr.error("Chọn loại hạng thẻ");
                    return;
                }
            }
            else {
                isMember = 0;
            }

            if (isEnable == true) // Check box: Không có hiệu lực
            {
                isEnable = 0; 
            }
            else  // mặc định có hiệu lực
            {
                isEnable = 1;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateSpecialComboV2", "SetupPromotion")',
                type: "POST",
                dataType: "json",
                data: {
                    Code: code,
                    SalesType: salesType,
                    Name: name,
                    FromDate: _fromDate,
                    ToDate: _toDate,
                    ComboQuantity: comboQuantity,
                    Amount: amount,
                    IsMember: isMember,
                    MemberCode: memberCode,
                    IsEnable: isEnable
                },
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 200) // thanh cong
                    {
                        $('.btn-search').trigger('click');
                        toastr.success(data.Message);
                        //ClearTextCreate();
                        $('#modal-update-combo-header').modal('hide');
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function UpdateStatusComboHeader(code, status) {
            var fromData = new FormData();
            fromData.append('code', code);
            fromData.append('status', status);
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateStatusComboHeader", "SetupPromotion")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == 1) {
                        $('.btn-search').trigger('click');
                        toastr.success(data.Message);
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function () {
                }
            });
        }

