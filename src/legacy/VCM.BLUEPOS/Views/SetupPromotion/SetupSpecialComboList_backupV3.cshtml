                    item['GroupCode'] = GroupCode;
                    item['GroupName'] = GroupName;
                    item['MinimumQuantity'] = MinimumQuantity;
                    item['MaximumQuantity'] = MaximumQuantity;
                    item['Order'] = Order;

                    // Add Prodcut
                    item['ItemNo'] = $(this).find('.sel-item-no').val();
