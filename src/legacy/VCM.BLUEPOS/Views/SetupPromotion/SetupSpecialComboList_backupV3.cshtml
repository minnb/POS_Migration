                                        </div>
                                    </div>

                                    @*<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
            <label class="font-weight-bold" style="font-weight:bold !important">Hạng thẻ</label>
            <div class="form-group">
                <input type="text" class="form-control" id="txt-member-code-header" name="MemberCode" disabled />
            </div>
        </div>*@

                                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Hạng thẻ</label>

                                        @*<div class="form-group">
                <input type="text" class="form-control" id="txt-member-code-header" name="MemberCode" disabled />
            </div>*@

                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-member-code-type" name="MemberCodeType" disabled>
                                                @if (listMemberCode != null && listMemberCode.Count > 0)
