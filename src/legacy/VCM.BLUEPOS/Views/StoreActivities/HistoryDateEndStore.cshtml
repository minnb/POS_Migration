@using VCM.BLUEPOS.Model.StoreActivities;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{

    ViewBag.Title = "Lịch sử kết thúc ngày tại POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSet = (List<SQLServerModel>)ViewBag.SetDB;
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Hoạt động cửa hàng</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Lịch sử kết thúc ngày tại POS</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("HistoryDateEndStoreExcel", "StoreActivities", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-setDB" name="SetDB">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer" data-serverread="@listSet.FirstOrDefault().IPServerRead">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="POSTerminal"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngày kinh doanh<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-search-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-search-from-date" name="TuNgay" placeholder="Ngày kinh doanh">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Chưa đóng ngày</option>
                                            <option value="1">Đã đóng ngày</option>
                                        </select>
                                    </div>
                                </div>

                                <input type="hidden" id="sel-store-no-temp" name="StoreNoTemp" />
                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group" style="margin-top:25px;">
                                        <button type="button" class="btn btn-primary" style="" id="btn-search"><i class="fa fa-search"></i>Tìm kiếm</button>
                                        <button type="submit" class="btn btn-success" style="" id="btn-export-excel"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered table-hover text-nowrap" id="tbl-history-date-end-store">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>Máy POS</th>
                                    <th>Loại POS</th>
                                    <th>Trạng thái</th>
                                    <th>Lần bán hàng cuối cùng</th>
                                    <th>T/G mở ngày</th>
                                    <th>T/G kết thúc ngày</th>
                                    <th>Tiền bán ra</th>
                                    <th>Tiền mặt</th>
                                    <th>Số lượt khách hàng</th>
                                    <th>Số lượng bán</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {
    <script type="text/javascript">
        var table = "";

        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-search-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-search-from-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                }
            );

            LoadComboxStoreByServer($("#sel-setDB").val());
            $("#sel-setDB").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-setDB").val());
            });

            var storeNo = $(this).find(':selected').attr('data-storeNo');
            LoadComboxPOSTerminalByStore(storeNo);

            $("#sel-store-no").on("change", function (e) {
                var storeNo = $(this).find(':selected').attr('data-storeNo');
                LoadComboxPOSTerminalByStore(storeNo);
            });

            $("#btn-export-excel").submit(function (e) {
                //
                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                var url = "/StoreActivities/HistoryDateEndStoreExcel?" + $(this).serialize();
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "HistoryConfirmPOS" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });


            table = $('#tbl-history-date-end-store').DataTable({
                destroy: true,
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: true,
                scrollX: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("HistoryDateEndStoreLoad", "StoreActivities")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#sel-setDB").val();
                        d.ServerRead = $("#sel-setDB").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.BussinessDate = $("#txt-search-from-date").val();
                        d.Status = $("#sel-status").val();
                        d.TerminalID = $("#sel-pos-terminal").val();
                    }
                },

                columns: [
                    {
                        data: "TerminalID",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TerminalID == null || row.TerminalID == "") {
                                html += '<span style="font-weight:700; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700; display: block;">' + row.TerminalID + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "DocumentType",  // Loai POS
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.DocumentType == null || row.DocumentType == "") {
                                html += '<span style="font-weight:400; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; display: block;">' + row.DocumentType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsClosed == true)
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đã đóng ngày</span>";
                            else
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#FFA800;\">Chưa đóng ngày</span>";
                            return html;
                        }
                    },

                    {
                        data: "FormatLastOrderTime",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.FormatLastOrderTime == null || row.FormatLastOrderTime == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.FormatLastOrderTime + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "FormatCreatedDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.FormatCreatedDate == null || row.FormatCreatedDate == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.FormatCreatedDate + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "FormatCloseDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;">' + row.FormatCloseDate + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FormatAmountTotal",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;text-align:right;">' + row.FormatAmountTotal + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FormatCashMoney",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;text-align:right;">' + row.FormatCashMoney + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FormatCountCustomer",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;">' + row.FormatCountCustomer + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FormatCountOrderNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;">' + row.FormatCountOrderNo + '</span>';
                            return html;
                        }
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
                });

            $("#btn-search").on("click", function (e) {
                table.draw();
            });

        });

        //------------------------------------------------------------------------

        function LoadComboxStoreByServer(ipServer) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].ValueJson + "' data-storeNo='" + data[0].SiteNo + "'>" + data[0].DisplayCombo + "</option>";
                            $('#sel-store-no').html(html);
                            LoadComboxPOSTerminalByStore(data[0].SiteNo);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.ValueJson + "' data-storeNo='" + name.SiteNo + "'>" + name.DisplayCombo + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxPOSTerminalByStore(storeNo) {
            if (storeNo == null || storeNo == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-pos-terminal').html(html);
            }
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: { StoreNo: storeNo },
                dataType: "json",
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].PosID + "'>" + data[0].PosID + "</option>";
                            $('#sel-pos-terminal').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.PosID != "") {
                                    html += "<option value='" + name.PosID + "'>" + name.PosID + "</option>";
                                }
                            });
                            $('#sel-pos-terminal').html(html);
                        }                        
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });
        };

        function LoadDataConfirmDate(siteCode, businessDate, posID, status) {
            loading.showloading();
            $('#tbl-history-date-end-store tbody').empty();
            var fromData = new FormData();
            fromData.append('StoreNo', siteCode);
            fromData.append('BusinessDate', businessDate);
            fromData.append('POSID', posID);
            fromData.append('Status', status);
             $.ajax({
                type: "POST",
                url: '@Url.Action("LoadHistoryDateEndStore", "StoreActivities")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                 success: function (data) {
                     if (data != null) {
                         var html = "";
                         var totalTienBR = 0;
                         var totalTienMat = 0;
                         var totalSLK = 0;
                         var totalSLB = 0;
                         data.forEach((name, i) => {
                             html += "<tr id=\"\">";
                             html += "<td style=\"text-align:center\">" + name.TerminalID + "</td>";
                             if (name.IsClosed == 0) {
                                 html += "<td style=\"text-align:center\"><span class=\"badge bg-danger\">" + name.FormatIsClosed + "</span></td>";
                             }
                             else if (name.IsClosed == 1) {
                                 html += "<td style=\"text-align:center\"><span class=\"badge bg-success\">" + name.FormatIsClosed + "</span></td>";
                             }
                             else {
                                 html += "<td style=\"text-align:center\">" + name.FormatIsClosed + "</td>";
                             }

                             html += "<td style=\"text-align:center\">" + name.FormatLastOrderTime + "</td>";
                             html += "<td style=\"text-align:center\">" + name.FormatCreatedDate + "</td>";
                             html += "<td style=\"text-align:center\">" + name.FormatCloseDate + "</td>";
                             html += "<td style=\"text-align:right\">"  + name.FormatAmountTotal + "</td>";
                             html += "<td style=\"text-align:right\">"  + name.FormatCashMoney + "</td>";
                             html += "<td style=\"text-align:center\">" + name.FormatCountCustomer + "</td>";
                             html += "<td style=\"text-align:center\">" + name.FormatCountOrderNo + "</td>";

                             html += "</tr>";

                             totalTienBR += name.AmountTotal;
                             totalTienMat += name.CashMoney;
                             totalSLK += name.CountCustomer;
                             totalSLB += name.CountOrderNo;

                         });
                         html += "<tr style=\"font-weight:bold\">";
                         html += "<td colspan=5 style=\"text-align:center\">Total</td>";
                         html += "<td style=\"text-align:right\">" + parseFloat(totalTienBR).toLocaleString('en') + "</td>";
                         html += "<td style=\"text-align:right\">" + parseFloat(totalTienMat).toLocaleString('en') + "</td>";
                         html += "<td style=\"text-align:center\">" + parseFloat(totalSLK).toLocaleString('en') + "</td>";
                         html += "<td style=\"text-align:center\">" + parseFloat(totalSLB).toLocaleString('en') + "</td>";
                         html += "</tr>";
                         $("#tbl-history-date-end-store tbody").html(html);
                     }
                     else {
                     }
                     loading.hideloading();
                },
                 error: function () {
                     loading.hideloading();
                }
            });
        }


    </script>
}


