@using VCM.BLUEPOS.Model.StoreActivities;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "IT xác nhận kết thúc ngày";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSet = (List<SQLServerModel>)ViewBag.SetDB;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Hoạt động cửa hàng</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">IT xác nhận kết thúc ngày</a>
                    </li>
                </ul>
            </div>
        </div>  
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">    
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer"  data-serverread="@listSet.FirstOrDefault().IPServerRead">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer"  data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>
   
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngày kinh doanh<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="searchFromDate">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Ngày kinh doanh">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Chưa xác nhận ngày</option>
                                            <option value="1">Đã xác nhận ngày</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12" style="margin-top: 25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary" style="" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        <button type="button" class="btn btn-success" style="" id="btn-xac-nhan"><i class="fa fa-database"></i> Xác nhận</button>
                                        <button type="button" class="btn btn-danger" style="" id="btn-huy-xac-nhan"><i class="fas fa-trash"></i> Hủy xác nhận</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered" id="tbl-it-confirm-end-date">
                            <thead>
                                <tr style="text-align:center;text-transform:uppercase">
                                    <th><input type="checkbox" class="chkAll" id="chkAll" value="" style="height:20px;width:20px;"></th>
                                    <th>Ngày kinh doanh</th>
                                    <th>ST/CH</th>
                                    <th>Tổng tiền bán ra</th>
                                    <th>Tiền mặt</th>
                                    <th>Số tiền ngân hàng</th>
                                    <th>Xác nhận</th>
                                    <th>Người xác nhận</th>
                                    <th>Thời gian xác nhận</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        var table = "";        

        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) { 
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        };
         
        $("#btn-huy-xac-nhan").click(function () {
                var countStore = 0;
                var listStore = "";
                $('#tbl-it-confirm-end-date input.chkStore:checkbox:checked').each(function () {
                    //debugger
                    countStore++;
                    listStore += $(this).val() + ";";
                });

                if (countStore == 0) {
                    $.alert('Vui lòng chọn ST/CH để xác nhận', 'Thông báo');
                }
                else {
                    $.confirm({
                        backgroundDismiss: false,
                        escapeKey: true,
                        icon: 'fa fa-warning',
                        type: 'red',
                        typeAnimated: true,
                        title: 'Thông báo',
                        content: 'Bạn có chắc chắn HỦY xác nhận kết thúc ngày?',
                        buttons: {
                            "CÓ": {
                                btnClass: 'btn btn-default',
                                keys: ['ctrl'],
                                action: function () {
                                    ConfirmDateCancel(listStore);
                                }
                            },
                            "KHÔNG": {
                                btnClass: 'btn-default',
                                action: function () { }
                            }
                        }
                    });
                }
            });

            $("#btn-xac-nhan").click(function () {
                var countStore = 0;
                var listStore = "";
                $('#tbl-it-confirm-end-date input.chkStore:checkbox:checked').each(function () {
                    //debugger
                    countStore++;
                    listStore += $(this).val() + ";";
                });

                if (countStore == 0) {
                    $.alert('Vui lòng chọn ST/CH để xác nhận', 'Thông báo');
                }
                else {
                     $.confirm({
                        backgroundDismiss: false,
                        escapeKey: true,
                        icon: 'fa fa-warning',
                        type: 'red',
                        typeAnimated: true,
                        title: 'Thông báo',
                        content: 'Bạn có chắc chắn xác nhận kết thúc ngày?',
                        buttons: {
                            "CÓ": {
                                btnClass: 'btn btn-default',
                                keys: ['ctrl'],
                                action: function () {
                                    ConfirmDate(listStore);
                                }
                            },
                            "KHÔNG": {
                                btnClass: 'btn-default',
                                action: function () { }
                            }
                        }
                    });
                }
            });
       
        function ConfirmDate(listStore) {
            //debugger
            var dateBusiness = $("#searchFromDate").val();
            if (listStore == "" || listStore.lenght == 0) {
                $.alert('Vui lòng chọn ST/CH', 'Thông báo');
                return;
            }
            if (dateBusiness == "" || dateBusiness.lenght == 0) {
                $.alert('Vui lòng chọn ngày kinh doanh', 'Thông báo');
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('ArrayStore', listStore);
            fromData.append('BusinessDate', dateBusiness);
            $.ajax({
                type: "POST",
                url: '@Url.Action("ITConfirmDateEndListStore", "StoreActivities")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {   
                    if (data.Status == 1)
                    {
                        table.draw();
                        $('#chkAll').prop('checked', false);
                        $.alert(data.Message, 'Thông báo');
                    }
                    else
                    {
                        $.alert(data.Message, 'Thông báo');
                    }  
                    loading.hideloading(); 
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        // Huy xac nhan ket thuc ngay
        function ConfirmDateCancel(listStore) {
            //debugger
            var dateBusiness = $("#searchFromDate").val();
            if (listStore == "" || listStore.lenght == 0) {
                $.alert('Vui lòng chọn ST/CH', 'Thông báo');
                return;
            }
            if (dateBusiness == "" || dateBusiness.lenght == 0) {
                $.alert('Vui lòng chọn ngày kinh doanh', 'Thông báo');
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('ArrayStore', listStore);
            fromData.append('BusinessDate', dateBusiness);

            $.ajax({
                type: "POST",
                url: '@Url.Action("ITCancelConfirmDateEndListStore", "StoreActivities")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1) {
                        table.draw();
                        $('#chkAll').prop('checked', false);
                        $.alert(data.Message, 'Thông báo');
                    }
                    else {
                        $.alert(data.Message, 'Thông báo');
                    }
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function LoadHistory() {

            table = $('#tbl-it-confirm-end-date').DataTable({
                drawCallback: function (settings) {
                    $(".btn-search-detail").click(function () {
                        var storeNo = $(this).attr("data-storeNo");
                        var dateBussiness = $("#searchFromDate").val();
                        ViewDetail(storeNo, dateBussiness);
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          
                serverSide: true,            
                filter: true,                 
                orderMulti: false,             
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                deferLoading: 0,
                info: true,

                ajax: {
                    url: '@Url.Action("HistoryEndDate", "StoreActivities")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#sel-set-server").val();
                        d.ServerRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.BusinessDate = $("#searchFromDate").val();
                        d.IsConfirm = $("#sel-status").val();
                    }
                },

                columns: [
                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<input type="checkbox" class="chkStore" id="chkchkStore' + row.StoreNo + '" value="' + row.StoreNo + '" style="height:18px;width:18px;">';
                            return html;
                        }                      
                    },

                    {
                        data: "FormatBusinessDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;">' + row.FormatBusinessDate + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },

                    {
                        data: "AmountTotal",  // Tong tien ban ra
                        className: 'text-center',
                        render: function (data, type, row) {
                            var AmountTotal = row.AmountTotal;
                            var html = '<span style="font-weight:700; display: block;">' + parseFloat(AmountTotal).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CashMoney",  // Tien mat
                        className: 'text-center',
                        render: function (data, type, row) {
                            var CashMoney = row.CashMoney;
                            var html = '<span style="font-weight:700; display: block;">' + parseFloat(CashMoney).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AmountBank",  // Tien ngan hang
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.AmountBank > 0) {
                                var AmountBank = row.AmountBank;
                                html += '<span style="font-weight:700; display: block;">' + parseFloat(AmountBank).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsConfirm == true) {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đã xác nhận</span>";
                            }
                            else {
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#FFA800;\">Chưa xác nhận</span>";
                            }    
                            return html;
                        }
                    },

                    {
                        data: "CreatedUser",
                        className: 'text-center'
                    },

                    {
                        data: "FormatConfirmDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;">' + row.FormatConfirmDate + '</span>';
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var storeNo = row.StoreNo;
                            var html = '<button type="button"  class="btn btn-icon btn-light-primary btn-search-detail" data-toggle="tooltip" data-placement="left" title="Xem chi tiết" data-id="' + storeNo + '"  data-storeNo = "' + storeNo + '" style=\"height:30px;margin-top:3px;\"><i class="fa fa-list"></i></button>';
                            return html;
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            }).on('page.dt', function () {
                $('#chkAll').prop('checked', false);

            }).on('length.dt', function () {
                $('#chkAll').prop('checked', false);
            });
        }

        function ViewDetail(storeNo, businessDate) {
            var url = '/StoreActivities/DetailEndDate?storeNo=' + storeNo + '&businessDate=' + businessDate;
            window.open(url);
        }


        $(document).ready(function () {

            $('.select2').select2();
            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            LoadHistory();

            $("#btn-search").on("click", function (e) {
                table.draw();
                $('#chkAll').prop('checked', false);
            });

            $("#chkAll").click(function () {
                if ($("#chkAll").is(':checked')) {
                    $('.chkStore').prop('checked', true);
                }
                else {
                    $('.chkStore').prop('checked', false);
                }    
            });

        });
    </script>
}