@using VCM.BLUEPOS.Model.StoreActivities
@{
    var data = Model as ViewShiftHeaderDesciptionModel;
    var description = "";
    var shiftCode = data.ShiftCode;
    var storeNo = data.StoreNo;
    var ngayKD = data.BussinessDate.Value.ToString("dd/MM/yyyy");
    if (data.DescriptionModel != null)
    {
        description = data.DescriptionModel.Descriptions;
    }
}

<div class="modal fade" id="modalShiftDescription">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;font-weight:bold">GIẢI TRÌNH KẾT CA <span style="font-weight:bold;font-size:16px;color:#62b0fa" id="spanCode">@data.ViewTitle</span></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <textarea class="form-control" rows="7" placeholder="Nhập nội dung giải trình kết ca" id="txtDesciption">@description</textarea>
                    </div>
                </div>
            </div>          
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"> Giải trình</button>
                <button type="button" id="btnCancle" class="btn btn-danger font-weight-bold"> Xóa giải trình</button>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $("#btnSave").on("click", function () {

            var txtDescription = $("#txtDesciption").val();
            var shiftCode = '@shiftCode';
            var storeNo = '@storeNo';
            var ngayKD = '@ngayKD';

            if (txtDescription == "") {
                toastr.error("Vui lòng nhập nội dung giải trình");
                return;
            }
            if (shiftCode == "") {
                toastr.error("Không lấy được thông tin cần giải trình");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('shiftCode', shiftCode);
            fromData.append('storeNo', storeNo);
            fromData.append('bussinessDate', ngayKD);
            fromData.append('description', txtDescription);

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateGiaiTrinh", "StoreActivities")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Item1 == true)
                    {
                        $('#modalShiftDescription').modal('hide');
                        toastr.success("Cập nhật giải trình thành công");
                    }
                    else
                    {
                        toastr.error(data.Item2);
                    }

                    loading.hideloading();

                },
                error: function ()
                {
                    loading.hideloading();
                }

            });

        });

        $("#btnCancle").on("click", function () {
            var shiftCode = '@shiftCode';
            var storeNo = '@storeNo';
            if (shiftCode == "") {
                toastr.error("Không lấy được thông tin cần giải trình");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('shiftCode', shiftCode);
            fromData.append('storeNo', storeNo);
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteGiaiTrinh", "StoreActivities")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Item1 == true) {
                        $("#txtDesciption").val('');
                        $('#modalShiftDescription').modal('hide');
                        toastr.success("Hủy giải trình thành công");
                    }
                    else {
                        toastr.error(data.Item2);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }

            });
        });
    });
</script>
