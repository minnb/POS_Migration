@using VCM.BLUEPOS.Model.StoreActivities;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Xác nhận kết thúc ca";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Hoạt động cửa hàng</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Xác nhận kết thúc ca</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">ST/CH</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                        @if (listStore != null && listStore.Count > 0)
                                        {
                                            if (listStore.Count == 1)
                                            {
                                                <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                            }
                                            else
                                            {
                                                foreach (var item in listStore)
                                                {
                                                    <option value="@item.SiteNo">@item.SiteNo - @item.SiteName</option>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <option value="" selected disabled>Chọn mã ST/CH</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">User POS<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="sel-staff-code"></select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại giao dịch</label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="sel-type-trans">
                                        <option value="WEB" selected>Bán hàng</option>
                                        @*<option value="TH">Thu hộ</option>*@
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày kinh doanh <strong id="strShiftNumber" style="color:#3045f2"></strong></label>
                                <div class="input-group">
                                    <input type="text" id="txt-business-date" disabled placeholder="" class="form-control">
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="margin-top:25px;">
                                <button type="button" class="btn btn-primary" onclick="EndShift()" id="btn-end-shift"><i class="fa fa-hourglass-end"></i>Xác nhận</button>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div card card-default>
                        <div class="card-header" style="margin-top: 10px; margin-left: 10px;">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group" style="margin:0;">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-search-from-date" name="TuNgay" placeholder="Ngày kết thúc ca">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-search-staff-code"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-search-type-trans">
                                            <option value="WEB" selected>Bán hàng</option>
                                            @*<option value="TH">Thu hộ</option>*@
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <button type="button" class="btn btn-warning" id="btnSearch" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-search"></i> Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body table-responsive">
                        <table id="tbl-confirm-end-shift" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>User POS</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>Loại giao dịch</th>
                                    <th>Ca</th>
                                    <th>Tiền đầu ca</th>
                                    <th>Số phong bì</th>
                                    <th>Số coupon</th>
                                    <th>Số PMH</th>
                                    <th class="text-center" style="min-width:100px;">#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



