                                toastr.error(data.Message);
                            }
                            else if (data.Status == 2) {   //Danh sách User chưa kết thúc bán hàng
                                var resultData = data.Data;
                                if (resultData != null) {
                                    var html = "";
                                    html += "<table id=\"\" class=\"table table-bordered table-hover\" style=\"width:100%;\">";
                                    html += "<thead>";
                                    html += "<tr>";
                                    html += "<th style=''>StoreNo</th>";
                                    html += "<th style=''>TerminalPOS</th>";
                                    html += "<th style=\"\">UserPOS</th>";
                                    html += "<th style=''>Ngày kinh doanh</th>";
                                    html += "<th style='text-align:center'>#</th>";

                                    html += "</tr>";
                                    html += "</thead>";
                                    html += "</tbody>";
                                    resultData.forEach((name, i) => {

                                        html += "<tr id=\"\">";
                                        html += "<td>" + name.StoreNo + "</td>";
                                        html += "<td style=\"\">" + name.PosTerminal + "</td>";
                                        html += "<td style=\"\">" + name.StaffCode + "</td>";
                                        html += "<td style=\"\">" + name.FormatBussinessDate + "</td>";
                                        html += "<td style=\"text-align:center\"><span class=\"badge bg-danger\">Chưa kết thúc</span></td>";
                                        html += "</tr>";
                                    });
                                    html += "</tbody>";
                                    html += "</table>";
                                    $('#listNotFinish').html(html);
                                }

                                $('#modalListUserNotFinish').modal({
                                    backdrop: 'static',
                                    keyboard: false
                                });
                            }
                            else if (data.Status == 1) {//Bước tiếp theo
                                ResetShiftEnd();
                                $('#modalShiftHeader').modal({
                                    backdrop: 'static',
                                    keyboard: false
                                });

                                $('#modalShiftHeader').on('shown.bs.modal', function () {
                                    $("#txt1").focus();
                                    show_easy_numpad(1);
                                })
                            }
                        }
                        else {
                        }
                        loading.hideloading();
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });

            }
        }


        function FinishShift() {
                var shiftLine = [];
                const regex = /,/gi;
                for (var i = 1; i <= $("input[name=Money]").length; i++) {
                    var qltMoney = $("#txt" + i).val();
                    qltMoney = qltMoney.replace(regex, "");
                    var money = $("#txt" + i).attr("data-money");
                    var lineNo = $("#txt" + i).attr("data-lineno");
                    if (qltMoney > 0) {
                        shiftLine.push({ LineNo: lineNo, CashCode: money, CashQuantity: qltMoney });
                    }
                }

                var arrayData = JSON.stringify(shiftLine);
                loading.showloading();
                var siteNo = $("#sel-store-no").val();
                var userPOS = $("#sel-staff-code").val();
                var dateBusiness = $("#txt-business-date").val();
                var posTerminal = "VM";
                var moneyShift = $("#txtTienLR").val().replace(regex, "");
                var quantityBox = $("#txtSoPB").val().replace(regex, "");
                var quantityCoupon = $("#txtSoCoupon").val().replace(regex, "");
                var quantityVoucher = $("#txtPMH").val().replace(regex, "");
                var closeAmount = $("#txtTotal").val().replace(regex, "");

                var fromData = new FormData();
                fromData.append('StaffCode', userPOS);
                fromData.append('SiteNo', siteNo);
                fromData.append('PosTerminal', posTerminal);
                fromData.append('BusinessDate', dateBusiness);
                fromData.append('CloseAmount', closeAmount == "" ? 0 : closeAmount);

                fromData.append('MoneyShift', moneyShift == "" ? 0 : moneyShift);
                fromData.append('QuantityBox', quantityBox == "" ? 0 : quantityBox);
                fromData.append('QuantityCoupon', quantityCoupon == "" ? 0 : quantityCoupon);
                fromData.append('QuantityVoucher', quantityVoucher == "" ? 0 : quantityVoucher);
                fromData.append('ArrayShiftLine', arrayData);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("FinsishShift", "StoreActivities")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.Status == 1) {
                            LoadDataShiftEnd();
                            ResetShiftEnd();
                            toastr.success(data.Message);
                            GetShiftNumber(siteNo, userPOS, dateBusiness, "WEB");
                            $('#modalShiftHeader').modal('hide');
                            var shiftNum = $('#txthdShiftNumber').val();
                            var urlPDF = '/StoreActivities/DetailEndShift?storeNo=' + siteNo + '&staffCode=' + userPOS + '&businessDate=' + dateBusiness + '&shiftCode=' + shiftNum;
                            window.open(urlPDF);
                        }
                        else {
                            toastr.error(data.Message);
                        }
                        loading.hideloading();
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });
        }


        function ResetShiftEnd() {
            for (var i = 1; i <= $("input[name=Money]").length; i++) {
                $("#txt" + i).val('');
            }
            $("#txtTienLR").val('');
            $("#txtSoPB").val('');
            $("#txtSoCoupon").val('');
            $("#txtPMH").val('');
            $("#txtTotal").val('');
        }


