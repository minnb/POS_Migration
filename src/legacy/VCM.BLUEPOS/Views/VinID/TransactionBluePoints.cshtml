@using VCM.BLUEPOS.Model.VinID;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Giao dịch điểm Blue";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>VINID</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Giao dịch điểm Blue</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportTransactionBluePoint", "VinID", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ ngày</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã CH/ST<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    <option value="">Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.SiteNo - @item.SiteName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Máy POS</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-pos-id" name="PosId"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12 mb-1">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại giao dịch</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="txt-transaction-type" name="TransactionType">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Sales</option>
                                            <option value="1">Refund</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="Nhập mã Receipt; số thẻ VinID; số đơn hàng">
                                    </div>
                                </div>

                                <input type="hidden" id="id-transaction" value="">
                                <input type="hidden" id="receipt-number" value="">
                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary btn-search" style="margin-top: 27px;" id="btn-search"><i class="fa fa-search"></i>&nbsp;&nbsp;Tìm kiếm</button>
                                        <button type="button" class="btn btn-success btn-export-excel" style="padding-top: 10px; margin-top: 27px; color: #ffffff;" id="btn-export-excel"><i class="fa fa-file-excel"></i>&nbsp;&nbsp;Xuất Excel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-striped" id="table-transaction-blue-points">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>#</th>
                                    <th>STT</th>
                                    <th>Số Receipt</th>
                                    <th>Số đơn hàng</th>
                                    <th>Thời gian</th>
                                    <th>Mã ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Loại giao dịch</th>
                                    <th>Số thẻ VinID</th>
                                    <th>Tên khách hàng</th>
                                    <th>Tổng số tiền</th>
                                    <th>Điểm KM Masan</th>
                                    <th>Điểm nhân viên</th>
                                    <th>Thu ngân</th>
                                    <th>Nhân viên (CSN)</th>
                                    <th>Số tham chiếu</th>
                                    <th>Số Receipt gốc</th>
                                    <th>Số tham chiếu gốc</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!--Chi tiet giao dịch điểm Blue -->

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="modal-detail-transaction-blue-point">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="title-order-no" class="modal-title">CHI TIẾT GIAO DỊCH ĐIỂM BLUE - ReceiptNumber:</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                            <div class="card-body">
                                <table id="extra-item-bill-detail-table" class="table table-bordered table-striped table-hover text-nowrap row-border order-column" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>STT</th>
                                            <th>Mã BarCode</th>
                                            <th>RecordNo</th>
                                            <th>Mã sản phẩm</th>
                                            <th>Tên sản phẩm</th>
                                            <th>ĐVT</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Thành tiền</th>
                                            <th>Khuyến mãi</th>
                                            <th>Thành tiền sau KM</th>
                                            <th>SL tích điểm</th>
                                            <th>Điểm</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



@section scripts {
    <script type="text/javascript">
        var table;
        var childtable;

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function checkValidate() {
            var valid = true;
            var fromdate = getFromDate();
            var todate = getToDate();

            if (Date.parse(todate) < Date.parse(fromdate)) {
                toastr.warning("Từ ngày phải nhỏ hơn hoặc bằng đến ngày", "Thông báo")
                valid = false;
            }
            return valid;
        }

        //
        function LoadComboxPOSTeminalByStore(_storeNo) {
            var html = "<option value=\"\" selected>Tất cả</option>";
            if (_storeNo == null || _storeNo == '') {
                return $('#sel-pos-id').html(html);
            }
            var fromData = new FormData();
            fromData.append('StoreNo', _storeNo);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.PosID != "") {
                                html += "<option value='" + name.PosID + "'>" + name.PosName + "</option>";
                            }
                        });
                        $('#sel-pos-id').html(html);
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });

        };

        $("#sel-store-no").on('change', function (e) {
            LoadComboxPOSTeminalByStore($("#sel-store-no").val());
        });


        $(document).ready(function () {
            $('.select2').select2();
            LoadComboxPOSTeminalByStore($("#sel-store-no").val());

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            table = $('#table-transaction-blue-points').DataTable({
                destroy: true,
                deferLoading: 0,                    // Load table lần đầu dữ liệu sẽ không có khi chưa thực hiện search
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    // Xem chi tiet
                    $(".btn-search-detail").click(function () {
                        var id = $(this).attr("data-id");
                        var receipt = $(this).attr("data-receipt");

                        $('#id-transaction').val(id);
                        $('#receipt-number').val(receipt);

                        $('#modal-detail-transaction-blue-point').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                        childtable.draw();
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,                  // for show progress bar
                serverSide: true,                   // for process server side
                filter: true,                       // this is for disable filter (search box)
                orderMulti: false,                  // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                info: true,

                ajax: {
                    url: '@Url.Action("GetTransactionBluePointHeader", "VinID")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                        d.storeNo = $('#txt-store-no').val();
                        d.posCode = $('#txt-pos-id').val();
                        d.textSearch = $('#txt-text-search').val();
                        d.transactionType = $('#txt-transaction-type').val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row) {
                                var id = row.ID;
                                var receiptNumber = row.ReceiptNumber;
                                var html = '<button type="button" class="btn btn-primary-detail-view btn-search-detail"  data-toggle="tooltip" data-placement="left" title="Xem chi tiết"   data-id="' + id + '"  data-receipt = "' + receiptNumber +'"     style="text-align:center;font-size:11px;margin-right:5px;color:#ffffff;"><i class="fa fa-list"></i></button>';
                                return html;
                        }
                    },

                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        },
                        orderable: false
                    },

                    {
                        data: "ReceiptNumber",            // Số receipt
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var ReceiptNumber = row.ReceiptNumber;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;">' + ReceiptNumber + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OrderNo",            // Số OrderNo
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var OrderNo = row.OrderNo;
                            var html = "";
                            html = '<span style="display: block;">' + OrderNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CreatedDate",              // Thời gian
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "StoreNo",                  // Mã cửa hàng
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "POSCode",                  // Mã máy POS
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "TransactionType",          // Loại giao dịch
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            //debugger
                            var TransactionType = row.TransactionType;
                            var html = "";
                            if (TransactionType == "Refund") {

                                html += '<span style="font-weight:400;display: block; color:#ec0c0c;">' + TransactionType + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display: block; color:#0000a2;">' + TransactionType + '</span>';
                            }

                            return html;
                        }

                    },

                    {
                        data: "VinidCardNumber",          // Số thẻ VinID
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var VinidCardNumber = row.VinidCardNumber;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;">' + VinidCardNumber + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CustomerName",             // Tên khách hàng
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "TotalBillAmount",          // Tổng số tiền
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var TotalBillAmount = row.TotalBillAmount;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(TotalBillAmount).toLocaleString('en') + '</span>';
                            return html;
                        }

                    },

                    {
                        data: "ExtraEarnByItems",         // Điểm khuyến mãi Masan
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var ExtraEarnByItems = row.ExtraEarnByItems;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(ExtraEarnByItems).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ExtraEarnByCampaign",      // Điểm nhân viên
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            var ExtraEarnByCampaign = row.ExtraEarnByCampaign;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(ExtraEarnByCampaign).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CashierCode",              // Thu ngân
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "VinIDCSN",                 // Mã nhân viên CSN
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "ReferenceNumber",          // Số tham chiếu
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "OriginalReceiptNumber",    // Số receipt goc
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "OriginalReferenceNumber",  // Số tham chiếu gốc
                        orderable: false,
                        className: "text-center"
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

                });

            //
            $('[data-toggle="tooltip"]').tooltip();

            $('#extra-header-table tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var check = checkValidate();
                if (!check) {
                    return;
                }
                table.draw();
            })

            childtable = $('#extra-item-bill-detail-table').DataTable({
                destroy: true,
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                lengthChange: false,            // disable lenghthMenu
                filter: false,                  // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                searching: false,               // Show (search box)
                autoWidth: false,
                ordering: false,
                displayLength: 5,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetTransactionBluePointDetail", "VinID")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ReceiptNumber = $('#receipt-number').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        },
                        orderable: false
                    },

                    {
                        data: "Barcode",
                        orderable: false,
                        render: function (data, type, row) {
                            var Barcode = row.Barcode;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:center;">' + Barcode + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "RecordNo",
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "Article",                          // Mã sản phẩm
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "ArticleName",                      // Tên sản phẩm
                        orderable: false,
                        className: "text-left"
                    },

                    {
                        data: "UOM",                              // Đơn vị tính
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        data: "Quantity",                         // Số lượng
                        orderable: false,
                        render: function (data, type, row) {
                            var Quantity = row.Quantity;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(Quantity).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "SalePrice",                        // Đơn giá
                        orderable: false,
                        render: function (data, type, row) {
                            var SalePrice = row.SalePrice;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(SalePrice).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "Amount",                           // Thành tiền
                        orderable: false,
                        render: function (data, type, row) {
                            var Amount = row.Amount;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(Amount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "DiscountAmount",                   // Khuyến mãi
                        orderable: false,
                        render: function (data, type, row) {
                            var DiscountAmount = row.DiscountAmount;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(DiscountAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "LineAmount",                       // Thành tiền sau khuyến mãi
                        orderable: false,
                        render: function (data, type, row) {
                            var LineAmount = row.LineAmount;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(LineAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ExtraQuantityEarn",                // Số lượng tích điểm
                        orderable: false,
                        render: function (data, type, row) {
                            var ExtraQuantityEarn = row.ExtraQuantityEarn;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(ExtraQuantityEarn).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ExtraAmountEarn",                  // Điểm
                        orderable: false,
                        render: function (data, type, row) {
                            var ExtraAmountEarn = row.ExtraAmountEarn;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:right;">' + parseFloat(ExtraAmountEarn).toLocaleString('en') + '</span>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                    var receiptNumber = $('#receipt-number').val();
                    $('#title-order-no').text('CHI TIẾT GIAO DỊCH ĐIỂM BLUE- ReceiptNumber: ' + receiptNumber);
                }
                else
                {
                    loading.hideloading();
                }

                });
        })

        $("#btn-export-excel").on("click", function (e) {
            var check = checkValidate();
            if (!check) {
                return;
            }

            var paramfromDate = getFromDate();
            var paramtoDate = getToDate();

            $('#hdFromDate').val(paramfromDate);
            $('#hdToDate').val(paramtoDate);

            $('#frm-export-excel').submit();
        })

    </script>
}




