@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Dữ liệu giao dịch VinID tại POS";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">

        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>VINID</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Dữ liệu giao dịch VinID tại POS</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        @using (Html.BeginForm("ExportTransactionLoyaltyBluePOS", "VinID", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ ngày</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">ST/Ch<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    <option value="">Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.SiteNo - @item.SiteName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Máy POS</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-pos-id" name="PosId"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại giao dịch</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slTypeTransaction" name="TransactionType">
                                            <option value="">Tất cả</option>
                                            <option value="SALE">Bán</option>
                                            <option value="REF">Trả</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Số thẻ VinID/QRCode</label>
                                    <div class="form-group">
                                        <input type="text" id="txt-cardnumber" placeholder="Nhập số thẻ / QRCode" class="form-control" name="CardNumber">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Số đơn hàng</label>
                                    <div class="form-group">
                                        <input type="text" id="txt-order-no" placeholder="Nhập số đơn hàng" class="form-control" name="OrderNo">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <div class="form-group" style="margin-top:27px;">
                                        <input type="hidden" id="hdFromDate" name="fDate" />
                                        <input type="hidden" id="hdToDate" name="tDate" />
                                        <button type="button" class="btn btn-primary btn-search" style="" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        <button type="button" class="btn btn-success" id="btn-export-excel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                        @*<a class="btn btn-success btn-export-excel" style="color: #ffffff;cursor:pointer;" id="btn-export-excel"><i class="fa fa-file-excel"></i> Xuất Excel</a>*@
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-striped" id="table-vin-id-report">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>STT</th>
                                    <th>Mã ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Thời gian</th>
                                    <th>Số thẻ VinID</th>
                                    <th>Mã QR</th>
                                    <th>Số đơn hàng</th>
                                    <th>Số đơn hàng gốc</th>
                                    <th>Loại giao dịch</th>
                                    <th>Tổng số tiền thanh toán</th>            <!-- FormatAmountOnOrderPOS -->
                                    <th>Tổng số tiền giao dịch OE</th>          <!-- GrossTransactionAmountOE -->
                                    <th>Tổng số tiền trả</th>                   <!-- RefundAmount -->
                                    <th>Điểm tích</th>                          <!-- AwardPointOE -->
                                    <th>Điểm tiêu</th>                          <!-- Spend Points -->
                                    <th>Tiền tích điểm</th>                     <!-- AwardAmountOE -->
                                    <th>Tiền tiêu điểm</th>                     <!-- RedeemAmountOE -->
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var table = "";
        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }
                
        function checkValidate() {
            var valid = true;
            var fromdate = getFromDate();
            var todate = getToDate();

            if (Date.parse(todate) < Date.parse(fromdate)) {
                toastr.warning("Từ ngày phải nhỏ hơn hoặc bằng đến ngày", "Thông báo")
                valid = false;
            }
            return valid;
        }

        //
        function LoadComboxPOSTeminalByStore(_storeNo) {
            var html = "<option value=\"\" selected>Tất cả</option>";
            if (_storeNo == null || _storeNo == '') {
                return $('#sel-pos-id').html(html);
            } 

            var fromData = new FormData();
            fromData.append('StoreNo', _storeNo);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                         data.forEach((name, i) => {
                             if (name.PosID != "") {
                                html += "<option value='"+ name.PosID +"'>" + name.PosName + "</option>";
                             }
                         });
                         $('#sel-pos-id').html(html);
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });

        };

        $("#sel-store-no").on('change', function (e) {
            LoadComboxPOSTeminalByStore($("#sel-store-no").val());
        });

        //
        function LoadTransaction() {
            table = $('#table-vin-id-report').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,                  // for show progress bar
                serverSide: true,                   // for process server side
                filter: true,                       // this is for disable filter (search box)
                orderMulti: false,                  // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                info: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("ReportVinIDLoad", "VinID")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.FromDate = getFromDate();
                        d.ToDate = getToDate();
                        d.StoreNo = $("#sel-store-no").val();
                        d.PosID = $("#sel-pos-id").val();
                        d.TransactionType = $("#slTypeTransaction").val();
                        d.CardNumber = $("#txt-cardnumber").val();
                        d.OrderNo = $("#txt-order-no").val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        },
                        orderable: false
                    },

                    {
                        data: "StoreID",
                        className: 'text-center'
                    },

                    {
                        data: "TerminalId",
                        className: 'text-center'
                    },

                    {
                        data: "DateTimeStr",
                        className: 'text-center'
                    },

                    {
                        data: "CardNumber",
                        render: function (data, type, row) {
                            var _cardNumber = row.CardNumber;
                            var html = "";
                            html = '<span style="font-weight:700;display: block;text-align:center;">' + _cardNumber + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "QRCode",
                        render: function (data, type, row) {
                            var _qrCode = row.QRCode;
                            var html = "";
                            html = '<span style="display: block;text-align:center;">' + _qrCode + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OrderNo",
                        render: function (data, type, row) {
                            var _orderNo = row.OrderNo;
                            var html = "";
                            html = '<span style="display:block;text-align:center;">' + _orderNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OrigOrderNo",
                        render: function (data, type, row) {
                            var _origOrderNo = row.OrigOrderNo;
                            var html = "";
                            html = '<span style="display:block;text-align:center;">' + _origOrderNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TransactionName",
                        render: function (data, type, row) {
                            var _transactionType = row.TransactionName;
                            var html = "";
                            if (_transactionType == "Trả") {
                                html = '<span style="display: block;text-align:center; color:red; font-weight:700;">' + _transactionType + '</span>';
                            }
                            else {
                                html = '<span style="display: block;text-align:center;">' + _transactionType + '</span>';
                            }
                            return html;
                        }

                    },

                    {
                        data: "AmountOnOrderPOS",                   // Tong so tien thanh toan don hang tren POS
                        render: function (data, type, row) {
                            var _totalAmount = row.AmountOnOrderPOS;
                            var html = "";
                            html = '<span style="display: block;text-align:right;">' + parseFloat(_totalAmount).toLocaleString('en') + '</span>';
                            return html;
                        }

                    },

                    {
                        data: "GrossTransactionAmountOE",            // Tong so tien thanh toan giao dich OE
                        render: function (data, type, row) {
                            var _GrossTransactionAmountOE = row.GrossTransactionAmountOE;
                            var html = "";
                            html = '<span style="display:block;text-align:right;">' + parseFloat(_GrossTransactionAmountOE).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    //{
                    //    "data": "NettAmtOE",
                    //    "render": function (data, type, row) {
                    //        var _NettAmtOE = row.NettAmtOE;
                    //        var html = "";
                    //        html = '<span style="display:block;text-align:right;">' + parseFloat(_NettAmtOE).toLocaleString('en') + '</span>';
                    //        return html;
                    //    }
                    //},

                    {
                        data: "RefundAmount",                         // Tong so tien tra lai
                        render: function (data, type, row) {
                            var _RefundAmount = row.RefundAmount;
                            var html = "";
                            if (_RefundAmount != "") {
                                html = '<span style="display:block;text-align:right;">' + parseFloat(_RefundAmount).toLocaleString('en') + '</span>';
                            }
                            else {
                                html = '<span style="display:block;text-align:right;">' + _RefundAmount + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "AwardPointOE",                         // Diem tich
                        render: function (data, type, row) {
                            var _AwardPointOE = row.AwardPointOE;
                            var html = "";
                            html = '<span style="display:block;text-align:right;">' + parseFloat(_AwardPointOE).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "SpendPoints",                              // Diem tieu
                        render: function (data, type, row) {
                            var _SpendPoints = row.SpendPoints;
                            var html = "";
                            html = '<span style="display:block;text-align:right;">' + parseFloat(_SpendPoints).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AwardAmountOE",                            // Tien tich diem
                        render: function (data, type, row) {
                            var _AwardAmountOE = row.AwardAmountOE;
                            var html = "";
                            html = '<span style="display:block;text-align:right;">' + parseFloat(_AwardAmountOE).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "RedeemAmountOE",                           // Tien tieu diem
                        render: function (data, type, row) {
                            var _RedeemAmountOE = row.RedeemAmountOE;
                            var html = "";
                            html = '<span style="display:block;text-align:right;">' + parseFloat(_RedeemAmountOE).toLocaleString('en') + '</span>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        //
        $('#table-vin-id-report tbody').on('click', 'tr', function () {
            $(this).toggleClass('selected');
        });

        $(document).ready(function () {
            $('.select2').select2();
            LoadTransaction();
            LoadComboxPOSTeminalByStore($("#sel-store-no").val());

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            //
            $("#btn-search").on("click", function (e) {
                //debugger
                var check = checkValidate();
                if (!check) {
                    return;
                }
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                //debugger
                var check = checkValidate();
                if (!check) {
                    return;
                }
                // Set value: Formdate, ToDate
                var paramfromDate = getFromDate();
                var paramtoDate = getToDate();
                var _fDate = "";
                var _tDate = "";

                if (paramfromDate != null && paramfromDate != "") {  // yyyy/MM/dd
                    _fDate = paramfromDate.split('-')[0] + "/" + paramfromDate.split('-')[1] + "/" + paramfromDate.split('-')[2];
                }
                else {
                    _fDate = "";
                }

                if (paramtoDate != null && paramtoDate != "") {  // yyyy/MM/dd
                    _tDate = paramtoDate.split('-')[0] + "/" + paramtoDate.split('-')[1] + "/" + paramtoDate.split('-')[2];
                }
                else {
                    _tDate = "";
                }

                if (paramfromDate == "" || paramtoDate == "") {
                    $('#hdFromDate').val("2000/01/01");
                    $('#hdToDate').val("9999/12/31");
                }
                else {
                    $('#hdFromDate').val(_fDate);
                    $('#hdToDate').val(_tDate);
                }
                $('#frm-export-excel').submit();

            })

        });

        
    </script>
}




