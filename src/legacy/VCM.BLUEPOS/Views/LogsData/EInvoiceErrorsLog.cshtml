@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.LogsData;

@{
    ViewBag.Title = "Logs lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Logs E-Invoice</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Logs Lỗi</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelInvoiceErrorsLog", "LogsData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <input type="hidden" id="hdFromDate" name="FromDate" />
                                    <input type="hidden" id="hdToDate" name="ToDate" />
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-invoice-errors-log" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Error ID</th>
                                    <th>Error DateTime</th>
                                    <th>User Name</th>
                                    <th>Error Number</th>
                                    <th>Error State</th>
                                    <th>Error Severity</th>
                                    <th>Error Line</th>
                                    <th>Error Procedure</th>
                                    <th>Error Message</th>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section scripts {
    <script type="text/javascript">
        $('#text-search-key').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        $(document).ready(function () {
            $(".select2").select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
            });

            table = $('#tbl-invoice-errors-log').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: false,                // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("LoadInvoiceErrorsLog", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }

                    },

                    {
                        data: "ErrorID",
                        className: "text-center"
                    },

                    {
                        data: "ErrorDateTimeStr",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ErrorDateTimeStr + '</span>';
                        }
                    },

                    {
                        data: "UserName",
                        className: "text-center"
                    },

                    {
                        data: "ErrorNumber",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ErrorNumber + '</span>';
                        }
                    },

                    {
                        data: "ErrorState",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.ErrorState + '</span>';
                        }
                    },

                    {
                        data: "ErrorSeverity",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.ErrorSeverity + '</span>';
                        }
                    },

                    {
                        data: "ErrorLine",
                        className: "text-center"
                    },

                    {
                        data: "ErrorProcedure",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ErrorProcedure + '</span>';
                        }
                    },

                    {
                        data: "ErrorMessage",
                        className: "text-center"
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

                });

            $('#tbl-invoice-errors-log tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                var paramfromDate = getFromDate();
                var paramtoDate = getToDate();
                $('#hdFromDate').val(paramfromDate);
                $('#hdToDate').val(paramtoDate);
                $('#frm-export-excel').submit();
            })

        })

    </script>
}













<style>

    #toast-container > .toast-success {
        background-image: none;
        background-color: #e9e9e9;
        color: black;
    }

    #toast-container > .toast-error {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    #toast-container > .toast-warning {
        background-image: none;
        /*background-color: #FCF8E3;*/
        background-color: #e9e9e9;
        /*color: #996D3B;*/
        color: red;
    }
</style>




