@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.LogsData;

@{
    ViewBag.Title = "Danh sách bảng dữ liệu đồng bộ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;

}
<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>
<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
    }

    #json-input {
        display: block;
        width: 100%;
        height: 200px;
    }

    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log Master Data</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh sách bảng dữ liệu đồng bộ</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "LogsData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected disabled>Chọn ST/CH</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.SiteNo - @item.SiteName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tên bảng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-table-name" name="TableName" placeholder="Nhập tên bảng">
                                    </div>
                                </div>

                                <button type="button" id="open-store" hidden></button>
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary" id="btn-search"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-log-sync-change-table-by-store" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>ID</th>
                                    <th>ST/CH</th>
                                    <th>Tên bảng</th>
                                    <th>Thời gian đống bộ</th>
                                    <th>Thời gian cập nhật sau cùng</th>
                                    <th>LastCounter</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div id="modal-update-last-counter" class="modal fade" role="dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lbl-tilte">Cập nhật LastCounter</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="modal-update-last-counter-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">

                                <div class="row">
                                    <input type="text" id="update-id" name="UpdateID" hidden />
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="update-store-no" name="StoreNo" disabled>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Table Name</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="update-table-name" name="TableName" disabled>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Last Counter</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control" id="update-last-counter" name="LastCounter">
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btn-update-last-counter" ><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Đóng</button>
            </div>

        </div>
    </div>
</div>



@section scripts {
    <script type="text/javascript">

        function UpdateLastCounterNumber() {
            //debugger
            var id = $('#update-id').val();
            var siteCode = $('#update-store-no').val();
            var tableName = $('#update-table-name').val();
            var lastCounter = $('#update-last-counter').val();

            if (lastCounter == null || lastCounter == "") {
                toastr.warning('Nhập số LastCounter. Vui lòng kiểm tra lại');
                return;
            }

            loading.showloading();

            $.ajax({
               url: '@Url.Action("UpdateLastCounter", "LogsData")',
               type: "POST",
               dataType: "json",
                data: {
                    ID: id,
                    SiteCode: siteCode,
                    TableName: tableName,
                    LastCounter: lastCounter
                },
               success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        $('#modal-update-last-counter').modal('hide');
                        $("#tbl-log-sync-change-table-by-store").DataTable().ajax.reload();
                    }
                    else if (data.Status == 2) {
                        toastr.error(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
               },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
               }

           });
        }


        $(document).ready(function () {
            var table;
            $('.select2').select2();
            $("#btn-update-last-counter").on("click", function (e) {
                UpdateLastCounterNumber();
            });

            table = $('#tbl-log-sync-change-table-by-store').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    $(".btn-editor-last-counter").click(function () {
                        //debugger
                        var id = $(this).attr("data-id");
                        $('#update-id').val(id);
                        var siteCode = $(this).attr("data-site-code");
                        $('#update-store-no').val(siteCode);
                        var tableName = $(this).attr("data-table-name");
                        $('#update-table-name').val(tableName);
                        var lastCounter = $(this).attr("data-last-counter");
                        $('#update-last-counter').val(lastCounter);
                        $('#modal-update-last-counter').modal({
                            backdrop: 'static',
                            //keyboard: true
                        });

                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("SyncChangeLogStoreList", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo = $('#sel-store-no').val();
                        d.TableName = $('#txt-table-name').val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ID",
                        className: "text-center"
                    },

                    {
                        data: "SiteCode",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.SiteCode + '</span>';
                        }
                    },

                    {
                        data: "TableName",
                        render: function (data, type, row) {
                            return '<span style="display:block;font-weight:700;text-align:left;">' + row.TableName + '</span>';
                        }
                    },

                    {
                        data: "SyncTimeStr",
                        className: "text-center"
                    },

                    {
                        data: "LastedDateStr",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display:block;font-weight:700;">' + row.LastedDateStr + '</span>';
                        }
                    },

                    {
                        data: "LastCounter",
                        render: function (data, type, row) {
                            var id = row.ID;
                            var siteCode = row.SiteCode;
                            var tableName = row.TableName;
                            var lastCounter = row.LastCounter;
                            var html = "";
                                html += '<table style="width: 100%;">';
                                html += '<tr>';
                                html += '<td style="width: 50px;text-align: center;">';
                                html += '<span style="font-weight:700;">' + lastCounter + '</span>';
                                html += '</td>';
                                html += '<td style="width: 50px; text-align: center;">';
                                html += '<button type="button" class="btn btn-icon btn-light-primary btn-editor-last-counter"  data-id ="' + id + '"  data-site-code ="' + siteCode + '"  data-table-name ="' + tableName + '"  data-last-counter ="' + lastCounter + '" data-toggle="tooltip" data-placement="left" title="Cập nhật" style=\"height:30px;margin-top:3px;\"><i class="fa fa-list"></i></button>';
                                html += '</td>';
                                html += '</tr>';
                                html += '</table>';
                            return html;
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $("#btn-search").on("click", function (e) {
                var _storeNo = $('#sel-store-no').val();
                if (_storeNo == null || _storeNo == "") {
                    toastr.warning('Vui lòng chọn ST/CH');
                    return;
                }
                table.draw();
            });


        })

    </script>
}





