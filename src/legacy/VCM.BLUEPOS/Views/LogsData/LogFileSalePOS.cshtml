@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.LogsData;

@{
    ViewBag.Title = "Log File Sales tại POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSet = (List<SQLServerModel>)ViewBag.SetDB;

}

<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>
<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
    }

    #json-input {
        display: block;
        width: 100%;
        height: 200px;
    }

    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log Central Sales</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log File Sales tại POS</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "LogsData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetDB">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer" data-serverread="@listSet.FirstOrDefault().IPServerRead">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="POSTerminal"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="FromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="ToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Tên File</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-file-name" name="FileName" placeholder="Nhập tên file..." />
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary" style="font-size:12px;"><i class="fa fa-search" style="font-size:12px;"></i>Tìm kiếm</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-log-file-pos-sale" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>#</th>
                                    <th>Stt</th>
                                    <th>IP Server</th>
                                    <th>Tên File</th>
                                    <th>Đường dẫn File</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



<div class="modal fade" id="modal-view-log-file-sale-pos">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="title-result" class="modal-title"> CHI TIẾT LOG FILE SALE TẠI POS</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div id="detail-json" style="display:block"></div>
                <div id="formatJsonError" style="display:none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal" id="close-modal-detail-json"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script type="text/javascript">
        var table = "";

        function getJson(json) {
            try {
                $("#formatJsonError").css("display", "none");
                $("#detail-json").css("display", "block");
                return JSON.parse(json);
            }
            catch (ex)
            {
                $('#detail-json').css("display", "none");
                $("#formatJsonError").css("display", "block");
                $('#formatJsonError').html(json);
            }
        }

        function LoadComboxStoreByServer(ipServer) {
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                            LoadComboxPOSTerminalByStore(data[0].SiteNo);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected disabled>----- Chọn ST/CH ----</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxPOSTerminalByStore(storeNo) {
            if (storeNo == null || storeNo == "") {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-pos-terminal').html(html);
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: { StoreNo: storeNo },
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].PosID + "'>" + data[0].PosID + "</option>";
                            $('#sel-pos-terminal').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>----- Tất cả -----</option>";
                            data.forEach((name, i) => {
                                if (name.PosID != "") {
                                    html += "<option value='" + name.PosID + "'>" + name.PosID + "</option>";
                                }
                            });
                            $('#sel-pos-terminal').html(html);
                        }
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });

        };


        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker(
            {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            $("#sel-store-no").on("change", function (e) {
                LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            });

            $("#btn-search").on("click", function (e) {
                if ($("#sel-store-no").val() == "") {
                    toastr.error("Vui lòng chọn ST/CH");
                }
                else {
                    table.draw();
                }
            });

            table = $('#tbl-log-file-pos-sale').DataTable({
                destroy: true,
                deferLoading: 0,

                drawCallback: function (settings) {
                    $(".btn-view-file").click(function () {
                        //debugger
                        $('#detail-json').empty();
                        var storeNo = $(this).attr("data-store-no");
                        var pathFile = $(this).attr("data-path-file");
                        var fileName = $(this).attr("data-file-name");
                        var ipServer = $(this).attr("data-ip-server");
                        var folderBackup = $(this).attr("data-folder-backup");

                        loading.showloading();

                        var fromData = new FormData();
                        fromData.append('IPServer', ipServer);
                        fromData.append('FilePath', pathFile);
                        fromData.append('FileName', fileName);
                        fromData.append('FolderFile', folderBackup);

                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("_ViewLogFileSalePOS", "LogsData")',
                            data: fromData,
                            contentType: "application/json",
                            dataType: "json",
                            contentType: false,
                            processData: false,
                            success: function (data) {
                                //debugger
                                var storeNo = data.StoreNo;
                                var posID = data.PosID;
                                var pathFileServer = data.PathFileServer;
                                var jsonString = JSON.stringify(data.ReadFile);
                                var jsonRead = JSON.parse(jsonString);
                                var editor = new JsonEditor('#detail-json', getJson(jsonRead));
                                editor.load(getJson(jsonRead));

                                $('#modal-view-log-file-sale-pos').modal({
                                    backdrop: 'static',
                                    keyboard: true
                                });
                                loading.hideloading();
                            },
                            error: function () {
                                loading.hideloading();
                            }
                        });
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("LogFileSalePOSList", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#sel-set-server").val();
                        d.ServerRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.PosTerminal = $("#sel-pos-terminal").val();
                        d.FromDate = $("#txt-from-date").val();
                        d.ToDate = $("#txt-to-date").val();
                        d.TableName = $("#txt-file-name").val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            debugger
                            var storeNo = row.StoreNo;
                            var pathFile = row.FileName;
                            var ipSvr = row.IpServer;
                            var fileName = row.TableName;
                            var folderBackup = moment(row.CreatedDate).format('YYYYMMDD');
                            var html = '<button type="button" class="btn btn-primary-custom btn-view-file" data-toggle="tooltip" data-placement="left" title="Xem chi tiết" data-id="' + storeNo + '" data-store-no = "' + storeNo + '" data-path-file="' + pathFile + '" data-file-name="' + fileName + '" data-ip-server="' + ipSvr + '" data-folder-backup="' + folderBackup + '" ><i class="fa fa-list" style="color:#fff;"></i></button>';
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "IpServer",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display:block;">' + row.IpServer + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TableName",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;text-align:left;">' + row.TableName + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FileName",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400; display: block;text-align:left;">' + row.FileName + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "MsgError",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display:block;color:#0C713D;">' + row.MsgError + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CreatedDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CreatedDate != null) {
                                html += '<span style="font-weight:700;display:block;">' + moment(row.CreatedDate).format('DD/MM/YYYY hh:mm:ss A') + '</span>';
                            } else {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

        })

    </script>
}


<style>

    #toast-container > .toast-success {
        background-image: none;
        background-color: #e9e9e9;
        color: black;
    }

    #toast-container > .toast-error {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    #toast-container > .toast-warning {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    .btn-primary-custom {
        text-align: center;
        font-size: 12px;
        color: #fff;
        padding-right: 5px;
        padding-left: 10px;
        background-color: #3699FF;
        border-color: #3699FF;
    }


</style>




