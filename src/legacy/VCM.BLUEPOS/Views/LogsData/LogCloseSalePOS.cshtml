@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.LogsData;

@{
    ViewBag.Title = "Log kết thúc ngày tại POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSet = (List<SQLServerModel>)ViewBag.SetDB;

}
<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>
<style>
    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log Central Sales</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log kết thúc ngày tại POS</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "LogsData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetDB">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer" data-serverread="@listSet.FirstOrDefault().IPServerRead">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="POSTerminal"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngày kinh doanh<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-bussiness-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-bussiness-date" name="BussinessDate" placeholder="Ngày kinh doanh">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Chưa đóng ngày</option>
                                            <option value="1">Đã đóng ngày</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" class="btn btn-success" style="" id="btn-sync-data-to-central"><i class="fa fa-sync"></i>Đồng bộ -> Central Sales</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-log-close-pos-sale" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th style="text-align:center"><input type="checkbox" class="chkAll" id="chk-all-store" value="" style="height:20px;width:20px;"></th>
                                    <th>ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>T/G mở ngày</th>
                                    <th>Trạng thái đóng ngày</th>
                                    <th>Thời gian đóng ngày</th>
                                    <th>Người tạo</th>
                                    <th>Ngày tạo</th>
                                    <th>Người cập nhật</th>
                                    <th>T/G cập nhật</th>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {
    <script type="text/javascript">
        var table = "";

        function SyncDataToCentral(jsonBussiness, ipServer) {
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SyncBussinessDateToCentral", "LogsData")',
                type: "POST",
                dataType: "json",
                data: {
                    jsonBussiness: jsonBussiness,
                    ipServer: ipServer
                },
                success: function (response) {
                    if (response.Item1 == true) {
                        toastr.success(response.Item2);
                    }
                    else {
                        toastr.error(response.Item2);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });

        }

        function LoadComboxStoreByServer(ipServer) {
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                            LoadComboxPOSTerminalByStore(data[0].SiteNo);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }         
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxPOSTerminalByStore(storeNo) {
            if (storeNo == null || storeNo == "") {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-pos-terminal').html(html);
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: { StoreNo: storeNo },
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].PosID + "'>" + data[0].PosID + "</option>";
                            $('#sel-pos-terminal').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.PosID != "") {
                                    html += "<option value='" + name.PosID + "'>" + name.PosID + "</option>";
                                }
                            });
                            $('#sel-pos-terminal').html(html);
                        }                        
                    } 
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });

        };


        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-bussiness-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-bussiness-date').datepicker(
            {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            $("#sel-store-no").on("change", function (e) {
                LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            });

            $("#chk-all-store").click(function () {
                if ($("#chk-all-store").is(':checked')) {
                    $('.chkStore').prop('checked', true);
                }
                else {
                    $('.chkStore').prop('checked', false);
                }     
            });

            $("#btn-search").on("click", function (e) {
                table.draw();
                $('#chk-all-store').prop('checked', false);
            });
           
            table = $('#tbl-log-close-pos-sale').DataTable({
                destroy: true,
                deferLoading: 0,
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                
                ajax: {
                    url: '@Url.Action("LogCloseSalePOSList", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#sel-set-server").val();
                        d.ServerRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.BussinessDate = $("#txt-bussiness-date").val();
                        d.IsClosed = $("#sel-status").val();
                        d.PosTerminal = $("#sel-pos-terminal").val();
                    }
                },

                columns: [
                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var StoreNo = row.StoreNo;
                            var posID = row.PosTerminal;
                            var ngaykd = moment(row.BussinessDate).format('YYYY-MM-DD');
                            var isClose = row.IsClosed;
                            var closeDate = moment(row.CloseDate).format('YYYY-MM-DD hh:mm:ss');
                            var closeUser = row.UpdatedUser;
                            if (row.IsClosed == true) {
                                var html = '<input type="checkbox" class="chkStore"  id ="' + StoreNo + '"  value ="' + StoreNo + '"  data-store-no ="' + StoreNo + '"  data-pos ="' + posID + '"  data-ngaykd ="' + ngaykd + '"  data-isclosed ="' + isClose + '"  data-closedate ="' + closeDate + '"  data-closeuser ="' + closeUser + '" style="height:18px;width:18px;">';
                                return html;
                            }
                            return "";
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + row.StoreNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "PosTerminal",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + row.PosTerminal + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BussinessDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;text-align:center;">' + moment(row.BussinessDate).format('DD/MM/YYYY') + '</span>';
                            return html; 
                        }
                    },
                    
                    {
                        data: "OpenDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OpenDate != null) {
                                html = '<span style="font-weight:700; display: block;text-align:center;">' + moment(row.OpenDate).format('DD/MM/YYYY hh:mm:ss A') + '</span>';
                            }
                            else {
                                html = '<span style="font-weight:700; display: block;text-align:center;">' + "" + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsClosed == true) {
                                html = "<span class=\"badge bg-success\" style=\"color: #fff;\">Đã đóng ngày</span>";
                            }
                            else {
                                html = "<span class=\"badge bg-danger\" style=\"color: #fff;\">Chưa đóng ngày</span>";
                            }   
                            return html;
                        } 
                    },

                    {
                        data: "CloseDate",           // T/G đóng ngày
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CloseDate != null) {
                                html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + moment(row.CloseDate).format('DD/MM/YYYY hh:mm:ss A') + '</span>';
                            }
                            else {
                                html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + "" + '</span>'; 
                            }
                            return html;
                        }
                    },

                    {
                        data: "CreatedUser",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400; display: block;text-align:center;">' + row.CreatedUser + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CreatedDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CreatedDate != null) {
                                html = '<span style="font-weight:400; display: block;text-align:center;">' + moment(row.CreatedDate).format('DD/MM/YYYY hh:mm:ss A') + '</span>';
                            } else {
                                html = '<span style="font-weight:400; display: block;text-align:center;">' + "" + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UpdatedUser",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UpdatedUser == null || row.UpdatedUser == "") {
                                html = '<span style="font-weight:700; display: block;text-align:center;">' + "" + '</span>';
                            } else {
                                html = '<span style="font-weight:700; display: block;text-align:center;">' + row.UpdatedUser + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UpdatedDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UpdatedDate != null) {
                                html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + moment(row.UpdatedDate).format('DD/MM/YYYY hh:mm:ss A') + '</span>';
                            } else {
                                html = '<span style="font-weight:700; display: block;text-align:center;color:#0C713D;">' + "" + '</span>';
                            } 
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });


            $("#btn-sync-data-to-central").click(function () {
                var arrayBussinessDate = [];
                $('#tbl-log-close-pos-sale input.chkStore:checkbox:checked').each(function () {
                    //debugger
                    var itemArray = {};
                    var storeNo     = $(this).attr("data-store-no");
                    var posID       = $(this).attr("data-pos");
                    var ngayKD      = $(this).attr("data-ngaykd");
                    var isClose     = $(this).attr("data-isclosed");
                    var closeDate   = $(this).attr("data-closedate");
                    var closeUser   = $(this).attr("data-closeuser");

                    itemArray['StoreNo'] = storeNo;
                    itemArray['PosID'] = posID;
                    itemArray['NgayKD'] = ngayKD;
                    itemArray['IsClosed'] = isClose;
                    itemArray['CloseDate'] = closeDate;
                    itemArray['CloseUser'] = closeUser;
                    arrayBussinessDate.push(itemArray);

                });

                if (arrayBussinessDate.length == 0) {
                    $.alert('Vui lòng chọn Máy POS để đồng bộ', 'Thông báo');
                }
                else {
                    $.confirm({
                        backgroundDismiss: false,
                        escapeKey: true,
                        icon: 'fa fa-warning',
                        type: 'red',
                        typeAnimated: true,
                        title: 'Thông báo',
                        content: 'Bạn có chắc chắn đồng bộ Trạng thái đóng ngày lên CentralSale ?',
                        buttons: {
                            "CÓ": {
                                btnClass: 'btn btn-default',
                                keys: ['ctrl'],
                                action: function () {
                                    var ipSvr = $("#sel-set-server").val();
                                    var jsonBussinessDate = arrayBussinessDate.length > 0 ? JSON.stringify(arrayBussinessDate) : "";
                                    SyncDataToCentral(jsonBussinessDate, ipSvr);
                                }
                            },

                            "KHÔNG": {
                                btnClass: 'btn-default',
                                action: function () { }
                            }
                        }
                    });
                }
            });





            
        })

    </script>
}













<style>

    #toast-container > .toast-success {
        background-image: none;
        background-color: #e9e9e9;
        color: black;
    }

    #toast-container > .toast-error {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    #toast-container > .toast-warning {
        background-image: none;
        /*background-color: #FCF8E3;*/
        background-color: #e9e9e9;
        /*color: #996D3B;*/
        color: red;
    }
</style>




