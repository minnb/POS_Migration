@using VCM.BLUEPOS.Model.Bank;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Danh sách mã lỗi E-Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Logs E-Invoice</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh sách mã lỗi E-Invoice</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "LogsData", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Tìm kiếm</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-search-error" name="SearchError" placeholder="Nhập mã lỗi...">
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-e-invoice-error-logs" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>ID</th>
                                    <th>Mã lỗi</th>
                                    <th>Mã lỗi đầy dủ</th>
                                    <th>Nội dung lỗi</th>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section scripts {
    <script type="text/javascript">
        var table;
        $('#txt-search-error').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $(document).ready(function () {
            $(".select2").select2();
            table = $('#tbl-e-invoice-error-logs').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: false,                // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                ajax: {
                    url: '@Url.Action("LoadAPIErrorMapping", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.eRRCode = $('#txt-search-error').val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }

                    },

                    {
                        data: "ID",
                        className: "text-center"
                    },

                    {
                        data: "ERRCode",
                        render: function (data, type, row) {
                            var _errCode = row.ERRCode;
                            return '<span style="display: block; font-weight: 700;">' + _errCode + '</span>';
                        }
                    },

                    {
                        data: "ERRFull"
                    },

                    {
                        data: "ERRMSG"
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('#tbl-e-invoice-error-logs tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                table.draw();
            });

        })

    </script>
}













<style>

    #toast-container > .toast-success {
        background-image: none;
        background-color: #e9e9e9;
        color: black;
    }

    #toast-container > .toast-error {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    #toast-container > .toast-warning {
        background-image: none;
        /*background-color: #FCF8E3;*/
        background-color: #e9e9e9;
        /*color: #996D3B;*/
        color: red;
    }
</style>




