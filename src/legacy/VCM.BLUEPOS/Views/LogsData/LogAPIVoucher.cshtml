@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.LogsData;

@{
    ViewBag.Title = "Log API Voucher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>
<style>
    #detail-json {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Log</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log API</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Log API Voucher</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold">Môi trường</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="slProd" name="PROD">
                                            <option value="srvUAT">POS Phúc Long</option>
                                            <option value="srvPROD">POS Odoo</option>

                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold;">Từ ngày<strong style="color:#ff0000">(*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold">Đến ngày<strong style="color:#ff0000">(*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold;">Mã CH/ST/POS</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="txtStoreNo" name="StoreNo" placeholder="Nhập mã CH/ST hoặc POS...">
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold">Partner</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="slPartner" name="Partner">
                                            <option value="">Tất cả</option>
                                            <option value="PLG">Phúc Long</option>
                                            <option value="UrBox">UrBox</option>
                                            <option value="GotIt">GotIt</option>
                                            <option value="GiftBox">GiftBox</option>

                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold">Loại API</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="slActionType" name="POSID">
                                            <option value="">Tất cả</option>
                                            <option value="GetInfoCard">Tra cứu voucher</option>
                                            <option value="CreateVchCpn">Tạo voucher/coupon</option>
                                            <option value="SaleVoucher">Bán voucher</option>
                                            <option value="RedeemVoucher">Sử dụng voucher</option>
                                            <option value="ActiveVoucher">Kích hoạt voucher</option>
                                            <option value="SAPCheckCoupon">Tra cứu coupon</option>
                                            <option value="SAPRedeemCoupon">Sử dụng coupon</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-weight: bold;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txtKeyWord" name="KeyWord" placeholder="Nhập số serial...">
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-loyalty-cx-log-api" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Partner</th>
                                    <th>ST/CH</th>
                                    <th>POS</th>
                                    <th>Serial</th>
                                    <th>Loại API</th>
                                    <th>RequestPOS</th>
                                    <th>RequestPartner</th>
                                    <th>ResponsePartner</th>
                                    <th>TimeResponsePartner</th>
                                    <th>CreatedDate</th>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-detail-json">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="title-result" class="modal-title">THÔNG TIN REQUEST POS</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div id="detail-json" style="display:block"></div>
                <div id="formatJsonError" style="display:none"></div>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnCopy" class="btn btn-primary font-weight-bold"><i class="la la-copy"></i>Copy</button>
                <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal" id="close-modal-detail-json"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        function getJson(json) {
            debugger
            try {
                $("#formatJsonError").css("display", "none");
                $("#detail-json").css("display", "block");
                return JSON.parse(json);
            } catch (ex) {
                $('#detail-json').css("display", "none");
                $("#formatJsonError").css("display", "block");
                $('#formatJsonError').html(json);
            }
        }
        $("#btnCopy").on("click", function () {
            copyToClipboard('#detail-json');
        });

        function copyToClipboard(element) {
            var $temp = $("<input>");
            $("body").append($temp);
            $temp.val($(element).text()).select();
            document.execCommand("copy");
            $temp.remove();
        }


        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
            });

            table = $('#tbl-loyalty-cx-log-api').DataTable({

                drawCallback: function (settings) {

                    // Xem chi tiet Request-POS
                    $(".btn-search-request-pos").click(function () {
                        $('#detail-json').empty();
                        debugger
                        var _id = $(this).attr("data-id");
                        var _requestPOS = $(this).data("requestpos");
                        var jsonResPOS = JSON.parse(_requestPOS);
                        $("#title-result").html("REQUEST POS");
                        loading.showloading();

                        var editor = new JsonEditor('#detail-json', getJson(jsonResPOS));
                        editor.load(getJson(jsonResPOS));

                        $('#modal-detail-json').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                        loading.hideloading();
                    });

                    // Xem chi tiet Request-XML
                    $(".btn-search-request-XML").click(function () {
                        $('#detail-json').empty();
                        var _id = $(this).attr("data-id");
                        var _requestcx = $(this).data("requestcx");
                        var jsonResCX = JSON.parse(_requestcx);
                        $("#title-result").html("REQUEST PARTNER");
                        loading.showloading();
                        var editor = new JsonEditor('#detail-json', getJson(jsonResCX));
                        editor.load(getJson(jsonResCX));

                        $('#modal-detail-json').modal({
                            backdrop: 'static',
                            keyboard: true
                        });
                        loading.hideloading();
                    });

                    // Xem chi tiet Response-XML
                    $(".btn-search-response-XML").click(function () {
                        $('#detail-json').empty();
                        var _responsecx = $(this).data("responsecx");
                        var jsonResponseCX = JSON.parse(_responsecx);
                        $("#title-result").html("RESPONSE PARTNER");
                        loading.showloading();
                        var editor = new JsonEditor('#detail-json', getJson(jsonResponseCX));
                        editor.load(getJson(jsonResponseCX));

                        $('#modal-detail-json').modal({
                            backdrop: 'static',
                            keyboard: true
                        });
                        loading.hideloading();
                    });
                },
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: true, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("LoadLogAPIVoucher", "LogsData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = $('#txt-from-date').val();
                        d.toDate = $('#txt-to-date').val();
                        d.storeNo = $('#txtStoreNo').val();
                        d.ActionType = $('#slActionType').val();
                        d.Keyword = $('#txtKeyWord').val();
                        d.Prod = $("#slProd").val();
                        d.Partner = $("#slPartner").val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "Parner",
                        className: "text-center"
                    },

                    {
                        data: "StoreNo",
                        className: "text-center"
                    },

                    {
                        data: "POSTerminal",
                        className: "text-center"
                    },

                    {
                        data: "SerialNumber",
                        className: "text-center",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.SerialNumber + '</span>';
                        }
                    },

                    {
                        data: "ActionType",
                        render: function (data, type, row) {
                            var actionType = row.ActionType;
                            var html = ""
                            if (actionType =="GetInfoCard") {
                                html = "Tra cứu voucher";
                            }
                            else if (actionType == "SaleVoucher") {
                                html = "Bán voucher";
                            }
                            else if (actionType == "RedeemVoucher") {
                                html = "Sử dụng voucher";
                            }
                            else if (actionType == "ActiveVoucher") {
                                html = "Kích hoạt voucher";
                            }
                            else if (actionType == "CheckCoupon") {
                                html = "Tra cứu coupon";
                            }
                            else {
                                html = actionType;
                            }
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var _id = row.ID;
                            var _requestPOS = row.PosRequest;
                            var jsonResPOS = JSON.stringify(_requestPOS);

                            var html = "<button type=\"button\" class=\"btn btn-primary btn-search-request-pos\" data-toggle=\"tooltip\" data-placement=\"left\" title=\"Xem chi tiết\" data-requestpos='" + jsonResPOS + "' data-id=\"" + _id + "\" style=\"color:#ffffff;\"><i class=\"fa fa-list\"></i></button>";
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var _id = row.ID;
                            var _requestCX = row.PartnerRequest;
                            var jsonResCX = JSON.stringify(_requestCX);
                            var html = "<a class=\"btn btn-success btn-search-request-XML\"  title=\"Xem chi tiết\" data-requestcx='" + jsonResCX + "' data-id='" + _id + "' style=\"color:#ffffff;\"><i class=\"fa fa-list\"></i></a>"
                            return html;
                        }
                    },

                    {
                        className: "text-center",
                        render: function (data, type, row) {
                            var _id = row.ID;
                            var _responseCX = row.PartnerResponse;
                            var jsonResponseCX = JSON.stringify(_responseCX);
                            var html = "<button type=\"button\" class=\"btn btn-warning btn-search-response-XML\" data-toggle=\"tooltip\" data-placement=\"left\" title=\"Xem chi tiết\" data-responsecx='" + jsonResponseCX + "' data-id='" + _id + "' style =\"color:#ffffff;\"><i class=\"fa fa-list\"></i></button>";
                            return html;
                        }
                    },

                    {
                        data: "ResponseTotal",
                        className: "text-center"
                    },

                    {
                        data: "CreatedDate",
                        render: function (data, type, full, meta) {
                            if (full.CreatedDate != null) {
                                return moment(full.CreatedDate).format("DD/MM/YYYY HH:mm:ss");
                            }
                            else
                                return "";
                        },
                        className: "text-center"
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

                });


            $("#btn-search").on("click", function (e) {
                table.draw();
            });
        })

    </script>
}













<style>

    #toast-container > .toast-success {
        background-image: none;
        background-color: #e9e9e9;
        color: black;
    }

    #toast-container > .toast-error {
        background-image: none;
        background-color: #e9e9e9;
        color: red;
    }

    #toast-container > .toast-warning {
        background-image: none;
        /*background-color: #FCF8E3;*/
        background-color: #e9e9e9;
        /*color: #996D3B;*/
        color: red;
    }
</style>




