@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo kết ca"; 
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo kết ca</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelShiftEndReportPLG", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer"  data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer"  data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngày kinh doanh<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="searchFromDate">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="searchFromDate" name="BussinessDate" placeholder="Ngày kinh doanh">
                                        </div>
                                    </div>

                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">POSID/Ca<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" placeholder="POSID/Ca" style="width:100%;" id="txt-pos-id" name="Keyword" />
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="" selected>Tất cả</option>
                                            <option value="0">Chưa đóng ca</option>
                                            <option value="1">Đã đóng ca</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary btn-search" style="" id="btn-search"><i class="fa fa-search"></i>Tìm</button>
                                        <button type="submit" class="btn btn-success" id="btn-export-excel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i>Xuất Excel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered" id="tbl-report-shift-end-plg">
                            <thead>
                                <tr style="text-align:center;text-transform:uppercase;">
                                    <th>ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>Ca</th>
                                    <th>Tiền đầu ca</th>
                                    <th>Tiền mặt</th>
                                    <th>Tiền hệ thống</th>
                                    <th>Chênh lệch</th>
                                    <th>T/G đóng ca</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section scripts {
    <script type="text/javascript">

        var table; 

        function LoadComboxStoreByServer(ipServer) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].ValueJson + "'  data-storeNo='" + data[0].SiteNo + "'>" + data[0].DisplayCombo + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.ValueJson + "'  data-storeNo='" + name.SiteNo + "'>" + name.DisplayCombo + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


