    function LoadReport() {
            table = $('#tbl-report-shift-end-plg').DataTable({               
                drawCallback: function (settings) {
                    // Xem chi tiet
                    $(".btn-search-detail").click(function () {
                        var storeNo = $(this).attr("data-storeNo");
                        var dateBussiness = $("#searchFromDate").val();
                        ViewDetail(storeNo, dateBussiness);
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              
                serverSide: true,               
                filter: false,                  
                orderMulti: false,
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                info: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("LoadShiftEndReportPLG", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#sel-set-server").val();
                        d.ServerRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.BussinessDate = $("#searchFromDate").val();
                        d.PosTerminal = $("#txt-pos-id").val();
                        d.IsShiftClosed = $("#sel-status").val();
                    }
                },

                columns: [
                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.StoreNo + '</span>';
                            }                           
                            return html;
                        }
                    },

                    {
                        data: "PosTerminal",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PosTerminal == null || row.PosTerminal == "") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block;">' + row.PosTerminal + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "FormatBussinessDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.FormatBussinessDate + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ShiftNumber",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.ShiftNumber + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BeginAmount",  // Tiền đầu ca
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + parseFloat(row.BeginAmount).toLocaleString('en') + '</span>';
                            return html;
                        } 
                    },

                    {
                        data: "CloseAmount",  // Tiền mặt
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + parseFloat(row.CloseAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AmountTendered",  // Tiền hệ thống
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + parseFloat(row.AmountTendered).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BlanceMoney",  // Chênh lệch
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + parseFloat(row.BlanceMoney).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "FormatCloseShiftDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.FormatCloseShiftDate + '</span>';
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsShiftClosed == 1)
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đã đóng ca</span>";
                            else
                                html += "<span class=\"badge\" style=\"color: #fff;background-color:#DC3545;\">Chưa đóng ca</span>";
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
    }


    $(document).ready(function () {

        $('.select2').select2();
        const startOfMonth = moment().clone().startOf('month');
        $('#searchFromDate').val(moment().format('DD/MM/YYYY'));

        $('#searchFromDate').datepicker(
        {
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
        });

        //LoadComboxStoreByServer($("#sel-set-server").val());
        //$("#sel-set-server").on("change", function (e) {
        //    //debugger
        //    LoadComboxStoreByServer($("#sel-set-server").val());
        //});

        LoadComboxStoreByServer($("#sel-set-server").val());
        $("#sel-set-server").on("change", function (e) {
            //debugger
            LoadComboxStoreByServer($("#sel-set-server").val());
        });

        LoadReport();

        $("#btn-search").on("click", function (e) {
            table.draw();
        });

        $("#frm-export-excel").submit(function (e) {
                debugger
                loading.showloading();
                e.preventDefault(); 
            
                var serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                var storeNo = $("#sel-store-no").val();
                var ngayKD = $("#searchFromDate").val();
                var search = $("#txt-pos-id").val();
                var status = $("#sel-status").val();

                var req = new XMLHttpRequest();
                var url = '/Report/ExportExcelShiftEndReportPLG?SetServer=' + serverRead + '&SiteNo=' + storeNo + '&BussinessDate=' + ngayKD + '&Keyword=' + search + '&Status=' + status;               
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "ShiftPLG_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });
    });


    </script>
}