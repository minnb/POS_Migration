            $("#btn-search").on("click", function (e) {
                //debugger
                var a1 = $('#from-date-selected').val();
                var b1 = $('#to-date-selected').val();
                var c1 = $('#from-date-comparison').val();
                var d1 = $('#to-date-comparison').val();
                if (a1 == "" || b1 == "" || c1 == "" || d1 == "") {
                    toastr.error('Vui lòng chọn từ ngày / đến ngày');
                    return;
                }

                var fromDate = getFromDateV1();
                var toDate = getToDateV1();            
                if (fromDate > toDate) {
                    toastr.error('Từ ngày không lớn hơn đến ngày');
                    return;
                }

                var fromDateComparison = getFromDateV2();
                var toDateComparison = getToDateV2();
                if (fromDateComparison > toDateComparison) {
                    toastr.error('Từ ngày không lớn hơn đến ngày');
                    return;
                }

                // Hoa - PL :: yeu cau khong rang buoc dk nay

                //if (fromDateComparison < fromDate) {
                //    toastr.error('Start date Comparison phải lớn hơn (hoặc bằng) Start date Selected');
                //    return;
                //}

                var a = parseDate($('#to-date-selected').val()).getTime();
                var b = parseDate($('#from-date-selected').val()).getTime();
                var checkDay = Math.ceil((a - b) / (24 * 60 * 60 * 1000));

                if (checkDay > 31) {
                    toastr.error('Do dữ liệu quá lớn, Vui lòng xem báo cáo trong thời gian tối đa 31 ngày');
                    return;
                }

                table.draw();

            });

            $("#btn-export-excel").on("click", function (e) {
                //debugger
                var a1 = $('#to-date-selected').val();
                var b1 = $('#from-date-selected').val();

                var c1 = $('#from-date-comparison').val();
                var d1 = $('#to-date-comparison').val();

                if (a1 == "" || b1 == "" || c1 == "" || d1 == "") {
                    toastr.error('Vui lòng chọn từ ngày / đến ngày');
                    return;
                }

                var fromDate = getFromDateV1();
                var toDate = getToDateV1();

                if (fromDate > toDate) {
                    toastr.error('Từ ngày (FromSelectedDate) không lớn hơn đến ngày (ToSelectedDate)');
                    return;
                }

                var fromDateComparison = getFromDateV2();
                var toDateComparison = getToDateV2();

                if (fromDateComparison > toDateComparison) {
                    toastr.error('Từ ngày (FromComparisonDate) không lớn hơn đến ngày (ToComparisonDate)');
                    return;
                }

                var a = parseDate($('#to-date-selected').val()).getTime();
                var b = parseDate($('#from-date-selected').val()).getTime();
                var checkDay = Math.ceil((a - b) / (24 * 60 * 60 * 1000));

                if (checkDay > 31) {
                    toastr.error('Do dữ liệu quá lớn, Vui lòng xem báo cáo trong thời gian tối đa 31 ngày');
                    return;
                }

                var fromDateSelected = getFromDateSelected();
                var toDateSelected = getToDateSelected();

                var fromDateComparison = getFromDateComparison();
                var toDateComparison = getToDateComparison();

                $('#hd-from-date-selected').val(fromDateSelected);
                $('#hd-to-date-selected').val(toDateSelected);

                $('#hd-from-date-comparison').val(fromDateComparison);
                $('#hd-to-date-comparison').val(toDateComparison);
                var storeNo = JSON.stringify($('#sel-store-no').val());

                $('#frm-export-excel').submit();

            });

