@section Scripts
{
    <script type="text/javascript">

        var table;

        function LoadComboxStore(channelSales) {
                //debugger
            if (channelSales == "WINLIFE")
            {
                loading.showloading();
                var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-store-no" name="StoreNo">';
                $.ajax({
                url: '@Url.Action("LoadComboxStoreNoByWinLife", "Common")',
                type: "POST",
                dataType: "json",
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.StoreNoPLH != "") {
                                html += "<option value=" + name.StoreNoPLH + ">" + name.StoreNoWCM + " - " + name.StoreNoPLH + " - " + name.StoreNamePLH + "</option>";
                                //html += "<option value=" + name.StoreNoPLH + ">" + name.StoreNoPLH + " - " + name.StoreNoWCM + " - " + name.StoreNamePLH + "</option>";
                            }
                        });
                        html += '</select>';
                        $("#div-store-no").html(html);

                        $('#sel-store-no').fSelect({
                            placeholder: 'All',
                            numDisplayed: 1,
                            overflowText: '{n} Cửa hàng được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy cửa hàng',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true,
                            includeSelectAllOption: true
                        });
                    }
                },
                error: function () {
                }
                });
            }
            else
            {
                loading.showloading();
                var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-store-no" name="StoreNo">';
                $.ajax({
                url: '@Url.Action("LoadComboxStoreByUserChannel", "Common")',
                type: "POST",
                dataType: "json",
                data: {
                    channelSales: channelSales
                },
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value=" + name.SiteNo + ">" + name.SiteNo + "-" + name.SiteName + "</option>";
                            }
                        });
                        html += '</select>';
                        $("#div-store-no").html(html);

                        $('#sel-store-no').fSelect({
                            placeholder: 'All',
                            numDisplayed: 1,
                            overflowText: '{n} Cửa hàng được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy cửa hàng',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true,
                            includeSelectAllOption: true
                        });
                    }
                },
                error: function () {
                }
                });
            }
        }

        function getFromDateV1() {
            var result = "";
            var fromDate = $('#from-date-selected').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];   // dd/MM/yyyy
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDateV1() {
            var result = "";
