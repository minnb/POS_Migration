@using VCM.BLUEPOS.Model.Report
@{
    var model = Model as List<SaleUsedCupModel>;

}
@if (model != null && model.Count > 0)
{
    List<string> listBackground = new List<string>(new string[] { "#FFFFFF", "#dee3ef" });
    int b = 0;
    var listSize = model.GroupBy(d => new { Size = d.Size }).Select(a => new { Size = a.Key.Size }).ToList();
    var listShift = model.GroupBy(d => new { ShiftCode = d.ShiftNo }).Select(a => new { ShiftCode = a.Key.ShiftCode }).OrderBy(d => d.ShiftCode).ToList();
    <style>
        .detailSize:hover {
            background-color: yellow;
        }
    </style>

    <table class="table table-bordered text-nowrap" id="tblData">
        <thead>
            <tr style="text-align:center">
                <th> Ca </th>
                <th> Mã sản phẩm</th>
                <th>Tên sản phẩm</th>
                @if (listSize.Count > 0)
                {
                    foreach (var size in listSize)
                    {
                        <th>Size @size.Size</th>
                    }
                }
                <th>Tổng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var shift in listShift)
            {

                var listItem = model.Where(d => d.ShiftNo == shift.ShiftCode).GroupBy(d => new { d.StoreNo,d.BussinessDate, d.ItemNo, d.Description })
                .Select(a => new
                {
                    StoreNo = a.Key.StoreNo,
                    BussinessDate = a.Key.BussinessDate,
                    ItemNo = a.Key.ItemNo,
                    ItemName = a.Key.Description

                }).ToList();

                if (b > 1)
                {
                    b = 0;
                }

                var rowspan = "rowspan=" + (listItem.Count + 1) + "";
                var backColor = "background-color:" + listBackground[b];
                <tr>
                    <th @rowspan style="@backColor;vertical-align:middle;text-align:center"> @shift.ShiftCode </th>
                </tr>
                b++;

                foreach (var item in listItem)
                {
                    <tr style="@backColor">
                        <td class="text-center">@item.ItemNo</td>
                        <td>@item.ItemName</td>
                        @if (listSize.Count > 0)
                        {
                            foreach (var size in listSize)
                            {
                                var checkQtt = model.FirstOrDefault(d => d.ItemNo == item.ItemNo && d.Size == size.Size && d.ShiftNo == shift.ShiftCode);
                                var quantity = checkQtt == null ? 0 : checkQtt.Quantity;
                                <td class="text-center detailSize" data-store="@item.StoreNo" data-bussinessdate="@item.BussinessDate" data-size="@size.Size" data-itemcup="@item.ItemNo" data-shiftno="@shift.ShiftCode" style="font-weight:bold;cursor:pointer">@quantity</td>
                            }
                        }
                        <td class="text-center" style="font-weight:bold;color:Blue;@backColor">
                            @{
                                var checkTotalQty = model.Where(d => d.ItemNo == item.ItemNo && d.ShiftNo == shift.ShiftCode);
                                var totalQty = checkTotalQty == null ? 0 : checkTotalQty.Sum(d => d.Quantity);

                            }
                            @totalQty
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
}
else
{
    <strong style="font-size:16px;color:red">Không có dữ liệu</strong>
}

    <div class="modal fade" id="modalDetailCup">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span id="titleDetailCup" style="font-weight:bold">DANH SÁCH CHI TIẾT LY</span></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body" id="divPopupDetailCup">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
                </div>
            </div>
        </div>
    </div>


    <script type="text/javascript">
        $(document).ready(function () {
            
            $(".detailSize").on("click", function (e) {
                var storeNo = $(this).attr("data-store");
                var bussinessdate = $(this).attr("data-bussinessdate");//yyyy-MM-dd
                var size = $(this).attr("data-size");
                var itemCup = $(this).attr("data-itemcup");
                var shiftNo = $(this).attr("data-shiftno");

                loading.showloading();
                $.ajax({
                    type: "GET",
                    url: "/Report/_ViewReportCupDetail?storeNo=" + storeNo + "&ngayKD=" + bussinessdate + "&shiftCode=" + shiftNo + "&itemCup=" + itemCup + "&size=" + size + "",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {   

                        $("#titleDetailCup").html("DANH SÁCH CHI TIẾT - CỬA HÀNG:" + storeNo + " - CA:" + shiftNo + " - SIZE:" + size + " - LY:" + itemCup + "");

                        $("#divPopupDetailCup").html(result);

                        $('#modalDetailCup').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });

            });

            
        });
    </script>
