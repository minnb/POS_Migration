        function getFromDateTab1() {
            var result = "";
            var fromDate = $('#tab1-txt-from-date').val();
            if (fromDate != null && fromDate != "")
            {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else
            {
                result = "";
            }
            return result;
        }

        function getToDateTab1() {
            var result = "";
            var toDate = $('#tab1-txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

