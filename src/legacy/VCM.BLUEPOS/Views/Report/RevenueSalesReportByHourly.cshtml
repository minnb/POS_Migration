                    var api = this.api();
                    var sum = 0;
                    var formated = 0;

                    //to show first th
                    //var str = '<span style="text-align:right;">'+ "Total by Sales Type:" + '</span>';
                    //$(api.column(0).footer()).html(str);

                    $(api.column(0).footer()).html('');
                    
                    for (var i = 8; i <= 31; i++) {
                        sum = api.column(i, { page: 'current' }).data().sum();

                        //to format this sum
                        //formated = parseFloat(sum).toLocaleString(undefined, { minimumFractionDigits: 2 });
                        //$(api.column(i).footer()).html('$' + formated);

                        formated = parseFloat(sum).toLocaleString('en');
                        $(api.column(i).footer()).html(formated);
                        
                    }
