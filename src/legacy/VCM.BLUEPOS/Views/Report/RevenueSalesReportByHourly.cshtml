@section Scripts
{
    <script type="text/javascript">

        var table;

        function LoadComboxStore() {
            //debugger
            var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-store-no" name="StoreNo">';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxStoreNoByUser", "Common")',
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                    data.forEach((name, i) => {
                        if (name.SiteNo != "") {
                            html += "<option value=" + name.SiteNo + ">" + name.SiteNo + "-" + name.SiteName + "</option>";
                        }
                    });
                    html += '</select>';
                    $("#div-store-no").html(html);

                    $('#sel-store-no').fSelect({
                        placeholder: '---- Chọn ----',
                        numDisplayed: 1,
                        overflowText: '{n} Cửa hàng được chọn',
                        searchText: 'Tìm kiếm....',
                        noResultsText: 'Không tìm thấy cửa hàng',
                        showSearch: true,
                        optionFormatter: false,
                        isSelectAll: true,
                        includeSelectAllOption: true
                    });
                    }
                },
                error: function () {
                }
            });
        }

        function LoadComboxSalesType() {
            //debugger
            var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-sales-type" name="SalesType">';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadSalesTypeByMultipleCheck", "Common")',
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.Code != "") {
                                html += "<option value=" + name.Code + ">" + name.Description + "</option>";
                            }
                        });
                        html += '</select>';
                        $("#div-sales-type").html(html);

                        $('#sel-sales-type').fSelect({
                            placeholder: '---- Chọn ----',
                            numDisplayed: 1,
                            overflowText: '{n} Sales type được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy sales type',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true,
                            includeSelectAllOption: true
                         });
                    }
                },
                error: function () {
                }
            });
        }

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];   // dd/MM/yyyy
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];   // dd/MM/yyyy
            }
            else {
                result = "";
            }
            return result;
        }

        function getFromDateStr() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "-" + fromDate.split('/')[1] + "-" + fromDate.split('/')[0];  // yyyy-MM-dd
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDateStr() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "-" + toDate.split('/')[1] + "-" + toDate.split('/')[0];  // yyyy-MM-dd
            }
            else {
                result = "";
            }
            return result;
        }

        function parseDate(str) {
            var mdy = str.split('/');
            return new Date(mdy[2], mdy[1], mdy[0]);
        };

        function ExportToExcel() {
            //debugger
            var fromDate = getFromDateStr();
            var toDate = getToDateStr();
            var storeNo = JSON.stringify($('#sel-store-no').val());
            var salesType = $('#sel-sales-type').val();
            loading.showloading();
            $.ajax({
                url: '@Url.Action("ExportExcel_GetRevenueSalesByHourly", "Report")',
                type: "POST",
                datatype: "json",
                data: {
                    FromDate: fromDate,
                    ToDate: toDate,
                    StoreNo: storeNo,
                    SalesType: salesType
                },
                success: function (data) {
                    loading.hideloading();
                    window.location = '/Report/DownloadFile?fileName=' + data;
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


    $(document).ready(function () {

            $('.select2').select2();
            LoadComboxStore();
            LoadComboxSalesType();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
