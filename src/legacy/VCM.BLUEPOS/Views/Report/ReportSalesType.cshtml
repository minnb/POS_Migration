@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo hình thức bán hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var model = Model as ViewSalesTypeModel;
    var lstStore = model.ListStore;
    var listSet = model.SetDB;
    var listSalesType = ViewBag.ListSalesType as List<OptionDataModel>;

}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo hình thức bán hàng</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="slSetDB" name="setDB">  
                                        @if (listSet != null && listSet.Count > 0)
                                        {
                                            if (listSet.Count == 1)
                                            {
                                                <option value="@listSet.FirstOrDefault().IPServer">@listSet.FirstOrDefault().Description</option>
                                            }
                                            else
                                            {
                                                foreach (var item in listSet)
                                                {
                                                    <option value="@item.IPServer">@item.Description</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slSiteNo" name="listStore">
                                        @if (lstStore != null && lstStore.Count() > 0)
                                        {
                                            if (lstStore.Count == 1)
                                            {
                                                var ht = $"{lstStore.FirstOrDefault().SiteNo} : {lstStore.FirstOrDefault().SiteName}";
                                                <option value="@lstStore.FirstOrDefault().SiteNo" data-array="@lstStore.FirstOrDefault().ValueJson">@ht</option>
                                            }
                                            else
                                            {
                                                <option value="-" selected>Tất cả</option>
                                                foreach (var item in lstStore)
                                                {
                                                    var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : (item.SiteNo + ":" + item.SiteName);
                                                    <option value="@item.SiteNo" data-array="@item.ValueJson">@storeName</option>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <option value="Not" data-array="Not">Không tìm thấy CH/ST</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Từ ngày</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Đến ngày</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Hình thức bán hàng</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slSalesType" name="salesType">
                                        @if (listSalesType != null && listSalesType.Count > 0)
                                        {
                                            if (listSalesType.Count == 1)
                                            {
                                                <option value="@listSalesType.FirstOrDefault().Code">@listSalesType.FirstOrDefault().Description</option>
                                            }
                                            else
                                            {
                                                <option value="" selected>Tất cả</option>
                                                foreach (var item in listSalesType)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="margin-top:25px">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary" id="btnSearch"><i class="fa fa-search"></i> Tìm</button>
                                    <button type="button" class="btn btn-success" id="btnExcelSalesType"><i class="fa fa-file-excel"></i> Xuất excel</button>
                                </div>
                            </div>
                        </div>

                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <table class="table table-bordered table-hover text-nowrap" id="tblData">
                                    <thead>
                                        <tr style="text-align:center">
                                            <th>Mã cửa hàng</th>
                                            <th>Hình thức bán hàng</th>
                                            <th>Tổng doanh thu</th>
                                            <th>Tổng hóa đơn</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var table;

        $(document).ready(function () {

            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#slSetDB").val());
            $("#slSetDB").on("change", function (e) {
                LoadComboxStoreByServer($("#slSetDB").val());
            });

            $("#btnSearch").on("click", function (e) {
                table.draw();
            });

            $("#btnExcelSalesType").on("click", function (e) {
                //debugger
                var storeNo = $('#slSiteNo').val();
                var listStore = "";
                if (storeNo == "-") {
                    listStore = "";
                }
                else {
                    var selectedStore = $('#slSiteNo option:selected').attr('data-array');
                    listStore = selectedStore;
                }

                var setDB = $("#slSetDB").val();
                var tuNgay = $("#searchFromDate").val();
                var denNgay = $("#searchToDate").val();
                var salesType = $("#slSalesType").val();

                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();

                var url = "/Report/ReportSalesTypeExcel?setDB=" + setDB + "&listStore=" + listStore + "&TuNgay=" + tuNgay + "&DenNgay=" + denNgay + "&salesType=" + salesType + "";
                //var url = "/Report/ReportSalesTypeExcel?" + $(this).serialize();

                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "SalesType_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };

                req.send();

            });

            table = $('#tblData').DataTable({             
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,      // for show progress bar
                serverSide: true,       // for process server side
                filter: true,           // this is for disable filter (search box)
                orderMulti: false,      // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: true,
                scrollX: true,
                deferLoading: 0,
                drawCallback: function (settings) {
                },

                ajax: {
                    url: '@Url.Action("ReportSalesTypeLoad", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        var listStore = $('#slSiteNo option:selected').attr('data-array');
                        d.StoreNo = listStore;
                        d.SetDB = $("#slSetDB").val();
                        d.TuNgay = $("#searchFromDate").val();
                        d.DenNgay = $("#searchToDate").val();
                        d.SalesType = $("#slSalesType").val();
                    }
                },

                drawCallback: function (settings) {
                    //debugger
                    var api = this.api();
                    var rows = api.rows().nodes();
                    var last = null;
                    var rowDataByStore = api.rows().data();

                    api.column(0).data().each(function (group, i) {
                        //debugger
                        if (last !== group) {

                            var rowData = api.row(i).data();

                            sumAmount = rowDataByStore.filter(d => d.StoreNo === group).reduce(function (s, a) {
                                return s + a.SalesAmount;
                            }, 0);

                            sumOrder = rowDataByStore.filter(d => d.StoreNo === group).reduce(function (s, a) {
                                return s + a.TotalOrder;
                            }, 0);

                            $(rows).eq(i).before(
                                '<tr class="group">'
                                + '<td colspan = "2" style = "background:#f2f2f2;font-weight:700;font-size:13px;color:#333333;text-align:left;"> ' + rowData.StoreNo + " - " + rowData.StoreName + '</td>'
                                + '<td colspan = "1" style = "background:#f2f2f2;font-weight:700;font-size:13px;color:#333333;text-align:right;"> ' + parseFloat(sumAmount).toLocaleString('en') + '</td>'
                                + '<td colspan = "1" style = "background:#f2f2f2;font-weight:700;font-size:13px;color:#333333;text-align:right;"> ' + parseFloat(sumOrder).toLocaleString('en') + '</td>'

                                + '</tr>'
                            );
                            last = group;
                        }
                    });
                },
                columns: [
                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },

                    {
                        data: "SalesTypeName"
                    },
                    
                    {
                        data: "SalesAmount",
                        className: 'text-right',
                        render: function (data, type, full, meta) {
                            if (full.SalesAmount != null) {
                                return parseFloat(full.SalesAmount).toLocaleString('en')
                            }
                            else
                                return "";
                        },
                    },

                    {
                        data: "TotalOrder",
                        className: 'text-right',
                        render: function (data, type, full, meta) {

                            if (full.TotalOrder != null) {
                                return parseFloat(full.TotalOrder).toLocaleString('en')
                            }
                            else
                                return "";
                        },
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

        });

        function LoadComboxStoreByServer(ipServer) {
            $("#slSiteNo").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    var html = "";
                    if (data != null) {
                        if (data.length > 0) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "' data-array='" + name.ValueJson + "'>" + name.DisplayComboSite + "</option>";
                            });
                        }
                        else {
                            html = "<option value='Not' data-array='Not'>Không tìm thấy CH/ST</option>";
                        }
                    }
                    $('#slSiteNo').html(html);      
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }
    </script>
}

