@using VCM.BLUEPOS.Model.Order;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "BC TH theo phương thức thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listPaymentType = ViewBag.ListPaymentType as List<OptionDataModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">BC TH theo phương thức thanh toán</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_PaymentOrderSalesGeneralList", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Phương thức thanh toán<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-tender-type" name="TenderType">
                                            @if (listPaymentType != null && listPaymentType.Count > 0)
                                            {
                                                if (listPaymentType.Count == 1)
                                                {
                                                    <option value="@listPaymentType.FirstOrDefault().Code">@listPaymentType.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listPaymentType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                @*<div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Phương thức thanh toán<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-tender-type" name="TenderType">
                                            @if (listPaymentType != null && listPaymentType.Count > 0)
                                            {
                                                if (listPaymentType.Count == 1)
                                                {
                                                    <option value="@listPaymentType.FirstOrDefault().Value">@listPaymentType.FirstOrDefault().Text</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listPaymentType)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>*@

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-general-payment-order-sales-report" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th>STT</th>
                                    <th>ST/CH</th>
                                    <th>Tên ST/CH</th>
                                    <th>Ngày thanh toán</th>
                                    <th>Phương thức thanh toán</th>
                                    <th>Doanh thu</th>
                                    <th>Số lượng bill</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        var table;

        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            if (ipServer == null || ipServer == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-store-no').html(html);
            }             
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }                    
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                    loading.hideloading();
                }
            });
        }

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            table = $('#tbl-general-payment-order-sales-report').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("PaymentOrderSalesGeneralList", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                        d.setServer = $('#sel-set-server').val();
                        d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.storeNo = $('#sel-store-no').val();
                        d.tenderType = $('#sel-tender-type').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",   
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "StoreName",            
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreName == null || row.StoreName == "") {
                                html += '<span style="font-weight:400;display:block;text-align:left;">' + "" + '</span>';          
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:left;">' + row.StoreName + '</span>';
                            } 
                            return html;
                        }
                    },

                    {
                        data: "PaymentDate", 
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:600;display:block;color:#0c713d;">' + moment(row.PaymentDate).format("DD/MM/YYYY") + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TenderTypeName",  // Phuong thuc thanh toan
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TenderTypeName == null || row.TenderTypeName == "") {
                                html += '<span style="display: block;text-align:left;font-weight:400;color:#0c713d;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display: block;text-align:left;font-weight:400;color:#0c713d;">' + row.TenderTypeName + '</span>';  
                            }
                            return html;
                        }
                    },

                    {
                        data: "AmountTendered",     // Doanh thu
                        render: function (data, type, row) {
                            var html = '<span style="display: block;text-align:right;font-weight:400;">' + parseFloat(row.AmountTendered).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CountOrder",       // So luong bill
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; font-weight:400;">' + row.CountOrder + '</span>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('#tbl-general-payment-order-sales-report tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                $('#hdFromDate').val(fromDate);
                $('#hdToDate').val(toDate);
                $('#frm-export-excel').submit();
            });

        });

    </script>
}

