@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.Report;

@{
    ViewBag.Title = "Báo cáo tổng hợp KM giảm giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var model = Model as OfferTypeListModel; 
    var listOfferType = model.ListOfferType;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo khuyến mãi</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp KM giảm giá</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_PromotionDiscountValue", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <option value="" selected disabled>Tất cả</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại CTKM giảm giá<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-offer-type" name="OfferType">
                                            @if (listOfferType != null && listOfferType.Count > 0)
                                            {
                                                <option value="">Tất cả</option>
                                                foreach (var item in listOfferType)
                                                {
                                                    var displaySelect = $"{item.OfferType1} : {item.OfferName}";
                                                    <option value="@item.OfferType1" data-totalbill="@item.IsTotalBill" data-setupbuy="@item.IsSetupBuy" data-setupget="@item.IsSetupGet" data-voucher="@item.IsVoucher">@displaySelect</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <input type="hidden" id="hdsetDB" name="SetDB" />
                                <input type="hidden" id="hdsetDBRead" name="ServerRead" />
                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div>
                            <table id="tbl-order-sales-discount-report" class="table table-bordered table-hover text-nowrap">
                                <thead>
                                    <tr class="text-center" style="text-align:center;text-transform:uppercase;">
                                        <th>STT</th>
                                        <th>Ngày</th>
                                        <th>ST/CH</th>
                                        <th>Tên ST/CH</th>
                                        <th>Loại CTKM giảm giá</th>
                                        <th>Tổng số đơn hàng</th>
                                        <th>Tổng tiền giảm giá</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table;
        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            LoadDataReport();

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                //debugger
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                $('#hdFromDate').val(fromDate);
                $('#hdToDate').val(toDate);
                var setDB = $("#sel-set-server").val();
                $('#hdsetDB').val(setDB);
                var serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                $('#hdsetDBRead').val(serverRead);
                $('#frm-export-excel').submit();
            });

        });

        function getFromDate() {
            //debugger
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            //debugger
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }


        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {  
                    if (data != null) {
                        if (data.length == 1) {
                            //var html = "<option value='" + data[0].ValueJson + "'>" + data[0].DisplayComboSite + "</option>";
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    //html += "<option value='" + name.ValueJson + "'>" + name.DisplayComboSite + "</option>";
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    } 
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        };

        function LoadDataReport() {

            table = $('#tbl-order-sales-discount-report').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                info: true,

                ajax: {
                    url: '@Url.Action("GetPromotionDiscountValue", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.FromDate = getFromDate();
                        d.ToDate = getToDate();
                        d.SetServer = $('#sel-set-server').val();
                        d.ServerRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.StoreNo = $("#sel-store-no").val();
                        d.OfferType = $("#sel-offer-type").val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "BussinessDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px;display: block;">' + row.BussinessDate + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px;display: block;">' + row.StoreNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StoreName",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400;padding-top: 8px;display: block; text-align: text-left;">' + row.StoreName + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OfferType",              // Loại CTKM giảm giá
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 400; padding-top: 8px;display: block; text-align: text-left;">' + row.OfferType + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CountOrderTotal",       // Tổng số bill
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(row.CountOrderTotal).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TotalDiscountAmount",  // Tổng tiền giảm giá
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(row.TotalDiscountAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        };



    </script>
}

