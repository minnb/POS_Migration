        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-1">
                                    <div class="form-group">
                                        <input type="text" id="txtStoreSearch" placeholder="Nhập CH/ST" class="form-control">
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-1">
                                    <div class="form-group">
                                        <input type="text" id="txtOrderNo" placeholder="Nhập mã đơn hàng" class="form-control">
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <button type="button" class="btn btn-primary" id="btnSearch" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-search"></i> Tìm kiếm</button>
                                </div>
                            </div>
                        </div>
                        <table id="tblSaleOdoo" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr>
                                    <th class="text-center">Mã CH/ST </th>
                                    <th class="text-center">Mã đơn hàng</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script type="text/javascript">
          
        var table = "";
        $(document).ready(function () {
            $('.select2').select2();
            $("#btnSearch").on("click", function (e) {
                table.draw();

            });

            $('#txtDateSale').val(moment().format('DD/MM/YYYY'));
            $('#txtDateSale').datepicker(
                {
                    format: 'dd/mm/yyyy',
                    autoUpdateInput: false,
                    todayHighlight: true,
                    singleDatePicker: true,
                    autoclose: true
                });

            table = $('#tblSaleOdoo').DataTable({

                drawCallback: function (settings) {

                    $(".btn-detail").click(function () {
                        var orderNo = $(this).attr("data-id");
                        var url = '/Report/DetailOrder?orderNo=' + orderNo;
                        window.open(url);
                    });

                },
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: true, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("SaleOdooLoad", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.OrderNo = $("#txtOrderNo").val();
                        d.StoreNo = $("#txtStoreSearch").val();
                    }
                },
                columns: [
                    {
                        "data": "StoreNo",
                        className: 'text-center'
                    },
                    {
                        "data": "OrderNo",
                        className: 'text-center'
                    },
                    {
                        "data": "FormatAmount",
                        className: 'text-center'
                    },
                    {
                        "render": function (data, type, row) {
                            //var html = "<a type=\"button\" data-id='" + row.OrderNo + "' class=\"btn btn-primary-detail-view btn-detail\" data-toggle=\"tooltip\" data-placement=\"left\" title=\"Xem chi tiết\"   style=\"text-align:center;font-size:11px;margin-right:5px;color:#ffffff;\"><i class=\"fa fa-list\"></i></a>";

                            //return html;
                            var html = "<button type=\"button\" data-id='" + row.OrderNo + "' class=\"btn btn-primary btn-detail\" data-toggle=\"tooltip\" data-placement=\"left\" title=\"Xem chi tiết\" style=\"color:#ffffff;\"><i class=\"fa fa-list\"></i></button>";
                            return html;

                        },
                        className: 'text-center'
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        })

    </script>
}



