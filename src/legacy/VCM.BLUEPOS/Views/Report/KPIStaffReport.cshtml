@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo tốc độ tính KPI nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tốc độ tính KPI nhân viên</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("KPIStaffExcel", "Report", FormMethod.Get, new { @id = "frmExcel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().DisplayCombo</option>
                                                }
                                                else
                                                {
                                                    <option value="">Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.DisplayCombo</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã nhân viên</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slStaffCode" name="StaffCode"></select>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Từ ngày">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Đến ngày">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary btn-search" style="" id="btnSearch"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        <button type="submit" class="btn btn-success" id="btnExportExcel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-striped" id="table-kpi-staff-report">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>STT</th>
                                    <th>Mã ST/CH</th>
                                    <th>Mã nhân viên</th>
                                    <th>Mã SAP</th>
                                    <th>Tên nhân viên</th>
                                    <th>Tổng số lượng</th>
                                    <th>Tổng thời gian(Giây)</th>
                                    <th>Time trung bình(Giây)</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var table = "";
        var table_AllSite = "";
        var serverSide = false;
        $('.select2').select2();

        $(document).ready(function () {
            const startOfMonth = moment().clone().startOf('month');
            $('#searchFromDate').val(startOfMonth.format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').datepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            ListStaffCode($("#slSiteNo").val());
           // LoadDataReportAllSite();

            $("#btnSearch").on("click", function (e) {
                LoadDataReport();
            });

            $("#slSiteNo").on("change", function (e) {
                serverSide = true;
                ListStaffCode($(this).val());
            });

            $("#frmExcel").submit(function (e) {
                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                var url = "/Report/KPIStaffExcel?" + $(this).serialize();
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "KPIStaff_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });

            //$("#btnExportPDF").on("click", function (e) {
            //    var siteFull = $("#slSiteNo option:selected").text();
            //    var siteCode = $("#slSiteNo").val();
            //    var emp = $("#slStaffCode").val();
            //    var fromDate = $("#searchFromDate").val();
            //    var toDate = $("#searchToDate").val();
            //    if (siteCode == "") {
            //        toastr.error("Vui lòng chọn CH/ST");
            //        return;
            //    }
            //    var url = '/ActivityStores/SalesByEmpPDF?storeNo=' + siteCode + '&storeName=' + siteFull + '&staffCode=' + emp + '&fromDate=' + fromDate + '&toDate=' + toDate;
            //    window.open(url);
            //});

        });

        function LoadDataReportAllSite() {
            table_AllSite = $('#table-kpi-staff-report').DataTable({
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api(), data;
                    var intVal = function (i, j) {
                        return typeof i === 'string' ?
                            i.replace(/[\$,]/g, '') * 1 :
                            typeof i === 'number' ?
                                i : 0;
                    };
                    var totalQty = 0;
                    var totalTime = 0;
                    var totalAvg = 0;
                    data.forEach((name, i) => {
                        totalQty += name.Quantity;
                    });

                    data.forEach((name, i) => {
                        totalTime += name.SeccondTotal;
                    });

                    data.forEach((name, i) => {
                        totalAvg += name.Seccond_AVG_ITEM;
                    });

                    $(api.column(5).footer()).html(
                        '<strong style="color:Blue">' + parseFloat(totalQty).toLocaleString('en') + '</strong>'
                    );
                    $(api.column(6).footer()).html(
                        '<strong style="color:Blue">' + parseFloat(totalTime).toLocaleString('en') + '</strong>'
                    );
                    $(api.column(7).footer()).html(
                        '<strong style="color:Blue">' + parseFloat(totalTime / totalQty).toLocaleString('en') + '</strong>'
                    );
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: true,               // for show progress bar
                serverSide: false,              // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                deferLoading: 0,
                info: true,
                ajax: {
                    url: '@Url.Action("KPIStaffLoadAll", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StaffCode = $("#slStaffCode").val();
                        d.StoreNo = $("#slSiteNo").val();
                        d.FromDate = $("#searchFromDate").val();
                        d.ToDate = $("#searchToDate").val();
                    }
                },
                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo"
                    },

                    {
                        data: "StaffCode"
                    },

                    {
                        data: "SAPCODE"
                    },

                    {
                        data: "StaffName"
                    },

                    {
                        data: "Quantity",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            var Quantity = row.Quantity;
                            html = '<span style="">' + parseFloat(Quantity).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "SeccondTotal",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SeccondTotal > 0) {
                                var SeccondTotal = row.SeccondTotal;
                                html = '<span style="">' + parseFloat(SeccondTotal).toLocaleString('en') + '</span>';
                            }
                            return html;
                        },
                        className: 'text-right'
                    },

                    {
                        data: "Seccond_AVG_ITEM",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Seccond_AVG_ITEM > 0) {
                                var Seccond_AVG_ITEM = row.Seccond_AVG_ITEM;
                                html = '<span style="">' + parseFloat(Seccond_AVG_ITEM).toLocaleString('en') + '</span>';
                            }
                            return html;
                        },
                        className: 'text-right'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {
                //debugger
                //serverSide = false;
                if (processing) {
                    loading.showloading();
                } else {
                    serverSide = false;
                    loading.hideloading();
                }

            }).on('page.dt', function () {
                //serverSide = false;
            });
        }

        function LoadDataReport() {
            //debugger
            var siteCode = $("#slSiteNo").val();
            var emp = $("#slStaffCode").val();
            var fromDate = $("#searchFromDate").val();
            var toDate = $("#searchToDate").val();
            //if (siteCode == "") {
            //    toastr.error("Vui lòng chọn CH/ST");
            //    return;
            //}
            $('#table-kpi-staff-report tbody').empty();
            $('#table-kpi-staff-report tfoot').empty();

            loading.showloading();
            var fromData = new FormData();
            fromData.append('siteCode', siteCode);
            fromData.append('emp', emp);
            fromData.append('fromDate', fromDate);
            fromData.append('toDate', toDate);
            $.ajax({
                type: "POST",
                url: '@Url.Action("KPIStaffLoad", "Reports")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";
                    var totalLine = 0;
                    var totalSeccond = 0;
                    var totalAVG = 0;
                    var stt = 1;
                    if (data != null) {
                        data.forEach((name, i) => {
                            html += "<tr>";
                            html += "<td style=\"text-align:center\">" + stt + "</td>";
                            html += "<td style=\"text-align:left\">" + name.StoreNo + "</td>";
                            html += "<td style=\"text-align:left\">" + name.StaffCode + "</td>";
                            html += "<td style=\"text-align:left\">" + name.SAPCODE + "</td>";
                            html += "<td style=\"text-align:left\">" + name.StaffName + "</td>";
                            html += "<td style=\"text-align:right\">" + parseFloat(name.Quantity).toLocaleString('en') + "</td>";
                            html += "<td style=\"text-align:right\">" + parseFloat(name.SeccondTotal).toLocaleString('en') + "</td>";
                            html += "<td style=\"text-align:right\">" + parseFloat(name.Seccond_AVG_ITEM).toLocaleString('en') + "</td>";
                            html += "</tr>";
                            totalLine += name.Quantity;
                            totalSeccond += name.SeccondTotal;
                            totalAVG += name.Seccond_AVG_ITEM;
                            stt++;
                        });
                    }
                    html += "<tr style=\"font-weight:bold\">";
                    html += "<td colspan=5 style=\"text-align:center\">Total</td>";
                    html += "<td style=\"text-align:right\">" + parseFloat(totalLine).toLocaleString('en') + "</td>";
                    html += "<td style=\"text-align:right\">" + parseFloat(totalSeccond).toLocaleString('en') + "</td>";
                    html += "<td style=\"text-align:right\">" + parseFloat(totalSeccond / totalLine).toLocaleString('en') + "</td>";
                    html += "</tr>";

                    $('#table-kpi-staff-report tbody').html(html);
                    $("#btnExportExcel").css("display","initial");
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }

            });
        }

        function ListStaffCode(siteCode) {
            $("#slStaffCode").empty();
            var fromData = new FormData();
            fromData.append('StoreNo', siteCode);
            //fromData.append('siteCode', siteCode);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxStaffCode", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";
                    if (data != null) {
                        //debugger
                        if (data.length == 1) {
                            html += "<option value='" + data[0].UserPOS + "'>" + data[0].UserPOS + "</option>";
                        }
                        else {
                            html += "<option value=''>Tất cả</option>";
                            data.forEach((name, i) => {
                                html += "<option value='" + name.UserPOS + "'>" + name.UserPOS + "</option>";
                            });
                        }
                    }
                    else {
                        html += "<option value='-'>Tất cả</option>";
                    }
                    $('#slStaffCode').html(html);
                },
                error: function () {}
            });
        }

    </script>
}
