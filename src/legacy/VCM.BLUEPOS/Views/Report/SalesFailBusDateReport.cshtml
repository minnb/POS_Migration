@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo ST/CH bán sai ngày kinh doanh";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Báo cáo ST/CH bán sai ngày kinh doanh</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelSalesFailBusinessDate", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Vùng Set</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSetDB" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Từ ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Từ ngày">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Đến ngày">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <input type="hidden" id="hdFromDate" name="FromDate" />
                                        <input type="hidden" id="hdToDate" name="ToDate" />

                                        <button type="button" class="btn btn-primary btn-search" style="" id="btnSearch"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        <button type="submit" class="btn btn-success" id="btn-export-excel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-striped" id="tbl-sale-fail-business-date-report">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Mã ST/CH</th>
                                    <th>Tên ST/CH</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>Ngày đơn hàng</th>
                                    <th>Tổng hóa đơn</th>
                                    <th>Trước thuế</th>
                                    <th>Thuế VAT</th>
                                    <th>Sau thuế</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" style="text-align:right"> Total Page:<br /><strong style="color:blue">Total ALL:</strong></th>

                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var table = "";        
        $(document).ready(function () {
            $('.select2').select2();
            var start = moment().subtract(7, 'day');
            $('#searchFromDate').val(start.format('DD/MM/YYYY'));

            $('#searchFromDate').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            LoadComboxStoreByServer($("#slSetDB").val());
            $("#slSetDB").on("change", function (e) {
                LoadComboxStoreByServer($("#slSetDB").val());
            });

            $("#btnSearch").on("click", function (e) {
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                var tuNgay = $("#searchFromDate").val();
                var denNgay = $("#searchToDate").val();

                $('#hdFromDate').val(tuNgay);
                $('#hdToDate').val(denNgay);
                $('#frm-export-excel').submit();
            });

            table = $('#tbl-sale-fail-business-date-report').DataTable({
                footerCallback: function (row, data, start, end, display) {
                    //debugger
                    var api = this.api(), data;
                    if (data != null) {
                        var intVal = function (i, j) {
                            return typeof i === 'string' ?
                                i.replace(/[\$,]/g, '') * 1 :
                                typeof i === 'number' ?
                                    i : 0;
                        };

                        totalTruocVAT = data.length > 0 ? data[0].SumTruocVAT : 0;

                        totalSauVAT = data.length > 0 ? data[0].SumSauVAT : 0;

                        totalVAT = data.length > 0 ? data[0].SumVAT : 0;

                        totalOrder = data.length > 0 ? data[0].SumTotalOrder : 0;


                        var pageTotalOrder = 0;
                        var pageTotalTruocVAT = 0;
                        var pageTotalVAT = 0;
                        var pageTotalSauVAT = 0;

                        data.forEach((name, i) => {
                            pageTotalOrder += name.CountOrderTotal;
                        });

                        pageTotalTruocVAT = api
                            .column(6, { "filter": "TruocVAT" })
                            .data()
                            .reduce(function (a, b) {
                                return intVal(a) + intVal(b);
                            }, 0);

                        pageTotalVAT = api
                            .column(7, { "filter": "ThueVAT" })
                            .data()
                            .reduce(function (a, b) {
                                return intVal(a) + intVal(b);
                            }, 0);

                        pageTotalSauVAT = api
                            .column(8, { "filter": "SauVAT" })
                            .data()
                            .reduce(function (a, b) {
                                return intVal(a) + intVal(b);
                            }, 0);


                        $(api.column(5).footer()).html(
                            '' + parseFloat(pageTotalOrder).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalOrder).toLocaleString('en') + '</strong>'
                        );

                        $(api.column(6).footer()).html(
                            '' + parseFloat(pageTotalTruocVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalTruocVAT).toLocaleString('en') + '</strong>'
                        );

                        $(api.column(7).footer()).html(
                            '' + parseFloat(pageTotalVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalVAT).toLocaleString('en') + '</strong>'
                        );

                        $(api.column(8).footer()).html(
                            '' + parseFloat(pageTotalSauVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalSauVAT).toLocaleString('en') + '</strong>'
                        );
                    }
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: false,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                deferLoading: 0,
                info: true,
                ajax: {
                    url: '@Url.Action("SalesFailBusDateLoad", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ServerRead = $("#slSetDB").select2().find(":selected").data("serverread");
                        d.SetDB = $("#slSetDB").val();
                        d.StoreNo = $("#slSiteNo").val();
                        d.FromDate = $("#searchFromDate").val();
                        d.ToDate = $("#searchToDate").val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },

                    {
                        data: "StoreName",
                        className: 'text-center'
                    },

                    {
                        data: "BussinessDate",
                        render: function (data, type, row) {
                            if (row.BussinessDate != null) {
                                return moment(row.BussinessDate).format("DD/MM/YYYY");
                            }
                            return "";
                        }
                    },

                    {
                        data: "OrderTime",
                        render: function (data, type, row) {
                            if (row.OrderTime != null) {
                                return moment(row.OrderTime).format("DD/MM/YYYY");
                            }
                            return "";
                        }
                    },

                    {
                        data: "CountOrderTotal",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CountOrderTotal != null) {
                                var CountOrderTotal = row.CountOrderTotal;
                                html = '<span style="">' + parseFloat(CountOrderTotal).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "TruocVAT",
                        className: 'text-right',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TruocVAT !=null && row.TruocVAT > 0) {
                                var TruocVAT = row.TruocVAT;
                                html = '<span style="">' + parseFloat(TruocVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ThueVAT",
                        className: 'text-right',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ThueVAT !=null && row.ThueVAT > 0) {
                                var ThueVAT = row.ThueVAT;
                                html = '<span style="">' + parseFloat(ThueVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }                   
                    },

                    {
                        data: "SauVAT",
                        className: 'text-right',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SauVAT != null && row.SauVAT > 0) {
                                var SauVAT = row.SauVAT;
                                html = '<span style="">' + parseFloat(SauVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        } 
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        });

        function LoadComboxStoreByServer(ipServer) {
            var html = "<option value=\"\" selected>Tất cả</option>";
            if (ipServer == null || ipServer == '') {
                return $('#slSiteNo').html(html);
            }
            $("#slSiteNo").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value='" + name.ValueJson + "'>" + name.DisplayCombo + "</option>";
                            } 
                        });
                        $('#slSiteNo').html(html);
                    }                   
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

    </script>
}




