@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo sử dụng BNMH/Voucher";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listVoucherType = ViewBag.ListVoucherType as List<OptionModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">

        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo sử dụng BNMH/Voucher</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelGetVoucherReceiptList", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="sel-pos-id" name="POSID"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-voucher-receipt-type" name="VoucherReceiptType">
                                            @if (listVoucherType != null && listVoucherType.Count > 0)
                                            {
                                                if (listVoucherType.Count == 1)
                                                {
                                                    <option value="@listVoucherType.FirstOrDefault().Value">@listVoucherType.FirstOrDefault().Text</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listVoucherType)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="Số đơn hàng; Biên nhận thanh toán">
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary" name="btnSearch"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-voucher-receipt-sales-report" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Số BNMH</th>
                                    <th>Serial Voucher</th>
                                    <th>Số đơn hàng</th>
                                    <th>Ngày tạo đơn hàng</th>
                                    <th>Thời gian</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Số tiền</th>
                                    <th>Loại đơn hàng</th>
                                    @*<th>Số thẻ VinID</th>*@
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table = "";
        
        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                            LoadComboxPOSTerminalByStore(data[0].SiteNo)
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxPOSTerminalByStore(storeNo) {
            loading.showloading();
            if (storeNo == null || storeNo == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-pos-id').html(html);
            } 
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                data: { StoreNo: storeNo }, 
                dataType: "json",
                success: function (data) { 
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].PosID + "'>" + data[0].PosID + "</option>";
                            $('#sel-pos-id').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.PosID != "") {
                                    html += "<option value='" + name.PosID + "'>" + name.PosID + "</option>";
                                }
                            });
                            $('#sel-pos-id').html(html);
                        }
                    }
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
          });

        };

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $('#txt-text-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $(document).ready(function () {
            $('.select2').select2();
            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            $("#sel-store-no").on("change", function (e) {
                LoadComboxPOSTerminalByStore($("#sel-store-no").val());
            });
           
            table = $('#tbl-voucher-receipt-sales-report').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,                  // for show progress bar
                serverSide: true,                   // for process server side
                filter: false,                      // this is for disable filter (search box)
                orderMulti: false,                  // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                
                ajax: {
                    url: '@Url.Action("GetVoucherReceiptList", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.setServer = $('#sel-set-server').val();
                        d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.storeNo = $('#sel-store-no').val();
                        d.posID = $('#sel-pos-id').val();
                        d.voucherReceiptType = $('#sel-voucher-receipt-type').val();
                        d.textSearch = $('#txt-text-search').val();
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ReferenceNo_Payment",              // Bien nhan mua hang
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;">' + row.ReferenceNo_Payment + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ReferenceNo_Voucher",             // Serial Voucher
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;">' + row.ReferenceNo_Voucher + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OrderNo",                         // số đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700; display: block;">' + row.OrderNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StartingTimeStr",                  // Ngày tạo đơn hàng
                        className: "text-center"
                    },

                    {
                        data: "OrderTimeStr",                     // Thời gian
                        className: "text-center"
                    },

                    {
                        data: "OrderDateStr",                     // Ngày kinh doanh
                        className: "text-center"
                    },

                    {
                        data: "StoreNo",                          
                        className: "text-center"
                    },

                    {
                        data: "POSTerminalNo",                    // Máy POS
                        className: "text-center"
                    },

                    {
                        data: "TotalAmount",                      // Tổng tiền
                        render: function (data, type, row) {
                            var totalAmount = row.TotalAmount;
                            var html = '<span style="display: block; font-weight:700; text-align:right;">' + parseFloat(totalAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OrderType",                        // Loại đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var OrderType = row.OrderType;
                            var html = "";
                            if (OrderType == "Đơn hàng trả") {
                                html += '<span style="display: block; font-weight:700; color: #db0b0b;">' + OrderType + '</span>';
                            }
                            else {
                                html += '<span style="display: block;">' + OrderType + '</span>';
                            }
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                }
                else {
                    loading.hideloading();
                }
            });

            $('#tbl-voucher-receipt-sales-report tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                $('#hdFromDate').val(fromDate);
                $('#hdToDate').val(toDate);
                $('#frm-export-excel').submit();
            });


        });

    </script>
}

