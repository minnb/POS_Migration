@using VCM.BLUEPOS.Model.Authen;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.MCH;

@{

    ViewBag.Title = "Báo cáo doanh thu theo quầy hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var error = ViewBag.Error;
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listNganhHang = (List<MCHComboboxModel>)ViewBag.ComboxNganhHang;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo doanh thu theo quầy hàng</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_GetDetailRevenueSalesByStoreMCH", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNo">@listStore.FirstOrDefault().StoreNo - @listStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.StoreNo">@item.StoreNo - @item.StoreName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngành hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-mch2" name="MCH2">
                                            @if (listNganhHang != null && listNganhHang.Count > 0)
                                            {
                                                <option value="">Tất cả</option>
                                                foreach (var item in listNganhHang)
                                                {
                                                    <option value="@item.Code">@item.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mặt hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-mch5" name="MCH5">
                                            <option value="">Tất cả</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" class="btn btn-primary" style="" id="btn-search"><i class="fa fa-search"></i> Tìm</button>
                                    <button type="button" class="btn btn-success" id="btn-export-excel" style="color: #fff;"><i class="fa fa-file-excel"></i>Xuất Excel (Chi tiết)</button>
                                    <button type="button" id="btn-export-pdf" class="btn btn-bg-secondary" style="cursor:pointer;display:none"><i class="la la-file-pdf"></i>Xuất PDF</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div id="loadPartialView"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        var table;

        $(document).ready(function () {
            $('.select2').select2();

            var start = moment().subtract(6, 'day');
            $('#txt-from-date').val(start.format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $("#sel-mch2").on("change", function () {
                var mch2 = $("#sel-mch2").val();
                $("#sel-mch5").empty();
                loading.showloading();
                var fromData = new FormData();
                fromData.append('MCH2', mch2);  
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetMCH5", "Report")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        var html = "";
                        html += "<option value=''>Tất cả</option>";
                        if (data != null) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.Code + "'>" + name.Name + "</option>";
                            });
                        }
                        $('#sel-mch5').html(html);
                        loading.hideloading();
                    },
                    error: function () {}
                });
            });

            $("#btn-search").on("click", function (e) {
                var _fromDate = getFromDate();
                var _toDate = getToDate();
                if (_fromDate > _toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                LoadDataReport();
            });

            $("#btn-export-pdf").on("click", function (e) {
                //debugger
                var siteCode = $("#sel-store-no").val();
                var mch2 = $("#sel-mch2").val();     /* nganh hang */
                var mch5 = $("#sel-mch5").val();
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                var url = '/Report/SalesByMCHDetailPDF?siteCode=' + siteCode + '&mch2=' + mch2 + '&mch5=' + mch5 + '&fromDate=' + fromDate + '&toDate=' + toDate;
                window.open(url);
            });


            $("#btn-export-excel").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }

                $('#hdFromDate').val(fromDate);
                $('#hdToDate').val(toDate);
                $('#frm-export-excel').submit();

            });

        });

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function LoadDataReport() {
            //debugger
            var siteCode = $("#sel-store-no").val();
            var mch2 = $("#sel-mch2").val();     /* nganh hang */
            var mch5 = $("#sel-mch5").val();
            var fromDate = getFromDate();
            var toDate = getToDate();

            $('#loadPartialView').html('');
            loading.showloading();

            var fromData = new FormData();
            fromData.append('siteCode', siteCode);
            fromData.append('mch2', mch2);
            fromData.append('mch5', mch5);
            fromData.append('fromDate', fromDate);
            fromData.append('toDate', toDate);
            $.ajax({
                type: "POST",
                url: '@Url.Action("_SalesByMCHDetailLoad", "Report")',
                data: fromData,
                contentType: "text",
                dataType: "html",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    $('#loadPartialView').html(data);
                    $("#btn-export-pdf").css("display","initial");
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

    </script>
}

