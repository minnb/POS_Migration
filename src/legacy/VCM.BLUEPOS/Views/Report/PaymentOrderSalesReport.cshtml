@using VCM.BLUEPOS.Model.Order;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo hình thức thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;

    var listOrderType = ViewBag.ListOrderType as List<OptionDataModel>;
    var listSalesType = ViewBag.ListSalesType as List<OptionDataModel>;
    var listSourceBill = ViewBag.ListSourceBill as List<OptionDataModel>;
    var listPaymentType = ViewBag.ListPaymentType as List<OptionDataModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo hình thức thanh toán</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_PaymentOrderSalesList", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Tìm theo<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-search-date" name="SearchDate">
                                            <option value="0" selected>Ngày thanh toán</option>
                                            <option value="1">Ngày kinh doanh</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServerDB">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại đơn hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-order-type" name="OrderType">
                                            @if (listOrderType != null && listOrderType.Count > 0)
                                            {
                                                if (listOrderType.Count == 1)
                                                {
                                                    <option value="@listOrderType.FirstOrDefault().Code">@listOrderType.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listOrderType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Hình thức thanh toán<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-tender-type" name="TenderType">
                                            @if (listPaymentType != null && listPaymentType.Count > 0)
                                            {
                                                if (listPaymentType.Count == 1)
                                                {
                                                    <option value="@listPaymentType.FirstOrDefault().Code">@listPaymentType.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listPaymentType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Nơi tạo bill</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-user-create-bill" name="UserCreateBill">
                                            @if (listSourceBill != null && listSourceBill.Count > 0)
                                            {
                                                if (listSourceBill.Count == 1)
                                                {
                                                    <option value="@listSourceBill.FirstOrDefault().Code">@listSourceBill.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listSourceBill)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>


                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mã nhân viên</label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-staff-code" name="StaffCode"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Số đơn hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-order-no" name="OrderNo" placeholder="Nhập số đơn hàng">
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />
                                <input type="hidden" id="hd-set-server-ip" name="SetServer" />

                                <div class="col-lg-9 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-payment-order-sales-report" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th>STT</th>
                                    <th>Số đơn hàng</th>
                                    <th>Ngày thanh toán</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>Cửa hàng</th>
                                    <th>Máy POS</th>
                                    <th>Hình thức thanh toán</th>
                                    <th>Hình thức bán hàng</th>
                                    <th>Loại đơn hàng</th>
                                    <th>Nơi tạo bill</th>
                                    <th>Tỷ giá</th>
                                    <th>Tiền nguyên tệ</th>
                                    <th>Đơn vị ngoại tệ</th>
                                    <th>Số tiền</th>
                                    <th>Đơn vị tiền tệ</th>
                                    <th>Số tham chiếu</th>
                                    <th>Mã chuẩn chi</th>
                                    <th>Máy thanh toán ngân hàng</th>
                                    <th>Loại thẻ thanh toán</th>
                                    <th>Số hóa đơn</th>
                                    <th>Trạng thái Online</th>
                                    <th>Số ĐH tham chiếu</th>
                                    <th>Đối tác</th>
                                    <th>Thu ngân</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        var table;

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $('#txt-order-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });


        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            if (ipServer == null || ipServer == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-store-no').html(html);
            }            
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {  
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                    LoadComboxStaffCode();
                    loading.hideloading();
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                    loading.hideloading();
                }
            });
        }

         function LoadComboxStaffCode() {
                //debugger
                $("#sel-staff-code").empty();
                var storeNo = $("#sel-store-no").val();
                loading.showloading();
                var fromData = new FormData();
                fromData.append('StoreNo', storeNo);           
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadStaffSalseForReport", "Common")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        var html = "<option value=\"\" selected>Tất cả</option>";
                        if (data != null)
                        {
                            if (data.length == 1) {
                                var html = "<option value='" + data[0].UserPOS + "'>" + data[0].UserPOS + "</option>";
                                $('#sel-staff-code').html(html);
                            }
                            else if (data.length > 1) {
                                data.forEach((name, i) => {
                                    html += "<option value='" + name.UserPOS + "'>" + name.UserPOS + "</option>";
                                });
                            }
                        }
                        else
                        {
                            html += "<option value=''>Tất cả</option>";
                        }

                        $('#sel-staff-code').html(html);
                        loading.hideloading();
                    },
                    error: function ()
                    {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });           
        }


        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val()); 
            });

            LoadComboxStaffCode();
            $("#sel-store-no").on("change", function (e) {
                LoadComboxStaffCode();
            });

            table = $('#tbl-payment-order-sales-report').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetPaymentOrderSalesList", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                        d.searchDate = $('#sel-search-date').val();
                        d.setServer = $('#sel-set-server').val();
                        d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.storeNo = $('#sel-store-no').val();
                        d.orderNo = $('#txt-order-no').val();
                        d.orderType = $('#sel-order-type').val();
                        d.tenderType = $('#sel-tender-type').val();
                        d.staffCode = $('#sel-staff-code').val();
                        d.userID = $('#sel-user-create-bill').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "OrderNo",                       
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null || row.OrderNo == "") {
                                html += '<span style="display:block;font-weight:700;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:700;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PaymentDay",                   
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PaymentDay == null || row.PaymentDay == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.PaymentDay + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "BusinessDay",   // Ngày kinh doanh
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.BusinessDay == null || row.BusinessDay == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.BusinessDay + '</span>';
                            }
                            return html;
                        } 
                    },

                    {
                        data: "StoreNo",    // Mã cửa hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        } 
                    },

                    {
                        data: "PosNo",    // Máy POS
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PosNo == null || row.PosNo == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.PosNo + '</span>';
                            }
                            return html;
                        }  
                    },

                    {
                        data: "TenderTypeName",  // Hinh thuc thanh toan
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TenderTypeName == null || row.TenderTypeName == "") {
                                html += '<span style="display: block; text-align:center; font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display: block; text-align:center; font-weight:400;">' + row.TenderTypeName + '</span>';
                            }
                            return html;
                        }
                    },
                  
                    {
                        data: "SalesType",    // Hinh thuc ban hang
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SalesType == null || row.SalesType  == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.SalesType + '</span>';
                            }
                            return html;
                        }    
                    },

                    {
                        data: "OrderType",    // Loai don hang
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderType == "Đơn hàng bán") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.OrderType + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;color:#db0b0b;font-weight:400;">' + row.OrderType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UserID",  // Noi tao bill
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UserID == null || row.UserID == "") {
                                html += '<span style="display: block; font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display: block; font-weight:400;">' + row.UserID + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ExchangeRate",  // Tỷ giá
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right; font-weight:400;">' + parseFloat(row.ExchangeRate).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AmountInCurrency",   // Tiền nguyên tệ
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right; font-weight:400;">' + parseFloat(row.AmountInCurrency).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CurrencyCode",   // Đơn vị ngoại tệ
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CurrencyCode == null || row.CurrencyCode == "") {
                                html += '<span style="display: block; font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display: block; font-weight:400;">' + row.CurrencyCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "AmountTendered",   // Tổng số tiền
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right; font-weight:400;">' + parseFloat(row.AmountTendered).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CurrencyUnit",  // Đơn vị tiền tệ VNĐ
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CurrencyUnit == null || row.CurrencyUnit == "") {
                                html += '<span style="display: block; font-weight:400;">' + "" + '</span>';
