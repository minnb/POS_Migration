@using VCM.BLUEPOS.Model.Order;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo doanh thu theo cửa hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listStore = ViewBag.ListStore as List<OptionSiteModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">WinLife</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo doanh thu theo cửa hàng</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_RevenueOrderSalesByStoreWinLife", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNoPLH" data-serverread="@listStore.FirstOrDefault().StoreNoPLH">@listStore.FirstOrDefault().StoreNoPLH - @listStore.FirstOrDefault().StoreNamePLH</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.StoreNoPLH" data-serverread="@item.StoreNoPLH">@item.StoreNoPLH - @item.StoreNamePLH</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="submit" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div>
                            <table id="tbl-revenue-order-sales-by-store-winlife" class="table table-bordered table-hover text-nowrap">
                                <thead>
                                    <tr class="text-center" style="text-align:center;text-transform:uppercase;">
                                        <th>STT</th>
                                        <th>Mã CH</th>
                                        <th>Tên CH</th>
                                        <th>Ngày kinh doanh</th>
                                        <th>Tổng số hóa đơn</th>
                                        <th>Doanh thu trước thuế</th>
                                        <th>Tiền thuế VAT</th>
                                        <th>Doanh thu sau thuế</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="4" style="text-align:right"> Total Page:<br /><strong style="color:blue">Total ALL:</strong></th>

                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        var table;

        $(document).ready(function () {
            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadDataReport();

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                table.draw();
            });


            $("#frm-export-excel").submit(function (e) {
                //debugger
                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                //var setDB = $("#sel-set-server").val();
                //var serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");

                var storeNo = $("#sel-store-no").val();
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }

                var url = '/Report/ExportExcel_RevenueOrderSalesByStoreWinLife?StoreNo=' + storeNo + '&TuNgay=' + fromDate + '&DenNgay=' + toDate;
                req.open("GET", url, true);
                req.responseType = "blob";

                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "RevenueOrderSalesByStoreWinLife_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };

                req.send();
            });
        });

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function LoadDataReport() {
            table = $('#tbl-revenue-order-sales-by-store-winlife').DataTable({
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api(), data;
                    var intVal = function (i, j) {
                        return typeof i === 'string' ?
                            i.replace(/[\$,]/g, '') * 1 :
                            typeof i === 'number' ?
                            i : 0;
                    };

                    totalTruocVAT = data.length > 0 ? data[0].SumTruocVAT : 0;
                    totalSauVAT = data.length > 0 ? data[0].SumSauVAT : 0;
                    totalVAT = data.length > 0 ? data[0].SumVAT : 0;
                    totalOrder = data.length > 0 ? data[0].SumTotalOrder : 0;

                    var pageTotalOrder = 0;
                    var pageTotalTruocVAT = 0;
                    var pageTotalVAT = 0;
                    var pageTotalSauVAT = 0;

                    data.forEach((name, i) => {
                        pageTotalOrder += name.CountOrderTotal;
                    });

                    pageTotalTruocVAT = api
                        .column(5, { "filter": "TruocVAT" })
                        .data()
                        .reduce(function (a, b) {
                            return intVal(a) + intVal(b);
                        }, 0);

                    pageTotalVAT = api
                        .column(6, { "filter": "ThueVAT" })
                        .data()
                        .reduce(function (a, b) {
                            return intVal(a) + intVal(b);
                        }, 0);

                    pageTotalSauVAT = api
                        .column(7, { "filter": "SauVAT" })
                        .data()
                        .reduce(function (a, b) {
                            return intVal(a) + intVal(b);
                        }, 0);


                    $(api.column(4).footer()).html(
                        '' + parseFloat(pageTotalOrder).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalOrder).toLocaleString('en') + '</strong>'
                    );

                    $(api.column(5).footer()).html(
                        '' + parseFloat(pageTotalTruocVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalTruocVAT).toLocaleString('en') + '</strong>'
                    );

                    $(api.column(6).footer()).html(
                        '' + parseFloat(pageTotalVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalVAT).toLocaleString('en') + '</strong>'
                    );

                    $(api.column(7).footer()).html(
                        '' + parseFloat(pageTotalSauVAT).toLocaleString('en') + '<br> <strong style="color:Blue">' + parseFloat(totalSauVAT).toLocaleString('en') + '</strong>'
                    );

                },

                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                info: true,

                ajax: {
                    url: '@Url.Action("GetRevenueOrderSalesByStoreWinLife", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.FromDate = getFromDate();
                        d.ToDate = getToDate();
                        d.StoreNo = $("#sel-store-no").val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;padding-top: 8px;display: block;">' + row.StoreNo + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "StoreName",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400;padding-top: 8px;display: block; text-align: text-left;">' + row.StoreName + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BussinessDate",
                        className: 'text-center',
                        render: function (data, type, row) {
                            if (row.BussinessDate != null) {
                                return moment(row.BussinessDate).format("DD/MM/YYYY");
                            }
                            return "";
                        }
                    },

                    {
                        data: "CountOrderTotal",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var CountOrderTotal = row.CountOrderTotal;
                            var html = '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(CountOrderTotal).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TruocVAT",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TruocVAT > 0) {
                                var TruocVAT = row.TruocVAT;
                                html += '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(TruocVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ThueVAT",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ThueVAT > 0) {
                                var ThueVAT = row.ThueVAT;
                                html += '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(ThueVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "SauVAT",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SauVAT > 0) {
                                var SauVAT = row.SauVAT;
                                html += '<span style="font-weight: 700;padding-top: 8px;display: block;">' + parseFloat(SauVAT).toLocaleString('en') + '</span>';
                            }
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        };



    </script>
}

