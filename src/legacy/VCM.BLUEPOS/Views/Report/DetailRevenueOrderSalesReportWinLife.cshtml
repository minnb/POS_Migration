@using VCM.BLUEPOS.Model.Order;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{

    ViewBag.Title = "Báo cáo doanh thu chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listOrderType = ViewBag.ListOrderType as List<OptionModel>;
    var listStore = ViewBag.ListStore as List<OptionSiteModel>;
    
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">WinLife</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo doanh thu chi tiết</a>
                    </li>
                </ul>
            </div>
        </div> 
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelDetailRevenueReportWinLife", "Report", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="FromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="ToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNoPLH" data-serverread="@listStore.FirstOrDefault().StoreNoPLH">@listStore.FirstOrDefault().StoreNoPLH - @listStore.FirstOrDefault().StoreNamePLH</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.StoreNoPLH" data-serverread="@item.StoreNoPLH">@item.StoreNoPLH - @item.StoreNamePLH</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Kênh bán hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-chanel-sales" name="ChanelSales">
                                            <option value="" selected>Tất cả</option>
                                            <option value="WIN_LIFE">BluePOS</option>
                                            <option value="KIOS">Máy đặt hàng</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại đơn hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-transaction-type" name="TransactionType">
                                            <option value="" selected>Tất cả</option>
                                            <option value="PLT1">Đơn hàng bán</option>
                                            <option value="PLR1">Đơn hàng trả</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Số đơn hàng gốc</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-return-order" name="ReturnOrder" placeholder="Nhập số đơn hàng gốc">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="Số đơn hàng;">
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-detail-revenue-report-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th>STT</th>
                                    <th>Ngày tạo đơn hàng</th>
                                    <th>Thời gian</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>ST/CH PLG</th>
                                    <th>ST/CH WCM</th>
                                    <th>Máy POS</th>
                                    <th>Số đơn hàng</th>
                                    <th>Hình thức bán hàng</th>
                                    <th>Loại đơn hàng</th>
                                    <th>Số đơn hàng gốc</th>
                                    <th>Mã sản phẩm PLG</th>
                                    <th>Mã sản phẩm</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Size</th>
                                    <th>Loại ly</th>
                                    <th>ĐVT</th>
                                    <th>Số lượng</th>
                                    <th>Giá bán</th>
                                    <th>Giảm giá</th>
                                    <th>Thành tiền trước thuế</th>
                                    <th>Thuế suất GTGT (%)</th>
                                    <th>Tiền thuế GTGT</th>
                                    <th>Thành tiền sau thuế</th>
                                    <th>Kênh bán hàng</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        var table;

        function getFromDate() {
            //debugger
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $('#txt-return -order').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-text-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $(document).ready(function () {

            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            table = $('#tbl-detail-revenue-report-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetDetailRevenueOrderSalesReportWinLife", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                        d.setServer = $('#sel-set-server').val();
                        d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.storeNo = $('#sel-store-no').val();
                        d.transactionType = $('#sel-transaction-type').val();
                        d.returnOrder = $('#txt-return-order').val();
                        d.textSearch = $('#txt-text-search').val();
                        d.chanelSales = $('#sel-chanel-sales').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "EndingTimeStr",    // Ngày tạo đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.EndingTimeStr == null || row.EndingTimeStr == "") {
                                html += '<span style="display:block;font-weight:700;">' + "" + '</span>';
                            }
                            else {
                                    html += '<span style="display:block;font-weight:700;">' + row.EndingTimeStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "TimeStr",        // Thời gian
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TimeStr == null || row.TimeStr == "") {
                                html += '<span style="display:block;font-weight:700;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:700;">' + row.TimeStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderDate",    // Ngày kinh doanh
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderDate == null || row.OrderDate == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.OrderDate + '</span>';
                            }
                            return html;
                        }                      
                    },

                    {
                        data: "StoreNoPLG",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNoPLG == null || row.StoreNoPLG == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.StoreNoPLG + '</span>';
                            }
                            return html;
                        }    
                    },

                    {
                        data: "StoreNoWCM",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNoWCM == null || row.StoreNoWCM == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.StoreNoWCM + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "POSTerminalNo",   
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.POSTerminalNo == null || row.POSTerminalNo == "") {
                                html += '<span style="display:block;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:400;">' + row.POSTerminalNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderNo", 
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null || row.OrderNo == "") {
                                html += '<span style="display:block;font-weight:700;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;font-weight:700;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderType",   // Hinh thuc ban hang
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderType == null || row.OrderType == "") {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + row.OrderType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "TransactionType",    // Loại đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TransactionType == "Đơn hàng trả") {
                                html += '<span style="display: block; font-weight:700; color: #db0b0b;">' + row.TransactionType + '</span>';
                            }
                            else {
                                html += '<span style="display: block;">' + row.TransactionType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrigOrder",    // Đơn hàng gốc
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrigOrder == null || row.OrigOrder == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.OrigOrder + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemNo",       // Mã sản phẩm PLG
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ItemNo == null || row.ItemNo == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.ItemNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemNoSAP",    // Mã sản phẩm SAP
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ItemNoSAP == null || row.ItemNoSAP == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.ItemNoSAP + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Description",   // Tên sản phẩm
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Description == null || row.Description == "") {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + row.Description + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Size",  
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Size == null || row.Size == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.Size + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CupName",  // ten loai ly
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CupName == null || row.CupName == "") {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:left;font-weight:400;">' + row.CupName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UnitOfMeasure",  
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UnitOfMeasure == null || row.UnitOfMeasure == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.UnitOfMeasure + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Quantity",  
                        className: "text-center",
                        render: function (data, type, row) {   
                            var html = '<span style="display: block;">' + parseFloat(row.Quantity).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "UnitPrice",  // Đơn giá
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.UnitPrice).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "DiscountAmount",  // Giảm giá
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;font-weight:700;color: #db0b0b;">' + parseFloat(row.DiscountAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "LineAmountBeforeVAT",  // Thành tiền trước thuế
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;font-weight:700;">' + parseFloat(row.LineAmountBeforeVAT).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "VATCode",  // Thuế suất GTGT (%)
                        render: function (data, type, row) {
                            //debugger
                            var VATCode = row.VATCode;
                            var html = "";
                            if (VATCode == null || VATCode == "") {
                                html += '<span style="display: block; text-align:center;">' + "" + '</span>';
                            }
                            else if (VATCode == 0) {
                                html += '<span style="display: block; text-align:center;">' + VATCode + "%" + '</span>';
                            }
                            else {
                                html += '<span style="display: block; text-align:center;">' + ((VATCode == 1) ? "Non Tax" : VATCode + "%") + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "VATAmount",  // Tiền thuế VAT
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.VATAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "LineAmountIncVAT",  // Thành tiền sau thuế
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;font-weight:700;">' + parseFloat(row.LineAmountIncVAT).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "ChanelSales",   // Kenh ban hang
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ChanelSales == null || row.ChanelSales == "") {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="display:block;text-align:center;font-weight:400;">' + row.ChanelSales + '</span>';
                            }
                            return html;
                        }
                    }
                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('#tbl-detail-revenue-report-list tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var _fromDate = getFromDate();
                var _toDate = getToDate();
                if (_fromDate > _toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {             
                var _fromDate = getFromDate();
                var _toDate = getToDate();
                if (_fromDate > _toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày. Vui lòng kiểm tra lại');
                    return;
                }
                $('#hdFromDate').val(_fromDate);
                $('#hdToDate').val(_toDate);
                $('#frm-export-excel').submit();
            });




        });

    </script>
}

