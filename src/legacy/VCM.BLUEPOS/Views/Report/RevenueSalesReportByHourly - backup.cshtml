                            return html;
                        }
                    },

                    {
                        data: "NowFood",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.NowFood).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "WebSite",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.WebSite).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "RDAmount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.RDAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "QAAmount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.QAAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "EduAmount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.EduAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "DeliveryAmount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.DeliveryAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "CallCenterAmount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; text-align:right;">' + parseFloat(row.CallCenterAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('#tbl-revenue-sales-report-by-hourly tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                //debugger
                var a1 = $('#txt-to-date').val();
                var b1 = $('#txt-from-date').val();
                if (a1 == "" || b1 == "") {
                    toastr.error('Vui lòng chọn từ ngày / đến ngày');
                    return;
                }

                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày không lớn hơn đến ngày');
                    return;
                }

                var a = parseDate($('#txt-to-date').val()).getTime();
                var b = parseDate($('#txt-from-date').val()).getTime();
                var checkDay = Math.ceil((a - b) / (24 * 60 * 60 * 1000));

                if (checkDay > 31) {
                    toastr.error('Chỉ được xem báo cáo tối đa 31 ngày');
                    return;
                }

                var storeNo = $('#sel-store-no').val();
                if (storeNo == null || storeNo == "") {
                    toastr.error('Vui lòng chọn cửa hàng');
                    return;
                }

                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                //debugger

                var a1 = $('#txt-to-date').val();
                var b1 = $('#txt-from-date').val();
                if (a1 == "" || b1 == "") {
                    toastr.error('Vui lòng chọn từ ngày / đến ngày');
                    return;
                }

                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày không lớn hơn đến ngày');
                    return;
                }

                var _fromDate = getFromDateStr();
                var _toDate = getToDateStr();
                $('#hdFromDate').val(_fromDate);
                $('#hdToDate').val(_toDate);

                var a = parseDate($('#txt-to-date').val()).getTime();
                var b = parseDate($('#txt-from-date').val()).getTime();
                var checkDay = Math.ceil((a-b) / (24*60*60*1000));
                if (checkDay > 31) {
                    toastr.error('Chỉ được xem báo cáo tối đa 31 ngày');
                    return;
                }

                //if (checkDay >= 7) {
                //    toastr.error('Chỉ được xem báo cáo tối đa 7 ngày');
                //    return;
                //}

                var storeNo = $('#sel-store-no').val();
                if (storeNo == null || storeNo == "") {
                    toastr.error('Vui lòng chọn cửa hàng');
                    return;
                }

                ExportToExcel();

            });

        });

    </script>
}

