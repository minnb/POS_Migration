                            return html;
                        }
                    },

                    {
                        data: "Beamin",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 400; display: block; text-align:right;">' + parseFloat(row.Beamin).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BeFood",
                        render: function (data, type, row) {
