                    },

                    {
                        data: "TotalAmountIncVAT", // Doanh thu sau thue
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 700; display: block; text-align:right;">' + parseFloat(row.TotalAmountIncVAT).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AtStore",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 400; display: block; text-align:right;">' + parseFloat(row.AtStore).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "GrabFood",
                        render: function (data, type, row) {
