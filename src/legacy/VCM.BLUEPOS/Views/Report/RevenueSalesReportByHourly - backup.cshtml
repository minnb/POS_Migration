@section Scripts
{
    <script type="text/javascript">
        var table;
        function LoadComboxStore() {
            //debugger
            var html = '<select class="form-control select2" multiple="multiple" style="width: 100%;" id="sel-store-no" name="StoreNo">';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxStoreNoByUser", "Common")',
                dataType: "json",
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value=" + name.SiteNo + ">" + name.SiteNo + "-" + name.SiteName + "</option>";
                            }
                        });

                         html += '</select>';
                         $("#div-store-no").html(html);
                         $('#sel-store-no').fSelect({
                            placeholder: '---- Chọn ----',
                            numDisplayed: 1,
                            overflowText: '{n} Cửa hàng được chọn',
                            searchText: 'Tìm kiếm....',
                            noResultsText: 'Không tìm thấy cửa hàng',
                            showSearch: true,
                            optionFormatter: false,
                            isSelectAll: true,
                            includeSelectAllOption: true
                         });
                    }
                },
                error: function () {
                }
            });
        }

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];   // dd/MM/yyyy
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];   // dd/MM/yyyy
            }
            else {
                result = "";
            }
            return result;
        }

        function getFromDateStr() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "-" + fromDate.split('/')[1] + "-" + fromDate.split('/')[0];  // yyyy-MM-dd 
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDateStr() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "-" + toDate.split('/')[1] + "-" + toDate.split('/')[0];  // yyyy-MM-dd  
            }
            else {
                result = "";
            }
            return result;
        }

        function parseDate(str) {
            var mdy = str.split('/');
            return new Date(mdy[2], mdy[1], mdy[0]);
        };

        function ExportToExcel() {
            //debugger
            var fromDate = getFromDateStr();
            var toDate = getToDateStr();
            var storeNo = JSON.stringify($('#sel-store-no').val());
            var salesType = $('#sel-sales-type').val();
            loading.showloading();
            $.ajax({
                url: '@Url.Action("ExportExcel_GetRevenueSalesByHourly", "Report")',
                type: "POST",
                datatype: "json",
                data: {
                    FromDate: fromDate,
                    ToDate: toDate,
                    StoreNo: storeNo,
                    SalesType: salesType
                },
                success: function (data) {
                    loading.hideloading();
                    window.location = '/Report/DownloadFile?fileName=' + data;
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


        $(document).ready(function () {
            $('.select2').select2();
            LoadComboxStore();
            
            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            table = $('#tbl-revenue-sales-report-by-hourly').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true, 
                
                ajax: {
                    url: '@Url.Action("GetRevenueSalesByHourly", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.FromDate = getFromDateStr();
                        d.ToDate = getToDateStr();
                        d.StoreNo = JSON.stringify($('#sel-store-no').val());
                        d.SalesType = $('#sel-sales-type').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="font-weight:700; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700; display: block;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    //{
                    //    data: "OrderNo",
                    //    className: "text-center",
                    //    render: function (data, type, row) {
                    //        var html = "";
                    //        if (row.OrderNo == null || row.OrderNo == "") {
                    //            html += '<span style="font-weight:700; display: block;">' + "" + '</span>';
                    //        }
                    //        else {
                    //            html += '<span style="font-weight:700; display: block;">' + row.OrderNo + '</span>';
                    //        }
                    //        return html;
                    //    }
                    //},

                    //{
                    //    data: "SalesType", // Hinh thuc ban hang
                    //    className: "text-center",
                    //    render: function (data, type, row) {
                    //        var html = "";
                    //        if (row.SalesType == null || row.SalesType == "") {
                    //            html += '<span style="font-weight:400; display: block;">' + "" + '</span>';
                    //        }
                    //        else if (row.SalesType == "Đơn hàng bán") {
                    //            html += '<span style="font-weight:400; display: block;">' + row.SalesType + '</span>';
                    //        }
                    //        else if (row.SalesType == "Đơn hàng trả") {
                    //            html += '<span style="font-weight:400; display: block;color: #db0b0b;">' + row.SalesType + '</span>';
                    //        }
                    //        return html;
                    //    }
                    //},

                    {
                        data: "ForDate",   // Ngày kinh doanh
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:400; display: block;">' + row.ForDate + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "OnHourStr",  // Khoảng thời gian
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 700; display: block;">' + row.OnHourStr + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "TotalAmountNET",  // Doanh thu truoc thue
                        render: function (data, type, row) {   
                            var html = '<span style="font-weight: 700; display: block; text-align:right;">' + parseFloat(row.TotalAmountNET).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AmountVAT", // Tien thue VAT
                        render: function (data, type, row) {
                            var html = '<span style="font-weight: 700; display: block; text-align:right;">' + parseFloat(row.AmountVAT).toLocaleString('en') + '</span>';
                            return html;
