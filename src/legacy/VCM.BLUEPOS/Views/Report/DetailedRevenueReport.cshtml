    </div>
</div>


<input type="hidden" id="temp-from-date-check-31" />
<input type="hidden" id="temp-to-date-check-31" />


@section Scripts
{
    <script type="text/javascript">

        var table;

        function LoadComboxStoreByServer(ipServer) {
            $("#sel-store-no").empty();
            if (ipServer == null || ipServer == '') {
                var html = "<option value=\"\" selected>Tất cả</option>";
                return $('#sel-store-no').html(html);
            }
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data != null) {
                        if (data.length == 1) {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                        }
                        else if (data.length > 1) {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) => {
                                if (name.SiteNo != "") {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                        }
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function getFromDate() {
            //debugger
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var toDate = $('#txt-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $('#txt-return-order').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-text-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        function getFromDateByCheck31(fromDateStr) {
            $('#fromDateStr').val(moment().format('DD/MM/YYYY'));

            $('#fromDateStr').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            var dateStr = $('#fromDateStr').val();
            return dateStr;
        }

        function getToDateByCheck31(toDateStr) {
            $('#toDateStr').val(moment().format('DD/MM/YYYY'));

            $('#toDateStr').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            var dateStr = $('#toDateStr').val();
            return dateStr;
        }

        $(document).ready(function () {

            $('.select2').select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadComboxStoreByServer($("#sel-set-server").val());
            $("#sel-set-server").on("change", function (e) {
                LoadComboxStoreByServer($("#sel-set-server").val());
            });

            table = $('#tbl-detail-revenue-report-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                ajax: {
                    url: '@Url.Action("GetDetailRevenueReport", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.fromDate = getFromDate();
                        d.toDate = getToDate();
                        d.setServer = $('#sel-set-server').val();
                        d.serverRead = $("#sel-set-server").select2().find(":selected").data("serverread");
                        d.storeNo = $('#sel-store-no').val();
                        d.vatCode = $('#sel-vat-code').val();
                        d.orderType = $('#sel-order-type').val();
                        d.returnOrder = $('#txt-return-order').val();
                        d.textSearch = $('#txt-text-search').val();
                        d.userID = $('#sel-user-create-bill').val();
                        d.salesType = $('#sel-sales-type').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StartingTimeStr",   // Ngày tạo đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StartingTimeStr == null || row.StartingTimeStr == "") {
                                html += '<span style="font-weight:700; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700; display: block;">' + row.StartingTimeStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderTimeStr",    // Thời gian
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
