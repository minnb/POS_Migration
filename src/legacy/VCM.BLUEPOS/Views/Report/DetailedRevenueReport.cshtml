                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Thuế suất (%)<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-vat-code" name="VatCode">
                                            <option value="" selected>Tất cả</option>
                                            <option value="4">10%</option>              <!--- Code SQL: 4 = 10% -->
                                            <option value="5">8%</option>               <!--- Code SQL: 5 = 8% -->
                                            <option value="3">5%</option>               <!--- Code SQL: 3 = 5%-->
                                            <option value="2">0%</option>               <!--- Code SQL: 2 = 0% -->
                                            <option value="6">Non Tax</option>          <!--- Code SQL: 6 = Khong xuat hoa don -->
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại đơn hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-order-type" name="OrderType">
