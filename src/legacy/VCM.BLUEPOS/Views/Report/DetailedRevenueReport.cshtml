                                html += '<span style="font-weight:700; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700; display: block;">' + row.OrderTimeStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderDateStr",    // Ngày kinh doanh
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
