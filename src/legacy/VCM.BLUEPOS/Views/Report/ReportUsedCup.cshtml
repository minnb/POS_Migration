@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Báo cáo sử dụng LY";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = ViewBag.ListSite as List<StoreModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo sử dụng LY</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                        @if (listSite != null && listSite.Count > 0)
                                        {
                                            if (listSite.Count == 1)
                                            {
                                                var ht = $"{ listSite.FirstOrDefault().StoreNo} : {listSite.FirstOrDefault().StoreName}";
                                                <option value="@listSite.FirstOrDefault().StoreNo">@ht</option>
                                            }
                                            else
                                            {
                                                foreach (var item in listSite)
                                                {
                                                    var ht = $"{ item.StoreNo} : {item.StoreName}";
                                                    <option value="@item.StoreNo">@ht</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Ngày kinh doanh</label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchNgayKD" name="NgayKinhDoanh" placeholder="Chọn ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Ca</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slShiftCode" name="ShiftCode">
                                        <option value="">Tất cả</option>
                                        <option value="1">Ca 1</option>
                                        <option value="2">Ca 2</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="margin-top:25px">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary" id="btnSearch"><i class="fa fa-search"></i> Tìm </button>
                                    <button type="button" class="btn btn-success" id="btnExcelCup"><i class="fa fa-file-excel"></i> Xuất excel </button>
                                </div>
                            </div>
                        </div>

                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                        
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="loadData">
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        $(document).ready(function () {

            $('.select2').select2();

            $('#searchNgayKD').val(moment().format('DD/MM/YYYY'));
            $('#searchNgayKD').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $("#btnSearch").on("click", function (e) {
                var storeNo = $("#slSiteNo").val();
                var shiftCode = $("#slShiftCode").val();
                var bussinessDate = $("#searchNgayKD").val();

                if (storeNo == "") {
                    toastr.error("Vui lòng chọn CH/ST");
                    return;
                }
                if (bussinessDate == "") {
                    toastr.error("Vui lòng chọn ngày kinh doanh");
                    return;
                }
                loading.showloading();
                $.ajax({
                    type: "GET",
                    url: "/Report/_ViewReportCup?storeNo=" + storeNo + "&ngayKD=" + bussinessDate + "&shiftCode=" + shiftCode + "",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        $("#loadData").html(result);
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });

            });

            $("#btnExcelCup").on("click", function (e) {
                var storeNo = $("#slSiteNo").val();
                var shiftCode = $("#slShiftCode").val();
                var bussinessDate = $("#searchNgayKD").val();

                if (storeNo == "") {
                    toastr.error("Vui lòng chọn CH/ST");
                    return;
                }
                if (bussinessDate == "") {
                    toastr.error("Vui lòng chọn ngày kinh doanh");
                    return;
                }

                loading.showloading();
                e.preventDefault();

                var req = new XMLHttpRequest();
                var url = "/Report/ExportExcelReportCup?storeNo=" + storeNo + "&ngayKD=" + bussinessDate + "&shiftCode=" + shiftCode + "";
                
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "ListCup_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });
        });
    </script>
}

