@using VCM.BLUEPOS.Model.Report;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;

@{
    ViewBag.Title = "Báo cáo kết ca VinMart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo kết ca VinMart</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ReportShiftEndVMExcel", "Report", FormMethod.Get, new { @id = "frmExcel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Vùng Set</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slSetDB" name="SetServer">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo"></select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày kinh doanh</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchFromDate" name="BussinessDate" placeholder="Ngày kinh doanh">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã NV</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" placeholder="Mã NV" style="width:100%;" id="txtStaffCode" name="StaffCode" />
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slStatus" name="Status">
                                            <option value="">Tất cả</option>
                                            <option value="0">Chưa đóng ca</option>
                                            <option value="1">Đã đóng ca</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary btn-search" style="" id="btnSearch"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        <button type="submit" class="btn btn-success" id="btnExportExcel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <table class="table table-bordered table-striped" id="table-report-shift-end-vm">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>Mã ST/CH</th>
                                    <th>Mã NV</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>Ca</th>
                                    <th>Tiền đầu ca</th>
                                    <th>Tiền mặt</th>
                                    <th>Tiền hệ thống</th>
                                    <th>Chênh lệch</th>
                                    <th>T/G đóng ca</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section scripts {
    <script type="text/javascript">
        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            const startOfMonth = moment().clone().startOf('month');
            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            LoadReport();
            $("#btnSearch").on("click", function (e) {
                table.draw();
            });

            LoadComboboxStoreByServer($("#slSetDB").val());
            $("#slSetDB").on("change", function (e) {
                LoadComboboxStoreByServer($("#slSetDB").val());
            });

            $("#frmExcel").submit(function (e) {
                loading.showloading();
                e.preventDefault();
                var setDB = $("#slSetDB").val();
                //var serverRead = $("#slSetDB").select2().find(":selected").data("serverread");
                var storeNo = $("#slSiteNo").val();
                var ngayKD = $("#searchFromDate").val();
                var maNV = $("#txtStaffCode").val();
                var status = $("#slStatus").val();

                var req = new XMLHttpRequest();
                var url = '/Report/ReportShiftEndVMExcel?SetDB=' + setDB + '&SiteNo=' + storeNo + '&BussinessDate=' + ngayKD + '&StaffCode=' + maNV + '&Status=' + status;
                //var url = '/Report/ReportShiftEndVMExcel?SetDB=' + setDB + '&ServerRead=' + serverRead + '&SiteNo=' + storeNo + '&BussinessDate=' + ngayKD + '&StaffCode=' + maNV + '&Status=' + status;

                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "ShiftVM_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });
        });

        function LoadComboboxStoreByServer(ipServer) {
            var html = "<option value=\"\" selected>Tất cả</option>";
            if (ipServer == null || ipServer == '') {
                return $('#slSiteNo').html(html);
            }
            $("#slSiteNo").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                            }
                        });
                        $('#slSiteNo').html(html);
                    }                    
                },
                error: function () {}
            });
        }

        function LoadReport() {
            table = $('#table-report-shift-end-vm').DataTable({
                drawCallback: function (settings) {
                    // Xem chi tiet
                    $(".btn-search-detail").click(function () {
                        var storeNo = $(this).attr("data-storeNo");
                        var dateBussiness = $("#searchFromDate").val();
                        ViewDetail(storeNo, dateBussiness);
                    });
                },
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,                  // for show progress bar
                serverSide: true,                   // for process server side
                filter: true,                       // this is for disable filter (search box)
                orderMulti: false,                  // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                info: true,
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("ReportShiftEndVMLoad", "Report")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.SetDB = $("#slSetDB").val();
                        d.StoreNo = $("#slSiteNo").val();
                        d.BussinessDate = $("#searchFromDate").val();
                        d.StaffCode = $("#txtStaffCode").val();
                        d.IsShiftClosed = $("#slStatus").val();
                    }
                },

                columns: [
                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },

                    {
                        data: "StaffCode",
                        className: 'text-center'
                    },

                    {
                        data: "FormatBussinessDate",
                        className: 'text-center'
                    },

                    {
                        data: "ShiftNumber",
                        className: 'text-center'
                    },
                    {
                        data: "BeginAmount",
                        render: function (data, type, row) {
                            var html = "";
                            var BeginAmount = row.BeginAmount;
                            html = '<span style="">' + parseFloat(BeginAmount).toLocaleString('en') + '</span>';
                            return html;
                        },
                        className: 'text-center',
                    },

                    {
                        data: "CloseAmount",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            var CloseAmount = row.CloseAmount;
                            html = '<span style="">' + parseFloat(CloseAmount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "AmountTendered",
                        render: function (data, type, row) {
                            var html = "";
                            var AmountTendered = row.AmountTendered;
                            html = '<span style="">' + parseFloat(AmountTendered).toLocaleString('en') + '</span>';
                            return html;
                        },
                        className: 'text-center',
                    },
                    {
                        data: "BlanceMoney",
                        render: function (data, type, row) {
                            var html = "";                        
                            var BlanceMoney = row.BlanceMoney;
                            html = '<span style="">' + parseFloat(BlanceMoney).toLocaleString('en') + '</span>';
                            return html;
                        },
                        className: 'text-center',
                    },

                    {
                        data: "FormatCloseShiftDate",
                        className: 'text-center'
                    },

                    {
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsShiftClosed == 1)
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Đã đóng ca</span>";
                            else
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Chưa đóng ca</span>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }
    </script>
}


