@{
    Layout = null;
}

@using VCM.BLUEPOS.Model.Report;
@model ExportPDFRevenueOrderSalesByStoreModel


<!DOCTYPE html>
<html lang="en" manifest="">
<head>
    <title>Doanh thu theo cửa hàng</title>
    @Styles.Render("~/Content/css")
    <style>
        table > tbody > tr {
            line-height: 10px !important;
        }
    </style>
    @{
    }
</head>
<body>
    <section class="content">
        <div class="container-fluid">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1" style="font-family:Arial !important">

                <!-- title row -->
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <span class="float-left">
                            ID của người dùng: @Model.UserName
                            <br />
                            Tên người dùng: @Model.FullName
                        </span>
                        <span class="float-right">
                            Ngày giờ: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            <br />@*Trang 1/1*@
                        </span>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- info row -->
                <div class="row" style="clear:both;padding-top:20px;">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                        <h3 class="text-center text-uppercase" style="font-size:20px;font-weight:bold;margin-bottom:20px;">Tổng hợp doanh thu theo cửa hàng</h3>
                        <span class="float-left">
                            <strong>
                                Ngày giao dịch:
                            </strong> @Model.TransDate
                        </span>

                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <table class="table table-bordered">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>STT</th>
                                    <th>Mã CH/ST</th>
                                    <th>Tên CH/ST</th>
                                    <th>Tổng hóa đơn</th>
                                    <th style="text-align:right">Doanh thu</th>

                                </tr>
                            </thead>
                            <tbody>
                                @{ if (Model.lstSaleStore.Count > 0)
                                    {
                                        var stt = 1;
                                        var total = 0.0;
                                        var totalBill = 0.0;
                                        foreach (var item in Model.lstSaleStore)
                                        {
                                            <tr>
                                                <td style="text-align:center">
                                                    @stt
                                                </td>
                                                <td style="text-align:center">
                                                    @item.StoreNo
                                                </td>
                                                <td style="text-align:left"> @item.StoreName</td>
                                                <td style="text-align:center"> @string.Format("{0:###,###}", item.CountOrderTotal)</td>
                                                <td style="text-align:right">@string.Format("{0:###,###}", item.AmountTotal)</td>
                                            </tr>
                                            stt++;
                                            total += (double)item.AmountTotal;
                                            totalBill += (double)item.CountOrderTotal;
                                        }
                                        <tr style="font-weight:bold;font-size:16px;background-color:#cecaca">
                                            <td colspan="3">Total</td>
                                            <td style="text-align:center">@string.Format("{0:###,###}", totalBill)</td>
                                            <td style="text-align:right">@string.Format("{0:###,###}", total)</td>
                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>


            </div>
        </div>

    </section>

</body>
</html>
