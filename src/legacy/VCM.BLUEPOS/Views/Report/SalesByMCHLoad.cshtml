@{
    Layout = null;
}

@using VCM.BLUEPOS.Model.Report
@model SalesByMCHRepsone

<!DOCTYPE html>
<html lang="en" manifest="">
<head>
    <title>Doanh thu theo ngành hàng</title>
    @Styles.Render("~/Content/css")

    <style>
        table > tbody > tr {
            line-height: 10px !important;
        }
        tr {
            page-break-inside: avoid;
        }
    </style>
    @{

    }
</head>
<body>
    <section class="content">
        <div class="container-fluid">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1" style="font-family:Arial !important">

                <!-- title row -->
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <span class="float-left">
                            ID của người dùng: @Model.UserName
                            <br />
                            Tên người dùng:@Model.FullName
                        </span>
                        <span class="float-right">
                            Ngày giờ: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            <br />@*Trang 1/1*@
                        </span>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- info row -->

                <div class="row" style="clear:both;padding-top:20px;">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                        <h3 class="text-center text-uppercase" style="font-size:20px;font-weight:bold;margin-bottom:20px;">Tổng hợp doanh thu theo ngành hàng</h3>
                        <span class="float-left">
                            @if (Model.Status == false)
                            {
                                var tenCH = "";
                                <strong>Siêu thị / Cửa hàng:</strong> @tenCH <br />
                            }
                            else
                            {
                                if (!string.IsNullOrEmpty(Model.StoreName))
                                {
                                    var tenCH = Model.StoreNo + " - " + Model.StoreName;
                                    <strong>Siêu thị / Cửa hàng:</strong> @tenCH <br />
                                }
                                else
                                {
                                    var tenCH = "Tất cả";
                                    <strong> Siêu thị / Cửa hàng:</strong> @tenCH <br />
                                }
                            }
                            <strong>
                                Ngày giao dịch:
                            </strong> @Model.TransDate
                        </span>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        @if (Model.Status == true)
                        {
                            if (Model.ListData.Count > 0)
                            {
                                var day = Model.ToDate.Value.Date.Subtract(Model.FromDate.Value.Date).TotalDays;
                                <table class="table table-bordered table-striped" style="width:100%">
                                    <thead>
                                        <tr style="text-align:center;text-transform:uppercase;">
                                            <th style="vertical-align:middle">STT</th>
                                            <th style="min-width:100px;vertical-align:middle">ST/CH</th>
                                            <th style="min-width:200px;vertical-align:middle">Tên ngành hàng</th>
                                            <th style="vertical-align:middle">Số lượng/<br />Số tiền</th>
                                            @for (int i = 0; i <= day; i++)
                                            {
                                                <th style="vertical-align:middle">
                                                    @{
                                                        var date = @Model.FromDate.Value.Date.AddDays(i);
                                                    }
                                                    <div>
                                                        @date.ToString("dd/MM")
                                                    </div>
                                                    <div>
                                                        (@date.DayOfWeek.ToString().Substring(0, 3))
                                                    </div>
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ var stt = 1;
                                            var data = Model.ListData;
                                            if (!string.IsNullOrEmpty(Model.StoreName))
                                            {
                                                //var listMCH = data.GroupBy(d => new { d.MCHCode, d.MCHName }).Select(a => new { a.Key.MCHCode, a.Key.MCHName }).OrderBy(d => d.MCHCode).ToList();
                                                var listMCH = data.GroupBy(d => new { d.StoreNo, d.StoreName, d.MCHCode, d.MCHName }).Select(a => new { a.Key.StoreNo, a.Key.StoreName, a.Key.MCHCode, a.Key.MCHName }).OrderBy(d => d.MCHCode).ToList();

                                                foreach (var itemMCH in listMCH)
                                                {
                                                    <tr>
                                                        <td style="text-align:center;vertical-align:middle">
                                                            @stt
                                                        </td>
                                                        <td style="text-align:left;vertical-align:middle;min-width:100px">
                                                            <div>@itemMCH.StoreNo</div>
                                                            <div style="margin-top:10px; width:100%">@itemMCH.StoreName</div>
                                                        </td>
                                                        <td style="text-align:left;vertical-align:middle;min-width:200px">
                                                            <div>@itemMCH.MCHCode</div>
                                                            <div style="margin-top:10px; width:100%">@itemMCH.MCHName</div>
                                                        </td>
                                                        <td style="text-align:right;vertical-align:middle">
                                                            @{
                                                                var totalAmountByMCH = data.Where(d => d.MCHCode == itemMCH.MCHCode)?.Sum(d => d.AmountTotal);
                                                                var totalQtyByMCH = data.Where(d => d.MCHCode == itemMCH.MCHCode)?.Sum(d => d.OrderTotal);
                                                            }
                                                            <div> @string.Format("{0:###,###}", totalQtyByMCH)</div>
                                                            <div style="margin-top:10px;">
                                                                @string.Format("{0:###,###}", totalAmountByMCH)
                                                            </div>
                                                        </td>
                                                        @for (int i = 0; i <= day; i++)
                                                        {
                                                            var dateBS = Model.FromDate.Value.Date.AddDays(i);
                                                            var amountByDate = data.FirstOrDefault(d => d.MCHCode == itemMCH.MCHCode && d.BussinessDate.Value == dateBS)?.AmountTotal;
                                                            var qtyByDate = data.FirstOrDefault(d => d.MCHCode == itemMCH.MCHCode && d.BussinessDate.Value == dateBS)?.OrderTotal;
                                                            <td style="text-align:right;vertical-align:middle">
                                                                <div> @string.Format("{0:###,###}", qtyByDate)</div>
                                                                <div style="margin-top:10px;">
                                                                    @string.Format("{0:###,###}", amountByDate)
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                    stt++;
                                                }
                                            }
                                            else // 12/07/2022
                                            {
                                                //var listMCH = data.GroupBy(d => new { d.MCHCode, d.MCHName }).Select(a => new { a.Key.MCHCode, a.Key.MCHName }).OrderBy(d => d.MCHCode).ToList();
                                                var listMCH = data.GroupBy(d => new { d.StoreNo, d.StoreName, d.MCHCode, d.MCHName }).Select(a => new { a.Key.StoreNo, a.Key.StoreName, a.Key.MCHCode, a.Key.MCHName }).OrderBy(d => d.MCHCode).ToList();

                                                foreach (var itemMCH in listMCH)
                                                {
                                                    <tr>
                                                        <td style="text-align:center;vertical-align:middle">
                                                            @stt
                                                        </td>
                                                        <td style="text-align:left;vertical-align:middle;min-width:100px">
                                                            <div>@itemMCH.StoreNo</div>
                                                            <div style="margin-top:10px; width:100%">@itemMCH.StoreName</div>
                                                        </td>
                                                        <td style="text-align:left;vertical-align:middle;min-width:200px">
                                                            <div>@itemMCH.MCHCode</div>
                                                            <div style="margin-top:10px; width:100%">@itemMCH.MCHName</div>
                                                        </td>
                                                        <td style="text-align:right;vertical-align:middle">
                                                            @{
                                                                var totalAmountByMCH = data.Where(d => d.MCHCode == itemMCH.MCHCode)?.Sum(d => d.AmountTotal);
                                                                var totalQtyByMCH = data.Where(d => d.MCHCode == itemMCH.MCHCode)?.Sum(d => d.OrderTotal);
                                                            }
                                                            <div> @string.Format("{0:###,###}", totalQtyByMCH)</div>
                                                            <div style="margin-top:10px;">
                                                                @string.Format("{0:###,###}", totalAmountByMCH)
                                                            </div>
                                                        </td>
                                                        @for (int i = 0; i <= day; i++)
                                                        {
                                                            var dateBS = Model.FromDate.Value.Date.AddDays(i);
                                                            var amountByDate = data.FirstOrDefault(d => d.MCHCode == itemMCH.MCHCode && d.BussinessDate.Value == dateBS)?.AmountTotal;
                                                            var qtyByDate = data.FirstOrDefault(d => d.MCHCode == itemMCH.MCHCode && d.BussinessDate.Value == dateBS)?.OrderTotal;
                                                            <td style="text-align:right;vertical-align:middle">
                                                                <div> @string.Format("{0:###,###}", qtyByDate)</div>
                                                                <div style="margin-top:10px;">
                                                                    @string.Format("{0:###,###}", amountByDate)
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                    stt++;
                                                }
                                            }

                                            <tr style="font-weight:bold;font-size:14px;background-color:#cecaca">
                                                <td colspan="3" style="text-align:center;vertical-align:middle">Tổng cộng:</td>
                                                <td style="text-align:right;vertical-align:middle">
                                                    @{
                                                        var totalAmount = data.Sum(d => d.AmountTotal);
                                                        var totalQty = data.Sum(d => d.OrderTotal);
                                                    }
                                                    <div> @string.Format("{0:###,###}", totalQty)</div>
                                                    <div style="margin-top:10px;">
                                                        @string.Format("{0:###,###}", totalAmount)
                                                    </div>
                                                </td>
                                                @for (int i = 0; i <= day; i++)
                                                {
                                                    var dateBS = Model.FromDate.Value.Date.AddDays(i);
                                                    var totalAmountByDate = data.Where(d => d.BussinessDate.Value == dateBS)?.Sum(d => d.AmountTotal);
                                                    var totalQtyByDate = data.Where(d => d.BussinessDate.Value == dateBS)?.Sum(d => d.OrderTotal);
                                                    <td style="text-align:right">
                                                        <div> @string.Format("{0:###,###}", totalQtyByDate)</div>
                                                        <div style="margin-top:10px;">
                                                            @string.Format("{0:###,###}", totalAmountByDate)
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            }
                        }
                        else
                        {
                            <div class="">
                                <br />
                                <h3 class="text-center" style="font-size:13px;font-weight:bold;margin-bottom:20px;color:#333;text-align:center;">@Model.Message</h3>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

</body>
</html>