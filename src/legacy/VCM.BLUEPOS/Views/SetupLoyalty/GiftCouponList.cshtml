@using VCM.BLUEPOS.Model.Voucher;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Báo cáo coupon đã phát hành";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listCouponType = (List<OptionModel>)ViewBag.ListCouponType;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Loyalty</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo coupon đã phát hành</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelGiftCouponList", "SetupLoyalty", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tình trạng sử dụng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-is-used" name="IsUsed">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Đã sử dụng</option>
                                            <option value="0">Chưa sử dụng</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái gửi CX<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-send-cx" name="SendCX">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Đã gửi CX</option>
                                            <option value="0">Chưa gửi CX</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Số đơn hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-order-no" name="OrderNo" placeholder="Nhập số đơn hàng bán" />
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Serial / Coupon</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-coupon-code" name="CouponCode" placeholder="Nhập số serial; coupon" />
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-text-search" name="TextSearch" placeholder="Nhập số điện thoại,..." />
                                    </div>
                                </div>

                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />

                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <table id="tbl-loyalty-gift-code-list" class="table table-bordered table-hover text-nowrap">
                                            <thead>
                                                <tr class="text-center" style="text-transform:uppercase;">
                                                    <th>STT</th>
                                                    <th>Thời gian</th>
                                                    <th>Số đơn hàng bán</th>
                                                    <th>Số điện thoại</th>
                                                    <th>Số serial</th>
                                                    <th>Mã coupon</th>
                                                    <th>Từ ngày</th>
                                                    <th>Đến ngày</th>
                                                    <th>Tình trạng sử dụng</th>
                                                    <th>Trạng thái gửi CX</th>
                                                    <th>Nội dung</th>
                                                    <th>Số đơn hàng đã sử dụng</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {

    <script type="text/javascript">

        var table;

        function getFromDate() {
            var result = "";
            var fromDate = $('#txt-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        function getToDate() {
            var result = "";
            var fromDate = $('#txt-to-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        }

        $(document).ready(function () {
            $(".select2").select2();

            $('#txt-from-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-from-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#txt-to-date').val(moment().format('DD/MM/YYYY'));
            $('#txt-to-date').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            table = $('#tbl-loyalty-gift-code-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                processing: false,               // for show progress bar
                serverSide: true,                // for process server side
                lengthChange: false,             // disable lenghthMenu
                filter: false,                   // this is for disable filter (search box)
                orderMulti: false,               // for disable multiple column at once
                autoWidth: false,
                searching: false,                // Show (search box)
                ordering: false,
                displayLength: 15,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetGiftCodeList", "SetupLoyalty")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.FromDate = $('#txt-from-date').val();
                        d.ToDate = $('#txt-to-date').val();
                        d.OrderNo = $('#txt-order-no').val();
                        d.Coupon = $('#txt-coupon-code').val();
                        d.IsUsed = $('#sel-is-used').val();
                        d.SendCX = $('#sel-send-cx').val();
                        d.TextSearch = $('#txt-text-search').val();
                    }
                },

                columns: [
                    {
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "CrtDateStr",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CrtDateStr == null | row.CrtDateStr == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.CrtDateStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderNo",  // don hang ban
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null | row.OrderNo == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "MemberCard", // so dien thoai
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.MemberCard == null | row.MemberCard == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.MemberCard + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CouponCode",  // So serial
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CouponCode == null | row.CouponCode == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.CouponCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "MaterialNo", // Ma coupon
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.MaterialNo == null | row.MaterialNo == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.MaterialNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "FromDateStr",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.FromDateStr == null | row.FromDateStr == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.FromDateStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ToDateStr",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ToDateStr == null | row.ToDateStr == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.ToDateStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsUsed",  // tinh trang su dung
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsUsed == null | row.IsUsed == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else if (row.IsUsed == "Đã sử dụng") {
                                html += '<span style="font-weight:700;display:block;color:#3699ff;">' + row.IsUsed + '</span>';
                            }
                            else if (row.IsUsed == "Chưa sử dụng") {
                                html += '<span style="font-weight:700;display:block;color:#ff0000;">' + row.IsUsed + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsSync",  // trang thai gui CX
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsSync == "Đã send") {
                                html += '<span class=\"badge bg-success\" style="font-weight:400;display:block;color:#fff;">Đã send</span>';
                            }
                            else {
                                html += '<span class=\"badge bg-danger\" style="font-weight:400;display:block;color:#fff;">Chưa send</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Message",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Message == null | row.Message == "") {
                                html += '<span style="font-weight:400;display:block;text-align:text;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:text;">' + row.Message + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OrderNoUsed",  // don hang da su dung
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNoUsed == null | row.OrderNoUsed == "") {
                                html += '<span style="font-weight:400;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;">' + row.OrderNoUsed + '</span>';
                            }
                            return html;
                        }
                    },

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });

            $('#tbl-loyalty-gift-code-list tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày');
                    return;
                }
                table.draw();
            })

        });

        $("#btn-export-excel").on("click", function (e) {
            var fromDate = getFromDate();
            var toDate = getToDate();
            if (fromDate > toDate) {
                toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày');
                return;
            }

            $('#hdFromDate').val(fromDate);
            $('#hdToDate').val(toDate);

            $('#frm-export-excel').submit();

        });





        function CheckSAP(voucherNumber) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('VoucherNumber', voucherNumber);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckToSAP", "Voucher")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (result) {
                    //debugger
                    if (result.ResultStatus != null) {
                        if (result.ResultStatus == 200) {
                            var name = result.ResutlData;
                            var html = "";
                            html += "<table id=\"\" class=\"table table-bordered\" style=\"width:100%;max-height:500px\">";
                            html += "<thead>";
                            html += "<tr>";
                            html += "<th style='text-align:center;'>Trạng thái</th>";
                            html += "<th style='text-align:center;'>ActicleNo</th>";
                            html += "<th style='text-align:center;'>ActicleType</th>";
                            html += "<th style='text-align:center;'>Mã Voucher</th>";
                            html += "<th style='text-align:center;'>Value</th>";
                            html += "<th style='text-align:center;'>Từ ngày</th>";
                            html += "<th style='text-align:center;'>Đến ngày</th>";
                            html += "</tr>";
                            html += "</thead>";
                            html += "</tbody>";
                            html += "<tr id=\"\">";

                            html += "</tr>";
                            html += "<tr id=\"\">";
                            html += "<td style=\"text-align:center;\">" + name.Status + "</td>";
                            html += "<td style=\"\">" + name.ActicleNo + "</td>";
                            html += "<td style=\"\">" + name.ActicleType + "</td>";
                            html += "<td style=\"\">" + name.VoucherNumber + "</td>";
                            html += "<td style=\"\">" + name.FormatValue + "</td>";

                            html += "<td style=\"\">" + name.Validity_From_Date + "</td>";
                            html += "<td style=\"\">" + name.Expiry_Date + "</td>";

                            html += "</tr>";

                            html += "</tbody>";
                            html += "</table>";
                            $('#listResult').html(html);
                            $("#titleNotFinish").html("CHECK SAP");

                            $('#modalResult').modal({
                                backdrop: 'static',
                                keyboard: false
                            });
                        }
                        else {
                            toastr.error(result.ResultMessage, 'Thông báo');
                        }
                    }
                    loading.hideloading();
                },
                error: function () {
                }
            });
        }

        function ResendToSAP() {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn resend tới SAP?',
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            loading.showloading();
                            var arrayVoucher = new Array();
                            $('#tbl-voucher-published input.chkOrderNo:checkbox:checked').each(function () {
                                //debugger
                                var serialNumber = $(this).closest('tr').find('td').eq(6).text();
                                arrayVoucher.push(serialNumber);
                            });

                            var listModel = JSON.stringify(arrayVoucher);
                            var fromData = new FormData();
                            fromData.append('ListVoucher', listModel);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("ResendVoucherToSAP", "Voucher")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (result) {
                                    //debugger
                                    if (result !=null) {
                                        var html = "";
                                        html += "<table id=\"\" class=\"table table-bordered\" style=\"width:100%;max-height:500px\">";
                                        html += "<thead>";
                                        html += "<tr>";
                                        html += "<th style='text-align:center;width:120px'>Mã voucher</th>";
                                        html += "<th style='text-align:center;width:120px'>Message</th>";
                                        html += "<th style='text-align:center;width:100px'>Trạng thái</th>";
                                        html += "</tr>";
                                        html += "</thead>";
                                        html += "</tbody>";
                                        result.forEach((name, i) => {
                                            //debugger
                                            html += "<tr id=\"\">";
                                            html += "<td style=\"text-align:center;\">" + name.VoucherNumber + "</td>";
                                            html += "<td style=\"max-width:400px\">" + name.MessageResult + "</td>";
                                            if (name.Result == true) {
                                                html += "<td style=\"text-align:center;\"><span class=\"badge bg-success\">Success</span></td>";
                                            }
                                            else {
                                                html += "<td style=\"text-align:center;\"><span class=\"badge bg-danger\">Fail</span></td>";
                                            }
                                            html += "</tr>";
                                        });
                                        html += "</tbody>";
                                        html += "</table>";

                                        $("#titleNotFinish").html("KẾT QUẢ RESEND TỚI SAP");
                                        $('#listResult').html(html);
                                        table.draw();
                                        $('#modalResult').modal({
                                            backdrop: 'static',
                                            keyboard: false
                                        });
                                    }
                                    loading.hideloading();
                                },
                                error: function () {
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });
        }

    </script>
}



