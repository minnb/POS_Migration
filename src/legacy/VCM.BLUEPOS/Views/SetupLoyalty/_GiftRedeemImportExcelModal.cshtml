
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
            <div class="card card-custom">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">File Excel</label>
                                        <div class="custom-file">
                                            <input type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" id="browse-file-excel" class="custom-file-input" />
                                            <label id="selected-file" class="custom-file-label" for="browse-file-excel">Chọn file excel</label>
                                        </div>
                                        <span class="form-text" id="click-down-file-example" style="cursor:pointer; color:#3699FF"><i class="fas fa-cloud-download-alt" style="color:#3699FF"></i>Download file excel mẫu(chỉ import đúng định dạng file mẫu)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <table id="tbl-import-file-excel-list" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center" style="text-transform:uppercase">
                                        <th style="width:10px;">#</th>
                                        <th style="padding-right:10px;">STT</th>
                                        <th>ID</th>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Đơn vị tính</th>
                                        <th>Điểm quy đổi</th>
                                        <th>Trạng thái</th>
                                        <th>Hiệu lực từ ngày</th>
                                        <th>Hiệu lực đến ngày</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    var table_data_list = "";
    $(".select2").select2();

    $("input[type='file']").change(function () {
        //debugger
        $('#selected-file').text(this.value.replace(/C:\\fakepath\\/i, ''));
    });

    $("#click-down-file-example").click(function (e) {
        loading.showloading();
        e.preventDefault();
        var req = new XMLHttpRequest();
        var url = "/Reward/ExcelExampleReward";
        req.open("GET", url, true);
        req.responseType = "blob";
        req.onload = function (event) {
            //debugger
            var blob = req.response;
            console.log(blob.size);
            if (blob.size > 10) {
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "FileMauMaDuThuong_" + fileName + ".xlsx";
                link.click();
            }
            else {
                toastr.error("Excel không có dữ liệu, nên không xuất được");
            }
            loading.hideloading();
        };
        req.send();

    });

    table_data_list = $('#tbl-import-file-excel-list').DataTable({
        destroy: true,
        dom: '<"top"iflp<"clear">>rt',
        responsive: true,
        processing: false,             
        serverSide: true,               
        filter: false,                  
        orderMulti: false,              
        autoWidth: true,
        ordering: false,
        displayLength: 10,
        searching: false,
        lengthChange: false,

        ajax: {
            url: '@Url.Action("RewardCodeLoad", "Reward")',
            type: "POST",
            datatype: "json",
            data: function (d) {
                d.RewardNo = $("#hdtxtRewardNo").val();
            }
        },

        createdRow: function (row, data, dataIndex) {
            $(row).attr('id', "rowRecord" + data.Code);
        },
        drawCallback: function (settings) {
        },
        columns: [
            {
                data: "RewardNo",
                className: "text-center",
                render: function (data, type, row, meta) {
                    var start = meta.settings._iDisplayStart;
                    return meta.row + 1 + start;
                }
            },

            {
                data: "Code",
                className: 'text-center'
            },

            {
                data: "Enabled",
                className: 'text-center',
                render: function (data, type, row) {
                    var html = "";
                    if (row.Enabled == true) {
                        html += "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                    }
                    else {
                        html += "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                    }
                    return html;
                }                
            },

            {
                data: "OrderNo",
                className: 'text-center',
                render: function (data, type, row) {
                    var html = "";
                    if (row.OrderNo == "" || row.OrderNo == null) {
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" disabled />";
                        html += "<span></span>";
                        html += "</label>";
                    }
                    else {
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" disabled checked />";
                        html += "<span></span>";
                        html += "</label>";
                    }
                    return html;
                }
            },

            {
                data: "OrderNo",
                className: 'text-center'
            }

        ]
    }).on('processing.dt', function (e, settings, processing) {

        if (processing) {
            loading.showloading();
        } else {
            loading.hideloading();
        }
        });


</script>
