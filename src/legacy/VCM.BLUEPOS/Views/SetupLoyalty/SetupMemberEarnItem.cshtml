@section Scripts
{
    <script type="text/javascript">
       
        var table_setup_member_earn_item = "";
        var table_item_import_list = "";

        $(".mask").inputmask('Regex', { regex: "^[0-9]{1,6}(\\.\\d{1,2})?$" });

        function getFromDate() {
            var result = "";
            var fromDate = $('#hdd-update-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "-" + fromDate.split('/')[1] + "-" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#hdd-update-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "-" + toDate.split('/')[1] + "-" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function parseDate(str) {
            var mdy = str.split('/');
            return new Date(mdy[2], mdy[1], mdy[0]);
        };

        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode
            return !(charCode > 31 && (charCode < 48 || charCode > 57));
        }

        function ImportExcelMemberEarnItem() {
            loading.showloading();
            var files = $('#browse-file-excel').get(0).files;
            var fileData = new FormData();
            fileData.append('ImportFile', files[0]);
            $.ajax({
                url: '/SetupLoyalty/ImportExcelMemberEarnItem',
                data: fileData,
                type: 'POST',
                datatype: 'json',
                contentType: false,
                processData: false,
                async: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        $('#selected-file').empty();
                        $('#sel-status').val('').trigger('change'); // Tat ca
                        $('#btn-search').trigger('click');
                        $('#modal-import-excel-file').modal('hide');
                    }
                    else {
                        $('#browse-file-excel').val('');
                        $('#selected-file').empty();
                        toastr.error(data.Message);
                        $('#browse-file-excel').val('');
                    }
                }
            });
        }

        $("#click-down-file-import-template").click(function (e) {
            loading.showloading();
            e.preventDefault();
            var req = new XMLHttpRequest();
            var url = "/SetupLoyalty/DownloadTemplate_MemberEarnItem";
            req.open("GET", url, true);
            req.responseType = "blob";
            req.onload = function (event) {
                //debugger
                var blob = req.response;
                console.log(blob.size);
                if (blob.size > 10) {
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "ImportMemberEarnItemTemplate_" + fileName + ".xlsx";
                    link.click();
                }
                else {
                    toastr.error("Excel không có dữ liệu, nên không xuất được");
                }
                loading.hideloading();
            };
            req.send();
        });

        function UpdateSetupMemberEarnItem() {
                //debugger
                var itemNo = $('#update-itemno').val();
                var itemName = $('#update-item-name').val();
                var uom = $('#hdd-update-uom').val();
                //var fromDate = $('#hdd-update-from-date').val();
                //var toDate = $('#hdd-update-to-date').val();
                var blocked = $('#update-sel-blocked').val();
                var saleQty = $('#update-sale-qty').val();
                var stampsQty = $('#update-stamps-qty').val();

                if (saleQty == 0 || saleQty == null) {
                    toastr.error("Nhập số lượng");
                    return;
                }
                if (stampsQty == 0 || stampsQty == null) {
                    toastr.error("Nhập tỷ lệ tích tem");
                    return;
                }

                var fromDate = getFromDate(); // yyyy-MM-dd
                var toDate = getToDate();     // yyyy-MM-dd
                loading.showloading();

                $.ajax({
                    url: '@Url.Action("UpdateSetupMemberEarnItem", "SetupLoyalty")',
                    type: "POST",
                    dataType: "json",
                    data: {
                        ItemNo: itemNo,
                        ItemName: itemName,
                        Uom: uom,
                        FromDateStr: fromDate,
                        ToDateStr: toDate,
                        Blocked: blocked,
                        SaleQty: saleQty,
                        StampsQty: stampsQty
                    },
                    success: function (data) {
                        //debugger
                        loading.hideloading();
                        if (data.Status == 1) {
                            toastr.success(data.Message);
                            $('#btn-search').trigger('click');
                            $('#modal-update-setup-member-earn-item').modal('hide');
                        }
                        else
                        {
                            toastr.error(data.Message);
                            $('#modal-update-setup-member-earn-item').modal('Show');
                        }
                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });
        }


