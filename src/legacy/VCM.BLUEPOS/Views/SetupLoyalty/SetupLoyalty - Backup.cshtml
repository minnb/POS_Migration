        if (_toDate == null || _toDate.length == 0) {
            toastr.error('Nhập hiệu lực đến ngày');
            return;
        }

        if (_memberCardType == null || _memberCardType == "") {
            toastr.error('Vui lòng chọn hội viên');
            return;
        }

        var dateNow = new Date();
        var year = dateNow.getFullYear();
        var month = dateNow.getMonth() + 1;
        var day = dateNow.getDate();
        var paramDate = day + '/' + month + '/' + year;
        var getTimeNow = parseDate(paramDate).getTime();
        var dateFrom = parseDate(_fromDate).getTime();
        var dateTo = parseDate(_toDate).getTime();

        if (dateTo < getTimeNow) {
            _status = 0; // Het hieu luc
        }

        if (_pointRedeem == null || _pointRedeem.length == 0) {
            toastr.error('Nhập điểm quy đổi');
            return;
        }

        loading.showloading();

        $.ajax({
            url: '@Url.Action("UpdateSetupLoyalty", "SetupLoyalty")',
            type: "POST",
            dataType: "json",
            data: {
                ID: _id,
                ItemNo: _itemNo,
                ItemName: _itemName,
                FromDateStr: _fromDate,
                ToDateStr: _toDate,
                ClubCode: _memberCardType,
                PointStr: _pointRedeem,
                Status: _status,
                Pkey: _pkey
            },
            success: function (data) {
                //debugger
                loading.hideloading();
                if (data.Status == 1) {
                    toastr.success(data.Message);
                    $('#txt-item-no').val(data.Item4);
                    $('#sel-by-search').val('');
                    $('#btn-search-setup-loyalty').trigger('click');
                    $('#modal-update-setup-loyalty').modal('hide');
                }
                else if (data.Status == 2)
                {
                    toastr.error(data.Message);
                    $('#modal-update-setup-loyalty').modal('Show');
                }
                else if (data.Status == 3)
                {
                    toastr.error(data.Message);
                    $('#modal-update-setup-loyalty').modal('Show');
                }
                else if (data.Status == 4)
                {
                    toastr.error(data.Message);
                    $('#modal-update-setup-loyalty').modal('Show');
