            $("#btn-export-excel").on("click", function (e) {
                //debugger
                var opt = $("#sel-by-search").val();
                if (opt == 2) {
                    var fromDate = getFromDate();
                    var toDate = getToDate();
                    if (fromDate > toDate) {
                        toastr.error('Hiệu lực từ ngày <= hiệu lực đến ngày.');
                        return;
                    }
                    $('#hdFromDate').val(fromDate);
                    $('#hdToDate').val(toDate);
                }
                else {
                    var fromDate = "2021/01/01";
                    var toDate = "2050/12/31";
                    $('#hdFromDate').val(fromDate);
                    $('#hdToDate').val(toDate);
                }

                $("#hd-sel-by-search").val(opt);
                var itemNo = $("#txt-item-no").val();
                $("#hd-item-no").val(itemNo);

                $('#frm-export-excel').submit();

