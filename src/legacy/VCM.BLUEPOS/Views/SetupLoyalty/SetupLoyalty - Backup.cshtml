@section Scripts
{
    <script type="text/javascript">
        var table_setup_loyalty = "";
        var table_item_import_list = "";
        $(".mask").inputmask('Regex', { regex: "^[0-9]{1,6}(\\.\\d{1,2})?$" });

        function getFromDate() {
            var result = "";
            var fromDate = $('#search-from-date').val();
            if (fromDate != null && fromDate != "") {
                result = fromDate.split('/')[2] + "/" + fromDate.split('/')[1] + "/" + fromDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function getToDate() {
            var result = "";
            var toDate = $('#search-to-date').val();
            if (toDate != null && toDate != "") {
                result = toDate.split('/')[2] + "/" + toDate.split('/')[1] + "/" + toDate.split('/')[0];
            }
            else {
                result = "";
            }
            return result;
        };

        function parseDate(str) {
            var mdy = str.split('/');
            return new Date(mdy[2], mdy[1], mdy[0]);
        };

        function ImportExcelGiftRedeem() {
            //debugger
            loading.showloading();
            var files = $('#browse-file-excel').get(0).files;
            var fileData = new FormData();
            fileData.append('ImportFile', files[0]);

            $.ajax({
                url: '/SetupLoyalty/ImportExcelGiftRedeem',
                data: fileData,
                type: 'POST',
                datatype: 'json',
                contentType: false,
                processData: false,
                async: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#selected-file').empty();
                        $('#sel-status').val('').trigger('change'); // Tat ca
                        $('#btn-search-setup-loyalty').trigger('click');
                        $('#modal-import-excel-file').modal('hide');
                    }
                    else
                    {
                        $('#browse-file-excel').val('');
                        $('#selected-file').empty();
                        toastr.error(data.Message);
                        $('#browse-file-excel').val('');
                    }
                }
            });
        };

        function ImportExcelGiftRedeem_V2() {
            //debugger
            loading.showloading();
            var files = $('#browse-file-excel').get(0).files;
            var fileData = new FormData();
            fileData.append('ImportFile', files[0]);

            $.ajax({
                url: '/SetupLoyalty/ImportExcelGiftRedeem_V2',
                data: fileData,
                type: 'POST',
                datatype: 'json',
                contentType: false,
                processData: false,
                async: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        $('#selected-file').empty();
                        $('#sel-status').val('').trigger('change'); // Tat ca
                        $('#btn-search-setup-loyalty').trigger('click');
                        $('#modal-import-excel-file').modal('hide');
                    }
                    else {
                        $('#browse-file-excel').val('');
                        $('#selected-file').empty();
