            $('#btn-search-setup-loyalty').on('click', function (e) {
                //debugger
                var opt = $("#sel-by-search").val();
                if (opt == 2)  // tim theo ngay/thang/nam
                {
                    var _fDate = $('#search-from-date').val();
                    var _tDate = $('#search-to-date').val();

                    if (_fDate == null || _fDate.length == 0) {
                        toastr.error('Nhập hiệu lực từ ngày.');
                        return;
                    }

                    if (_tDate == null || _tDate.length == 0) {
                        toastr.error('Nhập hiệu lực đến ngày.');
                        return;
                    }

                    var dateFrom = parseDate(_fDate).getTime();
                    var dateTo = parseDate(_tDate).getTime();

                    if (dateFrom > dateTo) {
                        toastr.error('Hiệu lực từ ngày phải nhỏ hơn hoặc bằng hiệu lực đến ngày.');
                        return;
                    }
                }

                table_setup_loyalty.draw();

