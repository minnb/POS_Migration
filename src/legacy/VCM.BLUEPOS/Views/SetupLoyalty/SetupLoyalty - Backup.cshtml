                            var month = dateNow.getMonth() + 1;
                            var day = dateNow.getDate();
                            var paramDate = day + '/' + month + '/' + year;
                            var getTimeNow = parseDate(paramDate).getTime();
                            var dateTo = parseDate(_toDate).getTime();
                            var dateFrom = parseDate(_fromDate).getTime();
                            var html = "";
                            if (dateTo < getTimeNow || dateTo < dateFrom) {
                                html += '<span style=\"color:#CD3D12;font-weight:400;display:block;text-align:center;\">' + row.ToDateStr + '</span>';
                            }
                            else {
                                html += '<span style=\"color:#058EC2;font-weight:400;display:block;text-align:center;\">' + row.ToDateStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CreatedUser",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CreatedUser == null || row.CreatedUser == "") {
                                html += '<span style="font-weight:400;display:block;text-align:center;">' + "" + '</span>';
                            } else {
