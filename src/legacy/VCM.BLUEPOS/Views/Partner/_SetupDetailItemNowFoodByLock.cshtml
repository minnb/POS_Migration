@using VCM.BLUEPOS.Model.Partner;
@using Newtonsoft.Json;
@using System.Web.Configuration;

@{
    var model = Model as API_ItemLockNowFoodResponseModel;
    var listItem = model.data;

    string  restaurant_id = "";
    string partner_restaurant_id = "";
    string partner_dish_id = "";
    bool? is_apply_all = false;
    int status = 0;

    if (model != null)
    {
        restaurant_id = listItem.restaurant_id.ToString();
        partner_restaurant_id = listItem.partner_restaurant_id;
        is_apply_all = listItem.is_apply_all;
        partner_dish_id = listItem.dishes.partner_dish_id;
        status = listItem.dishes.status;
    }
}

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="row">

                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Mã sản phẩm (SAP)<strong style="color:#ff0000">(*)</strong></label>
                        <div class="input-group">
                            <input type="text" id="txt-item-no" class="form-control" value="@partner_dish_id" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">ST/CH</label>
                        <div class="input-group">
                            <input type="text" id="txt-store-no" class="form-control" value="@partner_restaurant_id" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                        <div class="form-group">
                            <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                <option value="1" selected>Có hiệu lực</option>
                                <option value="0">Hết hiệu lực</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="text-align:right">
                        @{
                            var urlImg = "/Uploads/imgs/placeholder.png";
                            var isChangeImg = "";

                            //if (!string.IsNullOrEmpty(imgItem))
                            //{
                            //    //urlImg = "data:image/jpeg;base64," + imgBase64;
                            //    urlImg = "data:image/jpeg;base64";
                            //    isChangeImg = "image-input-changed";
                            //}

                        }
                    <div class="image-input image-input-outline @isChangeImg" id="kt_img_item">
                        <div class="image-input-wrapper" style="background-image: url(@urlImg)"></div>

                        <label class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-toggle="tooltip" title="" data-original-title="Change avatar">
                            <i class="fa fa-pen icon-sm text-muted"></i>
                            <input type="file" id="imgItem" name="imgItem" accept=".png, .jpg, .jpeg" />
                            <input type="hidden" name="imgItem_remove" />
                        </label>

                        <span id="btnCancleImg" class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="cancel" data-toggle="tooltip" title="Cancel avatar">
                            <i class="ki ki-bold-close icon-xs text-muted"></i>
                        </span>
                    </div>
                </div>


                @*<div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="input-group" style="margin-top:27px;">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <label class="checkbox checkbox-inline" title="Trạng thái">
                            <input type="checkbox" @Blocked id="chkBlocked" class="chkBlocked" disabled />
                            <span></span>
                        </label>
                    </span>
                </div>
                <div class="input-group-append"><span class="input-group-text">Blocked</span></div>
            </div>
        </div>*@

            </div>
        </div>

       


    </div>
</div>



<script type="text/javascript">
    $(document).ready(function () {
        $(".select2").select2();
        var kt_img_item = new KTImageInput('kt_img_item');
        $("#btnCancleImg").on("click", function (e) {
            $(".image-input-wrapper").css("background-image", 'url("/Uploads/imgs/placeholder.png"');
        });
    });
</script>


