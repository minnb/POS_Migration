@{
    ViewBag.Title = "Khai báo sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStoreHead = ViewBag.ListStoreHead as List<Shopee_Restaurant_Model>;
    var listNganhHang = (List<VCM.BLUEPOS.Model.Partner.OptionModel>)ViewBag.ListCategory;
    var listPicture = ViewBag.ListPicture as List<PictureResponseModel>;
    var model = Model as CreateViewItemListNowFoodModel;
    var listItem = model.ListItem;

    var totalPage = Model.TotalPageNumber;
    string pageCurrent_ItemNowFood = HttpContext.Current.Request.RequestContext.RouteData.Values["page"] == null ? "1" : HttpContext.Current.Request.RequestContext.RouteData.Values["page"].ToString();
    int pageCR = int.Parse(pageCurrent_ItemNowFood);

    var totalRow = Model.TotalRow;
    var pageSize = Model.PageSize;
    var displayRow = $"{pageCR}-{pageSize}/{totalRow} sản phẩm";

    if (totalRow <= pageSize)
    {
        displayRow = $"{totalRow} sản phẩm";
    }

    if (pageCR > 1 && totalRow > pageSize)
    {
        displayRow = $"{(pageCR * pageSize + 1) - pageSize}-{(pageCR * pageSize > totalRow ? totalRow : pageCR * pageSize)} /{totalRow} sản phẩm";
    }

    var textsearch = Html.Raw(model.Keyword);
    string urlImg = WebConfigurationManager.AppSettings["urlImg"];
    string urlImg_Create = WebConfigurationManager.AppSettings["urlImg"];
    var imgBase64 = ViewBag.ImagesBase64;
    var modelListAPI = Model as APIListItemNowFoodResponseModel;
    var listItemAPI = modelListAPI;

}


