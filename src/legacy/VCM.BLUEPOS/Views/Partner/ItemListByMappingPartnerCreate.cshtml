    function LoadItemListByNowFood(storeNo, itemNo, textSearch) {
            //debugger
            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('ItemNo', itemNo);
            fromData.append('TextSearch', textSearch);
            $.ajax({
                url: '@Url.Action("APIItemListNowFoodByStore", "Partner")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,         
                success: function (response)
                {
                    //debugger
                    loading.hideloading();
                    var html = '';
                    if (response.length != null) {
                        for (var i = 0; i < response.length; i++) {
                            html += '<div class="col-xl-3 col-lg-4 col-md-6 col-sm-12" style="margin-bottom:-20px">';
                            html += '<div class="card card-custom gutter-b card-stretch" style="border:1px solid #d5d2d2">';
                            html += '<div class="card-body">';
                            html += '<div style="cursor:pointer" class="d-flex align-items-center btnDetail" data-itemno="' + response[i].dish_id + '">';

                            html += '<div class="flex-shrink-0 mr-4 mt-lg-0">';
                            html += '<div class="symbol symbol-lg-75">';
                            if (response[i].picture == null) {
                                var ulrUploadImage = "~/Uploads/imgs/placeholder.png";
                                html += '<img src="' + ulrUploadImage +'" />';
                            }
                            else {
                                var imagesBase64 = response[i].picture.url;
                                html += '<img src="' + imagesBase64 + '" />';
                            }
                            html += '</div>';
                            html += '</div>';

                            html += '<div class="d-flex flex-column" style="font-family:Roboto ,Unicode Support Noto, sans-serif">';
                            html += '<a class="text-dark font-weight-bold text-hover-primary mb-0">' + response[i].name + '</a>';
                            html += '<span class="text-muted font-weight-bold">No: ' + response[i].dish_id + '</span>';
                            html += '<span class="text-muted font-weight-bold">Sap: ' + response[i].partner_dish_id + '</span>';
                            html += '<span class="text-muted font-weight-bold">Giá: ' + response[i].price + ' </span>';
                            if (response[i].is_active == false) {
                                var isActiveStr = "Deactive";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' + response[i].partner_dish_id + '" style=\"color:#ff0000;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }
                            else if (response[i].is_active == true) {
                                var isActiveStr = "Active";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' + response[i].partner_dish_id + '" style=\"color:#06b65c;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }
                            html += '</div>';

                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                        }
                    }
                    else
                    {
                        html += '<div class="alert-cutom alert-warning" style="font-weight: 400; text-align: center;">';
                        html += '<span>Không có dữ liệu</span>';
                        html += '</div>';
                    }
                    $('#div-view-item-list-now-food').html(html);                    
                },
                error: function (event)
                {
                    loading.hideloading();
                }
            });
        }

