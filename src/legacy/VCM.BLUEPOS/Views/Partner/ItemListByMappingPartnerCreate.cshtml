@section Scripts
{
    <script type="text/javascript">

        var keyword = $("#hdd-txt-key-word").val();

        // Load combox danh sách CH ( tab: Danh sách sản phẩm)

        function LoadComboxStore() { 
            var partner = "GRF";
            if (partner == "GRF") { 
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxStoreByGrabFood", "Partner")',
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        //debugger
                        var html = "";
                        if (data.length > 0) {
                            data.forEach((item, i) => {
                                html += "<option value='" + item.StoreNo + "'>" + item.StoreNo + "-" + item.StoreName + "</option>"
                            });
                        }
                        $('#sel-store-no').html(html);
                    },
                    error: function () {
                        toastr.error('Lỗi hệ thống');
                    }
                });
            }
        }

        function CreateItemByMappingPartner() {
            //debugger
            var partner = $("#sel-create-partner").val();
            var itemNo = $("#modal-create-item-no").val();
            var itemName = $("#modal-create-item-name").val();
            var description = $("#modal-create-description").val();
            var groupId = $("#modal-create-item-group-id").val();
            var storeNo = $("#modal-create-store-no").val();
            var unitPrice = $("#modal-create-unit-price").val();
            var picture = $("#modal-create-picture").val();

            if (partner == null || partner == "") {
                toastr.error('Vui lòng chọn đối tác');
                return;
            }

            if (itemName == null || itemName == "") {
                toastr.error('Nhập tên sản phẩm');
                return;
            }

            if (storeNo == null || storeNo == "") {
                toastr.error('Chọn cửa hàng');
                return;
            }

            if (groupId == null || groupId == "") {
                toastr.error('Chọn ngành hàng');
                return;
            }

            if (unitPrice == null || unitPrice == "") {
                toastr.error('Nhập giá bán sản phẩm');
                return;
            }

            // check giá
            if (unitPrice < 0) {
                toastr.error("Giá bán phải là kiểu số dương (>0). Vui lòng kiểm tra lại");
                return;
            }

            var check = $.isNumeric(unitPrice);
            if (check == false) {
                toastr.error("Giá bán phải là kiểu số (>0). Vui lòng kiểm tra lại");
                return;
            }

            if (picture == null || picture == "") {
                toastr.error('Chọn hình ảnh sản phẩm');
                return;
            }

            var picture_id = picture.split('-')[0];
            var picture_url = picture.split('/')[7];
            var merchant_item_image = picture.split('-')[1];

            var partner_restaurant_id = storeNo.split('-')[0];
            if (partner == "BEF")  // Befood
            {
                var restaurant_id = storeNo;
            }
            else {
                var restaurant_id = storeNo.split('-')[1];
            }

            var fromData = new FormData();
            fromData.append('partner_id', partner);
            fromData.append('restaurant_id', restaurant_id);
            fromData.append('partner_restaurant_id', partner_restaurant_id);
            fromData.append('partner_dish_group_id', groupId);
            fromData.append('partner_dish_id', itemNo);
            fromData.append('name', itemName);
            fromData.append('description', description);
            fromData.append('price', unitPrice);
            fromData.append('picture_id', picture_id);
            fromData.append('picture_url', picture_url);
            fromData.append('merchant_item_image', merchant_item_image);            
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateItemByMappingPartner", "Partner")',
                type: "POST",
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status != 200) {
                        toastr.error(data.Message);
                        $('#modal-create-item-now-food').modal("hide");
                    }
                    else {
                        if (data.Data.meta.code == 201)
                        {
                            toastr.error('Sản phẩm này đã tồn tại trên kênh đối tác. Vui lòng chọn sản phẩm khác');
                            $('#modal-create-item-now-food').modal("hide");
                        }
                        else if (data.Data.meta.code == 200)
                        {
                            toastr.success("Khai báo sản phẩm thành công");
                            $("#txt-text-search").val('');
                            $("#btn-header-search").trigger('click');
                            $('#modal-create-item-now-food').modal("hide");
                        }
                        else
                        {
                            toastr.success(data.Data.meta.message);
                            $('#modal-create-item-now-food').modal("hide");
                        }
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxStorebyPartner() {
            //debugger
            var partner = $('#sel-create-partner').val();
            
            if (partner == null || partner == "") {
                var html = "<option value=\"\" selected>--- Chọn ---</option>";
                $('#modal-create-store-no').html(html);
            }
            else
            {
                var fromData = new FormData();
                fromData.append('partner', partner);            
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadComboxStoreByPartner", "Partner")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        //debugger
                        if (data.length > 0) {
                            if (partner == "NOF") {
                                data.forEach((item, i) => {
                                    html += "<option value='" + item.partner_restaurant_id + "-" + item.restaurant_id + "'>" + item.partner_restaurant_id + "-" + item.name + "</option>"
                                });
                            }
                            else if (partner == "GRF") {
                                data.forEach((item, i) => {
                                    html += "<option value='" + item.restaurant_id + "'>" + item.partner_restaurant_id + "-" + item.restaurant_name + "</option>"
                                });
                            }
                            else if (partner == "BEF") {
                                data.forEach((item, i) => {
                                    html += "<option value='" + item.restaurant_id + "'>" + item.partner_restaurant_id + "-" + item.restaurant_name + "</option>"
                                });
                            } 
                        }
                        $('#modal-create-store-no').html(html);
                    },
                    error: function () {
                        toastr.error('Lỗi hệ thống');
                    }
                });
            }
        }

