                    return;
                }
                else {
                    var storeNo1 = storeNoStr.split('-')[0];
                    storeNo = storeNo1.trim();
                }
                GetItemShopeeFoodByUpdate(storeNo, itemNo, textSearch);
            }
            else if (partnerCode == "GRF") {
                GetItemGrabFoodByUpdate(storeGrab, categoryCode, itemNo, status, textSearch);
            }
            else if (partnerCode == "BEF") {
