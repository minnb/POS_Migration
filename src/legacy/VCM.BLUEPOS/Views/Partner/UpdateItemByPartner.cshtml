            //debugger
            var partnerCode = $("#sel-update-partner").val();
            var categoryCode = $("#sel-update-category").val();
            var storeNoStr = $("#sel-store-no").val();
            var storeNo = "";
            var itemNo = $("#txt-text-search").val();
            var textSearch = $("#txt-text-search").val();
            var storeGrab = $("#sel-store-no-grab-food").val();
            var status = $("#sel-status-item-grab-food").val();

            var storeBe = $("#sel-store-no-befood").val();
            var statusBe = $("#sel-status-item-befood").val();

            if (partnerCode == "NOF") {
                if (storeNoStr == null || storeNoStr == "") {
