        function ViewDetailByUpdate(partner_dish_id, partner_dish_group_id, pirce, is_active, picture_id) {
            //debugger
            var storeNo = $("#sel-store-no").val();
            if (storeNo == null) {
                return;
            }
            var partner_restaurant_id = storeNo.split('-')[0];
            var restaurant_id = storeNo.split('-')[1];
            $('#update-restaurant-id').val(restaurant_id);
            $('#update-partner-restaurant-id').val(partner_restaurant_id);

            $('#txt-update-partner-dish-id-temp').val(partner_dish_id);
            $('#txt-update-item-no-sap').val(partner_dish_id);

            $('#txt-update-picture-id-temp').val(picture_id);
            $('#txt-update-price').val(pirce);

            var partner_dish_id_temp_v1 = $('#txt-update-partner-dish-id-temp-v1').val();
            var priceTemp = $('#txt-update-price-temp').val();
            if (priceTemp == "") {
                $('#txt-update-price').val(pirce);
            }
            else {
                if (pirce != priceTemp) {
                    if (partner_dish_id_temp_v1 == partner_dish_id) {
                        $('#txt-update-price').val(priceTemp);
                    }
                    else {
                        $('#txt-update-price').val(pirce);
                    }
                }
                else {
                    $('#txt-update-price').val(pirce);
                }
            }

            var status = 1;
            if (is_active == true) {
                status = 1; // Active
            }
            else {
                status = 3; // Deactive
            }

            var _partner_dish_group_id = "";
            if (partner_dish_group_id == "1") {
                _partner_dish_group_id = 1;
            }
            else if (partner_dish_group_id == "214") {
                _partner_dish_group_id = 214;
            }
            else if (partner_dish_group_id == "216") {
                _partner_dish_group_id = 216;
            }
            else if (partner_dish_group_id == "" || partner_dish_group_id == null || partner_dish_group_id == "-1") {
                _partner_dish_group_id = "";
            }
            LoadDetailItemNowFoodByUpdate(restaurant_id, partner_restaurant_id, partner_dish_id, _partner_dish_group_id, status, picture_id);
        };

