        function collectOptionGroup() {
            //debugger
            var option = {};
            option.ChonSIze = $('#CHON_SIZE').prop('checked');
            if (option.ChonSIze == false) {
                option.Size5k = false;
                option.Size10k = false
            }
            else {
                option.Size5k = $('#CHON_SIZE_5K').prop('checked');
                option.Size10k = $('#CHON_SIZE_10K').prop('checked');
            }

            option.DoNgot = $('#OPTION_NGOT').prop('checked');
            option.Vitra = $('#OPTION_TRA').prop('checked');
            option.ThemTopping = $('#TOPPING').prop('checked');
            return option;
        }

        // Khi click button Lưu : Cập nhật sản phẩm Grabfood

        function UpdateItemByGrabFood() {
            //debugger
            var id = $('#txt-update-item-no-by-grab-food').val();
            var name = $("#txt-update-item-name-by-grab-food").val();
            var description = $("#txt-update-description-by-grab-food").val(); // thông tin ghi chú
            var status = $("#txt-update-status-by-grab-food").val();

            var idcategory = $("#txt-update-name-category-by-grab-food").val();
            var namecategory = $("#txt-update-name-category-by-grab-food").val();

            if (idcategory == -1 || idcategory == "") {
                toastr.error("Vui lòng chọn ngành hàng");
                return;
            }

            var fileName = $('#txt-file-img-upload-grab-food').val();
            if (fileName != "") {
                var extension = fileName.split('.').pop().toLowerCase();
                if ($.inArray(extension, ['png', 'gif', 'jpeg', 'jpg']) == -1) {
                    toastr.error("Tên file ảnh không hợp lệ !");
                    return;
                }
            }

            if (name == null || name == "") {
                toastr.error("Vui lòng nhập tên sản phẩm");
                return;
            }
            else
            {
                if (name.length > 50) {
                    toastr.error("Tên sản phẩm có chiều dài tối đa 50 ký tự. Vui lòng kiểm tra lại");
                    return;
                }
            }

            if (status == null || status == "") {
                toastr.error("Vui lòng chọn trạng thái");
                return;
            }

            if (description.length > 250) {
                toastr.error("Thông tin ghi chú có chiều dài tối đa 250 ký tự. Vui lòng kiểm tra lại");
                return;
            }

            var listOptionGroup = "";
            if (isCampaign == true) {
                listOptionGroup = "";
            }
            listOptionGroup = collectOptionGroup();
            loading.showloading();
            var data = {
                'Id': id,
                'Name': name,
                'Description': description,
                'CategoryId': idcategory,
                'AvailableStatus': status,
                'Photo': fileName,
                'ListOptionGroup': listOptionGroup
            }

            $.ajax({
                url: '@Url.Action("Update_Item_Async_By_Grabfood", "Partner")',
                type: "POST",
                data: data,
                success: function (data) {
                    loading.hideloading();
                    if (data.Status == 200) {
                        toastr.success("Cập nhật thành công");
                        $("#btn-search-item-list").trigger('click');
                        $('#modal-update-view-item-grab-food').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

