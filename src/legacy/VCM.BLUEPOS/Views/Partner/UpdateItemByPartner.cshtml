        function GetItemNameGrabFood(categoryCode, itemNo, textSearch) {
            //debugger
            $('#img-update-images-by-grab-food').val('');
            loading.showloading();
            var fromData = new FormData();
            fromData.append('Category', categoryCode);
            fromData.append('ItemNo', itemNo);
            fromData.append('TextSearch', textSearch);

            $.ajax({
                url: '@Url.Action("GetItemGrabFoodByUpdate", "Partner")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.length != null) {
                        for (var i = 0; i < data.length; i++) {
                            //debugger
                            var response = data[i].Items;
                            for (var y = 0; y < response.length; y++) {
                                if (itemNo == response[y].Id) {
                                    $('#txt-update-item-name-by-grab-food').val(response[y].Name);
                                    $('#img-update-images-by-grab-food').val(response[y].Photos);
                                    return;
                                }
                            }
                        }
                    }
                }
            });
        }

