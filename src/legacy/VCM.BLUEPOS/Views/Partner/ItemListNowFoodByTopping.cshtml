@section Scripts
{
<script type="text/javascript">

        var keyword = $("#hdd-txt-key-word").val();

        function CreateItemNowFood() {
            //debugger
            var itemNo = $("#modal-create-item-no").val();
            var itemName = $("#modal-create-item-name").val();
            var description = $("#modal-create-description").val();
            var groupId = $("#modal-create-item-group-id").val();
            var storeNo = $("#modal-create-store-no").val();
            var unitPrice = $("#modal-create-unit-price").val();
            var picture = $("#modal-create-picture").val();

            if (itemName == null || itemName == "") {
                toastr.error('Nhập tên sản phẩm');
                return;
            }
            if (groupId == null || groupId == "") {
                toastr.error('Chọn nhóm loại sản phẩm');
                return;
            }
            if (storeNo == null || storeNo == "") {
                toastr.error('Chọn ST/CH');
                return;
            }
            if (unitPrice == null || unitPrice == "") {
                toastr.error('Nhập giá bán sản phẩm');
                return;
            }
            if (picture == null || picture == "") {
                toastr.error('Chọn hình ảnh sản phẩm');
                return;
            }

            var picture_id = picture.split('-')[0];
            var picture_url = picture.split('/')[7];
            var partner_restaurant_id = storeNo.split('-')[0];
            var restaurant_id = storeNo.split('-')[1];

            loading.showloading();

            var fromData = new FormData();
            fromData.append('restaurant_id', restaurant_id);
            fromData.append('partner_restaurant_id', partner_restaurant_id);
            fromData.append('partner_dish_group_id', groupId);
            fromData.append('partner_dish_id', itemNo);
            fromData.append('name', itemName);
            fromData.append('description', description);
            fromData.append('price', unitPrice);
            fromData.append('picture_id', picture_id);
            fromData.append('picture_url', picture_url);

            $.ajax({
                url: '@Url.Action("CreateItemNowFood", "NowFood")',
                type: "POST",
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
