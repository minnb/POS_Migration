        function GetDataRowItem() {
             //debugger
            var data = [];
            var appCode = $('#sel-app-code').val();
            $('.div-infor-item div').each(function () {
                //debugger
                var item = {};
                    var checkItemNo = $(this).parents('div').find('*.chk-item-no').prop('checked');
                    var itemNo = $(this).parents('div').find('*.div-item-no').find('span:nth-child(1)').html();
                    var itemName = $(this).parents('div').find('*.div-item-name').find('span:nth-child(1)').html();
                    var barCode = $(this).parents('div').find('*.div-barcode').find('span:nth-child(1)').html();
                    var uom = $(this).parents('div').find('*.div-uom').find('span:nth-child(1)').html();
                    var cateCode = $(this).parents('div').find('*.div-category').find('span:nth-child(1)').html();
                    var cateName = $(this).parents('div').find('*.div-category').find('span:nth-child(3)').html();
                    //var img = $(this).parents('div').find('*.div-image').html();

                    item['ItemNo'] = itemNo;
                    item['ItemName'] = itemName;
                    item['UnitOfMeasure'] = uom;
                    item['Barcode'] = barCode;
                    item['CategoryCode'] = cateCode;
                    item['CategoryName'] = cateName;
                    item['AppCode'] = appCode;
                    item['CheckItem'] = checkItemNo;
                    //item['Images'] = img;
                    data.push(item);

            });

            return data;
         };

        function SaveItemListForPartner() {
            //debugger
            var itemInfor = GetDataRowItem();
            if (itemInfor == null || itemInfor.length == 0) {
                toastr.error('Không có thông tin để lưu. Vui lòng kiểm tra lại');
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SaveItemListForPartner", "SetupItem")',
                type: "POST",
                dataType: "json",
                data: {
                    //StoreNo: _storeNo,
                    ListItemPartnerStr: JSON.stringify(itemInfor)
                },
                success: function (response) {
                    if (response.Status == 200) {
                        toastr.success(response.Message);
                        location.reload();
                    }
                    else {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function GetInfoItem(itemNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                //url: "/SetupItem/_SetupItemPartnerDetail?ItemNo=" + itemNo + "",
                url: "/NowFood/_SetupDetailItemNowFood?ItemNo=" + itemNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadItem").css("display", "none");
                    $("#updateItem").html(result);
                    $("#updateItem").css("display", "block");
                    loading.hideloading();
                },
                error: function (event) {
                }
            });
        }

    function LoadItemListByNowFood(storeNo) {
            //debugger
            loading.showloading();
            $.ajax({
                type: "POST",
                url: "/NowFood/APIItemListNowFoodByStore?StoreNo=" + storeNo + "",
                dataType: 'json',
                //dataType: 'html',
                cache: false,
                contentType: false,
                processData: false,
                success: function (response)
                {
                    //debugger
                    //var listData = JSON.stringify(data.data);
                    //var listItem = JSON.parse(listData);
                    var html = '';
                    if (response.data.length != null) {                        
                        for (var i = 0; i < response.data.length; i++) {
                            var imagesBase64 = response.data[i].picture.url;
                            html += '<div class="col-xl-3 col-lg-4 col-md-6 col-sm-12" style="margin-bottom:-20px">';
                            html += '<div class="card card-custom gutter-b card-stretch" style="border:1px solid #d5d2d2">';
                            html += '<div class="card-body">';
                            html += '<div style="cursor:pointer" class="d-flex align-items-center btnDetail" data-itemno="' + response.data[i].dish_id + '">';

                            html += '<div class="flex-shrink-0 mr-4 mt-lg-0">';
                            html += '<div class="symbol symbol-lg-75">';
                            if (response.data[i].picture.url == null) {
                                var ulrUploadImage = "~/Uploads/imgs/placeholder.png";
                                html += '<img src="' + ulrUploadImage +'" />';
                            }
                            else {
                                html += '<img src="' + imagesBase64 + '" />';
                            }
                            html += '</div>';
                            html += '</div>';

                            html += '<div class="d-flex flex-column" style="font-family:Roboto ,Unicode Support Noto, sans-serif">';
                            html += '<a class="text-dark font-weight-bold text-hover-primary mb-0">' + response.data[i].name + '</a>';
                            html += '<span class="text-muted font-weight-bold">No: ' + response.data[i].dish_id + '</span>';
                            html += '<span class="text-muted font-weight-bold">Sap: ' + response.data[i].partner_dish_id + '</span>';
                            html += '<span class="text-muted font-weight-bold">Giá: ' + response.data[i].price + ' </span>';
                            html += '</div>';

                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                        }
                    }
                    else
                    {
                        html += '<div class="alert-cutom alert-warning" style="font-weight: 400; text-align: center;">';
                        html += '<span>Không có dữ liệu</span>';
                        html += '</div>';
                    }
                    $('#div-view-item-list-now-food').append(html);
                    loading.hideloading();
                },
                error: function (event)
                {
                    loading.hideloading();
                }
            });
        }


