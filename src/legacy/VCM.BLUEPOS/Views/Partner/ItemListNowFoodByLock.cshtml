            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var keyword = $("#hdd-txt-key-word").val(); 
        
        function CreateItemNoByLock() {
            //debugger
            var restaurant_id = $('#restaurant-id').val();
            var partner_restaurant_id = $("#txt-store-no-header").val();
            var partner_dish_id = $("#txt-item-no-sap").val();
            var isActive = $("#sel-status-lock").val();

            if (isActive == "" || isActive == null) {
                toastr.error('Vui lòng chọn trạng thái');
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('restaurant_id', restaurant_id);
            fromData.append('partner_restaurant_id', partner_restaurant_id);
            fromData.append('partner_dish_id', partner_dish_id);
            fromData.append('isActive', isActive);           
            $.ajax({
                url: '@Url.Action("_SetupDetailItemNowFoodByLock", "Partner")',
                type: "POST",
                data: fromData, 
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Data.meta.code == 200) {
                        toastr.success("Cập nhật thành công");

                        $("#txt-text-search").val('');
                        $("#btn-search-item-list").trigger('click');

                        $('#modal-view-detail-item-now-food').modal("hide");
                        var status = isActive == 3 ? '<span style=\"color:red;\">Deactive</span>':'<span style=\"color:green;\">Active</span>';
                        $("#lbStatus" + partner_dish_id).html(status);

                        $('#txt-partner-dish-id-temp-v1').val(partner_dish_id);    // Cai biên nay dung de dk so sanh hien thi cho input gia ban
                        $('#txt-partner-dish-id-temp-v2').val(partner_dish_id);    // Dung de uncheckbox khi chon sang item khac
                    }
                    else
                    {
                        toastr.error(data.Message);
                        $('#modal-view-detail-item-now-food').modal("hide");
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }
      
    function LoadItemListNowFoodByLock(storeNo, itemNo, textSearch) {
        //debugger
        loading.showloading();
        var fromData = new FormData();
        fromData.append('StoreNo', storeNo);
        fromData.append('ItemNo', itemNo);
        fromData.append('TextSearch', textSearch);

        $.ajax({ 
                url: '@Url.Action("ApiItemListNowFoodByLock", "Partner")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,                              
                success: function (response)
                {
                    //debugger
                    var html = '';
                    if (response.length != null) {
                        for (var i = 0; i < response.length; i++) {
                           
                            html += '<div class=\"col-xl-3 col-lg-4 col-md-6 col-sm-12\">';
                            html += '<div class=\"card card-custom gutter-b card-stretch\" style=\"border:1px solid #d5d2d2\">';
                            html += '<div class=\"card-body\">';
                            html += '<div>';

                            //html += '<input type=\"checkbox\" class=\"chk-item-no-lock\" id=\"chk-item-no-lock-' + response.data[i].partner_dish_id + '\" style=\"width: 20px; height:20px;\" data-item-no-lock="' + response.data[i].dish_id + '"  data-item-no-sap-lock="' + response.data[i].partner_dish_id + '"  isActie="' + response.data[i].is_active + '" onclick=\"ViewDetailCheckBox(' + response.data[i].partner_dish_id + ',' + response.data[i].is_active +')\"   />';

                            html += '<div style=\"cursor:pointer\" class=\"d-flex align-items-center btn-view-detail-item\" data-item-no="' + response[i].dish_id + '"  data-item-no-sap="' + response[i].partner_dish_id + '"  data-item-name="' + response[i].name + '"  onclick=\"ViewDetail(' + response[i].partner_dish_id + ',' + response[i].is_active + ')\" >';
                            html += '<div class=\"flex-shrink-0 mr-4 mt-lg-0\">';
                            html += '<div class=\"symbol symbol-lg-75\" style=\"padding-left: 10px;\">';

                            if (response[i].picture == null) {
                                var ulrUploadImage = "~/Uploads/imgs/placeholder.png";
                                html += '<img src="' + ulrUploadImage +'" />';
                            }
                            else {
                                var imagesBase64 = response[i].picture.url;
                                html += '<img src="' + imagesBase64 + '" />';
                            }
                            html += '</div>';
                            html += '</div>';

                            html += '<div class=\"d-flex flex-column\" style=\"font-family:Roboto ,Unicode Support Noto, sans-serif\">';
                            html += '<a class=\"text-dark font-weight-bold text-hover-primary mb-0\">' + response[i].name + '</a>';
                            html += '<span class=\"text-muted font-weight-bold\">No: ' + response[i].dish_id + '</span>';
                            html += '<span class=\"text-muted font-weight-bold\">Sap: ' + response[i].partner_dish_id + '</span>';
                            html += '<span class=\"text-muted font-weight-bold\">Giá: ' + response[i].price + ' </span>';
                            if (response[i].is_active == false) {
                                var isActiveStr = "Deactive";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' +response[i].partner_dish_id+ '" style=\"color:#ff0000;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }
                            else if (response[i].is_active == true) {
                                var isActiveStr = "Active";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' +response[i].partner_dish_id+ '" style=\"color:#06b65c;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }
                            html += '</div>';

                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                        }
                    }
                    else
                    {
                        html += '<div class="alert-cutom alert-warning" style="font-weight: 400; text-align: center;">';
                        html += '<span>Không có dữ liệu</span>';
                        html += '</div>';
                    }

                    $('#div-view-item-list-now-food-lock').html(html);
                    loading.hideloading();
                },
                error: function (event)
                {
                    loading.hideloading();
                }
            });
        }

    function LoadDetailItemNowFood(restaurant_id, partner_restaurant_id, partner_dish_id, status) {
        //debugger
        $('#txt-store-no-header').val(partner_restaurant_id);
        var storeName = $("#sel-store-no").select2().find(":selected").data("storename");
        $('#txt-store-no-header-name').val(storeName);
        $('#txt-item-no-sap').val(partner_dish_id);
        $('#sel-status-lock').val('').trigger('change');        
        GetItemName(partner_dish_id, partner_restaurant_id);
        $('#modal-view-detail-item-now-food').modal({
            backdrop: 'static',
            keyboard: false
        });
    }

    function GetItemName(partner_dish_id, partner_restaurant_id) {
        $.ajax({
            url: '@Url.Action("GetItemNameByNowFood", "Partner")',
            type: "POST",
            dataType: "json",
            data: {
                partner_dish_id: partner_dish_id,
                partner_restaurant_id: partner_restaurant_id
            },
            success: function (data) {
                //debugger
                $('#txt-item-name').val(data);  
            },
            error: function (data) {
                toastr.error('Lỗi hệ thống');
            }
        });
    }

    function ViewDetail(partner_dish_id, is_active) {
        //debugger
        $('#txt-partner-dish-id-temp').val(partner_dish_id);
        $('#txt-partner-dish-id-temp-v1').val(partner_dish_id);
        $('#txt-partner-dish-id-temp-v2').val(partner_dish_id);

        var storeNo = $("#sel-store-no").val();
