                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Đối tác</label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-create-partner" name="Partner">
                                                    <option value="NOF" selected>NowFood</option>
                                                    <option value="GRABFOOD" disabled>GrabFood</option>
                                                    @*<option value="BEF">BeFood</option>*@
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng</label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
