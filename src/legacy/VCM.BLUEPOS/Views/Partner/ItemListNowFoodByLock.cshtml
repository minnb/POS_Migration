            return;
        }

        var partner_restaurant_id = storeNo.split('-')[0];
        var restaurant_id = storeNo.split('-')[1];
        $('#restaurant-id').val(restaurant_id);
        $('#partner-restaurant-id').val(partner_restaurant_id);
        LoadDetailItemNowFood(restaurant_id, partner_restaurant_id, partner_dish_id, is_active);

    };
       
