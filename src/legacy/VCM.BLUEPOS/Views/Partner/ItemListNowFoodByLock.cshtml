                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch" style="border:1px solid #0c713d;width:100%">
                            @using (Html.BeginForm("ApiItemListNowFoodByLock", "Partner", FormMethod.Post, new { @id = "frm-item-list-now-food-lock" }))
