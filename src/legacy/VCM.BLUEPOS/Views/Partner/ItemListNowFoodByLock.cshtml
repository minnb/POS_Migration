</div>

<!-- Modal: View chi tiết sản phẩm để khóa món -->

<div class="modal fade" id="modal-view-detail-item-now-food" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
