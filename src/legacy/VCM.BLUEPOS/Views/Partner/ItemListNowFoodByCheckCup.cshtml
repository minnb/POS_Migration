@using Newtonsoft.Json;
@using System.Web.Configuration;
@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Partner;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.MCH;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Kiểm tra khai báo loại ly";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listCupType = ViewBag.ListCupType as List<OptionDataModel>;
}


<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đối tác</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Kiểm tra loại ly</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelGetCupTypeByItem", "Partner", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Đối tác <strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-create-partner" name="Partner" disabled>
                                            <option value="">--- Chọn ---</option>
                                            <option value="NOF" selected>NowFood</option>
                                            <option value="BEF">BeFood</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo">@listStore.FirstOrDefault().DisplayComboSite</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.SiteNo">@item.DisplayComboSite</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Loại ly</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-cup-type" name="CupType">
                                            @if (listCupType != null && listCupType.Count > 0)
                                            {
                                                if (listCupType.Count == 1)
                                                {
                                                    <option value="@listCupType.FirstOrDefault().Code">@listCupType.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listCupType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
                                            <option value="">Tất cả</option>
                                            <option value="0" selected>Có hiệu lực</option>
                                            <option value="1">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="text-search" name="TextSearch" placeholder="mã sản phẩm ; tên sản phẩm">
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>

                            </div>
                        </div>
                    </div>
                </div>            
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-item-sales-on-app-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr style="text-align:center;">
                                    <th>STT</th>
                                    <th>Cửa hàng</th>
                                    <th>Mã sản phẩm</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Loại ly</th>
                                    <th>Size</th>
                                    <th>ĐVT</th>
                                    <th>Đơn giá</th>
                                    <th>Trạng thái</th>
                                    <th>IsSync</th>
                                    <th>IsApplyAll</th>
                                    <th>SyncResults</th>
                                    <th>IsTopping</th>
                                    <th>IsSales</th>
                                    <th>Ngày tạo</th>
                                    <th>Ngày cập nhật</th>
                                    <th>Kênh</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var table;
        $('.select2').select2();

        $(document).ready(function () {

            table = $('#tbl-item-sales-on-app-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: true,                 // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetCupTypeByItem", "Partner")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo = $('#store-no').val();
                        d.CupType = $('#sel-cup-type').val();
                        d.Status = $('#sel-status').val();
                        d.TextSearch = $('#text-search').val();
                    }
                },

                columns: [
                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemNo",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ItemNo == null || row.ItemNo == "") {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.ItemNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemName",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ItemName == null || row.ItemName == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.ItemName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CupType",  // loai ly
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CupType == null || row.CupType == "") {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top: 8px; display: block;">' + row.CupType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Size",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Size == null || row.Size == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.Size + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Uom",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Uom == null || row.Uom == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.Uom + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "UnitPrice",
                        className: "text-right",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.UnitPrice == null || row.UnitPrice == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.UnitPrice + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Blocked",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Blocked == "Hết hiệu lực") {
                                html += '<span class=\"badge\" style=\"color:#fff; background-color:#dc3545;\">Hết hiệu lực</span>';
                            }
                            else {
                                html += '<span class=\"badge\" style=\"color:#fff; background-color:#28a745;\">Có hiệu lực</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsSync",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsSync == null || row.IsSync == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.IsSync + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsApplyAll",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsApplyAll == null || row.IsApplyAll == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.IsApplyAll + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "SyncResults",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SyncResults == null || row.SyncResults == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.SyncResults + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsTopping",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsTopping == null || row.IsTopping == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.IsTopping + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "IsSales",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsSales == null || row.IsSales == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.IsSales + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CrtDate",  // Ngày tạo đơn hàng
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CrtDate == null || row.CrtDate == "")
                            {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else
                            {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + row.CrtDate + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ChgeDate",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ChgeDate == null || row.ChgeDate == "")
                            {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else
                            {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + row.ChgeDate + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "AppCode",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.AppCode == null || row.AppCode == "") {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top: 8px; display: block;">' + row.AppCode + '</span>';
                            }
                            return html;
                        }
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });


            $("#btn-search").on("click", function (e) {
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                //debugger
                $('#frm-export-excel').submit();
            });

        });

    </script>
}


<style>
    .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
        color: #5E6278;
        background-color: #ffffff;
        border-color: #2c48c5 #E4E6EF #ffffff;
    }

    .nav-tabs {
        border-bottom: 1px solid #0c713d;
    }
</style>


