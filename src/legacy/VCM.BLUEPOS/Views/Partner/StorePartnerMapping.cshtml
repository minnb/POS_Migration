        function CreateStoreHeadByNowFood() {
            //debugger
            var storeNo = $("#modal-create-store-no").val();
            if (storeNo == null || storeNo == "") {
                toastr.error('Chọn Cửa hàng');
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('partner_restaurant_id', storeNo);
            fromData.append('parent_restaurant', storeNo);
            $.ajax({
                url: '@Url.Action("CreateStoreHeadByNowFood", "Partner")',
                type: "POST",
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 1) {
                        toastr.success("Mapping cửa hàng thành công");
                        LoadComboxStorePLHByMappingNowFood();
                        $("#btn-search").trigger('click');
                        $('#modal-create-store-head-now-food').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

