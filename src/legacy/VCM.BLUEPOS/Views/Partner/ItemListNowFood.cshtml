@using Newtonsoft.Json;
@using System.Web.Configuration;
@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Partner;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.MCH;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listNganhHang = (List<VCM.BLUEPOS.Model.Partner.OptionModel>)ViewBag.ComboxCategory;
    var listStore = ViewBag.ListStore as List<VCM.BLUEPOS.Model.OptionModel.OptionModel>;
    var listSalesType = (List<VCM.BLUEPOS.Model.OptionModel.OptionModel>)ViewBag.SaleOrderType;

    var model = Model as ViewItemListNowFoodModel;
    var listItem = model.ListItem;
    var totalPage = Model.TotalPageNumber;

    string pageCurrent = HttpContext.Current.Request.RequestContext.RouteData.Values["page"] == null ? "1" : HttpContext.Current.Request.RequestContext.RouteData.Values["page"].ToString();
    int pageCR = int.Parse(pageCurrent);
    var totalRow = Model.TotalRow;
    var pageSize = Model.PageSize;
    var displayRow = $"{pageCR}-{pageSize}/{totalRow} sản phẩm";

    if (totalRow <= pageSize)
    {
        displayRow = $"{totalRow} sản phẩm";
    }
    if (pageCR > 1 && totalRow > pageSize)
    {
        displayRow = $"{(pageCR * pageSize + 1) - pageSize}-{(pageCR * pageSize > totalRow ? totalRow : pageCR * pageSize)} /{totalRow} sản phẩm";
    }

    var keyword = Html.Raw(Model.Keyword);
    var mch2 = Html.Raw(Model.MCH2);
    var storeno = Html.Raw(Model.StoreNo);
    var appcode = Html.Raw(Model.AppCode);
    var status = Html.Raw(Model.Status);
    var cupType = Html.Raw(Model.CupType);

    //string urlImg = WebConfigurationManager.AppSettings["urlImg"];
    //var isButtionAdd = model.IsButtonAdd;
    //string urlImgServer = WebConfigurationManager.AppSettings["urlImg"];

    string urlImg = WebConfigurationManager.AppSettings["urlImg"];
    var imgBase64 = ViewBag.ImagesBase64;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đối tác</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh sách sản phẩm</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <!-- Tab -->
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="example-preview" style="background-color:#fff;margin-left:-15px;margin-right:-15px;">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    @*<li class="nav-item">
                            <a class="nav-link classTab active" id="tab-setup-item-partner" data-toggle="tab" href="#setupitempartner">
                                <span class="nav-text font-weight-bold" style="font-weight:bold !important">
                                    Khai báo sản phẩm
                                </span>
                            </a>
                        </li>*@
                    <li class="nav-item">
                        <a class="nav-link classTab active" id="tab-item-partner-list" data-toggle="tab" href="#itempartnerlist" aria-controls="profile">
                            <span class="nav-text font-weight-bold" style="font-weight:bold !important">
                                Danh sách sản phẩm
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <!-- End Tab -->

        <div class="tab-content mt-5" id="myTabContent">
            <!-- Khai báo sàn phẩm -->
            @*<div class="tab-pane fade show active" id="tab-setup-item-partner" role="tabpanel" aria-labelledby="tab-setup-item-partner-v1">
                    <div class="card card-custom">
                        <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                        </div>
                    </div>
                </div>*@

            <!-- Danh mục sản phẩm -->
            <div class="tab-pane fade show active" id="tab-item-partner-list" role="tabpanel" aria-labelledby="tab-item-partner-list-v2">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch" style="border:1px solid #0c713d;width:100%">
                            @using (Html.BeginForm("ItemListNowFood", "Partner", FormMethod.Post, new { @id = "frm-item-list-now-food" }))
                            {
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Kênh<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <select class="form-control select2" id="sel-app-code" name="AppCode">
                                                    <option value="NOWFOOD" selected>NOWFOOD</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                                    @if (listStore != null && listStore.Count() > 0)
                                                    {
                                                        if (listStore.Count == 1)
                                                        {
                                                            <option value="ALL">ALL</option>
                                                            <option value="@listStore.FirstOrDefault().Value">@listStore.FirstOrDefault().Value - @listStore.FirstOrDefault().Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="" selected>Tất cả</option>
                                                            <option value="ALL">ALL</option>
                                                            foreach (var item in listStore)
                                                            {
                                                                <option value="@item.Value">@item.Value - @item.Text</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Ngành hàng<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-mch2" name="MCH2">
                                                    @if (listNganhHang != null && listNganhHang.Count > 0)
                                                    {
                                                        <option value="">Tất cả</option>
                                                        foreach (var item in listNganhHang)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                            <div class="form-group">
                                                <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="mã sản phẩm ; mã barcode; tên sản phẩm">
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-status" name="Status">
