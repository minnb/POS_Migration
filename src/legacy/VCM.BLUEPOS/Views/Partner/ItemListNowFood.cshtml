                                                    <option value="0" selected>Có hiệu lực</option>
                                                    <option value="1">Hết hiệu lực</option>
                                                </select>
                                            </div>
                                        </div>

                                        <input type="hidden" id="hdd-txt-key-word" name="keyword" />
                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top: 25px;">
                                            <button type="button" class="btn btn-primary" style="" id="btn-header-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card card-custom">
                        <div class="card-body">

                            <div id="loadItem">
                                <div class="row">
                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        @using (Html.BeginForm("ItemListNowFood", "Partner", FormMethod.Post, new { id = "frm-item-list-now-food", enctype = "multipart/form-data" }))
                                        {
                                            <div class="input-group input-group-sm input-group-solid" style="margin-top:10px;background: none;">
                                                <input type="checkbox" class="cusor" style="width: 20px;height:20px;" id="chk-check-all" name="CheckAll" />
                                                <span style="margin-left: 5px;font-weight:500;">Chọn tất cả (theo phân trang)</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap" style="text-align:right; float:right">
                                            @if (totalPage > 1)
                                            {
                                                <div class="d-flex flex-wrap">
                                                    <a href="@Url.Action("ItemListNowFood", "Partner", new { page = 1, appcode = appcode, storeno = storeno, mch2 = mch2, keyword = keyword, status = status })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-back icon-xs"></i>
                                                    </a>
                                                    <a href="@Url.Action("ItemListNowFood", "Partner", new { page = pageCR > 1 ? pageCR - 1 : pageCR, appcode = appcode, storeno = storeno, mch2 = mch2, keyword = keyword, status = status })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-back icon-xs"></i>
                                                    </a>

                                                    @for (int page = 1; page <= totalPage; page++)
                                                    {
                                                        var activePage = pageCR == page ? "active" : "";
                                                        <a href="@Url.Action("ItemListNowFood", "Partner", new { page = page, appcode = appcode, storeno = storeno, mch2 = mch2, keyword = keyword, status = status })" class="btn btn-icon btn-sm border-0 btn-hover-primary mr-2 my-1 @activePage">@page</a>
                                                    }

                                                    <a href="@Url.Action("ItemListNowFood", "Partner", new { page = pageCR < totalPage ? pageCR + 1 : pageCR, appcode = appcode, storeno = storeno, mch2 = mch2, keyword = keyword, status = status })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-next icon-xs"></i>
                                                    </a>

                                                    <a href="@Url.Action("ItemListNowFood", "Partner", new { page = totalPage, appcode = appcode, storeno = storeno, mch2 = mch2, keyword = keyword, status = status })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-next icon-xs"></i>
                                                    </a>

                                                </div>
                                            }

                                            <div class="d-flex align-items-center">
                                                <span class="text-muted">@displayRow</span>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>

                                <div class="row" id="div-infor-item-list">
                                    @if (listItem != null && listItem.Count > 0)
                                    {
                                        foreach (var item in listItem)
                                        {
                                            var fullImgPath = $"{urlImg}/{item.ImageName}";
                                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12" style="margin-bottom:-20px">
                                                <div class="card card-custom gutter-b card-stretch" style="border:1px solid #d5d2d2">
                                                    <div class="card-body">
                                                        <div style="cursor:pointer" class="d-flex align-items-center div-infor-item btn-view-detail-item" data-item-no="@item.ItemNo" data-item-name="@item.ItemName" data-category-name="@item.MCH2_Name" data-app-code="@item.AppCode" data-store-no="@item.StoreNo" data-unit-price="@item.UnitPrice" data-uom="@item.BaseUnitOfMeasure" data-size="@item.Size" data-topping="@item.IsTopping" data-blocked="@item.Blocked" data-cup-type="@item.CupType">
                                                            <div>
                                                                <input type="checkbox" class="chk-item-no" name="CheckItemNo" style="width: 20px; height:20px;" data-item-no-2="@item.ItemNo" />
                                                            </div>
                                                            <div class="flex-shrink-0 mr-4 mt-lg-0" style="margin-left:5px;">
                                                                <div class="symbol symbol-lg-75 div-image">
                                                                    @if (string.IsNullOrEmpty(item.ImageName))
                                                                    {
                                                                        <img src="~/Uploads/imgs/placeholder.png" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <img src="@fullImgPath" />
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="d-flex flex-column" style="font-family:Roboto ,Unicode Support Noto, sans-serif">
                                                                <a class="text-dark font-weight-bold text-hover-primary mb-0 div-item-name" data-item-name="@item.ItemName"><span style="color:#0c713d;font-weight:700;">@item.ItemName</span></a>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-item-no" data-itemNo="@item.ItemNo">No:&ensp;<span>@item.ItemNo</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-price" data-unit-price="@item.UnitPrice">Giá:&ensp;<span>@item.UnitPrice</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-uom" data-uom="@item.BaseUnitOfMeasure">ĐVT:&ensp;<span>@item.BaseUnitOfMeasure</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-size" data-size="@item.Size">Size:&ensp;<span>@item.Size</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-size" data-cup-type="@item.CupType">Loại ly:&ensp;<span>@item.CupType</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-topping" data-topping="@item.IsTopping">Topping:&ensp;<span>@item.IsTopping</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-sales-type" data-app-code="@item.AppCode">S-Type:&ensp;<span>@item.AppCode</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-store" data-store-no="@item.StoreNo">ST/CH:&ensp;<span>@item.StoreNo</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-category" data-category="@item.MCH2_Name">Ngành hàng:&ensp;<span>@item.MCH2</span><span>-</span><span>@item.MCH2_Name</span></span>
                                                                <span class="text-dark font-weight-bold text-hover-primary mb-0 div-status" data-blocked="@item.Blocked">Trạng thái:&ensp;<span>@item.Blocked</span></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div id="updateItem" style="display:none"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>



