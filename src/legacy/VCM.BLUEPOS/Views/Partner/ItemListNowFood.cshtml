        function GetDataRowItem() {
             //debugger
             var data = [];
             var appCode = $('#sel-app-code').val();

            $('.div-infor-item div').each(function () {
                //debugger
                var item = {};
                    var checkItemNo = $(this).parents('div').find('*.chk-item-no').prop('checked');
                    var itemNo = $(this).parents('div').find('*.div-item-no').find('span:nth-child(1)').html();
                    var itemName = $(this).parents('div').find('*.div-item-name').find('span:nth-child(1)').html();
                    var barCode = $(this).parents('div').find('*.div-barcode').find('span:nth-child(1)').html();
                    var uom = $(this).parents('div').find('*.div-uom').find('span:nth-child(1)').html();
                    var cateCode = $(this).parents('div').find('*.div-category').find('span:nth-child(1)').html();
                    var cateName = $(this).parents('div').find('*.div-category').find('span:nth-child(3)').html();
                    //var img = $(this).parents('div').find('*.div-image').html();

                    item['ItemNo'] = itemNo;
                    item['ItemName'] = itemName;
                    item['UnitOfMeasure'] = uom;
                    item['Barcode'] = barCode;
                    item['CategoryCode'] = cateCode;
                    item['CategoryName'] = cateName;
                    item['AppCode'] = appCode;
                    item['CheckItem'] = checkItemNo;
                    //item['Images'] = img;
                    data.push(item);

            });

            return data;
         };

