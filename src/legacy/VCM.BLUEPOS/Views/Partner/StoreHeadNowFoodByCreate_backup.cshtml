@using Newtonsoft.Json;
@using System.Web.Configuration;
@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Partner;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.MCH;

@{
    ViewBag.Title = "Mapping CH PLH - NowFood";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStorePLH  = ViewBag.ListStorePLH as List<Shopee_Restaurant_Model>;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Đối tác</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Mapping CH PLH - NowFood</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <button type="button" id="btn-add-new-store-head" class="btn btn-primary font-weight-bold"><i class="la la-plus-circle"></i>Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <!-- Tab -->
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="example-preview" style="background-color:#fff;margin-left:-15px;margin-right:-15px;">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link classTab active" id="tab-create-store-head" data-toggle="tab" href="#create-store-head-now-food" aria-controls="profile">
                            <span class="nav-text font-weight-bold" style="font-weight:bold !important">
                                Mapping CH PLH - NowFood
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="tab-content mt-5" id="myTabContent">
            <!-- Khai báo Cửa hàng NowFood -->
            <div class="tab-pane fade show active" id="create-store-head-now-food" role="tabpanel" aria-labelledby="tab-create-store-head">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch" style="border:1px solid #0c713d;width:100%">
                            @using (Html.BeginForm("", "Partner", FormMethod.Post, new { @id = "frm-store-head-now-food-create", enctype = "multipart/form-data" }))
                            {
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Đối tác <strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-create-partner" name="Partner" disabled>
                                                    <option value="">--- Chọn ---</option>
                                                    <option value="NOF" selected>NowFood</option>
                                                    <option value="BEF">BeFood</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng PLH</label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important">IsHeader</label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-is-header" name="IsHeader">
                                                    <option value="" selected>Tất cả</option>
                                                    <option value="True">True</option> <!-- 1 = True ; 0 = False -->
                                                    <option value="False">False</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="margin-top: 25px;">
                                            <button type="button" class="btn btn-primary" style="cursor:pointer" id="btn-search" name="btnSearch"><i class="fa fa-search"></i>Tìm</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tab: Khai báo Cửa hàng NowFood -->

                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                            <div class="card card-custom">
                                <div class="card-body">
                                    <table id="tbl-store-head-list-now-food" class="table table-bordered table-hover text-nowrap">
                                        <thead>
                                            <tr style="text-transform:uppercase;text-align:center;">
                                                <th>#</th>
                                                <th>STT</th>
                                                <th>Mã CH NowFood</th>
                                                <th>Mã CH Phúc Long</th>
                                                <th>Tên Cửa hàng</th>
                                                <th>Địa chỉ</th>
                                                <th>Is_Header</th>
                                                <th>Ngày tạo</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-create-store-head-now-food" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-update-store-head-now-food">Cửa hàng PLH Mapping NowFood</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="modal-create-store-head-now-food-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng PLH <strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-create-store-no" name="CreateStoreNo">
                                                @if (listStorePLH.Count() == 1)
                                                {
                                                    foreach (var item in listStorePLH)
                                                    {
                                                        <option value="@item.partner_restaurant_id">@item.partner_restaurant_id - @item.name</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="" selected>--- Tất cả ---</option>
                                                    foreach (var item in listStorePLH)
                                                    {
                                                        <option value="@item.partner_restaurant_id">@item.partner_restaurant_id - @item.name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btn-save-create-store-head-now-food" class="btn btn-bg-primary" style="color:#fff;"><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close" style="color:#fff;"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-update-store-head-now-food" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-update-store-head-now-food">Cập nhật Mapping CH PLH - NowFood</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-store-head-now-food-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat card-stretch">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng PLH<strong style="color:#ff0000"> (*)</strong></label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="modal-update-store-no" name="UpdateStoreNo">
                                                @if (listStorePLH.Count() == 1)
                                                {
                                                    foreach (var item in listStorePLH)
                                                    {
                                                        <option value="@item.partner_restaurant_id">@item.partner_restaurant_id - @item.name</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="" selected>--- Tất cả ---</option>
                                                    foreach (var item in listStorePLH)
                                                    {
                                                        <option value="@item.partner_restaurant_id">@item.partner_restaurant_id - @item.name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" id="modal-update-store-no-old" name="UpdateStoreOld" />                
                <div class="modal-footer">
                    <button type="button" id="btn-save-update-store-head-now-food" class="btn btn-bg-primary" style="color:#fff;"><i class="fa fa-save" style="color:#fff;"></i>Lưu lại</button>
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close" style="color:#fff;"></i>Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        function CreateStoreHeadByNowFood() {
            //debugger
            var storeNo = $("#modal-create-store-no").val();
            if (storeNo == null || storeNo == "") {
                toastr.error('Chọn Cửa hàng');
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('partner_restaurant_id', storeNo);
            fromData.append('parent_restaurant', storeNo);
            $.ajax({
                url: '@Url.Action("CreateStoreHeadByNowFood", "Partner")',
                type: "POST",
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 1) {
                        toastr.success("Mapping cửa hàng thành công");
                        LoadComboxStorePLHByMappingNowFood();
                        $("#btn-search").trigger('click');
                        $('#modal-create-store-head-now-food').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function UpdateStoreHeadByNowFood() {
            //debugger
            var storeNo = $("#modal-update-store-no").val();
            var storeOld = $("#modal-update-store-no-old").val();
            if (storeNo == null || storeNo == "") {
                toastr.error('Chọn Cửa hàng');
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('partner_restaurant_id', storeNo);
            fromData.append('partner_restaurant_id_old', storeOld);
            fromData.append('parent_restaurant', storeNo);
            $.ajax({
                url: '@Url.Action("UpdateStoreHeadByNowFood", "Partner")',
                type: "POST",
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    if (data.Status == 1) {
                        toastr.success(data.Message);
                        LoadComboxStorePLHByMappingNowFood();
                        $("#btn-search").trigger('click');
                        $('#modal-update-store-head-now-food').modal("hide");
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }   
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxStorePLHByMappingNowFood() {
            //debugger
            var html = '<select class="form-control select2" style="width: 100%;" id="sel-store-no" name="StoreNo">';
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxStorePLHByMappingNowFood", "Partner")',
                dataType: "json",
                success: function (data) {
                    html += "<option value=\"\">Tất cả</option>";
                    if (data.length > 0) {
                        data.forEach((item, i) => {
                            html += "<option value='" + item.partner_restaurant_id + "-" + item.restaurant_id + "'>" + item.partner_restaurant_id + "-" + item.name +"</option>"
                        });
                    }
                    html += '</select>';
                    $('#sel-store-no').html(html);
                },
                error: function () {
                    toastr.error('Lỗi hệ thống');
                }
            });

        }


        $(document).ready(function () {

        var table = "";
        $(".select2").select2();
        LoadComboxStorePLHByMappingNowFood();

        $('#btn-add-new-store-head').on('click', function () {
            $('#modal-create-store-head-now-food').modal({
                backdrop: "static",
                keyboard: false
            });
        });

        $("#btn-save-create-store-head-now-food").on("click", function (e) {
            CreateStoreHeadByNowFood();
        });

        $("#btn-save-update-store-head-now-food").on("click", function (e) {
            UpdateStoreHeadByNowFood();
        });

        table = $('#tbl-store-head-list-now-food').DataTable({
                destroy: true,
                select: {
                    style: 'single'
                },
                drawCallback: function (settings) {
                    $(".btn-update-store-head").click(function () {
                        //debugger
                        var storeNo = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        $('#modal-update-store-no').val(storeNo).trigger('change');
                        $("#modal-update-store-no-old").val(storeNo);
                        $('#modal-update-store-head-now-food').modal({
                            backdrop: 'static',
                            keyboard: true
                        });
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: false,              // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                info: true,                 // Hiển thị dòng _START_ đến dòng _END_ của tổng số _TOTAL_ dòng,
                autoWidth: false,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                ajax: {
                    url: '@Url.Action("GetStoreHeadNowFoodByCreate", "Partner")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo  = $('#sel-store-no').val();
                        d.IsHeader = $('#sel-is-header').val();
                    }
                },

                columns: [
                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "0") {
                                html += '<a type="button" class="btn btn-icon btn-light-warning btn-update-store-head" data-store-no ="' + row.StoreNo + '" data-toggle="tooltip" data-placement="left" title="Cập nhật"><i class="la la-edit"></i><span class="pulse-ring"></span></a>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block;">' + "" + '</span>';
                            }
                            return html;     
                        }
                    },

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "restaurant_id",    // Ma CH NowFood
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "1" || row.is_header == "True") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block; color:#0c713d;">' + row.restaurant_id + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block;">' + row.restaurant_id + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "partner_restaurant_id",  // Mã CH Phúc Long
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "1" || row.is_header == "True") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block; color:#0c713d;">' + row.partner_restaurant_id + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block;">' + row.partner_restaurant_id + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "name",    // Tên CH
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "1" || row.is_header == "True") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block; color:#0c713d; text-align:left;">' + row.name + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block; text-align:left;">' + row.name + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "address",   // Địa chỉ
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "1" || row.is_header == "True") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block; color:#0c713d; text-align:left;">' + row.address + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block; text-align:left;">' + row.address + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "is_header",
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.is_header == "1" || row.is_header == "True") {
                                html += '<span style="font-weight:700; padding-top: 8px; display: block; color:#0c713d;">' + row.is_header + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400; padding-top: 8px; display: block;">' + row.is_header + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "crt_date_str",  // Ngay tao
                        render: function (data, type, row) {
                            var html = "";
                            if (row.crt_date_str == null || row.crt_date_str == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;text-align:center;color:#0c713d;">' + "" + '</span>';
                            }
                            else
                            {
                                if (row.is_header == "1" || row.is_header == "True") {
                                    html += '<span style="font-weight:700;padding-top:8px;display:block;text-align:center;color:#0c713d;">' + row.crt_date_str + '</span>';
                                }
                                else {
                                    html += '<span style="font-weight:400;padding-top:8px;display:block;text-align:center;">' + row.crt_date_str + '</span>';
                                }
                            }
                            return html;
                        }
                    }
            ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

        $('#tbl-store-head-list-now-food tbody').on('click', 'tr', function () {
            $(this).toggleClass('selected');
        });

        $("#btn-search").on("click", function (e) {
            table.draw();
        });


    });

    </script>
}


<style>
    .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
        color: #5E6278;
        background-color: #ffffff;
        border-color: #2c48c5 #E4E6EF #ffffff;
    }

    .nav-tabs {
        border-bottom: 1px solid #0c713d;
    }
</style>


