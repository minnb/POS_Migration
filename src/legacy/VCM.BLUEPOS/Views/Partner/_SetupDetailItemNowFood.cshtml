<script type="text/javascript">
    $(document).ready(function () {
        $(".select2").select2();
        var kt_img_item = new KTImageInput('kt_img_item');
        $("#btnCancleImg").on("click", function (e) {
            $(".image-input-wrapper").css("background-image", 'url("/Uploads/imgs/placeholder.png"');
        });
    });
</script>


