<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="row">
        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-12">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Mã sản phẩm<strong style="color:#ff0000">(*)</strong></label>
                        <div class="input-group">
                            <input type="text" id="txt-item-no" class="form-control" value="@ItemNo" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Tên sản phẩm<strong style="color:#ff0000">(*)</strong></label>
                        <div class="input-group">
                            <input type="text" id="txt-item-name" class="form-control" value="@ItemName" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Tên ngành hàng</label>
                        <div class="input-group">
                            <input type="text" id="txt-item-group-name" class="form-control" value="@ItemGroupName" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">ST/CH</label>
                        <div class="input-group">
                            <input type="text" id="txt-store-no" class="form-control" value="@StoreNo" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Đơn vị tính</label>
                        <div class="input-group">
                            <input type="text" id="txt-uom" class="form-control" value="@Uom" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Giá</label>
                        <div class="input-group">
                            <input type="text" id="txt-unit-price" class="form-control" value="@UnitPrice" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Size</label>
                        <div class="input-group">
                            <input type="text" id="txt-size" class="form-control" value="@Size" disabled />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">IsTopping</label>
                        <div class="input-group">
                            <input type="text" id="txt-topping" class="form-control" value="@IsTopping" disabled />
                        </div>
                    </div>
                </div>

                @*<div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label class="font-weight-bold" style="font-weight:bold !important">Trạng thái</label>
                            <div class="input-group">
                                <input type="text" id="txt-blocked" class="form-control" value="@Blocked" disabled />
                            </div>
                        </div>
                    </div>*@

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="input-group" style="margin-top:27px;">
                        <div class="input-group-prepend">
                            <span class="input-group-text">
                                <label class="checkbox checkbox-inline" title="Trạng thái">
                                    <input type="checkbox" @Blocked id="chkBlocked" class="chkBlocked" disabled />
                                    <span></span>
                                </label>
                            </span>
                        </div>
                        <div class="input-group-append"><span class="input-group-text">Blocked</span></div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12" style="text-align:right">

            @{
                var urlImg = "/Uploads/imgs/placeholder.png";
                var isChangeImg = "";

                //if (!string.IsNullOrEmpty(imgItem))
                //{
                //    //urlImg = "data:image/jpeg;base64," + imgBase64;
                //    urlImg = "data:image/jpeg;base64";
                //    isChangeImg = "image-input-changed";
                //}

            }

            <div class="image-input image-input-outline @isChangeImg" id="kt_img_item">
                <div class="image-input-wrapper" style="background-image: url(@urlImg)"></div>

                <label class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-toggle="tooltip" title="" data-original-title="Change avatar">
                    <i class="fa fa-pen icon-sm text-muted"></i>
                    <input type="file" id="imgItem" name="imgItem" accept=".png, .jpg, .jpeg" />
                    <input type="hidden" name="imgItem_remove" />
                </label>

                <span id="btnCancleImg" class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="cancel" data-toggle="tooltip" title="Cancel avatar">
                    <i class="ki ki-bold-close icon-xs text-muted"></i>
                </span>
            </div>
        </div>

    </div>
</div>


