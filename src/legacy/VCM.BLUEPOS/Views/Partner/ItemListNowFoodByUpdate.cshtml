                            {
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important;">Đối tác <strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-create-partner" name="Partner">
                                                    <option value="" selected>--- Chọn ---</option>
                                                    <option value="NOF">Now Food</option>
                                                    <option value="GRF">Grab Food</option>
                                                    <option value="BEF">Be Food</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng<strong style="color:#ff0000"> (*)</strong></label>
                                            <div class="form-group">
                                                <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
