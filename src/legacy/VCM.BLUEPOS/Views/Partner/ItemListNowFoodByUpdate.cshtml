@section Scripts
{
    <script type="text/javascript">

        var keyword = $("#hdd-txt-key-word").val();

        function UpdateItemNoByNowFood() {
            //debugger
            var restaurant_id = $('#update-restaurant-id').val();                   // StoreNo trên NowFood
            var partner_restaurant_id = $("#txt-update-store-no-header").val();     // StoreNo trên SAP
            var partner_dish_id = $("#txt-update-partner-dish-id-temp").val();
            var name = $("#txt-update-item-name").val();
            var partner_dish_group_id = $("#sel-update-partner-dish-group-id").val();
            var price = $("#txt-update-price").val();
            var picture_id = $("#txt-update-picture-id-temp").val();

            if (name == null || name == "") {
                toastr.error("Vui lòng nhập tên sản phẩm");
                return;
            }

            if (partner_dish_group_id == null || partner_dish_group_id == "") {
                toastr.error("Vui lòng chọn ngành hàng");
                return;
            }
           
            if (price < 0) {
                toastr.error("Giá bán phải là kiểu số dương (>0). Vui lòng kiểm tra lại");
                return;
            }

            var check = $.isNumeric(price);
            if (check == false) {
                toastr.error("Giá bán phải là kiểu số dương (>0). Vui lòng kiểm tra lại");
                return;
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('restaurant_id', restaurant_id);
            fromData.append('partner_restaurant_id', partner_restaurant_id);
            fromData.append('partner_dish_id', partner_dish_id);                // Mã sản phẩm SAP
            fromData.append('name', name);                                      // Tên sản phẩm
            fromData.append('partner_dish_group_id', partner_dish_group_id);    // Mã ngành hàng
            fromData.append('price', price);
            fromData.append('picture_id', picture_id);

            $.ajax({
                url: '@Url.Action("_UpdateDetailItemNoByNowFood", "Partner")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    loading.hideloading();
                    if (data.Data.meta.code == 200) {
                        toastr.success("Cập nhật thành công");
                        $("#txt-text-search").val('');
                        $("#btn-search-item-list").trigger('click');

                        $('#modal-update-view-detail-item-now-food').modal("hide");
                        var NameStr = name;
                        $("#lbName" + partner_dish_id).html(NameStr);

                        var PriceStr = price;
                        $("#lbPrice" + partner_dish_id).html(PriceStr);
                        $('#txt-update-price-temp').val(PriceStr);                        // De hien thi lai tren popup khi chua call lai api
                        $('#txt-update-partner-dish-id-temp-v1').val(partner_dish_id);    // Cai biên nay dung de dk so sanh hien thi cho input gia ban
                        $('#txt-update-partner-dish-id-temp-v2').val(partner_dish_id);    // Dung de uncheckbox khi chon sang item khac

                        if (partner_dish_group_id == "1") {
                            groupStr = "1-Trà";
                        }
                        else if (partner_dish_group_id == "214") {
                            groupStr = "214-Cafe";
                        }
                        else if (partner_dish_group_id == "216") {
                            groupStr = "216-Bánh nóng";
                        }
                        else {
                            groupStr = "Khác";
                        }
                        $("#lbGroup" + partner_dish_id).html(groupStr);
                        Cleare_Text();
                    }
                    else
                    {
                        toastr.error('Có lỗi xảy ra. Vui lòng kiểm tra lại');
                        $('#modal-update-view-detail-item-now-food').modal("hide");
                    }                    
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


    function LoadItemListNowFoodByUpdate(storeNo, itemNo, textSearch) {
        //debugger
        loading.showloading();
        var fromData = new FormData();
        fromData.append('StoreNo', storeNo);
        fromData.append('ItemNo', itemNo);
        fromData.append('TextSearch', textSearch);

        $.ajax({     
                url: '@Url.Action("ApiItemListNowFoodByUpdate", "Partner")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,               
                success: function (response)
                {
                    //debugger
                    var html = ''; 
                    if (response.length != null) {
                        for (var i = 0; i < response.length; i++)
                        {
                            //debugger
                            html += '<div class=\"col-xl-3 col-lg-4 col-md-6 col-sm-12\">';
                            html += '<div class=\"card card-custom gutter-b card-stretch\" style=\"border:1px solid #d5d2d2\">';
                            html += '<div class=\"card-body\">';
                            html += '<div>';

                            var picture_id = "";
                            if (response[i].picture == null)
                            {
                                picture_id = "";
                            }
                            else
                            {
                                picture_id = response[i].picture.id;
                            }

                            var partner_dish_group_id = "-1";
                            if (response[i].partner_dish_group_id == null || response[i].partner_dish_group_id == "") {
                                partner_dish_group_id = "-1"; // = null
                            } 
                            else
                            {
                                partner_dish_group_id = response[i].partner_dish_group_id;
                            }
                           
                            var _partner_dish_id = response[i].partner_dish_id;

                            html += '<div style=\"cursor:pointer\" class=\"d-flex align-items-center btn-view-detail-item\" data-item-no="' + response[i].dish_id + '"  data-item-no-sap="' + response[i].partner_dish_id + '"  data-item-name="' + response[i].name + '"  onclick=\"ViewDetailByUpdate(' + _partner_dish_id + ',' + partner_dish_group_id + ',' + response[i].price + ',' + response[i].is_active + ',' + picture_id + ')\">';
                            html += '<div class=\"flex-shrink-0 mr-4 mt-lg-0\">';
                            html += '<div class=\"symbol symbol-lg-75\" style=\"padding-left: 10px;\">';

                            if (response[i].picture == null)
                            {
                                var ulrUploadImage = "~/Uploads/imgs/placeholder.png";
                                html += '<img src="' + ulrUploadImage +'" />';
                            }
                            else
                            {
                                var imagesBase64 = response[i].picture.url;
                                html += '<img src="' + imagesBase64 + '" />';
                            }

                            html += '</div>';
                            html += '</div>';

                            html += '<div class=\"d-flex flex-column\" style=\"font-family:Roboto ,Unicode Support Noto, sans-serif\">';
                            html += '<a class=\"text-dark font-weight-bold text-hover-primary mb-0\"><span id = "lbName' + response[i].partner_dish_id + '">' + response[i].name + '</a>';
                            html += '<span class=\"text-muted font-weight-bold\">No: ' + response[i].dish_id + '</span>';
                            html += '<span class=\"text-muted font-weight-bold\">Sap: ' + response[i].partner_dish_id + '</span>';
                            html += '<span class=\"text-muted font-weight-bold\">Giá: <span id = "lbPrice' + response[i].partner_dish_id + '">' + response[i].price + ' </span></span>';

                            var partner_dish_group_id = response[i].partner_dish_group_id;

                            //GetGroupName(partner_dish_group_id);
                            //var partner_dish_group_name = $('#txt-update-group-name-temp').val();

                            var partner_dish_group_name = "";
                            if (partner_dish_group_id == "1")
                            {
                                partner_dish_group_name = "1-Trà";
                            }
                            else if (partner_dish_group_id == "214")
                            {
                                partner_dish_group_name = "214-Cafe";
                            }
                            else if (partner_dish_group_id == "216")
                            {
                                partner_dish_group_name = "216-Bánh nóng";
                            }
                            else
                            {
                                partner_dish_group_name = "Khác";
                            }
                            html += '<span class=\"text-muted font-weight-bold\">Ngành hàng: <span id = "lbGroup' + response[i].partner_dish_id + '">' + partner_dish_group_name + '</span></span>';

                            if (response[i].is_active == false)
                            {
                                var isActiveStr = "Deactive";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' + response[i].partner_dish_id+ '" style=\"color:#ff0000;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }
                            else if (response[i].is_active == true)
                            {
                                var isActiveStr = "Active";
                                html += '<span class=\"text-muted font-weight-bold\">Trạng thái: <span id="lbStatus' + response[i].partner_dish_id + '" style=\"color:#06b65c;font-weight-bold\">' + isActiveStr + '</span></span>';
                            }

                            html += '<span class=\"text-muted font-weight-bold\">PictureId: ' + picture_id + ' </span>';
                            html += '</div>';                            
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                        }
                    }
                    else
                    {
                        html += '<div class="alert-cutom alert-warning" style="font-weight: 400; text-align: center;">';
                        html += '<span>Không có dữ liệu</span>';
                        html += '</div>';
                    }

                    $('#div-update-view-item-list-now-food-lock').html(html);
                    loading.hideloading();

                },
                error: function (event)
                {
                    loading.hideloading();
                }
            });
        }


    function ViewDetailByUpdate(partner_dish_id, partner_dish_group_id, pirce, is_active, picture_id) {
            //debugger
            var storeNo = $("#sel-store-no").val();
            if (storeNo == null) {
                return;
                }

            var partner_restaurant_id = storeNo.split('-')[0];
            var restaurant_id = storeNo.split('-')[1];

            $('#update-restaurant-id').val(restaurant_id);
            $('#update-partner-restaurant-id').val(partner_restaurant_id);

            $('#txt-update-partner-dish-id-temp').val(partner_dish_id);
            $('#txt-update-item-no-sap').val(partner_dish_id);

            $('#txt-update-picture-id-temp').val(picture_id);
            $('#txt-update-price').val(pirce);

            var partner_dish_id_temp_v1 = $('#txt-update-partner-dish-id-temp-v1').val();
            var priceTemp = $('#txt-update-price-temp').val();
            if (priceTemp == "")
            {
                $('#txt-update-price').val(pirce);
            }
            else
            {
                if (pirce != priceTemp)
                {
                    if (partner_dish_id_temp_v1 == partner_dish_id) {
                        $('#txt-update-price').val(priceTemp);
                    }
                    else {
                        $('#txt-update-price').val(pirce);
                    } 
                }
                else {
                    $('#txt-update-price').val(pirce);
                }
            }

            var status = 1;
            if (is_active == true) {
                status = 1; // Active
            }
            else
            {
                status = 3; // Deactive
            }

            var _partner_dish_group_id = "";

            if (partner_dish_group_id == "1") {
                _partner_dish_group_id = 1;
            }
            else if (partner_dish_group_id == "214") {
                _partner_dish_group_id = 214;
            }
            else if (partner_dish_group_id == "216") {
                _partner_dish_group_id = 216;
            }
            else if (partner_dish_group_id == "" || partner_dish_group_id == null || partner_dish_group_id == "-1") {
                _partner_dish_group_id = "";
            }

            LoadDetailItemNowFoodByUpdate(restaurant_id, partner_restaurant_id, partner_dish_id, _partner_dish_group_id, status, picture_id);

    };


    function LoadDetailItemNowFoodByUpdate(restaurant_id, partner_restaurant_id, partner_dish_id, partner_dish_group_id, status) {
        //debugger

        $('#txt-update-store-no-header').val(partner_restaurant_id);
        var storeName = $("#sel-store-no").select2().find(":selected").data("storename");
        $('#txt-update-store-no-header-name').val(storeName);

        $('#txt-update-item-no-sap').val(partner_dish_id);
        $('#sel-update-status-lock').val(status).trigger('change');

        $('#sel-update-partner-dish-group-id').val(partner_dish_group_id).trigger('change');
        GetItemName(partner_dish_id, partner_restaurant_id);

        $('#modal-update-view-detail-item-now-food').modal({
            backdrop: 'static',
            keyboard: false
        });

    }

    function GetItemName(partner_dish_id, partner_restaurant_id) {
        //debugger
        $.ajax({
            url: '@Url.Action("GetItemNameByNowFood", "Partner")',
            type: "POST",
            dataType: "json",
            data: {
                partner_dish_id: partner_dish_id,
                partner_restaurant_id: partner_restaurant_id
            },
            success: function (data) {
                //debugger
                $('#txt-update-item-name').val(data);
            },
            error: function (data) {
                toastr.error('Lỗi hệ thống');
            }
        });

    }

    
    function GetGroupName(partner_dish_group_id) {
        //debugger
        $.ajax({
            url: '@Url.Action("GetGroupName", "Partner")',
            type: "POST",
            dataType: "json",
            data: {partner_dish_group_id: partner_dish_group_id},
            success: function (data) {
                $('#txt-update-group-name-temp').val(data);
            },
            error: function (data) {
                toastr.error('Lỗi hệ thống');
            }
        });
    }
    
    function Cleare_Text() {
        $('#txt-update-item-name').val('');
        $('#sel-update-partner-dish-group-id').trigger('changge');
    };


    $(document).ready(function () {
        $(".select2").select2();
        var kt_img_item_lock = new KTImageInput('kt_img_item_lock');

        $('#txt-text-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $("#btn-save-update-item-no-lock").on("click", function (e) {
            UpdateItemNoByNowFood();
        });

        $("#btn-search-item-list").on('click', function (e) {
            //debugger
            var storeNoStr = $("#sel-store-no").val();
            if (storeNoStr == null || storeNoStr == "") {
                toastr.error('Chọn ST/CH');
                return;
            }

            var storeNo1 = storeNoStr.split('-')[0];
            var storeNo = storeNo1.trim();
            var itemNo = $("#txt-text-search").val();
            var textSearch = $("#txt-text-search").val();

            LoadItemListNowFoodByUpdate(storeNo, itemNo, textSearch);

        });

    });
</script>

