@using VCM.BLUEPOS.Model.Product;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Cập nhật Article";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Cập nhật Article</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã sản phẩm</label>
                                <div class="form-group">
                                    <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-no" name="ItemNo" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tên sản phẩm</label>
                                <div class="form-group">
                                    <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-name" name="ItemName" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã barcode</label>
                                <div class="form-group">
                                    <input type="text" class="form-control pull-right" style="width:100%;" id="txt-barcode" name="Barcode" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 0 !important;">Thuế suất VAT</label>
                                <div class="form-group">
                                    <select class="form-control select2" id="sel-tax-code" name="TaxCode">
                                        <option value="" selected>----- Tất cả -----</option>
                                        <option value="4">10%</option>
                                        <option value="5">5%</option> <!-- 3,5 : 5%-->
                                        <option value="2">0%</option>
                                        <option value="1">Non Tax</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="margin-top:18px;">
                                <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i> Tìm kiếm</button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-scroll" style="">
                            <table id="tbl-update-article" class="table table-bordered table-hover text-nowrap row-border order-column">
                                <thead>
                                    <tr class="text-center">
                                        <th>#</th>
                                        <th>STT</th>
                                        <th>Mã sản phẩm</th>
                                        <th style="text-align:center">Tên sản phẩm</th>
                                        <th style="text-align:center">Tên đầy đủ sản phẩm</th>
                                        <th>ĐVT</th>
                                        <th>Loại</th>
                                        <th>Trạng thái sản phẩm</th>
                                        <th>Mã Barcode</th>
                                        <th>ĐVT Barcode</th>
                                        <th>Trạng thái Barcode</th>
                                        <th>Thuế suất VAT</th>
                                        <th>Tích điểm VinID</th>
                                        <th>Ngành hàng</th>
                                        <th>Thương hiệu</th>
                                        <th>Model</th>
                                        <th>Ngày cập nhật</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-update-product" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cập nhật thông tin sản phẩm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã sản phẩm</label>
                        <div class="form-group">
                            <input type="text" id="modal-item-no" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Loại</label>
                        <div class="form-group">
                            <input type="text" id="modal-article-type" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Đơn vị tính</label>
                        <div class="form-group">
                            <input type="text" id="modal-unit-item" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Ngành hàng</label>
                        <div class="form-group">
                            <input type="text" id="modal-category-item" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Thương hiệu</label>
                        <div class="form-group">
                            <input type="text" id="modal-brand-item" class="form-control" value="" />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Model</label>
                        <div class="form-group">
                            <input type="text" id="modal-model-item" class="form-control" value="" />
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tên sản phẩm</label>
                        <div class="form-group">
                            <input type="text" id="modal-item-name" class="form-control" value="" />
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tên đầy đủ sản phẩm</label>
                        <div class="form-group">
                            <input type="text" id="modal-item-name-full" class="form-control" value="" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="display: inline-block; padding-top: 30px;">
                        <input type="checkbox" id="modal-chk-taxcode-vat" style="height:25px; width:25px; cursor:pointer; padding-top: 5px; margin-left: 1px;">
                        <label for="modal-chk-taxcode-vat" style="font-size:11px; margin-top: 10px; position: absolute; padding-left: 7px;">Xuất VAT</label>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Thuế suất VAT</label>
                        <div class="form-group">
                            <select class="form-control select2" id="modal-tax-code" name="TaxCode">
                                <option value="" selected>----- Chọn -----</option>
                                <option value="4">10%</option>
                                <option value="5">5%</option> <!-- 3,5 : 5%-->
                                <option value="2">0%</option>
                                <option value="1">Non Tax</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Trạng thái sản phẩm</label>
                        <div class="form-group">
                            <select class="form-control select2" id="modal-status-item" name="StatusItem">
                                <option value="" selected>----- Chọn -----</option>
                                <option value="0">Có hiệu lực</option>
                                <option value="1">Hết hiệu lực</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="display: inline-block; padding-top: 30px;">
                        <input type="checkbox" id="modal-chk-member-points" style="height:25px; width:25px; cursor:pointer; padding-top: 5px; margin-left: 1px;">
                        <label for="chk-member-points" style="font-size:11px; margin-top: 10px; position: absolute; padding-left: 7px;">Tích điểm VinID</label>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã Barcode</label>
                        <div class="form-group">
                            <input type="text" id="modal-barcode" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">ĐVT Barcode</label>
                        <div class="form-group">
                            <input type="text" id="modal-unit-barcode" class="form-control" value="" disabled />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <label class="font-weight-bold" style="margin-bottom: 0 !important;">Trạng thái barcode</label>
                        <div class="form-group">
                            <select class="form-control select2" id="modal-status-barcode" name="StatusItem">
                                <option value="" selected>----- Chọn -----</option>
                                <option value="0">Có hiệu lực</option>
                                <option value="1">Hết hiệu lực</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="btn-save-update" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Lưu</button>
            </div>

        </div>
    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table = "";

        function UpdateProduct() {
            //debugger
            var _barcode            = $('#modal-barcode').val();
            var _unitBarcode        = $('#modal-unit-barcode').val();
            var _itemNo             = $('#modal-item-no').val();
            var _articleType        = $('#modal-article-type').val();
            var _unitItem           = $('#modal-unit-item').val();
            var _categoryItem       = $('#modal-category-item').val();
            var _brandItem          = $('#modal-brand-item').val();
            var _modelItem          = $('#modal-model-item').val();
            var _itemName           = $('#modal-item-name').val();
            var _itemNameFull       = $('#modal-item-name-full').val();
            var _barcodeStatus      = $('#modal-status-barcode').val();
            var _itemStatus         = $('#modal-status-item').val();
            var _taxCode            = $('#modal-tax-code').val();
            var _chkTaxCodeVAT      = $('#modal-chk-taxcode-vat').prop('checked');
            var _chkMemberPoints    = $('#modal-chk-member-points').prop('checked');

            if (_chkTaxCodeVAT == false) {
                _taxCode = "";
            }

            if (_chkMemberPoints == false) {
                _chkMemberPoints = 0;
            }
            else {
                _chkMemberPoints = 1;
            }

            if (_itemStatus == "0") {
                _itemStatus = 0;
            }
            else {
                _itemStatus = 1;
            }

            if (_barcodeStatus == "0") {
                _barcodeStatus = 0;
            }
            else {
                _barcodeStatus = 1;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("UpdateProductList", "Product")',
                type: "POST",
                dataType: "json",
                data: {
                        ItemNo: _itemNo,
                        ItemName: _itemName,
                        ItemNameFull: _itemNameFull,
                        Blocked: _itemStatus,
                        TaxGroupCode: _taxCode,
                        ItemFamilyCode: _articleType,
                        SalesUnit: _unitItem,
                        ItemCategoryCode: _categoryItem,
                        Brand: _brandItem,
                        Model: _modelItem,
                        BlockedVINID: _chkMemberPoints,
                        BarcodeNo: _barcode,
                        BarcodeUnit: _unitBarcode,
                        BlockedBarcode: _barcodeStatus
                },
                success: function (data) {
                   //debugger
                   if (data.Status == 1)
                   {
                       toastr.success(data.Message);
                       $('#modal-update-product').modal('hide');
                   }
                   else if (data.Status == 2)
                   {
                       toastr.warning(data.Message);
                   }
                   else if (data.Status == 3)
                   {
                       toastr.error(data.Message);
                   }
                   else if (data.Status == 4)
                   {
                       toastr.error(data.Message);
                   }
                   $('#btn-search').trigger('click');
                   loading.hideloading();
                },
                error: function (data)
                {
                   loading.hideloading();
                   toastr.error('Lỗi hệ thống');
                }
            });
        }

        $(document).ready(function () {            
            $("#btn-save-update").on("click", function (e) {
                UpdateProduct();
            });

            table = $('#tbl-update-article').DataTable({
                destroy: true,
                deferLoading: 0,
                //
                drawCallback: function (settings) {
                    // 
                    $('.btn-edit-item').click(function () {
                        //debugger
                        var _barCode = $(this).attr("data-barcode");
                        var _unitBarCode = $(this).attr("data-unit-barcode");
                        var _itemNo = $(this).attr("data-itemNo");
                        var _itemName = $(this).attr("data-itemName");
                        var _itemNameFull = $(this).attr('data-itemNameFull');
                        var _unitItem = $(this).attr("data-unit-item");
                        var _articleType = $(this).attr("data-article-type");
                        var _memberPoints = $(this).attr("data-member-points");
                        var _categoryItem = $(this).attr("data-category-item");
                        var _brand = $(this).attr("data-brand");
                        var _model = $(this).attr("data-model");

                        var _statusBarCode = $(this).parents('tr').find('td:nth-child(11)').find('span:nth-child(1)').html();
                        var _barcodeStatus = "";
                        if (_statusBarCode == "Có hiệu lực") {
                            _barcodeStatus = "0";
                        }
                        else if (_statusBarCode == "Hết hiệu lực")
                        {
                            _barcodeStatus = "1";
                        }
                        $('#modal-status-barcode').val(_barcodeStatus).trigger('change');

                        var _statusItems = $(this).parents('tr').find('td:nth-child(8)').find('span:nth-child(1)').html();
                        var _itemStatus = "";
                        if (_statusItems == "Có hiệu lực") {
                            _itemStatus = "0";
                        }
                        else if (_statusItems == "Hết hiệu lực") {
                            _itemStatus = "1";
                        }
                        $('#modal-status-item').val(_itemStatus).trigger('change');

                        $('#modal-barcode').val(_barCode);
                        $('#modal-unit-barcode').val(_unitBarCode);
                        $('#modal-item-no').val(_itemNo);
                        $('#modal-article-type').val(_articleType);
                        $('#modal-unit-item').val(_unitItem);
                        $('#modal-category-item').val(_categoryItem);
                        $('#modal-brand-item').val(_brand);
                        $('#modal-model-item').val(_model);
                        $('#modal-item-name').val(_itemName);
                        $('#modal-item-name-full').val(_itemNameFull);
                        
                        var _taxCode = $(this).attr("data-taxcode");
                        if (_taxCode == "5%") {
                            _taxCode = 5;
                        }
                        else if (_taxCode == "10%") {
                            _taxCode = 4;
                        }
                        else if (_taxCode == "0%") {
                            _taxCode = 2;
                        }
                        else if (_taxCode == "Non Tax") {
                            _taxCode = 1;
                        }

                        $('#modal-tax-code').val(_taxCode).trigger('change');

                        if (_taxCode != null || _taxCode != "") {
                            $('#modal-chk-taxcode-vat').attr('checked', true);
                        }
                        else {
                            $('#modal-chk-taxcode-vat').attr('checked', false);
                        }

                        if (_memberPoints == "1") {
                            $('#modal-chk-member-points').attr('checked', true);
                        }
                        else {
                            $('#modal-chk-member-points').attr('checked', false);
                        }

                        $('#modal-update-product').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 15,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("GetUpdateProductList", "Product")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        //debugger
                        d.ItemNo    = $('#txt-item-no').val();
                        d.ItemName  = $('#txt-item-name').val();
                        d.BarcodeNo = $('#txt-barcode').val();
                        d.TaxCode   = $('#sel-tax-code').val();
                    }
                },

                columns: [
                    {
                        "render": function (data, type, row) {
                            var _barcodeNo = row.BarcodeNo;
                            var _unitBarcode = row.BarcodeUnit;
                            var _statusBarcode = row.BlockedBarcode;
                            var _itemNo = row.ItemNo;
                            var _itemName = row.ItemName;
                            var _itemNameFull = row.ItemNameFull;
                            var _unitItem = row.SalesUnit;
                            var _articleType = row.ItemFamilyCode;
                            var _taxCode = row.TaxGroupCode;
                            var _statusItem = row.Blocked;
                            var _memberPoints = row.BlockedVINID;
                            var _categoryItem = row.ItemCategoryCode;
                            var _brand = row.Brand;
                            var _model = row.Model;
                            var html = '<a type="button" class="btn btn-icon btn-light-warning pulse pulse-warning btn-edit-item" data-toggle="tooltip" data-placement="left" title="Cập nhật"'; 
                            html += ' data-barcode ="' + _barcodeNo + '"';
                            html += ' data-unit-barcode ="' + _unitBarcode + '"';
                            html += ' data-status-barcode ="' + _statusBarcode + '"'; 
                            html += ' data-itemNo ="' + _itemNo + '"'; 
                            html += ' data-itemName ="' + _itemName + '"';
                            html += ' data-itemNameFull ="' + _itemNameFull + '"';
                            html += ' data-unit-item ="' + _unitItem + '"'; 
                            html += ' data-article-type ="' + _articleType + '"'; 
                            html += ' data-taxcode ="' + _taxCode + '"'; 
                            html += ' data-status-item ="' + _statusItem + '"';
                            html += ' data-member-points ="' + _memberPoints + '"';
                            html += ' data-category-item ="' + _categoryItem + '"';
                            html += ' data-brand ="' + _brand + '"';
                            html += ' data-model ="' + _model + '"';
                            html +=' style = "color:#ffffff;text-align:center; margin-right:5px;" ><i class=\"nav-icon la la-edit\"></i><span class=\"pulse-ring\"></span></a >';
                            return html;
                        }
                    },

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ItemNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ItemNo + '</span>';
                        }
                    },

                    {
                        data: "ItemName",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemName + '</span>';
                        }
                    },

                    {
                        data: "ItemNameFull",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemNameFull + '</span>';
                        }
                    },

                    {
                        data: "SalesUnit",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.SalesUnit + '</span>';
                        }
                    },
                    
                    {
                        data: "ItemFamilyCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.ItemFamilyCode + '</span>';
                        }
                    },

                    {
                        data: "Blocked",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var _status = row.Blocked;
                            var html = "";
                            if (_status == "0") {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Có hiệu lực</span>';
                            }
                            else {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "BarcodeNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.BarcodeNo + '</span>';
                        }
                    },

                    {
                        data: "BarcodeUnit",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.BarcodeUnit + '</span>';
                        }
                    },

                    {
                        data: "BlockedBarcode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var _status = row.BlockedBarcode;
                            var html = "";
                            if (_status == "0") {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Có hiệu lực</span>';
                            }
                            else {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>';
                            }
                            return html;
                        }
                    },
                    
                    {
                        data: "TaxGroupCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.TaxGroupCode + '</span>';
                        }
                    },

                    {
                        data: "BlockedVINID",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var _status = row.BlockedVINID;
                            var html = "";
                            if (_status == "1") {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Có</span>';
                            }
                            else {
                                html = '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Không</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemCategoryCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.ItemCategoryCode + '</span>';
                        }
                    },

                    {
                        data: "Brand",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.Brand + '</span>';
                        }
                    },

                    {
                        data: "Model",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.Model + '</span>';
                        }
                    },

                    {
                        data: "LastDateModifiedStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.LastDateModifiedStr + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            //
            $('[data-toggle="tooltip"]').tooltip();

            //
            $('#tbl-update-article tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            //
            $("#btn-search").on("click", function (e) {
                table.draw();
            });

        });

    </script>
}






