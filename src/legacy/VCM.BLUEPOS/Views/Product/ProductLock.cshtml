@using VCM.BLUEPOS.Model.Product;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Authen;
@using VCM.BLUEPOS.Models.Login;

@{
    ViewBag.Title = "Khóa món";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var listUserRole = ViewBag.ListRole as UserRoleModel;
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var UserLogin = ViewBag.UserLogin;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khóa món</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-6">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    @using (Html.BeginForm("", "Product", FormMethod.Post, new { @id = "frm-product-lock-list" }))
                                    {
                                        <div class="card-body">
                                            <div class="row">
                                                @if (listUserRole != null)
                                                {
                                                    if (listUserRole.RoleCode == "R0007") // SM_PhucLong : CH trưởng/ CH phó
                                                    {
                                                        <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                            <label style="font-weight:600 !important;color:#0c713d;">Loại kết nối</label>
                                                            <div class="input-group">
                                                                <select class="form-control select2" style="width:100%;" id="sel-source-type" name="SourceType">
                                                                    <option value="POS" selected>POS</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (listUserRole.RoleCode == "R0000" || listUserRole.RoleCode == "R0001" || listUserRole.RoleCode == "R0002" || listUserRole.RoleCode == "R0009")
                                                    {
                                                        <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                            <label style="font-weight:600 !important;color:#0c713d;">Loại kết nối</label>
                                                            <div class="input-group">
                                                                <select class="form-control select2" style="width:100%;" id="sel-source-type" name="SourceType">
                                                                    <option value="POS" selected>POS</option>
                                                                    <option value="SERVER">CENTRAL</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    }
                                                }

                                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                    <label style="font-weight:600 !important;color:#0c713d;">Vùng Set</label>
                                                    <div class="input-group">
                                                        <select class="form-control select2" style="width:100%;" id="sel-set-server" name="SetServer" disabled>
                                                            @if (listSetDB != null && listSetDB.Count > 0)
                                                            {
                                                                if (listSetDB.Count == 1)
                                                                {
                                                                    <option value="@listSetDB.FirstOrDefault().IPServer">@listSetDB.FirstOrDefault().Description</option>
                                                                }
                                                                else
                                                                {
                                                                    foreach (var item in listSetDB)
                                                                    {
                                                                        <option value="@item.IPServer">@item.Description</option>
                                                                    }
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                                    <label style="font-weight:600 !important;color:#0c713d;">Cửa hàng</label>
                                                    <div class="form-group">
                                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo"></select>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                                    <label style="font-weight:600 !important;color:#0c713d;">Máy POS</label>
                                                    <div class="input-group">
                                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="IPAddress"></select>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                                    <div class="form-group">
                                                        <button type="button" class="btn btn-primary" id="btn-search-store"><i class="fa fa-search"></i>Tìm</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-6">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                                <label style="font-weight:600 !important;color:#0c713d;">Trạng thái sản phẩm<strong style="color:#ff0000"> (*)</strong></label>
                                                <div class="form-group">
                                                    <select class="form-control select2" id="sel-status-item-no" name="StatusItemNo">
                                                        <option value="-1">Tất cả</option>
                                                        <option value="0" selected>Đang kinh doanh</option>
                                                        <option value="1">Tạm ngừng kinh doanh</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <input type="text" hidden id="param-store-no" name="Temp-Store-No"/>
                                            <input type="text" hidden id="param-store-name" name="Temp-Store-Name"/>

                                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                                <div class="form-group">
                                                    <button type="button" id="btn-search-item" class="btn btn-primary"> <i class="fa fa-search"></i>Tìm</button>
                                                </div>
                                            </div>
                                        </div>

                                        @if (listUserRole != null)
                                        {
                                            if (listUserRole.RoleCode == "R0000" || listUserRole.RoleCode == "R0001" || listUserRole.RoleCode == "R0002" || listUserRole.RoleCode == "R0009" || listUserRole.RoleCode == "R0007")
                                            {
                                                <div class="row">
                                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12"></div>
                                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                                        <div class="form-group">
                                                            <button type="button" id="btn-create-product-lock-or-unlock" class="btn btn-bg-warning" style="float: right;color:#fff;"><i class="la la-save" style="color:white;"></i> Lưu khóa / mở món</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-6">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tbl-store-list" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center" style="text-transform:uppercase">
                                        <th width="20px" style="padding-right: 10px;">
                                            <span>#</span>
                                        </th>
                                        <th style="padding-right: 10px;">STT</th>
                                        <th>Mã CH</th>
                                        <th>Tên cửa hàng</th>
                                        <th>Kênh</th>
                                        <th>Mở khóa</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-6">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tbl-product-list" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center" style="text-transform:uppercase">
                                        <th width="20px" style="padding-right: 10px;">
                                            <input type="checkbox" class="cusor" name="CheckAll" id="check-all-item-list" data-toggle="tooltip" data-placement="top" title="Chọn tất cả">
                                        </th>
                                        <th style="padding-right: 10px;">STT</th>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>ĐVT</th>
                                        <th style="display:none;">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modal-unlock-product" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-unlock-product">MỞ KHÓA MÓN - DANH SÁCH SẢN PHẨM - CH</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="div-popup-unlock-product">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <input type="text" hidden id="hdd-txt-store-no" name="TempStoreNo"/>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div>
                        <table id="tbl-unlock-product" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th width="3%" style="padding-right: 10px;">
                                        <input type="checkbox" class="cusor" name="CheckAll" id="check-all-unlock-product-modal" data-toggle="tooltip" data-placement="top" title="Chọn tất cả">
                                    </th>
                                    <th width="3%">STT</th>
                                    <th width="10%">Mã sản phẩm</th>
                                    <th width="45%">Tên sản phẩm</th>
                                    <th width="9%">ĐVT</th>
                                    <th width="10%">Trạng thái</th>
                                    <th width="10%">Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btn-modal-create-unlock-product" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i> Lưu lại</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{

    <script type="text/javascript">

        var table_store = "";
        var table_product = "";
        var table_unlock_product = "";
        var _countStoreNo = 0;

        function LoadSetServer() {
            //debugger
            var _sourceType = $("#sel-source-type").val();
            if (_sourceType == "POS")
            {
                $("#sel-set-server").attr('disabled', true);
                $("#sel-pos-terminal").attr('disabled', false);
            }
            else if (_sourceType == "SERVER")
            {
                $("#sel-set-server").attr('disabled', false);
                $("#sel-pos-terminal").attr('disabled', true);
            }
        }

        function LoadPOSByStoreNo(storeNo){
            //debugger
             $("#sel-pos-terminal").empty();
             var html1 = "<option value=''>Tất cả</option>";
             if (storeNo == null || storeNo == "")
             {
                return $("#sel-pos-terminal").html(html1);
             }
             var fromData = new FormData();
             fromData.append('StoreNo', storeNo);
             $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                          if (data != null) {
                              var html = "<option value=''>Chọn máy POS</option>";
                              data.forEach((name, i) =>
                              {
                                  if (name.IpAddress != "")
                                  {
                                    html += "<option value=" + name.IpAddress + ">" + name.PosID + " - " + name.IpAddress + "</option>";
                                  }
                              });
                              $("#sel-pos-terminal").html(html);
                          }
                    },
                    error: function () {}
             });
        }

        function SelectedFirstRow() {
              //debugger
              if (_countStoreNo == 1) {
                  $('#tbl-store-list tbody').find('input[type="checkbox"]').each(function ()
                  {
                        var storeNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                        var storeName = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                        $('#param-store-no').val(storeNo);
                        $('#param-store-name').val(storeName);
                        $('#title-site').text(storeNo + ' - ' + storeName);
                      $(this).attr("checked", true);
                  });
                  $('#btn-search-item').trigger('click');
              }
              else
              {
                  $('#tbl-store-list tbody').find('input[type="checkbox"]').each(function () {
                        $(this).attr("checked", false);
                  });
              }
        };

        function LoadStoreList() {
            $("#sel-store-no").empty();
            loading.showloading();
            $.ajax({
                 type: "POST",
                 url: '@Url.Action("LoadStoreByUserName", "Common")',
                 contentType: "application/json",
                 dataType: "json",
                 contentType: false,
                 processData: false,
                 success: function (data) {
                    //debugger
                    loading.hideloading();
                    var html = "";
                    if (data != null)
                    {
                        if (data.length == 1)
                        {
                            html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                            _countStoreNo = parseInt(data.length);
                        }
                        else if (data.length > 1)
                        {
                            data.forEach((name, i) =>
                            {
                                if (name.SiteNo != "")
                                {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });

                            $('#sel-store-no').html(html);
                            _countStoreNo = parseInt(data.length);
                        }
                        LoadPOSByStoreNo($('#sel-store-no').val());
                    }
                },
                error: function ()
                {
                        toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadComboxStoreByServer(ipServer) {
            //debugger
            $("#sel-store-no").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            loading.showloading();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data != null)
                    {
                        if (data.length == 1)
                        {
                            var html = "<option value='" + data[0].SiteNo + "'>" + data[0].DisplayComboSite + "</option>";
                            $('#sel-store-no').html(html);
                            _countStoreNo = parseInt(data.length);
                        }
                        else if (data.length > 1)
                        {
                            var html = "<option value=\"\" selected>Tất cả</option>";
                            data.forEach((name, i) =>
                            {
                                if (name.SiteNo != "")
                                {
                                    html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                                }
                            });
                            $('#sel-store-no').html(html);
                            _countStoreNo = parseInt(data.length);
                        }
                    }
                    LoadPOSByStoreNo($('#sel-store-no').val());
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

    function setSelectedRow() {
        //debugger
        var _checkStore = $('#param-store-no').val();
        var _storeName = $('#param-store-name').val();
        $('#tbl-store-list tbody').find('input[type="checkbox"]:checked').each(function ()
        {
            var storeNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
            if (_checkStore == storeNo)
            {
                // Khóa món: Màu đỏ
                var html1 = '<span style="font-weight:400;display: block;text-align:left;"><span style="font-weight:700;color:#ea4335;">Lock board:</span>' + _storeName + '</span>';
                $(this).parents('tr').find('td:nth-child(4)').empty();          // clear old data
                $(this).parents('tr').find('td:nth-child(4)').append(html1);    // add new data

                // Khóa món: Màu đỏ
                var html2 = '<a type="button" class=\"btn-unlock-product\" style="color:#fff;text-align:center;cursor:pointer;width:25px;height:25px; background-color:#fff; border: 2px solid #349edc;" id="btn-unlock-product" data-toggle="tooltip" data-placement="left" title="Mở khóa món" data-store-no="' + _checkStore + '"><i class="fa fa-lock" style="color:#EA4335;"></i></a>';
                $(this).parents('tr').find('td:nth-child(6)').empty();          // clear old data
                $(this).parents('tr').find('td:nth-child(6)').append(html2);    // add new data

                //event
                $('.btn-unlock-product').click(function () {
                        $('#tbl-unlock-product tbody').empty();
                        var _storeNo = $(this).attr("data-store-no");
                        $('#hdd-txt-store-no').val(_storeNo);

                        $('#modal-unlock-product').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                });

            }
        });
    };

    function setSelectedRowByUnlock() {
        var _checkStore = $('#param-store-no').val();
        var _storeName = $('#param-store-name').val();
        $('#tbl-store-list tbody').find('input[type="checkbox"]:checked').each(function ()
        {
            var storeNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
            if (_checkStore == storeNo)
            {
                var html1 = '<span style="font-weight:400;display: block;text-align:left;">' + _storeName + '</span>';
                $(this).parents('tr').find('td:nth-child(4)').empty();          // clear old data
                $(this).parents('tr').find('td:nth-child(4)').append(html1);    // add new data

                // Màu xanh
                var html2 = '<a type="button" class=\"btn-unlock-product\" style="color:#fff;text-align:center;cursor:pointer;width:25px;height:25px; background-color:#fff; border: 2px solid #349edc;" id="btn-unlock-product" data-toggle="tooltip" data-placement="left" title="Mở khóa món" data-store-no="' + _checkStore + '"><i class="fa fa-unlock" style="color:#058EC2;"></i></a>';
                $(this).parents('tr').find('td:nth-child(6)').empty();          // clear old data
                $(this).parents('tr').find('td:nth-child(6)').append(html2);    // add new data

                // Event
                $('.btn-unlock-product').click(function ()
                {
                    $('#tbl-unlock-product tbody').empty();
                    var _storeNo = $(this).attr("data-store-no");
                    $('#hdd-txt-store-no').val(_storeNo);

                    $('#modal-unlock-product').modal({
                        backdrop: 'static',
                        keyboard: false
                    });

                });
            }
        });
    };

    function GetDataRowStore() {
        var data = [];
        $('#tbl-store-list tbody').find('input[type="checkbox"]:checked').each(function ()
        {
            var item = {};
            var _storeNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
            var _storeName = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();

            if (_storeNo != null && _storeNo != "" && _storeName != null && _storeName.trim() != "")
            {
                item['StoreNo'] = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                item['StoreName'] = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                data.push(item);
            }
        });
        return data;
    };

    function GetDataRowProduct() {
        var data = [];
        $('#tbl-product-list tbody').find('input[type="checkbox"]:checked').each(function ()
        {
            var item = {};
            var _itemNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
            if (_itemNo != null && _itemNo != "")
            {
                item['ItemNo'] = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                item['ItemName'] = $(this).parents('tr').find('td:nth-child(4)').find('span:nth-child(1)').html();
                item['UnitOfMeasure'] = $(this).parents('tr').find('td:nth-child(5)').find('span:nth-child(1)').html();
                item['Status'] = $(this).parents('tr').find('td:nth-child(7)').html();
                data.push(item);
            }
        });
        return data;
    };

    function GetDataRowProductForAPI() {
        var data = [];
        $('#tbl-product-list tbody').find('input[type="checkbox"]:checked').each(function () {
            var item = {};
            var _itemNo = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
            if (_itemNo != null && _itemNo != "") {
                item['ItemId'] = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();
                item['AvailableStatus'] = "UNAVAILABLE";
                data.push(item);
            }
        });
        return data;
    };

