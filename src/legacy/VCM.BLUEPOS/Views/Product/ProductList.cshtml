@using VCM.BLUEPOS.Model.Product;
@{
    ViewBag.Title = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh mục sản phẩm</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center"></div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportProductList", "Product", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mã sản phẩm / Mã cha</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-no" name="ItemNo" placeholder="Nhập mã sản phẩm/mã cha"/>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Tên sản phẩm</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-name" name="ItemName" placeholder="Nhập tên sản phẩm"/>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Barcode</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-barcode" name="BarcodeNo" placeholder="Nhập mã barcode"/>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-12 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important;">Thuế suất</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="txt-tax-code" name="TaxCode">
                                                <option value="" selected>All</option>
                                                <option value="4">10%</option>
                                                <option value="5">8%</option>
                                                <option value="3">5%</option>
                                                <option value="2">0%</option>
                                                <option value="6">Non Tax</option>
                                            </select>
                                        </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary" name="btnSearch"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-product-list" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Mã sản phẩm</th>
                                    <th>Mã sản phẩm PLG</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Tên sản phẩm (tiếng việt)</th>
                                    <th>Đơn vị tính</th>
                                    <th>Barcode</th>
                                    <th>ĐVT Barcode</th>
                                    <th>Thuế suất</th>
                                    <th>Mã cha</th>
                                    <th>Size</th>
                                    @*<th>CommonItemNo</th>
                                    <th>ItemFamilyCode</th>*@
                                    <th>Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">

        $('#txt-item-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });
        
        $('#txt-item-name').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });
 
        $('#txt-barcode').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-tax-code').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });


        $(document).ready(function () {
            var table = "";
            table = $('#tbl-product-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("GetProductList", "Product")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemName = $('#txt-item-name').val();
                        d.ItemNo = $('#txt-item-no').val();
                        d.BarcodeNo = $('#txt-barcode').val();
                        d.TaxCode = $('#txt-tax-code').val();
                    }
                },

                columns: [

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ItemNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ItemNo + '</span>';
                        }
                    },

                    {
                        data: "ItemNo_PLG",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;color:#0C713D;">' + row.ItemNo_PLG + '</span>';
                        }
                    },

                    {
                        data: "ItemName1",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemName1 + '</span>';
                        }
                    },

                    {
                        data: "ItemName2",  // tên tiếng việt
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemName2 + '</span>';
                        }
                    },

                    {
                        data: "SalesUnit",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.SalesUnit + '</span>';
                        }
                    },

                    {
                        data: "BarcodeNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.BarcodeNo + '</span>';
                        }
                    },

                    {
                        data: "BarcodeUnit",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.BarcodeUnit + '</span>';
                        }
                    },
                    
                    {
                        data: "TaxGroupCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;color:#0C713D;">' + row.TaxGroupCode + '</span>';
                        }
                    },

                    {
                        data: "ParentCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ParentCode + '</span>';
                        }
                    },

                    {
                        data: "Size",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.Size + '</span>';
                        }
                    },

                    //{
                    //    data: "CommonItemNo",
                    //    className: 'text-center',
                    //    render: function (data, type, row) {
                    //        return '<span style="display: block; font-weight: 700;">' + row.CommonItemNo + '</span>';
                    //    }
                    //},

                    //{
                    //    data: "ItemFamilyCode",
                    //    className: 'text-center',
                    //    render: function (data, type, row) {
                    //        return '<span style="display: block; font-weight: 400;">' + row.ItemFamilyCode + '</span>';
                    //    }
                    //},

                    {
                        data: "LastDateModifiedStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.LastDateModifiedStr + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });

            $('[data-toggle="tooltip"]').tooltip();

            $("#btn-search").on("click", function (e) {
                table.draw();
            });

            $("#btn-export-excel").on("click", function (e) {
                $('#frm-export-excel').submit();
            });


    });

    </script>
}




