@using VCM.BLUEPOS.Model.Invoice;

@{
    ViewBag.Title = "Khách hàng xuất hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var model = Model as ViewMngInvoiceModel;
    var lstStore = model.ListStore;
    var listType = model.ListInvoiceType;
    var listInvoicePattern = model.ListInvoicePattern;
    var listInvoiceSerial = model.ListInvoiceSerial;
    var listSet = model.SetDB;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hóa đơn điện tử</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Khách hàng xuất hóa đơn</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        @using (Html.BeginForm("ExportExcelInvoiceTmp", "Invoice", FormMethod.Get, new { @id = "frmExcel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label style="font-weight:bold">Vùng set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSetDB" name="SetDB">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Cửa hàng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                            @if (lstStore != null && lstStore.Count() > 0)
                                            {
                                                if (lstStore.Count == 1)
                                                {
                                                    var ht = $"{lstStore.FirstOrDefault().SiteNo} : {lstStore.FirstOrDefault().SiteName}";
                                                    <option value="@lstStore.FirstOrDefault().SiteNo" data-array="@lstStore.FirstOrDefault().ValueJson">@ht</option>
                                                }
                                                else
                                                {
                                                    <option value="-">Tất cả</option>
                                                    foreach (var item in lstStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : (item.SiteNo + ":" + item.SiteName);
                                                        <option value="@item.SiteNo" data-array="@item.ValueJson">@storeName</option>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <option value="Not" data-array="Not">Không tìm thấy cửa hàng</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Từ ngày</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Đến ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="margin-top:-15px;">

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="display:none;">
                                    <label style="font-weight:bold">Phương thức phát hành</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sl-type-publish" name="TypePublish">
                                            <option value="MTT" selected>Hóa đơn MTT</option>
                                            <option value="GTGT">Hóa đơn GTGT</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Mã số thuế</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtMST" name="MST" />
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-text-search" name="TextSearch" placeholder="số đơn hàng; tên khách hàng; tên công ty; số điện thoại" />
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="padding-top:27px;">
                                    <button type="button" class="btn btn-primary" id="btnSearch" style="color:#fff;cursor:pointer;"><i class="fa fa-search"></i> Tìm</button>
                                    <button type="submit" class="btn btn-success" id="btnExport" style="color:#fff;cursor:pointer;"><i class="fa fa-file-excel"></i> Xuất Excel</button>
                                </div>
                            </div>

                            <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <table class="table table-bordered table-hover text-nowrap" id="tblData">
                                        <thead>
                                            <tr style="text-align:center">
                                                <th>#</th>
                                                <th>Cửa hàng</th>
                                                <th>Khách Hàng</th>
                                                <th>MST</th>
                                                <th>Số điện thoại</th>
                                                <th>Email</th>
                                                <th>Công ty</th>
                                                <th>Địa chỉ</th>
                                                <th>Ngày xuất hóa đơn</th>
                                                <th>Số đơn hàng</th>
                                                <th>Tổng số tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="modalUpdateInfoVAT" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">CẬP NHẬT THÔNG TIN XUẤT HÓA ĐƠN</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="loadDataInfoVAT"></div>
            <div class="modal-footer">
                <button type="button" id="btnUpdateInfoVAT" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Cập nhật</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $("#btnSearch").on("click", function (e) {
                table.search(this.value).draw();
            });

            LoadData();

            $("#frmExcel").submit(function (e) {
                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                var url = "/Invoice/ExportExcelInvoiceTmp?" + $(this).serialize();
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "CustomerVAT_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });

            $("#slSetDB").on("change", function (e) {
                LoadComboxStoreByServer($("#slSetDB").val());
            });

            $("#btnUpdateInfoVAT").on("click", function (e) {
                //debugger
                var tenKH = $("#txtUpdCustomerName").val();
                var mst = $("#txtUpdTaxCode").val();
                var soDT = $("#txtUpdPhoneNumber").val();
                var email = $("#txtUpdEmail").val();
                var tenCty = $("#txtUpdCompanyName").val();
                var diachi = $("#txtUpdAddress").val();
                var storeNo = $("#txtUpdStoreNo").val();
                var orderNo = $("#txtUpdOrderNo").val();
                var ipServer = $("#slSetDB").val();

                // alert(tenKH + "|" + mst + "|" + dienThoai + "|" + email + "|" + congTy + "|" + diaChi + "|" + storeNo);

                if (tenKH == "" || tenKH.length == 0) {
                    toastr.error("Chưa nhập tên khách hàng");
                    return;
                }
                if (tenKH.length > 100) {

                    toastr.error("Tên khách hàng không vượt quá 100 ký tự");
                    return;
                }

                if (tenCty != "" || tenCty.length != 0) {

                    if (diachi == "" || diachi.length == 0) {
                        toastr.error("Chưa nhập địa chỉ");
                        return;
                    }
                }

                if (mst != "" || mst.length != 0) {
                    if (tenCty == "" || tenCty.length == 0) {
                        toastr.error("Chưa nhập tên công ty");
                        return;
                    }

                    if (diachi == "" || diachi.length == 0) {
                        toastr.error("Chưa nhập địa chỉ");
                        return;
                    }
                }

                if (email == "" || email.length == 0) {
                    toastr.error("Chưa nhập địa chỉ email");
                    return;
                }

                if (email != "" || email.length > 0) {
                    var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                    if (!filter.test(email)) {
                        toastr.error("Định dạng email không đúng");
                        return;
                    }
                }

                if (soDT != "" || soDT.length > 0) {

                    var filter = /^\d+$/;
                    if (!filter.test(soDT)) {
                        toastr.error("Định dạng số điện thoại không đúng");
                        return;
                    }
                }

                loading.showloading();
                var fromData = new FormData();
                fromData.append('SiteNo', storeNo);
                fromData.append('IPServer', ipServer);
                fromData.append('CustomerName', tenKH);
                fromData.append('CompanyName', tenCty);
                fromData.append('Address', diachi);
                fromData.append('TaxCode', mst);
                fromData.append('PhoneNumber', soDT);
                fromData.append('Email', email);
                fromData.append('OrderNo', orderNo);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("UpdateInfoVAT", "Invoice")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        loading.hideloading();
                        if (data.Status == 200) {
                            table.draw();
                            toastr.success(data.Message);
                            $('#modalUpdateInfoVAT').modal('hide');
                        }
                        else
                        {
                            toastr.error(data.Message);
                        }
                    },
                    error: function () {
                        loading.hideloading();
                    }
                });
            });

        });

        function LoadComboxStoreByServer(ipServer) {
            loading.showloading();
            $("#slSiteNo").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";
                    if (data != null) {
                        if (data.length > 0) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "' data-array='" + name.ValueJson + "'>" + name.DisplayComboSite + "</option>";
                            });
                        }
                        else {
                            html = "<option value='Not' data-array='Not'>Không tìm thấy cửa hàng</option>";
                        }
                    }
                    $('#slSiteNo').html(html);
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function LoadData() {

            table = $('#tblData').DataTable({
                scrollY: "50vh",
                fixedColumns: {
                    leftColumns: 4,
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: true,
                scrollX: true,
                deferLoading: 0,
                
                ajax: {
                    url: '@Url.Action("MngInvoiceTempLoad", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        var listStore = $('#slSiteNo option:selected').attr('data-array');
                        d.StoreNo = listStore;
                        d.SetDB = $("#slSetDB").val();
                        d.TuNgay = $("#searchFromDate").val();
                        d.DenNgay = $("#searchToDate").val();
                        d.Type = $("#sl-type-publish").val();
                        d.CusTaxCode = $("#txtMST").val(); 
                        d.TextSearch = $("#txt-text-search").val();                
                    }
                },

                columns: [  
                    {
                        data: "SiteNo",
                        className: 'text-center',
                        render: function (data, type, full, meta) {
                            var html = "";
                            if (full.IsEdit == 1) {
                                html += "<a onclick=\"ModalUpdate('" + full.SiteNo + "','" + full.OrderNo + "')\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\">";
                                html += "<i class=\"la la-edit\"></i>";
                                html += "</a>";
                            }
                            return html;
                        }
                    },

                    {
                        data: "SiteNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SiteNo == null || row.SiteNo == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.SiteNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CustomerName",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CustomerName == null || row.CustomerName == "") {
                                html += '<span style="font-weight:400;display:block;text-align:left;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display:block;text-align:left;">' + row.CustomerName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "TaxCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.TaxCode == null || row.TaxCode == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.TaxCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PhoneNumber",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PhoneNumber == null || row.PhoneNumber == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.PhoneNumber + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Email"
                    },

                    {
                        data: "CompanyName"
                    },

                    {
                         data: "AddressCus"
                    },

                    {
                        data: "CreatedDate",
                        className: 'text-center',
                        render: function (data, type, full, meta) {
                            if (full.CreatedDate != null) {
                                return moment(full.CreatedDate).format("DD/MM/YYYY HH:mm");
                            }
                            else
                                return "";
                        }
                    },

                    {
                        data: "OrderNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null || row.OrderNo == "") {
                                html += '<span style="font-weight:700;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PrepaymentAmount",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.PrepaymentAmount != null) {
                                html += '<span style="font-weight:700;display:block;text-align:right;">' + parseFloat(row.PrepaymentAmount).toLocaleString('en') + '</span>'; 
                            }
                            else {
                                html += '<span style="font-weight:700;display:block;text-align:right;">' + "" + '</span>'; 
                            }
                            return html;  
                        }
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }      

        function ModalUpdate(storeNo, orderNo) {
            //debugger
            var ipServer = $("#slSetDB").val();
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/Invoice/_ViewUpdateInfoVAT?ipServer=" + ipServer + "&storeNo=" + storeNo + "&orderNo=" + orderNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadDataInfoVAT").html(result);
                    $('#modalUpdateInfoVAT').modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                    loading.hideloading();
                },
                error: function (event) {
                    loading.hideloading();
                }
            });


        }
    </script>
}

