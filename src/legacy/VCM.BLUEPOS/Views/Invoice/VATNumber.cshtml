@using VCM.BLUEPOS.Model.Invoice;
@{
    ViewBag.Title = "Dải hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //var lstBranch = ViewBag.ListBranch as List<BranchModel>;
    var lstNoseri = ViewBag.ListNoseri as List<StoreNoseriVATModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a>Hóa đơn điện tử</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cài đặt hóa đơn</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Dải hóa đơn</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btnAddVATNumber"><i class="la la-plus-circle"></i> Thêm dải hóa đơn</button>

        </div>
    </div>
</div>
<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Loại HĐ</label>
                                <div class="form-group">
                                    <select id="slSearchInvoiceType" class="form-control select2">
                                        <option value="-">Tất cả</option>
                                        <option value="NOR">NOR</option>
                                        <option value="EOD">EOD</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">NoseriCode</label>
                                <div class="form-group">
                                    <select id="slSearchNoseri" class="form-control select2">
                                        @if (lstNoseri != null && lstNoseri.Count() > 0)
                                        {
                                            <option value="-">Tất cả</option>
                                            foreach (var item in lstNoseri)
                                            {
                                                <option value="@item.NoseriCode">@item.NoseriCode</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Not">Không tìm thấy</option>

                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Mẫu số</label>
                                <div class="form-group">
                                    <input type="text" id="searchInvoicePattern" class="form-control searchKeyPress" placeholder="InvoicePattern" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Số seri</label>
                                <div class="form-group">
                                    <input type="text" id="searchSerialNo" class="form-control searchKeyPress" placeholder="SerialNo" />
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">TaxCode</label>
                                <div class="form-group">
                                    <input type="text" id="searchCompTaxCode" class="form-control searchKeyPress" placeholder="CompTaxCode" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12">
                                <label style="font-weight:bold">Trạng thái</label>
                                <div class="form-group">
                                    <select id="slSearchEnable" class="form-control select2">
                                        <option value="-">Tất cả</option>
                                        <option value="1">Hiệu lực</option>
                                        <option value="0">Hết hiệu lực</option>

                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12" style="margin-top:25px">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tblData" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>STT</th>
                                    <th>CHI NHÁNH</th>
                                    <th>MST</th>
                                    <th>NOSERI CODE</th>
                                    <th>MẪU SỐ</th>
                                    <th>SERIALNO</th>
                                    <th>BẮT ĐẦU</th>
                                    <th>KẾT THÚC</th>
                                    <th>STATUS</th>
                                    <th>NGÀY CẬP NHẬT</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalAddVATNumber" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cập nhật dải hóa đơn</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Loại hóa đơn</label>
                            <select id="slInvoiceType" class="form-control select2">
                                <option value="NOR">NOR</option>
                                <option value="EOD">EOD</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">NoseriCode</label>
                            <select id="slNoseriCode" class="form-control select2" data-placeholder=""></select>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Mẫu số</label>
                            <input type="text" id="txtInvoicePattern" class="form-control" value="" />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">SerialNo</label>
                            <input type="text" id="txtSerialNo" class="form-control" value="" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">MST</label>
                            <input type="text" id="txtCompTaxCode" class="form-control" value="" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Hiệu lực</label>
                            <select id="slStatus" class="form-control select2 select2-blue" data-placeholder="">
                                <option value="1">Có hiệu lực</option>
                                <option value="0">Hết hiệu lực</option>
                            </select>
                        </div>
                    </div>

                </div>

            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Cập nhật</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            LoadData();

            $("#slSearchInvoiceType").on("change", function (e) {
                //debugger
                var invoiceType = $("#slSearchInvoiceType").val();
                LoadNoseriByInvoiceType(invoiceType);
            });

            $("#btnSearch").on("click", function (e) {
                //debugger
                table.search(this.value).draw();
            });

            $('.searchKeyPress').keypress(function (e) {
                var key = e.which;
                if (key == 13) {
                    table.search(this.value).draw();
                }
            });

            $("#slInvoiceType").on("change", function (e) {
                //debugger
                var invoiceType = $("#slInvoiceType").val();
                LoadNoseriByInvoiceTypeModal(invoiceType);              
            });

            $("#slNoseriCode").on("change", function (e) {               
                var dataMST = $(this).find(':selected').data('comptaxcode');
                $("#txtCompTaxCode").val(dataMST);
            });

            $("#btnAddVATNumber").on("click", function (e) {
                var invoiceType = $("#slInvoiceType").val();
                LoadNoseriByInvoiceTypeModal(invoiceType);
                $("#txtInvoicePattern").val('');
                $("#txtSerialNo").val('');

                //$("#txtInvoicePattern").attr('disabled', false);       
                //$("#txtSerialNo").attr('disabled', false);       

                $("#slNoseriCode").attr('disabled', false);             
                $("#slInvoiceType").attr('disabled', false);

                $('#modalAddVATNumber').modal({
                    backdrop: 'static',
                    keyboard: false
                });

            });

            $("#slBranch").on("change", function (e) {
                LoadNoseriByInvoiceType($(this).val());
            });

            $("#btnSave").on("click", function (e) {
                SaveVATNumber();
            });
        });

        function SaveVATNumber() {
            var compTaxCode = $("#txtCompTaxCode").val();
            var noseriCode = $("#slNoseriCode").val();
            var status = $("#slStatus").val();
            var invoicePattern = $("#txtInvoicePattern").val();
            var serialNo = $("#txtSerialNo").val();

            if (compTaxCode == "" || compTaxCode == null) {
                toastr.error("Không lấy được MST");
                return;
            }
            if (noseriCode == "" || noseriCode == null) {
                toastr.error("Chọn noseriCode");
                return;
            }
            if (invoicePattern == "" || invoicePattern == null) {
                toastr.error("Nhập invoicePattern");
                return;
            }
            if (serialNo == "" || serialNo == null) {
                toastr.error("Nhập serialNo");
                return;
            }

            loading.showloading();

            var fromData = new FormData();
            fromData.append('CompTaxCode', compTaxCode);
            fromData.append('NoseriCode', noseriCode);
            fromData.append('InvoicePattern', invoicePattern);
            fromData.append('SerialNo', serialNo);
            fromData.append('Status', status);

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateVATNumber", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    debugger
                    if (data.Status == 200) {
                        toastr.success("Cập nhật thành công dải hóa đơn");
                        table.draw();
                        $('#modalAddVATNumber').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }

                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });

        }

        function ModalUpdate(invoiceType, noseriCode, invoicePattern, serialNo, status) {
            //debugger
            var splitType = noseriCode.split("-");
            var loaiHD = splitType[1];

            var enable = status == true ? "1" : "0";
            LoadNoseriByInvoiceTypeModal(loaiHD);
            $("#slNoseriCode").select2('val', [noseriCode]);
            $("#slInvoiceType").select2('val', [loaiHD]);
            $("#slStatus").select2('val', [enable]);

            $("#txtInvoicePattern").val(invoicePattern);
            $("#txtSerialNo").val(serialNo);

            $("#slNoseriCode").attr('disabled', true);
            $("#slInvoiceType").attr('disabled', true);
            $("#txtInvoicePattern").attr('disabled', true);
            $("#txtSerialNo").attr('disabled', true);  

            $('#modalAddVATNumber').modal({
                backdrop: 'static',
                keyboard: false
            });
        }
        function LoadNoseriByInvoiceType(invoiceType) {
            $("#slSearchNoseri").empty();
            var fromData = new FormData();
            fromData.append('invoiceType', invoiceType);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadNoseriByType", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";

                    if (data != null && data.length > 0) {
                        html += "<option value='-'>Tất cả</option>";
                        data.forEach((name, i) => {
                            debugger
                            html += "<option value='" + name.NoseriCode + "'>" + name.NoseriCode + "</option>";
                        });
                    }
                    $('#slSearchNoseri').html(html);
                },
                error: function () {

                }
            });

        }
        function LoadNoseriByInvoiceTypeModal(invoiceType) {
            $("#slNoseriCode").empty();
            var fromData = new FormData();
            fromData.append('invoiceType', invoiceType);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadNoseriByType", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";

                    if (data != null && data.length > 0) {
                        data.forEach((name, i) => {
                            debugger
                            html += "<option value='" + name.NoseriCode + "' data-comptaxcode='" + name.CompTaxCode + "'>" + name.NoseriCode + "</option>";
                        });
                    }
                    $('#slNoseriCode').html(html);

                    var dataMST = $('#slNoseriCode').find(':selected').data('comptaxcode');
                    $("#txtCompTaxCode").val(dataMST);
                },
                error: function () {

                }
            });
        }
        function LoadData() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: true, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("VATNumberLoad", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.InvoiceType = $("#slSearchInvoiceType").val();
                        d.NoseriCode = $("#slSearchNoseri").val();
                        d.InvoicePattern = $("#searchInvoicePattern").val();
                        d.SerialNo = $("#searchSerialNo").val();
                        d.Enabled = $("#slSearchEnable").val();
                        d.CompTaxCode = $("#searchCompTaxCode").val();

                        



                    }
                },

                columns: [
                    {
                        data: "ID",
                        "className": "text-center",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "BranchName"
                    }, {
                        data: "CompTaxCode",
                        className: 'text-center'

                    },
                    {
                        data: "NoseriCode",
                        className: 'text-center'

                    },
                    {
                        data: "InvoicePattern",
                        className: 'text-center'

                    },
                    {
                        data: "SerialNo",
                        className: 'text-center'

                    },
                    {
                        data: "StartNumber",
                        className: 'text-center'

                    }, {
                        data: "EndNumber",
                        className: 'text-center'

                    },
                    {
                        data: "Enabled",
                        render: function (data, type, row) {

                            var html = "";
                            if (row.Enabled == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Có hiệu lực</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>";
                            }
                            return html;
                        },
                        className: 'text-center'

                    },
                    {
                        data: "CreateDate",
                        render: function (data, type, full, meta) {
                            if (full.LastUpdate != null) {
                                return moment(full.LastUpdate).format("DD/MM/YYYY HH:mm");
                            }
                            else {
                                if (full.CreateDate != null) {
                                    return moment(full.CreateDate).format("DD/MM/YYYY HH:mm");
                                }
                                else
                                    return "";
                            }
                        },
                        className: 'text-center'
                    },
                    {
                        data: "ID",
                        render: function (data, type, full, meta) {
                            var html = "";
                            var invoiceType = full.InvoiceType;
                            var noseriCode = full.NoseriCode;
                            var serialNo = full.SerialNo;
                            var invoicePattern = full.InvoicePattern;
                            html += "<a onclick=\"ModalUpdate('" + invoiceType+"','" + noseriCode + "','" + invoicePattern + "','" + serialNo + "'," + full.Enabled + ")\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\">";
                            //html += "<a href=\"javascript:;\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\" data-toggle=\"dropdown\">";
                            html += "<i class=\"la la-edit\"></i>";
                            html += "<span class=\"pulse-ring\"></span>";
                            html += "</a>";

                            //html += "<div class=\"dropdown-menu dropdown-menu-sm dropdown-menu-right\">";
                            //html += "<ul class=\"nav nav-hoverable flex-column\">";
                            //html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ModalUpdate('" + full.TypeLogin + "','" + full.UserName + "')\"><i class=\"nav-icon la la-edit\"></i><span class=\"nav-text\">Sửa phân quyền</span></a></li>";
                            //html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ModalStore('" + full.UserName + "')\"><i class=\"nav-icon la la-database\"></i><span class=\"nav-text\">List CH/ST</span></a></li>";
                            //if (full.TypeLogin == "LOCAL") {
                            //    html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"ViewPass('" + full.UserName + "')\"><i class=\"nav-icon la la-eye\"></i><span class=\"nav-text\">Xem mật khẩu</span></a></li>";
                            //}
                            //html += "</ul>";
                            //html += "</div>";

                            return html;
                        },
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }

    </script>
}
