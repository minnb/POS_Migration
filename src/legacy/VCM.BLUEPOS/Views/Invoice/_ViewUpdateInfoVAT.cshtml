
@using VCM.BLUEPOS.Model.Invoice
@{
    var model = Model as InvoiceCreatedModel;
}

@if (model != null && !string.IsNullOrEmpty(model.OrderNo))
{
    var tenKH = model.CustomerName;
    var tenCTy = model.CompanyName;
    var mst = model.TaxCode;
    var phoneNumber = model.PhoneNumber;
    var email = model.Email;
    var diachi = model.Address;
    var storeNo = model.SiteNo;
    var orderNo = model.OrderNo;
    var disableMST = string.IsNullOrEmpty(mst) ? "" : "disabled";

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <div class="form-group">
                <label style="font-weight:bold">MST</label>
                <input type="text" id="txtUpdTaxCode" class="form-control" value="@mst" @disableMST />
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <div class="form-group">
                <label style="font-weight:bold">Tên khách hàng</label>
                <input type="text" id="txtUpdCustomerName" class="form-control" value="@tenKH" />
            </div>
        </div>


        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <div class="form-group">
                <label style="font-weight:bold">Điện thoại</label>
                <input type="text" id="txtUpdPhoneNumber" class="form-control" value="@phoneNumber" />
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
            <div class="form-group">
                <label style="font-weight:bold">Email</label>
                <input type="text" id="txtUpdEmail" class="form-control" value="@email" />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label style="font-weight:bold">Tên công ty</label>
                <input type="text" id="txtUpdCompanyName" class="form-control" value="@tenCTy" />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label style="font-weight:bold">Địa chỉ</label>
                <input type="text" id="txtUpdAddress" class="form-control" value="@diachi" />
            </div>
        </div>
    </div>



    <input type="hidden" id="txtUpdStoreNo" class="form-control" value="@storeNo" />
    <input type="hidden" id="txtUpdOrderNo" class="form-control" value="@orderNo" />

}
