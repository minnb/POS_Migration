@using VCM.BLUEPOS.Model.Invoice;

@{
    ViewBag.Title = "KH định danh xuất hóa đơn MTT";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var model = Model as ViewMngInvoiceModel;

    var lstStore = model.ListStore;
    var listType = model.ListInvoiceType;
    var listInvoicePattern = model.ListInvoicePattern;
    var listInvoiceSerial = model.ListInvoiceSerial;
    var listSet = model.SetDB;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Báo cáo Thuế - Hóa đơn</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>KH định danh xuất hóa đơn MTT</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        @using (Html.BeginForm("ExportCustomerInfoInvoiceMTT", "Invoice", FormMethod.Get, new { @id = "frmExcel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                    <label style="font-weight:bold">Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="slSetDB" name="SetDB">
                                            @if (listSet != null && listSet.Count > 0)
                                            {

                                                if (listSet.Count == 1)
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer">@listSet.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSet)
                                                    {
                                                        <option value="@item.IPServer">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Cửa hàng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                            @if (lstStore != null && lstStore.Count() > 0)
                                            {
                                                if (lstStore.Count == 1)
                                                {
                                                    var ht = $"{lstStore.FirstOrDefault().SiteNo} : {lstStore.FirstOrDefault().SiteName}";
                                                    <option value="@lstStore.FirstOrDefault().SiteNo" data-array="@lstStore.FirstOrDefault().ValueJson">@ht</option>
                                                }
                                                else
                                                {
                                                    <option value="-">Tất cả</option>
                                                    foreach (var item in lstStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : (item.SiteNo + ":" + item.SiteName);
                                                        <option value="@item.SiteNo" data-array="@item.ValueJson">@storeName</option>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <option value="Not" data-array="Not">Không tìm thấy cửa hàng</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Từ ngày</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Đến ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="margin-top:-15px;">
                                <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Mã số thuế</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtMST" name="MST" />
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 mb-1">
                                    <label style="font-weight:bold">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-text-search" name="TextSearch" placeholder="Nhập số hóa đơn;số đơn hàng;số điện thoại;tên công ty;tên khách hàng" />
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1" style="margin-top:25px;">
                                    <button type="button" class="btn btn-primary" id="btnSearch" style="color:#fff;cursor:pointer;"> <i class="fa fa-search"></i> Tìm</button>
                                    <button type="submit" class="btn btn-success" id="btnExport" style="color:#fff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                </div>
                            </div>

                            <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
                            
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <table class="table table-bordered table-hover text-nowrap" id="tblData">
                                        <thead>
                                            <tr style="text-align:center">
                                                <th>#</th>
                                                <th>Mã cửa hàng</th>
                                                <th>Khách hàng</th>
                                                <th>MST</th>
                                                <th>Số ĐT</th>
                                                <th>Email</th>
                                                <th>Công ty</th>
                                                <th>Địa chỉ</th>
                                                <th>Mẫu số</th>
                                                <th>Ký hiệu</th>
                                                <th>Số hóa đơn</th>
                                                <th>Loại hóa đơn</th>
                                                <th>Ngày xuất HĐ</th>
                                                <th>Ngày phát hành</th>
                                                <th>Hình thức</th>
                                                <th>Thay thế / điều chỉnh</th>
                                                <th>Số đơn hàng</th>
                                                <th>Tổng số tiền</th>
                                                <th>Mã CQT</th>
                                                <th>Key</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {

            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            LoadData();

            $("#slSetDB").on("change", function (e) {
                LoadComboxStoreByServer($("#slSetDB").val());
            });

            $("#btnSearch").on("click", function (e) {
                table.search(this.value).draw();
            });

            $("#frmExcel").submit(function (e) {
                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                var url = "/Invoice/ExportCustomerInfoInvoiceMTT?" + $(this).serialize();
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {
                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "InfoCustomerByInvoiceCash_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });

        });

        function LoadComboxStoreByServer(ipServer) {
            loading.showloading();
            $("#slSiteNo").empty();
            var fromData = new FormData();
            fromData.append('IPServer', ipServer);
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreBySetServerIP", "Common")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    var html = "";
                    if (data != null) {
                        if (data.length > 0) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.SiteNo + "' data-array='" + name.ValueJson + "'>" + name.DisplayComboSite + "</option>";
                            });
                        }
                        else {
                            html = "<option value='Not' data-array='Not'>Không tìm thấy cửa hàng</option>";
                        }
                    }
                    $('#slSiteNo').html(html);
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function LoadData() {
            table = $('#tblData').DataTable({
                scrollY: "50vh",
                fixedColumns: {
                    leftColumns: 4,
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: true,
                scrollX: true,
                deferLoading: 0,

                ajax: {
                    url: '@Url.Action("GetCustomerInfoByInvoiceMTT", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        var listStore = $('#slSiteNo option:selected').attr('data-array');
                        d.StoreNo = listStore;
                        d.SetDB = $("#slSetDB").val();
                        d.TuNgay = $("#searchFromDate").val();
                        d.DenNgay = $("#searchToDate").val();
                        d.CusTaxCode = $("#txtMST").val(); 
                        d.TextSearch = $("#txt-text-search").val();
                    }
                },

                columns: [  
                    {
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            var stt = meta.row + 1 + start;
                            return stt;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.StoreNo == null || row.StoreNo == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.StoreNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CusName",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CusName == null || row.CusName == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.CusName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CusTaxCode",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CusTaxCode == null || row.CusTaxCode == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.CusTaxCode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CusPhone",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CusPhone == null || row.CusPhone == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.CusPhone + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Email",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Email == null || row.Email == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.Email + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CusCom",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CusCom == null || row.CusCom == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.CusCom + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "AddressCus",  // dia chi
                        render: function (data, type, row) {
                            var html = "";
                            if (row.AddressCus == null || row.AddressCus == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.AddressCus + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "InvoicePattern",  // mau so,
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.InvoicePattern == null || row.InvoicePattern == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.InvoicePattern + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "SerialNo",  // ky hieu,
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SerialNo == null || row.SerialNo == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.SerialNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "InvoiceNo",  // so hoa don
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.InvoiceNo == null || row.InvoiceNo == "") {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;">' + row.InvoiceNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "InvoiceTypeName", // loai hoa don,
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.InvoiceTypeName == null || row.InvoiceTypeName == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.InvoiceTypeName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ArisingDate",  // ngày xuất HĐ
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.ArisingDate == null || row.ArisingDate == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.ArisingDate + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "CreateDate",  // ngay phat hanh
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.CreateDate == null || row.CreateDate == "") {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;padding-top:8px;display:block;">' + row.CreateDate + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "HinhThuc",  // hình thuc
                        className: 'text-center'
                    },

                    {
                        data: "Remark",  // thay the/dieu chinh
                        className: 'text-center'
                    },

                    {
                        data: "OrderNo",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OrderNo == null || row.OrderNo == "") {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;text-align:center;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;padding-top:8px;display:block;text-align:center;">' + row.OrderNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Amount",
                        render: function (data, type, row) {
                            var html = '<span style="display: block; padding-top: 8px; text-align:right;font-weight:700;">' + parseFloat(row.Amount).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "BillTaxCode",  // ma CQT
                        className: 'text-center'
                    },

                    {
                        data: "Key"
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }      


    </script>
}

