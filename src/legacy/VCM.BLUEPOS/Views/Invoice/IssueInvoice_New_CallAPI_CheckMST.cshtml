        function Print() {
            //debugger
            $('#btnPrint').prop('disabled', true);
            var storeNo = $("#slSiteNo").val();
            var notVAT = $("#slSiteNo option:selected").attr("data-notvat");//HF
            var hoaDon = $("#txtHoaDon").val();
            var ten = $("#txt-customer-name").val();
            var tenCty = $("#txt-company-name").val();
            var soDT = $("#txt-phone-number").val();
            var email = $("#txt-email").val();
            var mst = $("#txt-tax-code").val();
            var diachi = $("#txt-address").val();

            if (storeNo == "" || storeNo.length == 0) {
                $('#btnPrint').prop('disabled', false);
                toastr.error("Bạn chưa được phân quyền vào cửa hàng");
                return;
            }

            if (hoaDon == "" || hoaDon.length == 0) {
                $('#btnPrint').prop('disabled', false);
                $('#txtHoaDon').focus();
                toastr.error("Chưa nhập hóa đơn");
                return;
            }

            if (email == "" || email.length == 0) {
                $('#btnPrint').prop('disabled', false);
                $('#txt-email').focus();
                toastr.error("Chưa nhập địa chỉ email");
                return;
            }

            /*
             Fix: 01/11/2022, theo yeu cau cua ke toan 
