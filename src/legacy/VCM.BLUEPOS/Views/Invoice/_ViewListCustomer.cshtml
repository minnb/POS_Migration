
<div class="row">

    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="margin-bottom: 0 !important;">Tên khách hàng</label>
        <div class="form-group">
            <input type="text" id="txtSearchTenKH" placeholder="Tên khách hàng" class="form-control cusEvent">
        </div>
    </div>
    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="margin-bottom: 0 !important;">Số điện thoại</label>
        <div class="form-group">
            <input type="text" id="txtSearchSoDT" placeholder="Nhập số điện thoại" class="form-control cusEvent">
        </div>
    </div>
    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="margin-bottom: 0 !important;">Mã số thuế</label>
        <div class="form-group">
            <input type="text" id="txtSearchMST" placeholder="Nhập mã số thuế" class="form-control cusEvent">
        </div>
    </div>

</div>
<div class="row" style="margin-top:-15px;">
    <div class="col-lg-10 col-md-6 col-sm-12 col-xs-12 mb-1">
        <label style="margin-bottom: 0 !important;">Công ty</label>
        <div class="form-group">
            <input type="text" id="txtSearchCongTy" placeholder="Nhập tên công ty" class="form-control cusEvent">
        </div>
    </div>

    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
        <button type="button" class="btn btn-primary" id="btnSearchCus" style="color: #ffffff;cursor:pointer;margin-top: 20px;"> <i class="fa fa-search"></i> Tìm kiếm</button>
    </div>
</div>
<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1 card-body table-responsive">
        <table class="table table-bordered table-striped" id="tblDataCus" style="width:100%">
            <thead>
                <tr style="text-align:center;background-color:#a7d0f9">
                    <th style="min-width:150px">Tên KH</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th style="max-width:250px">Địa chỉ</th>
                    <th>MST</th>
                    <th style="max-width:250px">Công ty</th>
                    <th style="text-align:center;width:90px;">#</th>

                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

</div>

<script type="text/javascript">  
    var table2 = "";
    var loadData = false;

    $(document).ready(function () {
        $("#btnSearchCus").on("click", function (e) {
            //debugger
            LoadCustomer();
            //table2.search(this.value).draw();
        });

        var ten = $("#txtTen").val();
        var tenSearch = $("#txtSearchTenKH").val();
        if (ten != "" && tenSearch == "") {
            loadData = true;
            $("#txtSearchTenKH").val(ten);
        }       

        var sodt = $("#txtDienThoai").val();
        var sodtSearch = $("#txtSearchSoDT").val();
        if (sodt != "" && sodtSearch == "") {
            loadData = true;
            $("#txtSearchSoDT").val(sodt);
        }
      
        var mst = $("#txtMST").val();
        var mstSearch = $("#txtSearchMST").val();
        if (sodt != "" && mstSearch == "") {
            loadData = true;
            $("#txtSearchMST").val(mst);
        }     

        var tencty = $("#txtTenCTy").val();
        var tenctySearch = $("#txtSearchCongTy").val();
        if (tencty != "" && tenctySearch == "") {
            loadData = true;
            $("#txtSearchCongTy").val(tencty);
        }
        if (loadData == true) {
            LoadCustomer();
        }

    });

    function LoadCustomer() {

            table2 = $('#tblDataCus').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                drawCallback: function (settings) {

                    $(".chkCus").click(function () {
                        var tenKH = $(this).closest('tr').find('td').eq(0).text();
                        var dienthoai = $(this).closest('tr').find('td').eq(1).text();
                        var email = $(this).closest('tr').find('td').eq(2).text();
                        var diachi = $(this).closest('tr').find('td').eq(3).text();
                        var mst = $(this).closest('tr').find('td').eq(4).text();
                        var congty = $(this).closest('tr').find('td').eq(5).text();

                        $("#txtTen").val(tenKH);
                        $("#txtTenCTy").val(congty);
                        $("#txtMST").val(mst);
                        $("#txtDienThoai").val(dienthoai);
                        $("#txtEmail").val(email);
                        $("#txtDiaChi").val(diachi);

                        $('#modalListCustomer').modal('hide');

                    });
                },

                ajax: {
                    url: '@Url.Action("LoadCustomer", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {

                        var ten = $("#txtTen").val();
                        var tenSearch = $("#txtSearchTenKH").val();
                        if (ten != "" && tenSearch == "") {
                            d.CustomerName = ten;
                            $("#txtSearchTenKH").val(ten);
                        }
                        else {
                            d.CustomerName = tenSearch;
                        }

                        var sodt = $("#txtDienThoai").val();
                        var sodtSearch = $("#txtSearchSoDT").val();
                        if (sodt != "" && sodtSearch == "") {
                            d.PhoneNumber = sodt;
                            $("#txtSearchSoDT").val(sodt);
                        }
                        else {
                            d.PhoneNumber = sodtSearch;
                        }
                        var mst = $("#txtMST").val();
                        var mstSearch = $("#txtSearchMST").val();
                        if (sodt != "" && mstSearch == "") {
                            d.TaxCode = mst;
                            $("#txtSearchMST").val(mst);
                        }
                        else {
                            d.TaxCode = mstSearch;
                        }

                        var tencty = $("#txtTenCTy").val();
                        var tenctySearch = $("#txtSearchCongTy").val();
                        if (tencty != "" && tenctySearch == "") {
                            d.CompanyName = tencty;
                            $("#txtSearchCongTy").val(tencty);
                        }
                        else {
                            d.CompanyName = tenctySearch;
                        }

                       // d.CompanyName = $("#txtSearchCongTy").val();

                        //d.TaxCode = $("#txtSearchMST").val();
                    }
                },
                //createdRow: function (row, data, meta) {
                //    var stt = meta + 1;
                //    $(row).attr('id', "rowRecord" + stt);
                //    $(row).attr('class', "rowRecord");
                //},                
                columns: [
                    {
                        data: "CustomerName"
                    },
                    {
                        data: "PhoneNumber"
                    },
                    {
                        data: "Email"
                    },
                    {
                        data: "Address"
                    },
                    {
                        data: "TaxCode"
                    },
                    {
                        data: "CompanyName"
                    },
                    {
                        data: "TaxCode",                       
                        render: function (data, type, full, meta) {
                            var html = "";
                            html += "<label class=\"checkbox checkbox-lg\">";
                            html += "<input type=\"checkbox\" class=\"chkCus\" name=\"chkCus\" />";
                            html += "<span></span>";
                            html += "</label>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }
</script>

