@using VCM.BLUEPOS.Model.Store;
@{
    ViewBag.Title = "Tạo XML hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = ViewBag.ListSite as List<StoreModel>;
}
<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a>Hóa đơn điện tử</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cài đặt hóa đơn</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Tạo XML hóa đơn</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mb-1">
                                <label style="font-weight:bold">Cửa hàng</label>
                                <div class="form-group">
                                    <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">

                                        @foreach (var item in listSite)
                                        {
                                            var ht = $"{item.StoreNo} : {item.StoreName}";
                                            <option value="@item.StoreNo">@ht</option>
                                        }

                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-1">
                                <label>Nhập FKey<strong style="color:#ff0000"> (*)</strong></label>
                                <div class="form-group">
                                    <input type="text" class="form-control pull-right" style="width:100%;" id="txtFKey" name="FKey" placeholder="Nhập Key" />
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1" style="margin-top:25px">

                                <div class="form-group">
                                    <button type="button" class="btn btn-primary btn-search" style="" onclick="RunWriteXMLFromKey()"><i class="fa fa-print"></i><span id="titleHF"> Tạo file XML </span></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {            

        });

        $('.select2').select2();

        function RunWriteXMLFromKey() {
            var storeNo = $("#slSiteNo").val();
            var fkey = $("#txtFKey").val();
            if (fkey == "" || fkey.length == 0) {
                $('#txtFKey').focus();
                toastr.error("Chưa nhập Key");
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('Key', fkey);
            $.ajax({
                type: "POST",
                url: '@Url.Action("RunWriteXMLFromKey", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger;
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                }
            });
        }
    </script>
}
