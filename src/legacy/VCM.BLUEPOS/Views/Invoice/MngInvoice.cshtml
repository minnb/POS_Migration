            <div class="modal-header">
                <h5 class="modal-title"><span id="titleModel" style="font-weight:bold"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupListInvoice"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
                <button type="button" class="btn btn-primary btn-search" style="" onclick="ReplaceInvoice()" id="btnReplace"><i class="fa fa-save"></i> Đồng ý</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSendMail">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="titleModel" style="font-weight:bold">Chỉnh sửa email hóa đơn</span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupSendMail"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-success font-weight-bold" onclick="SendAndEditEmail()"><i class="la la-mail-bulk"></i>Gửi Email</button>
                <button type="button" class="btn btn-primary btn-search" onclick="EditEmail()"><i class="fa fa-save"></i> Chỉnh sửa email</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetailInvoice">
