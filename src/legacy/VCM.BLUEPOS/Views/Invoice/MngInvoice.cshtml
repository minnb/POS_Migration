        function ReplaceInvoice() {
            var isEOD = $("#hdisEOD").val();
            var storeNo = $("#hdstoreNo").val();
            var key = $("#hdkey").val();
            var fKey = $("#hdfKey").val();
            var ngayPhatHanh = $("#hdngayPhatHanh").val();
            var loaiDieuChinh = $("#hdloaiDieuChinh").val();

            var ten = $("#rep_txtTen").val();
            var tenCty = $("#rep_txtTenCTy").val();
            var soDT = $("#rep_txtDienThoai").val();
            var email = $("#rep_txtEmail").val();
            var mst = $("#rep_txtMST").val();
            var diachi = $("#rep_txtDiaChi").val();
            if (isEOD == "0") {
                if (ten == "" || ten.length == 0) {
                    toastr.error("Chưa nhập tên khách hàng", "Thông báo");
                    return;
                }
                if (tenCty != "" || tenCty.length != 0) {
                    //if (mst == "" || mst.length == 0) {
                    //    $('#rep_txtMST').focus();
                    //    toastr.error("Chưa nhập mã số thuế");
                    //    return;
                    //}
                    if (diachi == "" || diachi.length == 0) {
                        $('#rep_txtDiaChi').focus();
                        toastr.error("Chưa nhập địa chỉ", "Thông báo");
                        return;
                    }
                }
                if (mst != "" || mst.length != 0) {
                    if (tenCty == "" || tenCty.length == 0) {
                        $('#rep_txtTenCTy').focus();
                        toastr.error("Chưa nhập tên công ty", "Thông báo");
                        return;
                    }

                    if (diachi == "" || diachi.length == 0) {
                        $('#rep_txtDiaChi').focus();
                        toastr.error("Chưa nhập địa chỉ", "Thông báo");
                        return;
                    }
                }
                if (email == "" || email.length == 0) {
                    $('#rep_txtEmail').focus();
                    toastr.error("Chưa nhập địa chỉ email", "Thông báo");
                    return;
                }

                if (email != "" || email.length > 0) {
                    // var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                    //var filter = /^[a-z\A-Z0-9-\.]{1,32}@@[a-z\A-Z0-9-\.]{2,}(\.[a-z0-9\A-Z]{2,4}){1,2}$/;
                    var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                    if (!filter.test(email)) {
                        toastr.error("Định dạng email không đúng", "Thông báo");
                        return;
                    }
                }
                if (soDT != "" || soDT.length > 0) {

                    var filter = /^\d+$/;
                    if (!filter.test(soDT)) {
                        toastr.error("Định dạng số điện thoại không đúng", "Thông báo");
                        return;
                    }
                }
            }

            loading.showloading();
            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('isEOD', isEOD == true ? 1 : 0);
            fromData.append('Key', key);
            fromData.append('FKey', fKey);
            fromData.append('NgayPhatHanh', ngayPhatHanh);
            fromData.append('TenKH', ten);
            fromData.append('TenCT', tenCty);
            fromData.append('DiaChi', diachi);
            fromData.append('MST', mst);
            fromData.append('Phone', soDT);
            fromData.append('Email', email);
            fromData.append('LoaiDieuChinh', loaiDieuChinh);

            $.ajax({
                type: "POST",
                url: '@Url.Action("ReplaceInvoice", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == "200") {
                        //debugger
                        table.draw();
                        toastr.success(data.Message);
                        $("#modalDieuChinhThayThe").modal('hide');
                        if (loaiDieuChinh == "replaceNormal") {
                            var resultPrint = data.Data.ListPrint;
                            if (resultPrint != null) {
                                $("#divPrint").html('');
                                var divToPrint = document.getElementById('divPrint');
                                var html = "";
                                var linkSearch = "http://10.233.13.103/vin_search.html";
                                //var linkSearch = "https://hoadon.winmart.vn/";
                                linkSearch = data.LinkSearchInvoice;
                                html += "<div style='width:330px;font-family:Tahoma'>";
                                html += "<div style='text-align:center'>CÔNG TY CỔ PHẨN DỊCH VỤ</div>";
                                html += "<div style='text-align:center'>THƯƠNG MẠI TỔNG HỢP VINCOMMERCE</div>";
                                html += "<div style='text-align:center;font-weight:bold'>THÔNG TIN HÓA ĐƠN GTGT</div>";
                                html += "<div style='text-align:center;margin-top:14px;'>Quý khách vui lòng tra cứu thông tin tại hệ thống hóa đơn điện tử " + linkSearch + "</div>";

                                resultPrint.forEach((name, i) => {
                                    {
                                        ////////////////////////////////////////////////////////////////
                                        html += "<div style='margin-top:5px;'>";
                                        html += "<table style='font-size:15px;width:100%'>";
                                        html += "<tr style='text-align:left;height:20px;'><td colspan=2></td></tr>";
