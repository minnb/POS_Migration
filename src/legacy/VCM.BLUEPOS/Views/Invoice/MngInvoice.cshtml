        function EditEmail() {
            var key = $("#hdkey").val();
            var storeNo = $("#hdstoreNo").val();
            var typeInvoice = $("#hdisEOD").val() == "false" ? "NOR" : "EOD";
            var email = $("#email_txtEmail").val();

            if (email == "" || email.length == 0) {
                $('#email_txtEmail').focus();
                toastr.error("Chưa nhập địa chỉ email","Thông báo");
                return;
            }

            if (email != "" || email.length > 0) {
                // var filter = /^[a-z\A-Z0-9-\.]{1,32}@@[a-z\A-Z0-9-\.]{2,}(\.[a-z0-9\A-Z]{2,4}){1,2}$/;
                var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                if (!filter.test(email)) {
                    toastr.error("Định dạng email không đúng","Thông báo");
                    return;
                }
            }

            var fromData = new FormData();
            fromData.append('StoreNo', storeNo);
            fromData.append('InvoiceType', typeInvoice);
            fromData.append('Key', key);
            fromData.append('Email', email);
            $.ajax({
                type: "POST",
                url: '@Url.Action("EditEmail", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                        table.draw();
                        //$('#modalSendMail').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }
                },
                error: function () {
                }
            });
        }

        function SendAndEditEmail() {
            var key = $("#hdkey").val();
            var storeNo = $("#hdstoreNo").val();
            var email = $("#email_txtEmail").val();
            if (email == "" || email.length == 0) {
                $('#email_txtEmail').focus();
                toastr.error("Chưa nhập địa chỉ email");
                return;
            }

            if (email != "" || email.length > 0) {
                //var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                //var filter = /^[a-z\A-Z0-9-\.]{1,32}@@[a-z\A-Z0-9-\.]{2,}(\.[a-z0-9\A-Z]{2,4}){1,2}$/;
                var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                if (!filter.test(email)) {
                    toastr.error("Định dạng email không đúng");
                    return;
                }
            }

            var fromData = new FormData();
            fromData.append('Key', key);
            fromData.append('Email', email);
            fromData.append('StoreNo', storeNo);
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendMail", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                        $('#modalSendMail').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }
                },
                error: function () {
                }
            });
        }

