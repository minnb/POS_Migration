            //    req.onload = function (event) {
            //        var blob = req.response;
            //        console.log(blob.size);
            //        var link = document.createElement('a');
            //        link.href = window.URL.createObjectURL(blob);
            //        var d = new Date();
            //        var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
            //        link.download = "ExportInvoice_" + fileName + ".xlsx";
            //        link.click();
            //        loading.hideloading();
            //    };
            //    req.send();
            //});
           
            table = $('#tblData').DataTable({
                scrollY: "50vh",
                fixedColumns: {
                    leftColumns: 7,
                },

                deferLoading: 0,
                destroy: true,
                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: true,
                scrollX: true,

                drawCallback: function (settings) {
                    $(".replaceNormal").click(function () { //  Thay thế hóa đơn
                        //debugger
                        var keyDB = $(this).attr('data-keypdf');
                        var fKey = $(this).attr('data-fkey');
                        var storeNo = $(this).attr('data-StoreNo');
                        var branchNo = $(this).attr('data-branchno');
                        var isSigned = $(this).attr('data-issigned');
                        var isEOD = $(this).attr('data-iseod');
                        var documentNo = $(this).attr('data-documentno');
                        var branchInvoice = $(this).attr('data-branchinvoice');
                        var invoiceNo = $(this).attr('data-invoiceno');
                        var invoiceType = $(this).attr('data-invoicetype');
                        var isCancel = $(this).attr('data-iscancel');
                        var serialNo = $(this).attr('data-serialno');
                        var invoicePattern = $(this).attr('data-invoicepattern');
                        var isDummy = $(this).attr('data-isdummy');

                        var isSignedBool = (isSigned === "true");
                        var isCancelBool = (isCancel === "true");
                        var isDummyBool = (isDummy === "true");
                        var isEODBool = (isEOD === "true");

                        if (isSignedBool == false) {
                            toastr.error("Hóa đơn này (" + invoiceNo + ") đang đợi ký số. Không được thay thế", 'Thông báo');
                            return;
                        }
                        if (isCancelBool == true) {
                            toastr.error("Hóa đơn này (" + invoiceNo + ") đã được hủy hoặc thay thế", 'Thông báo');
                            return;
                        }
                        if (isDummyBool == true) {
                            toastr.error("Không được phép thay thế hóa đơn dummy", 'Thông báo');
                            return;
                        }

                        if (isEODBool == true) {
                            toastr.error("Không được phép thay thế hóa đơn EOD", 'Thông báo');
                            return;
                        }

                        ViewDieuChinhThayTheHoaDon(branchNo, storeNo, isEODBool, "replaceNormal", keyDB, fKey);

                    });

                    $(".adjustInfoNormal").click(function () {
                        //debugger
                        var keyDB = $(this).attr('data-keypdf');
                        var fKey = $(this).attr('data-fkey');
                        var storeNo = $(this).attr('data-StoreNo');
                        var branchNo = $(this).attr('data-branchno');
                        var isSigned = $(this).attr('data-issigned');
                        var isEOD = $(this).attr('data-iseod');
                        var documentNo = $(this).attr('data-documentno');
                        var branchInvoice = $(this).attr('data-branchinvoice');
                        var invoiceNo = $(this).attr('data-invoiceno');
                        var invoiceType = $(this).attr('data-invoicetype');
                        var isCancel = $(this).attr('data-iscancel');
                        var serialNo = $(this).attr('data-serialno');
                        var invoicePattern = $(this).attr('data-invoicepattern');
                        var isDummy = $(this).attr('data-isdummy');

                        var isSignedBool = (isSigned === "true");
                        var isCancelBool = (isCancel === "true");
                        var isDummyBool = (isDummy === "true");
                        var isEODBool = (isEOD === "true");

                        if (isSignedBool == false) {
                            toastr.error("Hóa đơn này (" + invoiceNo + ") đang đợi ký số. Không được điều chỉnh", 'Thông báo');
                            return;
                        }

                        if (isCancelBool == true) {
                            toastr.error("Hóa đơn này (" + invoiceNo + ") đã được hủy hoặc thay thế", 'Thông báo');
                            return;
                        }

                        if (invoiceType == "DCG") {
                            toastr.error("Không điều chỉnh thông tin trên HĐ điều chỉnh giảm", 'Thông báo');
                            //toastr.error("Hóa đơn này (" + invoiceNo + ") là hóa đơn điều chỉnh giảm", 'Thông báo');
                            return;
                        }

                        if (isDummyBool == true) {
                            toastr.error("Không được phép điều chỉnh hóa đơn dummy", 'Thông báo');
                            return;
                        }

                        if (isEODBool == true) {
                            toastr.error("Không được phép điều chỉnh hóa đơn EOD", 'Thông báo');
                            return;
                        }
                        ViewDieuChinhThayTheHoaDon(branchNo, storeNo, isEODBool, "adjustInfoNormal", keyDB, fKey);
                    });

