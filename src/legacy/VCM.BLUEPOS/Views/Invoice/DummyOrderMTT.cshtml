@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.Invoice;

@{
    ViewBag.Title = "Tạo hóa đơn dummy MTT";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = ViewBag.ListSite as List<StoreModel>;
    var model = Model as ViewMngInvoiceModel;
    var listSet = model.SetDB;

}

<script src="~/Content/jsonBeautiful/jquery-3.3.1.slim.min.js"></script>
<script src="~/Content/jsonBeautiful/jquery.json-editor.min.js"></script>

<style>
    div.dataTables_wrapper div.dataTables_paginate ul.pagination {
        white-space: nowrap;
        -webkit-box-pack: end;
        -ms-flex-pack: end;
        justify-content: flex-end;
    }

    #json-input {
        display: block;
        width: 100%;
        height: 200px;
    }

    #list-detail-content {
        border: 1px solid #000;
        margin: 0;
        padding: 10px 20px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hóa đơn điện tử</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Setup hóa đơn</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Tạo hóa đơn dummy MTT</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="inner">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12" style="display: none;">
                                    <label style="margin-bottom: 1px !important;color:#0871ab;font-weight:700">Set</label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="set-server" name="SetServer">
                                            @if (listSet != null && listSet.Count > 0)
                                            {
                                                if (@listSet.FirstOrDefault().Code == "SET1") // A.Hong: lay mac dinh set 1
                                                {
                                                    <option value="@listSet.FirstOrDefault().IPServer" data-serverread="@listSet.FirstOrDefault().IPServerRead" selected>@listSet.FirstOrDefault().Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin:auto;padding-top:15px;">
                                    <label style="margin-bottom: 3px !important;">Nội dung JSON hóa đơn Dummy MTT</label>
                                    <div class="form-group">
                                        <textarea class="form-control" rows="8" placeholder='Nhập nội dung JSON, VD: [{"value":94,"BranchNo":"HDB","SerialNo":"C24MPE","ArisingDate":"2024-11-22","BillTaxCode":"M1-24-JH48F-11002100091"},{"value":93,"BranchNo":"HDB","SerialNo":"C24MPE","ArisingDate":"2024-11-22","BillTaxCode":"M1-24-JH48F-11002100090"}]'  id="txtSoHDJson"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="row" id="div-message-info">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label style="margin-bottom: 1px !important;color:#0871ab;font-weight:700">Kết quả:</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="text-message-infor" name="MessageInfor" placeholder="" disabled>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div style="text-align:center;">
                                        <button style="cursor:pointer; color:#0d5da8; font-size:18px;margin-right:10px;" onclick="CreatedDummyMTT()" class="small-box-footer btn-create-invoice-dummy-mtt">Tạo hóa đơn Dummy MTT    <i class="fa fa-save" style="color:#ff6a00; font-weight:700; font-size:18px;"></i></button>
                                        <button style="cursor:pointer; color:#ff6a00; font-size:18px;margin-right:10px;" onclick="ClearTextJSON()" class="small-box-footer btn-clear-text-json">Tiếp tục<i style="color:#ff6a00; font-weight:700; font-size:18px;"></i></button>
                                        <button style="cursor:pointer; color:#0871ab; font-size:18px;" class="small-box-footer btn-view-json-invoice">View JSon<i style="color:#ff6a00; font-weight:700; font-size:18px;"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PopUp: JSON INVOICE -->

<div class="modal fade" id="modal-view-json-invoice" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span id="title-modal" class="modal-title"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="false" class="ki ki-close"></i>
                </button>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div id="list-detail-content" style="display:block"></div>
                        <div id="formatJsonError" style="display:none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-custom-footer" style="padding-top: 5px; padding-bottom: 5px;">
                @*<button type="button" id="btn-copy" class="btn btn-primary font-weight-bold"><i class="la la-copy"></i>Copy</button>*@
                <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal" id="btn-close-modal-detail"><i class="la la-close"></i>Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>

        $('.select2').select2();
        $(document).ready(function () {

            $('.select2').select2();
            $("#div-message-info").hide();

            $(".btn-view-json-invoice").click(function () {
                $('#list-detail-content').empty();
                //var rawData = JSON.parse($(this).find('.raw-data').text());
                var rawData = JSON.parse($("#txtSoHDJson").val());
                $('#title-modal').text('VIEW: JSON INVOICE');
                loading.showloading();
                var editor = new JsonEditor('#list-detail-content', rawData);
                editor.load(rawData);

                $('#modal-view-json-invoice').modal({
                    backdrop: 'static',
                    keyboard: true
                });
                loading.hideloading();
            });

            //$("#btn-copy").on("click", function () {
            //    copyToClipboard('#list-detail-content');
            //});

        });
       
         function CreatedDummyMTT() {
            var soHDJson = $("#txtSoHDJson").val();
            if (soHDJson == "" || soHDJson.length == 0) {
                $('#txtSoHDJson').focus();
                toastr.error("Nhập nội dung Json hóa đơn dummy MTT");
                return;
            }
            var ipSetServer = $('#set-server').val();
            loading.showloading();
            var fromData = new FormData();
            fromData.append('ipSetServer', ipSetServer);
            //var jsonlistInvoice = JSON.stringify(soHDJson);
            fromData.append('listInvoiceJson', soHDJson);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CreatedDummyMTT", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    $("#div-message-info").show();
                    $('#text-message-infor').val(data[0].MessageStr);
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function ClearTextJSON() {
             $("#txtSoHDJson").val('');
             $("#div-message-info").hide();
        }

        function getJson(json) {
            try {
                $("#formatJsonError").css("display", "none");
                $("#list-detail-content").css("display", "block");
                return JSON.parse(json);
            }
            catch (ex) {
                $('#list-detail-content').css("display", "none");
                $("#formatJsonError").css("display", "block");
                $('#formatJsonError').html(json);
            }
        }
      
        
    </script>
}
