<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row table-responsive" style="max-height:500px">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
        <table class="table table-bordered table-striped text-nowrap" id="tblDataViewDetail">
            <thead>
                <tr style="text-align:center">
                    <th>Số đơn hàng</th>
                    <th style="vertical-align:middle;max-width:300px;">Tên sản phẩm</th>
                    <th>ĐVT</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền<br /> trước thuế<br /> GTGT</th>
                    <th>Thuế suất<br /> GTGT(%)</th>
                    <th>Tiền thuế<br /> GTGT</th>
                    <th>Thành tiền<br /> sau <br />thuế GTGT</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr style="text-align:right;">
                    <th colspan="8" style="text-align:right;"><strong style="color:blue;">Tổng cộng </strong></th>
                    <th></th>
                </tr>            
            </tfoot>
        </table>
    </div>
</div>


<script type="text/javascript">

    var tableOrder = "";
    var storeNo = '@storeNo';
    var documentNo = '@documentNo';
    var branchInvoice = '@branchInvoice';
    var typePublish = '@typePublish';

    function LoadInvoice() {
         tableOrder = $('#tblDataViewDetail').DataTable({
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                var rowDataByStore = api.rows().data();
                sumAmount = rowDataByStore.reduce(function (s, a) {
                    return s + a.Amount;
                }, 0);
                // Update footer
                $(api.column(8).footer()).html("<strong style=color:Blue>"+ parseFloat(sumAmount).toLocaleString('en') +"</strong>");
            },

            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false,          // for show progress bar
            serverSide: true,           // for process server side
            filter: true,               // this is for disable filter (search box)
            orderMulti: false,          // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 1000000,
            searching: false,
            lengthChange: false,

            ajax: {
                @*url: '@Url.Action("LoadViewDetailByDocumentNo", "Invoice")',*@
                url: '@Url.Action("GetDetailInvoiceList", "Invoice")', // 25/11/2024, tungnt8
                type: "POST",
                datatype: "json",
                data: function (d) {
                    //d.OrderNo = $("#detailSearchtxtHoaDon").val();
                    d.OrderNo = "";
                    d.StoreNo = storeNo;
                    d.DocumentNo = documentNo;
                    d.BranchInvoice = branchInvoice;
                    d.TypePublish = typePublish;
                }
            },

            columns: [
                {
                    data: "OrderNo",
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:600;display:block;text-align:center;">' + row.OrderNo + '</span>';
                        return html;
                    }
                },

                {
                    data: "ProdName",
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:left;">' + row.ProdName + '</span>';
                        return html;
                    }
                },

                {
                    data: "ProdUnit",
                    className: 'text-center',
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;">' + row.ProdUnit + '</span>';
                        return html;
                    }
                },

                {
                    data: "ProdQuantity", // so luong
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:right;">' + parseFloat(row.ProdQuantity).toLocaleString('en') + '</span>';
                        return html;
                    }
                },

                {
                    data: "ProdPrice",  // don gia
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:right;">' + parseFloat(row.ProdPrice).toLocaleString('en') + '</span>';
                        return html;
                    }
                },

                {
                    data: "Total",  // thanh tien truoc thue GTGT
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:right;">' + parseFloat(row.Total).toLocaleString('en') + '</span>';
                        return html;
                    }
                },

                {
                    data: "VATRate", // thue suat
                    className: 'text-center',
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:center;">' + (row.VATRate == null || row.VATRate == 0 ? "" : row.VATRate + "%") + '</span>';
                        return html;
                    }
                },

                {
                    data: "VATAmount", // tien thue
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:400;display:block;text-align:right;">' + parseFloat(row.VATAmount).toLocaleString('en') + '</span>';
                        return html;
                    }
                },

                {
                    data: "Amount", // thanh tien sau thue GTGT
                    render: function (data, type, row) {
                        var html = '<span style="font-weight:700;display:block;text-align:right;">' + parseFloat(row.Amount).toLocaleString('en') + '</span>';
                        return html;
                    }
                }
            ]

        });
    }



