@using VCM.BLUEPOS.Model.Store;
@{
    ViewBag.Title = "Báo cáo hóa đơn điện tử";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstStore = ViewBag.ListStore as List<StoreModel>;
}

<style>
    .nav-text {
        color: #ffffff !important;
    }
</style>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        @using (Html.BeginForm("ExportInvoiceReport", "Invoice", FormMethod.Get, new { @id = "frmExcel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body table-responsive">
                            <div class="row" style="">
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã CH/ST</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slSiteNo" name="SiteNo">
                                            @if (lstStore != null && lstStore.Count() > 0)
                                            {
                                                if (lstStore.Count == 1)
                                                {
                                                    <option value="@lstStore.FirstOrDefault().StoreNo" data-array="@lstStore.FirstOrDefault().ValueJson">@lstStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    <option value="-">Tất cả</option>
                                                    foreach (var item in lstStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.StoreName) ? item.StoreNo : item.StoreNo + ":" + item.StoreName;
                                                        <option value="@item.StoreNo" data-array="@item.ValueJson">@storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Từ ngày</label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="searchFromDate" name="TuNgay" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Đến ngày</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <i class="far fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                        <input type="text" class="form-control float-right" id="searchToDate" name="DenNgay" placeholder="Đến ngày">
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Loại hóa đơn</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slTypeOrder" name="LoaiHoaDon">
                                            <option value="">Tất cả</option>

                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Hình thức</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slHinhThu" name="HinhThuc">
                                            <option value="">Tất cả</option>
                                            <option value="EOD">EOD</option>
                                            <option value="NOR">VAT</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="margin-top:-15px;">


                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mẫu số</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slMauSo" name="MauSo">
                                            <option value="">Tất cả</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Ký hiệu</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slKyHieu" name="KyHieu">
                                            <option value="">Tất cả</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Số hóa đơn</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtSoHD" name="SoHD" />
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Mã số thuế</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtMST" name="MST" />
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tên công ty</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtTenCty" name="TenCTy" />
                                    </div>
                                </div>

                            </div>
                            <div class="row" style="margin-top:-15px;">
                                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tên khách hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtTenKH" name="TenKH" />
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Điện thoại</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txtDienThoai" name="DienThoai" />
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                    <label class="font-weight-bold" style="margin-bottom: 0 !important;">Tình trạng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="slTinhTrang" name="TinhTrang">
                                            <option value="">Tất cả</option>
                                            <option value="1">Đã ký số</option>
                                            <option value="0">Đợi ký số</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-5 col-md-6 col-sm-12 col-xs-12" style="margin-top:20px">
                                    <button type="button" class="btn btn-primary" id="btnSearch" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-search"></i> Tìm kiếm</button>
                                    <button type="submit" class="btn btn-success" id="btnExport" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-scroll" style="">
                            <table class="table table-bordered table-hover text-nowrap" id="tblDataExprot">
                                <thead>
                                    <tr>
                                        <th>Ký hiệu</th>
                                        <th>Mẫu số</th>
                                        <th>Số HĐ</th>
                                        <th>IsEOD</th>
                                        <th>MST khách hàng</th>
                                        <th>Người mua hàng</th>
                                        <th>Tên đơn vị</th>
                                        <th>Email KH</th>
                                        <th>Địa chỉ</th>
                                        <th>Mã tra cứu</th>
                                        <th>Ngày kinh doanh</th>
                                        <th>Ngày xuất HĐ</th>
                                        <th>Mã site</th>
                                        <th>Số bill</th>
                                        <th>Tổng tiền thanh toán</th>
                                        <th>Tổng điểm tích</th>
                                        <th>Tổng điểm tiêu</th>
                                        <th>Barcode</th>
                                        <th>Tên SP</th>

                                        <th>Đơn giá</th>
                                        <th>Số lượng</th>
                                        <th>ĐVT</th>
                                        <th>Thành tiền</th>

                                        <th>Giảm giá</th>
                                        <th>Điểm tiêu VINID</th>
                                        <th>Thuế suất</th>
                                        <th>Tiền thuế</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        var table = "";
        $('.select2').select2();

        $(document).ready(function () {
            $('#searchFromDate').val(moment().format('DD/MM/YYYY'));
            $('#searchFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });

            $('#searchToDate').val(moment().format('DD/MM/YYYY'));
            $('#searchToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoUpdateInput: false,
                todayHighlight: true,
                singleDatePicker: true,
                autoclose: true
            });
            $("#btnSearch").on("click", function (e) {

                table.draw();
            });

            LoadData();

            $("#frmExcel").submit(function (e) {

                loading.showloading();
                e.preventDefault();
                var req = new XMLHttpRequest();
                var url = "/Invoice/ExportInvoiceReport?" + $(this).serialize();
                req.open("GET", url, true);
                req.responseType = "blob";
                req.onload = function (event) {

                    var blob = req.response;
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    var d = new Date();
                    var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                    link.download = "ExportInvoiceReport_" + fileName + ".xlsx";
                    link.click();
                    loading.hideloading();
                };
                req.send();
            });

        });



        function LoadData() {
            table = $('#tblDataExprot').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: true, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                deferLoading: 0,
                //info: false,
                ajax: {
                    url: '@Url.Action("ReportInvoiceLoad", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        var listStore = $('#slSiteNo option:selected').attr('data-array');
                        d.StoreNo = listStore;
                        d.ArisingDate = $("#searchFromDate").val();
                        d.ArisingToDate = $("#searchToDate").val();
                        d.InvoicePattern = $("#slMauSo").val();
                        d.SerialNo = $("#slKyHieu").val();
                        d.InvoiceNo = $("#txtSoHD").val();
                        d.CusName = $("#txtTenKH").val();
                        d.CusCom = $("#txtTenCty").val();
                        d.CusPhone = $("#txtDienThoai").val();
                        d.CusTaxCode = $("#txtMST").val();
                        d.InvoiceType = $("#slTypeOrder").val();
                        d.HinhThuc = $("#slHinhThu").val() == "NOR" ? "VAT" : $("#slHinhThu").val();
                        d.IsSigned = $("#slTinhTrang").val();

                    }
                },

                columns: [    
                    {
                        "data": "SerialNo"
                    },
                    {
                        "data": "InvoicePattern"
                    },
                    {
                        "data": "VATNumber"
                    },
                    {
                        "data": "IsEOD"
                    },
                    {
                        "data": "CusTaxCode"
                    },
                    {
                        "data": "CusName"
                    },
                    {
                        "data": "CusCom"
                    },
                    {
                        "data": "EmailDeliver"
                    }
                    ,
                    {
                        "data": "CusAddress"
                    }
                    ,
                    {
                        "data": "SaltEncrypt"
                    }
                    ,
                    {
                        "data": "BusinessDate"
                    }
                    ,
                    {
                        "data": "PrintedDate"
                    }
                    ,
                    {
                        "data": "StoreNo"
                    },
                    {
                        "data": "DocumentNo"
                    },
                    {
                        "data": "TotalAmount"
                    }
                    ,
                    {
                        "data": "MemberPointsEarn"
                    }
                    ,
                    {
                        "data": "MemberPointsRedeem"
                    }
                    ,
                    {
                        "data": "Barcode"
                    }
                    ,
                    {
                        "data": "ItemName"
                    }
                    ,
                    {
                        "data": "UnitPrice"
                    }
                    ,
                    {
                        "data": "Quantity"
                    }
                    ,
                    {
                        "data": "UnitOfMeasure"
                    }
                    ,
                    {
                        "data": "Amount"
                    }
                    ,
                    {
                        "data": "DiscountAmount"
                    }
                    ,
                    {
                        "data": "MemberPointsRedeemVINID"
                    }
                    ,
                    {
                        "data": "VATPercent"
                    }
                    ,
                    {
                        "data": "VATAmount"
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }
    </script>
}

