                        var branchName = result.BranchName;
                        var taxCode = result.CompTaxCode;
                        var address = result.Address;
                        var eTaxAccName = result.ETaxAccName;
                        var eTaxAccPass = result.ETaxAccPass;
                        var eTaxWSName = result.ETaxWSName;
                        var eTaxWSPass = result.ETaxWSPass;

                        $("#txtBranchNo").val(branchNo);
                        $("#txtBranchName").val(branchName);
                        $("#txtCompTaxCode").val(taxCode);
                        $("#txtAddress").val(address);
                        $("#txtETaxAccName").val(eTaxAccName);
                        $("#txtETaxAccPass").val(eTaxAccPass);
                        $("#txtETaxWSName").val(eTaxWSName);
                        $("#txtETaxWSPass").val(eTaxWSPass);
                        $("#txtBranchNo").attr('disabled', true);

                        $('#modalAddBranch').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    }
                    else {
                        toastr.error(result.Message)
                    }
                },
                error: function () {
                }
            });
          
            //$.ajax({
            //    type: "GET",
            //    url: "/Invoice/GetBranchByNo?branchNo=" + branchNo + "",
            //    dataType: 'json',                
            //    contentType: "application/json",
            //    processData: false,
            //    contentType: false,
            //    success: function (result) {
            //        if (result.Status == 200) {
            //            debugger
            //            var branchName = result.BranchName;
            //            var taxCode = result.CompTaxCode;
            //            var address = result.Address;
            //            var eTaxAccName = result.ETaxAccName;
            //            var eTaxAccPass = result.ETaxAccPass;
            //            var eTaxWSName = result.ETaxWSName;
            //            var eTaxWSPass = result.ETaxWSPass;

            //            $("#txtBranchNo").val(branchNo);
            //            $("#txtBranchName").val(branchName);
            //            $("#txtCompTaxCode").val(taxCode);
            //            $("#txtAddress").val(address);
            //            $("#txtETaxAccName").val(eTaxAccName);
            //            $("#txtETaxAccPass").val(eTaxAccPass);
            //            $("#txtETaxWSName").val(eTaxWSName);
            //            $("#txtETaxWSPass").val(eTaxWSPass);
            //            $("#txtBranchNo").attr('disabled', true);

            //            $('#modalAddBranch').modal({
            //                backdrop: 'static',
            //                keyboard: false
            //            });
            //        }
            //        else {

            //            toastr.error(result.Message)
            //        }
            //        loading.hideloading();
            //    },
            //    error: function (event) {
            //        loading.hideloading();
            //    }
            //});           
        }

        function LoadDataBranch() {
            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: true,                   // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("BranchInvoiceLoad", "Invoice")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.TypePublish = $("#sl-type-invoice-publish").val();
                        d.BranchNo = $("#slSearchBranch").val();
                        d.CompTaxCode = $("#searchTaxCode").val();
                    }
                },

                columns: [

                    {
                        data: "ID",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "BranchNo",
                        className: 'text-center'
                    },

                    {
                        data: "BranchName"
                    },

                    {
                        data: "CompTaxCode",
                        className: 'text-center'
                    },

                    {
                        data: "Address",
                    },

                    {
                        data: "ETaxAccName",
                        className: 'text-center'
                    },

                    {
                        data: "ETaxAccPass",
                        className: 'text-center'
                    },

                    {
                        data: "ETaxWSName",
                        className: 'text-center'
                    },

                    {
                        data: "ETaxWSPass",
                        className: 'text-center'
                    },

                    {
                        data: "CreateDate",
                        render: function (data, type, full, meta) {
                            if (full.LastUpdate != null) {
                                return moment(full.LastUpdate).format("DD/MM/YYYY HH:mm");
                            }
                            else {
                                if (full.CreateDate != null) {
                                    return moment(full.CreateDate).format("DD/MM/YYYY HH:mm");
                                }
                                else
                                    return "";
                            }
                        },
                        className: 'text-center'
                    },

                    {
                        data: "ID",
                        render: function (data, type, full, meta) {
                            var html = "";
                            var branchNo = full.BranchNo;
                            html += "<a onclick=\"ModalUpdate('" + full.BranchNo + "')\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\">";
                            //html += "<a href=\"javascript:;\" class=\"btn btn-icon btn-light-warning pulse pulse-warning\" data-toggle=\"dropdown\">";
                            html += "<i class=\"la la-edit\"></i>";
                            html += "<span class=\"pulse-ring\"></span>";
                            html += "</a>";
                            return html;
                        },
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });
        }

    </script>
}

