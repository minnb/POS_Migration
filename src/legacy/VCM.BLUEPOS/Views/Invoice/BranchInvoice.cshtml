@using VCM.BLUEPOS.Model.Store
@using VCM.BLUEPOS.Model.Invoice;

@{

    ViewBag.Title = "Danh sách chi nhánh";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstStore = ViewBag.ListStore as List<StoreModel>;
    var lstBranch = ViewBag.ListBranch as List<BranchModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hóa đơn điện tử</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cài đặt hóa đơn</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Danh sách chi nhánh</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary mr-2" data-toggle="modal" id="btnAddBranch"><i class="la la-plus-circle"></i> Thêm chi nhánh</button>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body table-responsive">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <label style="font-weight:bold">Phương thức phát hành</label>
                                <div class="form-group">
                                    <select id="sl-type-invoice-publish" class="form-control select2">
                                        <option value="MTT" disabled>Hóa đơn MTT</option>
                                        <option value="GTGT" selected>Hóa đơn GTGT</option>
                                    </select>
                                </div>
                            </div>

                           <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <label style="font-weight:bold">Chi nhánh</label>
                                <div class="form-group">
                                    <select id="slSearchBranch" class="form-control select2 searchOnchange" data-placeholder="">
                                        @if (lstBranch != null && lstBranch.Count() > 0)
                                        {
                                            <option value="-">Tất cả</option>
                                            foreach (var item in lstBranch)
                                            {
                                                var displayName = item.BranchNo + " : " + item.BranchName;
                                                <option value="@item.BranchNo">@displayName</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="Not">Không tìm thấy</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <label style="font-weight:bold">Mã số thuế</label>
                                <div class="form-group">
                                    <input type="text" id="searchTaxCode" class="form-control" placeholder="MST" />
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="margin-top:25px">
                                <button type="button" id="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm</button>
                            </div>
                        
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tblData" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th>STT</th>
                                    <th>Mã chi nhánh</th>
                                    <th>Tên chi nhánh</th>
                                    <th>Mã Cửa hàng</th>
                                    <th>ĐỊA CHỈ</th>
                                    <th>ETaxAccName</th>
                                    <th>ETaxAccPass</th>
                                    <th>ETaxWSName</th>
                                    <th>ETaxWSPass</th>
                                    <th>Ngày cập nhật</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAddBranch" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cập nhật thông tin chi nhánh</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Mã chi nhánh</label>
                            <input type="text" id="txtBranchNo" class="form-control" value="" placeholder="Vui lòng nhập mã chi nhánh" />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Mã số thuế</label>
                            <input type="text" id="txtCompTaxCode" class="form-control" value="" placeholder="Vui lòng nhập MST" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Tên chi nhánh</label>
                            <input type="text" id="txtBranchName" class="form-control" value="" placeholder="Vui lòng nhập tên chi nhánh" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Địa chỉ</label>
                            <input type="text" id="txtAddress" class="form-control" value="" placeholder="Vui lòng nhập địa chỉ" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">ETaxAccName</label>
                            <input type="text" id="txtETaxAccName" class="form-control" value="" placeholder="Vui lòng nhập ETaxAccName" />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">ETaxAccPass</label>
                            <input type="text" id="txtETaxAccPass" class="form-control" value="" placeholder="Vui lòng nhập ETaxAccPass" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">ETaxWSName</label>
                            <input type="text" id="txtETaxWSName" class="form-control" value="" placeholder="Vui lòng nhập ETaxWSName" />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label style="font-weight:bold">ETaxWSPass</label>
                            <input type="text" id="txtETaxWSPass" class="form-control" value="" placeholder="Vui lòng nhập ETaxWSPass" />
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Cập nhật</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        var table = "";
        $('.select2').select2();

        $(document).ready(function () {

            LoadDataBranch();

            var dataMST = $('#slBranch').find(':selected').data('comptaxcode');
            $("#txtCompTaxCode").val(dataMST);

            $("#btnSearch").on("click", function (e) {

                table.search(this.value).draw();
            });
            $(".searchOnchange").on("change", function (e) {
                table.search(this.value).draw();
            });

            $('.searchKeyPress').keypress(function (e) {
                var key = e.which;
                if (key == 13) {
                    table.search(this.value).draw();
                }
            });

            $("#btnAddBranch").on("click", function (e) {
                $("#txtBranchNo").attr('disabled', false);
                $("#txtBranchNo").val('');
                $("#txtBranchName").val('');
                $("#txtCompTaxCode").val('');
                $("#txtAddress").val('');
                $("#txtETaxAccName").val('');
                $("#txtETaxAccPass").val('');
                $("#txtETaxWSName").val('');
                $("#txtETaxWSPass").val('');

                $('#modalAddBranch').modal({
                    backdrop: 'static',
                    keyboard: false
                });
            });

            $("#slBranch").on("change", function (e) {
                var dataMST = $('#slBranch').find(':selected').data('comptaxcode');
                $("#txtCompTaxCode").val(dataMST);
            });

            $("#slStore").on("change", function (e) {
                var objectID = $('#slStore').find(':selected').data('objectid');
                $("#txtCompTaxCode").val(objectID);
            });

            $("#btnSave").on("click", function (e) {
                SaveBranch();
            });
        });

        function SaveBranch() {
            //debugger
            var branchNo = $("#txtBranchNo").val();
            var taxCode = $("#txtCompTaxCode").val();
            var branchName = $("#txtBranchName").val();
            var address = $("#txtAddress").val();
            var eTaxAccName = $("#txtETaxAccName").val();
            var eTaxAccPass = $("#txtETaxAccPass").val();
            var eTaxWSName = $("#txtETaxWSName").val();
            var eTaxWSPass = $("#txtETaxWSPass").val();

            if (branchNo == "" || branchNo == null) {
                toastr.error("Nhập mã chi nhánh");
                return;
            }
            if (taxCode == "" || taxCode == null) {
                toastr.error("Nhập mã số thuế");
                return;
            }
            if (branchName == "" || branchName == null) {
                toastr.error("Nhập tên chi nhánh");
                return;
            }
            if (address == "" || address == null) {
                toastr.error("Nhập địa chỉ chi nhánh");
                return;
            }

            loading.showloading();

            var fromData = new FormData();
            fromData.append('BranchNo', branchNo);
            fromData.append('BranchName', branchName);
            fromData.append('CompTaxCode', taxCode);
            fromData.append('Address', address);
            fromData.append('ETaxAccName', eTaxAccName);
            fromData.append('ETaxAccPass', eTaxAccPass);
            fromData.append('ETaxWSName', eTaxWSName);
            fromData.append('ETaxWSPass', eTaxWSPass);

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateBranch", "Invoice")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    debugger
                    if (data.Status == 200) {
                        toastr.success(data.Message);
                        table.draw();
                        $('#modalAddBranch').modal('hide');
                    }
                    else {
                        toastr.error(data.Message);
                    }

                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

