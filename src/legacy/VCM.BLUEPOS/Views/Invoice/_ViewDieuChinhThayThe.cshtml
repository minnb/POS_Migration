@using VCM.BLUEPOS.Model.Invoice;
@{
    var model = Model as ViewDieuChinhThayTheModel;
    var infoInvoiceByKey = model.InfoInvoiceByKey;
    var listInvoice = model.ListInvoiceReplace;
    string tenKH = "", tenCty = "", mst = "", dienThoai = "", email = "", diaChi = "", hinhthuc = "";
    if (infoInvoiceByKey != null && !string.IsNullOrEmpty(infoInvoiceByKey.InvoiceNo))
    {
        tenKH = infoInvoiceByKey.CusName;
        tenCty = infoInvoiceByKey.CusCom;
        mst = infoInvoiceByKey.CusTaxCode;
        dienThoai = infoInvoiceByKey.CusPhone;
        email = infoInvoiceByKey.EmailDeliver;
        diaChi = infoInvoiceByKey.CusAddress;
        hinhthuc = infoInvoiceByKey.InvoiceType;
    }
    var loaiDieuChinh = model.LoaiDieuChinh;
    var disableEOD = hinhthuc == "EOD" ? "disabled" : "";
    var titleTable = loaiDieuChinh == "replaceInvoice" ? "Danh sách hóa đơn sẽ bị thay thế" : "Danh sách hóa đơn sẽ bị điều chỉnh";
}
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title" style="font-size:14px;font-weight:bold;margin:10px">@titleTable</h3>

            </div>
            <div class="card-body" style="padding:0px !important">
                <div class="card-body table-responsive" style="padding: .25rem !important;">
                    <table class="table table-bordered table-striped" id="tblDataInvoice">
                        <thead>
                            <tr style="text-align:center;">
                                <th style="vertical-align:middle">Stt</th>
                                <th style="vertical-align:middle">Số hóa đơn</th>
                                <th style="vertical-align:middle">Số serial</th>
                                <th style="vertical-align:middle">Mẫu số</th>
                                <th style="vertical-align:middle">Hóa đơn</th>
                            </tr>

                        </thead>
                        <tbody>
                            @if (listInvoice != null && listInvoice.Count > 0)
                            {
                                var stt = 1;
                                foreach (var item in listInvoice)
                                {
                                    var loaiHD = item.IsRun == 1 ? (loaiDieuChinh == "replaceNormal" ? "Bị thay thế" : "Bị điều chỉnh") : "Liên quan (không " + (loaiDieuChinh == "replaceNormal" ? "bị thay thế" : "bị điều chỉnh") + ")";
                                    <tr>
                                        <td style="text-align:center">@stt</td>
                                        <td style="text-align:center">@item.InvoiceNo</td>
                                        <td style="text-align:center">@item.SerialNo</td>
                                        <td style="text-align:center">@item.InvoicePattern</td>
                                        <td style="text-align:center">@loaiHD</td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">Tên khách hàng</label>
        <div class="form-group">
            <input type="text" class="form-control" id="rep_txtTen" value="@tenKH" @disableEOD />
        </div>
    </div>

    <div class="col-lg-8 col-md-6 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">Tên công ty</label>
        <div class="form-group">
            <input type="text" class="form-control" id="rep_txtTenCTy" value="@tenCty" @disableEOD />
        </div>
    </div>
</div>
<div class="row">

    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">MST</label>
        <div class="form-group">
            <input type="text" class="form-control" id="rep_txtMST" value="@mst" @disableEOD />
        </div>
    </div>
    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">Điện thoại</label>
        <div class="form-group">
            <input type="text" class="form-control" id="rep_txtDienThoai" value="@dienThoai" @disableEOD />
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">Thư điện tử</label>
        <div class="form-group">
            <input type="text" class="form-control" id="rep_txtEmail" value="@email" @disableEOD />
        </div>
    </div>


</div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
        <label style="font-weight:bold">Địa chỉ</label>
        <div class="form-group">
            <textarea type="text" rows="3" class="form-control" id="rep_txtDiaChi" @disableEOD>@diaChi</textarea>
        </div>
    </div>
</div>
