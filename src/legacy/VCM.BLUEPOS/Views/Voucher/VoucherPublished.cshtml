            $('#tbl-voucher-published tbody').on('click', 'tr', function () {
                $(this).toggleClass('selected');
            });

            $("#btn-search").on("click", function (e) {
                var fromDate = getFromDate();
                var toDate = getToDate();
                if (fromDate > toDate) {
                    toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày');
                    return;
                }
                table.draw();
            })

        })

        $("#btn-export-excel").on("click", function (e) {
            var fromDate = getFromDate();
            var toDate = getToDate();
            if (fromDate > toDate) {
                toastr.error('Từ ngày phải nhỏ hơn hoặc bằng đến ngày');
                return;
            }
            $('#hdFromDate').val(fromDate);
            $('#hdToDate').val(toDate);
            $('#frm-export-excel').submit();
        })

        function CheckSAP(voucherNumber) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('VoucherNumber', voucherNumber);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckToSAP", "Voucher")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (result) {
                    //debugger
                    if (result.ResultStatus != null) {
                        if (result.ResultStatus == 200) {
                            var name = result.ResutlData;
                            var html = "";
                            html += "<table id=\"\" class=\"table table-bordered\" style=\"width:100%;max-height:500px\">";
                            html += "<thead>";
                            html += "<tr>";
                            html += "<th style='text-align:center;'>Trạng thái</th>";
                            html += "<th style='text-align:center;'>ActicleNo</th>";
                            html += "<th style='text-align:center;'>ActicleType</th>";
                            html += "<th style='text-align:center;'>Mã Voucher</th>";
                            html += "<th style='text-align:center;'>Value</th>";
                            html += "<th style='text-align:center;'>Từ ngày</th>";
                            html += "<th style='text-align:center;'>Đến ngày</th>";
                            html += "</tr>";
                            html += "</thead>";
                            html += "</tbody>";
                            html += "<tr id=\"\">";

                            html += "</tr>";
                            html += "<tr id=\"\">";
                            html += "<td style=\"text-align:center;\">" + name.Status + "</td>";
                            html += "<td style=\"\">" + name.ActicleNo + "</td>";
                            html += "<td style=\"\">" + name.ActicleType + "</td>";
                            html += "<td style=\"\">" + name.VoucherNumber + "</td>";
                            html += "<td style=\"\">" + name.FormatValue + "</td>";

                            html += "<td style=\"\">" + name.Validity_From_Date + "</td>";
                            html += "<td style=\"\">" + name.Expiry_Date + "</td>";
                            html += "</tr>";

                            html += "</tbody>";
                            html += "</table>";
                            $('#listResult').html(html);
                            $("#titleNotFinish").html("CHECK SAP");

                            $('#modalResult').modal({
                                backdrop: 'static',
                                keyboard: false
                            });
                        }
                        else {
                            toastr.error(result.ResultMessage, 'Thông báo');
                        }
                    }
                    loading.hideloading();
                },
                error: function () {
                }
            });
        }

      

    </script>
