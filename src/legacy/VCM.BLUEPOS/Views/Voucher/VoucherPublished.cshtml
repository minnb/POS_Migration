@using VCM.BLUEPOS.Model.Voucher;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Store;

@{
    ViewBag.Title = "Tra cứu V/C đã phát hành";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listCouponType = (List<OptionModel>)ViewBag.ListCouponType;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý Voucher</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Tra cứu V/C đã phát hành</a>
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <a class="btn btn-header-custom btn-success btn-search" style="color:#fff !important;float:right;font-weight: 700" id="btnResendToSAP" onclick="ResendToSAP()"><i class="fa fa-sync"></i>&nbsp;&nbsp;Resend SAP</a>
        </div>

    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelVoucherPublishedList", "Voucher", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Cửa hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().StoreNo">@listStore.FirstOrDefault().StoreNo - @listStore.FirstOrDefault().StoreName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        <option value="@item.StoreNo">@item.StoreNo - @item.StoreName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Loại</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-voucher-type" name="VoucherType">
                                                <option value="" selected>Tất cả</option>
                                                <option value="V">Voucher/Coupon</option>
                                                <option value="R">Mã dự thưởng</option>
                                            </select>
                                        </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Tình trạng</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status-voucher" name="StatusVoucher">
                                            <option value="" selected>Tất cả</option>
                                            <option value="SOLD">SOLD - Bán hàng</option>
                                            <option value="EXP">EXP - Trả hàng</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Send SAP</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-send-sap" name="SendSAP">
                                            <option value="" selected>Tất cả</option>
                                            <option value="1">Đã send</option>
                                            <option value="0">Chưa send</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-text-search" name="TextSearch" placeholder="Nhập số BonusBuy / SerialNo / Số đơn hàng" />
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <input type="hidden" id="hdFromDate" name="FromDate" />
                                    <input type="hidden" id="hdToDate" name="ToDate" />
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <table id="tbl-voucher-published" class="table table-bordered table-hover text-nowrap">
                                            <thead>
                                                <tr class="text-center" style="text-transform:uppercase;">
                                                    <th><input type="checkbox" class="chkAll" id="chkAll" value="" style="height:20px;width:20px;"></th>
                                                    <th>STT</th>
                                                    <th>Sended SAP</th>
                                                    @*<th>Check SAP</th>*@
                                                    <th>Cửa hàng</th>
                                                    <th>Máy POS</th>
                                                    <th>BonusBuy</th>
                                                    <th>SerialNo</th>
                                                    <th>Số đơn hàng</th>
                                                    <th>ArticleNo</th>
                                                    <th>Tên chương trình</th>
                                                    <th>Loại V/C áp dụng</th>
                                                    <th>Tình trạng</th>
                                                    <th>Giá trị</th>
                                                    <th>Giá trị tối đa</th>
                                                    <th>Số lượng sử dụng tối đa</th>
                                                    <th>Số lượng phát hành tối đa</th>
                                                    <th>Thời gian tạo</th>
                                                    <th>Batch File</th>
                                                    <th>Áp dụng cho Item</th>
                                                    <th>Loại</th>
                                                    <th>Từ ngày</th>
                                                    <th>Đến ngày</th>
                                                    <th>Ngày tạo</th>
                                                    @*<th>Ngày bắt đầu có hiệu lực</th>*@
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalResult" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;text-transform:uppercase" id="titleNotFinish">KẾT QUẢ RESEND TỚI SAP</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-5 col-sm-12 col-xs-12">
                        <div id="listResult" style="width:100%;float:left;max-height:600px;overflow-y:scroll"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



