        function ResendToSAP() {
            //debugger
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn resend tới SAP ?',
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            debugger
                            loading.showloading();
                            var dataArray = collectData();                            
                            if (dataArray == null) {
                                toastr.error("Không có thông tin để resend SAP. Vui lòng kiểm tra lại");
                                return;
                            }
                            var listModel = JSON.stringify(dataArray);
                            var fromData = new FormData();
                            fromData.append('modelVoucher', listModel);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("ResendVoucherToSAP", "Voucher")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {  
                                    debugger
                                    if (data != null) {
                                        var html = "";
                                        html += "<table id=\"\" class=\"table table-bordered\" style=\"width:100%;max-height:500px\">";
                                        html += "<thead>";
                                        html += "<tr>";
                                        html += "<th style='text-align:center;width:120px'>Mã Voucher/Coupon</th>";
                                        html += "<th style='text-align:center;width:120px'>Message</th>";
                                        html += "<th style='text-align:center;width:100px'>Trạng thái</th>";
                                        html += "</tr>";
                                        html += "</thead>";
                                        html += "</tbody>";

                                        data.Data.forEach((name, i) => {   
                                            debugger
                                            html += "<tr id=\"\">";
                                            html += "<td style=\"text-align:center;\">" + name.SerialNumber + "</td>";
                                            html += "<td style=\"max-width:400px\">" + data.Message + "</td>";
                                            if (data.Status == 200) {
                                                html += "<td style=\"text-align:center;color:#fff;\"><span class=\"badge bg-success\">Success</span></td>";
                                            }
                                            else {
                                                html += "<td style=\"text-align:center;color:#fff;\"><span class=\"badge bg-danger\">Fail</span></td>";
                                            }
                                            html += "</tr>";
                                        });

                                        html += "</tbody>";
                                        html += "</table>";
                                        
                                        $("#titleNotFinish").html("KẾT QUẢ RESEND TỚI SAP");
                                        $('#listResult').html(html);
                                        table.draw();

                                        $('#modalResult').modal({
                                            backdrop: 'static',
                                            keyboard: false
                                        });
                                    }
                                    loading.hideloading();
                                },
                                error: function () {
                                    loading.hideloading();
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });
        }


