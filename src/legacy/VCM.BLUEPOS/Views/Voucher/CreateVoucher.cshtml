@section Scripts
{
    <script type="text/javascript">

        var table_voucher_coupon;
        var table_modal;
        var globalHtml;

        function LoadComboxUnits() {
            //debugger
            $('#tbl-create-item-apply-voucher tbody').find('tr').each(function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComboxUnitOfMeasure", "Common")',
                    dataType: "json",
                    success: function (data)
                    {
                        //debugger
                        if (data != null) {
                           var html = "<option value=\"\" selected>Chọn đơn vị tính...</option>";
                           data.forEach((name, i) => {
                               html += "<option value='" + name.Value + "'>" + name.Text +"</option>";
                            });
                            globalHtml = html;
                            $('.sel-combox-units').empty().html(html).select2();
                        }
                    },
                    error: function ()
                    {
                        toastr.error('Lỗi hệ thống');
                    }
                });

            });

        };

