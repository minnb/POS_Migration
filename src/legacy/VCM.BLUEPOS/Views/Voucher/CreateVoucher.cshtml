@using VCM.BLUEPOS.Model.Voucher;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Tạo Voucher/Coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listCouponType = (List<OptionModel>)ViewBag.ListCouponType;
    var listArticleType = (List<OptionModel>)ViewBag.ListArticleType;
    var listUnits = (List<OptionModel>)ViewBag.ListUnitOfMeasure;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý Voucher</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Tạo Voucher / Coupon</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">

                        <div class="row">
                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại Voucher/Coupon</label>
                                <div class="form-group">
                                    <select class="form-control select2" id="sel-voucher-coupon-type" name="VoucherCouponType">
                                        <option value="" selected>--- Chọn ---</option>
                                        @if (listCouponType != null && listCouponType.Count > 0)
                                        {
                                            foreach (var item in listCouponType)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Tên Voucher/Coupon</label>
                                <div class="form-group">
                                    <input type="text" class="form-control pull-right" style="width:100%;" id="txt-voucher-coupon-name" name="VoucherCouponName" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Số serial Voucher/Coupon</label>
                                <div class="form-group">
                                    <input type="number" class="form-control pull-right" style="width:100%;" id="txt-serial-voucher-coupon" name="SerialVoucherCoupon" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đơn vị tính</label>
                                <div class="form-group">
                                    <select class="form-control select2" id="sel-unit-voucher" name="UnitsVoucher">
                                        <option value="" selected>--- Chọn ---</option>
                                        @if (listUnits != null && listUnits.Count > 0)
                                        {
                                            foreach (var item in listUnits)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại giảm giá</label>
                                <div class="form-group">
                                    <select class="form-control select2" id="sel-discount-type" name="DiscountType">
                                        <option value="" selected>--- Chọn ---</option>
                                        <option value="1">Percent (%)</option>
                                        <option value="2">Amount</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị giảm</label>
                                <div class="form-group">
                                    <input type="number" class="form-control pull-right" style="width:100%;" id="txt-discount-value" name="DiscountValue" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị Voucher/Coupon</label>
                                <div class="form-group">
                                    <input type="number" class="form-control pull-right" style="width:100%;" id="txt-value-voucher" name="ValueVoucher" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị lớn nhất</label>
                                <div class="form-group">
                                    <input type="number" class="form-control pull-right" style="width:100%;" id="txt-max-value" name="MaxValue" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Voucher/Coupon limit</label>
                                <div class="form-group">
                                    <input type="number" class="form-control pull-right" style="width:100%;" id="txt-voucher-coupon-limit" name="VoucherCouponLimit" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày bắt đầu hiệu lực</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="far fa-calendar-alt"></i>
                                        </span>
                                    </div>
                                    <input type="text" class="form-control float-right" id="starting-date" name="StartingDate" placeholder="">
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày kết thúc hiệu lực</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="far fa-calendar-alt"></i>
                                        </span>
                                    </div>
                                    <input type="text" class="form-control float-right" id="ending-date" name="EndingDate" placeholder="">
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12" style="display: inline-block; padding-top: 37px;">
                                <input type="checkbox" id="chk-total-bill" style="height:25px; width:25px; cursor:pointer; padding-top: 5px; margin-left: 1px;">
                                <label for="chk-total-bill" style="font-size:11px; margin-top: 10px; position: absolute; padding-left: 7px;">Áp dụng tổng bill</label>
                            </div>

                            @*<div class="col-lg-2 col-md-6 col-sm-6 col-xs-12" style="display: inline-block; padding-top: 13px;">
                                    <button type="button" id="btn-item-apply" class="btn btn-instagram"><i class="la la-plus-circle"></i>Sản phẩm Áp dụng</button>
                                </div>*@

                        </div>

                        <!-- Thông tin san pham ap dung -->
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                    <div class="card-body">
                                        <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                            <button type="button" id="btn-add-row" class="btn btn-hover-transparent-primary"><i class="la la-plus-circle"></i>Thêm dòng</button>
                                            <button type="button" id="btn-create-voucher-coupon" class="btn btn-hover-transparent-warning"><i class="fa fa-save"></i>Lưu</button>
                                        </div>
                                        <div style="padding-top:3px;">
                                            <table id="tbl-create-item-apply-voucher" class="table table-bordered table-hover">
                                                <thead>
                                                    <tr class="text-center" style="text-transform:uppercase;">
                                                        <th style="text-align:center; padding-right: 10px;">STT</th>
                                                        <th style="text-align:center; padding-right: 10px;">Mã sản phẩm</th>
                                                        <th style="text-align:center; padding-right: 10px;">Mã Barcode</th>
                                                        <th style="text-align:center; padding-right: 10px;">#</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


