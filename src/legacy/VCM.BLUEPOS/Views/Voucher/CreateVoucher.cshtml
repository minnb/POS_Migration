                    markup += '<td><input type="text" class="form-control" style="text-align: center;"></td>';
                    //markup += '<td><select class="select2 sel-combox-units" style="width:50%; height:40px;">' + globalHtml + '</select></td>';
                    markup += '<td style="text-align:center; width: 5%;"><button type="button" class="btn btn-clear-text-row" onclick="ClearRow($(this))"  data-toggle="tooltip" data-placement="left" title="Xóa dòng"  style="text-align:center;font-size:11px;margin-right:2px;color:#ffffff;"><i class="fa fa-trash" style="color:red"></i></button></td>';
                    markup += '</tr>';
                    $("#tbl-create-item-apply-voucher tbody").append(markup);
                    LoadComboxUnits();
                }
            });
        });

    </script>
