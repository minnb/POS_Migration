        function ModalRowCount() {
            var result = 0;
            $('#tbl-item-apply-voucher-coupon-modal tbody').find('tr').each(function () {
                //debugger
                var rowCount = $(this).find('td:nth-child(1)').html();
                result = rowCount;
                return result;
            });
            return result;
        };

        function ModalClearRow(row) {
            var result = true;
            $('#tbl-item-apply-voucher-coupon-modal tbody').find('tr').each(function () {
                var id = $(this).find('td:nth-child(1)').html();
                if (id > 0) {
                    row.closest('tr').remove();
                }
                return result;
            });
        };

        function RowCount() {
            var result = 0;
            $('#tbl-create-item-apply-voucher tbody').find('tr').each(function () {
                //debugger
                var rowCount = $(this).find('td:nth-child(1)').html();
                result = rowCount;
                return result;
            });
            return result;
        };

        function ClearRow(row) {
            var result = true;
            $('#tbl-create-item-apply-voucher tbody').find('tr').each(function () {
                var id = $(this).find('td:nth-child(1)').html();
                if (id > 0) {
                    row.closest('tr').remove();
                }
                return result;
            });
        };

        function GetDataRowItemApply() {
            var data = [];
            $('#tbl-create-item-apply-voucher tbody').find('tr').each(function () {
                var item = {};
                //var _unit = $(this).find('.sel-combox-units').val();
                var _itemNo = $(this).find('td:nth-child(2) input').val();
                if (_itemNo != null && _itemNo.trim() != "") {
                    item['LineItemNo'] = $(this).find('td:nth-child(2) input').val();
                    //item['UnitOfMeasure'] = $(this).find('.sel-combox-units').val();
                    item['Barcode'] = $(this).find('td:nth-child(3) input').val();
                    data.push(item);
                }
            });
            return data;
        };

        function validateDataRow() {
            var result = true;
            var data = GetDataRowItemApply();
            for (var i = 0; i < data.length; i++) {
                if (data[i].Barcode == null || data[i].Barcode == "") {
                    toastr.error('Nhập mã barcode');
                    result = false;
                    return result;
                }

                if (data[i].Barcode != null || data[i].Barcode.length > 0) {
                    var check = data[i].Barcode.trim();
                    if ((check == check / 1) == false) {
                        toastr.error("Mã barcode phải là kiểu số");
                        result = false;
                        return result;
                    }
                }

                if (data[i].LineItemNo == null || data[i].LineItemNo == "") {
                    toastr.error('Nhập mã sản phẩm');
                    result = false;
                    return result;
                }

                if (data[i].LineItemNo != null || data[i].LineItemNo.length > 0) {
                    var check = data[i].LineItemNo.trim();
                    if ((check == check / 1) == false) {
                        toastr.error("Mã sản phẩm phải là kiểu số");
                        result = false;
                        return result;
                    }
                }
            }
            return result;
        };

        //
        function CreateVoucherCoupon() {
            //debugger
            var _couponType     = $('#sel-voucher-coupon-type').val();
            var _couponName     = $('#txt-voucher-coupon-name').val();
            var _serialVoucher  = $('#txt-serial-voucher-coupon').val();
            var _units          = $('#sel-unit-voucher').val();
            var _discountType   = $('#sel-discount-type').val();
            var _discountValue  = $('#txt-discount-value').val();
            var _valueVoucher   = $('#txt-value-voucher').val();
            var _maxValue       = $('#txt-max-value').val();
            var _voucherLimit   = $('#txt-voucher-coupon-limit').val();
            var _startingDate   = $('#starting-date').val();
            var _endingDate     = $('#ending-date').val();
            var _statusVoucher  = 0;
            var _checkTotalBill = $('#chk-total-bill').prop('checked');

            if (_checkTotalBill == true) {

                if (_couponType == null || _couponType == "") {
                    toastr.warning("Vui lòng chọn loại voucher/coupon");
                    return;
                }

                if (_couponName == null || _couponName == "") {
                    toastr.warning("Vui lòng nhập tên voucher/coupon");
                    return;
                }

                if (_serialVoucher == null || _serialVoucher == "") {
                    toastr.warning("Vui lòng nhập số serial voucher/coupon");
                    return;
                }

                if (_units == null || _units == "") {
                    toastr.warning("Vui lòng chọn đơn vị tính");
                    return;
                }
                if (_discountType == null || _discountType == "") {
                    toastr.warning("Vui lòng chọn loại giảm giá");
                    return;
                }

                if (_discountValue == null || _discountValue == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher giảm");
                    return;
                }

                if (_valueVoucher == null || _valueVoucher == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher");
                    return;
                }

                if (_maxValue == null || _maxValue == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher lớn nhất");
                    return;
                }
                else {
                    if (_maxValue > 99999999) {
                        toastr.warning("Giá trị voucher lớn nhất không lớn hơn 99.999.999");
                        return;
                    }
                    else if (_maxValue < 1) {
                        toastr.warning("Giá trị voucher lớn nhất phải là số nguyên dương (>0)");
                        return;
                    }
                }

                if (_voucherLimit > 99999999) {
                    toastr.warning("Giá trị voucher limit không lớn hơn 99.999.999");
                    return;
                }
                else if (_voucherLimit < 1) {
                    toastr.warning("Giá trị voucher limit phải là số nguyên dương (>0)");
                    return;
                }

                if (_startingDate == null || _startingDate == "") {
                    toastr.warning("Vui lòng nhập ngày bắt đầu hiệu lực");
                    return;
                }

                if (_endingDate == null || _endingDate == "") {
                    toastr.warning("Vui lòng nhập ngày hết hiệu lực");
                    return;
                }

                loading.showloading();

                $.ajax({
                url: '@Url.Action("CreateVoucherCoupon", "Voucher")',
                type: "POST",
                dataType: "json",
                data: {
                        ItemName: _couponName,
                        CouponCode: _serialVoucher,
                        UnitOfMeasure: _units,
                        DiscountType: _discountType,
                        DiscountValue: _discountValue,
                        ValueOfVoucher: _valueVoucher,
                        MaxAmount: _maxValue,
                        LimitQty: _voucherLimit,
                        ArticleType: _couponType,
                        BlockedStr: _statusVoucher,
                        IsCheckItem : _checkTotalBill,
                        StartingDateStr: _startingDate,
                        EndingDateStr: _endingDate,
                        ListItemApplyStr: ""
                },
                success: function (data) {
                        loading.hideloading();
                        if (data.Status = 1) {
                            toastr.success(data.Message);
                            $('#sel-voucher-coupon-type').val('').trigger('change');
                            $('#txt-voucher-coupon-name').val('');
                            $('#txt-serial-voucher-coupon').val('');
                            $('#sel-unit-voucher').val('').trigger('change');
                            $('#sel-discount-type').val('').trigger('change');
                            $('#txt-discount-value').val('');
                            $('#txt-value-voucher').val('');
                            $('#txt-max-value').val('');
                            $('#txt-voucher-coupon-limit').val('');
                            $('#chk-total-bill').prop('checked', false);
                            $('#btn-add-row').prop('disabled', false);
                        }
                        else if (data.Status = 2) {
                            toastr.warning(data.Message);
                        }
                        else if (data.Status = 3) {
                            toastr.error(data.Message);
                        }
                        else if (data.Status = 4) {
                            toastr.error(data.Message);
                        }
                },
                error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                }
            });

            }
            else  // Không áp dụng total bill
            {
                var _listItemApply = GetDataRowItemApply();
                if (_listItemApply == null || _listItemApply.length == 0) {
                    toastr.error('Không có dữ liệu. Vui lòng kiểm tra lại');
                    return;
                }

                if (_couponType == null || _couponType == "") {
                    toastr.warning("Vui lòng chọn loại voucher/coupon");
                    return;
                }

                if (_couponName == null || _couponName == "") {
                    toastr.warning("Vui lòng nhập tên voucher/coupon");
                    return;
                }

                if (_serialVoucher == null || _serialVoucher == "") {
                    toastr.warning("Vui lòng nhập số serial voucher/coupon");
                    return;
                }

                if (_units == null || _units == "") {
                    toastr.warning("Vui lòng chọn đơn vị tính");
                    return;
                }
                if (_discountType == null || _discountType == "") {
                    toastr.warning("Vui lòng chọn loại giảm giá");
                    return;
                }

                if (_discountValue == null || _discountValue == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher giảm");
                    return;
                }

                if (_valueVoucher == null || _valueVoucher == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher");
                    return;
                }

                if (_maxValue == null || _maxValue == "") {
                    toastr.warning("Vui lòng nhập giá trị voucher lớn nhất");
                    return;
                }
                else {
                    if (_maxValue > 99999999) {
                        toastr.warning("Giá trị voucher lớn nhất không lớn hơn 99.999.999");
                        return;
                    }
                    else if (_maxValue < 1) {
                        toastr.warning("Giá trị voucher lớn nhất phải là số nguyên dương (>0)");
                        return;
                    }
                }

                if (_voucherLimit > 99999999) {
                    toastr.warning("Giá trị voucher limit không lớn hơn 99.999.999");
                    return;
                }
                else if (_voucherLimit < 1) {
                    toastr.warning("Giá trị voucher limit phải là số nguyên dương (>0)");
                    return;
                }
                    
                if (_startingDate == null || _startingDate == "") {
                    toastr.warning("Vui lòng nhập ngày bắt đầu hiệu lực");
                    return;
                }

                if (_endingDate == null || _endingDate == "") {
                    toastr.warning("Vui lòng nhập ngày hết hiệu lực");
                    return;
                }

                validateDataRow();
                loading.showloading();

                $.ajax({
                url: '@Url.Action("CreateVoucherCoupon", "Voucher")',
                type: "POST",
                dataType: "json",
                data: {
                        ItemName: _couponName,
                        CouponCode: _serialVoucher,
                        UnitOfMeasure: _units,
                        DiscountType: _discountType,
                        DiscountValue: _discountValue,
                        ValueOfVoucher: _valueVoucher,
                        MaxAmount: _maxValue,
                        LimitQty: _voucherLimit,
                        ArticleType: _couponType,
                        ValueOfVoucher: _voucherLimit,
                        Blocked: _statusVoucher,
                        IsCheckItem : _checkTotalBill,
                        StartingDateStr: _startingDate,
                        EndingDateStr: _endingDate,
                        ListItemApplyStr: JSON.stringify(_listItemApply)
                },
                success: function (data) {
                        loading.hideloading();
                        if (data.Status = 1) {
                            toastr.success(data.Message);
                            $('#sel-voucher-coupon-type').val('').trigger('change');
                            $('#txt-voucher-coupon-name').val('');
                            $('#txt-serial-voucher-coupon').val('');
                            $('#sel-unit-voucher').val('').trigger('change');
                            $('#sel-discount-type').val('').trigger('change');
                            $('#txt-discount-value').val('');
                            $('#txt-value-voucher').val('');
                            $('#txt-max-value').val('');
                            $('#txt-voucher-coupon-limit').val('');
                            $('#chk-total-bill').prop('checked', false);
                            $('#btn-add-row').prop('disabled', false);
                        }
                        else if (data.Status = 2) {
                            toastr.warning(data.Message);
                        }
                        else if (data.Status = 3) {
                            toastr.error(data.Message);
                        }
                        else if (data.Status = 4) {
                            toastr.error(data.Message);
                        }
                },
                error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                }
            });

            }
        }

