            if (_lineItemNo == null || _lineItemNo == "") {
                toastr.warning("Vui lòng nhập mã sản phẩm");
                return;
            }

            if (_barCode == null || _barCode == "") {
                toastr.warning("Vui lòng nhập mã barcode");
                return;
            }

            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateVoucherLine", "Voucher")',
                type: "POST",
                dataType: "json",
                data: {
                    Pkey: _pkey,
                    ItemNo: _itemNo,
                    LineItemNo: _lineItemNo,
                    Barcode: _barCode
                },
                success: function (data) {
                        //debugger
                        $('#btn-search-voucher-line').trigger('click');
                        loading.hideloading();

                        if (data.Status = 1) {
                            toastr.success(data.Message);
                            $('#modal-update-voucher-line').modal("hide");
                        }
                        else if (data.Status = 2) {
                            toastr.warning(data.Message);
                        }
                        else if (data.Status = 3) {
                            toastr.error(data.Message);
                        }
                        else if (data.Status = 4) {
                            toastr.error(data.Message);
                        }
                },
                error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                }
            });
        }


