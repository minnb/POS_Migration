@using VCM.BLUEPOS.Model.Voucher;
@using VCM.BLUEPOS.Model.OptionModel;

@{
    ViewBag.Title = "Cập nhật voucher/coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listCouponType = (List<OptionModel>)ViewBag.ListCouponType;
    var listUnits = (List<OptionModel>)ViewBag.ListUnitOfMeasure;
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">

        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>IT</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cập nhật voucher/coupon</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="card card-custom">
            <!--begin::Header-->
            <div class="card-custom card-primary card-tabs">
                <div class="card-header card-header-tabs-line">
                    <ul class="nav nav-dark nav-bold nav-tabs nav-tabs-line" data-remember-tab="tab_id" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" href="#tab-voucher-coupon-header" data-toggle="tab" role="tab">
                                <span class="nav-icon">
                                    <i class="flaticon-gift"></i>
                                </span>
                                Voucher/Coupon Header
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#tab-voucher-coupon-line" data-toggle="tab" role="tab">
                                <span class="nav-icon">
                                    <i class="flaticon-gift"></i>
                                </span>
                                Voucher/Coupon Line
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="tab-content">
                            <!-- Tab: Voucher/Coupon Header -->
                            <div class="active tab-pane" id="tab-voucher-coupon-header">
                            @using (Html.BeginForm("ExportVoucherHeaderList", "Voucher", FormMethod.Post, new { id = "frm-export-excel-voucher-header" }))
                            {
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Số Serial Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-serial-voucher-coupon" name="SerialVoucher" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-code-voucher-coupon" name="CodeVoucher" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Tên Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-voucher-coupon-name" name="NameVoucher" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <select class="form-control select2" id="sel-voucher-coupon-type" name="TypeVoucher">
                                                                <option value="-1" selected>Tất cả</option>
                                                                @if (listCouponType != null && listCouponType.Count > 0)
                                                                {
                                                                    foreach (var item in listCouponType)
                                                                    {
                                                                        <option value="@item.Value">@item.Text</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Trạng thái</label>
                                                        <div class="form-group">
                                                            <select class="form-control select2" id="sel-voucher-coupon-status" name="StatusVoucher">
                                                                <option value="-1" selected>Tất cả</option>
                                                                <option value="0">Có hiệu lực</option>
                                                                <option value="1">Hết hiệu lực</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px">
