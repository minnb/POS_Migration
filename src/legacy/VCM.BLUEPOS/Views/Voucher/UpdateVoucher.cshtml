                        $('#modal-update-voucher-line').modal({
                            backdrop: 'static',
                            keyboard: true
                        });

                    });


                    // Click button delete
                    $('.btn-delete-voucher-line').click(function () {
                        var _pkey = $(this).attr("data-pkey");
                        $.confirm({
                            backgroundDismiss: true,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: 'Bạn có chắc chắn muốn xóa không?',
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        loading.showloading();
                                        $.ajax({
                                            url: '@Url.Action("DeleteVoucherLineList", "Voucher")',
                                            type: "POST",
                                            dataType: "json",
                                            data: { Pkey: _pkey},
                                            success: function (data) {
                                                if (data.Status == 1)
                                                {
                                                    toastr.success(data.Message);  // case: delete success
                                                }
                                                else if (data.Status == 2)
                                                {
                                                    toastr.warning(data.Message);
                                                }
                                                else
                                                {
                                                    toastr.error(data.Message);
                                                }
                                                $('#btn-search-voucher-line').trigger('click');
                                                loading.hideloading();
                                            },
                                            error: function () {
                                                toastr.error("Lỗi hệ thống");
                                                loading.hideloading();
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });

                },

