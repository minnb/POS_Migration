                                                        <button type="button" id="btn-export-excel-voucher-header" class="btn btn-success" style="color: #ffffff;cursor:pointer;"><i class="fa fa-file-excel"></i>Xuất excel</button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                            <div class="card-body">
                                                <table class="table table-bordered table-hover text-nowrap" id="table-list-voucher-header">
                                                    <thead>
                                                        <tr style="text-align:center;text-transform:uppercase;">
                                                            <th width="80px;">#</th>
                                                            <th>STT</th>
                                                            <th>Số serial Voucher/Coupon</th>
                                                            <th>Mã Voucher/Coupon</th>
                                                            <th>Tên Voucher/Coupon</th>
                                                            <th>Loại Voucher/Coupon</th>
                                                            <th>ĐVT</th>
                                                            <th>Trạng thái</th>
                                                            <th>Giá trị Voucher/Coupon</th>
                                                            <th>Loại giảm giá</th>
                                                            <th>Giá trị giảm</th>
                                                            <th>Giá trị lớn nhất</th>
                                                            <th>Voucher/Coupon limit</th>
                                                            <th>Áp dụng total bill</th>
                                                            <th>Ngày bắt đầu hiệu lực</th>
                                                            <th>Ngày hết hiệu lực</th>
                                                            <th>Ngày cập nhật</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Tab: Voucher/Coupon Line -->

                            <div class="tab-pane" id="tab-voucher-coupon-line">
                            @using (Html.BeginForm("ExportVoucherLineList", "Voucher", FormMethod.Post, new { id = "frm-export-excel-voucher-line" }))
                            {
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Serial Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-serial-voucher-line" name="SerialVoucherLine" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-no-voucher-line" name="NoVoucherLine" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Tên Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-name-voucher-line" name="NameVoucherLine" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã sản phẩm</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-no-voucher-line" name="LineItemNo" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã Barcode</label>
                                                        <div class="form-group">
                                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-barcode-voucher-line" name="BarcodeVoucherLine" />
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại Voucher/Coupon</label>
                                                        <div class="form-group">
                                                            <select class="form-control select2" id="sel-voucher-line-type" name="TypeVoucherLine">
                                                                <option value="-1" selected>Tất cả</option>
                                                                @if (listCouponType != null && listCouponType.Count > 0)
                                                                {
                                                                    foreach (var item in listCouponType)
                                                                    {
                                                                        <option value="@item.Value">@item.Text</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Trạng thái</label>
                                                        <div class="form-group">
                                                            <select class="form-control select2" id="sel-voucher-line-status" name="StatusVoucherLine">
                                                                <option value="-1" selected>Tất cả</option>
                                                                <option value="0">Có hiệu lực</option>
                                                                <option value="1">Hết hiệu lực</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <input type="hidden" id="txt-pkey-voucher-line" name="PkeyVoucherLine" />
                                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px">
                                                        <button type="button" id="btn-search-voucher-line" class="btn btn-primary" style="color: #ffffff;cursor:pointer;"><i class="fa fa-search"></i> Tìm kiếm</button>
                                                        <button type="button" id="btn-export-excel-voucher-line" class="btn btn-success" style="color: #ffffff;cursor:pointer;"><i class="fa fa-file-excel"></i>Xuất excel</button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                }

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                                            <div class="card-body">
                                                <table class="table table-bordered table-hover text-nowrap" id="table-list-voucher-line">
                                                    <thead>
                                                        <tr class="text-center" style="text-transform:uppercase;">
                                                            <th width="80px;">#</th>
                                                            <th width="80px;">STT</th>
                                                            <th width="450px;">Số serial Voucher/Coupon</th>
                                                            <th width="4500px;">Mã Voucher/Coupon</th>
                                                            <th width="450px;" style="text-align:center;">Tên Voucher/Coupon</th>
                                                            <th width="150px;" style="text-align:center;">Loại Voucher/Coupon</th>
                                                            <th width="150px;">Trạng thái</th>
                                                            <th width="1500px;">Mã Barcode</th>
                                                            <th width="150px;">Mã sản phẩm</th>
                                                            <th width="450px;" style="text-align:center;">Tên sản phẩm</th>
                                                            <th width="150px;">ĐVT</th>
                                                            <th width="450px;">Pkey</th> 
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>


                        </div>
                        
                    </div>
                    
                </div>
                <!-- /.card -->
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal-update-voucher-header" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title-use-item">Cập nhật thông tin Voucher/Coupon Header</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="modal-update-voucher-header-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                            <div class="card-body">

                                <div class="row">
                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Số Serial Voucher/Coupon</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-serial-voucher" name="UpdateSerialVoucher" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã Voucher/Coupon</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-code-voucher" name="UpdateCodeVoucher" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Tên Voucher/Coupon</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-name-voucher" name="UpdateNameVoucher" disabled />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại Voucher/Coupon</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-update-type-voucher" name="UpdateTypeVoucher" disabled>
                                                <option value="-1" selected>--- Chọn ---</option>
                                                @if (listCouponType != null && listCouponType.Count > 0)
                                                {
                                                    foreach (var item in listCouponType)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại giảm giá</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-update-type-discount" name="UpdateDiscountType" disabled>
                                                <option value="" selected>--- Chọn ---</option>
                                                <option value="1">Percent (%)</option>
                                                <option value="2">Amount</option>
                                                <option value="0"></option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Đơn vị tính</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-update-unit-voucher" name="UpdateUnitVoucher" disabled>
                                                <option value="-1" selected>--- Chọn ---</option>
                                                @if (listUnits != null && listUnits.Count > 0)
                                                {
                                                    foreach (var item in listUnits)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 400; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Trạng thái</label>
                                        <div class="form-group">
                                            <select class="form-control select2" id="sel-update-status-voucher" name="UpdateStatusVoucher">
                                                <option value="-1" selected>--- Chọn ---</option>
                                                <option value="0">Có hiệu lực</option>
                                                <option value="1">Hết hiệu lực</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị voucher/coupon</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-value-voucher" name="UpdateValueVoucher" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị giảm</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-value-discount" name="UpdateValueDiscount" disabled />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Giá trị lớn nhất</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-max-value" name="UpdateMaxValue" />
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Voucher/Coupon limit</label>
                                        <div class="form-group">
                                            <input type="text" class="form-control pull-right" style="width:100%;" id="txt-update-limit-value" name="UpdateLimitValue" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày bắt đầu hiệu lực</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-update-starting-date" name="StartingDate" placeholder="">
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                        <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Ngày kết thúc hiệu lực</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-update-ending-date" name="EndingDate" placeholder="">
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="display: inline-block; padding-top: 37px;">
                                        <input type="checkbox" id="chk-update-total-bill" style="height:25px; width:25px; cursor:pointer; padding-top: 5px; margin-left: 1px;">
                                        <label for="chk-update-total-bill" style="font-size:11px; margin-top: 10px; position: absolute; padding-left: 7px;">Áp dụng tổng bill</label>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

