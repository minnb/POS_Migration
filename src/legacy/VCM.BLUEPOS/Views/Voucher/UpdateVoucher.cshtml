@section Scripts
{
    <script type="text/javascript">
        var table_voucher_header;
        var table_voucher_line;

        //
        function UpdateVoucherHeader() {
            //debugger
            var _noVoucher = $('#txt-update-code-voucher').val();
            var _serialVoucher = $('#txt-update-serial-voucher').val();
            var _nameVoucher = $('#txt-update-name-voucher').val();
            var _valueVoucher =  $('#txt-update-value-voucher').val();
            var _discountValue = $('#txt-update-value-discount').val();
            var _maxValue = $('#txt-update-max-value').val();
            var _limitValue = $('#txt-update-limit-value').val();
            var _typeVoucher = $('#sel-update-type-voucher').val();
            var _typeDiscount = $('#sel-update-type-discount').val();
            var _unitVoucher = $('#sel-update-unit-voucher').val();
            var _statusVoucher =  $('#sel-update-status-voucher').val();
            var _startingDateStr = $('#txt-update-starting-date').val();
            var _endingDateStr = $('#txt-update-ending-date').val();
            var _checkTotalBill = $('#chk-update-total-bill').prop('checked');

            if (_maxValue == null || _maxValue == "") {
                toastr.warning("Vui lòng nhập giá trị lớn nhất");
                return;
            }
            else {
                if (_maxValue > 99999999) {
                    toastr.warning("Giá trị lớn nhất không lớn hơn 99.999.999");
                    return;
                }
                else if (_maxValue < 1) {
                    toastr.warning("Giá trị lớn nhất phải là số nguyên dương (>0)");
                    return;
                }
            }

            if (_limitValue > 99999999) {
                toastr.warning("Giá trị voucher limit không lớn hơn 99.999.999");
                return;
            }
            else if (_limitValue < 1) {
                toastr.warning("Giá trị voucher limit phải là số nguyên dương (>0)");
                return;
            }

            if (_startingDateStr == null || _startingDateStr == "") {
                toastr.warning("Vui lòng nhập ngày bắt đầu hiệu lực");
                return;
            }

            if (_endingDateStr == null || _endingDateStr == "") {
                toastr.warning("Vui lòng nhập ngày hết hiệu lực");
                return;
            }

            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateVoucherHeader", "Voucher")',
                type: "POST",
                dataType: "json",
                data: {
                        ItemNo: _noVoucher,
                        CouponCode: _serialVoucher,
                        ItemName: _nameVoucher,
                        UnitOfMeasure: _unitVoucher,
                        DiscountType: _typeDiscount,
                        DiscountValue: _discountValue,
                        ValueOfVoucher: _valueVoucher,
                        MaxAmount: _maxValue,
                        LimitQty: _limitValue,
                        ArticleType: _typeVoucher,
                        BlockedStr: _statusVoucher,
                        IsCheckItem: _checkTotalBill,
                        StartingDateStr: _startingDateStr,
                        EndingDateStr: _endingDateStr
                },
                success: function (data) {
                        //debugger
                        $('#btn-search-voucher-header').trigger('click');
                        loading.hideloading();

                        if (data.Status = 1) {
                            toastr.success(data.Message);
                            $('#modal-update-voucher-header').modal("hide");
                        }
                        else if (data.Status = 2) {
                            toastr.warning(data.Message);
                        }
                        else if (data.Status = 3) {
                            toastr.error(data.Message);
                        }
                        else if (data.Status = 4) {
                            toastr.error(data.Message);
                        }
                },
                error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                }
            });
        }

        //
        function UpdateVoucherLine() {
            //debugger
            var _pkey = $('#txt-pkey-voucher-line').val();
            var _itemNo = $('#txt-update-no-voucher-line').val();
            var _lineItemNo = $('#txt-update-item-no-voucher-line').val();
