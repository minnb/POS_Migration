@section Scripts
{
    <script type="text/javascript">

        var table = "";
        var table_detail_offer_header;
        var table_detail_offer_buy;
        var table_detail_offer_benefits;
        var table_detail_offer_get;
        var table_detail_offer_site;
        var table_detail_offer_priority;

        function ExportExcelByOfferBuy() {
            var offerNo = $('#offer-no').val();
            loading.showloading();
            var req = new XMLHttpRequest();
            var url = "/Promotion/ExportToExcel_PromotionOfferBuy?OfferNo=" + offerNo;
            req.open("GET", url, true);
            req.responseType = "blob";
            req.onload = function (event) {
                var blob = req.response;
                console.log(blob.size);
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "OfferBuyList_" + fileName + ".xlsx";
                link.click();
                loading.hideloading();
            };
            req.send();
        }

        function ExportExcelByOfferGet() {
            var offerNo = $('#offer-no').val();
            loading.showloading();
            var req = new XMLHttpRequest();
            var url = "/Promotion/ExportToExcel_PromotionOfferGet?OfferNo=" + offerNo;
            req.open("GET", url, true);
            req.responseType = "blob";
            req.onload = function (event) {
                var blob = req.response;
                console.log(blob.size);
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "OfferGetList_" + fileName + ".xlsx";
                link.click();
                loading.hideloading();
            };
            req.send();
        }

        function ExportExcelByOfferSite() {
            var offerNo = $('#offer-no').val();
            loading.showloading();
            var req = new XMLHttpRequest();
            var url = "/Promotion/ExportToExcel_PromotionOfferSite?OfferNo=" + offerNo;
            req.open("GET", url, true);
            req.responseType = "blob";
            req.onload = function (event) {
                var blob = req.response;
                console.log(blob.size);
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                var d = new Date();
                var fileName = d.getFullYear() + "" + (d.getMonth() + 1) + "" + d.getDate() + "" + d.getHours() + "" + d.getMinutes() + "" + d.getSeconds();
                link.download = "OfferSiteList_" + fileName + ".xlsx";
                link.click();
                loading.hideloading();
            };
            req.send();
        }

        $(document).ready(function () {

            $('.select2').select2();

            // Chuyển chuỗi kí tự (string) sang đối tượng Date()
            function parseDate(str) {
                var mdy = str.split('/');
                return new Date(mdy[2], mdy[1], mdy[0]);
            }

            $('.example-preview .nav-tabs li a').click(function () {
                $("#detail-offer-header-table").DataTable().ajax.reload();
                $("#detail-offer-buy-table").DataTable().ajax.reload();
                $("#detail-offer-get-table").DataTable().ajax.reload();
                $("#detail-offer-benefits-table").DataTable().ajax.reload();
                $("#detail-offer-site-table").DataTable().ajax.reload();
                $("#detail-offer-priotity-table").DataTable().ajax.reload();
            });

            $('#modal-view-detail-promotion').on('shown.bs.modal', function () {
                $('.example-preview .nav-tabs li:first-child a').trigger('click');
            })

            table = $('#tbl-promotion-offer-header').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    // Xem chi tiet khuyen mai
                    $(".btn-view-detail").click(function () {
                        var _offerNo = $(this).attr("data-offerNo");
                        var _offerType = $(this).attr("data-offerType");
                        $('#offer-no').val(_offerNo);
                        $('#offer-type').val(_offerType);

                        $('#modal-view-detail-promotion').modal({
                            backdrop: 'static',
                            keyboard: true
                        });
                    });
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              
                serverSide: true,               
                filter: false,                  
                orderMulti: false,            
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                language: {
                    zeroRecords: "Không có dữ liệu"
                },

                ajax: {
                    url: '@Url.Action("GetOfferHeaderList", "Promotion")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.TextSearch = $('#text-search').val();
                        d.PromotionName = $('#promotion-name').val();
                        d.PromotionStatus = $('#promotion-status').val();
                        d.PromotionTypes = $('#promotion-type').val();
                        d.ItemNo = $('#item-no').val();
                        d.SalesType = $('#sel-sales-type').val();
                    }
                },

                columns: [
                    {
                        render: function (data, type, row) {
