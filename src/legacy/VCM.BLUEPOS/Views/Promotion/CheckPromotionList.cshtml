@using VCM.BLUEPOS.Model.Promotion;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Model.SetupPromotion;

@{
    ViewBag.Title = "Tra cứu khuyến mãi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listStore = ViewBag.ListStore as List<ArraySiteNoModel>;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;
    var lstPromotionType = ViewBag.ListPromotionType as List<OptionModel>;
    var lstPromotionStatus = ViewBag.ListPromotionStatus as List<OptionModel>;
    var model = Model as SetupMainModel;
    var listSalesType = model.ListSalesType;
    var listOfferType = model.ListOfferType;
}

<style>
    .detailSize:hover {
        background-color: yellow;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Khuyến mãi</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Tra cứu khuyến mãi</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcel_CheckPromotion", "Promotion", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Nguồn dữ liệu<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-source-type" name="SourceType">
                                            <option value="SERVER" selected>CENTRAL</option>
                                            <option value="POS">POS</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-store-no" name="StoreNo">
                                            @if (listStore != null && listStore.Count() > 0)
                                            {
                                                if (listStore.Count == 1)
                                                {
                                                    <option value="@listStore.FirstOrDefault().SiteNo" data-array="@listStore.FirstOrDefault().ValueJson">@listStore.FirstOrDefault().SiteNo - @listStore.FirstOrDefault().SiteName</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listStore)
                                                    {
                                                        var storeName = string.IsNullOrEmpty(item.SiteName) ? item.SiteNo : item.SiteName;
                                                        <option value="@item.SiteNo" data-array="@item.ValueJson">@item.SiteNo - @storeName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-pos-terminal" name="IPAddress" disabled></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Loại CTKM<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-promotion-type" name="OfferType">
                                            @if (listOfferType != null && listOfferType.Count > 0)
                                            {
                                                <option value="" selected>Tất cả</option>
                                                foreach (var item in listOfferType)
                                                {
                                                    var displaySelect = $"{item.OfferType1} : {item.OfferName}";
                                                    <option value="@item.OfferType1" data-totalbill="@item.IsTotalBill" data-setupbuy="@item.IsSetupBuy" data-setupget="@item.IsSetupGet" data-voucher="@item.IsVoucher">@displaySelect</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Hình thức bán hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-sales-type" name="SalesType">
                                            @if (listSalesType != null && listSalesType.Count > 0)
                                            {
                                                <option value="" selected>Tất cả</option>
                                                <option value="ALL">ALL</option>
                                                foreach (var item in listSalesType)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Hạng thẻ<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-member-type" name="MemberType">
                                            <option value="" selected>Tất cả</option>
                                            <option value="Vip">Vip</option>
                                            <option value="Diamond">Diamond</option>
                                            <option value="Member">Member</option>
                                            <option value="All">All loại thẻ</option>
                                            <option value="0">Không áp dụng</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Trạng thái<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" id="sel-promotion-status" name="Status">
                                            <option value="">Tất cả</option>
                                            <option value="0" selected>Có hiệu lực</option>
                                            <option value="2">Hết hiệu lực</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Bonus Buy / Mã CTKM<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-offer-no" name="OfferNo" placeholder="Nhập mã Bonus Buy / mã CTKM">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mã sản phẩm</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-item-no" name="ItemNo" placeholder="Nhập mã sản phẩm">
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txt-key-word" name="KeyWord" placeholder="Nhập tên CTKM / barcode">
                                    </div>
                                </div>

                                <input type="hidden" id="offer-no" value="">
                                <input type="hidden" id="offer-type" value="">

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-primary" id="btn-search" name="btnSearch" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-search"></i> Tìm kiếm</button>
                                        <a class="btn btn-success" id="btn-export-excel" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-file-excel"></i> Xuất Excel</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="card-scroll" style="">
                            <table id="tbl-check-promotion-list" class="table table-bordered table-hover text-nowrap">
                                <thead>
                                    <tr class="text-center" style="text-transform:uppercase;">
                                        <th>STT</th>
                                        <th>ST/CH</th>
                                        <th>Bonus Buy</th>
                                        <th>Mã CTKM</th>
                                        <th>Tên CTKM</th>
                                        <th>Loại CTKM</th>
                                        <th>Loại giảm giá</th>
                                        <th>Hình thức bán hàng</th>
                                        <th>Trạng thái</th>
                                        <th>Barcode</th>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>ĐVT</th>
                                        <th>Đơn giá</th>
                                        <th>Giảm giá</th>
                                        <th>Thành tiền</th>
                                        <th>Ngày bắt đầu có hiệu lực</th>
                                        <th>Ngày bắt đầu hết hiệu lực</th>
                                        <th>Thẻ thành viên</th>
                                        <th>Hạng thẻ</th>
                                        <th>Ngày cập nhật</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="modal-detail-promotion-check">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="title-detail-promotion-check" style="font-weight:bold">DANH SÁCH CHI TIẾT KHUYẾN MÃI</span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" id="div-detail-promotion-check"></div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Thoát</button>
            </div>

        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">
        var table = "";
        $('.select2').select2();

        function LoadPOSTerminalByStoreNo(typeQuery,storeNo) {
            if (typeQuery == "POS") {
                var html = "<option value=''>Chọn máy POS</option>";
                var fromData = new FormData();
                fromData.append('StoreNo', storeNo);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadPOSTerminalByStore", "Common")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data != null) {
                            data.forEach((name, i) => {
                                if (name.IpAddress != "") {
                                    html += "<option value=" + name.IpAddress + ">" + name.PosID + " - " + name.IpAddress + "</option>";
                                }
                            });
                            $("#sel-pos-terminal").html(html);
                        }
                    },
                    error: function () {
                    }
                });
            }
            else
            {
                var html = "<option value=''>Chọn máy POS</option>";
                $("#sel-pos-terminal").html(html);
            }
        }

        $('#btn-search').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-offer-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('input[name = btnSearch]').focus();
                return false;
            }
        });

        $('#txt-item-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('input[name = btnSearch]').focus();
                return false;
            }
        });

        $('#txt-key-word').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('input[name = btnSearch]').focus();
                return false;
            }
        });


        $(document).ready(function () {

            $(".select2").select2();

            $(".detailSize").on("click", function (e) {
                //debugger
                var bonusbuyNo = $(this).attr("data-bonusbuy-no");
                var promotionNo = $(this).attr("data-promotion-no");
                var barcodeNo = $(this).attr("data-barcode-no");
                var itemNo = $(this).attr("data-item-no");
                loading.showloading();
                $.ajax({
                    type: "GET",
                    url: "/Promotion/_ViewPromotionCheckForItem?bonusbuyNo=" + bonusbuyNo + "&promotionNo=" + promotionNo + "&barcodeNo=" + barcodeNo + "&itemNo=" + itemNo +"",
                    dataType: 'html',
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        $("#title-detail-promotion-check").html("DANH SÁCH CHI TIẾT KHUYẾN MÃI");
                        $("#div-detail-promotion-check").html(result);
                        $('#modal-detail-promotion-check').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                        loading.hideloading();
                    },
                    error: function (event) {
                        loading.hideloading();
                    }
                });

            });

            LoadPOSTerminalByStoreNo("SERVER", $("#sel-store-no").val());
            $("#sel-source-type").on("change", function (e) {
                if ($(this).val() == "POS") {
                    $('#sel-pos-terminal').prop('disabled', false);
                    LoadPOSTerminalByStoreNo($("#sel-source-type").val(), $("#sel-store-no").val());
                }
                else if ($(this).val() == "SERVER") {
                    $('#sel-pos-terminal').val('').trigger('change');
                    $('#sel-pos-terminal').prop('disabled', true);
                }
            });

            $("#sel-store-no").on("change", function (e) {
                if ($("#sel-source-type").val() == "POS") {
                    LoadPOSTerminalByStoreNo($("#sel-source-type").val(), $("#sel-store-no").val());
                }
            });

            table = $('#tbl-check-promotion-list').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: false,                  // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,
                language: {
                    zeroRecords: "Không có dữ liệu"
                },

                ajax: {
                    url: '@Url.Action("LoadCheckPromotionList", "Promotion")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.IPAddress = $('#sel-pos-terminal').val();
                        d.SourceType = $('#sel-source-type').val();
                        d.StoreNo = $('#sel-store-no').val();
                        d.PromotionStatus = $('#sel-promotion-status').val();
                        d.PromotionTypes = $('#sel-promotion-type').val();
                        d.OfferNo = $('#txt-offer-no').val();
                        d.ItemNo = $('#txt-item-no').val();
                        d.KeyWord = $('#txt-key-word').val();
                        d.SalesType = $('#sel-sales-type').val();
                        d.MemberType = $('#sel-member-type').val();
                    }
                },

                columns: [

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: "text-center"
                    },

                    {
                        data: "BonusbuyNo",
                        className: "text-center",
                        render: function (data, type, row) {
                            //debugger
                            var _bonusbuyNo = row.BonusbuyNo;
                            var _promotionNo = row.PromotionNo;
                            var _itemNo = row.ItemNo;
                            var _barcodeNo = row.Barcode;
                            var html = "";
                            if (row.BonusbuyNo == null || row.BonusbuyNo == "") {
                                html += '<span  class="detailSize"  style="font-weight:700;display: block;text-align:center;color:#0C713D;cursor:pointer;" data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no =' + _promotionNo + ' data-barcode-no =' + _barcodeNo + '  data-item-no =' + _itemNo + '>' + "" + '</span>';
                            }
                            else {
                                html += '<span  class="detailSize" style="font-weight:700;display: block;text-align:center;color:#0C713D;cursor:pointer;" data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no =' + _promotionNo + ' data-barcode-no =' + _barcodeNo + '  data-item-no =' + _itemNo + '>' + row.BonusbuyNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "PromotionNo",
                        render: function (data, type, row) {
                            var _bonusbuyNo = row.BonusbuyNo;
                            var _promotionNo = row.PromotionNo;
                            var _itemNo = row.ItemNo;
                            var _barcodeNo = row.Barcode;
                            var html = "";
                            if (row.PromotionNo == null || row.PromotionNo == "") {
                                html = '<span class="detailSize" style="font-weight:700;display:block;text-align:center;cursor:pointer;" data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no =' + _promotionNo + ' data-barcode-no =' + _barcodeNo + '  data-item-no =' + _itemNo + '>' + "" + '</span>';
                            }
                            else {
                                html = '<span class="detailSize" style="font-weight:700;display:block;text-align:center;cursor:pointer;" data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no =' + _promotionNo + ' data-barcode-no =' + _barcodeNo + '  data-item-no =' + _itemNo + '>' + row.PromotionNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Description",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Description == null || row.Description == "") {
                                html += '<span style="font-weight:400;display: block;text-align:left;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:400;display: block;text-align:left;">' + row.Description + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "OfferType",      // Loại CTKM
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.OfferType == null || row.OfferType == "") {
                                html += '<span style="font-weight:700;display: block;text-align:center;color:#0C713D;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display: block;text-align:center;color:#0C713D;">' + row.OfferType + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "DiscountTypeStr",    // Loại giảm giá
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.DiscountTypeStr == null || row.DiscountTypeStr == "") {
                                html += '<span style="font-weight:700;display: block;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display: block;">' + row.DiscountTypeStr + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "SalesTypeName", // Hinh thuc ban hang
                        className: "text-center",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.SalesTypeName == null || row.SalesTypeName == "") {
                                html += '<span style="font-weight:700;display: block;text-align:center;color:#0C713D;">' + "" + '</span>';
                            }
                            else {
                                html += '<span style="font-weight:700;display: block;text-align:center;color:#0C713D;">' + row.SalesTypeName + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Status",
                        className: "text-center",
                        render: function (data, type, row) {
                            var _status = row.Status;
                            var html = "";
                            if (_status == "Có hiệu lực") {
                                html += '<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">' + _status + '</span>';
                            }
                            else {
                                html += '<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">' + _status + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "Barcode",
                        render: function (data, type, row) {
                            var _bonusbuyNo = row.BonusbuyNo;
                            var _promotionNo = row.PromotionNo;
                            var _itemNo = row.ItemNo;
                            var _barcodeNo = row.Barcode;
                            var html = "";
                            if (row.Barcode == null || row.Barcode == "") {
                                html += '<span class="detailSize" style="font-weight:700;display: block;text-align:center;color:#0C713D;"  data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no=' + _promotionNo + ' data-barcode-no=' + _barcodeNo + '  data-item-no=' + _itemNo + '>' + "" + '</span>';
                            }
                            else {
                                html += '<span class="detailSize" style="font-weight:700;display: block;text-align:center;color:#0C713D;" data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no=' + _promotionNo + ' data-barcode-no=' + _barcodeNo + '  data-item-no=' + _itemNo + '>' + row.Barcode + '</span>';
                            }
                            return html;
                        }
                    },

                    {
                        data: "ItemNo",
                        className: "text-center",
                        render: function (data, type, row) {
                            var _bonusbuyNo = row.BonusbuyNo;
                            var _promotionNo = row.PromotionNo;
                            var _itemNo = row.ItemNo;
                            var _barcodeNo = row.Barcode;
                            var html = "";
                            if (row.ItemNo == null || row.ItemNo == "") {
                                html += '<span class="detailSize" style="font-weight:700;display: block;text-align:center;"  data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no=' + _promotionNo + ' data-barcode-no=' + _barcodeNo + '  data-item-no=' + _itemNo + '>' + "" + '</span>';
                            }
                            else {
                                html += '<span class="detailSize" style="font-weight:700;display: block;text-align:center;"  data-bonusbuy-no =' + _bonusbuyNo + ' data-promotion-no=' + _promotionNo + ' data-barcode-no=' + _barcodeNo + '  data-item-no=' + _itemNo + '>' + row.ItemNo + '</span>';
                            }
                            return html;
                        }
                    },

                    {
