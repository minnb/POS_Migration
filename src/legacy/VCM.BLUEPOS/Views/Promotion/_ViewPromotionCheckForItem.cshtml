
@using VCM.BLUEPOS.Model.Promotion

@{
    var model = Model as List<ViewCheckPromotionModalModel>;
}

<div id="div-detail-promotion-check">
    @if (model != null && model.Count > 0)
    {
        <table class="table table-bordered text-nowrap" id="tbl-promotion-check-detail-list">
            <thead>
                <tr style="text-align:center">
                    <th>Trạng thái</th>
                    <th>Loại KM</th>
                    <th>Loại giảm giá</th>
                    <th>BonusBuy</th>
                    <th>Mã CTKM</th>
                    <th>Barcode</th>
                    <th>Mã sản phẩm</th>
                    <th>Tên sản phẩm</th>
                    <th>Size</th>
                    <th>ĐVT</th>
                    <th>Đơn giá</th>
                    <th>Giảm giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in model)
                {
                    <tr style="">
                        <td class="text-center">@item.Status</td>
                        <td class="text-center">@item.OfferType</td>
                        <td class="text-center">@item.DiscountType</td>
                        <td class="text-center">@item.BonusBuy</td>
                        <td class="text-center">@item.PromotionNo</td>
                        <td class="text-center">@item.Barcode</td>
                        <td class="text-center">@item.ItemNo</td>
                        <td class="text-center">@item.ItemName</td>
                        <td class="text-center">@item.Size</td>
                        <td class="text-center">@item.UOM</td>
                        <td class="text-center">@item.SalesPrice</td>
                        <td class="text-center">@item.DiscountValue</td>
                        <td class="text-center">@item.Amount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <strong style="font-size:16px;color:red">Không có dữ liệu</strong>
    }

</div>



