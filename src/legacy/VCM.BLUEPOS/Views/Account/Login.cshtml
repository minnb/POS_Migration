@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    @*<title>Đăng nhập hệ thống BÁN HÀNG</title>*@
    <title>Phúc Long - Đăng nhập</title>
    <link rel="shortcut icon" href="/Assets/img/logo/iconPLH.ico" type="image/x-icon">
    <link href="/Content/themekeen/css/pages/login/classic/login-1.css" rel="stylesheet" type="text/css" />
    <link href="/Content/themekeen/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="/Content/themekeen/css/style.bundle.css" rel="stylesheet" type="text/css" />
</head>

<body id="kt_body" class="header-fixed header-mobile-fixed header-bottom-enabled subheader-enabled page-loading">
    <div class="d-flex flex-column flex-root">
        <div class="login login-1 login-signin-on d-flex flex-column flex-lg-row flex-column-fluid bg-white" id="kt_login">
            <div class="login-aside d-flex flex-row-auto bgi-size-cover bgi-no-repeat p-10 p-lg-10" style="background-color:#0C713D !important">
                <div class="d-flex flex-row-fluid flex-column justify-content-between">
                    <div style="text-align:center;">
                        <img alt="Logo" src="~/Assets/img/logo/logoPL.png" class="max-w-250px" />
                    </div>
                    <div class="flex-column-fluid d-flex flex-column justify-content-center">
                        <h3 class="font-size-h1 mb-5 text-white">Hệ thống quản lý BÁN HÀNG</h3>
                    </div>
                    <div class="d-none flex-column-auto d-lg-flex justify-content-between mt-10">
                        <div class="opacity-100 font-weight-bold text-white">© 2022 CÔNG TY CỔ PHẦN PHÚC LONG <span style="color:orange;font-size:15px;"> HERITAGE</span></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-row-fluid position-relative p-7 overflow-hidden">
                <div class="d-flex flex-column-fluid flex-center mt-30 mt-lg-0">

                    <div class="login-form login-signin" style="margin-top:100px;">
                        <div class="text-center mb-10 mb-lg-20">
                            <h3 class="font-size-h1">
                            <span style="color:orange;font-size:25px;font-weight:700;">ĐĂNG NHẬP</span></h3>
                        </div>

                        <div>
                            <div class="form-group">
                                <select id="slTypeLogin" name="LoginType" class="form-control form-control-solid h-auto py-5 px-6 select2">
                                    <option value="LOCAL" selected>Tài khoản LOCAL</option>
                                    <option value="AD">Tài khoản AD</option>
                                    <option value="SSO">Microsoft Account</option>
                                </select>
                            </div>

                            <div style="height:450px;">
                                <div class="show-login" id="div-login-local">
                                    <form class="form" novalidate="novalidate" id="kt_login_signin_form" stype="margin:25px;">
                                        <div class="form-group">
                                            <input class="form-control form-control-solid h-auto py-5 px-6" type="text" placeholder="Username" name="username" id="Username" autocomplete="off" value="" />
                                        </div>
                                        <div class="form-group">
                                            <input class="form-control form-control-solid h-auto py-5 px-6" type="password" placeholder="Password" name="password" id="Password" autocomplete="off" value="" />
                                        </div>
                                        <div>
                                            <div class="form-group d-flex flex-wrap justify-content-between align-items-center">
                                                <a href="javascript:;" class="text-dark-50 text-hover-primary my-3 mr-2" id="kt_login_forgot"></a>
                                                <button type="button" id="kt_login_signin_submit" name="kt_login_signin_submit" class="btn btn-primary font-weight-bold py-4 my-3"><i class="fas fa-lock-open"></i> Đăng nhập</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                                <div class="show-login" id="div-login-sso" style="display:none;">
                                    <div class="form-group text-center">
                                        <a href="@Url.Action("LoginWithMS365","Account")" class="btn btn-primary login_sso_ms_365" id="login_sso_ms_365" style="font-size: 13px;">
                                            <img src="/Assets/img/logo/logo_microsoft.png" width="25" height="25">
                                            Đăng nhập với Microsoft Account
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
        </div>
            </div>
    </div>

    <script>var KTAppSettings = { "breakpoints": { "sm": 576, "md": 768, "lg": 992, "xl": 1200, "xxl": 1200 }, "colors": { "theme": { "base": { "white": "#ffffff", "primary": "#6993FF", "secondary": "#E5EAEE", "success": "#1BC5BD", "info": "#8950FC", "warning": "#FFA800", "danger": "#F64E60", "light": "#F3F6F9", "dark": "#212121" }, "light": { "white": "#ffffff", "primary": "#E1E9FF", "secondary": "#ECF0F3", "success": "#C9F7F5", "info": "#EEE5FF", "warning": "#FFF4DE", "danger": "#FFE2E5", "light": "#F3F6F9", "dark": "#D6D6E0" }, "inverse": { "white": "#ffffff", "primary": "#ffffff", "secondary": "#212121", "success": "#ffffff", "info": "#ffffff", "warning": "#ffffff", "danger": "#ffffff", "light": "#464E5F", "dark": "#ffffff" } }, "gray": { "gray-100": "#F3F6F9", "gray-200": "#ECF0F3", "gray-300": "#E5EAEE", "gray-400": "#D6D6E0", "gray-500": "#B5B5C3", "gray-600": "#80808F", "gray-700": "#464E5F", "gray-800": "#1B283F", "gray-900": "#212121" } }, "font-family": "Poppins" };</script>
    <script src="~/Content/themekeen/plugins/global/plugins.bundle.js"></script>
    <script src="~/Content/themekeen/js/scripts.bundle.js"></script>
    <script src="~/Content/themekeen/js/pages/features/miscellaneous/blockui.js"></script>
    <script src="~/Content/login.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            $('.select2').select2();
            $('input[name = username]').focus();
            $('#Username').keypress(function (e) {
                var key = e.which;
                if (key == 13) {
                    $('input[name = password]').focus();
                    return false;
                }
            });

            $('#Password').keypress(function (e) {
                var key = e.which;
                if (key == 13) {
                    $('button[name = kt_login_signin_submit]').click();
                    return false;
                }
            });

            $("#div-login-local").removeClass('show-login');

            $('#slTypeLogin').on("change", function (e) {               
                $("#div-login-local").addClass('show-login');
                var typeLogin = $("#slTypeLogin").val();
                if (typeLogin == "SSO") {
                    $("#div-login-local").addClass("show-login");
                    $("#div-login-sso").show();
                }
                else if (typeLogin == "LOCAL" || typeLogin == "AD") {
                    $("#div-login-local").removeClass("show-login");
                    $("#div-login-sso").hide();
                }
            });

        });

    </script>

</body>
</html>


<style>
  .show-login {
      display: none;
}
 </style>
