        function GetListProcess(IP,ProcessName) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn get list process IP ' + IP + ' không?',
                buttons: {
                    "OK": {
                        btnClass: 'btn btn-primary',
                        action: function () {
                            loading.showloading();
                            var fromData = new FormData();
                            fromData.append('IPAddress', IP);
                            fromData.append('ProcessName', ProcessName);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("GetListProcess", "MonitorPOS")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    //debugger
                                    if (data.Status == true) {                                        
                                        var html = "";
                                        html += "<table id=\"dtListProcess\" class=\"table table-bordered table-striped\" style=\"\">";
                                        html += "<thead>";

                                        html += "<tr style=\"background-color:#62b0fa;text-align:center;text-transform:uppercase;\">";
                                        html += "<th>Caption</th>";
                                        html += "<th>Name</th>";
                                        
                                        html += "<th>CSName</th>";
                                        html += "<th>Processid</th>";
                                        html += "<th>Memory</th>";
                                        html += "<th>Kill</th>";

                                        html += "</tr>";
                                        html += "</thead>";

                                        html += "<tbody>";
                                        var listProcess = data.ListProcess;
                                        listProcess.forEach((name, i) => {
                                            html += "<tr id=\"\">";
                                            html += "<td>" + name.Caption + "</td>";
                                            html += "<td>" + name.Name + "</td>";
                                            
                                            html += "<td>" + name.CSName + "</td>";
                                            html += "<td>" + name.Processid + "</td>";
                                            html += "<td>" + name.Memory + "</td>";
                                            html += "<td><button type=\"button\" class=\"btn btn-block btn-outline-danger btnKill\" onclick=\"KillProcess('" + IP + "','" + name.Name +"')\">Kill</button></td>";
                                            html += "</tr>";
                                        });
                                        html += "</tbody>";
                                        html += "</table>";

                                        $('#listResult2').html(html);
                                        $("#titleProcess2").html("DANH SÁCH PROCESS");
                                        $('#dtListProcess').DataTable(
                                            {
                                                paging: true,
                                                processing: true,           // for show progress bar
                                                lengthChange: false,
                                                filter: true,
                                                displayLength: 8,
                                                searching: true,
                                                ordering: false,
                                                autoWidth: false,
                                                scrollCollapse: false,
                                                scrollX: false
                                            })

                                        $('#modal-list-process-1').modal({
                                            backdrop: 'static',
                                            keyboard: false
                                        });
                                    }
                                    else {
                                        toastr.error(data.Message);
                                    }
                                    loading.hideloading();
                                },
                                error: function (e) {
                                    //debugger
                                    loading.hideloading();
                                }
                            });
                        }
                    },
                    "Cancel": {
                        btnClass: 'btn-default',
                        action: function () {
                        }
                    }
                }
            });
        }


