@using VCM.BLUEPOS.Model.MonitorPOS;

@{
    ViewBag.Title = "MonitorPOS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Monitor POS</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Trạng thái máy POS</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("", "MonitorPOS", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mã ST/CH</label>
                                    <div class="form-group">
                                        <input type="text" id="txt-store-no" placeholder="Nhập mã ST/CH" class="form-control keyPress">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">IPAddress</label>
                                    <div class="form-group">
                                        <input type="text" id="txt-ip-address" placeholder="Nhập địa chỉ IP" class="form-control keyPress">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">ComputerName</label>
                                    <div class="form-group">
                                        <input type="text" id="txt-computer-name" placeholder="Nhập tên máy tính" class="form-control keyPress">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">StatusDB</label>
                                    <div class="form-group">
                                        <select class="form-control select2 keyPress" style="width:100%;" id="sel-status-db">
                                            <option value="">Tất cả</option>
                                            <option value="1">Connect</option>
                                            <option value="0">Disconnect</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">StatusPOS</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status-pos">
                                            <option value="">Tất cả</option>
                                            <option value="1">Open</option>
                                            <option value="0">Closed</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">StatusJOB</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-status-online">
                                            <option value="">Tất cả</option>
                                            <option value="1">Online</option>
                                            <option value="0">Offline</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">VersionPOS</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-warning valueOperationPOS" data-toggle="dropdown">
                                                <div id="opePOS">=</div>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li class="dropdown-item dropPOS" data-operationPOS="=">=</li>
                                                <li class="dropdown-item dropPOS" data-operationPOS="<"><</li>
                                                <li class="dropdown-item dropPOS" data-operationPOS=">">></li>
                                                <li class="dropdown-item dropPOS" data-operationPOS="#">#</li>
                                            </ul>
                                        </div>
                                        <input type="text" id="txt-version-pos" placeholder="Nhập version POS" class="form-control keyPress">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">VersionJOB</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-warning valueOperationJOB" data-toggle="dropdown">
                                                <div id="opeJOB">=</div>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li class="dropdown-item dropJOB" data-operationJOB="="><a>=</a></li>
                                                <li class="dropdown-item dropJOB" data-operationJOB="<"><a><</a></li>
                                                <li class="dropdown-item dropJOB" data-operationJOB=">"><a>></a></li>
                                                <li class="dropdown-item dropJOB" data-operationJOB="#"><a>#</a></li>
                                            </ul>
                                        </div>
                                        <input type="text" id="txt-version-job" placeholder="Nhập version JOB" class="form-control keyPress">
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search"  name="btnSearch" class="btn btn-primary"><i class="fa fa-search"></i> Tìm kiếm</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table class="table table-bordered text-nowrap row-border order-column" id="tbl-monitor-pos-list">
                            <thead>
                                <tr class="text-center" style="text-align:center;text-transform:uppercase;">
                                    <th style="">#</th>
                                    <th>StatusDB</th>
                                    <th>OpenPos</th>
                                    <th>StatusJob</th>
                                    <th>StoreNo</th>
                                    <th>PosTerminal</th>
                                    <th>IPAddress</th>
                                    <th>ComputerName</th>
                                    <th>PosVer</th>
                                    <th>JobVer</th>
                                    <th>ScriptVer</th>
                                    <th>PosDateTime</th>
                                    <th>PosAll</th>
                                    <th>PosChange</th>
                                    <th>LastEvent</th>
                                    <th>IntervalJob</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modal-list-process-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;font-weight:bold" id="titleProcess2">DANH SÁCH PROCESS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <div id="listResult2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-list-process-2">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;font-weight:bold" id="titleProcess">DANH SÁCH KILL PROCESS</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <div id="listResult"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">
        var table = "";
        $(document).ready(function () {
             $('.select2').select2();
             LoadMonitorPOS();
             MenuContext();
        });

        $('#txt-store-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-ip-address').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-computer-name').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('.keyPress').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                table.draw();
            }
        });

        $('.dropPOS').on("click",function (e) {
            var val = $(this).attr("data-operationPOS");
            $("#opePOS").html(val);
        });

        $('.dropJOB').on("click", function (e) {
            var val = $(this).attr("data-operationJOB");
            $("#opeJOB").html(val);
        });

        $("#btn-search").on("click", function (e) {
            table.draw();
        });

        function LoadMonitorPOS() {
            table = $('#tbl-monitor-pos-list').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: false,              // for show progress bar
                serverSide: true,               // for process server side
                filter: false,                  // this is for disable filter (search box)
                orderMulti: false,              // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 20,
                searching: false,
                lengthChange: false,
                scrollCollapse: false,
                scrollX: true,

                ajax: {
                    url: '@Url.Action("MonitorPOSLoad", "MonitorPOS")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo = $("#txt-store-no").val();
                        d.IpAddress = $("#txt-ip-address").val();
                        d.ComputerName = $("#txt-computer-name").val();
                        d.BluePosDatabaseStatus = $("#sel-status-db").val();
                        d.IsOpenBluePos = $("#sel-status-pos").val();
                        d.IsOnline = $("#sel-status-online").val();
                        d.JobVersion = $("#txt-version-job").val();
                        d.BluePosVersion = $("#txt-version-pos").val();
                        d.OperationPOS = $("#opePOS").html();
                        d.OperationJOB = $("#opeJOB").html();
                    }
                },

                columns: [
                    {
                        className: 'text-center',
                        render: function (data, type, full, meta) {
                            var html = "";
                            html += "<a href=\"javascript:;\" class=\"btn btn-default\" data-toggle=\"dropdown\" style=\"padding-top: .200rem; padding-left: .200rem; padding-right: .200rem; padding-bottom: .200rem;\">";
                            html += "<i class=\"fas fa-tools\" style=\"text-align: center; margin-left: 5px; color: #0b8beb\"></i>";
                            html += "</a>";

                            html += "<div class=\"dropdown-menu dropdown-menu-sm dropdown-menu-right\">";
                            html += "<ul class=\"nav nav-hoverable flex-column\">";

                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"PingIP('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Ping IPAddress</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"CheckService('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Check Service</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"StartService('" + full.IpAddress + "', 'Start')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Start Service</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"StartService('" + full.IpAddress + "', 'Stop')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Stop Service</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"RestartPC('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Restart PC</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"CheckPeformance('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Check Peformance</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"GetListProcess('" + full.IpAddress +"','BLUEPOS')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">List Process</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"FilePOS('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">File POS</span></a></li>";
                            html += "<li class=\"nav-item\"><a class=\"nav-link\" style=\"cursor:pointer\" onclick=\"DeleteIP('" + full.IpAddress +"')\"><i class=\"nav-icon fas fa-info-circle\"></i><span class=\"nav-text\">Delete IPAddress</span></a></li>";

                            html += "</ul>";
                            html += "</div>";
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.BluePosDatabaseStatus == true)
                                html = "<span class=\"badge bg-success\" style='color: #fff;'>Connected</span>";
                            else
                                html = "<span class=\"badge bg-danger\" style='color: #fff;'>Disconnected</span>";
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.IsOpenBluePos == true)
                                html = "<span class=\"badge bg-success\" style='color: #fff;'>Open</span>";
                            else
                                html = "<span class=\"badge bg-danger\" style='color: #fff;'>Close</span>";
                            return html;
                        }
                    },

                    {
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = "";
                            if (row.JobOnline == true)
                                html = "<span class=\"badge bg-success\" style='color: #fff;'>Online</span>";
                            else
                                html = "<span class=\"badge bg-danger\" style='color: #fff;'>Offline</span>";
                            return html;
                        }
                    },

                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },

                    {
                        data: "PosTerminalID",
                        className: 'text-center'
                    },

                    {
                        data: "IpAddress",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display:block;font-weight:700;">' + row.IpAddress + '</span>';
                        }
                    },

                    {
                        data: "ComputerName",
                        className: 'text-center'
                    },

                    {
                        data: "BluePosVersion",
                        className: 'text-center'
                    },

                    {
                        data: "JobVersion",
                        className: 'text-center'
                    },

                    {
                        data: "ScriptVersion",
                        className: 'text-center'
                    },

                    {
                        data: "FormatDateTimePos",
                        className: 'text-center'
                    },

                    {
                        data: "FormatLastTimeInsertAll",
                        className: 'text-center'
                    },

                    {
                        data: "FormatLastTimeInsertChange",
                        className: 'text-center'
                    },

                    {
                        data: "FormatLastTimeEvent",
                        className: 'text-center'
                    },

                    {
                        data: "IntervalJob",
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }


        function DeleteIP(IP) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn xóa IP (' + IP + ') này không?',
                buttons: {
                    "CÓ": {
                        btnClass: 'btn btn-default',
                        keys: ['ctrl'],
                        action: function () {
                            loading.showloading();
                            var fromData = new FormData();
                            fromData.append('IP', IP);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("DeleteMonitorIP", "MonitorPOS")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    if (data != null) {
                                        if (data.Item1 == 1) {
                                            table.draw();
                                            toastr.success(data.Item2);
                                        }
                                        else {
                                            toastr.error(data.Item2);
                                        }
                                    }
                                    loading.hideloading();
                                },
                                error: function () {
                                    loading.hideloading();
                                }
                            });
                        }
                    },
                    "KHÔNG": {
                        btnClass: 'btn-default',
                        action: function () { }
                    }
                }
            });
        }


        function PingIP(IP) {
            loading.showloading();
            var url = "@Url.Action("PingIP", "MonitorPOS")";
            $.ajax({
                url: url,
                data: { IPAddress: IP },
                cache: false,
                type: "POST",
                success: function (data) {
                    //debugger;
                    if (data.Status == true) {
                        toastr.success("Reply from " + data.IPAddress + " " + data.Message + "");
                    }
                    else {
                        toastr.error("Reply from " + data.IPAddress + " " + data.Message + "");
                    }
                    loading.hideloading();
                },
                error: function (xhr, status, error) {
                    loading.hideloading();
                    console.log(xhr.responseText);
                }

            });
        }

        function CheckService(IP) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn check service IP (' + IP + ') này không?',
                buttons: {
                    "JOB SERVICE": {
                        btnClass: 'btn btn-primary',
                        action: function () {
                            CallCheckService(IP, "BluePos.SyncData");
                        }
                    },
                    "SQL SERVICE": {
                        btnClass: 'btn-success',
                        action: function () {
                            CallCheckService(IP, "MSSQL$SQLEXPRESS");
                        }
                    },
                    "Cancel": {
                        btnClass: 'btn-default',
                        action: function () {
                        }
                    }
                }
            });
        }

        function CallCheckService(IP, ServiceName) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPAddress', IP);
            fromData.append('ServiceName', ServiceName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckService", "MonitorPOS")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == true) {
                        toastr.success(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function StartService(IP, Action) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn ' + Action + ' service IP (' + IP + ') này không?',
                buttons: {
                    "JOB SERVICE": {
                        btnClass: 'btn btn-primary',
                        action: function () {
                            CallStartService(IP, Action, "BluePos.SyncData");
                        }
                    },
                    "SQL SERVICE": {
                        btnClass: 'btn-success',
                        action: function () {
                            CallStartService(IP, Action, "MSSQL$SQLEXPRESS");
                        }
                    },
                    "Cancel": {
                        btnClass: 'btn-default',
                        action: function () {
                        }
                    }
                }
            });
        }

        function CallStartService(IP, Action, ServiceName) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPAddress', IP);
            fromData.append('Action', Action);
            fromData.append('ServiceName', ServiceName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("StartServiceByRemote", "MonitorPOS")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == true) {
                        toastr.success(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function KillProcess(IP, ServiceName) {
            loading.showloading();
            var fromData = new FormData();
            fromData.append('IPAddress', IP);
            fromData.append('ServiceName', ServiceName);
            $.ajax({
                type: "POST",
                url: '@Url.Action("KillProcess", "MonitorPOS")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Status == true) {
                        toastr.success(data.Message);
                    }
                    else {
                        toastr.error(data.Message);
                    }
                    loading.hideloading();
                },
                error: function () {
                    loading.hideloading();
                }
            });
        }

        function CheckPeformance(IP) {
            $.confirm({
                backgroundDismiss: false,
                escapeKey: true,
                icon: 'fa fa-warning',
                type: 'red',
                typeAnimated: true,
                title: 'Thông báo',
                content: 'Bạn có chắc chắn xem peformance IP ' + IP + ' không?',
                buttons: {
                    "OK": {
                        btnClass: 'btn btn-primary',
                        action: function () {
                            loading.showloading();
                            var fromData = new FormData();
                            fromData.append('IPAddress', IP);
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("CheckPeformance", "MonitorPOS")',
                                data: fromData,
                                contentType: "application/json",
                                dataType: "json",
                                contentType: false,
                                processData: false,
                                success: function (data) {
                                    if (data.Status == true) {
                                        //debugger
                                        var html = "";
                                        html += "<table id=\"\" class=\"table table-bordered table-hover\" style=\"width:100%;\">";
                                        html += "</tbody>";
                                        var checkPeformance = data.CheckPeformance;
                                        checkPeformance.forEach((name, i) => {
                                            html += "<tr id=\"\">";
                                            html += "<td>" + name + "</td>";
                                            html += "</tr>";
                                        });
                                        html += "</tbody>";
                                        html += "</table>";

