@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-column-fluid" id="div-price-group-by-store">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                <label style="font-weight:bold">Mã cửa hàng</label>
                                <div class="form-group">
                                    <input type="text" id="searchtxtStoreNo" placeholder="Nhập mã siêu thị" class="form-control changeEvent">
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mb-1">
                                <label style="font-weight:bold">Tên máy tính</label>
                                <div class="form-group">
                                    <input type="text" id="searchtxtComputerName" placeholder="Nhập tên máy tính" class="form-control changeEvent">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1">
                                <label style="font-weight:bold">IP Address</label>
                                <div class="form-group">
                                    <input type="text" id="searchtxtIPAddress" placeholder="Nhập IP cách nhau dấu;" class="form-control changeEvent">
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mb-1 text-left">
                                <button type="button" class="btn btn-primary" id="btnSearch" style="color: #ffffff;cursor:pointer;margin-top: 27px;"> <i class="fa fa-search"></i> Tìm kiếm</button>
                            </div>
                        </div>
                        <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;"></div>

                        <div class="row">
                            <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-1">
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-6 col-xs-12 mb-1 text-right">
                                        <button type="button" class="btn btn-primary" id="btnArrowRight" onclick="MoveRight()" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-arrow-alt-circle-right" style="font-size:22px"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-1">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1 text-left">
                                        <button type="button" class="btn btn-danger" id="btnArrowRight" onclick="MoveLeft()" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-arrow-alt-circle-left" style="font-size:22px"></i></button>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-1 text-right">
                                        <button type="button" class="btn btn-primary" id="btnViewSQL" onclick="ViewSQL()" title="Đồng bộ bằng SQL" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-database" style="font-size:22px"></i></button>
                                        <button type="button" class="btn btn-success" id="btnViewScript" onclick="ViewSrcipt()" title="Excute Script" style="color: #ffffff;cursor:pointer;"> <i class="fa fa-database" style="font-size:22px"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-1">
                                <table class="table table-bordered table-striped" id="tblData">
                                    <thead>
                                        <tr style="text-align:center;">
                                            <th>StoreNo</th>
                                            <th>PosTerminal</th>
                                            <th>IPAddress</th>
                                            <th>ComputerName</th>
                                            <th style="text-align:center"><input type="checkbox" class="chkAll" id="chkAll" value="" style="height:20px;width:20px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-1" style="margin-top: 40px;">
                                <table class="table table-bordered table-striped" id="tblData2" style="">
                                    <thead style="">
                                        <tr style="text-align:center;height:52px">
                                            <th style="text-align:center"><input type="checkbox" class="chkAll2" id="chkAll2" value="" style="height:20px;width:20px;"></th>
                                            <th>StoreNo</th>
                                            <th>PosTerminal</th>
                                            <th>IPAddress</th>
                                            <th>ComputerName</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalScript">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;text-transform:uppercase;font-weight:bold" id="titleNotFinish">EXECUTE SCRIPT</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="sldb">
                                <option value="StorePLH">StorePLH</option>
                                <option value="master">master</option>
                            </select>
                        </div>
                    </div>*@
                    @*<div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 mb-1">
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slSchema">
                                <option value="1">Select</option>
                                <option value="2">Execute</option>
                            </select>
                        </div>
                    </div>*@
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <textarea cols="1" rows="15" placeholder="select * from a left join b on a.Id=b.Id" class="form-control pull-right" id="txtSql" name="SqlScript"></textarea>
                    </div>

                </div>

            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" onclick="ClearScript()" class="btn btn-danger">Clear Script</button>
                <button type="button" onclick="ExecuteScriptV2()" class="btn btn-primary">Execute Script</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSQL">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titleNotFinish">ĐỒNG BỘ DỮ LIỆU THEO SQL SERVER</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-1">
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slGroupName"></select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-1">
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slAction">
                                <option value="0">DeleteAll --> Insert</option>
                                <option value="1">Delete By PKey --> Insert</option>
                                <option value="2">Only DeleteAll</option>
                                <option value="3">Only Delete By PKey</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-1">
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slCounter" name="Counter">
                                <option value="ALL" selected>ALL</option>
                                <option value="LAST">Last change</option>
                                <option value="INP">Input counter</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12 mb-1" style="display:none" id="displayCounter">
                        <div class="form-group">
                            <div class="form-group">
                                <input type="number" class="form-control" id="txtCounter" value="0" />
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <div id="divResult" style="width:100%;float:left;max-height:500px;overflow-y:scroll"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="">
                <button type="button" onclick="SyncTableSQL()" class="btn btn-primary">Đồng bộ</button>
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalResult">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" style="font-size:13px;text-transform:uppercase" id="titleNotFinish">KẾT QUẢ EXECUTE SCRIPT</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-1">
                        <div id="listResult" style="width:100%;float:left;max-height:500px;overflow-y:scroll"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $('.select2').select2();
        var table = "";

        $(document).ready(function () {

            LoadMonitorPOS();

            $("#chkAll").click(function () {

                if ($("#chkAll").is(':checked'))
                    $('.chkIP').prop('checked', true);
                else
                    $('.chkIP').prop('checked', false);
            });

            $("#chkAll2").click(function () {
                if ($("#chkAll2").is(':checked'))
                    $('.chkIP2').prop('checked', true);
                else
                    $('.chkIP2').prop('checked', false);
            });

            $("#slCounter").on("change", function (e) {
                if ($("#slCounter").val() == "INP") {
                    $("#displayCounter").css("display", "block");
                }
                else {
                    $("#displayCounter").css("display", "none");
                }
            });

            $("#btnSearch").on("click", function (e) {
                table.draw();
                $('#chkAll').prop('checked', false);
            });

            $(".changeEvent").on("change", function (e) {
                table.draw();
                $('#chkAll').prop('checked', false);
            });
        });


        function LoadMonitorPOS() {
            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: false,
                processing: true,           // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: false,
                ordering: false,
                displayLength: 100,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("LoadListIP", "SyncData")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.StoreNo = $("#searchtxtStoreNo").val();
                        d.IpAddress = $("#searchtxtIPAddress").val();
                        d.ComputerName = $("#searchtxtComputerName").val();
                    }
                },
                columns: [
                    {
                        data: "StoreNo",
                        className: 'text-center'
                    },
                    {
                        data: "PosTerminalID",
                        className: 'text-center'
                    },
                    {
                        data: "IpAddress"
                    },
                    {
                        data: "ComputerName"
                    },
                    {
                         render: function (data, type, row) {
                             var ipAddress = row.IpAddress;
                             var html = '<input type="checkbox" class="chkIP" id="chkIPAddress' + ipAddress + '" value="' + ipAddress + '" style="height:18px;width:18px;">';
                             return html;
                         },
                        className: 'text-center'
                    }
                ]

            }).on('page.dt', function () {
                $('#chkAll').prop('checked', false);
            });
        }

        function MoveRight() {
            var html = '';
            //debugger
            // $('#tblData2 tbody').empty();
            $('#tblData input.chkIP:checkbox:checked').each(function () {
                //debugger
                //item = new Array(3);// ["1","2","3"];
                var storeNo = $(this).closest('tr').find('td').eq(0).text();
                var posTerminal = $(this).closest('tr').find('td').eq(1).text();
                var ipAddress = $(this).closest('tr').find('td').eq(2).text();
                var computerName = $(this).closest('tr').find('td').eq(3).text();
                const regex = /./gi;
                //var ipReplace = ipAddress.replace(regex, "");
                var ipReplace = ipAddress.split('.').join("");
                $('#tblData2 tbody').each(function () {
                    //debugger
                    var posTerminalRight = $("#tblData2 tbody tr").find('td').eq(2).text();
                    if (posTerminalRight == posTerminal) {
                        $("#moveLeft" + posTerminalRight).remove();
                    }
                });
                html += '<tr id=\"moveLeft' + posTerminal + '\" class=\"ipError' + ipReplace+'\">';
                html += '<td style=\"text-align:center\"><input type="checkbox" class="chkIP2" id="chkIPAddress2' + ipAddress + '" value="' + ipAddress + '" style="height:18px;width:18px;"></td>';
                html += '<td style=\"text-align:center\">' + storeNo + '</td>';
                html += '<td style=\"text-align:center\">' + posTerminal + '</td>';
                html += '<td style=\"text-align:center\">' + ipAddress + '</td>';
                html += '<td>' + computerName + '</td>';
                html += '</tr>';
            });
            $('#tblData2 tbody').append(html);
        }

        function MoveLeft() {
            //debugger
            $('#tblData2 input.chkIP2:checkbox:checked').each(function () {
                //debugger
                var posTerminal = $(this).closest('tr').find('td').eq(2).text();
                $("#moveLeft" + posTerminal).remove();
            });

            $('#chkAll2').prop('checked', false);
        }

        function ViewSrcipt() {
            var countIP = 0;
            $('#tblData2 > tbody > tr').each(function () {
                debugger
                var ipAddress = $(this).find('td').eq(3).text();
                countIP++;
            });
            if (countIP == 0) {
                toastr.error('Chọn địa chị IP để bắt đầu execute script', 'Thông báo');
                return;
            }
            $('#modalScript').modal({
                backdrop: 'static',
                keyboard: false
            });
        }

        function ExecuteScript() {
            var countIP = 0;
            var listIP = "";
            $('#tblData2 > tbody > tr').each(function () {
                //debugger
                listIP += $(this).find('td').eq(3).text() +";";
                countIP++;
            });
            if (countIP == 0) {
                toastr.error('Chưa có địa chỉ IP để đồng bộ', 'Thông báo');
                return;
            }

            var scriptSQL = $("#txtSql").val();
            //var dbName = $("#sldb").val();
            //var type = $("#slSchema").val();

            if (scriptSQL == null || scriptSQL == "") {
                toastr.error('Chưa có câu lệnh SQL', 'Thông báo');
                return;
            }

            loading.showloading();
            var url = "@Url.Action("ExcuteScript", "SyncData")";
            $.ajax({
                url: url,
                data: { ListIP: listIP, SqlScript: scriptSQL},
                cache: false,
                type: "POST",
                success: function (data) {
                    $('#modalScript').modal('hide');
                    //debugger;
                    var result = data;
                    if (result != null) {
                        var html = "";
                        //html += "<div class=\"card-body table-responsive\">";
                        html += "<table id=\"\" class=\"table table-bordered\" style=\"width:100%;max-height:500px\">";
                        html += "<thead>";
                        html += "<tr>";
                        html += "<th style='text-align:center;width:120px'>IPAddress</th>";
                        html += "<th style='text-align:center;max-width:400px'>Message</th>";
                        html += "<th style='text-align:center;width:100px'>Trạng thái</th>";
                        html += "</tr>";
                        html += "</thead>";
                        html += "</tbody>";
                        result.forEach((name, i) => {
                             var ipReplace = name.IPAddress.split('.').join("");
                            html += "<tr id=\"\">";
                            html += "<td style=\"text-align:center;\">" + name.IPAddress + "</td>";
                            html += "<td style=\"max-width:400px\">" + name.Message + "</td>";
                            if (name.Status == 1) {
                                html += "<td style=\"text-align:center;\"><span class=\"badge bg-success\">Success</span></td>";
                                $(".ipError" + ipReplace).css("background-color", "#fff");
                            }
                            else {
                                html += "<td style=\"text-align:center;\"><span class=\"badge bg-danger\">Fail</span></td>";
                                $(".ipError" + ipReplace).css("background-color","#f39090");
                            }
                            html += "</tr>";
                        });
                        html += "</tbody>";
                        html += "</table>";
                        //html += "</div>";
                        $('#listResult').html(html);
                    }

                    loading.hideloading();

                    $('#modalResult').modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                    loading.hideloading();
                }
            });
        }

        function ExecuteScriptV2() {
            var countIP = 0;
            var listIP = "";
            $('#tblData2 > tbody > tr').each(function () {
                //debugger
                listIP += $(this).find('td').eq(3).text() +";";
                countIP++;
            });
            if (countIP == 0) {
                toastr.error('Chưa có địa chỉ IP để đồng bộ', 'Thông báo');
                return;
            }

            var scriptSQL = $("#txtSql").val();
            //var dbName = $("#sldb").val();
            //var type = $("#slSchema").val();

            if (scriptSQL == null || scriptSQL == "") {
                toastr.error('Chưa có câu lệnh SQL', 'Thông báo');
                return;
            }

            loading.showloading();
            var url = "@Url.Action("_ExcuteScript", "SyncData")";
            $.ajax({
                url: url,
                data: { ListIP: listIP, SqlScript: scriptSQL },
                cache: false,
                type: "POST",
                success: function (data) {
                    //debugger
                    $('#modalScript').modal('hide'); 
                    $('#listResult').html(data.ViewPartial);
                    loading.hideloading();
                    $('#modalResult').modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                    loading.hideloading();
                }
            });
        }

        function ClearScript() {
            $("#txtSql").val('');
        }

        function ViewSQL() {
            var countIP = 0;
            $('#tblData2 > tbody > tr').each(function () {
                //debugger
                var ipAddress = $(this).find('td').eq(3).text();
                countIP++;
            });
            if (countIP == 0) {
                toastr.error('Chọn địa chị IP để bắt đầu đồng bộ SQL', 'Thông báo');
                return;
            }
            var html = "";
            var fromData = new FormData();
            $.ajax({
                type: "POST",
                url: '@Url.Action("ListTableSync", "SyncData")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {

                    if (data != null) {
                        data.forEach((name, i) => {
                           html += "<option value=" + name.GroupName + ">" + name.GroupName + "</option>";
                        });
                        $("#slGroupName").html(html);
                    }
                },
                error: function () {
                }
            });

            $('#modalSQL').modal({
                backdrop: 'static',
                keyboard: false
            });
        }

        function SyncTableSQL() {
            var countIP = 0;
            var listIP = "";
            $('#tblData2 > tbody > tr').each(function () {
                //debugger
                listIP += $(this).find('td').eq(1).text() + "_" + $(this).find('td').eq(3).text() + ";";
                countIP++;
            });

            if (countIP == 0) {
                toastr.error('Chưa có địa chỉ IP để đồng bộ SQL', 'Thông báo');
                return;
            }

            var groupTable = $("#slGroupName").val();
            var typeCounter = $('#slCounter').val();
            var counter = $('#txtCounter').val();

            if (groupTable == null || groupTable == "") {
                toastr.error('Chưa chọn group table', 'Thông báo');
                return;
            }

            var action = $("#slAction").val();
            loading.showloading();
            var url = "@Url.Action("SyncDataBySQL", "SyncData")";
            $.ajax({
                url: url,
                data: { ListIPLocal: listIP, GroupTable: groupTable, Action: action, TypeCounter: typeCounter, Counter: counter },
                cache: false,
                type: "POST",
                success: function (data) {
                    $("#divResult").html('');
                    var html = "<ul class=\"nav nav-pills flex-column\">";
                    if (data != null && data.length > 0) {
                        //var lstError = "";
                        var countError = 0;
                        //var lstOK = "";
                        var countOK = 0;
                        //var htmlFail = "<ul class=\"nav nav-pills flex-column\">";
                        data.forEach((name, i) => {
                            //debugger
                            if (name.Item3 == false) {
                                //lstError += name.Item1 + ";";
                                //countError++;
                                html += "<li class=\"nav-item active\">";
                                html += "<a class=\"nav-link\">";
                                html += "<i class=\"fas fa-address-card\"></i> " + name.Item1 + " (" + name.Item2 + ")";
                                html += "<span class=\"badge bg-danger float-right\">Fail</span>";
                                html += "</a>";
                                html += "</li>";
                            }
                            else {
                                // lstOK += name.Item1 + ";";
                                //countOK++;
                                html += "<li class=\"nav-item active\">";
                                html += "<a class=\"nav-link\">";
                                html += "<i class=\"fas fa-address-card\"></i> " + name.Item1 + "";
                                html += "<span class=\"badge bg-primary float-right\">OK</span>";
                                html += "</a>";
                                html += "</li>";
                            }
                        });
                    }
                    else {
                        html += "<li class=\"nav-item active\">";
                        html += "<a class=\"nav-link\">";
                        html += "<i class=\"fas fa-address-card\"></i> Không có data để đồng bộ sql tới POS";
                        html += "</a>";
                        html += "</li>";
                    }
                    html += "</ul>";
                    $("#divResult").html(html);
                    loading.hideloading();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                    loading.hideloading();
                }
            });

        }
    </script>
}

