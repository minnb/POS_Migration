@using VCM.BLUEPOS.Model.Price;
@{
    ViewBag.Title = "Cập nhật giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    input[type="date"]::-webkit-datetime-edit, input[type="date"]::-webkit-inner-spin-button, input[type="date"]::-webkit-clear-button {
        color: #fff;
        position: relative;
    }

    input[type="date"]::-webkit-datetime-edit-year-field {
        position: absolute !important;
        border-left: 1px solid #8c8c8c;
        padding: 2px;
        color: #000;
        left: 56px;
    }

    input[type="date"]::-webkit-datetime-edit-month-field {
        position: absolute !important;
        border-left: 1px solid #8c8c8c;
        padding: 2px;
        color: #000;
        left: 26px;
    }


    input[type="date"]::-webkit-datetime-edit-day-field {
        position: absolute !important;
        color: #000;
        padding: 2px;
        left: 4px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>IT</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý giá</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cập nhật giá</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid" style="margin-top:10px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 1 !important;">Tìm theo</label>
                                <div class="form-group">
                                    <select id="sel-search" class="form-control select2">
                                        <option value="1" selected>Kênh bán hàng</option>
                                        <option value="2">Vùng giá</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 1 !important;">Kênh bán hàng</label>
                                <div class="form-group">
                                    <select id="sel-chanel-code" class="form-control select2">
                                        <option value="10" selected>10 - VinMart+</option>
                                        <option value="20">20 - VinMart</option>
                                        <option value="60" disabled>60 - B2B</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 1 !important;">Loại</label>
                                <div class="form-group">
                                    <select id="sel-region-price" class="form-control select2">
                                        <option value="-1" selected>Chọn loại...</option>
                                        <option value="1">Site</option>
                                        <option value="2">PriceList</option>
                                        <option value="3" disabled>PriceGroup</option>
                                        <option value="4">ALL</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 1 !important;">Mã site/Mã vùng giá</label>
                                <div class="form-group">
                                    <select id="sel-region-code" class="form-control select2">
                                        <option value="" selected>Chọn mã site, mã vùng giá...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                <label class="font-weight-bold" style="margin-bottom: 1 !important;">Từ khóa</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" style="width:100%;" id="item-no" name="ItemNo" placeholder="Nhập mã sản phẩm" />
                                </div>
                            </div>

                            <div class="col-lg-1 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btn-search-price-list" class="form-control btn btn-primary"><i class="fa fa-search"></i> Tìm kiếm</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-price-table" class="table  table-trip table-bordered table-hover">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th style="text-align:center;">STT</th>
                                    <th style="text-align:center;">Mã sản phẩm</th>
                                    <th style="text-align:center;">Đơn vị tính</th>
                                    <th style="text-align:center;">Giá bán</th>
                                    <th style="text-align:center;">Từ ngày</th>
                                    <th style="text-align:center;">Đến ngày</th>
                                    <th style="text-align:center;">#</th>
                                    <th style="text-align:center;">Kênh/Vùng giá</th>
                                    <th style="text-align:center;">Tên sản phẩm</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modal-search-item" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-sticky-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Thông tin sản phẩm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <input type="text" id="txt-id" class="form-control" value="" disabled />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <input type="text" id="txt-search" class="form-control" value="" placeholder="Nhập mã sản phẩm..." />
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <button type="button" id="btn-search-item" class="btn btn-primary"> <i class="fa fa-search"></i> Tìm kiếm</button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                        <label class="font-weight-bold">Mã sản phẩm</label>
                    </div>

                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <input type="text" id="txt-item-no" class="form-control" value="" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                        <label class="font-weight-bold">Tên sản phẩm</label>
                    </div>

                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <input type="text" id="txt-item-name" class="form-control" value="" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                        <label class="font-weight-bold">ĐVT</label>
                    </div>
                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <select id="sl-unit" class="form-control select2"></select>
                        </div>
                    </div>
                </div>
            </div>

            <input type="text" hidden id="hdd-txt-id" />
            <input type="text" hidden id="hdd-item-no" />
            <input type="text" hidden id="hdd-unit" />
            <div class="modal-footer">
                <button type="button" id="btn-save-data-row" class="btn btn-primary font-weight-bold" disabled> <i class="la la-save"></i>Cập nhật</button>
            </div>

        </div>
    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table = "";
       
        function LoadComboRegionSite() {
            //debugger
            var chanelCode = $('#sel-chanel-code').val();
            var regionPrice = $('#sel-region-price').val();
            if (chanelCode == null || chanelCode == '') {
                return;
            }

            if (regionPrice == null || regionPrice == '') {
                return;
            }

            var html = "<option value=\"\" selected disabled>Vui lòng chọn...</option>";

            if (regionPrice == "1")  // theo site
            {
                $.ajax({
                type: "POST",
                url: '@Url.Action("GetComboSite", "Price")',
                data: { ChanelCode: chanelCode },
                dataType: "json",
                success: function (data)
                {
                        if (data != null) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text +"</option>";
                            });
                            $('#sel-region-code').html(html);
                        }
                },
                error: function ()
                {
                        toastr.error('Lỗi hệ thống');
                }

                });
            }
            else if (regionPrice == "2") // theo PriceList
            {
                $.ajax({
                type: "POST",
                url: '@Url.Action("GetComboRegion", "Price")',
                //data: { },
                dataType: "json",
                success: function (data) {
                        if (data != null) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text +"</option>";
                            });
                            $('#sel-region-code').html(html);
                        }
                },

                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }

                });
            }
            else if (regionPrice == "3")
            {
            }
            else if (regionPrice == "4") //ALL
            {
                var value = "ALL";
                html += "<option value='" + value + "'>" + value + "</option>";
                $('#sel-region-code').html(html);
            }
        };

        
        $(document).ready(function () {

            LoadComboRegionSite();

            $("#sel-region-price").on('change', function (e) {
                LoadComboRegionSite();
            });

            table = $('#tbl-price-table').DataTable({
                destroy: true,
                deferLoading: 0,
                select: {
                    style: 'single'
                },

                drawCallback: function (settings) {
                    $(".unit-price").on({
                        keyup: function () {
                            formatCurrency($(this));
                        },
                        blur: function () {
                            formatCurrency($(this), "blur");
                        },
                        change: function () {
                            formatCurrency($(this), "change");
                        }
                    });

                    $(".btn-update-price-list").click(function() {
                        //debugger
                        var pkey = $(this).attr("data-id");
                        var itemNo = $(this).parents('tr').find('td:nth-child(1)').find('span:nth-child(2)').html();
                        var unitOfMeasure = $(this).parents('tr').find('td:nth-child(3)').find('span:nth-child(1)').html();

                        var unitPrice = $(this).parents('tr').find('td:nth-child(4) input').val();
                        var _unitPrice = unitPrice.replace(/\,/g, '');

                        var startDate = $(this).parents('tr').find('td:nth-child(5) input').val();
                        var endDate = $(this).parents('tr').find('td:nth-child(6) input').val();
                        var salseCode = $(this).parents('tr').find('td:nth-child(8)').find('span:nth-child(1)').html();
                        var _this = this;

                        if (_unitPrice == null || _unitPrice == "") {
                            toastr.warning('Vui lòng nhập giá bán');
                            return;
                        }
                        if (_unitPrice != null || _unitPrice !="") {
                            var check = _unitPrice.trim();
                            if ((check == check / 1) == false) {
                                toastr.error("Giá bán phải là kiểu số");
                                return;
                            }
                        }
                        if (startDate > endDate) {
                            toastr.warning('Từ ngày phải nhỏ hơn hoặc bằng đến ngày');
                            return;
                        }

                        loading.showloading();
                        $.ajax({
                            url: '@Url.Action("UpdatePriceList", "Price")',
                            type: "POST",
                            dataType: "json",
                            data: {
                                ItemNo: itemNo,
                                SalesCode: salseCode,
                                UnitOfMeasureCode: unitOfMeasure,
                                UnitPrice: _unitPrice,
                                StartDate: startDate,
                                EndDate: endDate,
                                Pkey: pkey
                            },
                            success: function (data)
                            {
                                if (data.Status == 1)   // case: thanh cong
                                {
                                    toastr.success(data.Message);
                                    $(_this).parents('tr').find('td:nth-child(4) input').addClass('green-Class-Input');
                                    $(_this).parents('tr').find('td:nth-child(5) input').addClass('green-Class-Input');
                                    $(_this).parents('tr').find('td:nth-child(6) input').addClass('green-Class-Input');
                                }
                                else if (data.Status == 3)      // case: fail
                                {
                                    toastr.error(data.Message);
                                }
                                else if (data.Status == 2) {
                                    toastr.error(data.Message);
                                }
                                else if (data.Status == 4) {
                                    toastr.error(data.Message);
                                }
                                loading.hideloading();
                            },
                            error: function (xhr, status, error) {
                                console.log(xhr.responseText);
                            }
                        });
                    });

                },


                dom: '<"top"iflp<"clear">>rt',
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,           // for show progress bar
                serverSide: true,            // for process server side
                filter: false,               // this is for disable filter (search box)
                orderMulti: false,           // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("GetUpdatePriceList", "Price")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.Search        = $('#sel-search').val();
                        d.ChanelCode    = $('#sel-chanel-code').val();
                        d.RegionCode    = $('#sel-region-code').val();
                        d.ItemNo        = $('#item-no').val();
                    }
                },

                columns: [

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "ItemNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.ItemNo + '</span>';
                        }
                    },

                    {
                        data: "UnitOfMeasureCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.UnitOfMeasureCode + '</span>';
                        }
                    },

                    {
                        data: "UnitPrice",
                        className: 'text-center',
                        render: function (data, type, row) {
                            //var price = row.UnitPrice.toString().replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1,");
                            //var html = '<input type="text" class="form-control mask unit-price"  name="UnitPrice"  style="display: block; margin-left: 1px; text-align: right; min-width: 30px;" pattern="[0-9]*" data-politespace data-grouplength="3" data-delimiter=","  data-delimiter="," value = "' + price + '" >';
                            var html = '<input type="text" class="form-control unit-price"  name="UnitPrice"  style="display: block; margin-left: 1px; text-align: right; min-width: 30px;" value = "' + parseFloat(row.UnitPrice).toLocaleString('en') + '" >';
                            return html;
                        }
                    },

                    {
                        data: "StartingDateStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var startDate = row.StartingDateStr;
                            var dateString = startDate.split("/").reverse().join("-");
                            return '<input type="date" class="form-control" style="text-align: center;" value = "' + dateString + '"></span>';
                        }
                    },
                    
                    {
                        data: "EndingDateStr",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var endDate = row.EndingDateStr;
                            var dateString = endDate.split("/").reverse().join("-");
                            return '<input type="date" class="form-control" style="text-align: center;" value = "' + dateString + '"></span>';
                        }
                    },

                    {
                        data: "Pkey",
                        className: "text-center",
                        render: function (data, type, row) {
                            var pkey = row.Pkey;
                            var html = '<button type="button" class="form-control btn btn-success btn-update-price-list" style="color:#fff; text-align: center; padding-right: 10px;" data-toggle="tooltip"  data-placement="left"  title="Cập nhật" data-id="' + pkey + '"><i class="fas fa-save"></i></button>';
                            return html;
                        } 
                    },

                    {
                        data: "SalesCode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400;">' + row.SalesCode + '</span>';
                        }
                    },

                    {
                        data: "ItemName",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemName + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });

            $('[data-toggle="tooltip"]').tooltip();

            //$('#tbl-price-table tbody').on('click', 'tr', function () {
            //    $(this).toggleClass('selected');
            //});

            $("#btn-search-price-list").on("click", function (e) {
                table.draw();
            });

            $(document).on('keyup', '.unit-price', function () {
                    var x = $(this).val();
                    $(this).val(x.toString().replace(/,/g, "").replace(/\B(?=(\d{20})+(?!\d))/g, ","));
            });

    });



    </script>
}


