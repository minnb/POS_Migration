        function CreatePriceGroup() {
            //debugger
            var priceGroupCode = $('#txt-add-price-group-code').val();
            var priceGroupName = $('#txt-add-price-group-name').val();
            var priority = $('#txt-add-priority').val();
            var status = $('#sel-status-by-price-group').val();

            if (priceGroupCode == null || priceGroupCode == "") {
                toastr.error("Vui lòng nhập mã nhóm giá");
                return;
            }

            if (priceGroupName == null || priceGroupName == "") {
                toastr.error("Vui lòng nhập tên nhóm giá");
                return;
            }

            if (priority == 0 || priority < 0) {
                toastr.error("Vui lòng nhập độ ưu tiên (số nguyên dương > 0");
                return;
            }
            loading.showloading();
            var fromData = new FormData();
            fromData.append('PriceGroupCode', priceGroupCode);
            fromData.append('PriceGroupName', priceGroupName);
            fromData.append('Priority', priority);
            fromData.append('EnabledStr', status);
            $.ajax({
                url: '@Url.Action("CreatePriceGroup", "Price")',
                type: "POST",
                data: fromData,
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    //debugger
                    loading.hideloading();
                    if (data.Status == 1)
                    {
                        toastr.success(data.Message);
                        $('#modal-add-price-group').modal("hide");
                        $('#btn-save-add-price-group').trigger('click');
                        $('#btn-search').trigger('click');
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function ClearText() {
            $('#txt-add-price-group-code').val('');
            $('#txt-add-price-group-name').val('');
            $('#txt-add-priority').val('');
        }

