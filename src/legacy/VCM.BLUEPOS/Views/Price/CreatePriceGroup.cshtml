        function CreatePriceGroup() {
            //debugger
            var data = GetDataRowPriceGroup();
            if (data == null || data.length == 0) {
                toastr.error('Không có dữ liệu để lưu');
                return;
            }
            // Validate
            var isCheck = validateDataRow();
            if (isCheck == false)
            {
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("CreateStorePriceGroup", "Price")',
                type: "POST",
                dataType: "text",
                data: { req: JSON.stringify(data) },
                success: function (response) {
                    //debugger
                    loading.hideloading();
                    var item = JSON.parse(response);
                    if (item.Status = 1) {      // Thành công
                        toastr.success(item.Message);
                        $('#btn-refesh').trigger('click');
                    }
                    else if (item.Status = 2) {
                        toastr.warning(item.Message);
                    }
                    else if (item.Status = 3) {
                        toastr.warning(item.Message);
                    }
                    else if (item.Status = 4) {
                        toastr.warning(item.Message);
                    }
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        };

        function LoadComboxStore() {
            var html = "<option value=\"\" selected disabled>----- Chọn đơn ST/CH -----</option>";
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadStoreNoByUserName", "Common")',
                dataType: "json",
                success: function (data)
                {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                            }
                        });
                        $('#sel-modal-store-no').html(html);
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        };

        // Chọn loại = Theo site : thì load combox price group code de cho phep chon store
        function LoadComboxPriceGroupCode() {
            var html = "<option value=\"\" selected disabled>----- Chọn mã nhóm -----</option>";
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadComboxStoreNo", "Common")',
                dataType: "json",
                success: function (data)
                {
                    if (data != null) {
                        data.forEach((name, i) => {
                            if (name.SiteNo != "") {
                                html += "<option value='" + name.SiteNo + "'>" + name.DisplayComboSite + "</option>";
                            }
                        });
                        $('#sel-modal-price-group-code').html(html);
                    }
                },
                error: function ()
                {
                    toastr.error('Lỗi hệ thống');
                }
            });
        };

        function LoadComboxPriorityByPriceType() {
            var priceType = $('#sel-price-type').val();
            var priorityCode = $('#sel-priority-code').val();
            if (priceType == null || priceType == '') {
                return;
            }
            if (priorityCode == null || priorityCode == '') {
                return;
            }
            var html = "<option value=\"\" selected disabled>----- Vui lòng chọn -----</option>";
            if (priceType == "1")           // ALL
            {
                var priority = "500";  // 5
                html += "<option value='" + priority + "' selected>" + priority + "</option>";
                html += "<option value='100'>100</option>";
                html += "<option value='200'>200</option>";
                html += "<option value='300'>300</option>";
                html += "<option value='400'>400</option>";
                $('#sel-priority-code').html(html);
            }
            else if (priceType == "2")      // Kênh
            {
                var priority = "400";  // 4
                html += "<option value='" + priority + "' selected>" + priority + "</option>";
                html += "<option value='100'>100</option>";
                html += "<option value='200'>200</option>";
                html += "<option value='300'>300</option>";
                html += "<option value='500'>500</option>";
                $('#sel-priority-code').html(html);
            }
            else if (priceType == "3")   // Vùng
            {
                var priority = "300";  // 3
                html += "<option value='" + priority + "' selected>" + priority + "</option>";
                html += "<option value='100'>100</option>";
                html += "<option value='200'>200</option>";
                html += "<option value='400'>400</option>";
                html += "<option value='500'>500</option>";
                $('#sel-priority-code').html(html);
            }
            else if (priceType == "5")   // Tỉnh thành
            {
                var priority = "200";  // 2
                html += "<option value='" + priority + "' selected>" + priority + "</option>";
                html += "<option value='100'>100</option>";
                html += "<option value='300'>300</option>";
                html += "<option value='400'>400</option>";
                html += "<option value='500'>500</option>";
                $('#sel-priority-code').html(html);
            }
            else if (priceType == "4")   // Theo site
            {
                var priority = "100";   // 1
                html += "<option value='" + priority + "' selected>" + priority + "</option>";
                html += "<option value='200'>200</option>";
                html += "<option value='300'>300</option>";
                html += "<option value='400'>400</option>";
                html += "<option value='500'>500</option>";
                $('#sel-priority-code').html(html);
            }
        };

        function LoadComboxPriceTypeByPriority() {
            var priceType = $('#sel-price-type').val();
            var priorityCode = $('#sel-priority-code').val();
            if (priceType == null || priceType == '') {
                return;
            }
            if (priorityCode == null || priorityCode == '') {
                return;
            }
            var html = "<option value=\"\" selected disabled>----- Vui lòng chọn -----</option>";
            if (priorityCode == "500")           // ALL
            {
                var priceType = "1"; 
                html += "<option value='" + priceType + "' selected>1 : ALL</option>";
                html += "<option value='2'>2 : Kênh</option>";
                html += "<option value='3'>3 : Vùng</option>";
                html += "<option value='4'>4 : Theo site</option>";
                html += "<option value='5'>5 : Tỉnh thành</option>";
                $('#sel-price-type').html(html);
            }
            else if (priorityCode == "400")      // Kênh
            {
                var priceType = "2"; 
                html += "<option value='" + priceType + "' selected>2 : Kênh</option>";
                html += "<option value='1'>1 : ALL</option>";
                html += "<option value='3'>3 : Vùng</option>";
                html += "<option value='4'>4 : Theo site</option>";
                html += "<option value='5'>5 : Tỉnh thành</option>";
                $('#sel-price-type').html(html);
            }
            else if (priorityCode == "300")   // Vùng
            {
                var priceType = "3"; 
                html += "<option value='" + priceType + "' selected>3 : Vùng</option>";
                html += "<option value='1'>1 : ALL</option>";
                html += "<option value='2'>2 : Kênh</option>";
                html += "<option value='4'>4 : Theo site</option>";
                html += "<option value='5'>5 : Tỉnh thành</option>";
                $('#sel-price-type').html(html);
            }
            else if (priorityCode == "200")   // Tỉnh thành
            {
                var priceType = "5"; 
                html += "<option value='" + priceType + "' selected>5 : Tỉnh thành</option>";
                html += "<option value='1'>1 : ALL</option>";
                html += "<option value='2'>2 : Kênh</option>";
                html += "<option value='3'>3 : Vùng</option>";
                html += "<option value='4'>4 : Theo site</option>";
                $('#sel-price-type').html(html);
            }
            else if (priorityCode == "100")   // Theo site
