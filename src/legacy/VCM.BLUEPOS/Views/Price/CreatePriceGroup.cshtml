@using VCM.BLUEPOS.Model.PriceGroup;
@{
    ViewBag.Title = "Tạo Price Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    input[type="date"]::-webkit-datetime-edit, input[type="date"]::-webkit-inner-spin-button, input[type="date"]::-webkit-clear-button {
        color: #fff;
        position: relative;
    }

    input[type="date"]::-webkit-datetime-edit-year-field {
        position: absolute !important;
        border-left: 1px solid #8c8c8c;
        padding: 2px;
        color: #000;
        left: 56px;
    }

    input[type="date"]::-webkit-datetime-edit-month-field {
        position: absolute !important;
        border-left: 1px solid #8c8c8c;
        padding: 2px;
        color: #000;
        left: 26px;
    }


    input[type="date"]::-webkit-datetime-edit-day-field {
        position: absolute !important;
        color: #000;
        padding: 2px;
        left: 4px;
    }
</style>

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>IT</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý giá</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Tạo Price Group</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Loại</label>
                                <div class="form-group">
                                    <select id="sel-price-type" class="form-control select2">
                                        <option value="-1" selected>----- Chọn loại -----</option>
                                        <option value="1">1 : ALL</option>
                                        <option value="2">2 : Kênh</option>
                                        <option value="3">3 : Vùng</option>
                                        <option value="4">4 : Theo site</option>
                                        <option value="5">5 : Tỉnh thành</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Mã nhóm</label>
                                <div class="form-group">
                                    <select id="sel-price-group-code" class="form-control select2">
                                        <option value="-1" selected>----- Chọn mã nhóm -----</option>
                                        <option value="ALL">ALL</option>
                                        <option value="2">Kênh</option>
                                        <option value="3">Vùng</option>
                                        <option value="4">Site</option>
                                        <option value="5">Tỉnh thành</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                <label style="font-size: 12px; font-weight: 700; font-family: Roboto,Arial,sans-serif; margin-bottom: 1 !important;">Độ ưu tiên</label>
                                <div class="form-group">
                                    <select id="sel-priority-code" class="form-control select2">
                                        <option value="-1" selected>----- Chọn độ ưu tiên -----</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                        <option value="300">300</option>
                                        <option value="400">400</option>
                                        <option value="500">500</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                <button type="button" id="btn-new-row-price-group" class="btn btn-primary" disabled><i class="la la-plus-circle"></i> Thêm mới</button>
                                <button type="button" id="btn-refesh" class="btn btn-bg-warning" style="color: #ffffff" disabled hidden><i class="la la-refresh" style="color:#ffffff"></i> Refesh</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                            <button type="button" id="btn-save-price-group" class="btn btn-hover-transparent-primary"><i class="la la-save"></i> Lưu</button>
                            <button type="button" id="delete-all-row" class="btn btn-hover-transparent-danger"><i class="fa fa-trash"></i> Xóa dòng</button>
                            <button type="button" id="delete-all-row-temp" class="btn btn-hover-transparent-danger" hidden><i class="fa fa-trash"></i> Xóa dòng</button>
                        </div>
                        <table id="tbl-create-price-group" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center">
                                    <th width="20px" style="padding-right: 10px;">
                                        <input type="checkbox" class="cusor" name="CheckAll" id="check-all" data-toggle="tooltip" data-placement="top" title="Chọn tất cả">
                                    </th>
                                    <th style="text-align:center; padding-right: 10px;">STT</th>
                                    <th style="text-align:center; padding-right: 10px;">Mã ST/CH</th>
                                    <th style="text-align:center; width: 5px;padding-right: 10px;">#</th>
                                    <th style="text-align:center; padding-right: 10px;">Mã nhóm</th>
                                    <th style="text-align:center; width: 5px;padding-right: 10px;">#</th>
                                    <th style="text-align:center; padding-right: 10px; width: 100px;" ">Loại</th>
                                    <th style="text-align:center; padding-right: 10px; width: 100px;" ">Độ ưu tiên</th>
                                    <th style="text-align:center; padding-right: 10px; width: 20px;">#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modal-search-store" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Thông tin Siêu thị / Cửa hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" style="margin: 25px;">
                <div class="row">
                    <input type="text" id="txt-stt" hidden  />
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="padding-top: 8px;">
                        <label class="font-weight-bold">ST/CH (*)</label>
                    </div>
                    <div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <select id="sel-modal-store-no" class="form-control select2"></select>
                        </div>
                    </div>
                </div>
            </div>

            <input type="text" hidden id="txt-stt-temp" />
            <input type="text" hidden id="hdd-store-no" />
            <div class="modal-footer">
                <button type="button" id="btn-save-store-no" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Cập nhật</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="modal-search-price-group-code" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Thông tin mã nhóm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" style="margin: 25px;">
                <div class="row">
                    <input type="text" id="txt-stt" hidden />
                    <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="padding-top: 8px;">
                        <label class="font-weight-bold">Mã nhóm (*)</label>
                    </div>
                    <div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <select id="sel-modal-price-group-code" class="form-control select2"></select>
                        </div>
                    </div>
                </div>
            </div>

            <input type="text" hidden id="txt-stt-temp" />
            <input type="text" hidden id="txt-price-group-temp" />
            <div class="modal-footer">
                <button type="button" id="btn-save-price-group-code" class="btn btn-primary font-weight-bold"> <i class="la la-save"></i>Cập nhật</button>
            </div>

        </div>
    </div>
</div>



