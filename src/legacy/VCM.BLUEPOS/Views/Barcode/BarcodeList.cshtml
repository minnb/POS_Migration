@using VCM.BLUEPOS.Model.Barcode;
@{
    ViewBag.Title = "Danh mục Barcode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">IT</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh mục Barcode</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div id="title-site" style="color:#1144b6;font-weight:bold;"></div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportBarcodeList", "Barcode", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Barcode</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-barcode" name="BarcodeNo" placeholder="Nhập mã barcode"/>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Mã sản phẩm/Mã sản phẩm PLG</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control pull-right" style="width:100%;" id="txt-item-no" name="ItemNo" placeholder="Nhập mã sản phẩm/mã LPG"/>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary" name="btnSearch"><i class="fa fa-search"></i>Tìm kiếm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-barcode-list" class="table table-bordered table-hover">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase">
                                    <th>STT</th>
                                    <th>Barcode</th>
                                    <th>Mã sản phẩm</th>
                                    <th>Mã sản phẩm PLG</th>
                                    <th>Tên sản phẩm</th>
                                    <th>ĐVT Barcode</th>
                                    @*<th>VariantCode</th>*@
                                    <th>Giảm giá (%)</th>
                                    <th>Ngày cập nhật</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts
{
    <script type="text/javascript">
        var table = "";

        $('#txt-barcode').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $('#txt-item-no').keypress(function (e) {
            var key = e.which;
            if (key == 13) {
                $('button[name = btnSearch]').click();
                return false;
            }
        });

        $(document).ready(function () {
            table = $('#tbl-barcode-list').DataTable({
                destroy: true,
                deferLoading: 0,

                select: {
                    style: 'single'
                },

                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                paging: true,
                pagingType: "simple_numbers",
                responsive: true,
                processing: false,          // for show progress bar
                serverSide: true,           // for process server side
                filter: true,               // this is for disable filter (search box)
                orderMulti: false,          // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,

                ajax: {
                    url: '@Url.Action("GetBarcodeList", "Barcode")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemNo = $('#txt-item-no').val();
                        d.BarcodeNo = $('#txt-barcode').val();
                    }
                },

                columns: [

                    {
                        data: "ID",
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },

                    {
                        data: "BarcodeNo",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;color:#0C713D;">' + row.BarcodeNo + '</span>';
                        }
                    },

                    {
                        data: "ItemNoSAP",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.ItemNoSAP + '</span>';
                        }
                    },

                    {
                        data: "ItemNo",  // Ma san pham PLG
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;color:#0C713D;">' + row.ItemNo + '</span>';
                        }
                    },

                    {
                        data: "ItemName",
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 400; text-align:left">' + row.ItemName + '</span>';
                        }
                    },

                    {
                        data: "UnitBarcode",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.UnitBarcode + '</span>';
                        }
                    },

                    //{
                    //    data: "VariantCode",
                    //    className: 'text-center',
                    //    render: function (data, type, row) {
                    //        return '<span style="display: block; font-weight: 400;">' + row.VariantCode + '</span>';
                    //    }
                    //},

                    {
                        data: "DiscountPercent",
                        className: 'text-center',
                        render: function (data, type, row) {
                            var html = '<span style="font-weight:700;display: block;">' + parseFloat(row.DiscountPercent).toLocaleString('en') + '</span>';
                            return html;
                        }
                    },

                    {
                        data: "LastDateModified",
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<span style="display: block; font-weight: 700;">' + row.LastDateModified + '</span>';
                        }
                    }

                ]

            }).on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }

            });

            $("#btn-search").on("click", function (e) {
                table.draw();
            })

            $("#btn-export-excel").on("click", function (e) {
                $('#frm-export-excel').submit();
            })


    });

    </script>
}




