@using VCM.BLUEPOS.Model.SetupItem;
@using System.Web.Configuration
@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;

@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var model = Model as ViewSetupItemModel;
    var listItem = model.ListItem;
    var totalPage = model.TotalPageNumber;
    string pageCurrent = HttpContext.Current.Request.RequestContext.RouteData.Values["page"] == null ? "1" : HttpContext.Current.Request.RequestContext.RouteData.Values["page"].ToString();
    int pageCR = int.Parse(pageCurrent);
    var totalRow = model.TotalRow;
    var pageSize = model.PageSize;
    var displayRow = $"{pageCR}-{pageSize}/{totalRow} sản phẩm";

    if (totalRow <= pageSize)
    {
        displayRow = $"{totalRow} sản phẩm";
    }
    if (pageCR > 1 && totalRow > pageSize)
    {
        displayRow = $"{(pageCR * pageSize + 1) - pageSize}-{(pageCR * pageSize > totalRow ? totalRow : pageCR * pageSize)} /{totalRow} sản phẩm";
    }
    var keyword = Html.Raw(model.Keyword);
    string urlImg = WebConfigurationManager.AppSettings["urlImg"];
    var isButtionAdd = model.IsButtonAdd;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Sản phẩm V2</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            @if (isButtionAdd)
            {
                <button type="button" class="btn btn-primary" id="btnAddItem"><i class="la la-plus-circle"></i> Thêm sản phẩm</button>
            }
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card card-custom">
                        <div class="card-body">
                            <div id="loadItem">
                                <div class="row">
                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        @using (Html.BeginForm("SetupItemV2", "SetupItem", FormMethod.Post, new { id = "frmItem", enctype = "multipart/form-data" }))
                                        {
                                            <div class="input-group input-group-sm input-group-solid" style="width:70%">
                                                <input type="text" class="form-control" id="txtSearch" name="keyword" value="@keyword" placeholder="Tìm mã sản phẩm, mã barcode, tên sản phẩm..." />
                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-search btnSearch" style="cursor:pointer"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap" style="text-align:right; float:right">
                                            @if (totalPage > 1)
                                            {
                                                <div class="d-flex flex-wrap">
                                                    <a href="@Url.Action("SetupItemV2", "SetupItem", new { page = 1, keyword = keyword })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-back icon-xs"></i>
                                                    </a>
                                                    <a href="@Url.Action("SetupItemV2", "SetupItem", new { page = pageCR > 1 ? pageCR - 1 : pageCR, keyword = keyword })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-back icon-xs"></i>
                                                    </a>
                                                    @for (int page = 1; page <= totalPage; page++)
                                                    {
                                                        var activePage = pageCR == page ? "active" : "";
                                                        <a href="@Url.Action("SetupItemV2", "SetupItem", new { page = page, keyword = keyword })" class="btn btn-icon btn-sm border-0 btn-hover-primary mr-2 my-1 @activePage">@page</a>
                                                    }
                                                    <a href="@Url.Action("SetupItemV2", "SetupItem", new { page = pageCR < totalPage ? pageCR + 1 : pageCR, keyword = keyword })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-next icon-xs"></i>
                                                    </a>

                                                    <a href="@Url.Action("SetupItemV2", "SetupItem", new { page = totalPage, keyword = keyword })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-next icon-xs"></i>
                                                    </a>
                                                </div>
                                            }
                                            <div class="d-flex align-items-center">
                                                <span class="text-muted">@displayRow</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                                
                                <div class="row">
                                    @if (listItem != null && listItem.Count > 0)
                                    {
                                        foreach (var item in listItem)
                                        {
                                            var fullImgPath = $"{urlImg}/{item.ImageName}";
                                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12" style="margin-bottom:-20px">
                                                <div class="card card-custom gutter-b card-stretch" style="border:1px solid #d5d2d2">
                                                    <div class="card-body">
                                                        <div style="cursor:pointer" class="d-flex align-items-center btnDetail" data-itemno="@item.ItemNo">
                                                            <div class="flex-shrink-0 mr-4 mt-lg-0">
                                                                <div class="symbol symbol-lg-75">
                                                                    @if (string.IsNullOrEmpty(item.ImageName))
                                                                    {
                                                                        <img src="~/Uploads/imgs/placeholder.png" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <img src="@fullImgPath" />
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="d-flex flex-column" style="font-family:Roboto ,Unicode Support Noto, sans-serif">
                                                                <a class="text-dark font-weight-bold text-hover-primary mb-0">@item.ItemName</a>
                                                                <span class="text-muted font-weight-bold">No:@item.ItemNo</span>
                                                                <span class="text-muted font-weight-bold">Barcode : @item.BarcodeNo</span>
                                                                <span class="text-muted font-weight-bold">UOM : @item.BaseUnitOfMeasure</span>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div id="updateItem" style="display:none"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        var keyword = '@keyword';
        $(document).ready(function () {

            $(".select2").select2();
            $("#txtSearch").keydown(function (e) {
                var key = e.keyCode || e.which;
                if (key == 13 || key == 9) {
                    e.preventDefault();
                    var searchVal = $(this).val();
                    loading.showloading();
                    $('#frmItem').attr('action', "/san-pham/1/" + encodeURIComponent(searchVal)).submit();
                }
            });

            $(".btnSearch").on("click", function (e) {
                var searchVal = $("#txtSearch").val();
                loading.showloading();
                $('#frmItem').attr('action', "/san-pham/1/" + encodeURIComponent(searchVal)).submit();
            });

            $("#btnAddItem").on("click", function (e) {
                GetInfoItem("");
            });

            $(".btnDetail").on("click", function (e) {
                var itemNo = $(this).attr("data-itemno");
                GetInfoItem(itemNo);
            });

            $("#btnCancle").on("click", function (e) {
                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddItem").css("display", "block");

                $("#loadItem").css("display", "block");
                $("#updateItem").css("display", "none");
            });

            $("#btnSave").on("click", function (e) {
                //debugger
                var imgItem = $(".image-input-wrapper").css('background-image');
                var indexBase64 = imgItem.indexOf("base64,");
                var imgBase64 = "";
                var imgChanged = false;
                if (indexBase64 > 0) {
                    var lenghBase64 = indexBase64 + 7;
                    imgBase64 = imgItem.substring(lenghBase64, imgItem.length);
                    imgBase64 = imgBase64.replace('")', '');
                    imgChanged = true;
                }

                var itemNo = $("#hdtxtItemNo").val();
                var itemNo2 = $("#txtItemNo2").val();
                var itemName = $("#txtItemName").val();
                var itemDecs = $("#txtSearchDecs").val();
                var typeItem = $("#slTypeItem").val();
                var size = $("#slSize").val();
                var parentCode = $("#txtParentCode").val();
                var uom = $("#slUOM").val();
                var tax = $("#slTax").val();

                var isBlock = false;
                if ($("#chkBlocked").prop('checked')) {
                    isBlock = true;
                }

                var isVAT = false;
                if ($("#chkVAT").prop('checked')) {
                    isVAT = true;
                }

                var isManual = false;
                if ($("#chkManual").prop('checked')) {
                    isManual = true;
                }

                if (isManual == true) {
                    if (itemNo == "") {
                        toastr.error("Vui lòng nhập mã sản phẩm");
                        return;
                    }
                    if (itemNo.length < 8) {
                        toastr.error("Định dạng mã sản phẩm 8 ký tự");
                        return;
                    }
                }
                var arrayHeader = [];
                var itemHeader = {};

                if (!itemName || itemName.trim() == "") {
                    toastr.error("Vui lòng nhập tên sản phẩm");
                    return;
                }

                itemHeader['ItemNo'] = itemNo;
                itemHeader['ItemName'] = itemName;
                itemHeader['ItemDecs'] = itemDecs;
                itemHeader['ItemType'] = typeItem;
                itemHeader['UOM'] = uom;
                itemHeader['TAX'] = tax;
                itemHeader['IsBlocked'] = isBlock;
                itemHeader['IsVAT'] = isVAT;
                itemHeader['ItemNo2'] = itemNo2;
                itemHeader['Size'] = size;
                itemHeader['ParentCode'] = parentCode;
                itemHeader['ImgBase64'] = imgBase64;
                itemHeader['ImgChanged'] = imgChanged;
                itemHeader['CheckManual'] = isManual;
                arrayHeader.push(itemHeader);
                if (arrayHeader.length == 0) {
                    toastr.error("Bạn chưa tạo dữ liệu header");
                    return;
                }
                var arrayBarcode = [];
                $('#tblBarcode tbody tr').each(function (e) {
                    var itemBarcode = {};
                    var barcodeUOM = $(this).find('td:nth-child(1) select').val();
                    var barcode = $(this).find('td:nth-child(2) input').val();
                    itemBarcode['Barcode'] = barcode;
                    itemBarcode['UOM'] = barcodeUOM;
                    arrayBarcode.push(itemBarcode);
                });

                var arrayTopping = [];
                $('#tblTopping tbody tr').each(function (e) {
                    var itemTopping = {};
                    var itemNo = $(this).find('td:nth-child(1)').html();
                    var itemName = $(this).find('td:nth-child(2)').html();
                    var uom = $(this).find('td:nth-child(3)').html();
                    itemTopping['ItemNoRef'] = itemNo;
                    itemTopping['ItemNameRef'] = itemName;
                    itemTopping['UOMRef'] = uom;
                    arrayTopping.push(itemTopping);
                });

                var arrayCup = [];
                $('#tblCup tbody .cupFirst').each(function () {
                    //debugger
                    var itemNo = $(this).find('td:nth-child(1)').html();
                    var itemName = $(this).find('td:nth-child(2)').html();
                    var uom = $(this).find('td:nth-child(3)').html();
                    var classSalesType = ".tblSalesType tbody .salesType_" + itemNo;
                    $(classSalesType).each(function () {
                        var itemCup = {};
                        var salesTypeCode = $(this).find('td:nth-child(1)').html();
                        var isCheck = $(this).find('td:nth-child(3) input[type="checkbox"]').is(":checked");
                        var isDefault = false;
                        if (isCheck) {
                            isDefault = true;
                        }
                        itemCup['ItemNoRef'] = itemNo;
                        itemCup['ItemNameRef'] = itemName;
                        itemCup['UOMRef'] = uom;
                        itemCup['IsDefault'] = isDefault;
                        itemCup['SalesTypeCode'] = salesTypeCode;
                        arrayCup.push(itemCup);
                    });
                });

                var arrayOption = [];
                $('#tblOption tbody .oftionFirst').each(function (e) {
                    var itemOption = {};
                    var itemNo = $(this).find('td:nth-child(1)').html();
                    var itemName = $(this).find('td:nth-child(2)').html();
                    var uom = $(this).find('td:nth-child(3)').html();
                    itemOption['ItemNoRef'] = itemNo;
                    itemOption['ItemNameRef'] = itemName;
                    itemOption['UOMRef'] = uom;
                    arrayOption.push(itemOption);
                });

                var arrayDinhLuong = [];
                $('.tblDinhLuong tbody tr input.chkDinhLuong:checkbox:checked').each(function (e) {
                    var itemDinhLuong = {};
                    var itemNo = $(this).attr("data-itemno");
                    var itemNoOption = $(this).attr("data-itemnooption");
                    var optionType = $(this).attr("data-optiontype");
                    var optionName = $(this).attr("data-optionname");
                    var isCheck = $(".dinhluong_" + itemNoOption + "" + optionType).find('td:nth-child(2) input[type="radio"]').is(":checked");
                    var isDefault = false;
                    if (isCheck) {
                        isDefault = true;
                    }
                    itemDinhLuong['ItemNo'] = itemNo;
                    itemDinhLuong['ItemNoOption'] = itemNoOption;
                    itemDinhLuong['OptionType'] = optionType;
                    itemDinhLuong['OptionName'] = optionName;
                    itemDinhLuong['IsDefault'] = isDefault;
                    arrayDinhLuong.push(itemDinhLuong);
                });

                var arrayPosGroup = [];
                $('#tblPOSGroup tbody tr input.chkGroupPos:radio:checked').each(function (e) {
                    //debugger
                    var itemPosGroup = {};
                    var groupCode = $(this).attr("data-groupcode");
                    itemPosGroup['GroupCode'] = groupCode;
                    arrayPosGroup.push(itemPosGroup);
                });

                //var arrayPosWebGroup = [];
                //$('#tblPOSGroupWeb tbody tr input.chkGroupPosWeb:radio:checked').each(function (e) {
                //    var itemPosGroup = {};
                //    var groupCode = $(this).attr("data-groupcode");
                //    itemPosGroup['GroupCode'] = groupCode;
                //    arrayPosWebGroup.push(itemPosGroup);
                //});

                //debugger
                var jsonHeader = arrayHeader.length > 0 ? JSON.stringify(arrayHeader) : "";
                var jsonBarcode = arrayBarcode.length > 0 ? JSON.stringify(arrayBarcode) : "";
                var jsonTopping = arrayTopping.length > 0 ? JSON.stringify(arrayTopping) : "";
                var jsonCup = arrayCup.length > 0 ? JSON.stringify(arrayCup) : "";
                var jsonOption = arrayOption.length > 0 ? JSON.stringify(arrayOption) : "";
                var jsonDinhLuong = arrayDinhLuong.length > 0 ? JSON.stringify(arrayDinhLuong) : "";
                var jsonPosGroup = arrayPosGroup.length > 0 ? JSON.stringify(arrayPosGroup) : "";

                // --- GrabFood ---
                var partner = "";
                if ($("#chkGrabFood").prop('checked')) {
                    partner = "GRABFOOD";
                }
                else {
                    partner = "";
                }

                var arrayCategoryGrabFood = [];
                $('#tbl-category-list-grab-food tbody tr input.chkGroupPosGrabFood:radio:checked').each(function (e) {
                    var itemList = {};
                    //debugger
                    var categoryID = $(this).attr("data-category-id");
                    itemList['Id'] = itemNo;
                    itemList['Name'] = itemName;
                    itemList['UOM'] = uom;
                    itemList['CategoryID'] = categoryID;
                    itemList['IsDefault'] = false; 
                    arrayCategoryGrabFood.push(itemList);
                });

                var jsonCategoryGrabFood = arrayCategoryGrabFood.length > 0 ? JSON.stringify(arrayCategoryGrabFood) : "";

                //var arrayToppingGrab = [];
                //$('#tbl-Topping-Grab tbody tr').each(function (e) {
                //    var itemTopping = {};
                //    var itemNo = $(this).find('td:nth-child(1)').html();
                //    var itemName = $(this).find('td:nth-child(2)').html();
                //    var uom = $(this).find('td:nth-child(3)').html();
                //    itemTopping['ItemNoRef'] = itemNo;
                //    itemTopping['ItemNameRef'] = itemName;
                //    itemTopping['UOMRef'] = uom;
                //    arrayToppingGrab.push(itemTopping);
                //});
                //var jsonToppingGrab = arrayToppingGrab.length > 0 ? JSON.stringify(arrayToppingGrab) : "";
                //var jsonPosGroupWeb = arrayPosWebGroup.length > 0 ? JSON.stringify(arrayPosWebGroup) : "";
                //SaveItem(jsonHeader, jsonBarcode, jsonTopping, jsonCup, jsonOption, jsonDinhLuong, jsonPosGroup, jsonPosGroupWeb);

                if (partner == "")
                {
                    SaveItem(jsonHeader, jsonBarcode, jsonTopping, jsonCup, jsonOption, jsonDinhLuong, jsonPosGroup, jsonCategoryGrabFood, "");
                }
                else
                {
                    SaveItem(jsonHeader, jsonBarcode, jsonTopping, jsonCup, jsonOption, jsonDinhLuong, jsonPosGroup, jsonCategoryGrabFood, partner);
                }
                
            });

        });

        function GetInfoItem(itemNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/SetupItem/_SetupItemV2?Id=" + itemNo +"",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadItem").css("display", "none");
                    $("#updateItem").html(result);
                    $("#updateItem").css("display", "block");
                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddItem").css("display", "none");
                    loading.hideloading();
                },
                error: function (event) {
                }
            });
        }

        // New : 14/04/2025, thêm GrabFood
        function SaveItem(jsonHeader, jsonBarcode, jsonTopping, jsonCup, jsonOption, jsonDinhLuong, jsonPosGroup, jsonCategoryGrabFood, partner)
        {
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SaveItemV2", "SetupItem")',
                type: "POST",
                dataType: "json",
                data: {
                    jsonHeader: jsonHeader,
                    jsonBarcode: jsonBarcode,
                    jsonTopping: jsonTopping,
                    jsonCup: jsonCup,
                    jsonOption: jsonOption,
                    jsonDinhLuong: jsonDinhLuong,
                    jsonPosGroup: jsonPosGroup,
                    jsonCategoryGrabFood: jsonCategoryGrabFood,
                    partner: partner
                },
                success: function (response) {
                    //debugger
                    loading.hideloading();
                    if (response.Status == 200) {
                        toastr.success(response.Message);
                        $("#hdtxtItemNo").val('');
                        $("#btnCancle").trigger("click");
                        location.reload();
                    }
                    else {
                        toastr.error(response.Message);
                    }                    
                },
                error: function (data)
                {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        @*function SaveItem(jsonHeader, jsonBarcode, jsonTopping, jsonCup, jsonOption, jsonDinhLuong, jsonPosGroup, jsonPosGroupWeb) {
            //debugger
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SaveItem", "SetupItem")',
                type: "POST",
                dataType: "json",
                data: {
                    jsonHeader: jsonHeader,
                    jsonBarcode: jsonBarcode,
                    jsonTopping: jsonTopping,
                    jsonCup: jsonCup,
                    jsonOption: jsonOption,
                    jsonDinhLuong: jsonDinhLuong,
                    jsonPosGroup: jsonPosGroup,
                    jsonPosGroupWeb: jsonPosGroupWeb,
                },
                success: function (response) {
                    if (response.Status == 200)
                    {
                        toastr.success(response.Message);
                        $("#hdtxtItemNo").val('');
                        $("#btnCancle").trigger("click");
                        location.reload();
                    }
                    else
                    {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();
                },
                error: function (data)
                {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });

        }*@

    </script>
}


