@using VCM.BLUEPOS.Model.SetupItem;

@{
    var model = Model as ListItemSetupRequest;
    var itemNoHeader = model.ItemNoHeader;
}

<div style="width:99%">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
            <input type="text" id="viewItemNoOption" class="form-control eventChangeItemOption" placeholder="Mã sản phẩm" />
        </div>

        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
            <input type="text" id="viewItemNameOption" class="form-control eventChangeItemOption" placeholder="Tên sản phẩm" />
        </div>

    </div>

    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <table id="tblSelectedItemOption" class="table table-bordered table-hover">
                <thead>
                    <tr class="text-center">
                        <th>STT</th>
                        <th>Mã sản phẩm</th>
                        <th>Mã tham chiếu</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn vị tính</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>


<script type="text/javascript">

    $(".select2").select2();
    var itemHeader = '@itemNoHeader';
    var tableOption = "";
   
    $(document).ready(function () {

        $("#viewbtnSearch").on("click", function () { table.draw(); });
        $(".eventChangeItemOption").on("change", function () {
            tableOption.draw();
        });

        tableOption = $('#tblSelectedItemOption').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false,      // for show progress bar
            serverSide: true,       // for process server side
            filter: true,           // this is for disable filter (search box)
            orderMulti: false,      // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 100,
            searching: false,
            lengthChange: false,
            ajax: {
                url: '@Url.Action("LoadItemGroup", "SetupItem")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.ItemNo = $("#viewItemNoOption").val();
                    d.ItemName = $("#viewItemNameOption").val();
                    d.ItemNoHeader = itemHeader;
                    d.GroupCode = "DUM";
                }
            },
            drawCallback: function (settings) {

                //$(".chkItem").click(function () {
                //    var item = {};
                //    var itemNo = $(this).attr("data-itemno");
                //    var desc = $(this).attr("data-description");
                //    var uom = $(this).attr("data-uom");

                //    item["ItemNo"] = itemNo;
                //    item["ItemName"] = desc;
                //    item["UOM"] = uom;
                //    arraySelectedItem.push(item);
                //});

            },
            columns: [
                {
                    data: "ItemNo",
                    className: "text-center",
                    render: function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "ItemNo",
                    className: 'text-center'

                },
                {
                    data: "ItemNo2",
                    className: 'text-center'
                },
                {
                    data: "ItemName"

                },
                {
                    data: "UOM",
                    className: 'text-center'

                },
                {
                    data: "ItemNo",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" data-itemno='" + full.ItemNo + "' data-itemno2='" + full.ItemNo2 + "' data-description='" + full.ItemName + "' data-uom='" + full.UOM + "' class=\"chkItem\" name=\"chkItem\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });
</script>

