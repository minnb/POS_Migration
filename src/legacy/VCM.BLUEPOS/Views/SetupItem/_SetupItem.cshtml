            <div class="tab-pane fade" id="dacdiem" role="tabpanel" aria-labelledby="dacdiem-tab">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label class="font-weight-bold" style="font-weight:bold !important">Mã tham chiếu</label>
                                <div class="input-group">
                                    <input type="text" id="txtItemNo2" class="form-control" @disableFields value="@itemNo2" />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label class="font-weight-bold" style="font-weight:bold !important">Size</label>
                                <div class="input-group">
                                    <select class="form-control select2" style="width:100%;" id="slSize" name="Size" @disableFields>
                                        @if (listSize != null && listSize.Count > 0)
                                        {
                                            <option value="">Chọn size</option>
                                            foreach (var size in listSize)
                                            {
                                                var selected = size.Value == itemSize ? "selected" : "";
                                                <option @selected value="@size.Value">@size.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
