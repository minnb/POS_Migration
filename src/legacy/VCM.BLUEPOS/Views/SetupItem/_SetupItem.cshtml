            @*<li class="nav-item">
            <a class="nav-link classTab" id="danhmucsanphamposweb_cus-tab" data-toggle="tab" href="#danhmucsanphamposweb_cus" aria-controls="contact">
                <span class="nav-text font-weight-bold" style="font-weight:bold !important">Danh mục sản phẩm POS WEB khách hàng</span>
            </a>
        </li>*@

        </ul>

        <div class="tab-content mt-5" id="myTabContent">

            @if (dataGrabFood == null || dataGrabFood.Count == 0)
            {
                <div class="tab-pane fade show active" id="thongtinchung" role="tabpanel" aria-labelledby="thongtinchung-tab">
                    <div class="card card-custom">
                        <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                            <div class="card-title">
                                <h3 class="card-label ml-3">
                                    Danh sách Barcode
                                </h3>
                            </div>

                            <div class="card-toolbar">
                                <a style="cursor:pointer" class="btn btn-primary font-weight-bolder btnAddBarcode mr-3">
                                    <i class="la la-plus-circle"></i>
                                    Thêm Barcode
                                </a>
                            </div>

                        </div>

                        <div class="card-body">
                            <table id="tblBarcode" class="table table-bordered text-nowrap">
                                <thead>
                                    <tr style="background-color:#eaeaf0 !important">
                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Đơn vị tính</th>
                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Mã vạch</th>
                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">#</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (listBarcode != null && listBarcode.Count > 0)
                                    {
                                        foreach (var bc in listBarcode)
                                        {
                                            <tr class="barcode_@bc.Barcode">
                                                <td>
                                                    <select class="form-control select2 uom" disabled>
                                                        <option value="">Chọn UOM</option>
                                                        @foreach (var uom in listUOM)
                                                        {
                                                            var selected = uom.Code == bc.UOM ? "selected" : "";
                                                            <option @selected value='@uom.Code'>@uom.Description</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control viewBarcode" maxlength="19" value="@bc.Barcode" disabled />
                                                </td>

                                                <td style="text-align:center;vertical-align:middle">
                                                    <a title="Xóa" class="btn btn-icon btn-light-danger btnBarcodeDelete" data-barcode="@bc.Barcode"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                                </td>

                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="tab-pane fade" id="thongtinchung" role="tabpanel" aria-labelledby="thongtinchung-tab">
                    <div class="card card-custom">
                        <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                            <div class="card-title">
                                <h3 class="card-label ml-3">
                                    Danh sách Barcode
                                </h3>
                            </div>
                        </div>

                        <div class="card-body">
                            <table id="tblBarcode" class="table table-bordered text-nowrap">
                                <thead>
                                    <tr style="background-color:#eaeaf0 !important">
                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Đơn vị tính</th>
                                        <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Mã vạch</th>
                                        @*<th class="text-center" style="color:#000000 !important;font-weight:bold !important">#</th>*@
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (listBarcode != null && listBarcode.Count > 0)
                                    {
                                        foreach (var bc in listBarcode)
                                        {
                                            <tr class="barcode_@bc.Barcode">
                                                <td>
                                                    <select class="form-control select2 uom" disabled>
                                                        <option value="">Chọn UOM</option>
                                                        @foreach (var uom in listUOM)
                                                        {
                                                            var selected = uom.Code == bc.UOM ? "selected" : "";
                                                            <option @selected value='@uom.Code'>@uom.Description</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control viewBarcode" maxlength="19" value="@bc.Barcode" disabled />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
