        $(".btnAddToppingGrab").on("click", function (e) {
            //debugger
            var itemHeader = $("#hdtxtItemNo").val();
            $.ajax({
                type: "GET",
                url: "/SetupItem/_ViewListItemToppingGrab?itemHeader=" + itemHeader + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    debugger
                    $("#divPopupListItemToppingGrab").html(result);
                    $('#modalListItemToppingGrab').modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                    loading.hideloading();
                },
                error: function (event) {
                    loading.hideloading();
                }
            });
        });

        $(".btnSelectedItemToppingGrab").on("click", function (e) {
            //debugger
            arraySelectedItemGrab = [];
            arrayNotSelectedItemGrab = [];

            $('#tblSelectedItemToppingGrab tbody tr label input.chkItem:checkbox:checked').each(function (e) {
                //debugger
                var itemSelected = {};
                var itemNo = $(this).attr("data-itemno");
                var itemName = $(this).attr("data-description");
                var uom = $(this).attr("data-uom");

                itemSelected['ItemNo'] = itemNo;
                itemSelected['ItemName'] = itemName;
                itemSelected['UOM'] = uom;
                arraySelectedItemGrab.push(itemSelected);

            });

            if (arraySelectedItemGrab.length == 0) {
                toastr.error('Vui lòng chọn Topping cần thêm');
                return;
            }

            if (arraySelectedItemGrab.length > 0) {
                var html = "";
                $('#tbl-Topping-Grab tbody tr').each(function () {
                    var itemNoCurrent = $(this).find('td:nth-child(1)').html();
                    arraySelectedItemGrab = arraySelectedItemGrab.filter(item => item.ItemNo !== itemNoCurrent);
                });

                arraySelectedItemGrab.forEach((name, i) => {
                    html += "<tr class=\"toppinggrab_" + name.ItemNo + "\">";
                    html += "<td>" + name.ItemNo + "</td>";
                    html += "<td style=\"text-align: left;\">" + name.ItemName + "</td>";
                    html += "<td>" + name.UOM + "</td>";
                    html += "<td>";
                    html += "<a title=\"Xóa\" class=\"btn btn-icon btn-light-danger btn-topping-delete-grab\" data-item-no-grab=" + name.ItemNo + "><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                    html += "</td>";
                    html += "</tr>";
                });

                $("#tbl-Topping-Grab tbody").append(html);
                $('#modalListItemToppingGrab').modal('hide');

                $(".btn-topping-delete-grab").on("click", function (e) {
                    //debugger
                    var itemNo = $(this).attr("data-item-no-grab");
                    $(".toppinggrab_" + itemNo).remove();
                });


            }
        });

        $(".btn-topping-delete-grab").on("click", function (e) {
            //debugger
            var itemNo = $(this).attr("data-item-no-grab");
            $(".toppinggrab_" + itemNo).remove();
        });



    });

</script>

