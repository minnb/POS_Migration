                                <label class="font-weight-bold" style="font-weight:bold !important">Mã cha</label>
                                <div class="input-group">
                                    <input type="text" id="txtParentCode" class="form-control" value="@itemParentCode" @disableFields />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

                <div class="card card-custom ">
                    <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                        <div class="card-title">
                            <h3 class="card-label ml-3">
                                Danh sách Topping
                            </h3>
                        </div>
                        <div class="card-toolbar">
                            <a style="cursor:pointer" class="btn btn-primary font-weight-bolder btnAddTopping mr-3">
                                <i class="la la-plus-circle"></i>
                                Thêm Topping
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <table id="tblTopping" class="table table-bordered text-nowrap">
                            <thead>
                                <tr style="background-color:#eaeaf0 !important">
                                    <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Mã sản phẩm</th>
                                    <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Tên sản phẩm</th>
                                    <th class="text-center" style="color:#000000 !important;font-weight:bold !important">Đơn vị tính</th>
                                    <th class="text-center" style="color:#000000 !important;font-weight:bold !important">#</th>
                                </tr>
                            </thead>
                            <tbody style="text-align:center">
                                @if (listItemTopping != null && listItemTopping.Count > 0)
                                {
                                    foreach (var tp in listItemTopping)
                                    {
                                        <tr class="topping_@tp.ItemNoRef">
                                            <td>@tp.ItemNoRef</td>
                                            <td>@tp.ItemNameRef</td>
                                            <td>@tp.UnitOfMeasureRef</td>
                                            <td style="text-align:center;vertical-align:middle">
                                                <a title="Xóa" class="btn btn-icon btn-light-danger btnToppingDelete" data-itemnoref="@tp.ItemNoRef"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>

                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

                <div class="card card-custom ">
                    <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                        <div class="card-title">
                            <h3 class="card-label ml-3">
                                Danh sách Ly
                            </h3>
                        </div>
                        <div class="card-toolbar">
                            <a style="cursor:pointer" class="btn btn-primary font-weight-bolder btnAddCup mr-3">
                                <i class="la la-plus-circle"></i>
                                Thêm Ly
                            </a>
                        </div>
                    </div>

                    <div class="card-body">
                        <table id="tblCup" class="table table-bordered text-nowrap">
