@using VCM.BLUEPOS.Model.SetupItem;
@using Newtonsoft.Json;
@using System.Web.Configuration;

@{
    var model = Model as ViewCapNhatSanPhamModel;
    var id = model.Id;
    var infoItem = model.InfoItem;
    string itemNo = "", itemName = "", itemName2 = "", itemFamilyCode = "", itemUOM = "", itemTAX = "";
    string imgItem = "", imgBase64 = "";
    string isBlocked = "";
    string isVAT = "";
    string itemNo2 = "", itemParentCode = "", itemSize = "";
    string groupCode = "";
    string groupCodeWeb = "";

    if (infoItem != null)
    {
        itemNo = infoItem.No;
        itemNo2 = infoItem.No2;
        itemName = infoItem.Description;
        itemName2 = infoItem.SearchDescription;
        itemFamilyCode = infoItem.ItemFamilyCode;
        itemUOM = infoItem.BaseUnitOfMeasure;
        itemTAX = infoItem.TaxGroupCode;
        isBlocked = infoItem.Blocked == 0 ? "" : "checked";
        isVAT = infoItem.IsVAT == true ? "checked" : "";
        itemParentCode = infoItem.ParentCode;
        itemSize = infoItem.Size;
        groupCode = infoItem.GroupCode;
        groupCodeWeb = infoItem.GroupCodeWeb;
        imgItem = infoItem.ImageName;
        imgBase64 = infoItem.ImageBase64;
    }

    isVAT = infoItem == null ? "checked" : (infoItem.IsVAT == true ? "checked" : "");
    var listUOM = model.ListUOM;
    var listJsonUOM = Html.Raw(JsonConvert.SerializeObject(listUOM));
    var listCombo = model.ListCombo;
    var listItemType = listCombo.Where(d => d.Type == "ItemType").ToList();
    var listTax = listCombo.Where(d => d.Type == "POSVAT").ToList();
    var listSize = listCombo.Where(d => d.Type == "SIZE").ToList();
    var listOption = listCombo.Where(d => d.Type == "Option").ToList();
    var listJsonOption = Html.Raw(JsonConvert.SerializeObject(listOption));

    var listBarcode = model.ListBarcode;
    var listItemExtra = model.ListItemExtra;
    var listItemTopping = listItemExtra.Where(d => d.Type == "Topping").ToList();
    var listItemCup = listItemExtra.Where(d => d.Type == "Cup").ToList();
    var listGroupItemRef = listItemCup.GroupBy(a => new { ItemNo = a.ItemNo, ItemNoRef = a.ItemNoRef, ItemNameRef = a.ItemNameRef, UnitOfMeasure = a.UnitOfMeasure, UnitOfMeasureRef = a.UnitOfMeasureRef, Description = a.Description }).Select(a => new GroupItemExtraModel
    {
        ItemNo = a.Key.ItemNo,
        ItemNoRef = a.Key.ItemNoRef,
        ItemNameRef = a.Key.ItemNameRef,
        UnitOfMeasure = a.Key.UnitOfMeasure,
        UnitOfMeasureRef = a.Key.UnitOfMeasureRef,
        Description = a.Key.Description
    }).ToList();

    var listSalesTypeCup = listItemCup.Select(a => new { ItemNoRef = a.ItemNoRef, IsDefault = a.IsDefault, SalesTypeCode = a.SaleTypeCode, SalesTypeName = a.SaleTypeName }).ToList();

    var listItemOption = listItemExtra.Where(d => d.Type == "Option").ToList();
    var listItemDinhLuong = model.ListItemOption;

    var listPOSGroup = model.ListPOSGroup;
    var listPOSWEBGroup = model.ListPOSWEBGroup;

    var displayItemNo = infoItem == null ? "display:none" : "display:block";
    string urlImgServer = WebConfigurationManager.AppSettings["urlImg"];
    var disableCheckManual = infoItem == null ? "" : "disabled";
    var disableFields = infoItem == null ? "" : "disabled";

    // GrabFood
    var listCategoryGrabFood = model.ListCategoryGrabFood;
    var listToppingGrab = model.ListToppingGrab.ToList();
    var dataGrabFood = model.ListItemGrabFood;
    bool checkGrabFood = false;
}

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="row">
        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-12">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Mã sản phẩm</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <label class="checkbox checkbox-inline" title="Tự tạo mã">
                                        <input type="checkbox" @disableCheckManual id="chkManual" />
                                        <span></span>
                                    </label>
                                </span>
                            </div>
                            <input type="text" id="hdtxtItemNo" class="form-control manualItem" disabled value="@itemNo" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Tên sản phẩm<strong style="color:#ff0000">(*)</strong></label>
                        <div class="input-group">
                            <input type="text" id="txtItemName" class="form-control" value="@itemName" @disableFields />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Tên viết tắt</label>
                        <div class="input-group">
                            <input type="text" id="txtSearchDecs" class="form-control" value="@itemName2" @disableFields />
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Loại sản phẩm</label>
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slTypeItem" name="TypeItem" @disableFields>
                                <option value="">Chọn loại sản phẩm</option>
                                @if (listItemType != null && listItemType.Count > 0)
                                {
                                    foreach (var type in listItemType)
                                    {
                                        var selected = type.Value == itemFamilyCode ? "selected" : "";
                                        <option @selected value="@type.Value">@type.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Đơn vị tính</label>
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slUOM" name="UOM" @disableFields>
                                @if (listUOM != null && listUOM.Count > 0)
                                {
                                    <option value="">Chọn UOM</option>
                                    foreach (var uom in listUOM)
                                    {
                                        var selected = uom.Code == itemUOM ? "selected" : "";
                                        <option @selected value="@uom.Code">@uom.Description</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="font-weight-bold" style="font-weight:bold !important">Thuế suất</label>
                        <div class="input-group">
                            <select class="form-control select2" style="width:100%;" id="slTax" name="Tax" @disableFields>
                                @if (listTax != null && listTax.Count > 0)
                                {
                                    @*<option value="">Chọn tax</option>*@
                                    foreach (var tax in listTax)
                                    {
                                        var selected = tax.Value == itemTAX ? "selected" : "";
                                        <option @selected value="@tax.Value">@tax.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
               
                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                    <table style="width:100%;">
                        <tr>
                            <td style="width:20%;">
                                <div class="input-group" style="margin-top:27px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <label class="checkbox checkbox-inline" title="Xuất VAT">
                                                <input type="checkbox" @isVAT id="chkVAT" class="chkVAT" @disableFields />
                                                <span></span>
                                            </label>
                                        </span>
                                    </div>
                                    <div class="input-group-append"><span class="input-group-text">Xuất VAT</span></div>
                                </div>
                            </td>

                            <td style="width:20%;">
                                <div class="input-group" style="margin-top:27px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <label class="checkbox checkbox-inline" title="Trạng thái">
                                                <input type="checkbox" @isBlocked id="chkBlocked" class="chkBlocked" @disableFields />
                                                <span></span>
                                            </label>
                                        </span>
                                    </div>
                                    <div class="input-group-append"><span class="input-group-text">Blocked</span></div>
                                </div>
                            </td>

                            <td style="width:60%;">
                                <div class="input-group" style="margin-top:27px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <label class="checkbox checkbox-inline" title="Grab/Bee">
                                                @if (dataGrabFood != null || dataGrabFood.Count > 0)
                                                {
                                                    var checkboxGrab = dataGrabFood.FirstOrDefault()?.ItemNo == itemNo ? "checked" : "";
                                                    <input type="checkbox" @checkboxGrab data-chk-grab-id="listCategoryGrabFood.FirstOrDefault().Value" id="chkGrabFood" class="chkGrabFood" />
                                                    <span></span>
                                                }
                                                else
                                                {
                                                    <input type="checkbox" id="chkGrabFood" class="chkGrabFood" />
                                                    <span></span>
                                                }
                                            </label>
                                        </span>
                                    </div>
                                    <div class="input-group-append"><span class="input-group-text">Giao hàng (Grab/Bee)</span></div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12" style="text-align:right">
            @{
                var urlImg = "/Uploads/imgs/placeholder.png";
                var isChangeImg = "";
                if (!string.IsNullOrEmpty(imgItem))
                {
                    // [PERF] imgBase64 giờ chứa URL thay vì chuỗi base64 → không nhúng data lớn vào HTML
                    urlImg = imgBase64;
                    isChangeImg = "image-input-changed";
                }
            }

            <div class="image-input image-input-outline @isChangeImg" id="kt_img_item">
                <div class="image-input-wrapper" style="background-image: url(@urlImg)"></div>
                <label class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-toggle="tooltip" title="" data-original-title="Change avatar">
                    <i class="fa fa-pen icon-sm text-muted"></i>
                    <input type="file" id="imgItem" name="imgItem" accept=".png, .jpg, .jpeg" />
                    <input type="hidden" name="imgItem_remove" />
                </label>
                <span id="btnCancleImg" class="btn btn-xs btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="cancel" data-toggle="tooltip" title="Cancel avatar">
                    <i class="ki ki-bold-close icon-xs text-muted"></i>
                </span>
            </div>
        </div>

    </div>
</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
