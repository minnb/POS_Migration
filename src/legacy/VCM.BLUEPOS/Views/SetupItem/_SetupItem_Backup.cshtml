                                    htmlSaleType += "<td style=\"vertical-align:middle\">";
                                    htmlSaleType += "<label class=\"checkbox checkbox-lg\">";
                                    htmlSaleType += "<input type=\"checkbox\" class=\"chkDefaultCup\" data-itemnoref=" + name.ItemNo + " data-saletype='" + typeCode + "' name=\"radioDefaultCup_" + name.ItemNo + "\">";
                                    htmlSaleType += "<span></span>";
                                    htmlSaleType += "</label>";
                                    htmlSaleType += "</td>";
                                    htmlSaleType += "<td style=\"vertical-align:middle\">";
                                    htmlSaleType += "<a title=\"Xóa\" class=\"btn btn-icon btn-light-danger btnSalesTypeDelete\" data-itemnorefsalestype=" + (name.ItemNo + typeCode) + "><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                                    htmlSaleType += "</td>";
                                    htmlSaleType += "</tr>";
                                    $(".tblSalesType .saleTypeCup" + name.ItemNo).append(htmlSaleType);

                                }
                            });
                        }
                    });
                }

                $("#tblCup .bodyFirstCup").append(html);

                $('#modalListItemCup').modal('hide');

                $(".btnCupDelete").on("click", function (e) {
                    var itemNo = $(this).attr("data-itemnoref");
                    $(".cup_" + itemNo).remove();
                });

                $(".btnSalesTypeDelete").on("click", function (e) {
                    var salesType = $(this).attr("data-itemnorefsalestype");
                    $(".delSaleType_" + salesType).remove();
                });

                $(".chkDefaultCup").on("change", function (e) {
                    var saleType = $(this).attr("data-saletype"); // 10,20,30
                    //$(".chkDefaultCup").prop('checked', false);
                    $('.chkDefaultCup[data-saletype="' + saleType + '"]').prop('checked', false);
                    $(this).prop('checked', true);
                });

            }

        });

        $(".chkDefaultCup").on("change", function (e) {
            //debugger
            var saleType = $(this).attr("data-saletype");  // 10,20,30
            //$(".chkDefaultCup").prop('checked', false);
            $('.chkDefaultCup[data-saletype="' + saleType + '"]').prop('checked', false);
            $(this).prop('checked', true);
        });

        $(".btnCupDelete").on("click", function (e) {
            var itemNo = $(this).attr("data-itemnoref");
            $(".cup_" + itemNo).remove();
        });

        $(".btnSalesTypeDelete").on("click", function (e) {
            var salesType = $(this).attr("data-itemnorefsalestype");
            $(".delSaleType_" + salesType).remove();
        });

        $(".btnAddOption").on("click", function (e) {
            var itemHeader = $("#hdtxtItemNo").val();
            $.ajax({
                type: "GET",
                url: "/SetupItem/_ViewListItemOption?itemHeader=" + itemHeader +"",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#divPopupListItemOption").html(result);

                    $('#modalListItemOption').modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                    loading.hideloading();
                },
                error: function (event) {
                    loading.hideloading();
                }
            });
        });
        $(".btnSelectedItemOption").on("click", function (e) {

            arraySelectedItem = [];
            $('#tblSelectedItemOption tbody tr label input.chkItem:checkbox:checked').each(function (e) {

                var itemSelected = {};
                var itemNo = $(this).attr("data-itemno");
                var itemNo2 = $(this).attr("data-itemno2");
                var itemName = $(this).attr("data-description");
                var uom = $(this).attr("data-uom");

                itemSelected['ItemNo'] = itemNo;
                itemSelected['ItemNo2'] = itemNo2;
                itemSelected['ItemName'] = itemName;
                itemSelected['UOM'] = uom;
                arraySelectedItem.push(itemSelected);
            });

            if (arraySelectedItem.length == 0) {
                toastr.error('Vui lòng chọn Option cần thêm');
                return;
            }
            if (arraySelectedItem.length > 0) {
                var html = "";

                $('#tblOption tbody tr').each(function () {

                    var itemNoCurrent = $(this).find('td:nth-child(1)').html();
                    arraySelectedItem = arraySelectedItem.filter(item => item.ItemNo !== itemNoCurrent);

                });

                arraySelectedItem.forEach((name, i) => {
                    html += "<tr style=\"background-color:#eaeaf0 !important\" class=\"oftionFirst option_" + name.ItemNo + "\">";
                    html += "<td style=\"vertical-align:middle\">" + name.ItemNo + "</td>";
                    html += "<td style=\"vertical-align:middle\">" + name.ItemName + "</td>";
                    html += "<td style=\"vertical-align:middle\" >" + name.UOM + "</td>";
                    html += "<td style=\"text-align:center;vertical-align:middle\">";
                    html += "<a style=\"cursor:pointer;background-color:#e3e3e1\" data-toggle=\"collapse\" data-target=\"#accordion_" + name.ItemNo + "\" class=\"btn font-weight-bolder accordion-toggle\" data-itemnoref=\"" + name.ItemNo + "\" aria-expanded=\"true\">";
                    html += "<i class=\"fas fa-align-justify\"></i>";
                    html += "Định lượng";
                    html += "</a>";
                    html += "</td>";
                    html += "<td style=\"vertical-align:middle\">";
                    html += "<a title=\"Xóa\" class=\"btn btn-icon btn-light-danger btnOptionDelete\" data-itemnoref=" + name.ItemNo + "><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                    html += "</td>";
                    html += "</tr>";
                    html += "<tr class=\"option_" + name.ItemNo + "\">";
                    html += "<td style=\"vertical-align:middle;padding:1px\" colspan=12 class=\"hiddenRow\">";
                    html += "<div class=\"accordian-body collapse show\" id=\"accordion_" + name.ItemNo + "\">";
                    html += "<table class=\"table table-bordered text-nowrap tblDinhLuong\">";
                    html += "<thead>";
                    html += "<tr style=\"background-color:#eaeaf0 !important\">";
                    html += "<td style=\"color:#000000 !important;font-weight:bold !important;vertical-align:middle\">Tên định lượng</td>";
                    html += "<td style=\"color:#000000 !important;font-weight:bold !important;vertical-align:middle\">Mặc định</td>";
                    html += "<td style=\"color:#000000 !important;font-weight:bold !important;vertical-align:middle\">Chọn</td>";

                    html += "</tr>";
                    html += "</thead>";
                    html += "<tbody>";
                    jsonOption.forEach((name2, i) => {
                        var checkDF = name2.Value == "BINHTHUONG" ? "checked" : "";
                        html += "<tr class=\"dinhluong_" + name.ItemNo + name2.Value + "\">";
                        html += "<td style=\"vertical-align:middle\">" + name2.Name + "</td>";
                        html += "<td style=\"vertical-align:middle\" ><label class=\"radio radio-lg radio-rounded\"><input type=\"radio\" " + checkDF +" data-itemnoref=" + name.ItemNo + " name=\"radioDefaultOption_" + name.ItemNo + "\" /><span></span></label></td>";
                        html += "<td style=\"vertical-align:middle\"><label class=\"checkbox checkbox-lg\"><input type=\"checkbox\" checked class=\"chkDinhLuong\" data-optiontype=\"" + name2.Value + "\" data-optionname=\"" + name2.Name + "\" data-itemnooption=\"" + name.ItemNo + "\" name=\"chkOption_" + name.ItemNo + "\" /><span></span></label></td>";
                        html += "</tr>";
                    });
                    html += "</tbody>";
                    html += "</table>";
                    html += "</div>";
                    html += "</td>";
                    html += "</tr>";
                });

                $("#tblOption .bodyFirstOption").append(html);
                $('#modalListItemOption').modal('hide');

                $(".btnOptionDelete").on("click", function (e) {
                    var itemNo = $(this).attr("data-itemnoref");
                    $(".option_" + itemNo).remove();
                });
            }

        });
        $(".btnOptionDelete").on("click", function (e) {
            var itemNo = $(this).attr("data-itemnoref");
            $(".option_" + itemNo).remove();
        });

    });
</script>

