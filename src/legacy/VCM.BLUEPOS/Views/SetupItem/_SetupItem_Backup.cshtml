                                        var checkRadio = cup.IsDefault == true ? "checked" : "";
                                        var classST = "saleTypeCup" + cup.ItemNoRef;
                                        <tr style="background-color:#eaeaf0 !important" class="cupFirst cup_@cup.ItemNoRef">
                                            <td style="vertical-align:middle">@cup.ItemNoRef</td>
                                            <td style="vertical-align:middle">@cup.ItemNameRef</td>
                                            <td style="vertical-align:middle">@cup.UnitOfMeasureRef</td>
                                            @*<td>
                                                <label class="radio radio-lg radio-rounded">
                                                    <input type="radio" @checkRadio data-itemnoref='@cup.ItemNoRef' class="chkItem" name="chkItem" />
                                                    <span></span>
                                                </label>
                                            </td>*@
                                            <td style="text-align:center;vertical-align:middle">
