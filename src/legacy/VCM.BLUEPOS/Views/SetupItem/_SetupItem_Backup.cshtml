                                            <td>@tp.UnitOfMeasureRef</td>
                                            <td style="text-align:center;vertical-align:middle">
                                                <a title="Xóa" class="btn btn-icon btn-light-danger btnToppingDelete" data-itemnoref="@tp.ItemNoRef"><i class="la la-close"></i><span class="pulse-ring"></span></a>
