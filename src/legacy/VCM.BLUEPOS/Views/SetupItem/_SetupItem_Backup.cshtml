                                                    <i class="fas fa-align-justify"></i>
                                                    Hình thức BH
                                                </a>
                                            </td>
                                            <td style="text-align:center;vertical-align:middle">
                                                <a title="Xóa" class="btn btn-icon btn-light-danger btnCupDelete" data-itemnoref="@cup.ItemNoRef"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                            </td>
                                        </tr>

                                        <tr class="cup_@cup.ItemNoRef">
                                            <td colspan="12" class="hiddenRow" style="vertical-align:middle;padding:1px">
                                                <div class="accordian-body collapse" id="accordionCup_@cup.ItemNoRef">
                                                    <table class="table table-bordered text-nowrap tblSalesType">
                                                        <thead>
                                                            <tr style="background-color:#eaeaf0 !important">
                                                                <td style="color:#000000 !important;font-weight:bold !important;vertical-align:middle">Mã Hình thức BH</td>
                                                                <td style="color:#000000 !important;font-weight:bold !important;vertical-align:middle">Tên Hình thức BH</td>
                                                                <td style="color:#000000 !important;font-weight:bold !important;vertical-align:middle">Mặc định</td>
                                                                <td style="color:#000000 !important;font-weight:bold !important;vertical-align:middle">#</td>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="@classST">
                                                            @if (listSalesTypeCup != null && listSalesTypeCup.Count > 0)
                                                            {
                                                                var listTypeCodeCup = listSalesTypeCup.Where(d => d.ItemNoRef == cup.ItemNoRef).OrderBy(d => d.SalesTypeCode).ToList();
                                                                foreach (var item in listTypeCodeCup)
                                                                {
                                                                    var isDefault = item.IsDefault == true ? "checked" : "";
                                                                    <tr class="salesType_@cup.ItemNoRef delSaleType_@cup.ItemNoRef@item.SalesTypeCode">
                                                                        <td style="vertical-align:middle">@item.SalesTypeCode</td>
                                                                        <td style="vertical-align:middle">@item.SalesTypeName</td>
                                                                        <td style="vertical-align:middle">
                                                                            @*<label class="radio radio-lg radio-rounded">
                                                                                    <input type="radio" @isDefault class="chkDefaultCup" data-itemnoref='@cup.ItemNoRef' name="radioDefaultCup_@cup.ItemNoRef" />
                                                                                    <span></span>
                                                                                </label>*@
                                                                            <label class="checkbox checkbox-lg">
                                                                                <input type="checkbox" @isDefault class="chkDefaultCup" data-saletype='@item.SalesTypeCode' data-itemnoref='@cup.ItemNoRef' name="radioDefaultCup_@cup.ItemNoRef" />
                                                                                <span></span>
                                                                            </label>
                                                                        </td>
                                                                        <td style="text-align:center;vertical-align:middle">
                                                                            <a title="Xóa" class="btn btn-icon btn-light-danger btnSalesTypeDelete" data-itemnorefsalestype="@cup.ItemNoRef@item.SalesTypeCode"><i class="la la-close"></i><span class="pulse-ring"></span></a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tuychon" role="tabpanel" aria-labelledby="tuychon-tab">
                <div class="card card-custom ">
                    <div class="card-header flex-wrap" style="background-color:#eaeaf0">
                        <div class="card-title">
                            <h3 class="card-label">
                                <i class="fas fa-list-alt"></i>
                                Danh sách tùy chọn
                            </h3>
