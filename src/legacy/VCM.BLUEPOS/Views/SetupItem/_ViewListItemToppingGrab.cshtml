@using VCM.BLUEPOS.Model.SetupItem;

@{ 
    var model = Model as ListItemSetupRequest;
    var itemNoHeader = model.ItemNoHeader;
}

<div class="row">

    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
        <input type="text" id="viewItemNoToppingGrab" class="form-control eventChangeItemToppingGrab" placeholder="Mã sản phẩm" />
    </div>

    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
        <input type="text" id="viewItemNameToppingGrab" class="form-control eventChangeItemToppingGrab" placeholder="Tên sản phẩm" />
    </div>
    
</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="tblSelectedItemToppingGrab" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>Mã sản phẩm</th>
                    <th>Mã tham chiếu</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn vị tính</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<script type="text/javascript">

    $(".select2").select2();
    var itemHeader = '@itemNoHeader';
    var tableToppingGrab = "";

    $(document).ready(function () {

        $("#viewbtnSearch").on("click", function () { table.draw(); });

        $(".eventChangeItemToppingGrab").on("change", function () {
            tableToppingGrab.draw();
        });

        tableToppingGrab = $('#tblSelectedItemToppingGrab').DataTable({

            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false,      // for show progress bar
            serverSide: true,       // for process server side
            filter: true,           // this is for disable filter (search box)
            orderMulti: false,      // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 100,
            searching: false,
            lengthChange: false,

            ajax: {
                url: '@Url.Action("LoadItemGroup", "SetupItem")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.ItemNo = $("#viewItemNoToppingGrab").val();
                    d.ItemName = $("#viewItemNameToppingGrab").val();
                    d.ItemNoHeader = itemHeader;
                    d.GroupCode = "Topping";
                }
            },
            drawCallback: function (settings) {
            },
            columns: [
                {
                    data: "ItemNo",
                    className: "text-center",
                    render: function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "ItemNo",
                    className: 'text-center'
                },
                {
                    data: "ItemNo2",
                    className: 'text-center'
                },
                {
                    data: "ItemName"
                },
                {
                    data: "UOM",
                    className: 'text-center'
                },
                {
                    data: "ItemNo",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<label class=\"checkbox checkbox-lg\">";
                        html += "<input type=\"checkbox\" data-itemno='" + full.ItemNo + "' data-description='" + full.ItemName + "' data-uom='" + full.UOM + "' class=\"chkItem\" name=\"chkItem\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }
            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });
</script>
