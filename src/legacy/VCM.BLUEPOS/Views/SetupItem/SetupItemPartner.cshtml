@using VCM.BLUEPOS.Model.SetupItem;
@using System.Web.Configuration
@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.MCH;
@using VCM.BLUEPOS.Model.OptionModel;


@{
    ViewBag.Title = "Sản phẩm bán kênh đối tác";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listStore = ViewBag.ListStore as List<StoreModel>;
    var listNganhHang = (List<MCHComboboxModel>)ViewBag.ComboxNganhHang;
    var listSalesType = (List<VCM.BLUEPOS.Model.SetupItem.OptionModel>)ViewBag.SaleOrderType;

    var model = Model as ViewSetupItemPartnerModel;
    var listItem = model.ListItem;
    var totalPage = model.TotalPageNumber;
    string pageCurrent = HttpContext.Current.Request.RequestContext.RouteData.Values["page"] == null ? "1" : HttpContext.Current.Request.RequestContext.RouteData.Values["page"].ToString();
    int pageCR = int.Parse(pageCurrent);
    var totalRow = model.TotalRow;
    var pageSize = model.PageSize;
    var displayRow = $"{pageCR}-{pageSize}/{totalRow} sản phẩm";

    if (totalRow <= pageSize)
    {
        displayRow = $"{totalRow} sản phẩm";
    }
    if (pageCR > 1 && totalRow > pageSize)
    {
        displayRow = $"{(pageCR * pageSize + 1) - pageSize}-{(pageCR * pageSize > totalRow ? totalRow : pageCR * pageSize)} /{totalRow} sản phẩm";
    }

    //var keyword = Html.Raw(model.Keyword);
    //var mch2 = Html.Raw(model.MCH2);
    //var mch5 = Html.Raw(model.MCH5);

    string urlImg = WebConfigurationManager.AppSettings["urlImg"];
    //var isButtionAdd = model.IsButtonAdd;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý dữ liệu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Quản lý sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Sản phẩm bán kênh đối tác</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xl-6">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch" style="border:1px solid #0c713d;">

                                    @using (Html.BeginForm("SetupItemPartner", "SetupItem", FormMethod.Post, new { @id = "frm-setup-item-partner" }))
                                    {
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                    <label class="font-weight-bold" style="font-weight:bold !important;">Ngành hàng<strong style="color:#ff0000"> (*)</strong></label>
                                                    <div class="input-group">
                                                        <select class="form-control select2" style="width:100%;" id="sel-mch2" name="MCH2">
                                                            @if (listNganhHang != null && listNganhHang.Count > 0)
                                                            {
                                                                <option value="">Tất cả</option>
                                                                foreach (var item in listNganhHang)
                                                                {
                                                                    <option value="@item.Code">@item.Name</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-lg-5 col-md-6 col-sm-12 col-xs-12">
                                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ khóa</label>
                                                    <div class="form-group">
                                                        <input type="text" class="form-control" id="txt-text-search" name="TextSearch" placeholder="mã sản phẩm ; mã barcode; tên sản phẩm">
                                                    </div>
                                                </div>

                                                <input type="hidden" id="hdd-txt-key-word" name="keyword" />
                                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top: 25px;">
                                                    <button type="button" class="btn btn-primary" style="" id="btn-header-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                                <div class="card card-custom bgi-no-repeat gutter-b card-stretch" style="border:1px solid #0c713d;">
                                    @*@using (Html.BeginForm("SetupItemPartner", "SetupItem", FormMethod.Post, new { id = "frm-setup-item-partner", enctype = "multipart/form-data" }))
                                    {*@
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                                    <label class="font-weight-bold" style="font-weight:bold !important;">Kênh bán hàng đối tác<strong style="color:#ff0000"> (*)</strong></label>
                                                    <div class="input-group">
                                                        <select class="form-control select2" id="sel-sales-order-type" name="SalesOrderType"></select>
                                                    </div>
                                                </div>

                                                <div class="col-lg-8 col-md-6 col-sm-12 col-xs-12" style="margin-top: 25px;">
                                                    <button type="button" id="btn-header-save" class="btn btn-warning" style="color:#fff"><i class="fa fa-save" style="color:#fff;"></i> Lưu lại</button>
                                                </div>
                                            </div>
                                        </div>
                                    @*}*@
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card card-custom">
                        <div class="card-body">
                            <div id="loadItem">
                                <div class="row">
                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        @using (Html.BeginForm("SetupItemPartner", "SetupItem", FormMethod.Post, new { id = "frm-setup-item-partner", enctype = "multipart/form-data" }))
                                        {
                                            @*<div class="input-group input-group-sm input-group-solid" style="width:70%">
                                                <input type="text" class="form-control" id="txtSearch" name="keyword" value="@keyword" placeholder="Tìm mã sản phẩm, mã barcode, tên sản phẩm..." />
                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-search btnSearch" style="cursor:pointer"></i>
                                                    </span>
                                                </div>
                                                </div>*@

                                            <div class="input-group input-group-sm input-group-solid" style="margin-top:10px;background: none;">
                                                <input type="checkbox" class="cusor" style="width: 20px;height:20px;" id="chk-check-all" name="CheckAll" />
                                                <span style="margin-left: 5px;font-weight:700;">Chọn tất cả (theo trang)</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="col-lg-12 col-md-6 col-sm-6 col-xl-6">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap" style="text-align:right; float:right">
                                            @if (totalPage > 1)
                                            {
                                                <div class="d-flex flex-wrap">
                                                    <a href="@Url.Action("SetupItemPartner", "SetupItem", new { page = 1, keyword = "" })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-back icon-xs"></i>
                                                    </a>
                                                    <a href="@Url.Action("SetupItemPartner", "SetupItem", new { page = pageCR > 1 ? pageCR - 1 : pageCR, keyword = "" })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-back icon-xs"></i>
                                                    </a>
                                                    @for (int page = 1; page <= totalPage; page++)
                                                    {
                                                        var activePage = pageCR == page ? "active" : "";
                                                        <a href="@Url.Action("SetupItemPartner", "SetupItem", new { page = page, keyword = "" })" class="btn btn-icon btn-sm border-0 btn-hover-primary mr-2 my-1 @activePage">@page</a>
                                                    }
                                                    <a href="@Url.Action("SetupItemPartner", "SetupItem", new { page = pageCR < totalPage ? pageCR + 1 : pageCR, keyword = "" })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-arrow-next icon-xs"></i>
                                                    </a>

                                                    <a href="@Url.Action("SetupItemPartner", "SetupItem", new { page = totalPage, keyword = "" })" class="btn btn-icon btn-sm btn-light-primary mr-2 my-1">
                                                        <i class="ki ki-bold-double-arrow-next icon-xs"></i>
                                                    </a>
                                                </div>
                                            }

                                            <div class="d-flex align-items-center">
                                                <span class="text-muted">@displayRow</span>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>

                                <div class="row" id="div-infor-item-list">
                                    @if (listItem != null && listItem.Count > 0)
                                    {
                                        foreach (var item in listItem)
                                        {
                                            var fullImgPath = $"{urlImg}/{item.ImageId}";
                                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12" style="margin-bottom:-20px">
                                                <div class="card card-custom gutter-b card-stretch" style="border:1px solid #d5d2d2">
                                                    <div class="card-body">
                                                        <div style="cursor:pointer" class="d-flex align-items-center div-infor-item" data-itemno="@item.ItemNo">
                                                            <div>
                                                                <input type="checkbox" class="chk-item-no" name="CheckItemNo" style="width: 20px; height:20px;" />
                                                            </div>
                                                            <div class="flex-shrink-0 mr-4 mt-lg-0" style="margin-left:5px;">
                                                                <div class="symbol symbol-lg-75 div-image">
                                                                    @if (item.ImageId > 0)
                                                                    {
                                                                        <img src="~/Uploads/imgs/placeholder.png" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <img src="@fullImgPath" />
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="d-flex flex-column" style="font-family:Roboto ,Unicode Support Noto, sans-serif">
                                                                <a class="text-dark font-weight-bold text-hover-primary mb-0 div-item-name"><span>@item.ItemName</span></a>
                                                                <span class="text-muted font-weight-bold div-item-no">No:<span>@item.ItemNo</span></span>
                                                                @*<span class="text-muted font-weight-bold div-barcode">Barcode:<span>@item.BarcodeNo</span></span>*@
                                                                @*<span class="text-muted font-weight-bold div-uom">UOM:<span>@item.BaseUnitOfMeasure</span></span>*@
                                                                <span class="text-muted font-weight-bold div-category">Category:<span>@item.MCH2</span><span>-</span><span>@item.MCH2_Name</span></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                            </div>

                            <div id="updateItem" style="display:none"></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts
{
    <script type="text/javascript">
        var keyword = $("#hdd-txt-key-word").val();

         function LoadComboxSalesOrderType() {
                  loading.showloading();
                  $.ajax({
                        type: "POST",
                        url: '@Url.Action("LoadComboxSalesOrderType", "Common")',
                        dataType: "json",
                        success: function (data) {
                            if (data != null) {
                                if (data.length == 1) {
                                    data.forEach((name, i) => {
                                        var html = "<option value='" + name.Text + "'>" + name.Value + " - " + name.Text + "</option>"
                                        //var html = "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + "</option>"
                                    });
                                    $('#sel-sales-order-type').html(html);
                                }
                                else if (data.length > 1)
                                {
                                    var html = "<option value=\"\" selected>Tất cả</option>";
                                    data.forEach((name, i) => {
                                        if (name.Code != "") {
                                            html += "<option value='" + name.Text + "'>" + name.Value + " - " + name.Text + "</option>";
                                            //html += "<option value='" + name.Value + "'>" + name.Value + " - " + name.Text + "</option>";
                                        }
                                    });
                                    $('#sel-sales-order-type').html(html);
                                }
                            }
                            loading.hideloading();
                        },
                        error: function ()
                        {
                        }
                    });
        };

        function GetDataRowItem() {
             //debugger
             var data = [];
             var salesType = $('#sel-sales-order-type').val();

            $('.div-infor-item div').each(function () {
                debugger
                var item = {};
                    var checkItemNo = $(this).parents('div').find('*.chk-item-no').prop('checked');
                    var itemNo = $(this).parents('div').find('*.div-item-no').find('span:nth-child(1)').html();
                    var itemName = $(this).parents('div').find('*.div-item-name').find('span:nth-child(1)').html();
                    var barCode = $(this).parents('div').find('*.div-barcode').find('span:nth-child(1)').html();
                    var uom = $(this).parents('div').find('*.div-uom').find('span:nth-child(1)').html();
                    var cateCode = $(this).parents('div').find('*.div-category').find('span:nth-child(1)').html();
                    var cateName = $(this).parents('div').find('*.div-category').find('span:nth-child(3)').html();
                    //var img = $(this).parents('div').find('*.div-image').html();

                    item['ItemNo'] = itemNo;
                    item['ItemName'] = itemName;
                    item['UnitOfMeasure'] = uom;
                    item['Barcode'] = barCode;
                    item['CategoryCode'] = cateCode;
                    item['CategoryName'] = cateName;
                    item['SaleType'] = salesType;
                    item['CheckItem'] = checkItemNo;
                    //item['Images'] = img;
                    data.push(item);
               
            });

            return data;
         };

        function SaveItemListForPartner() {
            //debugger
            var itemInfor = GetDataRowItem();
            if (itemInfor == null || itemInfor.length == 0) {
                toastr.error('Không có thông tin để lưu. Vui lòng kiểm tra lại');
                return;
            }

            loading.showloading();

            $.ajax({
                url: '@Url.Action("SaveItemListForPartner", "SetupItem")',
                type: "POST",
                dataType: "json",
                data: {
                    //StoreNo: _storeNo,
                    ListItemPartnerStr: JSON.stringify(itemInfor)
                },
                success: function (response) {
                    if (response.Status == 200) {
                        toastr.success(response.Message);
                        //$("#hdtxtItemNo").val('');
                        //$("#btnCancle").trigger("click");
                        location.reload();
                    }
                    else {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


        $(document).ready(function () {

            $(".select2").select2();
            LoadComboxSalesOrderType();

            $("#btn-header-search").on("click", function (e) {
                debugger
                var keyword = $("#txt-text-search").val();
                var keyword = "";
                $("#hdd-txt-key-word").val(keyword);
                var mch2 = $("#sel-mch2").val();

                loading.showloading();
                $('#frm-setup-item-partner').attr('action', "/san-pham-doi-tac/1/" + keyword + "/" + mch2 + "").submit();
            });

            $("#sel-mch2").on("change", function () {
                var mch2 = $("#sel-mch2").val();
                $("#sel-mch5").empty();
                loading.showloading();
                var fromData = new FormData();
                fromData.append('MCH2', mch2);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetMCH5", "SetupItem")',
                    data: fromData,
                    contentType: "application/json",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        var html = "";
                        html += "<option value=''>Tất cả</option>";
                        if (data != null) {
                            data.forEach((name, i) => {
                                html += "<option value='" + name.Code + "'>" + name.Name + "</option>";
                            });
                        }
                        $('#sel-mch5').html(html);
                        loading.hideloading();
                    },
                    error: function () { }
                });
            });

            $('#btn-header-save').on('click', function (e) {
                debugger
                SaveItemListForPartner();
            });





    });
    </script>
}


