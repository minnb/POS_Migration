
@{
    var offerNo = "1234";
}

<div class="row">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
        <input type="text" id="viewGroupCode" class="form-control eventChangeGroup" placeholder="groupCode" />
    </div>

    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
        <input type="text" id="viewGroupName" class="form-control eventChangeGroup" placeholder="groupName" />
    </div>
    @*<div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
            <button type="button" class="btn btn-primary font-weight-bold" id="btnSaveGroupCHST"><i class="fa fa fa-save"></i> Lưu</button>
        </div>*@

</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row  table-responsive" style="height:450px">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="AddStoreGroup_viewtblDataGroup" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>GROUP CODE</th>
                    <th>GROUP NAME</th>
                    <th>CH/ST</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>



<script type="text/javascript">
    var offerNo = '@offerNo';
    var arrayGroupCode = [];
    var table = "";
    $(document).ready(function () {
        $(".eventChangeGroup").on("change", function () {
            table.draw();
        });
        $("#viewbtnSearchGroup").on("click", function () { table.draw(); });

        $("#btnSaveGroupCHST").on("click", function () {
            if (arrayGroupCode.length == 0 || arrayGroupCode=="[]") {
                toastr.error("Vui lòng chọn nhóm CH/ST","Thông báo");
            }
            else {
                var jsonGroupCode = JSON.stringify(arrayGroupCode);
                SetListGroupSite(offerNo, jsonGroupCode);
            }
        });

        table = $('#AddStoreGroup_viewtblDataGroup').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false, // for show progress bar
            serverSide: true, // for process server side
            filter: true, // this is for disable filter (search box)
            orderMulti: false, // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 10,
            searching: false,
            lengthChange: false,
            ajax: {
                url: '@Url.Action("ListGroupSite", "ExtraFee")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.StoreGroup = $("#viewGroupCode").val();
                    d.StroreGroupName = $("#viewGroupName").val();
                }
            },
            //data, type, full, meta
            createdRow: function (row, data, full, meta) {
                debugger
                $(row).attr('id', "rowRecord" + data.StoreGroup);
                $(row).attr('class', "classGroupCode");
                $(row).attr('data-groupcode', data.StoreGroup);
            },
            drawCallback: function (settings) {
                $(".eventGroupCode").click(function () {
                    var groupcode = $(this).attr("data-groupcode");
                    ViewListStore(groupcode);
                });

                $(".chkStoreGroupCode").click(function () {
                    
                    var groupCode = $(this).attr("data-groupcode");                 
                    $("#txtStoreGroup").val(groupCode);                 
                    $("#modalSetupCHST").modal('hide');
                });
                $(".deleteGroupSite").click(function () {
                    debugger
                    var groupSite = $(this).attr("data-groupsite");
                    DeleteGroupSite(groupSite);

                });
            },
            columns: [
                {
                    data: "StoreGroup",
                    "className": "text-center",
                    "render": function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "StoreGroup",
                    className: 'text-center classGroupCode'

                },
                {
                    data: "StroreGroupName",
                    className: 'text-center classGroupCode'
                },
                {
                    data: "StoreGroup",
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<a title=\"Xem CH/ST\" data-groupcode='" + full.StoreGroup + "' class=\"btn btn-icon btn-light-primary eventGroupCode\"><i class=\"flaticon2-gear\"></i><span class=\"pulse-ring\"></span></a>";
                        html += "<a title=\"Xóa CH/ST\" style=\"margin-left:5px\" data-groupsite='" + full.StoreGroup + "' class=\"btn btn-icon btn-light-danger deleteGroupSite\"><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";

                        return html;
                    },
                    className: 'text-center'
                },
                {
                    data: "StoreGroup",
                    render: function (data, type, full, meta) {
                        //var html = "";
                        //html += "<label class=\"radio radio-lg radio-rounded\" title=\"Chọn groupCode\">";
                        //html += "<input type=\"radio\" data-groupcode='" + full.GroupCode + "' data-groupname='" + full.GroupName + "' class=\"radioChkGroupCode\" name=\"radioGroup\" />";
                        //html += "<span></span>";
                        //html += "</label>";
                        //return html;

                        var html = "";
                        html += "<label class=\"checkbox checkbox-lg\" title=\"Chọn groupCode\">";
                        html += "<input type=\"checkbox\" data-groupcode='" + full.StoreGroup + "' data-groupname='" + full.StroreGroupName + "' class=\"chkStoreGroupCode\" name=\"chkStoreGroupCode\" />";
                        html += "<span></span>";
                        html += "</label>";
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });

   

    function ViewListStore(groupCode) {
        $.ajax({
            type: "GET",
            url: "/ExtraFee/_ViewListStore?groupCode=" + groupCode + "",
            dataType: 'html',
            contentType: false,
            processData: false,
            success: function (result) {
                $("#loadGroupStore").html(result);

            },
            error: function (event) {

            }
        });
    }

    function DeleteGroupSite(groupSite) {
        var thongbao = "Bạn có chắc chắn xóa group site " + groupSite + " này không?";
        $.confirm({
            backgroundDismiss: false,
            escapeKey: true,
            icon: 'fa fa-warning',
            type: 'red',
            typeAnimated: true,
            title: 'Thông báo',
            content: thongbao,
            buttons: {
                "CÓ": {
                    btnClass: 'btn btn-default',
                    keys: ['ctrl'],
                    action: function () {
                        var fromData = new FormData();
                        fromData.append('GroupSite', groupSite);
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("DeleteGroupSite", "ExtraFee")',
                            data: fromData,
                            contentType: "application/json",
                            dataType: "json",
                            contentType: false,
                            processData: false,
                            success: function (data) {
                                if (data.Status == 200) {
                                    toastr.success(data.Message);
                                    table.draw();
                                    $("#txtStoreGroup").val('');
                                }
                                else {
                                    toastr.error(data.Message);
                                }

                            },
                            error: function () {
                            }
                        });
                    }
                },
                "KHÔNG": {
                    btnClass: 'btn-default',
                    action: function () { }
                }
            }
        });
    }
</script>

