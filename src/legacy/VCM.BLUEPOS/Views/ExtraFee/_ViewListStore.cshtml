@{
    var groupCode = ViewBag.GroupCode;
}
<div class="row" style="margin-top: -20px;">
    <label class="col-form-label col-12 text-left font-weight-bold text-primary">
        <a class="font-size-lg">
            <span class="label label-xl label-dot label-warning"></span>  Danh sách cửa hàng thuộc group (@groupCode)
        </a>
    </label>
</div>
<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;"></div>
<div class="row">
    <div class="col-lg-5 col-md-5 col-sm-5 col-xs-12">
        <input type="text" id="viewStoreNo" class="form-control eventChangeStore" placeholder="storeNo" />
    </div>

    <div class="col-lg-5 col-md-5 col-sm-5 col-xs-12">
        <input type="text" id="viewStoreName" class="form-control eventChangeStore" placeholder="storeName" />
    </div>
    <div class="col-lg-2 col-md-2 col-sm-5 col-xs-12">
        <button type="button" class="btn btn-light-primary font-weight-bold backAgaint"> <i class="flaticon2-left-arrow"></i>Quay lại</button>
    </div>
</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row  table-responsive" style="height:400px">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="viewtblDataSite" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>STORE NO</th>
                    <th>STORE NAME</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
            var tableStoreSetup = "";
            var groupCode = '@groupCode';
            $(document).ready(function () {
                tableStoreSetup = $('#viewtblDataSite').DataTable({
                    dom: '<"top"iflp<"clear">>rt',
                    destroy: true,
                    paging: true,
                    pagingType: "simple_numbers",
                    responsive: true,
                    processing: false, // for show progress bar
                    serverSide: true, // for process server side
                    filter: true, // this is for disable filter (search box)
                    orderMulti: false, // for disable multiple column at once
                    autoWidth: true,
                    ordering: false,
                    displayLength: 10,
                    searching: false,
                    lengthChange: false,
                    ajax: {
                        url: 'ExtraFee/LoadStoreByGroup',
                        type: "POST",
                        datatype: "json",
                        data: function (d) {
                            d.SiteNo = $("#viewStoreNo").val();
                            d.SiteName = $("#viewStoreName").val();
                            d.GroupCode = groupCode;
                        }
                    },
                    columns: [
                        {
                            data: "SiteNo",
                            "className": "text-center",
                            "render": function (data, type, row, meta) {
                                var start = meta.settings._iDisplayStart;
                                return meta.row + 1 + start;
                            }
                        },
                        {
                            data: "SiteNo",
                            className: 'text-center'

                        },
                        {
                            data: "SiteName"

                        }
                    ]
                }).on('processing.dt', function (e, settings, processing) {

                    if (processing) {
                        loading.showloading();
                    } else {
                        loading.hideloading();
                    }

                });

                $(".backAgaint").on("click", function () {
                    LoadGroupSite();
                });
                $(".eventChangeStore").on("change", function () {
                    tableStoreSetup.draw();
                });
            });
</script>
