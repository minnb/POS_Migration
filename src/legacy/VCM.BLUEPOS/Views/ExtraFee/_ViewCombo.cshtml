@using VCM.BLUEPOS.Model.SetupExtraFee;
@using Newtonsoft.Json;
@{
    var model = Model as ViewComboModel;
    var listComboSelected = model.ListComboSelected;
    var extraFeeValue = "0";
    var jsonOfferNo = "";
    string displayFeeValue = "";
    if (listComboSelected != null && listComboSelected.Count > 0)
    {
        displayFeeValue = "disabled";
        extraFeeValue = listComboSelected.FirstOrDefault().ExtraFeeValue;
        jsonOfferNo = JsonConvert.SerializeObject(listComboSelected.Select(a => a.No).ToList());
    }
    var listJsonOfferNo = Html.Raw(jsonOfferNo);
}
<div class="row">
    <label class="col-form-label col-4 text-left" style="font-weight:bold">Phụ thu(%)</label>
    <div class="col-8">
        <input class="form-control" type="text" id="txtComboExtraFeeValue" @displayFeeValue placeholder="0" value="@extraFeeValue" />
    </div>
</div>
<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>
<div class="row">
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12">
        <input type="text" id="viewOfferNo" class="form-control eventChangeOffer" placeholder="Mã CTKM" />
    </div>

    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
        <input type="text" id="viewOfferName" class="form-control eventChangeOffer" placeholder="Tên CTKM" />
    </div>

</div>

<div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:10px;"></div>

<div class="row  table-responsive" style="height:450px">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <table id="tblOfferHeader" class="table table-bordered table-hover">
            <thead>
                <tr class="text-center">
                    <th>STT</th>
                    <th>Mã CTKM</th>
                    <th style="max-width:250px;min-width:250px">Tên CTKM</th>
                    <th>Loại CTKM</th>
                    <th>
                        <input type="checkbox" class="chkAll" id="chkAll" value="" style="height:20px;width:20px;">
                    </th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<script type="text/javascript">
    $(".select2").select2();
    var tableOffer = "";
    var arrayOffer = "";
    debugger

    @*if ('@jsonOfferNo' != "") {
        arrayOffer = JSON.stringify('@jsonOfferNo');
    }*@
    console.log("arrayOffer", '@listJsonOfferNo');


    $(document).ready(function () {

        $("#chkAll").click(function () {
            if ($("#chkAll").is(':checked')) {
                $('.chkOffer').prop('checked', true);
            }
            else {
                $('.chkOffer').prop('checked', false);
            }
        });

        $(".eventChangeOffer").on("change", function () {
            $('#chkAll').prop('checked', false);
            tableOffer.draw();
        });

        tableOffer = $('#tblOfferHeader').DataTable({
            dom: '<"top"iflp<"clear">>rt',
            destroy: true,
            paging: true,
            pagingType: "simple_numbers",
            responsive: true,
            processing: false, // for show progress bar
            serverSide: true, // for process server side
            filter: true, // this is for disable filter (search box)
            orderMulti: false, // for disable multiple column at once
            autoWidth: true,
            ordering: false,
            displayLength: 50,
            searching: false,
            lengthChange: false,
            ajax: {
                url: '@Url.Action("LoadExtraFeeCombo", "ExtraFee")',
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.OfferNo = $("#viewOfferNo").val();
                    d.OfferName = $("#viewOfferName").val();
                    d.ComboSelected = '@listJsonOfferNo';
                }
            },
            drawCallback: function (settings) {
                $(".chkOffer").click(function () {
                    //var itemOffer = {};
                    var offerNo = $(this).attr("data-offerno");
                    //itemOffer["OfferNo"] = offerNo;

                });
            },
            columns: [
                {
                    data: "No",
                    "className": "text-center",
                    "render": function (data, type, row, meta) {
                        var start = meta.settings._iDisplayStart;
                        return meta.row + 1 + start;
                    }
                },
                {
                    data: "No",
                    className: 'text-center'
                },
                {
                    data: "Description"
                },
                {
                    data: "OfferType",
                    "className": "text-center"
                },
                {
                    data: "No",
                    render: function (data, type, full, meta) {
                        var html = "";
                        if (full.IsOfferSelected == true) {
                            html += "<label class=\"checkbox checkbox-lg\">";
                            html += "<input type=\"checkbox\" class=\"chkOffer\" checked data-offerno='" + full.No + "' data-offername='" + full.Description + "' name=\"chkOffer\" />";
                            html += "<span></span>";
                            html += "</label>";
                        }
                        else {
                            html += "<label class=\"checkbox checkbox-lg\">";
                            html += "<input type=\"checkbox\" class=\"chkOffer\" data-offerno='" + full.No + "' data-offername='" + full.Description + "' name=\"chkOffer\" />";
                            html += "<span></span>";
                            html += "</label>";
                        }
                        return html;
                    },
                    className: 'text-center'
                }

            ]
        }).on('processing.dt', function (e, settings, processing) {

            if (processing) {
                loading.showloading();
            } else {
                loading.hideloading();
            }

        });
    });
</script>


