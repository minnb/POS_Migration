
@{
    ViewBag.Title = "Cài đặt phụ thu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">

                    <li class="breadcrumb-item text-muted">
                        <a>IT</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Phụ thu</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Cài đặt phụ thu</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnAddExtraFee"><i class="la la-plus-circle"></i> Thêm phụ thu</button>
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>

        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div id="loadExtraFee">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card card-custom">
                            <div class="card-body">
                                <div class="row">

                                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Mã phụ thu</label>
                                            <div class="input-group">
                                                <input type="text" id="slSearchExtraFeeNo" class="form-control" placeholder="Mã phụ thu" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Tên phụ thu</label>
                                            <div class="input-group">
                                                <input type="text" id="slSearchExtraFeeName" class="form-control" placeholder="Tên phụ thu" />
                                            </div>
                                        </div>
                                    </div>

                                    @*<div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold" style="font-weight:bold !important">Cách phát hành</label>
                                                <div class="input-group">
                                                    <select class="form-control select2" style="width:100%;" id="slSearchExtraFeeCode" name="IssueType">
                                                        <option value="">Tất cả</option>
                                                        <option value="Auto">Tự động tạo mã</option>
                                                        <option value="Import">Import excel</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                                <div class="input-group">
                                                    <select class="form-control select2" style="width:100%;" id="slSearchExtraFeeStoreGroup" name="Blocked">
                                                        <option value="">Tất cả</option>
                                                        <option value="1">Hiệu lực</option>
                                                        <option value="0">Hết hiệu lực</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>*@

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <button type="button" id="btnSearch" class="btn btn-primary" style="margin-top:27px;"><i class="fa fa-search"></i> Tìm</button>
                                    </div>

                                </div>

                                <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                                
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                                        <table id="tblData" class="table table-bordered table-hover">
                                            <thead>
                                                <tr class="text-center">
                                                    <th>STT</th>
                                                    <th>MÃ PHỤ THU</th>
                                                    <th>TÊN PHỤ THU</th>
                                                    <th>HÌNH THỨC</th>
                                                    <th>PHÍ PHỤ THU</th>
                                                    <th>NHÓM CH</th>
                                                    <th>TỪ NGÀY</th>
                                                    <th>ĐẾN NGÀY</th>
                                                    <th>#</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="updateExtraFee" style="display:none"></div>

    </div>
</div>


@section Scripts
{

    <script type="text/javascript">

        var table = "";
        var tableCode = "";

        $(document).ready(function () {

            $(".select2").select2();
            LoadData();

            $("#btnSearch").on("click", function (e) {
                //debugger
                table.search(this.value).draw();
            });

            $("#btnAddExtraFee").on("click", function (e) {
                GetInfoExtraFee("");
            });

            $("#btnCancle").on("click", function (e) {

                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddExtraFee").css("display", "block");

                $("#loadExtraFee").css("display", "block");
                $("#updateExtraFee").css("display", "none");
                table.draw();
            });

            $("#btnSave").on("click", function (e) {
                debugger
                var extraFeeCode = $("#hdtxtCode").val();
                var extraFeeName = $("#txtName").val(); 
                var saleType = $("#slSalesType").val();
                var fromDate = $("#fromDate").val();
                var toDate = $("#toDate").val();
                var storeGroup = $("#txtStoreGroup").val();

                if (extraFeeName == "") {
                    toastr.error("Vui lòng nhập tên phụ thu");
                    return;
                }

                if (saleType == "") {
                    toastr.error("Vui lòng chọn hình thức bán hàng");
                    return;
                }

                if (fromDate == "") {
                    toastr.error("Vui lòng chọn ngày bắt đầu");
                    return;
                }
                if (toDate == "") {
                    toastr.error("Vui lòng chọn ngày kết thúc");
                    return;
                }

                if (storeGroup == "") {
                    toastr.error("Vui lòng chọn nhóm CH/ST");
                    return;
                }

                var arrayExtraFeeHeader = [];
                var itemExtraFeeHeader = {};
                itemExtraFeeHeader['ExtraFeeNo'] = extraFeeCode;
                itemExtraFeeHeader['ExtraFeeName'] = extraFeeName;
                itemExtraFeeHeader['StoreGroup'] = storeGroup;
                itemExtraFeeHeader['ArraySalesType'] = saleType;
                itemExtraFeeHeader['FromDateStr'] = fromDate;
                itemExtraFeeHeader['ToDateStr'] = toDate;
                itemExtraFeeHeader['ItemNo'] = "69000013";

                arrayExtraFeeHeader.push(itemExtraFeeHeader);
                if (arrayExtraFeeHeader.length == 0) {
                    toastr.error("Bạn chưa tạo dữ liệu phụ thu");
                    return;
                }
                var arrayNganhHang = [];

                $('#tblNganhHang tbody tr.dataNganhHang').each(function (e) {
                    var itemNganhHang = {};
                    var groupCode = $(this).find('td:nth-child(1)').html();
                    var extraFeeValue = $(this).find('td:nth-child(3)').html();

                    itemNganhHang['No'] = groupCode;
                    itemNganhHang['ItemType'] = "Group";
                    itemNganhHang['ExtraFeeValue'] = extraFeeValue;
                    arrayNganhHang.push(itemNganhHang);
                });

                var arrayCombo = [];
                $('#tblCombo tbody tr').each(function (e) {
                    var itemCombo = {};
                    var offerNo = $(this).find('td:nth-child(1)').html();
                    var extraFeeValue = $(this).find('td:nth-child(3)').html();

                    itemCombo['No'] = offerNo;
                    itemCombo['ItemType'] = "Combo";
                    itemCombo['ExtraFeeValue'] = extraFeeValue;
                    arrayCombo.push(itemCombo);
                });

                var jsonExtraFeeHeader = arrayExtraFeeHeader.length > 0 ? JSON.stringify(arrayExtraFeeHeader) : "";
                var jsonExtraFeeNganhHang = arrayNganhHang.length > 0 ? JSON.stringify(arrayNganhHang) : "";
                var jsonExtraFeeCombo = arrayCombo.length > 0 ? JSON.stringify(arrayCombo) : "";

                loading.showloading();

                $.ajax({
                    url: '@Url.Action("SaveExtraFee", "ExtraFee")',
                    type: "POST",
                    dataType: "json",
                    data: {
                        jsonExtraFeeHeader: jsonExtraFeeHeader,
                        jsonExtraFeeNganhHang: jsonExtraFeeNganhHang,
                        jsonExtraFeeCombo: jsonExtraFeeCombo
                    },
                    success: function (response) {
                        if (response.Status == 200) {
                            debugger
                            toastr.success(response.Message);
                            LoadData();
                            $("#hdtxtCode").val('');
                            $("#btnCancle").trigger("click");


                        }
                        else {
                            toastr.error(response.Message);
                        }
                        loading.hideloading();

                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });

            });
        });

        function SaveAdvance() {
            var itemNo = $("#hdtxtItemNo").val();
            var saleType = $("#slSalesType").val();
            var storeGroup = $("#slStoreGroup").val();
            var itemName = $("#txtItemName").val();
            var typeIssue = $("#slIssueType").val();
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            var dvt = $("#slUOM").val();
            var typeCpn = $("#slTypeCpn").val();
            var discountType = $("#slDiscountType").val();
            var discountValue = $("#txtDiscountValue").val().replace(/\,/g, '');
            var maxAmount = $("#txtMaxAmount").val().replace(/\,/g, '');
            var limitQty = $("#txtLimitQty").val().replace(/\,/g, '');
            var limitQtyUsed = $("#txtLimitQtyUsed").val().replace(/\,/g, '');

            //debugger;
            var isBlock = false;
            if ($("#chkBlocked").prop('checked')) {
                isBlock = true;
            }

            var isMultiUse = false;
            if ($("#chkIsMultiUse").prop('checked')) {
                isMultiUse = true;
            }
            var checkAPI = false;
            if ($("#chkCheckAPI").prop('checked')) {
                checkAPI = true;
            }

            if (isMultiUse == true) {
                if (parseInt(limitQtyUsed) == 0) {
                    toastr.error("Vui lòng nhập số lần sử dụng");
                    return;
                }
            }

            if (itemName == "") {
                toastr.error("Vui lòng nhập tên phát hành coupon");
                return;
            }

            if (typeIssue == "") {
                toastr.error("Vui lòng chọn cách phát hành");
                return;
            }

            if (dvt == "") {
                toastr.error("Vui lòng chọn đơn vị tính");
                return;
            }
            if (discountValue == "" || discountValue == "0") {
                toastr.error("Vui lòng nhập giá trị giảm giá");
                return;
            }

            if (parseInt(discountType) == 1 && parseInt(discountValue) > 100) {
                toastr.error("Giá trị phần trăm giảm giá không lơn hơn 100");
                return;
            }

            if (fromDate == "") {
                toastr.error("Vui lòng chọn ngày bắt đầu");
                return;
            }
            if (toDate == "") {
                toastr.error("Vui lòng chọn ngày kết thúc");
                return;
            }
            loading.showloading();
            $.ajax({
                url: '@Url.Action("SaveAdvancedCoupon", "SetupCoupon")',
                type: "POST",
                dataType: "json",
                data: {

                    ItemNo: itemNo,
                    Description: itemName,
                    IssueType: typeIssue,
                    UOM: dvt,
                    CpnVchType: typeCpn,
                    DiscountType: discountType,
                    DiscountValue: discountValue,
                    StartingDateStr: fromDate,
                    EndingDateStr: toDate,
                    MaxValue: maxAmount,
                    Blocked: isBlock,
                    LimitQty: limitQty,
                    IsMultiUsed: isMultiUse,
                    LimitQtyUsed: limitQtyUsed,
                    IsCheckAPI: checkAPI,
                    SaleType: saleType,
                    StoreGroupCode: storeGroup

                },
                success: function (response) {
                    if (response.Status == 200) {
                        toastr.success(response.Message);
                        var model = response.Data;
                        $("#hdtxtItemNo").val(model.ItemNo);
                        if (typeIssue == "Auto") {
                            $(".importExcel").css("display", "block");
                            $(".importFileExcel").css("display", "none");
                            $("#txtPrefix").prop("disabled", "disabled");
                            $("#txtLenCode").prop("disabled", "disabled");
                            $("#txtCharOfNumber").prop("disabled", "disabled");
                            $("#txtCharPosition").prop("disabled", "disabled");
                            $("#txtQuantity").prop("disabled", "disabled");
                            $("#slIssueType").prop("disabled", "disabled");
                        }
                        else {
                            $(".importExcel").css("display", "none");
                            $(".importFileExcel").css("display", "block");
                            $("#browseFileExcel").prop("disabled", "disabled");
                        }
                        $('#modalAdvanced').modal('hide');
                    }
                    else {
                        toastr.error(response.Message);
                    }
                    loading.hideloading();
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }

        function LoadData() {
            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                //paging: true,
               // pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: false, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("SetupExtraFeeLoad", "ExtraFee")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.Code = $("#slSearchExtraFeeNo").val();
                        d.Name = $("#slSearchExtraFeeName").val();
                        d.StoreGroup = "";
                    }
                },
                createdRow: function (row, data, dataIndex) {

                    //$(row).attr('class', "clssRow");
                    //$(row).attr('data-itemno', data.ItemNo);

                   // var a = $(row).find('td:eq(2)').html();
                    $(row).find('.clssRow').attr('data-code', data.Code);
                },
                drawCallback: function (settings) {
                    $(".clssRow").click(function () {

                        var code = $(this).attr("data-code");
                        GetInfoExtraFee(code);

                    });
                    $(".deleteExtraFee").on("click", function (e) {
                        var code = $(this).attr("data-code");
                        var thongbao = "Bạn có chắc chắn xóa phụ thu " + code + " này không?";
                        $.confirm({
                            backgroundDismiss: false,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: thongbao,
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        debugger
                                        var fromData = new FormData();
                                        fromData.append('Code', code);
                                        $.ajax({
                                            type: "POST",
                                            url: '@Url.Action("DeleteExtraFee", "ExtraFee")',
                                            data: fromData,
                                            contentType: "application/json",
                                            dataType: "json",
                                            contentType: false,
                                            processData: false,
                                            success: function (data) {
                                                if (data.Status == 200) {
                                                    toastr.success(data.Message);
                                                    table.draw();
                                                }
                                                else {
                                                    toastr.error(data.Message);
                                                }

                                            },
                                            error: function () {
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });
                },
                columns: [
                    {
                        data: "Code",
                        "className": "text-center clssRow",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "Code",
                        className: 'text-center clssRow'

                    },
                    {
                        data: "Name",
                        className: 'clssRow'
                    },
                    {
                        data: "ListSalesType",
                        className: 'clssRow'
                    },
                    {
                        data: "ExtraFeeValue",
                        className: 'clssRow'
                    },
                    {
                        data: "StoreGroupName",
                        className: 'clssRow',
                        render: function (data, type, full, meta) {
                            return full.StoreGroup + " : " + full.StoreGroupName;
                        },
                    },
                    {
                        data: "FromDate",
                        render: function (data, type, full, meta) {
                            if (full.FromDate != null) {
                                return moment(full.FromDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        },
                        className: 'text-center clssRow'

                    },
                    {
                        data: "ToDate",
                        render: function (data, type, full, meta) {
                            if (full.ToDate != null) {
                                return moment(full.ToDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        },
                        className: 'text-center clssRow'

                    },
                    {
                        data: "Code",
                        render: function (data, type, full, meta) {
                            var html = "";
                            html += "<a title=\"Xóa phụ thu\" style=\"height:30px\" data-code='" + full.Code + "' class=\"btn btn-icon btn-light-danger deleteExtraFee\"><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function GetInfoExtraFee(itemNo) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/ExtraFee/_SetupExtraFee?Id=" + itemNo + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadExtraFee").css("display", "none");
                    $("#updateExtraFee").html(result);
                    $("#updateExtraFee").css("display", "block");

                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddExtraFee").css("display", "none");

                    loading.hideloading();
                },
                error: function (event) {

                }
            });
        }
        function LoadDataCoupon() {
        tableCode = $('#tblDataCoupon').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                //paging: true,
               // pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: false, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("CouponCodeLoad", "SetupCoupon")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.ItemNo = $("#hdtxtItemNo").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {
                    $(row).attr('id', "rowRecord" + data.ID);
                },
                drawCallback: function (settings) {
                },
                columns: [
                    {
                        data: "ItemNo",
                        "className": "text-center",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "Code",
                        className: 'text-center'
                    },
                    {
                        data: "Enable",
                        render: function (data, type, row) {

                            var html = "";
                            if (row.Enable == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Active</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Locked</span>";
                            }
                            return html;
                        },
                        className: 'text-center'
                    }

                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }
    </script>
}

