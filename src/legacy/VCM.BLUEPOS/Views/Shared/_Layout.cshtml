    @Scripts.Render("~/bundles/base")
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)

    <script src="~/Content/confirm/jquery-confirm.min.js"></script>
    <script src="~/Content/multiselect/fSelect.js"></script>
    <link href="~/Content/multiselect/fSelect.css" rel="stylesheet" />

    <script>

        function UpdateChangePassWord() {
            //debugger
            var typeLogin = $('#txt-type-login').val();
            var staffCode = @userName;
            var staffName = $('#update-staff-name').val();
            var authen_passWord = '@userPassWord';
            var passWord = "";
            if (authen_passWordd == null || authen_passWord == '') {
                passWord = "";
            }
            else if (authen_passWord != null || authen_passWordd != '')
            {
                passWord = authen_passWord;
            }
            var passWordOld = $('#update-password-old').val();
            var passWordNew1 = $('#update-password-new-1').val();
            var passWordNew2 = $('#update-password-new-2').val();

            if (passWordOld == null || passWordOld == '') {
                toastr.error('Nhập mật khẩu cũ');
                return;
            }

            if (passWordNew1 == null || passWordNew1 == '') {
                toastr.error('Nhập mật khẩu mới');
                return;
            }

            if (passWordNew2 == null || passWordNew2 == '') {
                toastr.error('Nhập lại mật khẩu mới');
                return;
            }

            loading.showloading();
            $.ajax({
                url: '@Url.Action("UpdateChangePassWord", "Authen")',
                type: "POST",
                dataType: "json",
                data: {
                    StaffCode: staffCode,
                    StaffName: staffName,
                    PassWord: passWord,
                    PassWordOld: passWordOld,
                    PassWordNew1: passWordNew1,
                    PassWordNew2: passWordNew2,
                    TypeLogin: typeLogin
                },
                success: function (data) {
                    loading.hideloading();
                    if (data.Message == "OK")
                    {
                        $('#kt_quick_user_close').trigger('click');
                        toastr.success('Đổi mật khẩu thành công');
                        ClearText();
                        $('#modal-change-password').modal("hide");
                    }
                    else if(data.Message == "FALSE")
                    {
                        toastr.error('Nhập mật khẩu cũ sai. Vui lòng kiểm tra lại');
                        $('#update-password-old').focus();
                    }
                    else
                    {
                        toastr.error(data.Message);
                    }

                    $('#btn-search').trigger('click');
                },
                error: function (data) {
                    loading.hideloading();
                    toastr.error('Lỗi hệ thống');
                }
            });
        }


        const ipnElement = document.querySelector('#update-password-old')
        const btnElement = document.querySelector('#btnPasswordold')

        btnElement.addEventListener('click', function () {
            const currentType = ipnElement.getAttribute('type')
            ipnElement.setAttribute(
                'type',
                currentType === 'password' ? 'text' : 'password'
            )
        })

        const ipnElementNew1 = document.querySelector('#update-password-new-1')
        const btnElementNew1 = document.querySelector('#btnPasswordnew1')
        btnElementNew1.addEventListener('click', function () {
            const currentType = ipnElementNew1.getAttribute('type')
            ipnElementNew1.setAttribute(
                'type',
                currentType === 'password' ? 'text' : 'password'
            )
        })

        const ipnElementNew2 = document.querySelector('#update-password-new-2')
        const btnElementNew2 = document.querySelector('#btnPasswordnew2')
        btnElementNew2.addEventListener('click', function () {
            const currentType = ipnElementNew2.getAttribute('type')
            ipnElementNew2.setAttribute(
                'type',
                currentType === 'password' ? 'text' : 'password'
            )
        });


        $(document).ready(function () {

            $('.select2').select2();
            var activeFirst = true;

            $('ul.header-tabs li a').each(function () {
                var activeCheck = $(this).hasClass('active');
                if (activeCheck) {
                    activeFirst = false;
                }
            });

            if (activeFirst) {
                $('ul.header-tabs li a:first').addClass('active');
                $('div.tab-pane:first').addClass('active');
            }

            $("#chkConfirmNotify").on("change", function () {
                if ($(this).prop('checked')) {
                    var id = $("#hdtxtViewId").val();
                    var title = $("#hdtxtViewTitle").val();
                    var fromData = new FormData();
                    fromData.append('NotifyID', id);
                    fromData.append('Title', title);
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("ConfirmNotify", "Notify")',
                        data: fromData,
                        contentType: "application/json",
                        dataType: "json",
                        contentType: false,
                        processData: false,
                        success: function (result) {
                            if (result.Status == 200) {
                                $('#modalNotify').modal('hide');
                            }
                            else {
                                toastr.error("Vui lòng nhập tiêu đề thông báo");
                            }
                        },
                        error: function () {
                            toastr.error("Lỗi hệ thống");
                        }
                    });
                }
            });
        });

        function Notify() {
            var fromData = new FormData();
            $.ajax({
                type: "POST",
                url: '@Url.Action("_Notify", "Notify")',
                data: fromData,
                contentType: "application/json",
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (result) {
                    if (result.Status == 200) {
                        var viewHtml = result.ViewPartial;
                        $("#divPopupNotify").html(viewHtml);
                        var model = result.Data;
                        $("#hdtxtViewId").val(model.ID);
                        $("#hdtxtViewTitle").val(model.Title);

                        $('#modalNotify').modal({
                            backdrop: 'static',
                            keyboard: false
                        });
                    }
                },
                error: function () {
                }
            });
        }

        $("#btn-change-password").click(function () {
            //debugger
            var staffCode = $('#hdd-txt-staffcode').val();
            var fullName = $('#hdd-txt-fullname').val();
            var passWord = $('#hdd-txt-password').val();
            $('#update-staff-code').val(staffCode);
            $('#update-staff-name').val(fullName);
            $('#update-password').val(passWord);
            $('#modal-change-password').modal({
                backdrop: 'static',
                keyboard: true
            });
            $('#update-password-old').focus();
        });

        $('#btn-save-change-password').on("click", function () {
            UpdateChangePassWord();
        });

    </script>

</body>

</html>

