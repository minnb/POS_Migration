@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Account;
@using VCM.BLUEPOS.Models.Account;
@using VCM.BLUEPOS.Model.Account;

@{
    AccountBLO accountBLO = new AccountBLO();
    var user = AuthCookie.CurrentUser(this.Context);
    string userName = "", userDept = "", userRole = "", userFullName = "", userTypeLogin = "", userPassWord = "";

    if (user != null && !string.IsNullOrEmpty(user.UserName))
    {
        userName = user.UserName;
        userFullName = user.FullName;
        userDept = user.Department;
        userRole = user.Role;
        userTypeLogin = user.TypeLogin;
        userPassWord = user.PasswordLocal ?? string.Empty;
    }
}

<!DOCTYPE html>
