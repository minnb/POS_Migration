@using VCM.BLUEPOS.Models;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Authen;
@{

    AuthenBLO autheBLO = new AuthenBLO();
    var user = AuthCookie.CurrentUser(this.Context);
    var listMenu1 = new List<MenuModel>();
    var menu = new List<MenuModel>();
    string userName = "",userDept="";
    if (user !=null && !string.IsNullOrEmpty(user.UserName))
    {
        userName = user.UserName;
        userDept = user.FullNameDep;
        menu = MenuPermissionModel.ListMenuPermission;
        if (menu != null && menu.Count > 0)
        {
            listMenu1 = menu.Where(d => d.ParentMenu == 0).OrderBy(d => d.Orderby).ToList();
        }
    }

    string actionName = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
}
<style>

    .menu-subnav::-webkit-scrollbar-track {
        border-radius: 5px;
    }

    .menu-subnav::-webkit-scrollbar {
        width: 3px;
    }

    .menu-subnav::-webkit-scrollbar-thumb {
        background-color: #0C713D;
        border-radius: 5px;
    }
    .header-menu .menu-nav > .menu-item .menu-submenu > .menu-subnav > .menu-item > .menu-link {
        padding: 11px 15px !important;
    }

</style>

<div id="kt_header" class="header flex-column header-fixed">
    <div class="header-top">
        <div class="container">
            <div class="d-none d-lg-flex align-items-center mr-3">
                <a href="/" style="color:#FFF" class="mr-20">
                    <img alt="Logo" src="~/Content/themekeen/media/pl/logoPL.png" class="max-w-120px" />
                </a>            
                    @if (menu != null && menu.Count() > 0)
                    {
                        var stt1 = 1;
                        <ul class="header-tabs nav align-self-end font-size-lg" role="tablist">
                            @foreach (var item in listMenu1)
                            {
                                var active = "";
                                var menuC2 = menu.FirstOrDefault(d => d.Controller == controllerName && d.Action == actionName);
                                if (menuC2 != null)
                                {
                                    var menuC1 = menu.FirstOrDefault(d => d.ID == menuC2.ParentMenu);
                                    if (menuC2.ParentMenu == item.ID || menuC1.ParentMenu == item.ID)
                                    {
                                        active = "active";
                                    }
                                }
                                <li class="nav-item">
                                    <a href="/" class="nav-link py-4 px-6 @active" data-toggle="tab" data-target="#kt_header_tab_@item.ID" role="tab">@item.MenuName</a>
                                </li>

                                stt1++;
                            }

                        </ul>
                    }
                
            </div>

            <div class="topbar" style="background-color:#0C713D !important">
                <div class="topbar-item">
                    <div class="btn btn-icon btn-hover-transparent-white w-sm-auto d-flex align-items-center btn-lg px-2" id="kt_quick_user_toggle">
                        <div class="d-flex flex-column text-right pr-sm-3">
                            <span class="text-white opacity-50 font-weight-bold font-size-sm d-none d-sm-inline">@userName</span>
                            <span class="text-white font-weight-bolder font-size-sm d-none d-sm-inline">@userDept</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="header-bottom">
        <div class="container">
            <div class="header-navs header-navs-left" id="kt_header_navs">
                @if (menu != null && menu.Count() > 0)
                {
         
                    <ul class="header-tabs p-5 p-lg-0 d-flex d-lg-none nav nav-bold nav-tabs" role="tablist">
                      
                        <li class="nav-item mr-2">
                            <a href="#" class="nav-link btn btn-clean active" data-toggle="tab" data-target="#kt_header_tab_1" role="tab">Home</a>
                        </li>
                       
                        <li class="nav-item mr-2">
                            <a href="#" class="nav-link btn btn-clean" data-toggle="tab" data-target="#kt_header_tab_2" role="tab">Reports</a>
                        </li>
                       
                        <li class="nav-item mr-2">
                            <a href="#" class="nav-link btn btn-clean" data-toggle="tab" data-target="#kt_header_tab_2" role="tab">Orders</a>
                        </li>
                       
                        <li class="nav-item mr-2">
                            <a href="#" class="nav-link btn btn-clean" data-toggle="tab" data-target="#kt_header_tab_2" role="tab">Help Ceter</a>
                        </li>
                      
                    </ul>
                   
                    <div class="tab-content">
                        @{
                            var stt2 = 1;
                            foreach (var item in listMenu1)
                            {
                                var listMenu2 = menu.Where(d => d.ParentMenu == item.ID).OrderBy(d => d.Orderby).ToList();
                                var active = "";
                                var tabMultiItem = "kt_header_tab_" + stt2;

                                var menuC2 = menu.FirstOrDefault(d => d.Controller == controllerName && d.Action == actionName);
                                if (menuC2 != null)
                                {
                                    var menuC1 = menu.FirstOrDefault(d => d.ID == menuC2.ParentMenu);
                                    if (menuC2.ParentMenu == item.ID || menuC1.ParentMenu == item.ID)
                                    {
                                        active = "active";
                                    }
                                }

                                <div class="tab-pane py-5 p-lg-0 show @active" id="kt_header_tab_@item.ID">
                                    <div id="kt_header_menu_@stt2" class="header-menu header-menu-mobile header-menu-layout-default">
                                        <ul class="menu-nav">
                                            @if (listMenu2.Count > 0)
                                            {
                                                var stt3 = 1;
                                                foreach (var item2 in listMenu2)
                                                {
                                                    var listMenu3 = menu.Where(d => d.ParentMenu == item2.ID).OrderBy(d => d.Orderby).ToList();
                                                    var active_bg = "";
                                                    if (listMenu3.Count == 0)
                                                    {
                                                        var menuActive = listMenu2.FirstOrDefault(d => d.Action == actionName && d.Controller == controllerName);
                                                        if (menuActive?.ID == item2.ID)
                                                        {
                                                            active_bg = "bg-light-success";
                                                        }

                                                        <li class="menu-item menu-item-active" aria-haspopup="true">
                                                            <a href="@Url.Action(item2.Action, item2.Controller)" class="menu-link @active_bg">
                                                                <span class="menu-text">@item2.MenuName</span>
                                                            </a>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li class="menu-item menu-item-submenu menu-item-rel menu-item-active" data-menu-toggle="click" aria-haspopup="true">

                                                            <a href="javascript:;" class="menu-link menu-toggle">
                                                                <span class="menu-text">@item2.MenuName</span>
                                                                <i class="fa la-angle-down custom-arrow"></i>
                                                            </a>
                                                            <div class="menu-submenu menu-submenu-classic menu-submenu-left">
                                                                <ul class="menu-subnav" style="max-height:460px; overflow-y:scroll">
                                                                    @foreach (var item3 in listMenu3)
                                                                    {
                                                                        var active3 = "";
                                                                        var menuActive = listMenu3.FirstOrDefault(d => d.Action == actionName && d.Controller == controllerName);
                                                                        if (menuActive?.ID == item3.ID)
                                                                        {
                                                                            active3 = "menu-item-active";
                                                                        }
                                                                        <li class="menu-item @active3" aria-haspopup="true">
                                                                            <a href="@Url.Action(item3.Action, item3.Controller)" class="menu-link">
                                                                                <span class="menu-icon">
                                                                                    <i class="la la-plus-circle"></i>
                                                                                </span>
                                                                                <span class="menu-text">
                                                                                    @item3.MenuName
                                                                                </span>
                                                                            </a>
                                                                        </li>
                                                                    }

                                                                </ul>
                                                            </div>
                                                        </li>
                                                    }
                                                    stt3++;
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                stt2++;
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

   
</div>

