@using VCM.BLUEPOS.Model.Notify;
@{
    var model = Model as ViewNotifyModel;
    var dateTime = DateTime.Now;
    var title = "";
    var noidung = "";
    var id = 0;
    var fromDate = dateTime.ToString("dd/MM/yyyy");
    var toDate = dateTime.ToString("dd/MM/yyyy");
    var isStatus = false;
    var isCheckNew = false;
    if (model.Info != null)
    {
        var info = model.Info;
        if (info.ID > 0)
        {
            info = model.Info;
            title = info.Title;
            noidung = info.Description;
            fromDate = info.FromDate == null ? "" : info.FromDate.Value.ToString("dd/MM/yyyy");
            toDate = info.ToDate == null ? "" : info.ToDate.Value.ToString("dd/MM/yyyy");
            isStatus = info.Status == true ? true : false;
            id = info.ID;
        }
        else
        {
            isCheckNew = true;
        }
    }
    else
    {
        isCheckNew = true;
    }

    var checkStatus = isCheckNew == true ? "checked" : (isStatus == true ? "checked" : "");
}
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
        <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
            <div class="card card-custom">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="row">
                                @*<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Mã phát hành</label>
                                            <div class="input-group">
                                                <input type="text" id="hdtxtItemNo" class="form-control" disabled value="@itemNo" />
                                                <div class="input-group-prepend btnSearchCpnVch" style="cursor:pointer;@displayBtnSearchItem">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-search"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>*@
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Tiêu đề</label>
                                        <div class="input-group">
                                            <input type="text" id="txtTitle" class="form-control" value="@title" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Từ ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="fromDate" name="StartingDate" value="@fromDate">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                    <div class="form-group">
                                        <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <i class="far fa-calendar-alt"></i>
                                                </span>
                                            </div>
                                            <input type="text" class="form-control float-right" id="toDate" name="EndingDate" value="@toDate">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-12">
                                    <div class="input-group" style="margin-top:27px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <label class="checkbox checkbox-inline" title="Trạng thái">
                                                    <input type="checkbox" @checkStatus id="chkStatus" class="chkStatus" />
                                                    <span></span>
                                                </label>
                                            </span>
                                        </div>
                                        <div class="input-group-append"><span class="input-group-text">Trạng thái</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="separator separator-dashed separator-border-1 separator-primary" style="margin-bottom:10px;margin-top:5px;"></div>
                    
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label class="font-weight-bold" style="font-weight:bold">Nội dung thông báo</label>
                                <div id="txtDescription-toolbar"></div>
                                    <div id="txtDescription" style="border: 1px solid #ccc;">
                                        @Html.Raw(noidung)
                                    </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div style="display:none">
    <input type="text" id="hdtxtId" class="form-control" disabled value="@id" />
</div>

<script type="text/javascript">

    //var tableCode = "";
    //$(document).ready(function () {

    $(".select2").select2();

    $('#fromDate').datepicker({
        format: 'dd/mm/yyyy',
        autoUpdateInput: false,
        todayHighlight: true,
        singleDatePicker: true,
        autoclose: true
    });

    $('#toDate').datepicker({
        format: 'dd/mm/yyyy',
        autoUpdateInput: false,
        todayHighlight: true,
        singleDatePicker: true,
        autoclose: true
    });

    var KTCkeditorDocument = function () {
        var desc = function () {
            DecoupledEditor
                .create(document.querySelector('#txtDescription')
                )
                .then(editor => {
                    const toolbarContainer = document.querySelector('#txtDescription-toolbar');
                    toolbarContainer.appendChild(editor.ui.view.toolbar.element);
                })
                .catch(
                    //error => {
                    //console.error(error);
                    //}
                );
        }
        return {
            init: function () {
                desc();
            }
        };
    }();
    KTCkeditorDocument.init();
        
</script>