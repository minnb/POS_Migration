
@{
    ViewBag.Title = "Quản lý thông báo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader" style="">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a>Hệ thống</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a>Quản lý thông báo</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" id="btnAddNotify"><i class="la la-plus-circle"></i> Tạo thông báo mới</button>
            <button type="button" style="display:none;margin-right:5px;" class="btn btn-success" id="btnSave"><i class="la la-save"></i> Lưu thông báo</button>
            <button type="button" style="display:none" class="btn btn-danger" id="btnCancle"><i class="la la-close"></i> Hủy bỏ</button>
        </div>

    </div>
</div>

<div class="d-flex flex-column-fluid">
    <div class="container">
        <div id="loadItem">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">

                        <div class="card card-custom">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Tiêu đề</label>
                                            <div class="input-group">
                                                <input type="text" id="searchTitle" class="form-control" placeholder="Tiêu đề" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                        <div class="form-group">
                                            <label class="font-weight-bold" style="font-weight:bold !important">Hiệu lực</label>
                                            <div class="input-group">
                                                <select class="form-control select2" style="width:100%;" id="slSearchStatus" name="Status">
                                                    <option value="">Tất cả</option>
                                                    <option value="1">Hiệu lực</option>
                                                    <option value="0">Hết hiệu lực</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                                        <button type="button" id="btnSearch" class="btn btn-primary" style="margin-top:27px;"><i class="fa fa-search"></i> Tìm</button>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <table id="tblData" class="table table-bordered table-hover">
                                <thead>
                                    <tr class="text-center">
                                        <th>STT</th>
                                        <th>TIÊU ĐỀ</th>
                                        <th>TỪ NGÀY</th>
                                        <th>ĐẾN NGÀY</th>
                                        <th>HIỆU LỰC</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="updateNotify" style="display:none">
        </div>
    </div>
</div>

<div class="modal fade" id="modalPreviewNotify" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">THÔNG BÁO</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="divPopupPreviewNotify">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal"><i class="la la-close"></i>Hủy</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/Content/themekeen/plugins/custom/ckeditor/ckeditor-document.bundle.js"></script>

    <script type="text/javascript">
        var table = "";
        $(document).ready(function () {
            $(".select2").select2();
            LoadDataNotify();

            $("#btnSearch").on("click", function (e) {

                table.search(this.value).draw();
            });

            $("#btnAddNotify").on("click", function (e) {
                GetInfoNotify("");

            });
            $("#btnCancle").on("click", function (e) {

                $("#btnCancle").css("display", "none");
                $("#btnSave").css("display", "none");
                $("#btnAddNotify").css("display", "block");

                $("#loadItem").css("display", "block");
                $("#updateNotify").css("display", "none");

                table.draw();
            });
            $("#btnSave").on("click", function (e) {
                debugger
                var id = $("#hdtxtId").val();
                var title = $("#txtTitle").val();
                var desc = $("#txtDescription").html();
                var fromDate = $("#fromDate").val();
                var toDate = $("#toDate").val();
                var status = false;
                if ($("#chkStatus").prop('checked')) {
                    status = true;
                }

                if (title == "") {
                    toastr.error("Vui lòng nhập tiêu đề thông báo");
                    return;
                }
                if (desc == "") {
                    toastr.error("Vui lòng nhập nội dung thông báo");
                    return;
                }
                if (fromDate == "") {
                    toastr.error("Vui lòng nhập ngày bắt đầu thông báo");
                    return;
                }
                if (toDate == "") {
                    toastr.error("Vui lòng nhập ngày kết thúc thông báo");
                    return;
                }
                var fromData = new FormData();
                fromData.append('ID', id);
                fromData.append('Title', title);
                fromData.append('Description', desc);
                fromData.append('FromDateStr', fromDate);
                fromData.append('ToDateStr', toDate);
                fromData.append('Status', status);

                $.ajax({
                    url: '@Url.Action("SaveNotify", "Notify")',
                    type: "POST",
                    dataType: "json",
                    contentType: false,
                    processData: false,
                    data: fromData,
                    success: function (response) {
                        if (response.Status == 200) {
                            toastr.success(response.Message);
                            $("#btnCancle").trigger("click");
                            table.draw();
                        }
                        else {
                            toastr.error(response.Message);
                        }
                        loading.hideloading();

                    },
                    error: function (data) {
                        loading.hideloading();
                        toastr.error('Lỗi hệ thống');
                    }
                });
            });
        });

        function LoadDataNotify() {

            table = $('#tblData').DataTable({
                dom: '<"top"iflp<"clear">>rt',
                destroy: true,
                //paging: true,
                // pagingType: "simple_numbers",
                responsive: true,
                processing: false, // for show progress bar
                serverSide: true, // for process server side
                filter: false, // this is for disable filter (search box)
                orderMulti: false, // for disable multiple column at once
                autoWidth: true,
                ordering: false,
                displayLength: 10,
                searching: false,
                lengthChange: false,
                ajax: {
                    url: '@Url.Action("NotifyLoad", "Notify")',
                    type: "POST",
                    datatype: "json",
                    data: function (d) {
                        d.Title = $("#searchTitle").val();
                        d.Status = $("#slSearchStatus").val();
                    }
                },
                createdRow: function (row, data, dataIndex) {

                    //$(row).attr('class', "clssRow");
                    //$(row).attr('data-notifyid', data.ItemNo);

                    // var a = $(row).find('td:eq(2)').html();
                    $(row).find('.clssRow').attr('data-notifyid', data.ID);
                },
                drawCallback: function (settings) {
                    $(".clssRow").click(function () {
                        //var itemOffer = {};
                        var id = $(this).attr("data-notifyid");
                        GetInfoNotify(id);
                    });
                    $(".deleteNotify").on("click", function (e) {
                        var id = $(this).attr("data-notifyid");
                        var thongbao = "Bạn có chắc chắn xóa thông báo này không?";
                        $.confirm({
                            backgroundDismiss: false,
                            escapeKey: true,
                            icon: 'fa fa-warning',
                            type: 'red',
                            typeAnimated: true,
                            title: 'Thông báo',
                            content: thongbao,
                            buttons: {
                                "CÓ": {
                                    btnClass: 'btn btn-default',
                                    keys: ['ctrl'],
                                    action: function () {
                                        debugger
                                        var fromData = new FormData();
                                        fromData.append('ID', id);
                                        $.ajax({
                                            type: "POST",
                                            url: '@Url.Action("DeleteNotify", "Notify")',
                                            data: fromData,
                                            contentType: "application/json",
                                            dataType: "json",
                                            contentType: false,
                                            processData: false,
                                            success: function (data) {
                                                if (data.Status == 200) {
                                                    toastr.success(data.Message);
                                                    table.draw();
                                                }
                                                else {
                                                    toastr.error(data.Message);
                                                }

                                            },
                                            error: function () {
                                            }
                                        });
                                    }
                                },
                                "KHÔNG": {
                                    btnClass: 'btn-default',
                                    action: function () { }
                                }
                            }
                        });
                    });

                    $(".previewNotify").on("click", function (e) {
                        loading.showloading();
                        var id = $(this).attr("data-notifyid");
                        var fromData = new FormData();
                        fromData.append('ID', id);
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("PreviewNotify", "Notify")',
                            data: fromData,
                            contentType: "application/json",
                            dataType: "json",
                            contentType: false,
                            processData: false,
                            success: function (data) {
                                if (data.Status == 200) {
                                    $("#divPopupPreviewNotify").html(data.Data);

                                    $('#modalPreviewNotify').modal({
                                        backdrop: 'static',
                                        keyboard: false
                                    });
                                }
                                else {
                                    toastr.error(data.Message);
                                }
                                loading.hideloading();
                            },
                            error: function () {
                                loading.hideloading();
                            }
                        });

                    });
                },
                columns: [
                    {
                        data: "ID",
                        "className": "text-center clssRow",
                        "render": function (data, type, row, meta) {
                            var start = meta.settings._iDisplayStart;
                            return meta.row + 1 + start;
                        }
                    },
                    {
                        data: "Title",
                        className: 'clssRow'
                    },
                    {
                        data: "FromDate",
                        className: 'text-center clssRow',
                        render: function (data, type, full, meta) {
                            if (full.FromDate != null) {
                                return moment(full.FromDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        }
                    },
                    {
                        data: "ToDate",
                        className: 'text-center clssRow',
                        render: function (data, type, full, meta) {
                            if (full.ToDate != null) {
                                return moment(full.ToDate).format("DD/MM/YYYY");
                            }
                            else
                                return "";
                        }
                    },
                    {
                        data: "Status",
                        render: function (data, type, row) {
                            var html = "";
                            if (row.Status == true) {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#28a745;\">Hiệu lực</span>";
                            }
                            else {
                                html = "<span class=\"badge\" style=\"color: #fff;background-color:#dc3545;\">Hết hiệu lực</span>";
                            }
                            return html;
                        },
                        className: 'text-center clssRow'
                    },
                    {
                        data: "ID",
                        render: function (data, type, full, meta) {
                            var html = "";
                            html += "<a title=\"Xóa thông báo\" style=\"height:30px\" data-notifyid='" + full.ID + "' class=\"btn btn-icon btn-light-danger deleteNotify\"><i class=\"la la-close\"></i><span class=\"pulse-ring\"></span></a>";
                            html += "<a title=\"Preview\" style=\"height:30px;margin-left:5px\" data-notifyid='" + full.ID + "' class=\"btn btn-icon btn-light-primary previewNotify\"><i class=\"fa fa-list\"></i><span class=\"pulse-ring\"></span></a>";
                            return html;
                        },
                        className: 'text-center'
                    }
                ]
            }).on('processing.dt', function (e, settings, processing) {

                if (processing) {
                    loading.showloading();
                } else {
                    loading.hideloading();
                }
            });
        }

        function GetInfoNotify(id) {
            loading.showloading();
            $.ajax({
                type: "GET",
                url: "/Notify/_SetupNotify?Id=" + id + "",
                dataType: 'html',
                contentType: false,
                processData: false,
                success: function (result) {
                    $("#loadItem").css("display", "none");
                    $("#updateNotify").html(result);
                    $("#updateNotify").css("display", "block");

                    $("#btnCancle").css("display", "block");
                    $("#btnSave").css("display", "block");
                    $("#btnAddNotify").css("display", "none");

                    loading.hideloading();
                },
                error: function (event) {

                }
            });
        }
    </script>
}


