@using BLUEPOS.REPORT.Model.Order.PrintOrderModel;
@using BLUEPOS.REPORT.Components.Constants;
@using BLUEPOS.REPORT.Helpers;

@{
    var header = $"{Model.StoreName}  {Model.Address}  {Model.PhoneNo}";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";

    var line = ".....................................................................................";
    var line_name = "..............................................................";
    var line_diachi = "...............................................................";
    var line_phone = ".................................................................";
    var line_hoso = "........................................................................";
}

@model PrintInvoiceOrderSalesResultResponseModel

@if (Model.Status == "1")
{
    <!-- Liên 2 : giao cho KH -->
    if (Model.SalesIsReturn != 0)
    {
        var title_BNTT = $"BIÊN NHẬN THANH TOÁN IN LẠI";
        var subTitle = $"(Bản sao cho khách hàng)";
        var policy = $"không chuyển nhượng BNTT này cho bất cứ khách hàng nào khác. BNTT có hiệu lực 15 ngày. Số dư của BNTT khi sử dụng sẽ không được trả lại";

        <div id="order-print-session-custommer" style='width:270px;font-family:Roboto, sans-serif;margin:auto;font-size: 12px;'>

            <div style="display: block;min-height: 85px;margin:auto;">
                <div style='float: left;text-align: left;margin-top: 25px;'><img src='@Model.Host/AdminLTE-3.0.5/dist/img/logo_invoice.png' width="102" height="25" /></div>
                <div style="float: right; display: inline-block; text-align: center; width: 59%; font-size: 12px !important;">
                    <span style="display: inline-block;">@Model.StoreName</span>
                    <span style="display: inline-block;">@Model.Address</span>
                    <span style="display: inline-block;">@Model.PhoneNo</span>
                </div>
            </div>


            <div style='margin-top:50px;display:block;'>
                <div style='display:block;text-align:center;font-weight:bold;font-size:16px !important;'>@title_BNTT</div>
                <div style='display:block;text-align:center;font-weight:bold;font-size:10px !important;'>@subTitle</div>
                <br />

                <div style='margin-top:10px;display:block;'>
                    @if (Model.OrderTime != null)
                    {
                        <div style='float: left;padding-top: 5px;'><span style="font-weight:700;">Ngày bán:</span> @Model.OrderTime.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    else
                    {
                        <div style='float: left;padding-top: 5px;'><span style="font-weight:700;">Ngày bán:</span></div>
                    }

                    @if (Model.POSTerminalNo != null)
                    {
                        <div style='float: right;padding-top: 5px;'><span style="font-weight:700;">Quầy:</span> @Model.POSTerminalNo</div>
                    }
                    else
                    {
                        <div style='float: right;padding-top: 5px;'><span style="font-weight:700;">Quầy:</span></div>
                    }

                </div>

                <div style='margin-top:10px;display:block;'>
                    @if (Model.OrderNo != null)
                    {
                        <div style='float: left;padding-top: 5px;'><span style="font-weight:700;">HĐ:</span> @Model.OrderNo </div><br />
                    }
                    else
                    {
                        <div style='float: left;padding-top: 5px;'><span style="font-weight:700;">HĐ:</span></div><br />
                    }

                    @if (Model.CashierID != null)
                    {
                        <div style='float: right;padding-top: 5px;'><span style="font-weight:700;">NVBH:</span> @Model.CashierID</div>
                    }
                    else
                    {
                        <div style='float: right;padding-top: 5px;'><span style="font-weight:700;">NVBH:</span></div>
                    }
                </div>

                <div style='margin-top:40px;display:block;'>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Tên khách hàng:</span>@line_name
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Địa chỉ K.Hàng:</span>@line_diachi
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Số điện thoại:</span>@line_phone
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Số hồ sơ:</span>@line_hoso
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Giá trị voucher:</span>   @Model.ReturnVoucherAmount.VNCurrency() VNĐ
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Ngày hết hạn:</span>          @Model.ReturnVoucherExpireDate
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Chữ ký khách hàng</span>
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Chữ ký nhân viên</span>
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Chữ ký quản lý</span>
                    </div>
                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;">@line</span>
                    </div>

                    <div style='padding-top: 10px;'>
                        <span style="font-weight:400;font-size: 10px;">Chính sách cửa hàng: </span>
                        <br />
                        <span style="font-weight:400;">@policy</span>
                    </div>

                    <div style="text-align:center; padding-top: 20px;">
                        <img src="data:image/png;base64,@BarcodeHelper.GenerateBarcodeToString(Model.ReturnVoucherNo)" width="140" height="35">
                    </div>
                    <div style="text-align:center;">@Model.ReturnVoucherNo</div>

                </div>

            </div>

        </div>

    }

}

<script src="~/AdminLTE-3.0.5/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        window.print();
    })

    window.print();
    window.onafterprint = function () {
        // xủ lý open tab 3
        var returnVoucherNo = @Model.ReturnVoucherNo;
        if (returnVoucherNo == "0") {
            window.top.close();
        }
        else {
            var storeNo = @Model.StoreNo;
            var posID = @Model.POSTerminalNo;
            var orderNo = @Model.OrderNo;
            var url3 = '@Model.Host/Order/PrintInvoiceOrderSalesForStore?StoreCode=' + storeNo + '&PosID=' + posID + '&OrderNo=' + orderNo;
            window.location.href = url3;
        }
    }

</script>
