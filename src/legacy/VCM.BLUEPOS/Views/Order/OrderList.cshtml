        function checkAmount() {
            var flag = false;
            var fromAmount = $('#from-amount').val();
            var toAmount = $('#to-amount').val();
            var frAmount = 0;
            var tAmount = 0;
            if (fromAmount != "" && toAmount != "") {
                frAmount = parseFloat(fromAmount);
                tAmount = parseFloat(toAmount);
            }
            if (frAmount < 0) {
                toastr.warning('Nhập số tiền từ là số nguyên dương (>0)');
                loading.hideloading();
                return flag;
            }
            if (tAmount < 0) {
                toastr.warning('Nhập số tiền đến là số nguyên dương (>0)');
                loading.hideloading();
                return flag;
            }
            if (frAmount > tAmount) {
                toastr.warning('Số tiền từ phải nhỏ hơn hoặc bằng số tiền đến');
                loading.hideloading();
                return flag;
            }
            return true;
        };

