
@using VCM.BLUEPOS.Helpers;
@using Newtonsoft.Json;
@using VCM.BLUEPOS.Models.Account;
@using VCM.BLUEPOS.Model.Store;
@using VCM.BLUEPOS.Model.OptionModel;
@using VCM.BLUEPOS.Model.Common;
@using VCM.BLUEPOS.Authen;
@using VCM.BLUEPOS.Model.Order;
@using VCM.BLUEPOS.Model.POS;
@using VCM.BLUEPOS.Model.Account;


@{

    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var menu = MenuPermissionModel.ListMenuPermission;

    var listRole = ViewBag.PermissionRole as UserRoleModel;
    var listSetDB = ViewBag.SetDB as List<SQLServerModel>;

    var isUpdateSaleTypePermission = menu.Any(x => x.Controller == "Order" && x.Action == "UpdateSalesType");

    var listStore = ViewBag.ListStore as List<StoreModel>;

    var model = Model as SalesType;
    var listToSalesType = ViewBag.ToSalesType as List<OptionModel>;
    var listFromSalesType = ViewBag.FromSalesType as string;

    var listOrderType = ViewBag.ListOrderType as List<OptionDataModel>;
    var listSalesType = ViewBag.ListSalesType as List<OptionDataModel>;
    var listSourceBill = ViewBag.ListSourceBill as List<OptionDataModel>;

}

<div class="subheader py-2 py-lg-6 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-lg">
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Vận hành</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Báo cáo tổng hợp</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a style="color:#0C713D;">Danh sách đơn hàng</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="d-flex flex-column-fluid">
    <div class="container">
        @using (Html.BeginForm("ExportExcelOrderList", "Order", FormMethod.Get, new { @id = "frm-export-excel" }))
        {
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                    <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important;">Từ ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-from-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-from-date" name="TxtFromDate" placeholder="Từ ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Đến ngày<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <label class="input-group-btn" for="txt-to-date">
                                                    <span class="btn btn-default">
                                                        <span class="glyphicon glyphicon-calendar">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <input type="text" class="form-control float-right" id="txt-to-date" name="TxtToDate" placeholder="Đến ngày">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Vùng Set<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="input-group">
                                        <select class="form-control select2" style="width:100%;" id="set-server" name="SetServerDB">
                                            @if (listSetDB != null && listSetDB.Count > 0)
                                            {
                                                if (listSetDB.Count == 1)
                                                {
                                                    <option value="@listSetDB.FirstOrDefault().IPServer" data-serverread="@listSetDB.FirstOrDefault().IPServerRead">@listSetDB.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    foreach (var item in listSetDB)
                                                    {
                                                        <option value="@item.IPServer" data-serverread="@item.IPServerRead">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">ST/CH<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="store-no" name="StoreNo"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Máy POS<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width: 100%;" id="pos-terminal" name="POSID"></select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Loại đơn hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-order-type" name="OrderType">
                                            @if (listOrderType != null && listOrderType.Count > 0)
                                            {
                                                if (listOrderType.Count == 1)
                                                {
                                                    <option value="@listOrderType.FirstOrDefault().Code">@listOrderType.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listOrderType)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Hình thức bán hàng<strong style="color:#ff0000"> (*)</strong></label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-sales-type" name="SalesType">
                                            @if (listSalesType != null && listSalesType.Count > 0)
                                            {
                                                <option value="" selected>Tất cả</option>
                                                foreach (var item in listSalesType)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Nơi tạo bill</label>
                                    <div class="form-group">
                                        <select class="form-control select2" style="width:100%;" id="sel-user-create-bill" name="UserCreateBill">
                                            @if (listSourceBill != null && listSourceBill.Count > 0)
                                            {
                                                if (listSourceBill.Count == 1)
                                                {
                                                    <option value="@listSourceBill.FirstOrDefault().Code">@listSourceBill.FirstOrDefault().Description</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected>Tất cả</option>
                                                    foreach (var item in listSourceBill)
                                                    {
                                                        <option value="@item.Code">@item.Description</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Thông tin đơn hàng</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="text-search-order" name="TextSearchOrder" placeholder="Số đơn hàng ; Mã Thu Ngân">
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Thông tin sản phẩm</label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="text-search-item" name="TextSearchItem" placeholder="Mã sản phẩm ; Mã barcode ; Tên sản phẩm">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Số tiền từ</label>
                                    <div class="form-group">
                                        <input type="text" class="mask form-control" id="from-amount" name="FromAmount" placeholder="Nhập số tiền dương (>0)">
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                                    <label class="font-weight-bold" style="font-weight:bold !important">Số tiền đến</label>
                                    <div class="form-group">
                                        <input type="text" class="mask form-control" id="to-amount" name="ToAmount" placeholder="Nhập số tiền dương (>0)">
                                    </div>
                                </div>

                                <input type="hidden" id="dFromAmount" name="FromAmount">
                                <input type="hidden" id="hToAmount" name="ToAmount">
                                <input type="hidden" id="hdFromDate" name="FromDate" />
                                <input type="hidden" id="hdToDate" name="ToDate" />
                                <input type="hidden" id="view-detail-order-no">
                                <input type="hidden" id="hd-set-server-ip" name="SetServer">

                                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12" style="margin-top:25px;">
                                    <button type="button" id="btn-search" class="btn btn-primary"><i class="fa fa-search"></i>Tìm</button>
                                    <button type="button" id="btn-export-excel" class="btn btn-success"><i class="fa fa-file-excel"></i>Xuất Excel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xl-12">
                <div class="card card-custom bgi-no-repeat gutter-b card-stretch">
                    <div class="card-body">
                        <table id="tbl-order-list" class="table table-bordered table-hover text-nowrap">
                            <thead>
                                <tr class="text-center" style="text-transform:uppercase;">
                                    <th>#</th>
                                    <th>STT</th>
                                    <th>Số đơn hàng</th>
                                    <th>Ngày tạo đơn hàng</th>
                                    <th>Thời gian</th>
                                    <th>Ngày kinh doanh</th>
                                    <th>ST/CH</th>
                                    <th>Máy POS</th>
                                    <th>Tổng số tiền</th>
                                    <th>Tổng số tiền giảm giá</th>
                                    <th>Thành tiền</th>
                                    <th>Hình thức bán hàng</th>
                                    <th>Loại đơn hàng</th>
                                    <th>Số đơn hàng gốc</th>
                                    <th>Nơi tạo bill</th>
                                    <th>Số ĐH tham chiếu</th>
                                    <th>Tên khách hàng</th>
                                    <th>Thu ngân</th>
                                    <th>Label</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="modal-detail-order-list">
