        $("#btn-search").on("click", function (e) {
            //debugger
            var fromDate = getFromDate();
            var toDate = getToDate();

            if (fromDate > toDate) {
                toastr.error('Từ ngày <= đến ngày. Vui lòng kiểm tra lại');
                return;
            }

            var fromDateStr = getFromDate();  //yyyy/MM/dd
            var toDateStr = getToDate();      //yyyy/MM/dd

            var yearStrFrom = fromDateStr.split('/')[0];  //yyyy
            var monthStrFrom = fromDateStr.split('/')[1]; //MM
            var dayStrFrom = fromDateStr.split('/')[2];   //dd
            var _dateFrom = dayStrFrom.substr(0, 2);

            var yearStrTo = toDateStr.split('/')[0];  //yyyy
            var monthStrTo = toDateStr.split('/')[1]; //MM
            var dayStrTo = toDateStr.split('/')[2];   //dd
            var _dateTo = dayStrTo.substr(0, 2);

            $('#fromDate').val(moment().format('DD/MM/YYYY'));
            $('#fromDate').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            $('#toDate').val(moment().format('DD/MM/YYYY'));
            $('#toDate').daterangepicker({
                singleDatePicker: true,
                locale: {
                    format: 'DD/MM/YYYY'
                }
            });

            var fromDate = _dateFrom + "/" + monthStrFrom + "/" + yearStrFrom;
            var toDate = _dateTo + "/" + monthStrTo + "/" + yearStrTo;

            $("#temp-from-date-check-31").val(fromDate);
            $("#temp-to-date-check-31").val(toDate);

            var _fromDate = $("#temp-from-date-check-31").val().split('/');
            var _toDate = $("#temp-to-date-check-31").val().split('/');

            var newFromDate = new Date(_fromDate[1] + '/' + _fromDate[0] + '/' + _fromDate[2]);
            var newToDate = new Date(_toDate[1] + '/' + _toDate[0] + '/' + _toDate[2]);

            var Difference_In_Time = newToDate.getTime() - newFromDate.getTime();
            var Difference_In_Days = Difference_In_Time / (1000 * 3600 * 24);

            if (Difference_In_Days > 7) {
                toastr.error("Do dữ liệu quá lớn, vui lòng chọn thời gian xem báo cáo trong khoảng thời gian tối đa 07 ngày");
                loading.hideloading();
                return;
            }

            var checkStoreBySet = $('#store-no').val();
            if (checkStoreBySet == "-1") {
                toastr.error('Bạn không có quyền xem thông tin bán hàng trong vùng set này');
                loading.hideloading();
                return;
            }

            table_order_list.draw();

        });

