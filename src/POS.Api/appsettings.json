{
  "AllowedHosts": "*",

  "Logging": {
    "FileLogDirectory": "D:/Logs/POSBLUE",
    "LogLevel": { "Default": "Information" }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "Elasticsearch": {
    "Nodes": [ "http://es-node1:9200", "http://es-node2:9200" ],
    "IndexFormat": "posblue-logs-{0:yyyy.MM.dd}",
    "Username": "",
    "Password": ""
  },

  "Redis": {
    "Mode": "Sentinel",
    "SentinelHosts": [ "sentinel1:26379", "sentinel2:26379", "sentinel3:26379" ],
    "MasterName": "mymaster",
    "Password": "",
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "DefaultDatabase": 0
  },

  "RabbitMQ": {
    "Hosts": [ "rabbitmq1", "rabbitmq2", "rabbitmq3" ],
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "RequestedHeartbeat": 60
  },

  "ConnectionStrings": {
    "CentralMD": "Server=.;Database=CentralMD;Trusted_Connection=True;TrustServerCertificate=True;",
    "Loyalty": "Server=.;Database=Loyalty;Trusted_Connection=True;TrustServerCertificate=True;",
    "StagingDB": "Server=.;Database=StagingDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "BootstrapServers": "kafka-node1:9092,kafka-node2:9092,kafka-node3:9092"
  },

  "BasicAuth": {
    "Username": "",
    "Password": ""
  },

