{
  "AppSettings": {
    "Environment": "UAT",
    "ApiServerIp": "<UAT_API_SERVER_IP>",
    "UploadFileFTP": "NO",
    "FtpRootPath": "/app/ftpbluepos",
    "FolderShare": "",
    "FolderShareUpdSource": "",
    "FolderShareAPIBluePOS": "",
    "RemoteSvrUser": "",
    "RemoteSvrPass": ""
  },
  "Logging": {
    "FileLogDirectory": "/app/logs"
  },
  "Elasticsearch": {
    "Nodes": [
      ""
    ],
    "IndexFormat": "pos-api-logs-uat-{0:yyyy.MM.dd}"
  },
  "RequestLogging": {
    "Enabled": false,
    "PersistToFile": true,
    "MaxBodyBytes": 8192,
    "ExcludePaths": [
      "/health",
      "/swagger"
    ]
  },
  "Redis": {
    "Mode": "StandAlone",
    "SentinelHosts": [
      "<UAT_REDIS_HOST>:6379"
    ],
    "MasterName": "mymaster",
    "Password": "",
    "ConnectTimeout": 5500,
    "SyncTimeout": 5500,
    "DefaultDatabase": 2,
    "KeepAlive": 180,
    "ConnectRetry": 2
  },
  "RabbitMQ": {
    "Host": "<UAT_RABBIT_HOST>",
    "Port": 5672,
    "Username": "appvcm",
    "Password": "<UAT_RABBIT_PASSWORD>",
    "VirtualHost": "/"
  },
  "ConnectionStrings": {
    "CentralMD": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSMasterData;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Loyalty": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSLoyalty;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "StagingDB": "Data Source=<UAT_SQL_HOST>;Initial Catalog=StagingDB;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralGeneral": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSCentralGeneral;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSale": "Data Source=<UAT_SQL_HOST>;Initial Catalog=RPOSCentralSales;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "CentralSaleTemplate": "Data Source={server};Initial Catalog=RPOSCentralSales;User ID=<UAT_SQL_USER>;Password=<UAT_SQL_PASSWORD>;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "BootstrapServers": "<UAT_KAFKA_HOST>:9092"
  },
  "SetDb": {
    "DB1": "<UAT_SQL_HOST>"
  },
  "MasterDataSync": {
    "SqlCommandTimeoutSeconds": 600,
    "KeepZipDays": 2,
    "DateInZipName": true,
    "ZipCompressionLevel": "Fastest",
    "BatchSizePerFile": 10000,
    "MaxParallelTables": 4,
    "MaxConcurrentGeneration": 3,
    "ThrottleStaleAfterSeconds": 600
  },
  "SyncTableTracker": {
    "FlushIntervalSeconds": 5,
    "ChannelCapacity": 5000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "LogRetention": {
    "SerilogRetainedFileCountLimit": 7,
    "SerilogFileSizeLimitBytes": null,
    "RawLogRetentionDays": 7
  }
}